    function s__EVBossDispell_onCharge takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EVBossDispell_myServant[this]) then
            call s__tick_pause(s__EVBossDispell_coolTick[this])
            return
        endif
        call SetUnitVertexColor(s__EVBossDispell_myServant[this], 255, 255, 255, 255)
        call UnitRemoveAbility(s__EVBossDispell_myServant[this], 'A0CZ')
        call UnitRemoveAbility(s__EVBossDispell_myServant[this], 'B025')
        call DestroyEffect(s__EVBossDispell_myFx[this])
        set s__EVBossDispell_myFx[this]=null
        call s__tick_start(s__EVBossDispell_coolTick[this],s__EVBossDispell_myCooldown[this] , false , function sc__EVBossDispell_onCastSpell)
    endfunction
    function s__EVBossDispell_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EVBossDispell_myServant[this]) then
            call s__tick_pause(s__EVBossDispell_coolTick[this])
            return
        endif
        call s__EVDebuffSlow_clear(s__EVBossDispell_myServant[this])
        call FXRD_FXDebuffShockClear(s__EVBossDispell_myServant[this])
        call SetUnitVertexColor(s__EVBossDispell_myServant[this], 128, 0, 128, 128)
        call UnitAddAbility(s__EVBossDispell_myServant[this], 'A0CZ')
        set s__EVBossDispell_myFx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl", s__EVBossDispell_myServant[this], "origin")
        call s__tick_start(s__EVBossDispell_coolTick[this],s__EVBossDispell_myCharge[this] , false , function s__EVBossDispell_onCharge)
    endfunction
    

