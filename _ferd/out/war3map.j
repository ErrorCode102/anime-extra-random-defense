    function UIResultButtonResume___onClosing takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        call ShowUnit(UIResultButtonResume___CLICKBOUND[ui], false)
        call KillUnit(UIResultButtonResume___CLICKBOUND[ui])
        set UIResultButtonResume___CLICKBOUND[ui]=null
        
        call RemoveDestructable(UIResultButtonResume___BACKDROP[ui])
        set UIResultButtonResume___BACKDROP[ui]=null
        
        set p=null
    endfunction
    
    function UIResultButtonResume___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        set UIResultButtonResume___BACKDROP[ui]=CreateDestructableZ('B033', 5440.0 + 64.0, - 320.0, 0.0, 270.0, 0.95, 0)
        call ShowDestructable(UIResultButtonResume___BACKDROP[ui], false)
        set UIResultButtonResume___CLICKBOUND[ui]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n006', 5440.0 + 64.0, - 320.0, 270.0)
        call SetUnitUserData(UIResultButtonResume___CLICKBOUND[ui], ui)
        call SetUnitVertexColor(UIResultButtonResume___CLICKBOUND[ui], 0, 0, 0, 0)
        call SetUnitScale(UIResultButtonResume___CLICKBOUND[ui], 0.0, 0.0, 0.0)
    
        set p=null
    endfunction
    
    function UIResultButtonResume___onUpdating takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        local boolean isVisible= s__FXResultInterface_Visible[parent]
        
        if GetLocalPlayer() == p then
            call ShowDestructable(UIResultButtonResume___BACKDROP[ui], isVisible)
            if isVisible then
                call SetUnitScale(UIResultButtonResume___CLICKBOUND[ui], 0.95, 0.95, 1.0)
            else
                call SetUnitScale(UIResultButtonResume___CLICKBOUND[ui], 0.0, 0.0, 0.0)
            endif
        endif
        
        set p=null
    endfunction

    function UIResultButtonResume___onClick takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer parent= (id)
        if id != GetUnitUserData(GetTriggerUnit()) then
            return
        endif
        call RRRequestPlayer(REQUEST_UI_RESULT_CLOSE , GetTriggerPlayer())
    endfunction
    
    function UIResultButtonResume___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultButtonResume___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_UPDATING , function UIResultButtonResume___onUpdating)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultButtonResume___onClosing)
        
        call s__UnitSelectEvent_Create('n006' , function UIResultButtonResume___onClick)
    endfunction
    
