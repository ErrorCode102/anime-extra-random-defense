    function s__CMBladeWorks_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMBladeWorks_myDummy[this])
        set s__CMBladeWorks_myDummy[this]=null
        set s__CMBladeWorks_caster[this]=null
        call s__tick_destroy(s__CMBladeWorks_mainFlow[this])
        call s__tick_destroy(s__CMBladeWorks_subFlow[this])
    endfunction
    function s__CMBladeWorks_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__enemy_dealLogic(s__CMBladeWorks_caster[this] , GetEnumUnit() , s__CMBladeWorks_myDamage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function s__CMBladeWorks_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMBladeWorks_caster[this], UNIT_TYPE_DEAD) or s__CMBladeWorks_myCombo[this] == 0 then
            call s__tick_start(s__CMBladeWorks_mainFlow[this],0.10 , false , function s__CMBladeWorks_onFinal)
            return
        endif
        set s__CMBladeWorks_myCombo[this]=s__CMBladeWorks_myCombo[this] - 1
        call SetSoundPosition(gg_snd_weaponrain, s__CMBladeWorks_myX[this], s__CMBladeWorks_myY[this], 300)
        call StartSound(gg_snd_weaponrain)
        call s__splash_range(s__splash_ENEMY , s__CMBladeWorks_caster[this] , s__CMBladeWorks_myX[this] , s__CMBladeWorks_myY[this] , s__CMBladeWorks_myRange[this] , function s__CMBladeWorks_enumDealt)
        if s__CMBladeWorks_myCombo[this] > 0 then
            call s__tick_start(s__CMBladeWorks_mainFlow[this],s__CMBladeWorks_myDelay[this] , false , function s__CMBladeWorks_onFireStart)
        else
            call s__tick_start(s__CMBladeWorks_mainFlow[this],0.10 , false , function s__CMBladeWorks_onFinal)
        endif
    endfunction
    function s__CMBladeWorks_onEffectDrop takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local real ang
        local real dist
        local integer i= 0
        loop
            exitwhen i == 5
            set ang=GetRandomReal(0.00, 360.00)
            set dist=s__CMBladeWorks_myRange[this] * SquareRoot(GetRandomReal(0.00, 1.00))
            call DestroyEffect(AddSpecialEffect("FX\\Gilgamesh\\Shower.mdl", s__CMBladeWorks_myX[this] + s__Polar_X(dist , ang), s__CMBladeWorks_myY[this] + s__Polar_Y(dist , ang)))
            set i=i + 1
        endloop
    endfunction
    function s__CMBladeWorks_cast takes unit src,real tx,real ty,real r,real dmg,integer combo,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMBladeWorks_caster[this]=src
        set s__CMBladeWorks_myX[this]=tx
        set s__CMBladeWorks_myY[this]=ty
        set s__CMBladeWorks_myRange[this]=r
        set s__CMBladeWorks_myDamage[this]=dmg
        set s__CMBladeWorks_myCombo[this]=combo
        set s__CMBladeWorks_myDelay[this]=delay
        //
        set s__CMBladeWorks_myDummy[this]=CreateUnit(Player(15), 'h00M', tx, ty, 270)
        call sc__DummyColorChanger_cast(s__CMBladeWorks_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 1.00)
        //
        set s__CMBladeWorks_mainFlow[this]=this
        call s__tick_start(s__CMBladeWorks_mainFlow[this],1.00 , false , function s__CMBladeWorks_onFireStart)
        set s__CMBladeWorks_subFlow[this]=s__tick_create(this)
        call s__tick_start(s__CMBladeWorks_subFlow[this],0.10 , true , function s__CMBladeWorks_onEffectDrop)
    endfunction
// Trigger: Sv C ServantEmiya
//===========================================================================
// scope SvServantEmiya begins
    //기본 서번트 스탯 설정
    //구현부
    function SvServantEmiya__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        local boolean pen
        local boolean addit
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvServantEmiya__onAttackThrust takes unit src,unit dst,real perc,real mtpl returns nothing
        if GetRandomReal(0.00, 100.00) > perc then
            set mtpl=1.00
        endif
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5.00)
        else
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1.00)
        endif
        call s__enemy_dealLogicEx(src , dst , s__EVDamageManager_getFinalDamage(src) * mtpl , true , false , WEAPON_TYPE_WHOKNOWS , 0)
    endfunction
    function SvServantEmiya__onAttackRankB takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SvServantEmiya__onAttackThrust(GetTriggerUnit() , GetEventDamageSource() , 15.00 , 2.00)
    endfunction
    function SvServantEmiya__onAttackRankA takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SvServantEmiya__onAttackThrust(GetTriggerUnit() , GetEventDamageSource() , 20.00 , 3.00)
    endfunction
    function SvServantEmiya__onAttackRankS takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SvServantEmiya__onAttackThrust(GetTriggerUnit() , GetEventDamageSource() , 25.00 , 5.00)
    endfunction
    function SvServantEmiya__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvServantEmiya__ODMG[lv])
        //Adding Special Skillz
        if lv == 3 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvServantEmiya__onAttack)
        endif
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvServantEmiya__onAttackRankB)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A088')
            call UnitAddAbility(s__eventServantAdd_e, 'A03G')
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvServantEmiya__onAttackRankA)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0CR')
            call UnitAddAbility(s__eventServantAdd_e, 'A0CT')
            call sc__EV159EmiyaB_append(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvServantEmiya__onAttackRankS)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0CS')
            call UnitAddAbility(s__eventServantAdd_e, 'A0CU')
            call sc__EV159EmiyaB_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvServantEmiya__main takes nothing returns nothing
        set SvServantEmiya__ODMG[3]=75
        set SvServantEmiya__ODMG[4]=150
        set SvServantEmiya__ODMG[5]=375
        set SvServantEmiya__ODMG[6]=1200
        call s__eventServantAdd_register(SV_EMIYA + OFF_C , function SvServantEmiya__onServantGet)
        call s__eventServantAdd_register(SV_EMIYA + OFF_B , function SvServantEmiya__onServantGet)
        call s__eventServantAdd_register(SV_EMIYA + OFF_A , function SvServantEmiya__onServantGet)
        call s__eventServantAdd_register(SV_EMIYA + OFF_S , function SvServantEmiya__onServantGet)
    endfunction
// scope SvServantEmiya ends
