    function TrigFactionAlteraBatchBuilding__CreateSkillBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 0)
        local real y= FXGetPlayerBuildingLocationY(p , 0)
        local unit u= CreateUnit(p, 'H012', x, y, 270)
        call SuspendHeroXP(u, true)
        set FXRD_TOWER[GetPlayerId(p)]=u
        set u=null
    endfunction
    function TrigFactionAlteraBatchBuilding__CreateUpgradeBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 1)
        local real y= FXGetPlayerBuildingLocationY(p , 1)
        local unit u= CreateUnit(p, 'H009', x, y, 270)
        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    function TrigFactionAlteraBatchBuilding__CreateGachaBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 2)
        local real y= FXGetPlayerBuildingLocationY(p , 2)
        local unit u= CreateUnit(p, IntegerTertiaryOp(GetPanalty(PANALTY_NURF_GACHA), 'H00E', 'H002'), x, y, 270)
        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    function TrigFactionAlteraBatchBuilding__CreateConvBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 3)
        local real y= FXGetPlayerBuildingLocationY(p , 3)
