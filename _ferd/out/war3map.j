    function FXActionRegisterUnitBeforeJohabEvent takes code c returns triggeraction
        return TriggerAddAction(FXEventUnitJohab__t, c)
    endfunction
    function FXGetJohabUnit takes nothing returns unit
        return FXEventUnitJohab__U
    endfunction
    function FXAbortJohab takes nothing returns nothing
        set FXEventUnitJohab__A=false
    endfunction
    function FXFireUnitBeforeJohabEvent takes unit src returns boolean
        local unit pu= FXEventUnitJohab__U
        local boolean pa= FXEventUnitJohab__A
        local boolean ra
        set FXEventUnitJohab__U=src
        set FXEventUnitJohab__A=true
        call TriggerExecute(FXEventUnitJohab__t)
        set ra=FXEventUnitJohab__A
        set FXEventUnitJohab__A=pa
        set FXEventUnitJohab__U=pu
        set pu=null
        return ra
    endfunction

