    function s__CMBlessofWisdomSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMBlessofWisdomSingle_myDummy[this])
        call ShowUnit(s__CMBlessofWisdomSingle_myDummy[this], false)
        set s__CMBlessofWisdomSingle_myDummy[this]=null
        set s__CMBlessofWisdomSingle_caster[this]=null
        set s__CMBlessofWisdomSingle_target[this]=null
        call s__tick_destroy(s__CMBlessofWisdomSingle_main[this])
    endfunction
    function s__CMBlessofWisdomSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl", s__CMBlessofWisdomSingle_target[this], "chest"))
        if IsUnitType(s__CMBlessofWisdomSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMBlessofWisdomSingle_myDummy[this], "overhead"))
        else
            call s__EVDebuffSlow_apply(GetEnumUnit() , 2.00)
            if IsUnitType(s__CMBlessofWisdomSingle_target[this], UNIT_TYPE_UNDEAD) then
                call FXRD_FXDebuffShock(GetEnumUnit() , 1.00)
            endif
            call s__enemy_dealLogic(s__CMBlessofWisdomSingle_caster[this] , s__CMBlessofWisdomSingle_target[this] , s__CMBlessofWisdomSingle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMBlessofWisdomSingle_myDummy[this] , 0 , 0 , 0 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMBlessofWisdomSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMBlessofWisdomSingle_main[this],0.20 , false , function s__CMBlessofWisdomSingle_onFinal)
    endfunction
    function s__CMBlessofWisdomSingle_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real dist= 150
        local real angle= GetRandomReal(0.00, 360.00)
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            set dist=75
            set dmg=dmg * 2
        endif
        set s__CMBlessofWisdomSingle_caster[this]=src
        set s__CMBlessofWisdomSingle_target[this]=dst
        set s__CMBlessofWisdomSingle_damage[this]=dmg
        set s__CMBlessofWisdomSingle_main[this]=this
        set s__CMBlessofWisdomSingle_myDummy[this]=CreateUnit(Player(15), 'o008', GetUnitX(dst) + s__Polar_X(dist * 2 , angle), GetUnitY(dst) + s__Polar_Y(dist * 2 , angle), angle - 180)
        call sc__DummyKnockback_cast(s__CMBlessofWisdomSingle_myDummy[this] , dist , angle - 180 , 0 , 0.20)
        call sc__DummyColorChanger_cast(s__CMBlessofWisdomSingle_myDummy[this] , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 128 , 0.20)
        call SetUnitAnimation(s__CMBlessofWisdomSingle_myDummy[this], "attack")
        call SetUnitTimeScale(s__CMBlessofWisdomSingle_myDummy[this], 3.00)
        call s__tick_start(s__CMBlessofWisdomSingle_main[this],0.20 , true , function s__CMBlessofWisdomSingle_onFire)
    endfunction

    //
    function s__CMBlessofWisdom_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__CMBlessofWisdom_CNT) == 0 then
            set s__CMBlessofWisdom_DEST=GetEnumUnit()
        endif
        set s__CMBlessofWisdom_CNT=s__CMBlessofWisdom_CNT + 1
    endfunction
    function s__CMBlessofWisdom_GetRandomEnemy takes unit src,real x,real y,real r returns unit
        set s__CMBlessofWisdom_DEST=null
        set s__CMBlessofWisdom_CNT=0
        call s__splash_range(s__splash_ENEMY , src , x , y , r , function s__CMBlessofWisdom_enumGetTarget)
        return s__CMBlessofWisdom_DEST
    endfunction
    //
    function s__CMBlessofWisdom_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local unit target= null
        if s__CMBlessofWisdom_loops[this] < 1 or IsUnitType(s__CMBlessofWisdom_caster[this], UNIT_TYPE_DEAD) then
            set s__CMBlessofWisdom_caster[this]=null
            call s__tick_destroy(s__CMBlessofWisdom_main[this])
            return
        endif
        set target=s__CMBlessofWisdom_GetRandomEnemy(s__CMBlessofWisdom_caster[this] , s__CMBlessofWisdom_ox[this] , s__CMBlessofWisdom_oy[this] , s__CMBlessofWisdom_range[this])
        set s__CMBlessofWisdom_DEST=null
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", GetUnitX(s__CMBlessofWisdom_caster[this]), GetUnitY(s__CMBlessofWisdom_caster[this])))
        if target != null then
            call s__CMBlessofWisdomSingle_cast(s__CMBlessofWisdom_caster[this] , target , s__CMBlessofWisdom_damage[this])
        endif
        set target=null
        set s__CMBlessofWisdom_loops[this]=s__CMBlessofWisdom_loops[this] - 1
    endfunction
    function s__CMBlessofWisdom_cast takes unit src,real x,real y,real rng,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMBlessofWisdom_caster[this]=src
        set s__CMBlessofWisdom_damage[this]=dmg
        set s__CMBlessofWisdom_range[this]=rng
        set s__CMBlessofWisdom_loops[this]=5
        set s__CMBlessofWisdom_ox[this]=x
        set s__CMBlessofWisdom_oy[this]=y
        set s__CMBlessofWisdom_main[this]=this
        call s__tick_start(s__CMBlessofWisdom_main[this],0.40 , true , function s__CMBlessofWisdom_onFireStart)
    endfunction
