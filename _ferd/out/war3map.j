//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 준_서번트_선언_개시("BBSS")
// scope SVBBSS begins
//end of: 준_서번트_선언_개시("BBSS")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        
    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVBBSS__OnAnylevel takes nothing returns nothing
            // 영웅이라 기본공추가가 안먹음
            call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , 100)
            //Adding Special Skillz
            call sc__ABILBBSSDamageStat_append(s__eventServantAdd_e , 1.0)
            call sc__ABILBBSSDomina_append(s__eventServantAdd_e)
            call sc__ABILBBSSPotnia_append(s__eventServantAdd_e , 0.5)
            call sc__ABILBBSSAConsume_append(s__eventServantAdd_e)
            call sc__ABILBBSSBAllKill_append(s__eventServantAdd_e)
            call sc__ABILBBSSCCCC_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVBBSS__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVBBSS__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVBBSS__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVBBSS__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록_확장("H014","8","100","Anylevel")
        set SVBBSS__SERVANT_DAMAGE[8]=100
        call s__eventServantAdd_register('H014' , function SVBBSS__Anylevel)
//end of: 서번트_등록_확장("H014","8","100","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVBBSS ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("BBSSDamageStat")
//end of: 어빌리티_선언_개시("BBSSDamageStat")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILBBSSDamageStat_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBBSSDamageStat_rmTrig[this], s__ABILBBSSDamageStat_rmAct[this])
        set s__ABILBBSSDamageStat_rmAct[this]=null
        set s__ABILBBSSDamageStat_rmTrig[this]=null
        call sc__ABILBBSSDamageStat_onAbilityLost(this)
        call s__tick_destroy(s__ABILBBSSDamageStat_durTik[this])
        set s__ABILBBSSDamageStat_source[this]=null
        set s__ABILBBSSDamageStat_exists[this]=false
    endfunction
    
    function s__ABILBBSSDamageStat_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSDamageStat_free(this)
    endfunction
    
    function s__ABILBBSSDamageStat_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILBBSSDamageStat_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILBBSSDamageStat_source[this]) then
            return
        endif
        call sc__ABILBBSSDamageStat_onAbilityEffect(this)
        call s__tick_start(s__ABILBBSSDamageStat_durTik[this],s__ABILBBSSDamageStat_duration[this] , false , function s__ABILBBSSDamageStat_onExpire)
    endfunction
    
    function s__ABILBBSSDamageStat_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSDamageStat_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSDamageStat_exists[this] then
            set s__ABILBBSSDamageStat_exists[this]=true
            set s__ABILBBSSDamageStat_source[this]=src
            set s__ABILBBSSDamageStat_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSDamageStat_rmAct[this]=TriggerAddAction(s__ABILBBSSDamageStat_rmTrig[this], function s__ABILBBSSDamageStat_OnSourceRemove)
            
            set s__ABILBBSSDamageStat_duration[this]=dur
            set s__ABILBBSSDamageStat_defaultDuration[this]=dur
            set s__ABILBBSSDamageStat_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILBBSSDamageStat_durTik[this],dur , false , function s__ABILBBSSDamageStat_onExpire)
            call sc__ABILBBSSDamageStat_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILBBSSDamageStat_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILBBSSDamageStat_PrevStrength[this]=GetHeroStr(s__ABILBBSSDamageStat_source[this], true) * 20
        set s__ABILBBSSDamageStat_PrevBonus[this]=20 * ( GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10 )
        call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EN', 1 + GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10)
        call sc__EVDamageManager_addOrigin(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevStrength[this])
        call sc__EVDamageManager_addBonus(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevBonus[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILBBSSDamageStat_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBBSSDamageStat_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer selfModLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 5, 1, 2)
        local integer cccLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 30, 1, 2)
        local integer ultiLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 30, 1, 2)
        local integer dominaLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 15, 1, 2)
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EM') != selfModLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EM', selfModLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EQ') != cccLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EQ', cccLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0ET') != ultiLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0ET', ultiLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EO') != dominaLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EO', dominaLev)
        endif
        call sc__EVDamageManager_addOrigin(s__ABILBBSSDamageStat_source[this] , - s__ABILBBSSDamageStat_PrevStrength[this])
        call sc__EVDamageManager_addBonus(s__ABILBBSSDamageStat_source[this] , - s__ABILBBSSDamageStat_PrevBonus[this])
        set s__ABILBBSSDamageStat_PrevStrength[this]=GetHeroStr(s__ABILBBSSDamageStat_source[this], true) * 20
        set s__ABILBBSSDamageStat_PrevBonus[this]=20 * ( GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10 )
        call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EN', 1 + GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10)
        call sc__EVDamageManager_addOrigin(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevStrength[this])
        call sc__EVDamageManager_addBonus(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevBonus[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//textmacro instance: 어빌리티_선언_개시("BBSSDomina")
//end of: 어빌리티_선언_개시("BBSSDomina")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILBBSSDomina_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBBSSDomina_rmTrig[this], s__ABILBBSSDomina_rmAct[this])
        set s__ABILBBSSDomina_rmAct[this]=null
        set s__ABILBBSSDomina_rmTrig[this]=null
        call sc__ABILBBSSDomina_onAbilityLost(this)
        set s__ABILBBSSDomina_source[this]=null
        set s__ABILBBSSDomina_exists[this]=false
    endfunction
    
    function s__ABILBBSSDomina_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSDomina_free(this)
    endfunction
    
    function s__ABILBBSSDomina_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILBBSSDomina_onAbilityEffect(this)
    endfunction
    
    function s__ABILBBSSDomina_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSDomina_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSDomina_exists[this] then
            set s__ABILBBSSDomina_exists[this]=true
            set s__ABILBBSSDomina_source[this]=src
            set s__ABILBBSSDomina_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSDomina_rmAct[this]=TriggerAddAction(s__ABILBBSSDomina_rmTrig[this], function s__ABILBBSSDomina_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILBBSSDomina_onSourceUnitAttack)
            call sc__ABILBBSSDomina_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILBBSSDomina_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILBBSSDomina_Combo[this]=0
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILBBSSDomina_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBBSSDomina_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        local real dmg= sc__EVDamageManager_getFinalDamage(src)
        set s__ABILBBSSDomina_Combo[this]=s__ABILBBSSDomina_Combo[this] + 1
        if s__ABILBBSSDomina_Combo[this] >= 3 then
            if GetUnitAbilityLevel(src, 'A0EO') > 1 then
                set dmg=dmg * 10.0
                if IsUnitType(dst, UNIT_TYPE_GIANT) then
                    call UnitAddAbility(dst, 'A07G')
                endif
            else
                set dmg=dmg * 5.0
            endif
            call FXRD_FXDebuffShock(dst , 1.0)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", dst, "origin"))
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02C', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst)))
            set s__ABILBBSSDomina_Combo[this]=0
        else
            //call EVDebuffSlow.apply( dst, 1.0 )
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
        endif
        call SetUnitState(s__ABILBBSSDomina_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILBBSSDomina_source[this], UNIT_STATE_MANA) + 5.0 + GetHeroAgi(s__ABILBBSSDomina_source[this], true) * 0.02)
        call s__enemy_dealLogic(src , dst , dmg , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//textmacro instance: 어빌리티_선언_개시("BBSSPotnia")
//end of: 어빌리티_선언_개시("BBSSPotnia")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
