//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILMashuCRest_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMashuCRest_rmTrig[this], s__ABILMashuCRest_rmAct[this])
        set s__ABILMashuCRest_rmAct[this]=null
        set s__ABILMashuCRest_rmTrig[this]=null
        call sc__ABILMashuCRest_onAbilityLost(this)
        call s__tick_destroy(s__ABILMashuCRest_durTik[this])
        set s__ABILMashuCRest_source[this]=null
        set s__ABILMashuCRest_exists[this]=false
    endfunction
    
    function s__ABILMashuCRest_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMashuCRest_free(this)
    endfunction
    
    function s__ABILMashuCRest_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILMashuCRest_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILMashuCRest_source[this]) then
            return
        endif
        call sc__ABILMashuCRest_onAbilityEffect(this)
        call s__tick_start(s__ABILMashuCRest_durTik[this],s__ABILMashuCRest_duration[this] , false , function s__ABILMashuCRest_onExpire)
    endfunction
    
    function s__ABILMashuCRest_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMashuCRest_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMashuCRest_exists[this] then
            set s__ABILMashuCRest_exists[this]=true
            set s__ABILMashuCRest_source[this]=src
            set s__ABILMashuCRest_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMashuCRest_rmAct[this]=TriggerAddAction(s__ABILMashuCRest_rmTrig[this], function s__ABILMashuCRest_OnSourceRemove)
            
            set s__ABILMashuCRest_duration[this]=dur
            set s__ABILMashuCRest_defaultDuration[this]=dur
            set s__ABILMashuCRest_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILMashuCRest_durTik[this],dur , false , function s__ABILMashuCRest_onExpire)
            call sc__ABILMashuCRest_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
