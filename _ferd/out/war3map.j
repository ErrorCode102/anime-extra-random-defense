    function UIResultStat___onClosing takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        call sc__InterfaceNumpad_destroy(UIResultStat___NUM_LV[ui])
        call sc__InterfaceNumpad_destroy(UIResultStat___NUM_XP[ui])
        
        call sc__InterfaceNumpad_destroy(UIResultStat___NUM_BASE[ui])
        call sc__InterfaceNumpad_destroy(UIResultStat___NUM_BONUS[ui])
        call sc__InterfaceNumpad_destroy(UIResultStat___NUM[ui])
        
        call RemoveDestructable(UIResultStat___BACKDROP_BASE[ui])
        call RemoveDestructable(UIResultStat___BACKDROP_BONUS[ui])
        call RemoveDestructable(UIResultStat___BACKDROP[ui])
        set UIResultStat___BACKDROP_BASE[ui]=null
        set UIResultStat___BACKDROP_BONUS[ui]=null
        set UIResultStat___BACKDROP[ui]=null
        
        call RemoveDestructable(UIResultStat___MILESTONE[ui])
        call RemoveDestructable(UIResultStat___MILESTONE_MASTER[ui])
        call RemoveDestructable(UIResultStat___MILESTONE_MAX[ui])
        set UIResultStat___MILESTONE[ui]=null
        set UIResultStat___MILESTONE_MASTER[ui]=null
        set UIResultStat___MILESTONE_MAX[ui]=null
        
        set p=null
    endfunction
    
    function UIResultStat___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        
        local string path
        if s__FXResultInterface_CurPlayerMastered[parent] then
            set path="FXRD\\Numbers\\GoldNeon\\"
        else
            set path="FXRD\\Numbers\\BlueNeon\\"
        endif
        
        set UIResultStat___NUM_LV[ui]=sc__InterfaceNumpad_create(p , 5424 + 64 , 62.00 - 192.00 , path , 0.50)
        set UIResultStat___NUM_XP[ui]=sc__InterfaceNumpad_create(p , 5350 + 64 , - 64.00 - 192.00 , path , 0.00)
        
        set UIResultStat___NUM_BASE[ui]=sc__InterfaceNumpad_create(p , 5350 + 96 , 16.00 + 192.00 , path , 0.0)
        set UIResultStat___NUM_BONUS[ui]=sc__InterfaceNumpad_create(p , 5350 + 96 , 16.00 + 96.00 , path , 0.0)
        set UIResultStat___NUM[ui]=sc__InterfaceNumpad_create(p , 5350 + 96 , 16.00 , path , 0.0)
        
        set UIResultStat___BACKDROP_BASE[ui]=CreateDestructableZ('B01X', 5408.0, 320.0 - 64.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___BACKDROP_BASE[ui], false)
        set UIResultStat___BACKDROP_BONUS[ui]=CreateDestructableZ('B01Y', 5408.0, 320.0 - 64.0 - 96.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___BACKDROP_BONUS[ui], false)
        set UIResultStat___BACKDROP[ui]=CreateDestructableZ('B01Z', 5408.0, 320.0 - 64.0 - 192.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___BACKDROP[ui], false)
    
        set UIResultStat___MILESTONE[ui]=CreateDestructableZ('B007', 5408.0 + 64.0, 64.0 - 192.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___MILESTONE[ui], false)
        set UIResultStat___MILESTONE_MASTER[ui]=CreateDestructableZ('B02A', 5408.0 + 64.0, 64.0 - 192.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___MILESTONE_MASTER[ui], false)
        set UIResultStat___MILESTONE_MAX[ui]=CreateDestructableZ('B02B', 5408.0 + 64.0, 64.0 - 192.0, 0.0, 270, 1.5, 0)
        call ShowDestructable(UIResultStat___MILESTONE_MAX[ui], false)
        
        set p=null
    endfunction
    
    function UIResultStat___onUpdating takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        local boolean isMastered= s__FXResultInterface_CurPlayerMastered[parent]
        local boolean isMaxed= isMastered and ( s__FXResultInterface_CurPlayerLevel[parent] == FX_MASTER_MAX_LEVEL )
        local boolean isVisible= s__FXResultInterface_Visible[parent]
        
        local integer xpcap
        if isMastered then
            set xpcap=FXGetMasterXpReq(s__FXResultInterface_CurPlayerLevel[parent])
        else
            set xpcap=FXGetXpReq(s__FXResultInterface_CurPlayerLevel[parent])
        endif
        
        call sc__InterfaceNumpad__set_text(UIResultStat___NUM_XP[ui],I2S(s__FXResultInterface_CurPlayerXP[parent]) + "S" + I2S(xpcap))
        call sc__InterfaceNumpad__set_text(UIResultStat___NUM_LV[ui],I2S(s__FXResultInterface_CurPlayerLevel[parent]))
        
        call sc__InterfaceNumpad__set_text(UIResultStat___NUM_BASE[ui],I2S(s__FXResultInterface_CurXPBase[parent]))
        call sc__InterfaceNumpad__set_text(UIResultStat___NUM_BONUS[ui],I2S(s__FXResultInterface_CurXPBonus[parent]))
        call sc__InterfaceNumpad__set_text(UIResultStat___NUM[ui],I2S(s__FXResultInterface_CurXP[parent]))
        
        if GetLocalPlayer() == p then
            call ShowDestructable(UIResultStat___BACKDROP_BASE[ui], isVisible)
            call ShowDestructable(UIResultStat___BACKDROP_BONUS[ui], isVisible)
            call ShowDestructable(UIResultStat___BACKDROP[ui], isVisible)
            if isMastered then
                call ShowDestructable(UIResultStat___MILESTONE[ui], false)
                call ShowDestructable(UIResultStat___MILESTONE_MASTER[ui], not isMaxed)
                call ShowDestructable(UIResultStat___MILESTONE_MAX[ui], isMaxed)
            else
                call ShowDestructable(UIResultStat___MILESTONE[ui], true)
                call ShowDestructable(UIResultStat___MILESTONE_MASTER[ui], false)
                call ShowDestructable(UIResultStat___MILESTONE_MAX[ui], false)
            endif
        endif
        
        set p=null
    endfunction
    
    function UIResultStat___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultStat___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_UPDATING , function UIResultStat___onUpdating)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultStat___onClosing)
    endfunction
    
// scope UIResultStat ends
// Trigger: Mod UI Result Calc Effect
//===========================================================================
// scope UIResultCalcEffect begins


    function UIResultCalcEffect___onClosing takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        if GetLocalPlayer() == Player(ui) then
            call StopSound(gg_snd_XP_UP, false, false)
        endif
            
        call s__tick_destroy(UIResultCalcEffect___TICK[ui])
        
        set p=null
    endfunction
    
    function UIResultCalcEffect___CallBackStat takes nothing returns nothing
        local integer ui= s__tick_data[s__tick_getExpired()]
        local integer parent= (ui)
        
        local integer xpmax
        
        local boolean gainingRequired= true
        if s__FXResultInterface_CurPlayerLevel[parent] >= s__FXResultInterface_PlayerLevel[parent] then
            if s__FXResultInterface_CurPlayerXP[parent] >= s__FXResultInterface_PlayerXP[parent] then
                set gainingRequired=false
            endif
        endif
        
        if not gainingRequired then
            call s__tick_pause(UIResultCalcEffect___TICK[ui])
            if GetLocalPlayer() == Player(ui) then
                call StopSound(gg_snd_XP_UP, false, false)
            endif
            if GetLocalPlayer() == Player(ui) then
                call StopSound(gg_snd_LEVEL_UP, false, false)
            endif
            if s__FXResultInterface_Result[parent] == s__FXGameResult_Victory then
                call StartSoundForPlayerBJ(Player(ui), gg_snd_XP_GAIN_DONE)
                call StartSoundForPlayerBJ(Player(ui), gg_snd_GAME_VICTORY)
            else
                call StartSoundForPlayerBJ(Player(ui), gg_snd_GAME_DEFEAT)
            endif
        endif
        
        if s__FXResultInterface_CurPlayerMastered[parent] then
            set xpmax=FXGetMasterXpReq(s__FXResultInterface_CurPlayerLevel[parent])
        else
            set xpmax=FXGetXpReq(s__FXResultInterface_CurPlayerLevel[parent])
        endif
        
        if s__FXResultInterface_CurPlayerLevel[parent] >= s__FXResultInterface_PlayerLevel[parent] then
            set xpmax=s__FXResultInterface_PlayerXP[parent]
            set s__FXResultInterface_CurPlayerXP[parent]=IMinBJ(s__FXResultInterface_CurPlayerXP[parent] + 1000, xpmax)
        else
            set s__FXResultInterface_CurPlayerXP[parent]=IMinBJ(s__FXResultInterface_CurPlayerXP[parent] + 1000, xpmax)
            if s__FXResultInterface_CurPlayerXP[parent] == xpmax then
                set s__FXResultInterface_CurPlayerLevel[parent]=s__FXResultInterface_CurPlayerLevel[parent] + 1
                set s__FXResultInterface_CurPlayerXP[parent]=0
                if GetLocalPlayer() == Player(ui) then
                    call StopSound(gg_snd_LEVEL_UP, false, false)
                endif
                call StartSoundForPlayerBJ(Player(ui), gg_snd_LEVEL_UP)
            endif
        endif
        
        call RRRequestPlayer(REQUEST_UI_RESULT_UPDATE , Player(ui))
    endfunction
    
    function UIResultCalcEffect___CallBackXp takes nothing returns nothing
        local integer ui= s__tick_data[s__tick_getExpired()]
        local integer parent= (ui)
        
        if s__FXResultInterface_CurXP[parent] >= s__FXResultInterface_XP[parent] then
            call s__tick_start(UIResultCalcEffect___TICK[ui],0.03125 , true , function UIResultCalcEffect___CallBackStat)
            if GetLocalPlayer() == Player(ui) then
                call StopSound(gg_snd_XP_GAIN, false, false)
            endif
            call StartSoundForPlayerBJ(Player(ui), gg_snd_XP_GAIN)
        endif
        set s__FXResultInterface_CurXP[parent]=IMinBJ(s__FXResultInterface_XP[parent], s__FXResultInterface_CurXP[parent] + 1000)
        
        call RRRequestPlayer(REQUEST_UI_RESULT_UPDATE , Player(ui))
    endfunction
    function UIResultCalcEffect___CallBackXpBonus takes nothing returns nothing
        local integer ui= s__tick_data[s__tick_getExpired()]
        local integer parent= (ui)
        
        if s__FXResultInterface_CurXPBonus[parent] >= s__FXResultInterface_XPBonus[parent] then
            call s__tick_start(UIResultCalcEffect___TICK[ui],0.03125 , true , function UIResultCalcEffect___CallBackXp)
            if GetLocalPlayer() == Player(ui) then
                call StopSound(gg_snd_XP_GAIN, false, false)
            endif
            call StartSoundForPlayerBJ(Player(ui), gg_snd_XP_GAIN)
        endif
        set s__FXResultInterface_CurXPBonus[parent]=IMinBJ(s__FXResultInterface_XPBonus[parent], s__FXResultInterface_CurXPBonus[parent] + 1000)
        
        call RRRequestPlayer(REQUEST_UI_RESULT_UPDATE , Player(ui))
    endfunction
    function UIResultCalcEffect___CallBackXpBase takes nothing returns nothing
        local integer ui= s__tick_data[s__tick_getExpired()]
        local integer parent= (ui)
        
        if s__FXResultInterface_CurXPBase[parent] >= s__FXResultInterface_XPBase[parent] then
            call s__tick_start(UIResultCalcEffect___TICK[ui],0.03125 , true , function UIResultCalcEffect___CallBackXpBonus)
            call StartSoundForPlayerBJ(Player(ui), gg_snd_XP_GAIN)
        endif
        set s__FXResultInterface_CurXPBase[parent]=IMinBJ(s__FXResultInterface_XPBase[parent], s__FXResultInterface_CurXPBase[parent] + 1000)
        
        call RRRequestPlayer(REQUEST_UI_RESULT_UPDATE , Player(ui))
    endfunction
    
    function UIResultCalcEffect___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        
        set UIResultCalcEffect___TICK[ui]=s__tick_create(ui)
        call s__tick_start(UIResultCalcEffect___TICK[ui],0.03125 , true , function UIResultCalcEffect___CallBackXpBase)
        call StartSoundForPlayerBJ(p, gg_snd_XP_UP)
    
        set p=null
    endfunction
    
    function UIResultCalcEffect___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultCalcEffect___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultCalcEffect___onClosing)
    endfunction
    
