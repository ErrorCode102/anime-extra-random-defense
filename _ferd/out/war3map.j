//textmacro instance: 어빌리티_선언_개시("HeroineXCalibur")
//end of: 어빌리티_선언_개시("HeroineXCalibur")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0G6")
    
    function s__ABILHeroineXCalibur_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILHeroineXCalibur_onSpellEffect[this], s__ABILHeroineXCalibur_onSpellEffectAction[this])
        set s__ABILHeroineXCalibur_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILHeroineXCalibur_onSpellEffect[this])
        set s__ABILHeroineXCalibur_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILHeroineXCalibur_rmTrig[this], s__ABILHeroineXCalibur_rmAct[this])
        set s__ABILHeroineXCalibur_rmAct[this]=null
        set s__ABILHeroineXCalibur_rmTrig[this]=null
        call sc__ABILHeroineXCalibur_onAbilityLost(this)
        set s__ABILHeroineXCalibur_source[this]=null
        set s__ABILHeroineXCalibur_exists[this]=false
    endfunction
    
    function s__ABILHeroineXCalibur_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILHeroineXCalibur_free(this)
    endfunction
    
    function s__ABILHeroineXCalibur_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILHeroineXCalibur_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILHeroineXCalibur_exists[this] then
            set s__ABILHeroineXCalibur_exists[this]=true
            set s__ABILHeroineXCalibur_source[this]=src
            set s__ABILHeroineXCalibur_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILHeroineXCalibur_rmAct[this]=TriggerAddAction(s__ABILHeroineXCalibur_rmTrig[this], function s__ABILHeroineXCalibur_OnSourceRemove)
            set s__ABILHeroineXCalibur_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILHeroineXCalibur_onSpellEffect[this], Condition(function sc__ABILHeroineXCalibur_conditionSpellEffect))
            set s__ABILHeroineXCalibur_onSpellEffectAction[this]=TriggerAddAction(s__ABILHeroineXCalibur_onSpellEffect[this], function sc__ABILHeroineXCalibur_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILHeroineXCalibur_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILHeroineXCalibur_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILHeroineXCalibur_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILHeroineXCalibur_exists[this] then
            return
        endif
        call sc__ABILHeroineXCalibur_onAbilityEffect(this)
    endfunction
    
    function s__ABILHeroineXCalibur_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILHeroineXCalibur_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0G6")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILHeroineXCalibur_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILHeroineXCalibur_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILHeroineXCalibur_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILHeroineXCalibur_source[this])
        if GetUnitAbilityLevel(s__ABILHeroineXCalibur_source[this], s__ABILHeroineXCalibur_ABILITY) == 1 then
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0FK') == 0 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXCalibur_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXCalibur_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant not classified as Artoria.|r")
                set p=null
                return
            endif
            if GetUnitLevel(GetSpellTargetUnit()) != 5 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXCalibur_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXCalibur_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant's grade is too low to be sacrificed.|r")
                set p=null
                return
            endif
            call s__servant_kill(GetSpellTargetUnit() , true)
            call sc__EVDamageManager_addBonus(s__ABILHeroineXCalibur_source[this] , 100)
            call SetUnitAbilityLevel(s__ABILHeroineXCalibur_source[this], s__ABILHeroineXCalibur_ABILITY, 2)
            call SetUnitAbilityLevel(s__ABILHeroineXCalibur_source[this], 'A0FH', 2)
            call UnitRemoveAbility(s__ABILHeroineXCalibur_source[this], 'A0GC')
            call UnitAddAbility(s__ABILHeroineXCalibur_source[this], 'A0G5')
        else
            call sc__CMHeroineXSecret_cast(s__ABILHeroineXCalibur_source[this] , GetSpellTargetUnit() , sc__EVDamageManager_getFinalDamage(s__ABILHeroineXCalibur_source[this]) * 1.6 , 50 , 0)
        endif
        set p=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

