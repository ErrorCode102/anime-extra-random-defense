    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_마나수급형_차등("OnMeleeAttack","1","5")
        function SVMELT___OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            else
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1)
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_마나수급형_차등("OnMeleeAttack","1","5")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVMELT___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVMELT___OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVMELT___OnAnylevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMELT___MeleeAttack)
            call sc__EVDamageManager_addBonus(s__eventServantAdd_e , 20)
            call UnitAddAbility(s__eventServantAdd_e, 'A0E2')
            call sc__ABILMeltASadist_append(s__eventServantAdd_e , 1.0)
            call sc__ABILMeltCMeltout_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0D0')
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVMELT___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVMELT___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVMELT___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
