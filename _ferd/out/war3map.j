    endfunction
    function s__CMWeaponfireMissle_cast takes unit src,real tx,real ty,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBP(src , tx , ty)
        local real x= GetUnitX(src) + s__Polar_X(100 , ang)
        local real y= GetUnitY(src) + s__Polar_Y(100 , ang)
        call KillUnit(CreateUnit(Player(15), 'o01H', GetUnitX(src), GetUnitY(src), ang))
        set s__CMWeaponfireMissle_caster[this]=src
        set s__CMWeaponfireMissle_damage[this]=dmg
        set s__CMWeaponfireMissle_count[this]=0
        set s__CMWeaponfireMissle_myG[this]=CreateGroup()
        set s__CMWeaponfireMissle_main[this]=this
        set s__CMWeaponfireMissle_myDummy[this]=CreateUnit(Player(15), 'o01I', x, y, ang)
        call sc__DummyKnockback_cast(s__CMWeaponfireMissle_myDummy[this] , 800 , ang , 0 , 0.20)
        call s__tick_start(s__CMWeaponfireMissle_main[this],0.04 , true , function s__CMWeaponfireMissle_onFire)
    endfunction

    function s__CMGateofabaylon_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang
        if s__CMGateofabaylon_loops[this] < 1 or IsUnitType(s__CMGateofabaylon_caster[this], UNIT_TYPE_DEAD) then
            set s__CMGateofabaylon_caster[this]=null
            call s__tick_destroy(s__CMGateofabaylon_main[this])
            return
        endif
        set ang=GetUnitFacing(s__CMGateofabaylon_caster[this]) + GetRandomReal(- 45, 45)
        call s__CMWeaponfireMissle_cast(s__CMGateofabaylon_caster[this] , GetUnitX(s__CMGateofabaylon_caster[this]) + s__Polar_X(800 , ang) , GetUnitY(s__CMGateofabaylon_caster[this]) + s__Polar_Y(800 , ang) , s__CMGateofabaylon_damage[this])
        set s__CMGateofabaylon_loops[this]=s__CMGateofabaylon_loops[this] - 1
    endfunction
    function s__CMGateofabaylon_cast takes unit src,real dmg,integer cmb returns nothing
        local integer this= s__tick_create(0)
        set s__CMGateofabaylon_caster[this]=src
        set s__CMGateofabaylon_damage[this]=dmg
        set s__CMGateofabaylon_loops[this]=cmb
        set s__CMGateofabaylon_main[this]=this
        call s__tick_start(s__CMGateofabaylon_main[this],0.05 , true , function s__CMGateofabaylon_onFireStart)
    endfunction
