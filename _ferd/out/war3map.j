// scope CHEATPLAY begins
    function CHEATPLAY___onCopyServant takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local unit u= GetTriggerUnit()
        if GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_PASSIVE) then
            set CHEATPLAY___DST=GetTriggerUnit()
            set u=null
            return
        endif
        if not IsUnitType(u, UNIT_TYPE_TAUREN) then
            set u=null
            return
        endif
        set u=CreateUnit(GetTriggerPlayer(), GetUnitTypeId(GetTriggerUnit()), GetPlayerStartLocationX(GetTriggerPlayer()), GetPlayerStartLocationY(GetTriggerPlayer()), 270.00)
        call s__servant_add(GetTriggerPlayer() , u , s__servant_BOUNTY)
        set u=null
    endfunction
    function CHEATPLAY___onCheat takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if GetEventPlayerChatString() == "-1" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 1)
        endif
        if GetEventPlayerChatString() == "-2" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 2)
        endif
        if GetEventPlayerChatString() == "-3" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 3)
        endif
        if GetEventPlayerChatString() == "-4" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 4)
        endif
        if GetEventPlayerChatString() == "-5" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 5)
        endif
        if GetEventPlayerChatString() == "-6" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 6)
        endif
        if GetEventPlayerChatString() == "-7" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 7)
        endif
        if GetEventPlayerChatString() == "-8" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 8)
        endif
        if GetEventPlayerChatString() == "-9" then
            call SetUnitAnimationByIndex(CHEATPLAY___DST, 9)
        endif
        if GetEventPlayerChatString() == "-10" then
            call SetUserWave(GetTriggerPlayer() , 9)
        endif
        if GetEventPlayerChatString() == "-20" then
            call SetUserWave(GetTriggerPlayer() , 19)
        endif
        if GetEventPlayerChatString() == "-30" then
            call SetUserWave(GetTriggerPlayer() , 29)
        endif
        if GetEventPlayerChatString() == "-40" then
            call SetUserWave(GetTriggerPlayer() , 39)
        endif
        if GetEventPlayerChatString() == "-50" then
            call SetUserWave(GetTriggerPlayer() , 49)
        endif
        if GetEventPlayerChatString() == "-60" then
            call SetUserWave(GetTriggerPlayer() , 59)
        endif
        if GetEventPlayerChatString() == "-70" then
            call SetUserWave(GetTriggerPlayer() , 69)
        endif
        if GetEventPlayerChatString() == "-80" then
            call SetUserWave(GetTriggerPlayer() , 79)
        endif
        if GetEventPlayerChatString() == "-90" then
            call SetUserWave(GetTriggerPlayer() , 89)
        endif
        if GetEventPlayerChatString() == "-100" then
            call SetUserWave(GetTriggerPlayer() , 99)
        endif
        if GetEventPlayerChatString() == "-mission" then
            call SetPlayerTechResearched(GetTriggerPlayer(), 'R0WA', 8)
        endif
        if GetEventPlayerChatString() == "-win" then
            call RRRequestPlayer(REQUEST_GAME_PLAYER_VICTORY , GetTriggerPlayer())
            //call FXRDVictory( GetTriggerPlayer(), true ) (구 승리 코드, 다음에 보면 지울 것)
        endif
        if GetEventPlayerChatString() == "-lose" then
            call RRRequestPlayer(REQUEST_GAME_PLAYER_DEFEAT , GetTriggerPlayer())
            //call CleanupUser( GetTriggerPlayer() ) (구 승리 코드, 다음에 보면 지울 것)
        endif
    endfunction
    function CHEATPLAY___main takes nothing returns nothing
    endfunction
