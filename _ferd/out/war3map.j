//library MiscEvents ends
//library PLAYJohab:
        function s__Johab_flush takes nothing returns nothing
            set s__Johab_KIND=0
        endfunction
        function s__Johab_recipeChk takes player p,integer id,integer vid returns boolean
            local integer i= 0
            local boolean able= true
            local integer uid
            local string s= "ends"
            local string ts
            local integer req
            local integer avl
            set s__Johab_KIND=0
            loop
                set ts=GetAbilityEffectById(id, EFFECT_TYPE_CASTER, i)
                exitwhen ts == null
                exitwhen ts == s
                set s=ts
                set uid=S2A(ts)
                set req=S2I(GetAbilityEffectById(id, EFFECT_TYPE_LIGHTNING, i))
                set s__Johab_KTYP[s__Johab_KIND]=uid
                if vid == uid then
                    set s__Johab_KCNT[s__Johab_KIND]=req - 1
                else
                    set s__Johab_KCNT[s__Johab_KIND]=req
                endif
                set s__Johab_KIND=s__Johab_KIND + 1
                if sc__servant_count(p , uid) < req then
                    set s__Johab_ERRORCODE=uid
                    set able=false
                    exitwhen true
                endif
                set i=i + 1
            endloop
            return able
        endfunction
        
        function s__Johab_KILL takes nothing returns nothing
            local unit v
            if GetEnumUnit() == s__Johab_ME then
                return
            endif
            set v=GetEnumUnit()
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", GetUnitX(v), GetUnitY(v)))
            call sc__servant_remove(GetOwningPlayer(v) , v)
            call ShowUnit(v, false)
            call KillUnit(v)
            set v=null
        endfunction
        function s__Johab_try takes player p,unit u,integer id returns nothing
            local integer i= 0
            set s__Johab_ME=u
            loop
                exitwhen i == s__Johab_KIND
                call sc__servant_enum(p , s__Johab_KTYP[i] , s__Johab_KCNT[i] , function s__Johab_KILL)
                set i=i + 1
            endloop
            set s__Johab_ME=null
        endfunction

//library PLAYJohab ends
