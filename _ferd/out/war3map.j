//textmacro instance: 버프_선언_개시("EXGawainDayTime")
//end of: 버프_선언_개시("EXGawainDayTime")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFEXGawainDayTime_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFEXGawainDayTime_exist[this] then
            set s__BUFFEXGawainDayTime_exist[this]=true
            set s__BUFFEXGawainDayTime_running[this]=false
            set s__BUFFEXGawainDayTime_source[this]=src
            set s__BUFFEXGawainDayTime_duration[this]=dur
            set s__BUFFEXGawainDayTime_durationTimer[this]=s__tick_create(this)
            set s__BUFFEXGawainDayTime_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFEXGawainDayTime_rmAct[this]=TriggerAddAction(s__BUFFEXGawainDayTime_rmTrig[this], function sc__BUFFEXGawainDayTime_onSourceRemove)
        endif
        if s__BUFFEXGawainDayTime_running[this] then
            if dur < s__tick__get_remaining(s__BUFFEXGawainDayTime_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFEXGawainDayTime_running[this]=true
            call sc__BUFFEXGawainDayTime_onBuffStart(this)
        endif
        set s__BUFFEXGawainDayTime_duration[this]=dur
        call sc__BUFFEXGawainDayTime_onBuffRefresh(this)
        call s__tick_start(s__BUFFEXGawainDayTime_durationTimer[this],s__BUFFEXGawainDayTime_duration[this] , false , function sc__BUFFEXGawainDayTime_onExpire)
    endfunction
    function s__BUFFEXGawainDayTime_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFEXGawainDayTime_running[this]=false
        call sc__BUFFEXGawainDayTime_onBuffEnd(this)
    endfunction
    function s__BUFFEXGawainDayTime_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFEXGawainDayTime_rmTrig[this], s__BUFFEXGawainDayTime_rmAct[this])
        set s__BUFFEXGawainDayTime_rmAct[this]=null
        set s__BUFFEXGawainDayTime_rmTrig[this]=null
        if s__BUFFEXGawainDayTime_running[this] then
            set s__BUFFEXGawainDayTime_running[this]=false
            call sc__BUFFEXGawainDayTime_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFEXGawainDayTime_durationTimer[this])
        set s__BUFFEXGawainDayTime_source[this]=null
        set s__BUFFEXGawainDayTime_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
    //private static constant integer ATBO = 200
    //private effect fx1
    //private effect fx2
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFEXGawainDayTime_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        //set .fx1 = AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl",.source,"hand left")
        //set .fx2 = AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustSpecial.mdl",.source,"hand right")
        call UnitAddAbility(s__BUFFEXGawainDayTime_source[this], s__BUFFEXGawainDayTime_ABILITY)
        //call EVDamageManager.addBonus( .source, ATBO )
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFEXGawainDayTime_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFEXGawainDayTime_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFEXGawainDayTime_source[this]) then
            //call EVDamageManager.addBonus( .source, -ATBO )
            call UnitRemoveAbility(s__BUFFEXGawainDayTime_source[this], s__BUFFEXGawainDayTime_ABILITY)
            call UnitRemoveAbility(s__BUFFEXGawainDayTime_source[this], s__BUFFEXGawainDayTime_BUFF)
        endif
        //call DestroyEffect(.fx1)
        //call DestroyEffect(.fx2)
        //set .fx1 = null
        //set .fx2 = null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()
    function s__TMGawainGalatin_EnumEnhanced takes nothing returns nothing
        local integer this= GetHandleUserData(GetExpiredTimer())
        call FXRD_FXDebuffShock(GetEnumUnit() , 5.0)
        call s__enemy_dealLogicEx(s__TMGawainGalatin_caster[this] , GetEnumUnit() , s__TMGawainGalatin_damage[this] , true , true , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__TMGawainGalatin_EnumHit takes nothing returns nothing
        local integer this= GetHandleUserData(GetExpiredTimer())
        call s__enemy_dealLogic(s__TMGawainGalatin_caster[this] , GetEnumUnit() , s__TMGawainGalatin_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__TMGawainGalatin_onFire takes nothing returns nothing
        local integer this= GetHandleUserData(GetExpiredTimer())
        local boolean isDayTime= GetUnitAbilityLevel(s__TMGawainGalatin_caster[this], 'A0HN') > 0
        if not IsUnitDead(s__TMGawainGalatin_caster[this]) then
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02P', s__TMGawainGalatin_X[this], s__TMGawainGalatin_Y[this], GetRandomReal(0.0, 270.0)))
            if isDayTime then
                call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02P', s__TMGawainGalatin_X[this], s__TMGawainGalatin_Y[this], GetRandomReal(0.0, 270.0)))
                call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02P', s__TMGawainGalatin_X[this], s__TMGawainGalatin_Y[this], GetRandomReal(0.0, 270.0)))
                call s__splash_range(s__splash_ENEMY , s__TMGawainGalatin_caster[this] , s__TMGawainGalatin_X[this] , s__TMGawainGalatin_Y[this] , 350.0 , function s__TMGawainGalatin_EnumEnhanced)
            else
                call s__splash_range(s__splash_ENEMY , s__TMGawainGalatin_caster[this] , s__TMGawainGalatin_X[this] , s__TMGawainGalatin_Y[this] , 350.0 , function s__TMGawainGalatin_EnumHit)
            endif
        endif
        call ClearHandleUserData(s__TMGawainGalatin_mainFlow[this])
        call DestroyTimer(s__TMGawainGalatin_mainFlow[this])
        set s__TMGawainGalatin_mainFlow[this]=null
        call KillUnit(s__TMGawainGalatin_dummy[this])
        set s__TMGawainGalatin_dummy[this]=null
        set s__TMGawainGalatin_caster[this]=null
        set s__TMGawainGalatin_target[this]=null
    endfunction
    function s__TMGawainGalatin_onCharge takes nothing returns nothing
        local integer this= GetHandleUserData(GetExpiredTimer())
        set s__TMGawainGalatin_dummy[this]=CreateUnit(FX_PLAYER_DUMMY, 'o02Q', s__TMGawainGalatin_X[this], s__TMGawainGalatin_Y[this], 270.0)
        call SetUnitAnimation(s__TMGawainGalatin_dummy[this], "birth")
        call TimerStart(s__TMGawainGalatin_mainFlow[this], 0.5, false, function s__TMGawainGalatin_onFire)
    endfunction
    function s__TMGawainGalatin_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__TMGawainGalatin__allocate()
        set s__TMGawainGalatin_caster[this]=src
        set s__TMGawainGalatin_target[this]=dst
        set s__TMGawainGalatin_damage[this]=dmg
        set s__TMGawainGalatin_X[this]=GetUnitX(dst)
        set s__TMGawainGalatin_Y[this]=GetUnitY(dst)
        set s__TMGawainGalatin_mainFlow[this]=CreateTimer()
        call SetHandleUserData(s__TMGawainGalatin_mainFlow[this] , this)
        call TimerStart(s__TMGawainGalatin_mainFlow[this], 0.03125, false, function s__TMGawainGalatin_onCharge)
    endfunction
// Trigger: Common Gawain
//===========================================================================
    function s__CMSwordCamelot_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMSwordCamelot_target[this], UNIT_TYPE_DEAD) then
            call UnitRemoveAbility(s__CMSwordCamelot_target[this], 'A04Z')
            call UnitRemoveAbility(s__CMSwordCamelot_target[this], 'B02F')
        endif
        call DestroyEffect(s__CMSwordCamelot_fx[this])
        set s__CMSwordCamelot_fx[this]=null
        set s__CMSwordCamelot_caster[this]=null
        set s__CMSwordCamelot_target[this]=null
        call s__tick_destroy(s__CMSwordCamelot_mainFlow[this])
    endfunction
    function s__CMSwordCamelot_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMSwordCamelot_caster[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMSwordCamelot_mainFlow[this],1.00 , false , function s__CMSwordCamelot_onFinal)
            return
        endif
        if IsUnitType(s__CMSwordCamelot_target[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMSwordCamelot_mainFlow[this],1.00 , false , function s__CMSwordCamelot_onFinal)
            return
        endif
        if s__CMSwordCamelot_myLoops[this] <= 0 then
            call s__tick_start(s__CMSwordCamelot_mainFlow[this],1.00 , false , function s__CMSwordCamelot_onFinal)
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\DemonHunterMissile\\DemonHunterMissile.mdl", s__CMSwordCamelot_target[this], "chest"))
        call s__enemy_dealLogic(s__CMSwordCamelot_caster[this] , s__CMSwordCamelot_target[this] , s__CMSwordCamelot_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        set s__CMSwordCamelot_myLoops[this]=s__CMSwordCamelot_myLoops[this] - 1
    endfunction
    function s__CMSwordCamelot_cast takes unit src,unit dst,real dmg,integer loops returns nothing
        local integer this= s__tick_create(0)
        set s__CMSwordCamelot_caster[this]=src
        set s__CMSwordCamelot_target[this]=dst
        set s__CMSwordCamelot_myLoops[this]=loops
        set s__CMSwordCamelot_damage[this]=dmg
        set s__CMSwordCamelot_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Immolation\\ImmolationDamage.mdl", dst, "overhead")
        call UnitAddAbility(s__CMSwordCamelot_target[this], 'A04Z')
        set s__CMSwordCamelot_mainFlow[this]=this
        call s__tick_start(s__CMSwordCamelot_mainFlow[this],1.00 , true , function s__CMSwordCamelot_onFire)
    endfunction
// Trigger: EV 101 GawainB
//===========================================================================

    
    function s__EV101GawainB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV101GawainB_STRUCT_ID)
    endfunction
    
    function s__EV101GawainB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV101GawainB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV101GawainB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV101GawainB__allocate()
        set s__EV101GawainB_ID[this]=GetUnitUserData(src)
        call s__EV101GawainB_setThis(s__EV101GawainB_ID[this] , this)
        return this
    endfunction
    
    function s__EV101GawainB_destroy takes integer this returns nothing
        call s__EV101GawainB_setThis(s__EV101GawainB_ID[this] , 0)
        call s__EV101GawainB_deallocate(this)
    endfunction
    
    //API
    function s__EV101GawainB_append takes unit src,real damage,integer loops returns nothing
        local integer this= s__EV101GawainB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV101GawainB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV101GawainB_onRemoveAction[this]=sc__EVUnitRemove_bind(src , function sc__EV101GawainB_onSourceUnitRemove)
        set s__EV101GawainB_myServant[this]=src
        set s__EV101GawainB_myBuffLoops[this]=loops
        set s__EV101GawainB_myDamage[this]=damage
        set s__EV101GawainB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV101GawainB_coolTick[this],1.00 , true , function sc__EV101GawainB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV101GawainB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV101GawainB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV101GawainB_coolTick[this])
        set s__EV101GawainB_myServant[this]=null
        call TriggerUnbindAction(s__EV101GawainB_onRemoveAction[this])
        set s__EV101GawainB_onRemoveAction[this]=null
        //종결
        call s__EV101GawainB_destroy(this)
    endfunction
    
    function s__EV101GawainB_enumGetTarget takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if GetUnitAbilityLevel(GetEnumUnit(), 'A04Z') > 0 then
            return
        endif
        call s__CMSwordCamelot_cast(s__EV101GawainB_myServant[this] , GetEnumUnit() , s__EV101GawainB_myDamage[this] , s__EV101GawainB_myBuffLoops[this])
    endfunction
    
    function s__EV101GawainB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV101GawainB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV101GawainB_coolTick[this])
            return
        endif
        call s__splash_range(s__splash_ENEMY , s__EV101GawainB_myServant[this] , GetUnitX(s__EV101GawainB_myServant[this]) , GetUnitY(s__EV101GawainB_myServant[this]) , 400 , function s__EV101GawainB_enumGetTarget)
    endfunction
    
//===========================================================================
// Trigger: EV 169 GawainA
//===========================================================================

    
    function s__EV169GawainA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV169GawainA_STRUCT_ID)
    endfunction
    
    function s__EV169GawainA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV169GawainA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV169GawainA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV169GawainA__allocate()
        set s__EV169GawainA_ID[this]=GetUnitUserData(src)
        call s__EV169GawainA_setThis(s__EV169GawainA_ID[this] , this)
        return this
    endfunction
    
    function s__EV169GawainA_destroy takes integer this returns nothing
        call s__EV169GawainA_setThis(s__EV169GawainA_ID[this] , 0)
        call s__EV169GawainA_deallocate(this)
    endfunction
    
    //API
    function s__EV169GawainA_append takes unit src,integer amt returns nothing
        local integer this= s__EV169GawainA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV169GawainA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV169GawainA_onRemoveAction[this]=sc__EVUnitRemove_bind(src , function sc__EV169GawainA_onSourceUnitRemove)
        set s__EV169GawainA_myServant[this]=src
        set s__EV169GawainA_myAmount[this]=amt
        call sc__EVServantAttack_addFunction(src , function sc__EV169GawainA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV169GawainA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set this=s__EV169GawainA_getThis(GetUnitUserData(src))
        call AddPlayerGold(GetOwningPlayer(src) , s__EV169GawainA_myAmount[this])
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetUnitX(dst), GetUnitY(dst)))
        call SetSoundPosition(gg_snd_Gold, GetUnitX(dst), GetUnitY(dst), 200)
        call StartSoundForPlayerBJ(GetOwningPlayer(src), gg_snd_Gold)
        call s__bountyTag_custom(GetOwningPlayer(src) , GetUnitX(dst) , GetUnitY(dst) + 64 , "|c00FFFF00+" + I2S(s__EV169GawainA_myAmount[this]))
        set src=null
        set dst=null
    endfunction
    
    function s__EV169GawainA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV169GawainA_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV169GawainA_myServant[this]=null
        call TriggerUnbindAction(s__EV169GawainA_onRemoveAction[this])
        set s__EV169GawainA_onRemoveAction[this]=null
        //종결
        call s__EV169GawainA_destroy(this)
    endfunction
    
