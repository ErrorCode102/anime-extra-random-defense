        set s__ABILBBSSPotnia_rmAct[this]=null
        set s__ABILBBSSPotnia_rmTrig[this]=null
        call sc__ABILBBSSPotnia_onAbilityLost(this)
        call s__tick_destroy(s__ABILBBSSPotnia_durTik[this])
        set s__ABILBBSSPotnia_source[this]=null
