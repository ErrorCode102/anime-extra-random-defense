    endfunction
    
    //API
    function s__BossSkillSecondPhase_append takes unit src,real delay returns nothing
        local integer this= s__BossSkillSecondPhase_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "BossSkillSecondPhase application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__BossSkillSecondPhase_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__BossSkillSecondPhase_onSourceUnitRemove)
        set s__BossSkillSecondPhase_myServant[this]=src
        set s__BossSkillSecondPhase_myDone[this]=false
        
        set s__BossSkillSecondPhase_myFx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\InnerFire\\InnerFireTarget.mdl", src, "overhead")
        set s__BossSkillSecondPhase_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__BossSkillSecondPhase_coolTick[this],delay , true , function sc__BossSkillSecondPhase_onCastSpell)
    endfunction
    
    //구현부
    function s__BossSkillSecondPhase_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__BossSkillSecondPhase_getThis(s__EVUnitRemove_e)
        //누수처리
        call DestroyEffect(s__BossSkillSecondPhase_myFx[this])
        set s__BossSkillSecondPhase_myFx[this]=null
        call s__tick_destroy(s__BossSkillSecondPhase_coolTick[this])
        set s__BossSkillSecondPhase_myServant[this]=null
        call TriggerUnbindAction(s__BossSkillSecondPhase_onRemoveAction[this])
        set s__BossSkillSecondPhase_onRemoveAction[this]=null
        //종결
        call s__BossSkillSecondPhase_destroy(this)
    endfunction
    function s__BossSkillSecondPhase_enumStunServant takes nothing returns nothing
        local integer this
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set this=s__tick_data[s__tick_getExpired()]
        call s__EVDebuffStunServant_apply(GetEnumUnit() , 5.0)
        call FXRD_FXKnockbackFromTo(GetEnumUnit() , s__BossSkillSecondPhase_myServant[this] , 1000 , 250 , 0.625)
    endfunction
    function s__BossSkillSecondPhase_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if s__BossSkillSecondPhase_myDone[this] then
            return
        endif
        if IsUnitDead(s__BossSkillSecondPhase_myServant[this]) then
            call s__tick_pause(s__BossSkillSecondPhase_coolTick[this])
            return
        endif
        if GetUnitState(s__BossSkillSecondPhase_myServant[this], UNIT_STATE_LIFE) > GetUnitState(s__BossSkillSecondPhase_myServant[this], UNIT_STATE_MAX_LIFE) * 0.5 then
            return
        endif
        set s__BossSkillSecondPhase_myDone[this]=true
        call s__tick_pause(s__BossSkillSecondPhase_coolTick[this])
        call DestroyEffect(s__BossSkillSecondPhase_myFx[this])
        set s__BossSkillSecondPhase_myFx[this]=null
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", s__BossSkillSecondPhase_myServant[this], "origin"))
        call KillUnit(CreateUnit(Player(15), 'o01Z', GetUnitX(s__BossSkillSecondPhase_myServant[this]), GetUnitY(s__BossSkillSecondPhase_myServant[this]), 270.0))
        call SetUnitState(s__BossSkillSecondPhase_myServant[this], UNIT_STATE_MANA, GetUnitState(s__BossSkillSecondPhase_myServant[this], UNIT_STATE_MAX_MANA))
        call s__splash_range(s__splash_ANY , null , GetUnitX(s__BossSkillSecondPhase_myServant[this]) , GetUnitY(s__BossSkillSecondPhase_myServant[this]) , 1000 , function s__BossSkillSecondPhase_enumStunServant)
    endfunction
    
