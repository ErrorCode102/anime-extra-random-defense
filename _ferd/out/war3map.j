// scope FXGather begins
    function FXGather___onFilter takes nothing returns boolean
        if GetUnitTypeId(GetFilterUnit()) != FXGather___ID then
            return false
        endif
        if GetUnitAbilityLevel(GetFilterUnit(), FXGather___ABIL) == 0 then
            return false
        endif
        call SetUnitPosition(GetFilterUnit(), FXGather___X, FXGather___Y)
        call SetUnitX(GetFilterUnit(), FXGather___X)
        call SetUnitY(GetFilterUnit(), FXGather___Y)
        call IssueImmediateOrder(GetFilterUnit(), "holdposition")
        return false
    endfunction
    function FXGather___cast takes nothing returns nothing
        set FXGather___ID=GetUnitTypeId(GetTriggerUnit())
        set FXGather___X=GetUnitX(GetTriggerUnit())
        set FXGather___Y=GetUnitY(GetTriggerUnit())
        call GroupEnumUnitsOfPlayer(FXGather___G, GetOwningPlayer(GetTriggerUnit()), Filter(function FXGather___onFilter))
        call GroupClear(FXGather___G)
    endfunction
    function FXGather___main takes nothing returns nothing
        call s__AbilityEffectEvent_Create(FXGather___ABIL , function FXGather___cast)
    endfunction
// scope FXGather ends
// Trigger: FX Trig Try Reverse
//===========================================================================
// scope PLAYtryreverse begins
    function PLAYtryreverse___onFreeReverse takes nothing returns nothing
        local integer id= s__tick_data[s__tick_getExpired()]
        set PLAYtryreverse___LASTREVERSE[id]=0
    endfunction

    function PLAYtryreverse___onCast takes nothing returns nothing
            local player p
            local unit u
            local integer id= GetSpellAbilityId()
            local integer pid= GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))
            if GetObjectName(id) != "[Disassembly]" then
                return
            endif
            //중복조합 방지
            if PLAYtryreverse___LASTREVERSE[pid] == id then
                return
            endif
            set PLAYtryreverse___LASTREVERSE[pid]=id
            call s__tick_start(PLAYtryreverse___REVERSECUT[pid],0.03125 , false , function PLAYtryreverse___onFreeReverse)
            //구현 끝
            set p=GetOwningPlayer(GetSpellAbilityUnit())
            set u=GetSpellAbilityUnit()
            if GetRandomReal(0.00, 100.00) < S2I(GetAbilityEffectById(id, EFFECT_TYPE_LIGHTNING, 0)) then
                call DisplayTextToPlayer(p, 0.00, 0.00, GetAbilityEffectById(id, EFFECT_TYPE_TARGET, 0))
                call s__JohabReverse_disAssemble(p , id , GetUnitX(u) , GetUnitY(u))
            else
                call DisplayTextToPlayer(p, 0.00, 0.00, GetAbilityEffectById(id, EFFECT_TYPE_TARGET, 1))
                call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl", GetUnitX(u), GetUnitY(u)))
            endif
            call s__servant_remove(p , u)
            call KillUnit(u)
            call ShowUnit(u, false)
            set p=null
            set u=null
    endfunction
    function PLAYtryreverse___main takes nothing returns nothing
        set PLAYtryreverse___LASTREVERSE[0]=0
        set PLAYtryreverse___LASTREVERSE[1]=0
        set PLAYtryreverse___LASTREVERSE[2]=0
        set PLAYtryreverse___LASTREVERSE[3]=0
        set PLAYtryreverse___REVERSECUT[0]=s__tick_create(0)
        set PLAYtryreverse___REVERSECUT[1]=s__tick_create(1)
        set PLAYtryreverse___REVERSECUT[2]=s__tick_create(2)
        set PLAYtryreverse___REVERSECUT[3]=s__tick_create(3)
        call s__AbilityEffectEvent_Create(0 , function PLAYtryreverse___onCast)
    endfunction
// scope PLAYtryreverse ends
// Trigger: FX Trig Try Mission
//===========================================================================
// scope PLAYtrymission begins
    function PLAYtrymission___onMission takes nothing returns nothing
        local player p= GetOwningPlayer(GetSellingUnit())
        local integer id= GetPlayerId(p)
        local integer lv= R2I(GetUnitState(GetSoldUnit(), UNIT_STATE_MAX_MANA))
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local unit u= CreateUnit(Player(id + 4), PLAYtrymission___UID[lv], x, y, GetRandomReal(0, 360))
        call UnitAddAbility(u, 'Aeth')
        call s__enemy_add(Player(id + 4) , u)
        if GetPanalty(PANALTY_ENEMY_HEAL) then
            call UnitAddAbility(u, 'A04J')
            call s__EVStateRegenerate_append(u , GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.005 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
        else
            call s__EVStateRegenerate_append(u , 0.00 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
        endif
        call s__lifeMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_LIFE) * LEVEL_HP[LEVEL_CURRENT]))
        call s__manaMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_MANA) * LEVEL_HP[LEVEL_CURRENT]))
        //미션 반영 - 자유 이동
        call s__EVFreeRectMovement_append(u , PLAYER_ZONE_LINE[id] , PLAYtrymission___UMOTION[lv])
        call s__EVMissionTimeout_append(p , u , 240.00 , "Mission " + PLAYtrymission___PREFIX[lv] + " : " + s__pcs__staticgetindex(id) + USER_NAME_CURRENT[id])
        call s__EVSpecialBounty_append(u , "Mission" , Player(id) , PLAYtrymission___GOLD[lv] , PLAYtrymission___LUMBER[lv] , 0 , PLAYtrymission___SRNK[lv] , PLAYtrymission___SAMT[lv] , PLAYtrymission___XAMT[lv])
        call PingMinimapEx(x, y, 10.00, 255, 128, 0, true)
        call PingMinimapEx(x, y, 10.00, 255, 128, 0, false)
        //종결
        set u=null
        call ShowUnit(GetSoldUnit(), false)
        call KillUnit(GetSoldUnit())
        set p=null
    endfunction
    function PLAYtrymission___main takes nothing returns nothing
        set PLAYtrymission___PREFIX[1]="D"
        set PLAYtrymission___PREFIX[2]="C"
        set PLAYtrymission___PREFIX[3]="B"
        set PLAYtrymission___PREFIX[4]="A"
        set PLAYtrymission___PREFIX[5]="S"
        set PLAYtrymission___PREFIX[6]="EX"
        set PLAYtrymission___UMOTION[1]=1
        set PLAYtrymission___UMOTION[2]=6
        set PLAYtrymission___UMOTION[3]=9
        set PLAYtrymission___UMOTION[4]=1
        set PLAYtrymission___UMOTION[5]=2
        set PLAYtrymission___UMOTION[6]=10
        set PLAYtrymission___UID[1]='nB00'
        set PLAYtrymission___UID[2]='nB01'
        set PLAYtrymission___UID[3]='nB02'
        set PLAYtrymission___UID[4]='nB03'
        set PLAYtrymission___UID[5]='nB04'
        set PLAYtrymission___UID[6]='nB05'
        call s__UnitSellEvent_Create('L00D' , function PLAYtrymission___onMission)
        call s__UnitSellEvent_Create('L00C' , function PLAYtrymission___onMission)
        call s__UnitSellEvent_Create('L00B' , function PLAYtrymission___onMission)
        call s__UnitSellEvent_Create('L00A' , function PLAYtrymission___onMission)
        call s__UnitSellEvent_Create('L00S' , function PLAYtrymission___onMission)
        call s__UnitSellEvent_Create('L0EX' , function PLAYtrymission___onMission)
        
        set PLAYtrymission___GOLD[1]=3000
        set PLAYtrymission___LUMBER[1]=3
        set PLAYtrymission___SRNK[1]=0
        set PLAYtrymission___SAMT[1]=0
        set PLAYtrymission___XAMT[1]=1
        
        set PLAYtrymission___GOLD[2]=5000
        set PLAYtrymission___LUMBER[2]=5
        set PLAYtrymission___SRNK[2]=0
        set PLAYtrymission___SAMT[2]=0
        set PLAYtrymission___XAMT[2]=1
        
        set PLAYtrymission___GOLD[3]=9000
        set PLAYtrymission___LUMBER[3]=9
        set PLAYtrymission___SRNK[3]=0
        set PLAYtrymission___SAMT[3]=0
        set PLAYtrymission___XAMT[3]=1
        
        set PLAYtrymission___GOLD[4]=15000
        set PLAYtrymission___LUMBER[4]=15
        set PLAYtrymission___SRNK[4]=0
        set PLAYtrymission___SAMT[4]=0
        set PLAYtrymission___XAMT[4]=2
        
        set PLAYtrymission___GOLD[5]=23000
        set PLAYtrymission___LUMBER[5]=0
        set PLAYtrymission___SRNK[5]=5
        set PLAYtrymission___SAMT[5]=1
        set PLAYtrymission___XAMT[5]=3
        
        set PLAYtrymission___GOLD[6]=33000
        set PLAYtrymission___LUMBER[6]=0
