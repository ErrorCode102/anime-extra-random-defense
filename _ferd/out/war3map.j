    endfunction
    
    //API
    
    function s__EV113LubuB_append takes unit src,integer abid returns nothing
        local integer this= s__EV113LubuB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV113LubuB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV113LubuB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV113LubuB_onSourceUnitRemove)
        set s__EV113LubuB_myServant[this]=src
        set s__EV113LubuB_myAbil[this]=abid
        set s__EV113LubuB_myCombo[this]=1
        call UnitAddAbility(src, abid)
        //기절, 넉백 면역 효과
        call FXRD_FXImmuneStun(s__EV113LubuB_myServant[this] , true)
        call FXRD_FXImmuneKnockback(s__EV113LubuB_myServant[this] , true)
        
        set s__EV113LubuB_myBoostFx[this]=null
        set s__EV113LubuB_myBoostTick[this]=s__tick_create(this)
        call s__EVServantAttack_addFunction(src , function sc__EV113LubuB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV113LubuB_onBoostOver takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__EV113LubuB_myCombo[this]=1
        if s__EV113LubuB_myBoostFx[this] != null then
            call DestroyEffect(s__EV113LubuB_myBoostFx[this])
        endif
        set s__EV113LubuB_myBoostFx[this]=null
        if IsUnitType(s__EV113LubuB_myServant[this], UNIT_TYPE_DEAD) then
            return
        endif
        call SetUnitAbilityLevel(s__EV113LubuB_myServant[this], s__EV113LubuB_myAbil[this], s__EV113LubuB_myCombo[this])
    endfunction
    function s__EV113LubuB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV113LubuB_getThis(GetUnitUserData(src))
        if s__EV113LubuB_myCombo[this] == 5 then
            if s__EV113LubuB_myBoostFx[this] != null then
                call DestroyEffect(s__EV113LubuB_myBoostFx[this])
            endif
            set s__EV113LubuB_myBoostFx[this]=AddSpecialEffectTarget("FX\\Okita\\Aura1.mdl", s__EV113LubuB_myServant[this], "origin")
        endif
        set s__EV113LubuB_myCombo[this]=IMinBJ(6, s__EV113LubuB_myCombo[this] + 1)
        call SetUnitAbilityLevel(s__EV113LubuB_myServant[this], s__EV113LubuB_myAbil[this], s__EV113LubuB_myCombo[this])
        call s__tick_start(s__EV113LubuB_myBoostTick[this],5.00 , false , function s__EV113LubuB_onBoostOver)
        set src=null
        set dst=null
    endfunction
    
    function s__EV113LubuB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV113LubuB_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV113LubuB_myBoostFx[this] != null then
            call DestroyEffect(s__EV113LubuB_myBoostFx[this])
        endif
        set s__EV113LubuB_myBoostFx[this]=null
        call s__tick_destroy(s__EV113LubuB_myBoostTick[this])
        set s__EV113LubuB_myServant[this]=null
        call TriggerUnbindAction(s__EV113LubuB_onRemoveAction[this])
        set s__EV113LubuB_onRemoveAction[this]=null
        //종결
        call s__EV113LubuB_destroy(this)
    endfunction
    

//===========================================================================
// Trigger: EV 114 AtalantaAlterA
//===========================================================================

    
    function s__EV114AtalantaAlterA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV114AtalantaAlterA_STRUCT_ID)
    endfunction
    
