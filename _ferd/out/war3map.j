//library UnitCounter:
    
    
    function IsUnitCountedTo takes unit u,integer uc returns boolean
        return IsUnitInGroup(u, UnitCounter___G[uc])
    endfunction
    
    function GetUnitCountedTypeId takes unit u,integer uc returns integer
        if not IsUnitCountedTo(u , uc) then
            return 0
        endif
        return LoadInteger(UnitCounter___IDH, 0, GetHandleId(u))
    endfunction
    
    function UnitCounterRemoveUnit takes integer uc,unit u returns nothing
        local group g= null
        if not UnitCounter___E[uc] then
            return
        endif
        if not IsUnitCountedTo(u , uc) then
            return
        endif
        set g=LoadGroupHandle(UnitCounter___H[uc], 0, LoadInteger(UnitCounter___IDH, 0, GetHandleId(u)))
        call RemoveSavedInteger(UnitCounter___IDH, 0, GetHandleId(u))
        call GroupRemoveUnit(g, u)
        call GroupRemoveUnit(UnitCounter___G[uc], u)
        set g=null
    endfunction
    
    function UnitCounter___EnumCount takes nothing returns nothing
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_DEAD) then
            return
        endif
        set UnitCounter___CNT=UnitCounter___CNT + 1
    endfunction
    
    function UnitCounterGetCounted takes integer uc,integer typeId returns integer
        local group g= null
        local integer c
        if not UnitCounter___E[uc] then
            return 0
        endif
        set g=LoadGroupHandle(UnitCounter___H[uc], 0, typeId)
        if g == null then
            return 0
        endif
        set UnitCounter___CNT=0
        call ForGroup(g, function UnitCounter___EnumCount)
        set c=UnitCounter___CNT
        set g=null
        return c
    endfunction
    
    function UnitCounter___EnumIter takes nothing returns nothing
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_DEAD) then
            return
        endif
        if UnitCounter___CNT == UnitCounter___CNTMAX then
            call GroupAddUnit(UnitCounter___NG, GetEnumUnit())
            return
        endif
        set UnitCounter___CNT=UnitCounter___CNT + 1
        call TriggerEvaluate(UnitCounter___T)
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_DEAD) then
            return
        endif
        call GroupAddUnit(UnitCounter___NG, GetEnumUnit())
    endfunction
    
    function ForUnitCounter takes integer uc,integer typeId,integer n,code c returns nothing
        local group g= null
        if not UnitCounter___E[uc] then
            return
        endif
        set g=LoadGroupHandle(UnitCounter___H[uc], 0, typeId)
        if g == null then
            return
        endif
        set UnitCounter___CNT=0
        set UnitCounter___CNTMAX=n
        set UnitCounter___NG=CreateGroup()
        set UnitCounter___T=CreateTrigger()
        call TriggerAddCondition(UnitCounter___T, Condition(c))
        call ForGroup(g, function UnitCounter___EnumIter)
        call DestroyTrigger(UnitCounter___T)
        set UnitCounter___T=null
        call GroupClear(g)
        call DestroyGroup(g)
        set g=null
        call SaveGroupHandle(UnitCounter___H[uc], 0, typeId, UnitCounter___NG)
        set UnitCounter___NG=null
    endfunction
    
    function UnitCounterAddUnitEx takes integer uc,unit u,integer typeId returns nothing
        local group g= null
        if not UnitCounter___E[uc] then
            return
        endif
        if IsUnitCountedTo(u , uc) then
            return
        endif
        set g=LoadGroupHandle(UnitCounter___H[uc], 0, typeId)
        if g == null then
            set g=CreateGroup()
            call SaveGroupHandle(UnitCounter___H[uc], 0, typeId, g)
        endif
        call GroupAddUnit(UnitCounter___G[uc], u)
        call GroupAddUnit(g, u)
        call SaveInteger(UnitCounter___IDH, 0, GetHandleId(u), typeId)
        set g=null
    endfunction
    
    function UnitCounterAddUnit takes integer uc,unit u returns nothing
        call UnitCounterAddUnitEx(uc , u , GetUnitTypeId(u))
    endfunction
    
    function CreateUnitCounter takes nothing returns integer
        local integer c= s__unitcounter__allocate()
        set UnitCounter___E[c]=true
        set UnitCounter___G[c]=CreateGroup()
        set UnitCounter___H[c]=InitHashtable()
        return c
    endfunction
    

//library UnitCounter ends
//library UnitIndexer:
    //=========================================
    //  +a. 성능 평가
    //=========================================
    function GetIndexRate takes nothing returns real
        return UnitIndexer__C / 8191.0
    endfunction
    //=========================================
    //  디인덱스 이벤트
    //=========================================
    function GetTriggerIndex takes nothing returns integer
        return UnitIndexer__V
    endfunction
    function GetUnitRemoveTrigger takes unit u returns trigger
        return UnitIndexer__E[LoadInteger(UnitIndexer__H, 0, GetHandleId(u))]
    endfunction
    //=========================================
    //  1/3. 디인덱서
    //=========================================
    function UnitIndexer__Deindex takes integer id returns nothing
        local integer pi= UnitIndexer__V
        set UnitIndexer__V=id
        call TriggerExecute(UnitIndexer__E[id])
        set UnitIndexer__V=pi
        call DestroyTrigger(UnitIndexer__E[id])
        call RemoveSavedInteger(UnitIndexer__H, 0, UnitIndexer__I[id])
        set UnitIndexer__E[id]=null
        set UnitIndexer__U[id]=null
        set UnitIndexer__I[id]=0
        set UnitIndexer__S[UnitIndexer__Z]=id
        set UnitIndexer__Z=UnitIndexer__Z + 1
        set UnitIndexer__C=UnitIndexer__C - 1
    endfunction
    //=========================================
    //  2/3. MUI화된 인덱서 리프레셔
    //=========================================
        function UnitIndexer__DRef takes integer id returns nothing
            call RemoveSavedInteger(UnitIndexer__H, 0, GetHandleId(UnitIndexer__T[id]))
            call RemoveSavedInteger(UnitIndexer__H, 0, GetHandleId(UnitIndexer__T1[id]))
            call DestroyTimer(UnitIndexer__T[id])
            set UnitIndexer__T[id]=null
            call TriggerRemoveAction(UnitIndexer__T1[id], UnitIndexer__T1A[id])
            set UnitIndexer__T1A[id]=null
            call DestroyTrigger(UnitIndexer__T1[id])
            set UnitIndexer__T1[id]=null
        endfunction
        function UnitIndexer__ORem takes nothing returns nothing
            local integer id= LoadInteger(UnitIndexer__H, 0, GetHandleId(GetExpiredTimer()))
            if GetUnitTypeId(UnitIndexer__U[id]) != 0 then
                if IsUnitType(UnitIndexer__U[id], UNIT_TYPE_DEAD) then
                    call TimerStart(UnitIndexer__T[id], 5.0, false, function UnitIndexer__ORem)
                    return
                endif
                return
            endif
            call UnitIndexer__DRef(id)
            call UnitIndexer__Deindex(id)
        endfunction
        function UnitIndexer__ODea takes nothing returns nothing
            local integer id= LoadInteger(UnitIndexer__H, 0, GetHandleId(GetTriggeringTrigger()))
            call TimerStart(UnitIndexer__T[id], 1.0, false, function UnitIndexer__ORem)
        endfunction
        function UnitIndexer__ARef takes unit u,integer id returns nothing
            set UnitIndexer__T[id]=CreateTimer()
            call SaveInteger(UnitIndexer__H, 0, GetHandleId(UnitIndexer__T[id]), id)
            set UnitIndexer__T1[id]=CreateTrigger()
            set UnitIndexer__T1A[id]=TriggerAddAction(UnitIndexer__T1[id], function UnitIndexer__ODea)
            call SaveInteger(UnitIndexer__H, 0, GetHandleId(UnitIndexer__T1[id]), id)
            call TriggerRegisterUnitEvent(UnitIndexer__T1[id], u, EVENT_UNIT_DEATH)
            if IsUnitType(u, UNIT_TYPE_DEAD) then
                call TimerStart(UnitIndexer__T[id], 5.0, false, function UnitIndexer__ORem)
            endif
        endfunction
    //=========================================
    //  3/3. 인덱서
    //=========================================
    function GetUnitIndex takes unit u returns integer
        return LoadInteger(UnitIndexer__H, 0, GetHandleId(u))
    endfunction
    function IsUnitIndexed takes unit u returns boolean
        return HaveSavedInteger(UnitIndexer__H, 0, GetHandleId(u))
    endfunction
    function IndexUnit takes unit u returns integer
        local integer id= LoadInteger(UnitIndexer__H, 0, GetHandleId(u))
        if id == 0 then
            if GetUnitTypeId(u) == 0 then
                return 0
            endif
            if UnitIndexer__Z == 0 then
                set UnitIndexer__M=UnitIndexer__M + 1
                set id=UnitIndexer__M
            else
                set UnitIndexer__Z=UnitIndexer__Z - 1
                set id=UnitIndexer__S[UnitIndexer__Z]
            endif
            set UnitIndexer__C=UnitIndexer__C + 1
            set UnitIndexer__U[id]=u
            set UnitIndexer__I[id]=GetHandleId(u)
            set UnitIndexer__E[id]=CreateTrigger()
            call SaveInteger(UnitIndexer__H, 0, GetHandleId(u), id)
            call UnitIndexer__ARef(u , id)
        endif
        return id
    endfunction
    //=========================================
    //  +a. 프리인덱서/포스트인덱서
    //=========================================
    function UnitIndexer__OnAllocateCondition takes nothing returns boolean
        return not HaveSavedInteger(UnitIndexer__H, 0, GetHandleId(GetTriggerUnit()))
    endfunction
    function UnitIndexer__OnAllocateAction takes nothing returns nothing
        call IndexUnit(GetTriggerUnit())
    endfunction
    function UnitIndexer__PostAllocate takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function UnitIndexer__OnAllocateAction)
        call TriggerAddCondition(t, Condition(function UnitIndexer__OnAllocateCondition))
        call TriggerRegisterEnterRectSimple(t, GetWorldBounds())
        set t=null
    endfunction
    function UnitIndexer__EnumPreAllocate takes nothing returns boolean
        call IndexUnit(GetFilterUnit())
        return false
    endfunction
    function UnitIndexer__PreAllocate takes nothing returns nothing
        local group g= CreateGroup()
        call GroupEnumUnitsInRect(g, GetWorldBounds(), Filter(function UnitIndexer__EnumPreAllocate))
        call DestroyGroup(g)
        set g=null
    endfunction
    function UnitIndexer__main takes nothing returns nothing
        call UnitIndexer__PreAllocate()
        call UnitIndexer__PostAllocate()
    endfunction

