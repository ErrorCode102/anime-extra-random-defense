//===================================================
// scope TrigFactionTamamoEnhancedSkillz begins
    function TrigFactionTamamoEnhancedSkillz__onEnumTrue takes nothing returns nothing
        local real maxdmg= GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_LIFE) * TrigFactionTamamoEnhancedSkillz__HPDMG
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            set maxdmg=0.0
        endif
        call FXRD_FXDebuffShock(GetEnumUnit() , TrigFactionTamamoEnhancedSkillz__STUN)
        call s__enemy_dealLogicEx(TrigFactionTamamoEnhancedSkillz__SRC , GetEnumUnit() , RMaxBJ(TrigFactionTamamoEnhancedSkillz__DMG, maxdmg) , true , false , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function TrigFactionTamamoEnhancedSkillz__dealStunTrue takes unit src,rect r,real dmg,real hpdmg,real del returns nothing
        local unit psrc= TrigFactionTamamoEnhancedSkillz__SRC
        local real pdmg= TrigFactionTamamoEnhancedSkillz__DMG
        local real pstun= TrigFactionTamamoEnhancedSkillz__STUN
        local real phpdmg= TrigFactionTamamoEnhancedSkillz__HPDMG
        set TrigFactionTamamoEnhancedSkillz__SRC=src
        set TrigFactionTamamoEnhancedSkillz__DMG=dmg
        set TrigFactionTamamoEnhancedSkillz__HPDMG=hpdmg
        set TrigFactionTamamoEnhancedSkillz__STUN=del
        call s__splash_rect(s__splash_ENEMY , TrigFactionTamamoEnhancedSkillz__SRC , r , function TrigFactionTamamoEnhancedSkillz__onEnumTrue)
        set TrigFactionTamamoEnhancedSkillz__STUN=pstun
        set TrigFactionTamamoEnhancedSkillz__SRC=psrc
        set TrigFactionTamamoEnhancedSkillz__DMG=pdmg
        set TrigFactionTamamoEnhancedSkillz__HPDMG=phpdmg
        set psrc=null
    endfunction
    
    function TrigFactionTamamoEnhancedSkillz__starFall takes rect r returns nothing
        local integer i= 0
        local real x
        local real y
        local real minx= GetRectMinX(r)
        local real maxx= GetRectMaxX(r)
        local real miny= GetRectMinY(r)
        local real maxy= GetRectMaxY(r)
        loop
            set x=GetRandomReal(minx, maxx)
            set y=GetRandomReal(miny, maxy)
            call DestroyEffect(AddSpecialEffect("V2\\Milchun\\Milchun.mdl", x, y))
            set i=i + 1
            exitwhen i == 100
        endloop
    endfunction
    function TrigFactionTamamoEnhancedSkillz__starFallCastEx takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call TrigFactionTamamoEnhancedSkillz__starFall(PLAYER_ZONE_LINE[id])
        call TrigFactionTamamoEnhancedSkillz__dealStunTrue(GetTriggerUnit() , PLAYER_ZONE_LINE[id] , 2000.0 , 0.0 , 1.0)
        if MODE_CURRENT != MODE_SPEEDRUN then
            call TrigFactionTamamoEnhancedSkillz__starFall(gg_rct_Z_BOSS)
            call TrigFactionTamamoEnhancedSkillz__dealStunTrue(GetTriggerUnit() , gg_rct_Z_BOSS , 2000.0 , 0.0 , 1.0)
        endif
    endfunction
    function TrigFactionTamamoEnhancedSkillz__nuclear takes rect r,integer id returns nothing
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), id, x, y, 270.0))
    endfunction
    function TrigFactionTamamoEnhancedSkillz__nuclearCastEx takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call TrigFactionTamamoEnhancedSkillz__nuclear(PLAYER_ZONE_LINE[id] , 'h00V')
        call TrigFactionTamamoEnhancedSkillz__dealStunTrue(GetTriggerUnit() , PLAYER_ZONE_LINE[id] , 30000.0 , 0.2 , 5.0)
        if MODE_CURRENT != MODE_SPEEDRUN then
            call TrigFactionTamamoEnhancedSkillz__nuclear(gg_rct_Z_BOSS , 'h00V')
            call TrigFactionTamamoEnhancedSkillz__dealStunTrue(GetTriggerUnit() , gg_rct_Z_BOSS , 30000.0 , 0.2 , 5.0)
        endif
    endfunction
    //
    function TrigFactionTamamoEnhancedSkillz__boost takes player p,rect r,real d,integer id returns nothing
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        local unit u= CreateUnit(p, 'h000', x, y, 270.0)
        call UnitApplyTimedLife(u, 'BHwe', d)
        call SetUnitAnimation(u, "birth")
        call SetUnitTimeScale(u, 60.0 / d)
        if id != 0 then
            call UnitAddAbility(u, id)
        endif
        set u=null
    endfunction
    function TrigFactionTamamoEnhancedSkillz__boostCastEx takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call TrigFactionTamamoEnhancedSkillz__boost(Player(id) , PLAYER_ZONE_LINE[id] , 15.0 , 0)
    endfunction
    //
    function TrigFactionTamamoEnhancedSkillz__main takes nothing returns nothing
        //call AbilityEffectEvent.Create( 'A05R', function mpFill200 ) (Unused)
        call s__AbilityEffectEvent_Create('A01E' , function TrigFactionTamamoEnhancedSkillz__starFallCastEx)
        call s__AbilityEffectEvent_Create('A01G' , function TrigFactionTamamoEnhancedSkillz__nuclearCastEx)
        call s__AbilityEffectEvent_Create('A049' , function TrigFactionTamamoEnhancedSkillz__boostCastEx)
    endfunction
// scope TrigFactionTamamoEnhancedSkillz ends
