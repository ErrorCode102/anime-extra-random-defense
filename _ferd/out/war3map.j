//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("SemiBTC")
//end of: 어빌리티_선언_개시("SemiBTC")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DT")
    
    function s__ABILSemiBTC_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSemiBTC_onSpellEffect[this], s__ABILSemiBTC_onSpellEffectAction[this])
        set s__ABILSemiBTC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILSemiBTC_onSpellEffect[this])
        set s__ABILSemiBTC_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILSemiBTC_rmTrig[this], s__ABILSemiBTC_rmAct[this])
        set s__ABILSemiBTC_rmAct[this]=null
        set s__ABILSemiBTC_rmTrig[this]=null
        call sc__ABILSemiBTC_onAbilityLost(this)
        set s__ABILSemiBTC_source[this]=null
        set s__ABILSemiBTC_exists[this]=false
    endfunction
    
    function s__ABILSemiBTC_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSemiBTC_free(this)
    endfunction
    
    function s__ABILSemiBTC_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSemiBTC_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSemiBTC_exists[this] then
            set s__ABILSemiBTC_exists[this]=true
            set s__ABILSemiBTC_source[this]=src
            set s__ABILSemiBTC_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSemiBTC_rmAct[this]=TriggerAddAction(s__ABILSemiBTC_rmTrig[this], function s__ABILSemiBTC_OnSourceRemove)
            set s__ABILSemiBTC_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILSemiBTC_onSpellEffect[this], Condition(function sc__ABILSemiBTC_conditionSpellEffect))
            set s__ABILSemiBTC_onSpellEffectAction[this]=TriggerAddAction(s__ABILSemiBTC_onSpellEffect[this], function sc__ABILSemiBTC_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILSemiBTC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILSemiBTC_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILSemiBTC_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILSemiBTC_exists[this] then
            return
        endif
        call sc__ABILSemiBTC_onAbilityEffect(this)
    endfunction
    
    function s__ABILSemiBTC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILSemiBTC_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DT")
    
    
    function s__ABILSemiBTC_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__ABILSemiBTC_CNT) == 0 then
            set s__ABILSemiBTC_DEST=GetEnumUnit()
        endif
        set s__ABILSemiBTC_CNT=s__ABILSemiBTC_CNT + 1
    endfunction
    
    function s__ABILSemiBTC_enumFunction takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__ABILSemiBTC_source[this]) then
            if s__ABILSemiBTC_DUM[this] != null then
                call ShowUnit(s__ABILSemiBTC_DUM[this], false)
                call KillUnit(s__ABILSemiBTC_DUM[this])
            endif
            set s__ABILSemiBTC_DUM[this]=null
            return
        endif
        set s__ABILSemiBTC_DEST=null
        set s__ABILSemiBTC_CNT=0
        set s__ABILSemiBTC_DMG[this]=sc__EVDamageManager_getFinalDamage(s__ABILSemiBTC_source[this])
        call s__splash_range(s__splash_ENEMY , s__ABILSemiBTC_source[this] , s__ABILSemiBTC_X[this] , s__ABILSemiBTC_Y[this] , 700 , function s__ABILSemiBTC_enumGetTarget)
        if s__ABILSemiBTC_DEST == null then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("FX\\Gawain\\Sun.mdl", s__ABILSemiBTC_DEST, "origin"))
        call s__enemy_dealLogic(s__ABILSemiBTC_source[this] , s__ABILSemiBTC_DEST , s__ABILSemiBTC_DMG[this] , WEAPON_TYPE_WHOKNOWS , 1)
        set s__ABILSemiBTC_DEST=null
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILSemiBTC_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILSemiBTC_TK[this]=s__tick_create(this)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILSemiBTC_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        if s__ABILSemiBTC_DUM[this] != null then
            call ShowUnit(s__ABILSemiBTC_DUM[this], false)
            call KillUnit(s__ABILSemiBTC_DUM[this])
        endif
        set s__ABILSemiBTC_DUM[this]=null
        call s__tick_destroy(s__ABILSemiBTC_TK[this])
        set s__ABILSemiBTC_TK[this]=0
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSemiBTC_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real x= GetSpellTargetX()
        local real y= GetSpellTargetY()
        if s__ABILSemiBTC_DUM[this] == null then
            set s__ABILSemiBTC_DUM[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01Y', x, y, 270)
        endif
        call SetUnitX(s__ABILSemiBTC_DUM[this], x)
        call SetUnitY(s__ABILSemiBTC_DUM[this], y)
        set s__ABILSemiBTC_X[this]=x
        set s__ABILSemiBTC_Y[this]=y
        call SetSoundPosition(gg_snd_spell_semiramis_garden, x, y, 300)
        call StartSound(gg_snd_spell_semiramis_garden)
        call s__tick_start(s__ABILSemiBTC_TK[this],0.50 , true , function s__ABILSemiBTC_enumFunction)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("SemiDGarden")
//end of: 어빌리티_선언_개시("SemiDGarden")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DI")
    
    function s__ABILSemiDGarden_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSemiDGarden_onSpellEffect[this], s__ABILSemiDGarden_onSpellEffectAction[this])
        set s__ABILSemiDGarden_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILSemiDGarden_onSpellEffect[this])
        set s__ABILSemiDGarden_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILSemiDGarden_rmTrig[this], s__ABILSemiDGarden_rmAct[this])
        set s__ABILSemiDGarden_rmAct[this]=null
        set s__ABILSemiDGarden_rmTrig[this]=null
        call sc__ABILSemiDGarden_onAbilityLost(this)
        set s__ABILSemiDGarden_source[this]=null
        set s__ABILSemiDGarden_exists[this]=false
    endfunction
    
    function s__ABILSemiDGarden_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSemiDGarden_free(this)
    endfunction
    
    function s__ABILSemiDGarden_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSemiDGarden_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSemiDGarden_exists[this] then
            set s__ABILSemiDGarden_exists[this]=true
            set s__ABILSemiDGarden_source[this]=src
            set s__ABILSemiDGarden_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSemiDGarden_rmAct[this]=TriggerAddAction(s__ABILSemiDGarden_rmTrig[this], function s__ABILSemiDGarden_OnSourceRemove)
            set s__ABILSemiDGarden_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILSemiDGarden_onSpellEffect[this], Condition(function sc__ABILSemiDGarden_conditionSpellEffect))
            set s__ABILSemiDGarden_onSpellEffectAction[this]=TriggerAddAction(s__ABILSemiDGarden_onSpellEffect[this], function sc__ABILSemiDGarden_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILSemiDGarden_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILSemiDGarden_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILSemiDGarden_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILSemiDGarden_exists[this] then
            return
        endif
        call sc__ABILSemiDGarden_onAbilityEffect(this)
    endfunction
    
    function s__ABILSemiDGarden_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILSemiDGarden_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DI")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILSemiDGarden_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILSemiDGarden_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSemiDGarden_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real x= GetSpellTargetX()
        local real y= GetSpellTargetY()
        local unit u= CreateUnit(GetOwningPlayer(s__ABILSemiDGarden_source[this]), 'o01X', x, y, 270)
        call SetSoundPosition(gg_snd_spell_semiramis_garden, x, y, 300)
        call StartSound(gg_snd_spell_semiramis_garden)
        call FXRD_FXLifeSpanCommon(u , 15.00)
        set u=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("SemiCPoison")
//end of: 어빌리티_선언_개시("SemiCPoison")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DL")
    
    function s__ABILSemiCPoison_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSemiCPoison_onSpellEffect[this], s__ABILSemiCPoison_onSpellEffectAction[this])
        set s__ABILSemiCPoison_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILSemiCPoison_onSpellEffect[this])
        set s__ABILSemiCPoison_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILSemiCPoison_rmTrig[this], s__ABILSemiCPoison_rmAct[this])
        set s__ABILSemiCPoison_rmAct[this]=null
        set s__ABILSemiCPoison_rmTrig[this]=null
        call sc__ABILSemiCPoison_onAbilityLost(this)
        set s__ABILSemiCPoison_source[this]=null
        set s__ABILSemiCPoison_exists[this]=false
    endfunction
    
    function s__ABILSemiCPoison_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSemiCPoison_free(this)
    endfunction
    
    function s__ABILSemiCPoison_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSemiCPoison_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSemiCPoison_exists[this] then
            set s__ABILSemiCPoison_exists[this]=true
            set s__ABILSemiCPoison_source[this]=src
            set s__ABILSemiCPoison_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSemiCPoison_rmAct[this]=TriggerAddAction(s__ABILSemiCPoison_rmTrig[this], function s__ABILSemiCPoison_OnSourceRemove)
            set s__ABILSemiCPoison_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILSemiCPoison_onSpellEffect[this], Condition(function sc__ABILSemiCPoison_conditionSpellEffect))
            set s__ABILSemiCPoison_onSpellEffectAction[this]=TriggerAddAction(s__ABILSemiCPoison_onSpellEffect[this], function sc__ABILSemiCPoison_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILSemiCPoison_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILSemiCPoison_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILSemiCPoison_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILSemiCPoison_exists[this] then
            return
        endif
        call sc__ABILSemiCPoison_onAbilityEffect(this)
    endfunction
    
    function s__ABILSemiCPoison_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILSemiCPoison_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DL")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILSemiCPoison_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILSemiCPoison_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSemiCPoison_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitAbilityLevel(GetSpellTargetUnit(), s__BUFFSemiPoision_ABILITY) > 0 then
            call UnitRemoveAbility(GetTriggerUnit(), s__ABILSemiCPoison_ABILITY)
            call UnitAddAbility(GetTriggerUnit(), s__ABILSemiCPoison_ABILITY)
            return
        endif
        call sc__BUFFSemiPoision_apply(GetSpellTargetUnit() , s__ABILSemiCPoison_source[this] , 1.00 , - 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("SemiPoision")
//end of: 버프_선언_개시("SemiPoision")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩안됨()
    function s__BUFFSemiPoision_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFSemiPoision_exist[this] then
            set s__BUFFSemiPoision_exist[this]=true
            set s__BUFFSemiPoision_source[this]=src
            set s__BUFFSemiPoision_caster[this]=cas
            set s__BUFFSemiPoision_duration[this]=dur
            set s__BUFFSemiPoision_count[this]=cnt
            set s__BUFFSemiPoision_running[this]=false
            set s__BUFFSemiPoision_durationTimer[this]=s__tick_create(this)
            set s__BUFFSemiPoision_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFSemiPoision_rmAct[this]=TriggerAddAction(s__BUFFSemiPoision_rmTrig[this], function sc__BUFFSemiPoision_onSourceRemove)
        endif
        if s__BUFFSemiPoision_running[this] then
            if s__BUFFSemiPoision_count[this] < 0 then
                return
            endif
            if dur * cnt < s__BUFFSemiPoision_count[this] * s__BUFFSemiPoision_duration[this] then
                return
            endif
            set s__BUFFSemiPoision_count[this]=cnt
            set s__BUFFSemiPoision_duration[this]=dur
        else
            set s__BUFFSemiPoision_running[this]=true
            set s__BUFFSemiPoision_count[this]=cnt
            set s__BUFFSemiPoision_duration[this]=dur
            call sc__BUFFSemiPoision_onBuffStart(this)
            call s__tick_start(s__BUFFSemiPoision_durationTimer[this],s__BUFFSemiPoision_duration[this] , false , function sc__BUFFSemiPoision_onExpire)
        endif
        call sc__BUFFSemiPoision_onBuffRefresh(this)
    endfunction
    
    function s__BUFFSemiPoision_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__BUFFSemiPoision_source[this]) then
            set s__BUFFSemiPoision_running[this]=false
            call sc__BUFFSemiPoision_onBuffEnd(this)
            return
        endif
        if s__BUFFSemiPoision_count[this] > 0 then
            set s__BUFFSemiPoision_count[this]=s__BUFFSemiPoision_count[this] - 1
        endif
        call sc__BUFFSemiPoision_onBuffEffect(this)
        if s__BUFFSemiPoision_count[this] == 0 then
            set s__BUFFSemiPoision_running[this]=false
            call sc__BUFFSemiPoision_onBuffEnd(this)
            return
        endif
        call s__tick_start(s__BUFFSemiPoision_durationTimer[this],s__BUFFSemiPoision_duration[this] , false , function s__BUFFSemiPoision_onExpire)
    endfunction
    
    function s__BUFFSemiPoision_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFSemiPoision_rmTrig[this], s__BUFFSemiPoision_rmAct[this])
        set s__BUFFSemiPoision_rmAct[this]=null
        set s__BUFFSemiPoision_rmTrig[this]=null
        if s__BUFFSemiPoision_running[this] then
            set s__BUFFSemiPoision_running[this]=false
            call sc__BUFFSemiPoision_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFSemiPoision_durationTimer[this])
        set s__BUFFSemiPoision_source[this]=null
        set s__BUFFSemiPoision_caster[this]=null
        set s__BUFFSemiPoision_exist[this]=false
    endfunction
//end of: 버프_종류_반복적_중첩안됨()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFSemiPoision_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFSemiPoision_damage[this]=0
        set s__BUFFSemiPoision_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Possession\\PossessionCaster.mdl", s__BUFFSemiPoision_source[this], "origin")
        call UnitAddAbility(s__BUFFSemiPoision_source[this], s__BUFFSemiPoision_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFSemiPoision_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        if IsUnitDead(s__BUFFSemiPoision_caster[this]) then
            return
        endif
        set s__BUFFSemiPoision_damage[this]=s__BUFFSemiPoision_damage[this] + 100
        call s__enemy_dealLogicEx(s__BUFFSemiPoision_caster[this] , s__BUFFSemiPoision_source[this] , s__BUFFSemiPoision_damage[this] , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", s__BUFFSemiPoision_source[this], "origin"))
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFSemiPoision_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFSemiPoision_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFSemiPoision_source[this]) then
            call UnitRemoveAbility(s__BUFFSemiPoision_source[this], s__BUFFSemiPoision_ABILITY)
            call UnitRemoveAbility(s__BUFFSemiPoision_source[this], s__BUFFSemiPoision_BUFF)
        endif
        call DestroyEffect(s__BUFFSemiPoision_fx[this])
        set s__BUFFSemiPoision_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 어빌리티_선언_개시("SemiABuff")
//end of: 어빌리티_선언_개시("SemiABuff")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILSemiABuff_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSemiABuff_rmTrig[this], s__ABILSemiABuff_rmAct[this])
        set s__ABILSemiABuff_rmAct[this]=null
        set s__ABILSemiABuff_rmTrig[this]=null
        call sc__ABILSemiABuff_onAbilityLost(this)
        call s__tick_destroy(s__ABILSemiABuff_durTik[this])
        set s__ABILSemiABuff_source[this]=null
        set s__ABILSemiABuff_exists[this]=false
    endfunction
    
    function s__ABILSemiABuff_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSemiABuff_free(this)
    endfunction
    
    function s__ABILSemiABuff_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILSemiABuff_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILSemiABuff_source[this]) then
            return
        endif
        call sc__ABILSemiABuff_onAbilityEffect(this)
        call s__tick_start(s__ABILSemiABuff_durTik[this],s__ABILSemiABuff_duration[this] , false , function s__ABILSemiABuff_onExpire)
    endfunction
    
    function s__ABILSemiABuff_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSemiABuff_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSemiABuff_exists[this] then
            set s__ABILSemiABuff_exists[this]=true
            set s__ABILSemiABuff_source[this]=src
            set s__ABILSemiABuff_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSemiABuff_rmAct[this]=TriggerAddAction(s__ABILSemiABuff_rmTrig[this], function s__ABILSemiABuff_OnSourceRemove)
            
            set s__ABILSemiABuff_duration[this]=dur
            set s__ABILSemiABuff_defaultDuration[this]=dur
            set s__ABILSemiABuff_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILSemiABuff_durTik[this],dur , false , function s__ABILSemiABuff_onExpire)
            call sc__ABILSemiABuff_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
    function s__ABILSemiABuff_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__ABILSemiABuff_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), s__BUFFDoubleSummon_ABILITY) > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__ABILSemiABuff_LEV then
            set s__ABILSemiABuff_LEV=GetUnitLevel(GetEnumUnit())
            set s__ABILSemiABuff_CNT=0
        endif
        if GetRandomInt(0, s__ABILSemiABuff_CNT) == 0 then
            set s__ABILSemiABuff_DEST=GetEnumUnit()
        endif
        set s__ABILSemiABuff_CNT=s__ABILSemiABuff_CNT + 1
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILSemiABuff_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILSemiABuff_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSemiABuff_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer i= 0
        if IsUnitDead(s__ABILSemiABuff_source[this]) then
            return
        endif
        loop
            exitwhen i == 8
            set s__ABILSemiABuff_DEST=null
            set s__ABILSemiABuff_CNT=0
            set s__ABILSemiABuff_LEV=0
            call s__splash_range(s__splash_ALLY , s__ABILSemiABuff_source[this] , GetUnitX(s__ABILSemiABuff_source[this]) , GetUnitY(s__ABILSemiABuff_source[this]) , GetUnitAcquireRange(s__ABILSemiABuff_source[this]) + 100 , function s__ABILSemiABuff_enumGetTarget)
            if s__ABILSemiABuff_DEST != null then
                call sc__BUFFDoubleSummon_apply(s__ABILSemiABuff_DEST , null , 0.95 , 10)
            endif
            set i=i + 1
        endloop
        set s__ABILSemiABuff_DEST=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("DoubleSummon")
//end of: 버프_선언_개시("DoubleSummon")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩안됨()
    function s__BUFFDoubleSummon_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFDoubleSummon_exist[this] then
            set s__BUFFDoubleSummon_exist[this]=true
            set s__BUFFDoubleSummon_source[this]=src
            set s__BUFFDoubleSummon_caster[this]=cas
            set s__BUFFDoubleSummon_duration[this]=dur
            set s__BUFFDoubleSummon_count[this]=cnt
            set s__BUFFDoubleSummon_running[this]=false
            set s__BUFFDoubleSummon_durationTimer[this]=s__tick_create(this)
            set s__BUFFDoubleSummon_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFDoubleSummon_rmAct[this]=TriggerAddAction(s__BUFFDoubleSummon_rmTrig[this], function sc__BUFFDoubleSummon_onSourceRemove)
        endif
        if s__BUFFDoubleSummon_running[this] then
            if s__BUFFDoubleSummon_count[this] < 0 then
                return
            endif
            if dur * cnt < s__BUFFDoubleSummon_count[this] * s__BUFFDoubleSummon_duration[this] then
                return
            endif
            set s__BUFFDoubleSummon_count[this]=cnt
            set s__BUFFDoubleSummon_duration[this]=dur
        else
            set s__BUFFDoubleSummon_running[this]=true
            set s__BUFFDoubleSummon_count[this]=cnt
            set s__BUFFDoubleSummon_duration[this]=dur
            call sc__BUFFDoubleSummon_onBuffStart(this)
            call s__tick_start(s__BUFFDoubleSummon_durationTimer[this],s__BUFFDoubleSummon_duration[this] , false , function sc__BUFFDoubleSummon_onExpire)
        endif
        call sc__BUFFDoubleSummon_onBuffRefresh(this)
    endfunction
    
    function s__BUFFDoubleSummon_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__BUFFDoubleSummon_source[this]) then
            set s__BUFFDoubleSummon_running[this]=false
            call sc__BUFFDoubleSummon_onBuffEnd(this)
            return
        endif
        if s__BUFFDoubleSummon_count[this] > 0 then
            set s__BUFFDoubleSummon_count[this]=s__BUFFDoubleSummon_count[this] - 1
        endif
        call sc__BUFFDoubleSummon_onBuffEffect(this)
        if s__BUFFDoubleSummon_count[this] == 0 then
            set s__BUFFDoubleSummon_running[this]=false
            call sc__BUFFDoubleSummon_onBuffEnd(this)
            return
        endif
        call s__tick_start(s__BUFFDoubleSummon_durationTimer[this],s__BUFFDoubleSummon_duration[this] , false , function s__BUFFDoubleSummon_onExpire)
    endfunction
    
    function s__BUFFDoubleSummon_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFDoubleSummon_rmTrig[this], s__BUFFDoubleSummon_rmAct[this])
        set s__BUFFDoubleSummon_rmAct[this]=null
        set s__BUFFDoubleSummon_rmTrig[this]=null
        if s__BUFFDoubleSummon_running[this] then
            set s__BUFFDoubleSummon_running[this]=false
            call sc__BUFFDoubleSummon_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFDoubleSummon_durationTimer[this])
        set s__BUFFDoubleSummon_source[this]=null
        set s__BUFFDoubleSummon_caster[this]=null
        set s__BUFFDoubleSummon_exist[this]=false
    endfunction
//end of: 버프_종류_반복적_중첩안됨()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFDoubleSummon_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        call sc__EVDamageManager_addBonus(s__BUFFDoubleSummon_source[this] , s__BUFFDoubleSummon_ATBO)
        set s__BUFFDoubleSummon_fx[this]=AddSpecialEffectTarget(s__BUFFDoubleSummon_FXMD, s__BUFFDoubleSummon_source[this], s__BUFFDoubleSummon_FXAT)
        call UnitAddAbility(s__BUFFDoubleSummon_source[this], s__BUFFDoubleSummon_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFDoubleSummon_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFDoubleSummon_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        call SetUnitState(s__BUFFDoubleSummon_source[this], UNIT_STATE_MANA, GetUnitState(s__BUFFDoubleSummon_source[this], UNIT_STATE_MANA) + 3.00)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFDoubleSummon_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFDoubleSummon_source[this]) then
            call sc__EVDamageManager_addBonus(s__BUFFDoubleSummon_source[this] , - s__BUFFDoubleSummon_ATBO)
            call UnitRemoveAbility(s__BUFFDoubleSummon_source[this], s__BUFFDoubleSummon_ABILITY)
            call UnitRemoveAbility(s__BUFFDoubleSummon_source[this], s__BUFFDoubleSummon_BUFF)
        endif
        call DestroyEffect(s__BUFFDoubleSummon_fx[this])
        set s__BUFFDoubleSummon_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
