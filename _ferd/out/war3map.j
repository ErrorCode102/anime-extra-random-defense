// scope PLAYtryboss begins
    
    function PLAYtryboss___genBoss takes player p,player ep,integer lv,boolean isFinal returns nothing
        local integer id= GetPlayerId(p)
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local unit u= CreateUnit(ep, PLAYtryboss___UID[lv], x, y, GetRandomReal(0, 360))
        local integer cin
        call UnitAddAbility(u, 'Aeth')
        call UnitAddAbility(u, 'A00O')
        call s__enemy_add(ep , u)
        //Boss 기본 Ability (모든 모드 공통)
        call s__EVBossDispell_append(u , 15.00 , 5.00)
        if id == 11 then
            //브금재생
            call s__TLThematicMusic_apply(u , null , "Music\\YouAreMyKing_Part_B.mp3")
            set cin=CountInGameUser() - 1
            if cin > 0 then
                set cin=cin + 2
                call s__manaMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.50 * cin))
                call s__lifeMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.50 * cin))
            endif
            //각 보스 스킬
            if lv == 1 then
                call s__BossSkillSplash_append(u , 20.00 , 10.00)
            endif
            if lv == 2 then
                call s__BossStunStrongest_append(u , 20.00 , 10.00)
            endif
            if lv == 3 then
                call s__BossSkillKnockback_append(u , 15.00 , 5.00)
            endif
            if lv == 4 then
                call s__EVBossSkillBlackhole_append(u , gg_rct_Z_BOSS)
            endif
            if lv == 5 then
                call s__EVBossSkillBathory_append(u , gg_rct_Z_BOSS)
            endif
            if lv >= 5 then
                call s__BossSkillSecondPhase_append(u , 1.00)
            endif
            if lv == 6 then
                call s__EVBossSkillBan_append(u , gg_rct_Z_BOSS)
            endif
            if lv == 7 then
                call s__EVBossSkillTornado_append(u , gg_rct_Z_BOSS)
            endif
            if lv == 8 then
                call s__EVBossSkillStasis_append(u , 15.00 , gg_rct_Z_BOSS)
            endif
            if lv == 9 then
                call s__EVBossSkillR90_append(u , gg_rct_Z_BOSS , 20.00)
            endif
            if lv == 10 then
                call s__EVBossSkillR100_append(u , 15.00 , 5.00 , gg_rct_Z_BOSS)
            endif
            //이어서...
            call s__EVFreeRectMovement_append(u , gg_rct_Z_BOSS , PLAYtryboss___UMOTION[lv])
            if isFinal then
                call s__EVGameFinalizer_append(u)
                call s__EVMissionTimeout_append(GetLocalPlayer() , u , 300.00 , "|c00FF4040Terminator|r")
                call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c00ff0000Terminator appeared! If you kill the Terminator, you will win the game!|r")
            else
                call s__EVMissionTimeout_append(GetLocalPlayer() , u , 300.00 , "Boss " + PLAYtryboss___PREFIX[lv])
                call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c00ff0000The Boss has appeared!")
            endif
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c00ff0000If you don't kill it within 5 minutes, all players will lose!")
        else
            call s__TLThematicMusic_apply(u , p , "Music\\YouAreMyKing_Part_B.mp3")
            call s__EVFreeRectMovement_append(u , PLAYER_ZONE_LINE[id] , PLAYtryboss___UMOTION[lv])
            if isFinal then
                call s__EVGameFinalizer_append(u)
                call s__EVMissionTimeout_append(p , u , 300.00 , "|c00FF4040Terminator|r : " + s__pcs__staticgetindex(id) + USER_NAME_CURRENT[id])
                call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff0000Terminator appeared! If you kill the Terminator, Speedrun will be completed!")
            else
                call s__EVMissionTimeout_append(p , u , 300.00 , "Boss " + PLAYtryboss___PREFIX[lv] + " : " + s__pcs__staticgetindex(id) + USER_NAME_CURRENT[id])
                call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff0000The Boss has appeared!")
            endif
            call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff0000If you don't kill it within 5 minutes, you'll lose!")
        endif
        if GetPanalty(PANALTY_ENEMY_HEAL) then
            call UnitAddAbility(u, 'A04J')
            call s__EVStateRegenerate_append(u , GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.005 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
        else
            call s__EVStateRegenerate_append(u , 0.00 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
        endif
        call s__lifeMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_LIFE) * LEVEL_HP[LEVEL_CURRENT]))
        call s__manaMod_apply(u , R2I(GetUnitState(u, UNIT_STATE_MAX_MANA) * LEVEL_HP[LEVEL_CURRENT]))
        call s__EVSpecialBounty_append(u , "Boss" , Player(id) , PLAYtryboss___GOLD[lv] , 3 , 5 , 0 , 0 , 0)
        call s__EVDamageBounty_append(u)
        call PingMinimapEx(x, y, 10.00, 255, 0, 0, true)
        call PingMinimapEx(x, y, 10.00, 255, 0, 0, false)
        //종결
        set u=null
    endfunction
    
    function PLAYtryboss___onGameRound takes nothing returns nothing
        local integer id= GetPlayerId(s__eventCustom_getTriggerPlayer())
        local integer wav= GetUserWave(Player(id))
        if ModuloInteger(wav, 10) != 0 then
            return
        endif
        if FXRD_UNION_WAVE then
            call PLAYtryboss___genBoss(Player(11) , Player(11) , wav / 10 , wav == LEVEL_WAVE[LEVEL_CURRENT])
        else
            call PLAYtryboss___genBoss(Player(id) , Player(id + 4) , wav / 10 , wav == LEVEL_WAVE[LEVEL_CURRENT])
        endif
    endfunction
    
