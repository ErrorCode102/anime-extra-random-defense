//textmacro instance: 어빌리티_선언_개시("JeanneLPUC")
//end of: 어빌리티_선언_개시("JeanneLPUC")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0G9")
    
    function s__ABILJeanneLPUC_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILJeanneLPUC_onSpellEffect[this], s__ABILJeanneLPUC_onSpellEffectAction[this])
        set s__ABILJeanneLPUC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILJeanneLPUC_onSpellEffect[this])
        set s__ABILJeanneLPUC_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILJeanneLPUC_rmTrig[this], s__ABILJeanneLPUC_rmAct[this])
        set s__ABILJeanneLPUC_rmAct[this]=null
        set s__ABILJeanneLPUC_rmTrig[this]=null
        call sc__ABILJeanneLPUC_onAbilityLost(this)
        set s__ABILJeanneLPUC_source[this]=null
        set s__ABILJeanneLPUC_exists[this]=false
    endfunction
    
    function s__ABILJeanneLPUC_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILJeanneLPUC_free(this)
    endfunction
    
    function s__ABILJeanneLPUC_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILJeanneLPUC_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILJeanneLPUC_exists[this] then
            set s__ABILJeanneLPUC_exists[this]=true
            set s__ABILJeanneLPUC_source[this]=src
            set s__ABILJeanneLPUC_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILJeanneLPUC_rmAct[this]=TriggerAddAction(s__ABILJeanneLPUC_rmTrig[this], function s__ABILJeanneLPUC_OnSourceRemove)
            set s__ABILJeanneLPUC_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILJeanneLPUC_onSpellEffect[this], Condition(function sc__ABILJeanneLPUC_conditionSpellEffect))
            set s__ABILJeanneLPUC_onSpellEffectAction[this]=TriggerAddAction(s__ABILJeanneLPUC_onSpellEffect[this], function sc__ABILJeanneLPUC_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILJeanneLPUC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILJeanneLPUC_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILJeanneLPUC_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILJeanneLPUC_exists[this] then
            return
        endif
        call sc__ABILJeanneLPUC_onAbilityEffect(this)
    endfunction
    
    function s__ABILJeanneLPUC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILJeanneLPUC_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0G9")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILJeanneLPUC_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILJeanneLPUC_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILJeanneLPUC_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call sc__CMPucelle_castEx(s__ABILJeanneLPUC_source[this] , 1000000.0 , 10.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("JeanneFire")
//end of: 어빌리티_선언_개시("JeanneFire")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILJeanneFire_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILJeanneFire_rmTrig[this], s__ABILJeanneFire_rmAct[this])
        set s__ABILJeanneFire_rmAct[this]=null
        set s__ABILJeanneFire_rmTrig[this]=null
        call sc__ABILJeanneFire_onAbilityLost(this)
        set s__ABILJeanneFire_source[this]=null
        set s__ABILJeanneFire_exists[this]=false
    endfunction
    
    function s__ABILJeanneFire_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILJeanneFire_free(this)
    endfunction
    
    function s__ABILJeanneFire_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILJeanneFire_onAbilityEffect(this)
    endfunction
    
    function s__ABILJeanneFire_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILJeanneFire_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILJeanneFire_exists[this] then
            set s__ABILJeanneFire_exists[this]=true
            set s__ABILJeanneFire_source[this]=src
            set s__ABILJeanneFire_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILJeanneFire_rmAct[this]=TriggerAddAction(s__ABILJeanneFire_rmTrig[this], function s__ABILJeanneFire_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILJeanneFire_onSourceUnitAttack)
            call sc__ABILJeanneFire_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    function s__ABILJeanneFire_enumFunction takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__ABILJeanneFire_source[this]) then
            return
        endif
        if IsUnitDead(s__ABILJeanneFire_MarkedTarget[this]) then
            if s__ABILJeanneFire_MarkFx[this] != null then
                call DestroyEffect(s__ABILJeanneFire_MarkFx[this])
                set s__ABILJeanneFire_MarkFx[this]=null
            endif
            set s__ABILJeanneFire_MarkedTarget[this]=null
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Other\\NeutralBuildingExplosion\\NeutralBuildingExplosion.mdl", s__ABILJeanneFire_MarkedTarget[this], "origin"))
        call s__enemy_dealLogicEx(s__ABILJeanneFire_source[this] , s__ABILJeanneFire_MarkedTarget[this] , s__ABILJeanneFire_MarkDamage[this] , true , true , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILJeanneFire_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILJeanneFire_MarkedTarget[this]=null
        set s__ABILJeanneFire_MarkFx[this]=null
        set s__ABILJeanneFire_MarkDamage[this]=0.0
        set s__ABILJeanneFire_MarkTick[this]=s__tick_create(this)
        call s__tick_start(s__ABILJeanneFire_MarkTick[this],1.0 , true , function s__ABILJeanneFire_enumFunction)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILJeanneFire_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        if s__ABILJeanneFire_MarkFx[this] != null then
            call DestroyEffect(s__ABILJeanneFire_MarkFx[this])
            set s__ABILJeanneFire_MarkFx[this]=null
        endif
        set s__ABILJeanneFire_MarkedTarget[this]=null
        call s__tick_destroy(s__ABILJeanneFire_MarkTick[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILJeanneFire_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            if s__ABILJeanneFire_MarkedTarget[this] != dst then
                if s__ABILJeanneFire_MarkFx[this] != null then
                    call DestroyEffect(s__ABILJeanneFire_MarkFx[this])
                    set s__ABILJeanneFire_MarkFx[this]=null
                endif
                set s__ABILJeanneFire_MarkedTarget[this]=dst
                set s__ABILJeanneFire_MarkDamage[this]=0.0
                set s__ABILJeanneFire_MarkFx[this]=AddSpecialEffectTarget("Doodads\\Cinematic\\FirePillarMedium\\FirePillarMedium.mdl", dst, "chest")
            endif
            set s__ABILJeanneFire_MarkDamage[this]=s__ABILJeanneFire_MarkDamage[this] + 250.0
        endif
        set src=null
        set dst=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("JeanneCARI")
//end of: 어빌리티_선언_개시("JeanneCARI")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILJeanneCARI_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILJeanneCARI_rmTrig[this], s__ABILJeanneCARI_rmAct[this])
        set s__ABILJeanneCARI_rmAct[this]=null
        set s__ABILJeanneCARI_rmTrig[this]=null
        call sc__ABILJeanneCARI_onAbilityLost(this)
        call s__tick_destroy(s__ABILJeanneCARI_durTik[this])
        set s__ABILJeanneCARI_source[this]=null
        set s__ABILJeanneCARI_exists[this]=false
    endfunction
    
    function s__ABILJeanneCARI_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILJeanneCARI_free(this)
    endfunction
    
    function s__ABILJeanneCARI_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILJeanneCARI_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILJeanneCARI_source[this]) then
            return
        endif
        call sc__ABILJeanneCARI_onAbilityEffect(this)
        call s__tick_start(s__ABILJeanneCARI_durTik[this],s__ABILJeanneCARI_duration[this] , false , function s__ABILJeanneCARI_onExpire)
    endfunction
    
    function s__ABILJeanneCARI_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILJeanneCARI_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILJeanneCARI_exists[this] then
            set s__ABILJeanneCARI_exists[this]=true
            set s__ABILJeanneCARI_source[this]=src
            set s__ABILJeanneCARI_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILJeanneCARI_rmAct[this]=TriggerAddAction(s__ABILJeanneCARI_rmTrig[this], function s__ABILJeanneCARI_OnSourceRemove)
            
            set s__ABILJeanneCARI_duration[this]=dur
            set s__ABILJeanneCARI_defaultDuration[this]=dur
            set s__ABILJeanneCARI_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILJeanneCARI_durTik[this],dur , false , function s__ABILJeanneCARI_onExpire)
            call sc__ABILJeanneCARI_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
    function s__ABILJeanneCARI_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'B01C') > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__ABILJeanneCARI_LEV then
            set s__ABILJeanneCARI_LEV=GetUnitLevel(GetEnumUnit())
            set s__ABILJeanneCARI_CNT=0
        endif
        if GetRandomInt(0, s__ABILJeanneCARI_CNT) == 0 then
            set s__ABILJeanneCARI_DEST=GetEnumUnit()
        endif
        set s__ABILJeanneCARI_CNT=s__ABILJeanneCARI_CNT + 1
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILJeanneCARI_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILJeanneCARI_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILJeanneCARI_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer i= 0
        set s__ABILJeanneCARI_DEST=null
        set s__ABILJeanneCARI_CNT=0
        set s__ABILJeanneCARI_LEV=0
        call s__splash_range(s__splash_PLAYER , s__ABILJeanneCARI_source[this] , GetUnitX(s__ABILJeanneCARI_source[this]) , GetUnitY(s__ABILJeanneCARI_source[this]) , 1000.0 , function s__ABILJeanneCARI_enumGetTarget)
        if s__ABILJeanneCARI_DEST == null then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", s__ABILJeanneCARI_DEST, "origin"))
        //call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl",.source,"origin"))
        call sc__BUFFJeanneCARI_apply(s__ABILJeanneCARI_DEST , 10.0)
        set s__ABILJeanneCARI_DEST=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("JeanneCARI")
//end of: 버프_선언_개시("JeanneCARI")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFJeanneCARI_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFJeanneCARI_exist[this] then
            set s__BUFFJeanneCARI_exist[this]=true
            set s__BUFFJeanneCARI_running[this]=false
            set s__BUFFJeanneCARI_source[this]=src
            set s__BUFFJeanneCARI_duration[this]=dur
            set s__BUFFJeanneCARI_durationTimer[this]=s__tick_create(this)
            set s__BUFFJeanneCARI_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFJeanneCARI_rmAct[this]=TriggerAddAction(s__BUFFJeanneCARI_rmTrig[this], function sc__BUFFJeanneCARI_onSourceRemove)
        endif
        if s__BUFFJeanneCARI_running[this] then
            if dur < s__tick__get_remaining(s__BUFFJeanneCARI_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFJeanneCARI_running[this]=true
            call sc__BUFFJeanneCARI_onBuffStart(this)
        endif
        set s__BUFFJeanneCARI_duration[this]=dur
        call sc__BUFFJeanneCARI_onBuffRefresh(this)
        call s__tick_start(s__BUFFJeanneCARI_durationTimer[this],s__BUFFJeanneCARI_duration[this] , false , function sc__BUFFJeanneCARI_onExpire)
    endfunction
    function s__BUFFJeanneCARI_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFJeanneCARI_running[this]=false
        call sc__BUFFJeanneCARI_onBuffEnd(this)
    endfunction
    function s__BUFFJeanneCARI_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFJeanneCARI_rmTrig[this], s__BUFFJeanneCARI_rmAct[this])
        set s__BUFFJeanneCARI_rmAct[this]=null
        set s__BUFFJeanneCARI_rmTrig[this]=null
        if s__BUFFJeanneCARI_running[this] then
            set s__BUFFJeanneCARI_running[this]=false
            call sc__BUFFJeanneCARI_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFJeanneCARI_durationTimer[this])
        set s__BUFFJeanneCARI_source[this]=null
        set s__BUFFJeanneCARI_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFJeanneCARI_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFJeanneCARI_fx[this]=AddSpecialEffectTarget(s__BUFFJeanneCARI_PATH_EFFECT, s__BUFFJeanneCARI_source[this], s__BUFFJeanneCARI_POINT_EFFECT)
        call UnitAddAbility(s__BUFFJeanneCARI_source[this], s__BUFFJeanneCARI_ABID)
        call sc__EVDamageManager_addBonus(s__BUFFJeanneCARI_source[this] , s__BUFFJeanneCARI_ATBO)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFJeanneCARI_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFJeanneCARI_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if IsUnitAlive(s__BUFFJeanneCARI_source[this]) then
            call UnitRemoveAbility(s__BUFFJeanneCARI_source[this], s__BUFFJeanneCARI_ABID)
            call UnitRemoveAbility(s__BUFFJeanneCARI_source[this], s__BUFFJeanneCARI_BFID)
            call sc__EVDamageManager_addBonus(s__BUFFJeanneCARI_source[this] , - s__BUFFJeanneCARI_ATBO)
        endif
        call DestroyEffect(s__BUFFJeanneCARI_fx[this])
        set s__BUFFJeanneCARI_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
//end of: 버프_선언_끝()//===========================================================================
// Trigger: Common Jeanne
//===========================================================================
    function s__CMPucelle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMPucelle_myDummy[this])
        call ShowUnit(s__CMPucelle_myDummy[this], false)
        set s__CMPucelle_myDummy[this]=null
        set s__CMPucelle_caster[this]=null
        call s__tick_destroy(s__CMPucelle_main[this])
    endfunction
    function s__CMPucelle_enumDealtUlt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , s__CMPucelle_stunTime[this])
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            call s__enemy_dealLogic(s__CMPucelle_caster[this] , GetEnumUnit() , s__CMPucelle_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        else
            call s__enemy_dealLogic(s__CMPucelle_caster[this] , GetEnumUnit() , 99999999.0 , WEAPON_TYPE_WHOKNOWS , 1)
        endif
    endfunction
    function s__CMPucelle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , s__CMPucelle_stunTime[this])
        call s__enemy_dealLogic(s__CMPucelle_caster[this] , GetEnumUnit() , s__CMPucelle_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function s__CMPucelle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMPucelle_loops[this] == 0 then
            call SetSoundPosition(gg_snd_Puicell_1, s__CMPucelle_myX[this], s__CMPucelle_myY[this], 300.0)
            call StartSound(gg_snd_Puicell_1)
            call SetSoundPosition(gg_snd_Puicell_2, s__CMPucelle_myX[this], s__CMPucelle_myY[this], 300.0)
            call StartSound(gg_snd_Puicell_2)
            call SetSoundPosition(gg_snd_Puicell_3, s__CMPucelle_myX[this], s__CMPucelle_myY[this], 300.0)
            call StartSound(gg_snd_Puicell_3)
            call SetUnitTimeScale(s__CMPucelle_myDummy[this], 0.0)
            call s__tick_start(s__CMPucelle_main[this],0.05 , true , function s__CMPucelle_onFire)
        endif
        if s__CMPucelle_loops[this] == 25 then
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01G', s__CMPucelle_myX[this], s__CMPucelle_myY[this], GetRandomReal(0.0, 360.0)))
        endif
        if s__CMPucelle_loops[this] == 80 then
            call SetSoundPosition(gg_snd_Puicell_4, s__CMPucelle_myX[this], s__CMPucelle_myY[this], 300.0)
            call StartSound(gg_snd_Puicell_4)
            call SetSoundPosition(gg_snd_Puicell_5, s__CMPucelle_myX[this], s__CMPucelle_myY[this], 300.0)
            call StartSound(gg_snd_Puicell_5)
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01C', s__CMPucelle_myX[this], s__CMPucelle_myY[this], 270.0))
            if s__CMPucelle_ultimate[this] then
                call s__splash_range(s__splash_ENEMY , s__CMPucelle_caster[this] , s__CMPucelle_myX[this] , s__CMPucelle_myY[this] , 2000 , function s__CMPucelle_enumDealtUlt)
            else
                call s__splash_range(s__splash_ENEMY , s__CMPucelle_caster[this] , s__CMPucelle_myX[this] , s__CMPucelle_myY[this] , 2000 , function s__CMPucelle_enumDealt)
            endif
            call sc__DummyColorChanger_cast(s__CMPucelle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
            call s__tick_start(s__CMPucelle_main[this],0.20 , false , function s__CMPucelle_onFinal)
            return
        endif
        set s__CMPucelle_loops[this]=s__CMPucelle_loops[this] + 1
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01E', s__CMPucelle_myX[this], s__CMPucelle_myY[this], GetRandomReal(0.0, 360.0)))
        if s__CMPucelle_loops[this] > 60 then
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01F', s__CMPucelle_myX[this], s__CMPucelle_myY[this], GetRandomReal(0.0, 360.0)))
        endif
    endfunction
    function s__CMPucelle_cast takes unit src,real dmg,real stunt returns nothing
        local integer this= s__tick_create(0)
        set s__CMPucelle_caster[this]=src
        set s__CMPucelle_myX[this]=GetUnitX(src)
        set s__CMPucelle_myY[this]=GetUnitY(src)
        set s__CMPucelle_damage[this]=dmg
        set s__CMPucelle_stunTime[this]=stunt
        set s__CMPucelle_loops[this]=0
        set s__CMPucelle_main[this]=this
        set s__CMPucelle_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01D', s__CMPucelle_myX[this], s__CMPucelle_myY[this], GetUnitFacing(src))
        set s__CMPucelle_ultimate[this]=false
        call sc__DummyColorChanger_cast(s__CMPucelle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 1.0)
        call SetUnitAnimation(s__CMPucelle_myDummy[this], "spell one")
        call SetUnitTimeScale(s__CMPucelle_myDummy[this], 0.5)
        call s__tick_start(s__CMPucelle_main[this],1.0 , false , function s__CMPucelle_onFire)
    endfunction
    function s__CMPucelle_castEx takes unit src,real dmg,real stunt returns nothing
        local integer this= s__tick_create(0)
        set s__CMPucelle_caster[this]=src
        set s__CMPucelle_myX[this]=GetUnitX(src)
        set s__CMPucelle_myY[this]=GetUnitY(src)
        set s__CMPucelle_damage[this]=dmg
        set s__CMPucelle_stunTime[this]=stunt
        set s__CMPucelle_loops[this]=0
        set s__CMPucelle_main[this]=this
        set s__CMPucelle_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01D', s__CMPucelle_myX[this], s__CMPucelle_myY[this], GetUnitFacing(src))
        set s__CMPucelle_ultimate[this]=true
        call sc__DummyColorChanger_cast(s__CMPucelle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 1.0)
        call SetUnitAnimation(s__CMPucelle_myDummy[this], "spell one")
        call SetUnitTimeScale(s__CMPucelle_myDummy[this], 0.50)
        call s__tick_start(s__CMPucelle_main[this],1.0 , false , function s__CMPucelle_onFire)
    endfunction

    function s__CMPucellePanalty_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMPucellePanalty_target[this], UNIT_TYPE_DEAD) then
            call UnitRemoveAbility(s__CMPucellePanalty_target[this], 'A09O')
            call UnitRemoveAbility(s__CMPucellePanalty_target[this], 'B012')
        endif
        call DestroyEffect(s__CMPucellePanalty_fx[this])
        set s__CMPucellePanalty_fx[this]=null
        set s__CMPucellePanalty_target[this]=null
        call s__tick_destroy(s__CMPucellePanalty_mainFlow[this])
    endfunction
    function s__CMPucellePanalty_onCast takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if GetUnitAbilityLevel(s__CMPucellePanalty_target[this], 'A09O') > 0 or IsUnitDead(s__CMPucellePanalty_target[this]) then
            set s__CMPucellePanalty_target[this]=null
            call s__tick_destroy(s__CMPucellePanalty_mainFlow[this])
            return
        endif
        set s__CMPucellePanalty_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Banish\\BanishTarget.mdl", s__CMPucellePanalty_target[this], "origin")
        call UnitAddAbility(s__CMPucellePanalty_target[this], 'A09O')
        call s__tick_start(s__CMPucellePanalty_mainFlow[this],s__CMPucellePanalty_myDelay[this] , false , function s__CMPucellePanalty_onFinal)
    endfunction
    function s__CMPucellePanalty_cast takes unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMPucellePanalty_target[this]=dst
        set s__CMPucellePanalty_myDelay[this]=delay
        set s__CMPucellePanalty_mainFlow[this]=this
        call s__tick_start(s__CMPucellePanalty_mainFlow[this],0.10 , false , function s__CMPucellePanalty_onCast)
    endfunction
// Trigger: Servant Kiara
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("KIARA","BB")
// scope SVKIARA begins
//end of: 서번트_선언_개시("KIARA","BB")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVKIARA__EnumKiara takes nothing returns nothing
            call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 1.00)
            call DestroyEffect(AddSpecialEffect("FX\\ShadowAssault.mdl", GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit())))
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
        endfunction
//textmacro instance: 서번트_무기_방사형("KiaraWeapon","RMaxBJ(600,Distance.WBW(source,target)+100)","EnumKiara")
        function SVKIARA__KiaraWeapon takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
            call s__splash_range(s__splash_ENEMY , source , GetUnitX(source) , GetUnitY(source) , RMaxBJ(600, s__Distance_WBW(source , target) + 100) , function SVKIARA__EnumKiara)
            set source=null
            set target=null
        endfunction
//end of: 서번트_무기_방사형("KiaraWeapon","RMaxBJ(600,Distance.WBW(source,target)+100)","EnumKiara")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "KiaraWeapon")
    function SVKIARA__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVKIARA__KiaraWeapon()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "KiaraWeapon")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVKIARA__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVKIARA__MeleeAttack)
            //Adding Special Skillz
            call UnitRemoveAbility(s__eventServantAdd_e, 'A05T')
            call UnitAddAbility(s__eventServantAdd_e, 'A0D3')
            call sc__ABILKiaraCCCC_append(s__eventServantAdd_e)
            call sc__FXKiara_cast(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVKIARA__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVKIARA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVKIARA__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVKIARA__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("7","4444","Anylevel")
        set SVKIARA__SERVANT_DAMAGE[7]=4444
        call s__eventServantAdd_register(SVKIARA__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVKIARA__Anylevel)
//end of: 서번트_등록("7","4444","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVKIARA ends
