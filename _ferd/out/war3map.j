            call sc__EV142NeroA_append(s__eventServantAdd_e , 3200 , 10.00 , 0.00)
            call sc__EV143NeroB_append(s__eventServantAdd_e , 4)
        endif
        if lv == 7 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A032')
            call sc__EV142NeroA_append(s__eventServantAdd_e , 0 , 10.00 , 0.50)
            call sc__EV143NeroB_append(s__eventServantAdd_e , 3)
            call sc__EV144NeroEXC_append(s__eventServantAdd_e)
        endif
    endfunction
