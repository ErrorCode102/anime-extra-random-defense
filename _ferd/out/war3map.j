    endfunction
    
    
    function FXTrigUsingWispCtrlTool__onChangeServantSellSetting takes nothing returns nothing
        local player p= GetOwningPlayer(GetTriggerUnit())
        local integer currentSetting= FXTogglePlayerServantSellSetting(p)
        call CONTSetSellzoneState(p , currentSetting)
        if currentSetting == 0 then
            call DisplayTextToPlayer(p, 0, 0, "Servant sale was set to |c00b0b0b0Locked|r state.")
        elseif currentSetting == 1 then
            call DisplayTextToPlayer(p, 0, 0, "You have allowed selling of |c004040ffC|r and below grade Servants.")
        elseif currentSetting == 2 then
            call DisplayTextToPlayer(p, 0, 0, "You have allowed selling of |c00ffff00A|r and below grade Servants.")
        endif
        call SetUnitAbilityLevel(GetTriggerUnit(), 'A068', currentSetting + 1)
        set p=null
    endfunction
    
    function FXTrigUsingWispCtrlTool__onAutoSellFilter takes nothing returns boolean
        local integer cnt= 0
        if GetUnitAbilityLevel(GetFilterUnit(), FXTrigUsingWispCtrlTool__ABIL) == 0 then
            return false
        endif
        if GetUnitLevel(GetFilterUnit()) > 3 then
            return false
        endif
        set cnt=LoadInteger(FXTrigUsingWispCtrlTool__H, 0, GetUnitTypeId(GetFilterUnit()))
        if cnt < 6 then
            call SaveInteger(FXTrigUsingWispCtrlTool__H, 0, GetUnitTypeId(GetFilterUnit()), cnt + 1)
            return false
        endif
        call IssueImmediateOrder(GetFilterUnit(), "neutralinteract")
        set FXTrigUsingWispCtrlTool__CNT=FXTrigUsingWispCtrlTool__CNT + 1
        return false
    endfunction
    function FXTrigUsingWispCtrlTool__onAutoSell takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call FlushChildHashtable(FXTrigUsingWispCtrlTool__H, 0)
        set FXTrigUsingWispCtrlTool__IND=0
        set FXTrigUsingWispCtrlTool__CNT=0
        call GroupEnumUnitsOfPlayer(FXTrigUsingWispCtrlTool__G, Player(id), Filter(function FXTrigUsingWispCtrlTool__onAutoSellFilter))
        call GroupClear(FXTrigUsingWispCtrlTool__G)
        call DisplayTextToPlayer(Player(id), 0, 0, "|c000080ffSelling|r " + I2S(FXTrigUsingWispCtrlTool__CNT) + " |c000080ffservants|r")
    endfunction
    
    function FXTrigUsingWispCtrlTool__main takes nothing returns nothing
        call s__AbilityEffectEvent_Create('A055' , function FXTrigUsingWispCtrlTool__onAutoSell)
        call s__AbilityEffectEvent_Create('A068' , function FXTrigUsingWispCtrlTool__onChangeServantSellSetting)
        
        call FXTrigUsingWispCtrlTool__RegisterCommandTrigger(function FXTrigUsingWispCtrlTool__onChatGold , function FXTrigUsingWispCtrlTool__onChatLumber , function FXTrigUsingWispCtrlTool__onChatGacha , function FXTrigUsingWispCtrlTool__onChatEGacha , function FXTrigUsingWispCtrlTool__onChatStop)
        call s__AbilityEffectEvent_Create('*can' , function FXTrigUsingWispCtrlTool__onAutoStop)
        call s__AbilityEffectEvent_Create('*eat' , function FXTrigUsingWispCtrlTool__onAutoEGacha)
        call s__AbilityEffectEvent_Create('*gat' , function FXTrigUsingWispCtrlTool__onAutoGacha)
        call s__AbilityEffectEvent_Create('*gol' , function FXTrigUsingWispCtrlTool__onAutoGold)
        call s__AbilityEffectEvent_Create('*lum' , function FXTrigUsingWispCtrlTool__onAutoLumber)
    endfunction
// scope FXTrigUsingWispCtrlTool ends
// Trigger: SP Trig When Player Leave
//===========================================================================
// scope SPwhenplayerleave begins
    //구현부
    function SPwhenplayerleave__atObserverLeave takes player p returns nothing
        local integer id= GetPlayerId(p)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 30.0, s__pcs__staticgetindex(id) + GetPlayerName(p) + "|r stopped watching and left the game.")
    endfunction
    function SPwhenplayerleave__atUserLeave takes player p returns nothing
        local integer id= GetPlayerId(p)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 30.0, s__pcs__staticgetindex(id) + GetPlayerName(p) + "|r left the game!")
    endfunction
    //핵심 알고리즘
    function SPwhenplayerleave__onPlayerLeave takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if id > 3 then
            //옵저버가 나감
            call SPwhenplayerleave__atObserverLeave(GetTriggerPlayer())
            return
        endif
        //유저가 나감
        call SPwhenplayerleave__atUserLeave(GetTriggerPlayer())
    endfunction
    //초기화
    function SPwhenplayerleave__main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterPlayerEventLeave(t, Player(0))
        call TriggerRegisterPlayerEventLeave(t, Player(1))
        call TriggerRegisterPlayerEventLeave(t, Player(2))
        call TriggerRegisterPlayerEventLeave(t, Player(3))
        
        call TriggerRegisterPlayerEventLeave(t, Player(8))
        call TriggerRegisterPlayerEventLeave(t, Player(9))
        call TriggerRegisterPlayerEventLeave(t, Player(10))
        call TriggerAddAction(t, function SPwhenplayerleave__onPlayerLeave)
    endfunction
// scope SPwhenplayerleave ends
