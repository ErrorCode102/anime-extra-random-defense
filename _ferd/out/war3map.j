// scope SvGilgamesh begins
    //
    //기본 서번트 스탯 설정
    //구현부
    function SvGilgamesh__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvGilgamesh__onAttackAbility takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__CMWeaponrain_cast(src , GetUnitX(dst) , GetUnitY(dst) , 300.0 , s__EVDamageManager_getFinalDamage(src) * 0.5 , 3 , 0.21)
        set src=null
        set dst=null
    endfunction
    function SvGilgamesh__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvGilgamesh__ODMG[lv])
        //Adding Special Skillz
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvGilgamesh__onAttack)
            call sc__EV134GilgameshA_append(s__eventServantAdd_e , 500 , 5.0)
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvGilgamesh__onAttack)
            call sc__EV134GilgameshA_append(s__eventServantAdd_e , 1250 , 5.0)
            call sc__EV135GilgameshB_append(s__eventServantAdd_e , 15000 , 15.0)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvGilgamesh__onAttack)
            call sc__EV134GilgameshA_append(s__eventServantAdd_e , 8000 , 5.0)
            call sc__EV135GilgameshB_append(s__eventServantAdd_e , 96000 , 15.0)
        endif
        if lv == 7 then
            set IS_PLAYER_HAVE_EX_GILGAMESH[GetPlayerId(s__eventServantAdd_ep)]=true
            call UnitRemoveAbility(s__eventServantAdd_e, 'A045')
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvGilgamesh__onAttackAbility)
            call sc__EV136GilgameshB2_append(s__eventServantAdd_e)
            call sc__EV137GilgameshEXC_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvGilgamesh__main takes nothing returns nothing
        set SvGilgamesh__ODMG[4]=80
        set SvGilgamesh__ODMG[5]=200
        set SvGilgamesh__ODMG[6]=640
        set SvGilgamesh__ODMG[7]=1840
        call s__eventServantAdd_register(SV_GILGAMESH + OFF_B , function SvGilgamesh__onServantGet)
        call s__eventServantAdd_register(SV_GILGAMESH + OFF_A , function SvGilgamesh__onServantGet)
        call s__eventServantAdd_register(SV_GILGAMESH + OFF_S , function SvGilgamesh__onServantGet)
        call s__eventServantAdd_register(SV_GILGAMESH + OFF_EX , function SvGilgamesh__onServantGet)
    endfunction
// scope SvGilgamesh ends
