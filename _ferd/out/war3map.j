            call TrigFactionAnotherBatchBuilding__CreateUpgradeBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    function TrigFactionAnotherBatchBuilding__OnGachaBuilding takes nothing returns nothing
