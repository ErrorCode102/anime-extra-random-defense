function sa__EV102BBA_onSourceUnitAttack takes nothing returns boolean

        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
return true
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if not DEAL_FLAG_LOGIC then
            set this=s__EV102BBA_getThis(GetUnitUserData(src))
            set s__EV102BBA_atkStack[this]=s__EV102BBA_atkStack[this] + 1
            if s__EV102BBA_atkStack[this] == s__EV102BBA_maxStack[this] then
                if IsUnitType(dst, UNIT_TYPE_GIANT) and s__EV102BBA_myBuff[this] then
                    call UnitAddAbility(dst, 'A07G')
                endif
                call s__EVDamageManager_addBonus(src , - s__EV102BBA_dmgBonus[this])
                call FXRD_FXDebuffShock(dst , 1.0)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", dst, "origin"))
                call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o000', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst)))
                set s__EV102BBA_atkStack[this]=0
            else
                call s__EVDebuffSlow_apply(dst , 1.0)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
            endif
            if s__EV102BBA_atkStack[this] == s__EV102BBA_maxStack[this] - 1 then
                call s__EVDamageManager_addBonus(src , s__EV102BBA_dmgBonus[this])
            endif
        endif
        set src=null
        set dst=null
   return true
endfunction
