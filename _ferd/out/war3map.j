        set CONTSellZone___ANIMATION_TAG_STATE[0]=""
        set CONTSellZone___ANIMATION_TAG_STATE[1]="Upgrade First "
        set CONTSellZone___ANIMATION_TAG_STATE[2]="Upgrade Second "
