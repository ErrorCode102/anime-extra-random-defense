    function s__ABILEnkiduCEnuma_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__ABILEnkiduCEnuma_source[this], UNIT_TYPE_DEAD) then
            return
        endif
        if IS_PLAYER_HAVE_EX_GILGAMESH[GetPlayerId(GetOwningPlayer(s__ABILEnkiduCEnuma_source[this]))] then
            call SetUnitAbilityLevel(s__ABILEnkiduCEnuma_source[this], s__ABILEnkiduCEnuma_ABILITY, 2)
            return
        endif
        call s__tick_start(s__ABILEnkiduCEnuma_main[this],1.00 , false , function s__ABILEnkiduCEnuma_onExpire)
    endfunction
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0E8")
    
    function s__ABILEnkiduCEnuma_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEnkiduCEnuma_onSpellEffect[this], s__ABILEnkiduCEnuma_onSpellEffectAction[this])
        set s__ABILEnkiduCEnuma_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILEnkiduCEnuma_onSpellEffect[this])
        set s__ABILEnkiduCEnuma_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILEnkiduCEnuma_rmTrig[this], s__ABILEnkiduCEnuma_rmAct[this])
        set s__ABILEnkiduCEnuma_rmAct[this]=null
        set s__ABILEnkiduCEnuma_rmTrig[this]=null
        call sc__ABILEnkiduCEnuma_onAbilityLost(this)
        set s__ABILEnkiduCEnuma_source[this]=null
        set s__ABILEnkiduCEnuma_exists[this]=false
    endfunction
    
    function s__ABILEnkiduCEnuma_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEnkiduCEnuma_free(this)
    endfunction
    
    function s__ABILEnkiduCEnuma_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEnkiduCEnuma_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEnkiduCEnuma_exists[this] then
            set s__ABILEnkiduCEnuma_exists[this]=true
            set s__ABILEnkiduCEnuma_source[this]=src
            set s__ABILEnkiduCEnuma_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEnkiduCEnuma_rmAct[this]=TriggerAddAction(s__ABILEnkiduCEnuma_rmTrig[this], function s__ABILEnkiduCEnuma_OnSourceRemove)
            set s__ABILEnkiduCEnuma_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILEnkiduCEnuma_onSpellEffect[this], Condition(function sc__ABILEnkiduCEnuma_conditionSpellEffect))
            set s__ABILEnkiduCEnuma_onSpellEffectAction[this]=TriggerAddAction(s__ABILEnkiduCEnuma_onSpellEffect[this], function sc__ABILEnkiduCEnuma_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILEnkiduCEnuma_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILEnkiduCEnuma_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILEnkiduCEnuma_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILEnkiduCEnuma_exists[this] then
            return
        endif
        call sc__ABILEnkiduCEnuma_onAbilityEffect(this)
    endfunction
    
    function s__ABILEnkiduCEnuma_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILEnkiduCEnuma_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0E8")
