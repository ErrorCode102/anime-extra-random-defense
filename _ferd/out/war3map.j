//=======================================================
// TLDummyBind.apply( dummy, target )
//=======================================================
    function s__TLDummyBind_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__TLDummyBind_target[this]) then
            return
        endif
        call KillUnit(s__TLDummyBind_myDummy[this])
        call ShowUnit(s__TLDummyBind_myDummy[this], false)
        set s__TLDummyBind_myDummy[this]=null
        set s__TLDummyBind_target[this]=null
        call s__tick_destroy(s__TLDummyBind_main[this])
    endfunction
    function s__TLDummyBind_apply takes unit dum,unit dst returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyBind_main[this]=this
        set s__TLDummyBind_target[this]=dst
        set s__TLDummyBind_myDummy[this]=dum
        call s__tick_start(s__TLDummyBind_main[this],1.00 , true , function s__TLDummyBind_onFire)
    endfunction
//=======================================================
// TLDummyLife.apply( dummy, time )
//=======================================================
    function s__TLDummyLife_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__TLDummyLife_myDummy[this])
        call ShowUnit(s__TLDummyLife_myDummy[this], false)
        set s__TLDummyLife_myDummy[this]=null
        call s__tick_destroy(s__TLDummyLife_main[this])
    endfunction
    function s__TLDummyLife_apply takes unit dum,real r returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyLife_main[this]=this
        set s__TLDummyLife_myDummy[this]=dum
        call s__tick_start(s__TLDummyLife_main[this],r , false , function s__TLDummyLife_onFire)
    endfunction
//=======================================================
// TLDummyEmitter.apply( dummy, real x, real y, real radius, real delay, real st, real et )
    function s__TLDummyEmitter_destroy takes integer this returns nothing
        set s__TLDummyEmitter_attatch[this]=null
        call s__tick_destroy(s__TLDummyEmitter_endtick[this])
        call s__tick_destroy(s__TLDummyEmitter_main[this])
    endfunction
    function s__TLDummyEmitter_onTickET takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        call s__TLDummyEmitter_destroy(this)
    endfunction
    function s__TLDummyEmitter_emit takes integer this returns nothing
        local real ang= GetRandomReal(0.00, 360.00)
        local real rad= GetRandomReal(0.00, s__TLDummyEmitter_myRadius[this])
        local real face= GetRandomReal(0.00, 360.00)
        local real x= s__TLDummyEmitter_myX[this] + s__Polar_X(rad , ang)
        local real y= s__TLDummyEmitter_myY[this] + s__Polar_Y(rad , ang)
        local unit u= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), s__TLDummyEmitter_myId[this], x, y, face)
        call KillUnit(u)
        set u=null
    endfunction
    function s__TLDummyEmitter_onTickTK takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__TLDummyEmitter_attatch[this] != null and IsUnitDead(s__TLDummyEmitter_attatch[this]) then
            call s__TLDummyEmitter_destroy(this)
            return
        endif
        call s__TLDummyEmitter_emit(this)
    endfunction
    function s__TLDummyEmitter_start takes integer this returns nothing
        call s__TLDummyEmitter_emit(this)
        call s__tick_start(s__TLDummyEmitter_main[this],s__TLDummyEmitter_myDelay[this] , true , function s__TLDummyEmitter_onTickTK)
    endfunction
    function s__TLDummyEmitter_onTickST takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__TLDummyEmitter_start(this)
    endfunction
    function s__TLDummyEmitter_apply takes unit dum,integer typ,real x,real y,real rad,real delay,real st,real et returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyEmitter_endtick[this]=s__tick_create(this)
        set s__TLDummyEmitter_main[this]=this
        set s__TLDummyEmitter_myDelay[this]=RMaxBJ(0.03125, delay)
        set s__TLDummyEmitter_attatch[this]=dum
        set s__TLDummyEmitter_myId[this]=typ
        set s__TLDummyEmitter_myX[this]=x
        set s__TLDummyEmitter_myY[this]=y
        set s__TLDummyEmitter_myRadius[this]=rad
        if et > st then
            call s__tick_start(s__TLDummyEmitter_endtick[this],et , false , function s__TLDummyEmitter_onTickET)
        endif
        if st < 0.03125 then
            call s__TLDummyEmitter_start(this)
            return
        endif
        call s__tick_start(s__TLDummyEmitter_main[this],st , false , function s__TLDummyEmitter_onTickST)
    endfunction
//=======================================================
//=======================================================
// TLDummyAnimation.apply( dummy, ani, time )
//=======================================================
    function s__TLDummyAnimation_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__TLDummyAnimation_myDummy[this], UNIT_TYPE_DEAD) then
            set s__TLDummyAnimation_myDummy[this]=null
            call s__tick_destroy(s__TLDummyAnimation_main[this])
            return
        endif
        call SetUnitAnimation(s__TLDummyAnimation_myDummy[this], s__TLDummyAnimation_myAnim[this])
    endfunction
    function s__TLDummyAnimation_apply takes unit dum,string ani,real del returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyAnimation_main[this]=this
        set s__TLDummyAnimation_myDummy[this]=dum
        set s__TLDummyAnimation_myAnim[this]=ani
        call s__tick_start(s__TLDummyAnimation_main[this],del , false , function s__TLDummyAnimation_onFire)
    endfunction
//=======================================================
// TLDummyFollow.apply( dummy, target, speed )
//=======================================================
    function s__TLDummyFollow_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real dir
        if IsUnitDead(s__TLDummyFollow_myDummy[this]) or IsUnitDead(s__TLDummyFollow_myTarget[this]) then
            set s__TLDummyFollow_myTarget[this]=null
            set s__TLDummyFollow_myDummy[this]=null
            call s__tick_destroy(s__TLDummyFollow_main[this])
            return
        endif
        set dir=s__Angle_WBW(s__TLDummyFollow_myDummy[this] , s__TLDummyFollow_myTarget[this])
        call SetUnitX(s__TLDummyFollow_myDummy[this], GetUnitX(s__TLDummyFollow_myDummy[this]) + s__Polar_X(s__TLDummyFollow_mySpeed[this] , dir))
        call SetUnitY(s__TLDummyFollow_myDummy[this], GetUnitY(s__TLDummyFollow_myDummy[this]) + s__Polar_Y(s__TLDummyFollow_mySpeed[this] , dir))
    endfunction
    function s__TLDummyFollow_apply takes unit dum,unit tar,real spd returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyFollow_main[this]=this
        set s__TLDummyFollow_myDummy[this]=dum
        set s__TLDummyFollow_myTarget[this]=tar
        set s__TLDummyFollow_mySpeed[this]=spd * 0.03125
        call s__tick_start(s__TLDummyFollow_main[this],0.03125 , true , function s__TLDummyFollow_onFire)
    endfunction
//=======================================================
// TLDummyFade.apply( 
//=======================================================
    function s__TLDummyFade_apply takes unit dum,integer sr,integer sg,integer sb,integer sa,integer er,integer eg,integer eb,integer ea,real d returns nothing
        call sc__DummyColorChanger_cast(dum , sr , sg , sb , sa , er , eg , eb , ea , d)
    endfunction
//=======================================================
// TLDummyFadespan.apply( 
//=======================================================
    function s__TLDummyFadespan_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call sc__DummyColorChanger_cast(s__TLDummyFadespan_myDummy[this] , s__TLDummyFadespan_r1[this] , s__TLDummyFadespan_g1[this] , s__TLDummyFadespan_b1[this] , s__TLDummyFadespan_a1[this] , s__TLDummyFadespan_r2[this] , s__TLDummyFadespan_g2[this] , s__TLDummyFadespan_b2[this] , s__TLDummyFadespan_a2[this] , s__TLDummyFadespan_d[this])
        set s__TLDummyFadespan_myDummy[this]=null
        call s__tick_destroy(s__TLDummyFadespan_main[this])
    endfunction
    function s__TLDummyFadespan_apply takes unit dum,integer sr,integer sg,integer sb,integer sa,integer er,integer eg,integer eb,integer ea,real sd,real ed returns nothing
        local integer this= s__tick_create(0)
        set s__TLDummyFadespan_r1[this]=sr
        set s__TLDummyFadespan_g1[this]=sg
        set s__TLDummyFadespan_b1[this]=sb
        set s__TLDummyFadespan_a1[this]=sa
        set s__TLDummyFadespan_r2[this]=er
        set s__TLDummyFadespan_g2[this]=eg
        set s__TLDummyFadespan_b2[this]=eb
        set s__TLDummyFadespan_a2[this]=ea
        set s__TLDummyFadespan_d[this]=ed - sd
        set s__TLDummyFadespan_main[this]=this
        set s__TLDummyFadespan_myDummy[this]=dum
        call s__tick_start(s__TLDummyFadespan_main[this],sd , false , function s__TLDummyFadespan_onFire)
    endfunction
//=======================================================
// TLThematicMusic
//=======================================================
    function s__TLThematicMusic_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__TLThematicMusic_myDummy[this]) then
            return
        endif
        if GetLocalPlayer() == s__TLThematicMusic_owner[this] or s__TLThematicMusic_owner[this] == null then
            call EndThematicMusic()
        endif
        set s__TLThematicMusic_owner[this]=null
        set s__TLThematicMusic_myDummy[this]=null
        call s__tick_destroy(s__TLThematicMusic_main[this])
    endfunction
    function s__TLThematicMusic_apply takes unit dum,player own,string path returns nothing
        local integer this= s__tick_create(0)
        if GetLocalPlayer() == own or own == null then
            call PlayThematicMusic(path)
        endif
        set s__TLThematicMusic_owner[this]=own
        set s__TLThematicMusic_myDummy[this]=dum
        set s__TLThematicMusic_main[this]=this
        call s__tick_start(s__TLThematicMusic_main[this],1.00 , true , function s__TLThematicMusic_onFire)
    endfunction
// Trigger: Servant Mashu
