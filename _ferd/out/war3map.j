//library FXLifeSpan:

    
    function FXLifeSpan___Destroy takes integer ATIK returns nothing
        set FXLifeSpan___ADST[ATIK]=null
        call sc__tick_destroy(ATIK)
    endfunction
    
    function FXLifeSpan___OnImpact takes nothing returns nothing
        local integer ATIK= sc__tick_getExpired()
        if not IsUnitDead(FXLifeSpan___ADST[ATIK]) then
            call SetUnitTimeScale(FXLifeSpan___ADST[ATIK], FXLifeSpan___ASPD[ATIK])
            call KillUnit(FXLifeSpan___ADST[ATIK])
        endif
        call FXLifeSpan___Destroy(ATIK)
    endfunction

    function FXRD_FXLifeSpan takes unit u,real casdur,real tspd returns nothing
        local integer ATIK= sc__tick_create(0)
        set FXLifeSpan___ADST[ATIK]=u
        set FXLifeSpan___ASPD[ATIK]=tspd
        call sc__tick_start(ATIK,casdur , false , function FXLifeSpan___OnImpact)
    endfunction
    
    function FXRD_FXLifeSpanCommon takes unit src,real casdur returns nothing
        call FXRD_FXLifeSpan(src , casdur , 1.00)
    endfunction

