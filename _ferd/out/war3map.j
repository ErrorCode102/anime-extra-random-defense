    function SVMELTPENGUINSPAWN___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVMELTPENGUINSPAWN___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVMELTPENGUINSPAWN___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
