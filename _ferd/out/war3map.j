    function s__CMWeaponfireMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMWeaponfireMissle_caster[this], UNIT_TYPE_DEAD) or s__CMWeaponfireMissle_count[this] > 5 then
            call KillUnit(s__CMWeaponfireMissle_myDummy[this])
            set s__CMWeaponfireMissle_myDummy[this]=null
            call GroupClear(s__CMWeaponfireMissle_myG[this])
