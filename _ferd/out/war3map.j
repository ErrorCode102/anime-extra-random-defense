// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("SCATHACH","SK")
// scope SVSCATHACH begins
//end of: 서번트_선언_개시("SCATHACH","SK")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_마나수급형_차등("GaeBulgaSwing","1","5")
        function SVSCATHACH___GaeBulgaSwing takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            else
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1)
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_마나수급형_차등("GaeBulgaSwing","1","5")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "GaeBulgaSwing")
    function SVSCATHACH___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVSCATHACH___GaeBulgaSwing()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "GaeBulgaSwing")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVSCATHACH___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVSCATHACH___MeleeAttack)
            //Adding Special Skillz
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0D5')
            call UnitAddAbility(s__eventServantAdd_e, 'A0D4')
            call sc__ABILScathachAGodKiller_append(s__eventServantAdd_e)
            call sc__ABILScathachBCPrimordial_append(s__eventServantAdd_e , 1.0)
            call sc__ABILScathachDGaeBulga_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVSCATHACH___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVSCATHACH___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVSCATHACH___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVSCATHACH___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("8","4444","Anylevel")
        set SVSCATHACH___SERVANT_DAMAGE[8]=4444
        call s__eventServantAdd_register(SVSCATHACH___SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVSCATHACH___Anylevel)
//end of: 서번트_등록("8","4444","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVSCATHACH ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("ScathachDGaeBulga")
//end of: 어빌리티_선언_개시("ScathachDGaeBulga")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0D4")
    
    function s__ABILScathachDGaeBulga_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILScathachDGaeBulga_onSpellEffect[this], s__ABILScathachDGaeBulga_onSpellEffectAction[this])
        set s__ABILScathachDGaeBulga_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILScathachDGaeBulga_onSpellEffect[this])
        set s__ABILScathachDGaeBulga_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILScathachDGaeBulga_rmTrig[this], s__ABILScathachDGaeBulga_rmAct[this])
        set s__ABILScathachDGaeBulga_rmAct[this]=null
        set s__ABILScathachDGaeBulga_rmTrig[this]=null
        call sc__ABILScathachDGaeBulga_onAbilityLost(this)
        set s__ABILScathachDGaeBulga_source[this]=null
        set s__ABILScathachDGaeBulga_exists[this]=false
    endfunction
    
    function s__ABILScathachDGaeBulga_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILScathachDGaeBulga_free(this)
    endfunction
    
    function s__ABILScathachDGaeBulga_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILScathachDGaeBulga_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILScathachDGaeBulga_exists[this] then
            set s__ABILScathachDGaeBulga_exists[this]=true
            set s__ABILScathachDGaeBulga_source[this]=src
            set s__ABILScathachDGaeBulga_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILScathachDGaeBulga_rmAct[this]=TriggerAddAction(s__ABILScathachDGaeBulga_rmTrig[this], function s__ABILScathachDGaeBulga_OnSourceRemove)
            set s__ABILScathachDGaeBulga_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILScathachDGaeBulga_onSpellEffect[this], Condition(function sc__ABILScathachDGaeBulga_conditionSpellEffect))
            set s__ABILScathachDGaeBulga_onSpellEffectAction[this]=TriggerAddAction(s__ABILScathachDGaeBulga_onSpellEffect[this], function sc__ABILScathachDGaeBulga_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILScathachDGaeBulga_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILScathachDGaeBulga_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILScathachDGaeBulga_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILScathachDGaeBulga_exists[this] then
            return
        endif
        call sc__ABILScathachDGaeBulga_onAbilityEffect(this)
    endfunction
    
    function s__ABILScathachDGaeBulga_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILScathachDGaeBulga_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0D4")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILScathachDGaeBulga_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILScathachDGaeBulga_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILScathachDGaeBulga_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real mtpl= 1.0
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_GIANT) then
            set mtpl=0.5
        endif
        call FXRD_FXDebuffShock(GetSpellTargetUnit() , 10.0)
        call s__enemy_dealLogicEx(s__ABILScathachDGaeBulga_source[this] , GetSpellTargetUnit() , GetUnitState(GetSpellTargetUnit(), UNIT_STATE_LIFE) * mtpl , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("ScathachBCPrimordial")
//end of: 어빌리티_선언_개시("ScathachBCPrimordial")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILScathachBCPrimordial_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILScathachBCPrimordial_rmTrig[this], s__ABILScathachBCPrimordial_rmAct[this])
        set s__ABILScathachBCPrimordial_rmAct[this]=null
        set s__ABILScathachBCPrimordial_rmTrig[this]=null
        call sc__ABILScathachBCPrimordial_onAbilityLost(this)
        call s__tick_destroy(s__ABILScathachBCPrimordial_durTik[this])
        set s__ABILScathachBCPrimordial_source[this]=null
        set s__ABILScathachBCPrimordial_exists[this]=false
    endfunction
    
    function s__ABILScathachBCPrimordial_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILScathachBCPrimordial_free(this)
    endfunction
    
    function s__ABILScathachBCPrimordial_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILScathachBCPrimordial_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILScathachBCPrimordial_source[this]) then
            return
        endif
        call sc__ABILScathachBCPrimordial_onAbilityEffect(this)
        call s__tick_start(s__ABILScathachBCPrimordial_durTik[this],s__ABILScathachBCPrimordial_duration[this] , false , function s__ABILScathachBCPrimordial_onExpire)
    endfunction
    
    function s__ABILScathachBCPrimordial_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILScathachBCPrimordial_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILScathachBCPrimordial_exists[this] then
            set s__ABILScathachBCPrimordial_exists[this]=true
            set s__ABILScathachBCPrimordial_source[this]=src
            set s__ABILScathachBCPrimordial_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILScathachBCPrimordial_rmAct[this]=TriggerAddAction(s__ABILScathachBCPrimordial_rmTrig[this], function s__ABILScathachBCPrimordial_OnSourceRemove)
            
            set s__ABILScathachBCPrimordial_duration[this]=dur
            set s__ABILScathachBCPrimordial_defaultDuration[this]=dur
            set s__ABILScathachBCPrimordial_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILScathachBCPrimordial_durTik[this],dur , false , function s__ABILScathachBCPrimordial_onExpire)
            call sc__ABILScathachBCPrimordial_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILScathachBCPrimordial_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILScathachBCPrimordial_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILScathachBCPrimordial_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitState(s__ABILScathachBCPrimordial_source[this], UNIT_STATE_MANA) < 150 then
            return
        endif
        if GetUnitAbilityLevel(s__ABILScathachBCPrimordial_source[this], s__BUFFPrimordialRune_ABILITY) > 0 then
            return
        endif
        call sc__BUFFPrimordialRune_apply(s__ABILScathachBCPrimordial_source[this] , 10.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("PrimordialRune")
//end of: 버프_선언_개시("PrimordialRune")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFPrimordialRune_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFPrimordialRune_exist[this] then
            set s__BUFFPrimordialRune_exist[this]=true
            set s__BUFFPrimordialRune_running[this]=false
            set s__BUFFPrimordialRune_source[this]=src
            set s__BUFFPrimordialRune_duration[this]=dur
            set s__BUFFPrimordialRune_durationTimer[this]=s__tick_create(this)
            set s__BUFFPrimordialRune_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFPrimordialRune_rmAct[this]=TriggerAddAction(s__BUFFPrimordialRune_rmTrig[this], function sc__BUFFPrimordialRune_onSourceRemove)
        endif
        if s__BUFFPrimordialRune_running[this] then
            if dur < s__tick__get_remaining(s__BUFFPrimordialRune_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFPrimordialRune_running[this]=true
            call sc__BUFFPrimordialRune_onBuffStart(this)
        endif
        set s__BUFFPrimordialRune_duration[this]=dur
        call sc__BUFFPrimordialRune_onBuffRefresh(this)
        call s__tick_start(s__BUFFPrimordialRune_durationTimer[this],s__BUFFPrimordialRune_duration[this] , false , function sc__BUFFPrimordialRune_onExpire)
    endfunction
    function s__BUFFPrimordialRune_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFPrimordialRune_running[this]=false
        call sc__BUFFPrimordialRune_onBuffEnd(this)
    endfunction
    function s__BUFFPrimordialRune_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFPrimordialRune_rmTrig[this], s__BUFFPrimordialRune_rmAct[this])
        set s__BUFFPrimordialRune_rmAct[this]=null
        set s__BUFFPrimordialRune_rmTrig[this]=null
        if s__BUFFPrimordialRune_running[this] then
            set s__BUFFPrimordialRune_running[this]=false
            call sc__BUFFPrimordialRune_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFPrimordialRune_durationTimer[this])
        set s__BUFFPrimordialRune_source[this]=null
        set s__BUFFPrimordialRune_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFPrimordialRune_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFPrimordialRune_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl", s__BUFFPrimordialRune_source[this], "overhead")
        call UnitAddAbility(s__BUFFPrimordialRune_source[this], s__BUFFPrimordialRune_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFPrimordialRune_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
        // 기간제 기절/넉백 면역 효과 습득
        call FXRD_FXImmuneStunTimed(s__BUFFPrimordialRune_source[this] , s__BUFFPrimordialRune_duration[this])
        call FXRD_FXImmuneKnockbackTimed(s__BUFFPrimordialRune_source[this] , s__BUFFPrimordialRune_duration[this])
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFPrimordialRune_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFPrimordialRune_source[this]) then
            call SetUnitState(s__BUFFPrimordialRune_source[this], UNIT_STATE_MANA, 0.0)
            call UnitRemoveAbility(s__BUFFPrimordialRune_source[this], s__BUFFPrimordialRune_ABILITY)
            call UnitRemoveAbility(s__BUFFPrimordialRune_source[this], s__BUFFPrimordialRune_BUFF)
        endif
        call DestroyEffect(s__BUFFPrimordialRune_fx[this])
        set s__BUFFPrimordialRune_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 어빌리티_선언_개시("ScathachAGodKiller")
//end of: 어빌리티_선언_개시("ScathachAGodKiller")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILScathachAGodKiller_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILScathachAGodKiller_rmTrig[this], s__ABILScathachAGodKiller_rmAct[this])
        set s__ABILScathachAGodKiller_rmAct[this]=null
        set s__ABILScathachAGodKiller_rmTrig[this]=null
        call sc__ABILScathachAGodKiller_onAbilityLost(this)
        set s__ABILScathachAGodKiller_source[this]=null
        set s__ABILScathachAGodKiller_exists[this]=false
    endfunction
    
    function s__ABILScathachAGodKiller_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILScathachAGodKiller_free(this)
    endfunction
    
    function s__ABILScathachAGodKiller_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILScathachAGodKiller_onAbilityEffect(this)
    endfunction
    
    function s__ABILScathachAGodKiller_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILScathachAGodKiller_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILScathachAGodKiller_exists[this] then
            set s__ABILScathachAGodKiller_exists[this]=true
            set s__ABILScathachAGodKiller_source[this]=src
            set s__ABILScathachAGodKiller_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILScathachAGodKiller_rmAct[this]=TriggerAddAction(s__ABILScathachAGodKiller_rmTrig[this], function s__ABILScathachAGodKiller_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILScathachAGodKiller_onSourceUnitAttack)
            call sc__ABILScathachAGodKiller_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILScathachAGodKiller_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILScathachAGodKiller_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILScathachAGodKiller_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        local integer perc= 1
        local real mtpl= 0.01
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            set perc=13
        endif
        if GetRandomInt(1, perc) == 1 then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
            call s__enemy_dealLogicEx(src , dst , GetUnitState(dst, UNIT_STATE_LIFE) * mtpl , true , false , WEAPON_TYPE_METAL_MEDIUM_SLICE , 1)
        endif
        set src=null
        set dst=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()//===========================================================================
//end of: 어빌리티_선언_끝()//===========================================================================
// Trigger: Servant Astef
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("ASTOLFO","AS")
// scope SVASTOLFO begins
//end of: 서번트_선언_개시("ASTOLFO","AS")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_마나수급형_차등("ArgaliaSwing","1","5")
        function SVASTOLFO___ArgaliaSwing takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            else
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1)
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_마나수급형_차등("ArgaliaSwing","1","5")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "ArgaliaSwing")
    function SVASTOLFO___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVASTOLFO___ArgaliaSwing()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "ArgaliaSwing")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVASTOLFO___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVASTOLFO___MeleeAttack)
            //Adding Special Skillz
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0DA')
            call UnitAddAbility(s__eventServantAdd_e, 'A0DB')
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0DD')
            call UnitAddAbility(s__eventServantAdd_e, 'A0DE')
            call sc__ABILAstefAArgalia_append(s__eventServantAdd_e , 2.00)
            call sc__ABILAstefBCasseur_append(s__eventServantAdd_e , 1.00)
            call sc__ABILAstefCLaBraqueLuna_append(s__eventServantAdd_e)
            call sc__ABILAstefDHippo_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVASTOLFO___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVASTOLFO___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVASTOLFO___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVASTOLFO___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("8","3840","Anylevel")
        set SVASTOLFO___SERVANT_DAMAGE[8]=3840
        call s__eventServantAdd_register(SVASTOLFO___SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVASTOLFO___Anylevel)
//end of: 서번트_등록("8","3840","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVASTOLFO ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("AstefAArgalia")
//end of: 어빌리티_선언_개시("AstefAArgalia")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILAstefAArgalia_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILAstefAArgalia_rmTrig[this], s__ABILAstefAArgalia_rmAct[this])
        set s__ABILAstefAArgalia_rmAct[this]=null
        set s__ABILAstefAArgalia_rmTrig[this]=null
        call sc__ABILAstefAArgalia_onAbilityLost(this)
        call s__tick_destroy(s__ABILAstefAArgalia_durTik[this])
        set s__ABILAstefAArgalia_source[this]=null
        set s__ABILAstefAArgalia_exists[this]=false
    endfunction
    
    function s__ABILAstefAArgalia_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILAstefAArgalia_free(this)
    endfunction
    
    function s__ABILAstefAArgalia_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILAstefAArgalia_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILAstefAArgalia_source[this]) then
            return
        endif
        call sc__ABILAstefAArgalia_onAbilityEffect(this)
        call s__tick_start(s__ABILAstefAArgalia_durTik[this],s__ABILAstefAArgalia_duration[this] , false , function s__ABILAstefAArgalia_onExpire)
    endfunction
    
    function s__ABILAstefAArgalia_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILAstefAArgalia_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILAstefAArgalia_exists[this] then
            set s__ABILAstefAArgalia_exists[this]=true
            set s__ABILAstefAArgalia_source[this]=src
            set s__ABILAstefAArgalia_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILAstefAArgalia_rmAct[this]=TriggerAddAction(s__ABILAstefAArgalia_rmTrig[this], function s__ABILAstefAArgalia_OnSourceRemove)
            
            set s__ABILAstefAArgalia_duration[this]=dur
            set s__ABILAstefAArgalia_defaultDuration[this]=dur
            set s__ABILAstefAArgalia_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILAstefAArgalia_durTik[this],dur , false , function s__ABILAstefAArgalia_onExpire)
            call sc__ABILAstefAArgalia_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILAstefAArgalia_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILAstefAArgalia_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_모듈_필터_무작위_대상_선정("TargetFilter")
    function s__ABILAstefAArgalia_EnumTargetFilter takes nothing returns nothing
        if GetRandomInt(0, s__ABILAstefAArgalia_TargetFilter_CNT) == 0 then
            set s__ABILAstefAArgalia_TargetFilter_TARGET=GetEnumUnit()
        endif
        set s__ABILAstefAArgalia_TargetFilter_CNT=s__ABILAstefAArgalia_TargetFilter_CNT + 1
    endfunction
    function s__ABILAstefAArgalia_TargetFilter takes boolexpr f,unit src,real x,real y,real rng returns unit
        set s__ABILAstefAArgalia_TargetFilter_TARGET=null
        set s__ABILAstefAArgalia_TargetFilter_CNT=0
        call s__splash_range(f , src , x , y , rng , function s__ABILAstefAArgalia_EnumTargetFilter)
        set src=s__ABILAstefAArgalia_TargetFilter_TARGET
        set s__ABILAstefAArgalia_TargetFilter_TARGET=null
        return src
    endfunction
//end of: 어빌리티_모듈_필터_무작위_대상_선정("TargetFilter")
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILAstefAArgalia_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit u= s__ABILAstefAArgalia_TargetFilter(s__splash_ENEMY , s__ABILAstefAArgalia_source[this] , GetUnitX(s__ABILAstefAArgalia_source[this]) , GetUnitY(s__ABILAstefAArgalia_source[this]) , 700)
        if u == null then
            set s__ABILAstefAArgalia_duration[this]=1.00
            return
        endif
        set s__ABILAstefAArgalia_duration[this]=s__ABILAstefAArgalia_defaultDuration[this]
        call sc__CMTrapOfArgalia_cast(s__ABILAstefAArgalia_source[this] , sc__EVDamageManager_getFinalDamage(s__ABILAstefAArgalia_source[this]) , GetUnitX(u) , GetUnitY(u))
        set u=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("AstefBCasseur")
//end of: 어빌리티_선언_개시("AstefBCasseur")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILAstefBCasseur_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILAstefBCasseur_rmTrig[this], s__ABILAstefBCasseur_rmAct[this])
        set s__ABILAstefBCasseur_rmAct[this]=null
        set s__ABILAstefBCasseur_rmTrig[this]=null
        call sc__ABILAstefBCasseur_onAbilityLost(this)
        call s__tick_destroy(s__ABILAstefBCasseur_durTik[this])
        set s__ABILAstefBCasseur_source[this]=null
        set s__ABILAstefBCasseur_exists[this]=false
    endfunction
    
    function s__ABILAstefBCasseur_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILAstefBCasseur_free(this)
    endfunction
    
    function s__ABILAstefBCasseur_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILAstefBCasseur_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILAstefBCasseur_source[this]) then
            return
        endif
        call sc__ABILAstefBCasseur_onAbilityEffect(this)
        call s__tick_start(s__ABILAstefBCasseur_durTik[this],s__ABILAstefBCasseur_duration[this] , false , function s__ABILAstefBCasseur_onExpire)
    endfunction
    
    function s__ABILAstefBCasseur_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILAstefBCasseur_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILAstefBCasseur_exists[this] then
            set s__ABILAstefBCasseur_exists[this]=true
            set s__ABILAstefBCasseur_source[this]=src
            set s__ABILAstefBCasseur_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILAstefBCasseur_rmAct[this]=TriggerAddAction(s__ABILAstefBCasseur_rmTrig[this], function s__ABILAstefBCasseur_OnSourceRemove)
            
            set s__ABILAstefBCasseur_duration[this]=dur
            set s__ABILAstefBCasseur_defaultDuration[this]=dur
            set s__ABILAstefBCasseur_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILAstefBCasseur_durTik[this],dur , false , function s__ABILAstefBCasseur_onExpire)
            call sc__ABILAstefBCasseur_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILAstefBCasseur_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILAstefBCasseur_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILAstefBCasseur_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitState(s__ABILAstefBCasseur_source[this], UNIT_STATE_MANA) < 100 then
            return
        endif
        if GetUnitAbilityLevel(s__ABILAstefBCasseur_source[this], s__BUFFCasseurDeLogistille_ABILITY) > 0 then
            return
        endif
        call sc__BUFFCasseurDeLogistille_apply(s__ABILAstefBCasseur_source[this] , 10.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("CasseurDeLogistille")
//end of: 버프_선언_개시("CasseurDeLogistille")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFCasseurDeLogistille_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFCasseurDeLogistille_exist[this] then
            set s__BUFFCasseurDeLogistille_exist[this]=true
            set s__BUFFCasseurDeLogistille_running[this]=false
            set s__BUFFCasseurDeLogistille_source[this]=src
            set s__BUFFCasseurDeLogistille_duration[this]=dur
            set s__BUFFCasseurDeLogistille_durationTimer[this]=s__tick_create(this)
            set s__BUFFCasseurDeLogistille_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFCasseurDeLogistille_rmAct[this]=TriggerAddAction(s__BUFFCasseurDeLogistille_rmTrig[this], function sc__BUFFCasseurDeLogistille_onSourceRemove)
        endif
        if s__BUFFCasseurDeLogistille_running[this] then
            if dur < s__tick__get_remaining(s__BUFFCasseurDeLogistille_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFCasseurDeLogistille_running[this]=true
            call sc__BUFFCasseurDeLogistille_onBuffStart(this)
        endif
        set s__BUFFCasseurDeLogistille_duration[this]=dur
        call sc__BUFFCasseurDeLogistille_onBuffRefresh(this)
        call s__tick_start(s__BUFFCasseurDeLogistille_durationTimer[this],s__BUFFCasseurDeLogistille_duration[this] , false , function sc__BUFFCasseurDeLogistille_onExpire)
    endfunction
    function s__BUFFCasseurDeLogistille_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFCasseurDeLogistille_running[this]=false
        call sc__BUFFCasseurDeLogistille_onBuffEnd(this)
    endfunction
    function s__BUFFCasseurDeLogistille_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFCasseurDeLogistille_rmTrig[this], s__BUFFCasseurDeLogistille_rmAct[this])
        set s__BUFFCasseurDeLogistille_rmAct[this]=null
        set s__BUFFCasseurDeLogistille_rmTrig[this]=null
        if s__BUFFCasseurDeLogistille_running[this] then
            set s__BUFFCasseurDeLogistille_running[this]=false
            call sc__BUFFCasseurDeLogistille_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFCasseurDeLogistille_durationTimer[this])
        set s__BUFFCasseurDeLogistille_source[this]=null
        set s__BUFFCasseurDeLogistille_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFCasseurDeLogistille_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFCasseurDeLogistille_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\LightningShield\\LightningShieldTarget.mdl", s__BUFFCasseurDeLogistille_source[this], "origin")
        call UnitAddAbility(s__BUFFCasseurDeLogistille_source[this], s__BUFFCasseurDeLogistille_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFCasseurDeLogistille_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
        // 기간제 기절/넉백 면역 효과 습득
        call FXRD_FXImmuneStunTimed(s__BUFFCasseurDeLogistille_source[this] , s__BUFFCasseurDeLogistille_duration[this])
        call FXRD_FXImmuneKnockbackTimed(s__BUFFCasseurDeLogistille_source[this] , s__BUFFCasseurDeLogistille_duration[this])
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFCasseurDeLogistille_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFCasseurDeLogistille_source[this]) then
            call SetUnitState(s__BUFFCasseurDeLogistille_source[this], UNIT_STATE_MANA, 0.00)
            call UnitRemoveAbility(s__BUFFCasseurDeLogistille_source[this], s__BUFFCasseurDeLogistille_ABILITY)
            call UnitRemoveAbility(s__BUFFCasseurDeLogistille_source[this], s__BUFFCasseurDeLogistille_BUFF)
        endif
        call DestroyEffect(s__BUFFCasseurDeLogistille_fx[this])
        set s__BUFFCasseurDeLogistille_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 어빌리티_선언_개시("AstefCLaBraqueLuna")
//end of: 어빌리티_선언_개시("AstefCLaBraqueLuna")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DB")
    
    function s__ABILAstefCLaBraqueLuna_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILAstefCLaBraqueLuna_onSpellEffect[this], s__ABILAstefCLaBraqueLuna_onSpellEffectAction[this])
        set s__ABILAstefCLaBraqueLuna_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILAstefCLaBraqueLuna_onSpellEffect[this])
        set s__ABILAstefCLaBraqueLuna_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILAstefCLaBraqueLuna_rmTrig[this], s__ABILAstefCLaBraqueLuna_rmAct[this])
        set s__ABILAstefCLaBraqueLuna_rmAct[this]=null
        set s__ABILAstefCLaBraqueLuna_rmTrig[this]=null
        call sc__ABILAstefCLaBraqueLuna_onAbilityLost(this)
        set s__ABILAstefCLaBraqueLuna_source[this]=null
        set s__ABILAstefCLaBraqueLuna_exists[this]=false
    endfunction
    
    function s__ABILAstefCLaBraqueLuna_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILAstefCLaBraqueLuna_free(this)
    endfunction
    
    function s__ABILAstefCLaBraqueLuna_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILAstefCLaBraqueLuna_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILAstefCLaBraqueLuna_exists[this] then
            set s__ABILAstefCLaBraqueLuna_exists[this]=true
            set s__ABILAstefCLaBraqueLuna_source[this]=src
            set s__ABILAstefCLaBraqueLuna_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILAstefCLaBraqueLuna_rmAct[this]=TriggerAddAction(s__ABILAstefCLaBraqueLuna_rmTrig[this], function s__ABILAstefCLaBraqueLuna_OnSourceRemove)
            set s__ABILAstefCLaBraqueLuna_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILAstefCLaBraqueLuna_onSpellEffect[this], Condition(function sc__ABILAstefCLaBraqueLuna_conditionSpellEffect))
            set s__ABILAstefCLaBraqueLuna_onSpellEffectAction[this]=TriggerAddAction(s__ABILAstefCLaBraqueLuna_onSpellEffect[this], function sc__ABILAstefCLaBraqueLuna_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILAstefCLaBraqueLuna_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILAstefCLaBraqueLuna_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILAstefCLaBraqueLuna_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILAstefCLaBraqueLuna_exists[this] then
            return
        endif
        call sc__ABILAstefCLaBraqueLuna_onAbilityEffect(this)
    endfunction
    
    function s__ABILAstefCLaBraqueLuna_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILAstefCLaBraqueLuna_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DB")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILAstefCLaBraqueLuna_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILAstefCLaBraqueLuna_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILAstefCLaBraqueLuna_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call sc__CMLaBraqueLuna_cast(s__ABILAstefCLaBraqueLuna_source[this] , sc__EVDamageManager_getFinalDamage(s__ABILAstefCLaBraqueLuna_source[this]) * 20.00 , GetSpellTargetX() , GetSpellTargetY())
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
