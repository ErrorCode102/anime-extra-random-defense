    //기본 서번트 스탯 설정
    //구현부
    function SvPassionLip___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        local real mtpl
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set mtpl=1.00
        if GetUnitLevel(src) > 4 then
            set mtpl=2.00
        endif
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) * mtpl , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvPassionLip___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvPassionLip___ODMG[lv])
        //Adding Base Attack
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPassionLip___onAttack)
        //Adding Special Skillz
    endfunction
    //초기화
    function SvPassionLip___main takes nothing returns nothing
        set SvPassionLip___ODMG[3]=150
        set SvPassionLip___ODMG[4]=900
        set SvPassionLip___ODMG[5]=2250
        set SvPassionLip___ODMG[6]=7200
        call s__eventServantAdd_register(SV_PASSION + OFF_C , function SvPassionLip___onServantGet)
        call s__eventServantAdd_register(SV_PASSION + OFF_B , function SvPassionLip___onServantGet)
        call s__eventServantAdd_register(SV_PASSION + OFF_A , function SvPassionLip___onServantGet)
        call s__eventServantAdd_register(SV_PASSION + OFF_S , function SvPassionLip___onServantGet)
    endfunction
