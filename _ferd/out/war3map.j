// scope SvPendragonAlter begins
    //기본 서번트 스탯 설정
    //구현부
    function SvPendragonAlter__enumDealt takes nothing returns nothing
        call DestroyEffect(AddSpecialEffectTarget("FX\\Slash\\Pink.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) + 1)
        call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function SvPendragonAlter__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            call KillUnit(CreateUnit(Player(15), 'o016', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call KillUnit(CreateUnit(Player(15), 'o016', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(src) , GetUnitY(src) , GetUnitAcquireRange(src) - 50 , function SvPendragonAlter__enumDealt)
        else
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvPendragonAlter__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvPendragonAlter__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragonAlter__onAttack)
        //Adding Special Skillz
        if lv == 5 then
            call sc__EV148PendragonAlterB_append(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call sc__EV148PendragonAlterB_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvPendragonAlter__main takes nothing returns nothing
        set SvPendragonAlter__ODMG[4]=180
        set SvPendragonAlter__ODMG[5]=450
        set SvPendragonAlter__ODMG[6]=1440
        call s__eventServantAdd_register(SV_PENDRAGONALTER + OFF_B , function SvPendragonAlter__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGONALTER + OFF_A , function SvPendragonAlter__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGONALTER + OFF_S , function SvPendragonAlter__onServantGet)
    endfunction
