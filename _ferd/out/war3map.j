    function TrigFactionAnotherBatchBuilding__CreateAnotherTower takes player p returns nothing
        local integer i= GetPlayerId(p)
        set FXRD_SPECIAL_TOWER[i]=CreateUnit(Player(i), 'n008', GetPlayerStartLocationX(p), GetPlayerStartLocationY(p), 270)
        call SetUnitAnimation(FXRD_SPECIAL_TOWER[i], "birth")
        call SetUnitTimeScale(FXRD_SPECIAL_TOWER[i], 0.40)
        call SetUnitVertexColor(FXRD_SPECIAL_TOWER[i], 255, 255, 255, 32)
        call sc__UnitIndexer_append(FXRD_SPECIAL_TOWER[i])
        call sc__EVUnitRemove_append(FXRD_SPECIAL_TOWER[i])
        call sc__EVServantAttack_append(FXRD_SPECIAL_TOWER[i])
        //
        call sc__EV104SpecialTower_append(FXRD_SPECIAL_TOWER[i])
    endfunction
    //=================================================
