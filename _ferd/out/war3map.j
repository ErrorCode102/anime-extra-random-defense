    function s__CMAgriosSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMAgriosSingle_myDummy[this])
        call ShowUnit(s__CMAgriosSingle_myDummy[this], false)
        set s__CMAgriosSingle_myDummy[this]=null
        set s__CMAgriosSingle_caster[this]=null
        set s__CMAgriosSingle_target[this]=null
        call s__tick_destroy(s__CMAgriosSingle_main[this])
    endfunction
    function s__CMAgriosSingle_onFireCombo takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMAgriosSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMAgriosSingle_myDummy[this], "overhead"))
        else
            call DestroyEffect(AddSpecialEffectTarget("FX\\CrossGlowYellow\\glow" + I2S(GetRandomInt(1, 4)) + ".mdl", s__CMAgriosSingle_target[this], "origin"))
            call FXRD_FXDebuffShock(s__CMAgriosSingle_target[this] , 5.0)
            if GetUnitLevel(s__CMAgriosSingle_caster[this]) == 6 then
                call FXRD_FXShieldBreak(s__CMAgriosSingle_target[this] , 5.0)
                call FXRD_FXPauseShield(s__CMAgriosSingle_target[this] , 5.0)
                call FXRD_FXPauseLife(s__CMAgriosSingle_target[this] , 5.0)
            endif
            call s__enemy_dealLogicEx(s__CMAgriosSingle_caster[this] , s__CMAgriosSingle_target[this] , s__CMAgriosSingle_damage[this] , s__CMAgriosSingle_myPen[this] , s__CMAgriosSingle_myKick[this] , WEAPON_TYPE_METAL_MEDIUM_SLICE , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMAgriosSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.2)
        call SetUnitTimeScale(s__CMAgriosSingle_myDummy[this], 0.0)
        call s__tick_start(s__CMAgriosSingle_main[this],0.2 , false , function s__CMAgriosSingle_onFinal)
    endfunction
    function s__CMAgriosSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMAgriosSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMAgriosSingle_myDummy[this], "overhead"))
        else
            call DestroyEffect(AddSpecialEffectTarget("FX\\CrossGlowYellow\\glow" + I2S(GetRandomInt(1, 4)) + ".mdl", s__CMAgriosSingle_target[this], "origin"))
            call s__enemy_dealLogicEx(s__CMAgriosSingle_caster[this] , s__CMAgriosSingle_target[this] , s__CMAgriosSingle_damage[this] , s__CMAgriosSingle_myPen[this] , s__CMAgriosSingle_myKick[this] , WEAPON_TYPE_METAL_MEDIUM_SLICE , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMAgriosSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMAgriosSingle_myDummy[this], 0.0)
        call s__tick_start(s__CMAgriosSingle_main[this],0.2 , false , function s__CMAgriosSingle_onFinal)
    endfunction
    function s__CMAgriosSingle_cast takes unit src,unit dst,real dmg,real x,real y,boolean dopen,boolean dokick,integer combo returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_PBW(x , y , dst)
        set s__CMAgriosSingle_caster[this]=src
        set s__CMAgriosSingle_target[this]=dst
        set s__CMAgriosSingle_damage[this]=dmg
        set s__CMAgriosSingle_myPen[this]=dopen
        set s__CMAgriosSingle_myKick[this]=dokick
        set s__CMAgriosSingle_main[this]=this
        set s__CMAgriosSingle_myDummy[this]=CreateUnit(FX_PLAYER_DUMMY, 'o00G', GetUnitX(dst) + s__Polar_X(200 , ang - 180), GetUnitY(dst) + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMAgriosSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.2)
        call SetUnitAnimation(s__CMAgriosSingle_myDummy[this], "attack")
        call SetUnitTimeScale(s__CMAgriosSingle_myDummy[this], 1.5)
        if combo == 100 then
            call s__tick_start(s__CMAgriosSingle_main[this],0.4 , true , function s__CMAgriosSingle_onFireCombo)
        else
            call s__tick_start(s__CMAgriosSingle_main[this],0.4 , true , function s__CMAgriosSingle_onFire)
        endif
    endfunction
