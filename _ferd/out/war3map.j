//===========================================================================
// Trigger: EV 108 VladA
//===========================================================================

    
    function s__EV108VladA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV108VladA_STRUCT_ID)
    endfunction
    
    function s__EV108VladA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV108VladA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV108VladA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV108VladA__allocate()
        set s__EV108VladA_ID[this]=GetUnitUserData(src)
        call s__EV108VladA_setThis(s__EV108VladA_ID[this] , this)
        return this
    endfunction
    
    function s__EV108VladA_destroy takes integer this returns nothing
        call s__EV108VladA_setThis(s__EV108VladA_ID[this] , 0)
        call s__EV108VladA_deallocate(this)
    endfunction
    
    //API
    function s__EV108VladA_append takes unit src,real dmg1,real dmg2 returns nothing
        local integer this= s__EV108VladA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV108VladA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV108VladA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV108VladA_onSourceUnitRemove)
        set s__EV108VladA_myServant[this]=src
        set s__EV108VladA_myDamage1[this]=dmg1
        set s__EV108VladA_myDamage2[this]=dmg2
        call s__EVServantAttack_addFunction(src , function sc__EV108VladA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV108VladA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if not DEAL_FLAG_LOGIC then
            //Melee Attack
            set this=s__EV108VladA_getThis(GetUnitUserData(src))
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                call s__CMKazicleSingle_cast(src , dst , s__EV108VladA_myDamage2[this])
            endif
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV108VladA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV108VladA_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV108VladA_myServant[this]=null
        call TriggerUnbindAction(s__EV108VladA_onRemoveAction[this])
        set s__EV108VladA_onRemoveAction[this]=null
        //종결
        call s__EV108VladA_destroy(this)
    endfunction
    
    

