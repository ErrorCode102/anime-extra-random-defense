    function s__EVBossSuperSpeed_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__EVBossSuperSpeed_caster[this]) then
            call UnitRemoveAbility(s__EVBossSuperSpeed_caster[this], 'A0DG')
            call UnitRemoveAbility(s__EVBossSuperSpeed_caster[this], 'B00M')
        endif
        set s__EVBossSuperSpeed_caster[this]=null
        call s__tick_destroy(s__EVBossSuperSpeed_main[this])
    endfunction
    function s__EVBossSuperSpeed_cast takes unit src,real bufftime returns nothing
        local integer this= s__tick_create(0)
        set s__EVBossSuperSpeed_caster[this]=src
        call UnitAddAbility(s__EVBossSuperSpeed_caster[this], 'A0DG')
        set s__EVBossSuperSpeed_main[this]=this
        call s__tick_start(s__EVBossSuperSpeed_main[this],bufftime , false , function s__EVBossSuperSpeed_onFire)
    endfunction

    function s__EVBossShootingStar_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__EVBossShootingStar_caster[this]) or s__EVBossShootingStar_count[this] <= 0 then
            set s__EVBossShootingStar_zone[this]=null
            set s__EVBossShootingStar_caster[this]=null
            call s__tick_destroy(s__EVBossShootingStar_main[this])
            return
        endif
        set s__EVBossShootingStar_count[this]=s__EVBossShootingStar_count[this] - 1
        call FXRD_FXBomb(s__EVBossShootingStar_caster[this] , GetRandomReal(GetRectMinX(s__EVBossShootingStar_zone[this]) + 100, GetRectMaxX(s__EVBossShootingStar_zone[this]) - 100) , GetRandomReal(GetRectMinY(s__EVBossShootingStar_zone[this]) + 100, GetRectMaxY(s__EVBossShootingStar_zone[this]) - 100) , 200 , 2.00)
    endfunction
    function s__EVBossShootingStar_cast takes unit src,rect r,integer cnt returns nothing
        local integer this= s__tick_create(0)
        set s__EVBossShootingStar_caster[this]=src
        set s__EVBossShootingStar_count[this]=cnt
        set s__EVBossShootingStar_zone[this]=r
        set s__EVBossShootingStar_main[this]=this
        call s__tick_start(s__EVBossShootingStar_main[this],0.10 , true , function s__EVBossShootingStar_onFire)
    endfunction
