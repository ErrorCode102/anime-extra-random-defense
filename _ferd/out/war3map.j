//library FXBinder:

    
    function FXBinder___Free takes integer self returns nothing
        call TriggerRemoveAction(FXBinder___FX_BINDTRIG[self], FXBinder___FX_BINDACTION[self])
        set FXBinder___FX_BINDACTION[self]=null
        call DestroyTrigger(FXBinder___FX_BINDTRIG[self])
        set FXBinder___FX_BINDTRIG[self]=null
        call GroupClear(FXBinder___FX_BINDGRP[self])
        call DestroyGroup(FXBinder___FX_BINDGRP[self])
        set FXBinder___FX_BINDGRP[self]=null
        call TriggerRemoveAction(FXBinder___FX_REMOVETRIG[self], FXBinder___FX_REMOVEACTION[self])
        set FXBinder___FX_REMOVEACTION[self]=null
        set FXBinder___FX_REMOVETRIG[self]=null
        set FXBinder___FX_SOURCE[self]=null
        set FXBinder___FX_EXISTS[self]=false
    endfunction
    
    function FXBinder___OnRemove takes nothing returns nothing
        local integer self= GetTriggerIndex()
        call FXBinder___Free(self)
    endfunction
    
    function FXBinder___OnBindedKilled takes nothing returns nothing
        local integer self= GetHandleUserData(GetTriggeringTrigger())
        if not IsUnitInGroup(GetTriggerUnit(), FXBinder___FX_BINDGRP[self]) then
            return
        endif
        call KillUnit(FXBinder___FX_SOURCE[self])
    endfunction
    
    function FXBinder___Allocate takes integer self,unit src returns nothing
        set FXBinder___FX_EXISTS[self]=true
        set FXBinder___FX_SOURCE[self]=src
        set FXBinder___FX_REMOVETRIG[self]=GetUnitRemoveTrigger(src)
        set FXBinder___FX_REMOVEACTION[self]=TriggerAddAction(FXBinder___FX_REMOVETRIG[self], function FXBinder___OnRemove)
        set FXBinder___FX_BINDTRIG[self]=CreateTrigger()
        call SetHandleUserData(FXBinder___FX_BINDTRIG[self] , self)
        set FXBinder___FX_BINDACTION[self]=TriggerAddAction(FXBinder___FX_BINDTRIG[self], function FXBinder___OnBindedKilled)
        set FXBinder___FX_BINDGRP[self]=CreateGroup()
    endfunction
    
    function FXRD_FXBinderBindUnit takes unit src,unit dst returns nothing
        local integer self
        //유효성 검사 ( 소스, 바인딩 대상 )
        if GetUnitTypeId(src) == 0 then
            return
        endif
        if GetUnitTypeId(dst) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXBinder___FX_EXISTS[self] then
            call FXBinder___Allocate(self , src)
        endif
        if not IsUnitInGroup(dst, FXBinder___FX_BINDGRP[self]) then
            call GroupAddUnit(FXBinder___FX_BINDGRP[self], dst)
            call TriggerRegisterUnitEvent(FXBinder___FX_BINDTRIG[self], dst, EVENT_UNIT_DEATH)
        endif
    endfunction
    
    function FXRD_FXBinderUnbindUnit takes unit src,unit dst returns nothing
        local integer self
        //유효성 검사 ( 소스, 바인딩 대상 )
        if GetUnitTypeId(src) == 0 then
            return
        endif
        if GetUnitTypeId(dst) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXBinder___FX_EXISTS[self] then
            return
        endif
        if IsUnitInGroup(dst, FXBinder___FX_BINDGRP[self]) then
            call GroupRemoveUnit(FXBinder___FX_BINDGRP[self], dst)
        endif
    endfunction
    
    function FXRD_FXBinderClearUnit takes unit src returns nothing
        local integer self
        //유효성 검사 ( 소스, 바인딩 대상 )
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXBinder___FX_EXISTS[self] then
            return
        endif
        call GroupClear(FXBinder___FX_BINDGRP[self])
    endfunction

//library FXBinder ends
//library FXDebuffShock:

    
    
    function FXDebuffShock___Free takes integer self returns nothing
        call s__tick_destroy(FXDebuffShock___FX_TICK[self])
        call DestroyEffect(FXDebuffShock___FX_EFFECT[self])
        set FXDebuffShock___FX_EFFECT[self]=null
        call TriggerRemoveAction(FXDebuffShock___FX_REMOVETRIG[self], FXDebuffShock___FX_REMOVEACTION[self])
        set FXDebuffShock___FX_REMOVEACTION[self]=null
        set FXDebuffShock___FX_REMOVETRIG[self]=null
        set FXDebuffShock___FX_SOURCE[self]=null
        set FXDebuffShock___FX_TIMMED[self]=false
        set FXDebuffShock___FX_EXISTS[self]=false
    endfunction
    
    function FXDebuffShock___OnRemove takes nothing returns nothing
        local integer self= GetTriggerIndex()
        call FXDebuffShock___Free(self)
    endfunction
    
    function FXDebuffShock___Allocate takes integer self,unit src returns nothing
        set FXDebuffShock___FX_EXISTS[self]=true
        set FXDebuffShock___FX_TIMMED[self]=false
        set FXDebuffShock___FX_SOURCE[self]=src
        set FXDebuffShock___FX_EFFECT[self]=null
        set FXDebuffShock___FX_REMOVETRIG[self]=GetUnitRemoveTrigger(src)
        set FXDebuffShock___FX_REMOVEACTION[self]=TriggerAddAction(FXDebuffShock___FX_REMOVETRIG[self], function FXDebuffShock___OnRemove)
        set FXDebuffShock___FX_TICK[self]=s__tick_create(self)
    endfunction
    
    function FXDebuffShock___OnExpire takes nothing returns nothing
        local integer self= s__tick_data[s__tick_getExpired()]
        set FXDebuffShock___FX_TIMMED[self]=false
        call DestroyEffect(FXDebuffShock___FX_EFFECT[self])
        set FXDebuffShock___FX_EFFECT[self]=null
        if IsUnitDead(FXDebuffShock___FX_SOURCE[self]) then
            return
        endif
        call UnitRemoveAbility(FXDebuffShock___FX_SOURCE[self], FXDebuffShock___ID_ABILITY)
        call UnitRemoveAbility(FXDebuffShock___FX_SOURCE[self], FXDebuffShock___ID_DEBUFF)
    endfunction
    
    function FXRD_FXDebuffShockClear takes unit src returns nothing
        local integer self= GetUnitIndex(src)
        if self == 0 then
            return
        endif
        if not FXDebuffShock___FX_EXISTS[self] then
            return
        endif
        //Forcing over tick control
        if not FXDebuffShock___FX_TIMMED[self] then
            return
        endif
        set FXDebuffShock___FX_TIMMED[self]=false
        call s__tick_pause(FXDebuffShock___FX_TICK[self])
        //
        call DestroyEffect(FXDebuffShock___FX_EFFECT[self])
        set FXDebuffShock___FX_EFFECT[self]=null
        call UnitRemoveAbility(src, FXDebuffShock___ID_ABILITY)
        call UnitRemoveAbility(src, FXDebuffShock___ID_DEBUFF)
    endfunction
    
    function FXRD_FXDebuffShockEx takes unit src,real delay,string efpth,string efpnt returns nothing
        local integer self= IndexUnit(src)
        if GetUnitAbilityLevel(src, FXDebuffShock___ID_IMMUNE) > 0 then
            return
        endif
        if IsUnitDead(src) then
            return
        endif
        if self == 0 then
            return
        endif
        if not FXDebuffShock___FX_EXISTS[self] then
            call FXDebuffShock___Allocate(self , src)
        endif
        //
        if GetUnitAbilityLevel(src, FXDebuffShock___ID_ABILITY) == 0 then
            call UnitAddAbility(src, FXDebuffShock___ID_ABILITY)
        endif
        //
        if FXDebuffShock___FX_TIMMED[self] then
            if s__tick__get_remaining(FXDebuffShock___FX_TICK[self]) >= delay then
                return
            endif
        endif
        set FXDebuffShock___FX_TIMMED[self]=true
        call DestroyEffect(FXDebuffShock___FX_EFFECT[self])
        set FXDebuffShock___FX_EFFECT[self]=AddSpecialEffectTarget(efpth, src, efpnt)
        call s__tick_start(FXDebuffShock___FX_TICK[self],delay , false , function FXDebuffShock___OnExpire)
    endfunction
    
    function FXRD_FXDebuffShock takes unit src,real delay returns nothing
        call FXRD_FXDebuffShockEx(src , delay , FXDebuffShock___PATH_EFFECT , FXDebuffShock___POINT_EFFECT)
    endfunction
    

//library FXDebuffShock ends
//library FXFortnia:

    
    
    
    function FXFortnia___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        if IsUnitInRangeXY(GetEnumUnit(), FXFortnia___ADSX[self], FXFortnia___ADSY[self], 500) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 10.0)
    endfunction
    
    function FXFortnia___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        if FXFortnia___AIDX[self] == 0 then
            set FXFortnia___ADSX[self]=GetRandomReal(GetRectMinX(FXFortnia___AREC[self]) + 500, GetRectMaxX(FXFortnia___AREC[self]) - 500)
            set FXFortnia___ADSY[self]=GetRandomReal(GetRectMinY(FXFortnia___AREC[self]) + 500, GetRectMaxY(FXFortnia___AREC[self]) - 500)
            set FXFortnia___UWAR[self]=CreateUnit(FX_PLAYER_DUMMY, FXFortnia___AWAR, FXFortnia___ADSX[self], FXFortnia___ADSY[self], 270)
            call FXRD_FXLifeSpanCommon(FXFortnia___UWAR[self] , 15.0)
            set FXFortnia___AIDX[self]=1
            call s__tick_start(self,10.0 , false , function FXFortnia___OnExpire)
            return
        endif
        if FXFortnia___AIDX[self] < 7 then
            if FXFortnia___AIDX[self] == 1 then
                set FXFortnia___UDUM[self]=CreateUnit(FX_PLAYER_DUMMY, FXFortnia___AIMP, GetRectCenterX(FXFortnia___AREC[self]), GetRectCenterY(FXFortnia___AREC[self]), 270)
                call SetUnitAnimation(FXFortnia___UDUM[self], "birth")
                call FXRD_FXLifeSpanCommon(FXFortnia___UDUM[self] , 5.0)
                call SetUnitVertexColor(FXFortnia___UDUM[self], 255, 255, 255, 128)
            endif
            call s__splash_rect(s__splash_ANY , null , FXFortnia___AREC[self] , function FXFortnia___EnumSplash)
            set FXFortnia___AIDX[self]=FXFortnia___AIDX[self] + 1
            call s__tick_start(self,1.0 , false , function FXFortnia___OnExpire)
            return
        endif
        set FXFortnia___AIDX[self]=0
        call s__tick_start(self,5.0 , false , function FXFortnia___OnExpire)
    endfunction
    
    function FXRD_FXFortniaCreate takes rect r returns integer
        local integer self= s__tick_create(0)
        set FXFortnia___OEXI[self]=true
        set FXFortnia___AREC[self]=r
        set FXFortnia___AIDX[self]=0
        call s__tick_start(self,5.0 , false , function FXFortnia___OnExpire)
        return self
    endfunction
    
    function FXRD_FXFortniaDestroy takes integer src returns nothing
        local integer self= src
        if not FXFortnia___OEXI[self] then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Fatal error: An attempt was made to destroy an FX_FORTNIA FXRD object that does not exist.")
            return
        endif
        call KillUnit(FXFortnia___UWAR[self])
        set FXFortnia___UWAR[self]=null
        call KillUnit(FXFortnia___UDUM[self])
        set FXFortnia___UDUM[self]=null
        set FXFortnia___AREC[self]=null
        set FXFortnia___OEXI[self]=false
        call s__tick_destroy(self)
    endfunction
    

