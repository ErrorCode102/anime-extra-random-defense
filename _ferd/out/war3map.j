        local integer i= 0
        if IsUnitDead(s__ABILSemiABuff_source[this]) then
return true
        endif
        loop
            exitwhen i == 8
            set s__ABILSemiABuff_DEST=null
            set s__ABILSemiABuff_CNT=0
            set s__ABILSemiABuff_LEV=0
            call s__splash_range(s__splash_ALLY , s__ABILSemiABuff_source[this] , GetUnitX(s__ABILSemiABuff_source[this]) , GetUnitY(s__ABILSemiABuff_source[this]) , GetUnitAcquireRange(s__ABILSemiABuff_source[this]) + 100 , function s__ABILSemiABuff_enumGetTarget)
            if s__ABILSemiABuff_DEST != null then
                call sc__BUFFDoubleSummon_apply(s__ABILSemiABuff_DEST , null , 0.95 , 10)
            endif
            set i=i + 1
        endloop
        set s__ABILSemiABuff_DEST=null
   return true
endfunction
