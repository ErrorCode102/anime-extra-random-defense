//textmacro instance: 어빌리티_선언_개시("MedusaBHold")
//end of: 어빌리티_선언_개시("MedusaBHold")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILMedusaBHold_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMedusaBHold_rmTrig[this], s__ABILMedusaBHold_rmAct[this])
        set s__ABILMedusaBHold_rmAct[this]=null
        set s__ABILMedusaBHold_rmTrig[this]=null
        call sc__ABILMedusaBHold_onAbilityLost(this)
        call s__tick_destroy(s__ABILMedusaBHold_durTik[this])
        set s__ABILMedusaBHold_source[this]=null
        set s__ABILMedusaBHold_exists[this]=false
    endfunction
    
    function s__ABILMedusaBHold_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMedusaBHold_free(this)
    endfunction
    
    function s__ABILMedusaBHold_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILMedusaBHold_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILMedusaBHold_source[this]) then
            return
        endif
        call sc__ABILMedusaBHold_onAbilityEffect(this)
        call s__tick_start(s__ABILMedusaBHold_durTik[this],s__ABILMedusaBHold_duration[this] , false , function s__ABILMedusaBHold_onExpire)
    endfunction
    
    function s__ABILMedusaBHold_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMedusaBHold_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMedusaBHold_exists[this] then
            set s__ABILMedusaBHold_exists[this]=true
            set s__ABILMedusaBHold_source[this]=src
            set s__ABILMedusaBHold_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMedusaBHold_rmAct[this]=TriggerAddAction(s__ABILMedusaBHold_rmTrig[this], function s__ABILMedusaBHold_OnSourceRemove)
            
            set s__ABILMedusaBHold_duration[this]=dur
            set s__ABILMedusaBHold_defaultDuration[this]=dur
            set s__ABILMedusaBHold_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILMedusaBHold_durTik[this],dur , false , function s__ABILMedusaBHold_onExpire)
            call sc__ABILMedusaBHold_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
    function s__ABILMedusaBHold_enumGetTarget takes nothing returns nothing
        local real life
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            return
        endif
        set life=s__Life__staticgetindex(GetEnumUnit()) + s__Mana__staticgetindex(GetEnumUnit())
        if life < s__ABILMedusaBHold_LIFE then
            return
        endif
        if life > s__ABILMedusaBHold_LIFE then
            set s__ABILMedusaBHold_CNT=0
            set s__ABILMedusaBHold_LIFE=life
        endif
        if GetRandomInt(0, s__ABILMedusaBHold_CNT) == 0 then
            set s__ABILMedusaBHold_DEST=GetEnumUnit()
        endif
        set s__ABILMedusaBHold_CNT=s__ABILMedusaBHold_CNT + 1
    endfunction
    function s__ABILMedusaBHold_HoldCallBack takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if s__IsDead__staticgetindex(s__ABILMedusaBHold_MarkedTarget[this]) then
            call DestroyEffect(s__ABILMedusaBHold_MarkEffect[this])
            set s__ABILMedusaBHold_MarkEffect[this]=null
            set s__ABILMedusaBHold_MarkedTarget[this]=null
            call SetUnitVertexColor(s__ABILMedusaBHold_MarkDummy[this], 128, 128, 128, 0)
            set s__ABILMedusaBHold_MarkHolding[this]=false
            return
        endif
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILMedusaBHold_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILMedusaBHold_MarkHolding[this]=false
        set s__ABILMedusaBHold_MarkedTarget[this]=null
        set s__ABILMedusaBHold_MarkDummy[this]=CreateUnit(FX_PLAYER_DUMMY, 'o02N', s__PosX__staticgetindex(s__ABILMedusaBHold_source[this]), s__PosY__staticgetindex(s__ABILMedusaBHold_source[this]), s__Facing__staticgetindex(s__ABILMedusaBHold_source[this]))
        call SetUnitVertexColor(s__ABILMedusaBHold_MarkDummy[this], 128, 128, 128, 0)
        set s__ABILMedusaBHold_MarkTick[this]=s__tick_create(this)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILMedusaBHold_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        call SetUnitVertexColor(s__ABILMedusaBHold_MarkDummy[this], 128, 128, 128, 0)
        call KillUnit(s__ABILMedusaBHold_MarkDummy[this])
        set s__ABILMedusaBHold_MarkDummy[this]=null
        set s__ABILMedusaBHold_MarkedTarget[this]=null
        call s__tick_destroy(s__ABILMedusaBHold_MarkTick[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMedusaBHold_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real tx
        local real ty
        if s__ABILMedusaBHold_MarkHolding[this] then
            return
        endif
        set s__ABILMedusaBHold_DEST=null
        set s__ABILMedusaBHold_CNT=0
        set s__ABILMedusaBHold_LIFE=0.0
        call s__splash_range(s__splash_ENEMY , s__ABILMedusaBHold_source[this] , GetUnitX(s__ABILMedusaBHold_source[this]) , GetUnitY(s__ABILMedusaBHold_source[this]) , GetUnitAcquireRange(s__ABILMedusaBHold_source[this]) , function s__ABILMedusaBHold_enumGetTarget)
        if s__ABILMedusaBHold_DEST == null then
            return
        endif
        set s__ABILMedusaBHold_MarkedTarget[this]=s__ABILMedusaBHold_DEST
        set s__ABILMedusaBHold_MarkHolding[this]=true
        set tx=s__PosX__staticgetindex(s__ABILMedusaBHold_MarkedTarget[this]) - s__Polar_X(100.0 , s__Angle_WBW(s__ABILMedusaBHold_source[this] , s__ABILMedusaBHold_MarkedTarget[this]))
        set ty=s__PosY__staticgetindex(s__ABILMedusaBHold_MarkedTarget[this]) - s__Polar_Y(100.0 , s__Angle_WBW(s__ABILMedusaBHold_source[this] , s__ABILMedusaBHold_MarkedTarget[this]))
        call SetUnitX(s__ABILMedusaBHold_MarkDummy[this], tx)
        call SetUnitY(s__ABILMedusaBHold_MarkDummy[this], ty)
        call SetUnitFacing(s__ABILMedusaBHold_MarkDummy[this], s__Angle_WBW(s__ABILMedusaBHold_MarkDummy[this] , s__ABILMedusaBHold_MarkedTarget[this]))
        call SetUnitVertexColor(s__ABILMedusaBHold_MarkDummy[this], 128, 128, 128, 128)
        call SetUnitAnimation(s__ABILMedusaBHold_MarkDummy[this], "spell")
        set s__ABILMedusaBHold_MarkEffect[this]=AddSpecialEffectTarget("FXRD\\FX\\BossIndicator\\BossIndicator.mdl", s__ABILMedusaBHold_MarkedTarget[this], "origin")
        call FXRD_FXDebuffShock(s__ABILMedusaBHold_MarkedTarget[this] , 3600.0)
        call FXRD_FXShieldBreak(s__ABILMedusaBHold_MarkedTarget[this] , 3600.0)
        call FXRD_FXPauseShield(s__ABILMedusaBHold_MarkedTarget[this] , 3600.0)
        call FXRD_FXPauseLife(s__ABILMedusaBHold_MarkedTarget[this] , 3600.0)
        call s__tick_start(s__ABILMedusaBHold_MarkTick[this],0.5 , true , function s__ABILMedusaBHold_HoldCallBack)
        set s__ABILMedusaBHold_DEST=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
