    endfunction
    
    //생성자, 소멸자
    
    function s__EVDeathBounty_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVDeathBounty__allocate()
        set s__EVDeathBounty_ID[this]=GetUnitUserData(src)
        call s__EVDeathBounty_setThis(s__EVDeathBounty_ID[this] , this)
        return this
    endfunction
    
    function s__EVDeathBounty_destroy takes integer this returns nothing
        call s__EVDeathBounty_setThis(s__EVDeathBounty_ID[this] , 0)
        call s__EVDeathBounty_deallocate(this)
    endfunction
    
    //API
    function s__EVDeathBounty_append takes unit src,integer gamt,player ownr returns nothing
        local integer this= s__EVDeathBounty_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVDeathBounty application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVDeathBounty_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVDeathBounty_onSourceUnitRemove)
        set s__EVDeathBounty_mySource[this]=src
        set s__EVDeathBounty_goldAmt[this]=gamt
        set s__EVDeathBounty_myOwner[this]=ownr
        set s__EVDeathBounty_atDeath[this]=CreateTrigger()
        set s__EVDeathBounty_onDeathAction[this]=TriggerAddAction(s__EVDeathBounty_atDeath[this], function sc__EVDeathBounty_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVDeathBounty_atDeath[this], src, EVENT_UNIT_DEATH)
    endfunction
    
    //구현부
    function s__EVDeathBounty_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVDeathBounty_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EVDeathBounty_atDeath[this], s__EVDeathBounty_onDeathAction[this])
        set s__EVDeathBounty_onDeathAction[this]=null
        call DestroyTrigger(s__EVDeathBounty_atDeath[this])
        set s__EVDeathBounty_atDeath[this]=null
        set s__EVDeathBounty_mySource[this]=null
        set s__EVDeathBounty_myOwner[this]=null
        call TriggerUnbindAction(s__EVDeathBounty_onRemoveAction[this])
        set s__EVDeathBounty_onRemoveAction[this]=null
        //종결
        call s__EVDeathBounty_destroy(this)
    endfunction
    
    function s__EVDeathBounty_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVDeathBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        if GetKillingUnit() != null then
            set id=GetPlayerId(GetOwningPlayer(GetKillingUnit()))
            call AddPlayerGold(Player(id) , s__EVDeathBounty_goldAmt[this])
            call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", x, y))
            call SetSoundPosition(gg_snd_Gold, x, y, 200)
            call StartSoundForPlayerBJ(Player(id), gg_snd_Gold)
            call s__bountyTag_gold(Player(id) , x , y , s__EVDeathBounty_goldAmt[this])
            call s__eventCustom_evaluate(EVENT_USER_LINEMOB_KILL , s__EVDeathBounty_myOwner[this] , GetKillingUnit() , null , 0)
        endif
        call s__eventCustom_evaluate(EVENT_USER_LINEMOB_DEATH , s__EVDeathBounty_myOwner[this] , s__EVDeathBounty_mySource[this] , null , 0)
    endfunction
    

