    function s__UIGameLoading_destroy takes integer this returns nothing
        call sc__InterfaceBackground_destroy(s__UIGameLoading_if_bgr[this])
        call RemoveDestructable(s__UIGameLoading_img_indicator[this])
        call RemoveDestructable(s__UIGameLoading_img_msg[this])
        set s__UIGameLoading_img_indicator[this]=null
        set s__UIGameLoading_img_msg[this]=null
    endfunction
    function s__UIGameLoading_show takes integer this,boolean flag returns nothing
        call ShowDestructable(s__UIGameLoading_img_indicator[this], flag)
        call ShowDestructable(s__UIGameLoading_img_msg[this], flag)
    endfunction
    function s__UIGameLoading_create takes nothing returns integer
        //Union 객체로 할당
        local integer this= 1
        set s__UIGameLoading_img_indicator[this]=CreateDestructableZ('B001', CONF_UI_CENTERX, CONF_UI_CENTERY - 64.00, 1, 270, 3.00, 0)
        set s__UIGameLoading_img_msg[this]=CreateDestructableZ('B002', CONF_UI_CENTERX, CONF_UI_CENTERY - 320.00, 1, 270, 2.00, 0)
        set s__UIGameLoading_if_bgr[this]=sc__InterfaceBackground_create(null)
        call sc__InterfaceBackground_show(s__UIGameLoading_if_bgr[this],true)
        return this
    endfunction

// scope UIGameLoadingModule begins
    function UIGameLoadingModule__onGameSet takes nothing returns nothing
        if UIGameLoadingModule__singleton == 0 then
            return
        endif
        call s__UIGameLoading_destroy(UIGameLoadingModule__singleton)
        set UIGameLoadingModule__singleton=0
    endfunction
    function UIGameLoadingModule__onMapInitialized takes nothing returns nothing
        if UIGameLoadingModule__singleton == 0 then
            return
        endif
        call s__UIGameLoading_show(UIGameLoadingModule__singleton,false)
    endfunction
    function UIGameLoadingModule__onMapInitializing takes nothing returns nothing
        if UIGameLoadingModule__singleton > 0 then
            call s__UIGameLoading_destroy(UIGameLoadingModule__singleton)
        endif
        set UIGameLoadingModule__singleton=s__UIGameLoading_create()
    endfunction
    function UIGameLoadingModule__main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_MAP_INITIALIZING , function UIGameLoadingModule__onMapInitializing)
        call RRRegisterResponseEvent(RESPONSE_MAP_INITIALIZED , function UIGameLoadingModule__onMapInitialized)
        call RRRegisterResponseEvent(RESPONSE_GAME_SET , function UIGameLoadingModule__onGameSet)
    endfunction
// scope UIGameLoadingModule ends
