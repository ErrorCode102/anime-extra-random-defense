        call UnitRemoveAbility(FXImmuneStun___FX_SOURCE[self], FXImmuneStun___BUFF_IMMUNE)
    endfunction
    
    function FXRD_FXImmuneStun takes unit src,boolean flag returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneStun___FX_EXISTS[self] then
            call FXImmuneStun___Allocate(self , src)
        endif
        set FXImmuneStun___FX_ALWAYS[self]=flag
        //
        if flag then
            if GetUnitAbilityLevel(src, FXImmuneStun___ID_IMMUNE) == 0 then
                call UnitAddAbility(src, FXImmuneStun___ID_IMMUNE)
            endif
            return
        endif
        //
        if not FXImmuneStun___FX_TIMMED[self] then
            call UnitRemoveAbility(src, FXImmuneStun___ID_IMMUNE)
            call UnitRemoveAbility(src, FXImmuneStun___BUFF_IMMUNE)
        endif
    endfunction
    
    function FXRD_FXImmuneStunForced takes unit src,boolean flag returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneStun___FX_EXISTS[self] then
            call FXImmuneStun___Allocate(self , src)
        endif
        set FXImmuneStun___FX_ALWAYS[self]=flag
        //Forcing over tick control
        if FXImmuneStun___FX_TIMMED[self] then
            set FXImmuneStun___FX_TIMMED[self]=false
            call s__tick_pause(FXImmuneStun___FX_TICK[self])
        endif
        //
        if flag then
            if GetUnitAbilityLevel(src, FXImmuneStun___ID_IMMUNE) == 0 then
                call UnitAddAbility(src, FXImmuneStun___ID_IMMUNE)
            endif
            return
        endif
        //
        call UnitRemoveAbility(src, FXImmuneStun___ID_IMMUNE)
        call UnitRemoveAbility(src, FXImmuneStun___BUFF_IMMUNE)
    endfunction
    
    function FXRD_FXImmuneStunTimed takes unit src,real delay returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneStun___FX_EXISTS[self] then
            call FXImmuneStun___Allocate(self , src)
        endif
        //
        if GetUnitAbilityLevel(src, FXImmuneStun___ID_IMMUNE) == 0 then
            call UnitAddAbility(src, FXImmuneStun___ID_IMMUNE)
        endif
        //
        if FXImmuneStun___FX_TIMMED[self] then
            if s__tick__get_remaining(FXImmuneStun___FX_TICK[self]) >= delay then
                return
            endif
        endif
        set FXImmuneStun___FX_TIMMED[self]=true
        call s__tick_start(FXImmuneStun___FX_TICK[self],delay , false , function FXImmuneStun___OnExpire)
    endfunction
    

