    function s__ABILBBSSCCCC_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILBBSSCCCC_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBBSSCCCC_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real mana= GetUnitState(s__ABILBBSSCCCC_source[this], UNIT_STATE_MANA)
        if GetUnitAbilityLevel(s__ABILBBSSCCCC_source[this], 'A0ET') <= 1 then
            return
        endif
        call SetUnitState(s__ABILBBSSCCCC_source[this], UNIT_STATE_MANA, 0.0)
        call s__enemy_dealLogic(s__ABILBBSSCCCC_source[this] , GetSpellTargetUnit() , 999999.0 * ( 1.0 + 0.005 * mana ) , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
