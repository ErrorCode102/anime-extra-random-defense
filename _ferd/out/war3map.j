//library Route:
        function s__Route___rpnt_create takes real x,real y returns integer
            local integer this= s__Route___rpnt__allocate()
            set s__Route___rpnt_X[this]=x
            set s__Route___rpnt_Y[this]=y
            return this
        endfunction
        function s__Route___rpnt_connect takes integer this,integer next returns nothing
            set s__Route___rpnt_R[this]=s__Angle_PBP(s__Route___rpnt_X[this] , s__Route___rpnt_Y[this] , s__Route___rpnt_X[next] , s__Route___rpnt_Y[next])
            set s__Route___rpnt_D[this]=s__Distance_PBP(s__Route___rpnt_X[this] , s__Route___rpnt_Y[this] , s__Route___rpnt_X[next] , s__Route___rpnt_Y[next])
            set s__Route___rpnt_DX[this]=s__Polar_X(1 , s__Route___rpnt_R[this])
            set s__Route___rpnt_DY[this]=s__Polar_Y(1 , s__Route___rpnt_R[this])
        endfunction

        function s__Route_create takes nothing returns integer
            local integer this= s__Route__allocate()
            call sc__Route_clear(this)
            set s__Route_PS[this]=0
            set s__Route_D[this]=0
            return this
        endfunction
        function s__Route_clear takes integer this returns nothing
            local integer i= 0
            loop
                exitwhen i == 5
                if s___Route_P[s__Route_P[this]+i] != 0 then
                    call s__Route___rpnt_deallocate(s___Route_P[s__Route_P[this]+i])
                endif
                set s___Route_P[s__Route_P[this]+i]=0
                set i=i + 1
            endloop
            set s__Route_PS[this]=0
            set s__Route_D[this]=0
        endfunction
        function s__Route__get_distance takes integer this returns real
            return s__Route_D[this]
        endfunction
        function s__Route_destroy takes integer this returns nothing
            call s__Route_clear(this)
            call s__Route_deallocate(this)
        endfunction
        function s__Route_add takes integer this,real x,real y returns nothing
            set s___Route_P[s__Route_P[this]+s__Route_PS[this]]=s__Route___rpnt_create(x , y)
            if s__Route_PS[this] > 0 then
                call s__Route___rpnt_connect(s___Route_P[s__Route_P[this]+s__Route_PS[this] - 1],s___Route_P[s__Route_P[this]+s__Route_PS[this]])
                set s__Route_D[this]=s__Route_D[this] + s__Route___rpnt_D[s___Route_P[s__Route_P[this]+s__Route_PS[this] - 1]]
            endif
            set s__Route_PS[this]=s__Route_PS[this] + 1
        endfunction
        function s__Route_calc takes integer this,real d returns nothing
            local integer i= 0
            set d=ModuloReal(d, s__Route_D[this])
            loop
                if d < s__Route___rpnt_D[s___Route_P[s__Route_P[this]+i]] then
                    set s__Route_X[this]=s__Route___rpnt_X[s___Route_P[s__Route_P[this]+i]] + d * s__Route___rpnt_DX[s___Route_P[s__Route_P[this]+i]]
                    set s__Route_Y[this]=s__Route___rpnt_Y[s___Route_P[s__Route_P[this]+i]] + d * s__Route___rpnt_DY[s___Route_P[s__Route_P[this]+i]]
                    set s__Route_R[this]=s__Route___rpnt_R[s___Route_P[s__Route_P[this]+i]]
                    exitwhen true
                endif
                set d=d - s__Route___rpnt_D[s___Route_P[s__Route_P[this]+i]]
                set i=i + 1
                exitwhen i == 4
            endloop
        endfunction

