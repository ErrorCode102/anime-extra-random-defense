// scope TrigFactionTamamoChangeServant begins
    function TrigFactionTamamoChangeServant__ResetChange takes unit u,integer id returns nothing
        call UnitRemoveAbility(u, id)
        call UnitAddAbility(u, id)
    endfunction
    function TrigFactionTamamoChangeServant__KillWisps takes player p,integer cnt returns nothing
        local group g= CreateGroup()
        local unit u
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen cnt == 0
            exitwhen u == null
            call GroupRemoveUnit(g, u)
            if not IsUnitType(u, UNIT_TYPE_DEAD) then
                if GetUnitAbilityLevel(u, 'A02L') > 0 then
                    call SetUnitTimeScale(u, 1.00)
                    call KillUnit(u)
                    set cnt=cnt - 1
                endif
            endif
        endloop
        call DestroyGroup(g)
        set g=null
        set u=null
    endfunction
    function TrigFactionTamamoChangeServant__CountWisp takes player p returns integer
        local integer cnt= 0
        local group g= CreateGroup()
        local unit u
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set u=FirstOfGroup(g)
            exitwhen u == null
            call GroupRemoveUnit(g, u)
            if not IsUnitType(u, UNIT_TYPE_DEAD) then
                if GetUnitAbilityLevel(u, 'A02L') > 0 then
                    set cnt=cnt + 1
                endif
            endif
        endloop
        call DestroyGroup(g)
        set g=null
        return cnt
    endfunction
    function TrigFactionTamamoChangeServant__Pickup takes player p,integer typeId returns nothing
        local integer id= GetPlayerId(p)
        local real x= GetPlayerStartLocationX(Player(id + 4))
        local real y= GetPlayerStartLocationY(Player(id + 4))
        call s__servant_add(p , CreateUnit(p, typeId, x, y, 270) , s__servant_JOHAB)
    endfunction
    function TrigFactionTamamoChangeServant__OnCast takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        local integer lev= GetUnitLevel(GetSpellTargetUnit())
        local integer cnt
        if GetOwningPlayer(GetSpellTargetUnit()) != Player(PLAYER_NEUTRAL_PASSIVE) then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000You must select the servant you want to summon from the combination table.|r")
            call TrigFactionTamamoChangeServant__ResetChange(GetTriggerUnit() , GetSpellAbilityId())
        endif
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_SAPPER) then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000You cannot summon a Hidden Servant that doesn't appear in Gacha or Draws.|r")
            call TrigFactionTamamoChangeServant__ResetChange(GetTriggerUnit() , GetSpellAbilityId())
            return
        endif
        if not IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000Non-Servant targets cannot be summoned.|r")
            call TrigFactionTamamoChangeServant__ResetChange(GetTriggerUnit() , GetSpellAbilityId())
            return
        endif
        if lev > 4 or lev < 1 then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000Servants of this grade cannot be summoned.|r")
            call TrigFactionTamamoChangeServant__ResetChange(GetTriggerUnit() , GetSpellAbilityId())
            return
        endif
        set cnt=TrigFactionTamamoChangeServant__CountWisp(Player(id))
        if cnt < TrigFactionTamamoChangeServant__PICKUP_REQ[lev] then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000In order to summon this servant, you'll need " + I2S(TrigFactionTamamoChangeServant__PICKUP_REQ[lev] - cnt) + " more Saint Quartz.|r")
            call TrigFactionTamamoChangeServant__ResetChange(GetTriggerUnit() , GetSpellAbilityId())
            return
        endif
        call TrigFactionTamamoChangeServant__KillWisps(Player(id) , TrigFactionTamamoChangeServant__PICKUP_REQ[lev])
        call TrigFactionTamamoChangeServant__Pickup(Player(id) , GetUnitTypeId(GetSpellTargetUnit()))
    endfunction
    function TrigFactionTamamoChangeServant__main takes nothing returns nothing
        set TrigFactionTamamoChangeServant__PICKUP_REQ[1]=1
        set TrigFactionTamamoChangeServant__PICKUP_REQ[2]=2
        set TrigFactionTamamoChangeServant__PICKUP_REQ[3]=5
        set TrigFactionTamamoChangeServant__PICKUP_REQ[4]=10
        call s__AbilityEffectEvent_Create('A09D' , function TrigFactionTamamoChangeServant__OnCast)
    endfunction
// scope TrigFactionTamamoChangeServant ends
