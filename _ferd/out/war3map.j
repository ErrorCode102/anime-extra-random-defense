        function s__DecodeEvent_register takes integer ver,code c returns nothing
            if s__DecodeEvent_T[ver] == null then
                set s__DecodeEvent_T[ver]=CreateTrigger()
            endif
            call TriggerAddCondition(s__DecodeEvent_T[ver], Filter(c))
        endfunction
        function s__DecodeEvent_evaluate takes player p,integer w,integer ver returns nothing
            set s__DecodeEvent_e=w
            set s__DecodeEvent_ep=p
            call TriggerEvaluate(s__DecodeEvent_T[ver])
            set s__DecodeEvent_e=0
            set s__DecodeEvent_ep=null
        endfunction
    
        function s__Decoder_onInit takes nothing returns nothing
            //이전 버전 호환
            call s__DecodeEvent_register(0 , function sc__Decoder_DECS00000)
            //최신 버전
            call s__DecodeEvent_register(1 , function sc__Decoder_DECS00001)
        endfunction
        
        
        function s__Decoder_DECS00001 takes nothing returns nothing
            //이 버전에서 특기할 사항
            local integer FACTION_MAX_THISVER= 5
            local integer FACTION_MAX_LEVEL_THISVER= 15
            local integer FACTION_XP_LIMIT_THISVER= 130000
            local integer MASTER_MAX_LEVEL_THISVER= 1000
            local integer MASTER_XP_LIMIT_THISVER= 1035000
            //
            local integer fIndex= 1
            //
            local integer id= GetPlayerId(s__DecodeEvent_ep)
            local integer theCode= s__DecodeEvent_e
            //-상하키-
            local integer upperkey= sc__Savecode_Decode(theCode,10)
            local integer lowerkey= sc__Savecode_Decode(theCode,9)
            //-끝-
            local integer array factionXp
            local integer array factionLv
            local integer masterXp
            local integer masterLv
            local integer playTime
            local integer session
            
            //-주 데이터-
            
            set factionXp[5]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[4]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[3]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[2]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[1]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionLv[5]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[4]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[3]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[2]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[1]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set masterXp=sc__Savecode_Decode(theCode,MASTER_XP_LIMIT_THISVER)
            set masterLv=sc__Savecode_Decode(theCode,MASTER_MAX_LEVEL_THISVER)
            set playTime=sc__Savecode_Decode(theCode,599940)
            set session=sc__Savecode_Decode(theCode,1)
            
            //-최후 검증-
            if sc__Savecode_Decode(theCode,upperkey) != lowerkey then
                return
            endif
            
            //최후 검증까지 무사했다면...
            set UI_ERROR[id]=false
            //-주 데이터 복원 -
            set DATA_SESSION[id]=session
            set DATA_PLAYTIME[id]=playTime
            call FXSetPlayerMasterLevel(Player(id) , masterLv)
            call FXSetPlayerMasterXp(Player(id) , masterXp)
            loop
                exitwhen fIndex > FX_FACTION_MAX
                if fIndex > FACTION_MAX_THISVER then
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , 1)
                    call FXSetPlayerFactionXp(Player(id) , fIndex , 0)
                else
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , factionLv[fIndex])
                    call FXSetPlayerFactionXp(Player(id) , fIndex , factionXp[fIndex])
                endif
                set fIndex=fIndex + 1
            endloop
            //-끝 -
        endfunction
        
        
        function s__Decoder_DECS00000 takes nothing returns nothing
            //이 버전에서 특기할 사항
            local integer FACTION_MAX_THISVER= 4
            local integer FACTION_MAX_LEVEL_THISVER= 15
            local integer FACTION_XP_LIMIT_THISVER= 130000
            local integer MASTER_MAX_LEVEL_THISVER= 999
            local integer MASTER_XP_LIMIT_THISVER= 1035000
            //
            local integer fIndex= 1
            //
            local integer id= GetPlayerId(s__DecodeEvent_ep)
            local integer theCode= s__DecodeEvent_e
            //-상하키-
            local integer upperkey= sc__Savecode_Decode(theCode,10)
            local integer lowerkey= sc__Savecode_Decode(theCode,9)
            //-끝-
            local integer array factionXp
            local integer array factionLv
            local integer masterXp
            local integer masterLv
            local integer playTime
            local integer session
            
            //-주 데이터-
            set factionXp[4]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[3]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[2]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[1]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionLv[4]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[3]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[2]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[1]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set masterXp=sc__Savecode_Decode(theCode,MASTER_XP_LIMIT_THISVER)
            set masterLv=sc__Savecode_Decode(theCode,MASTER_MAX_LEVEL_THISVER)
            set playTime=sc__Savecode_Decode(theCode,599940)
            set session=sc__Savecode_Decode(theCode,1)
            
            //-최후 검증-
            if sc__Savecode_Decode(theCode,upperkey) != lowerkey then
                return
            endif
            
            //최후 검증까지 무사했다면...
            set UI_ERROR[id]=false
            //-주 데이터 복원 -
            set DATA_SESSION[id]=session
            set DATA_PLAYTIME[id]=playTime
            call FXSetPlayerMasterLevel(Player(id) , masterLv)
            call FXSetPlayerMasterXp(Player(id) , masterXp)
            loop
                exitwhen fIndex > FX_FACTION_MAX
                if fIndex > FACTION_MAX_THISVER then
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , 1)
                    call FXSetPlayerFactionXp(Player(id) , fIndex , 0)
                else
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , factionLv[fIndex])
                    call FXSetPlayerFactionXp(Player(id) , fIndex , factionXp[fIndex])
                endif
                set fIndex=fIndex + 1
            endloop
            //-끝 -
        endfunction
    
        //세이브데이터 코어
        
        function s__SaveData_encodeFaction takes player p,integer myCode returns nothing
            local integer fIndex= 1
            loop
                exitwhen fIndex > FX_FACTION_MAX
                call sc__Savecode_Encode(myCode,FXGetPlayerFactionLevel(p , fIndex) , FX_FACTION_MAX_LEVEL)
                set fIndex=fIndex + 1
            endloop
            set fIndex=1
            loop
                exitwhen fIndex > FX_FACTION_MAX
                call sc__Savecode_Encode(myCode,FXGetPlayerFactionXp(p , fIndex) , FX_FACTION_LIMIT_XP)
                set fIndex=fIndex + 1
            endloop
        endfunction
        
        function s__SaveData_encode takes player p returns nothing
            local string codeStr
            local integer id= GetPlayerId(p)
            local string oName= USER_NAME[id]
            local boolean saveEnable= true
            local string prefix
            local integer myCode= sc__Savecode_create()
            local integer upperkey= 7
            local integer lowerkey= 7
            //닉네임 짧으면 덧대기
            if StringLength(oName) < 5 then
                set oName="lo" + oName
            endif
            //최하키 기록
            call sc__Savecode_Encode(myCode,lowerkey , upperkey)
            //-데이터 기록부-
            call sc__Savecode_Encode(myCode,IMinBJ(MAP_SESSION, DATA_SESSION[id]) , 1)
            call sc__Savecode_Encode(myCode,DATA_PLAYTIME[id] , 599940)
            call sc__Savecode_Encode(myCode,FXGetPlayerMasterLevel(p) , FX_MASTER_MAX_LEVEL)
            call sc__Savecode_Encode(myCode,FXGetPlayerMasterXp(p) , FX_MASTER_LIMIT_XP)
            call s__SaveData_encodeFaction(p , myCode)
            //-끝-
            
            //상하키 기록
            call sc__Savecode_Encode(myCode,lowerkey , 9)
            call sc__Savecode_Encode(myCode,upperkey , 10)
            //버전 기록
            call sc__Savecode_Encode(myCode,MAP_VERSION , MAP_MAX_VERSION)
            
            set codeStr=sc__Savecode_Save(myCode,oName , s__SaveData_SAVEHASH)
            
            if not USER_IS_FIRSTPLAY[id] then
                set oName="SaveCode_" + I2S(MAP_VERSION) + "_" + I2S(StringHash(USER_NAME[id]))
                set prefix="This is the last save file you played Fate Extra Random Defense."
            else
                set oName="NewSave_" + I2S(MAP_VERSION) + "_" + I2S(StringHash(USER_NAME[id]))
                set prefix="This is the first save file of Fate Extra Random Defense."
            endif
            if IMinBJ(MAP_SESSION, DATA_SESSION[id]) == 0 then
                set oName="CHT" + oName
                set prefix="[Unofficial]" + prefix
            endif
            set s__FXGameResult_LastSaveCode[(id)]=codeStr
            call sc__Savecode_deallocate(myCode)
            
            if GetLocalPlayer() != p then
                set saveEnable=false
            endif
            if GetPlayerId(GetLocalPlayer()) != MAP_INITIAL_USER then
                set saveEnable=false
            endif
            
            call sc__SaveData_showCodeQuest(p , codeStr , saveEnable)
            if saveEnable then
                call DisplayTextToPlayer(p, 0.00, 0.00, "|c000080ffAuto saved|r")
                call FlashQuestDialogButton()
                call PreloadGenClear()
                call PreloadGenStart()
                call Preload("<Fate Extra Random Defense Final Season Achievement Data>")
                call Preload("Save version: " + I2S(MAP_VERSION))
                call Preload(prefix)
                call Preload("==================================================================")
                call Preload("Nickname " + USER_NAME[id])
                call Preload("Playtime " + I2S(DATA_PLAYTIME[id] / 60) + "h " + I2S(ModuloInteger(DATA_PLAYTIME[id], 60)) + "m")
                call Preload(" [Master Information]")
                call Preload("  - Master Lvl : " + I2S(FXGetPlayerMasterLevel(p)))
                call Preload("  - Master XP : " + I2S(FXGetPlayerMasterXp(p)))
                call Preload(" [Faction Information]")
                call Preload("  Nero Claudius")
                call Preload("   - Lvl : " + I2S(FXGetPlayerFactionLevel(p , FX_FACTION_NERO)))
                call Preload("   - XP : " + I2S(FXGetPlayerFactionXp(p , FX_FACTION_NERO)))
                call Preload("  Tamamo-no-Mae")
                call Preload("   - Lvl : " + I2S(FXGetPlayerFactionLevel(p , FX_FACTION_TAMAMO)))
                call Preload("   - XP : " + I2S(FXGetPlayerFactionXp(p , FX_FACTION_TAMAMO)))
                call Preload("  Attila")
                call Preload("   - Lvl : " + I2S(FXGetPlayerFactionLevel(p , FX_FACTION_ALTERA)))
                call Preload("   - XP : " + I2S(FXGetPlayerFactionXp(p , FX_FACTION_ALTERA)))
                call Preload("  Another")
                call Preload("   - Lvl : " + I2S(FXGetPlayerFactionLevel(p , FX_FACTION_ANOTHER)))
                call Preload("   - XP : " + I2S(FXGetPlayerFactionXp(p , FX_FACTION_ANOTHER)))
                call Preload("  BB")
                call Preload("   - Lvl : " + I2S(FXGetPlayerFactionLevel(p , FX_FACTION_BB)))
                call Preload("   - XP : " + I2S(FXGetPlayerFactionXp(p , FX_FACTION_BB)))
                call Preload("==================================================================")
                call PreloadSaveCode("-load " + codeStr)
                call Preload("Code usage: Copy the above code with Ctrl+C and paste it in the Warcraft chat window with Ctrl+V.")
                call PreloadGenEnd("Fate Extra Random Defence\\" + oName + ".txt")
            else
                call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff8000No other save code is created in replay mode!|r")
            endif
        endfunction
        //
        function s__SaveData_showCodeQuest takes player p,string codeStr,boolean saveEnable returns nothing
            local integer myFaction= FXGetPlayerCurrentFaction(p)
            local quest q= CreateQuest()
            call QuestSetTitle(q, "View - Save Code")
            call QuestSetDescription(q, codeStr)
            if FXIsPlayerFactionMastered(p , myFaction) then
                call QuestSetIconPath(q, FXGetFactionMasterIcon(myFaction))
            else
                call QuestSetIconPath(q, FXGetFactionIcon(myFaction))
            endif
            call QuestSetRequired(q, true)
            call QuestSetDiscovered(q, saveEnable)
            call QuestSetEnabled(q, saveEnable)
            set q=null
        endfunction
        //
        function s__SaveData_decode takes player p,string codeStr returns nothing
            local integer theCode= sc__Savecode_create()
            local integer id= GetPlayerId(p)
            local string oName= USER_NAME[id]
            local integer ver
            //에러가 떴음을 기정사실화
            set UI_ERROR[id]=true
            //각종 오류 체크
            if not sc__Savecode_Load(theCode,oName , codeStr , s__SaveData_SAVEHASH) then
                call sc__Savecode_deallocate(theCode)
                if StringLength(oName) < 5 then
                    set oName="lo" + oName
                endif
                set theCode=sc__Savecode_create()
                if not sc__Savecode_Load(theCode,oName , codeStr , s__SaveData_SAVEHASH) then
                    call sc__Savecode_deallocate(theCode)
                    return
                endif
            endif
            set ver=sc__Savecode_Decode(theCode,MAP_MAX_VERSION)
            if ver > MAP_VERSION then
                call sc__Savecode_deallocate(theCode)
                return
            endif
            //코드 불러오기
            call s__DecodeEvent_evaluate(p , theCode , ver)
            call sc__Savecode_deallocate(theCode)
            if UI_ERROR[id] then
                return
            endif
            set USER_IS_FIRSTPLAY[id]=false
        endfunction

//library SaveEngine ends
//library Savecode:
//library Savecode requires BigNum
//Colorize colors
constant function uppercolor takes nothing returns string
	return "|cffff0000"
endfunction
constant function lowercolor takes nothing returns string
	return "|cff00ff00"
endfunction
constant function numcolor takes nothing returns string
	return "|cff0000ff"
endfunction

function Savecode___player_charset takes nothing returns string
	return Savecode___CHARSET
endfunction
function Savecode___player_charsetlen takes nothing returns integer
	return StringLength(Savecode___CHARSET)
endfunction

function Savecode___charset takes nothing returns string
	return Savecode___CHARSET
//	return "0123456789"
endfunction
function Savecode___charsetlen takes nothing returns integer
	return StringLength(Savecode___CHARSET)
endfunction
function Savecode___BASE takes nothing returns integer
	return Savecode___charsetlen()
endfunction

constant function Savecode___HASHN takes nothing returns integer
	return 5000 //1./HASHN() is the probability of a random code being valid
endfunction

constant function Savecode___MAXINT takes nothing returns integer
	return 2147483647
endfunction

function Savecode___player_chartoi takes string c returns integer
 local integer i= 0
 local string cs= Savecode___player_charset()
 local integer len= Savecode___player_charsetlen()
	loop
		exitwhen i >= len or c == SubString(cs, i, i + 1)
		set i=i + 1
	endloop
	return i
endfunction

function Savecode___chartoi takes string c returns integer
 local integer i= 0
 local string cs= Savecode___charset()
 local integer len= Savecode___charsetlen()
	loop
		exitwhen i >= len or c == SubString(cs, i, i + 1)
		set i=i + 1
	endloop
	return i
endfunction

function Savecode___itochar takes integer i returns string
	return SubString(Savecode___charset(), i, i + 1)
endfunction

//You probably want to use a different char set for this
//Also, use a hash that doesn't suck so much
function Savecode___scommhash takes string s returns integer
 local integer array count
 local integer i= 0
 local integer len= StringLength(s)
 local integer x
	set s=StringCase(s, true)
	loop
		exitwhen i >= len
		set x=Savecode___player_chartoi(SubString(s, i, i + 1))
		set count[x]=count[x] + 1
		set i=i + 1
	endloop
	set i=0
	set len=Savecode___player_charsetlen()
	set x=0
	loop
		exitwhen i >= len
		set x=count[i] * count[i] * i + count[i] * x + x + 199
//		call BJDebugMsg(I2S(x)+" "+I2S(count[i]))
//		call TriggerSleepAction(0.)
		set i=i + 1
	endloop
	if x < 0 then
		set x=- x
	endif
	return x
endfunction

function Savecode___modb takes integer x returns integer
	if x >= Savecode___BASE() then
		return x - Savecode___BASE()
	elseif x < 0 then
		return x + Savecode___BASE()
	else
		return x
	endif
endfunction

    
 function s__Savecode_create takes nothing returns integer
  local integer sc= s__Savecode__allocate()
		set s__Savecode_digits[sc]=0.
		set s__Savecode_bignum[sc]=s__BigNum_create(Savecode___BASE())
		return sc
 endfunction
    
    function s__Savecode_onDestroy takes integer this returns nothing
		call s__BigNum_deallocate(s__Savecode_bignum[this])
 endfunction

//Generated destructor of Savecode
function s__Savecode_deallocate takes integer this returns nothing
    if this==null then
        return
    elseif (si__Savecode_V[this]!=-1) then
        return
    endif
    call s__Savecode_onDestroy(this)
    set si__Savecode_V[this]=si__Savecode_F
    set si__Savecode_F=this
endfunction

 function s__Savecode_Encode takes integer this,integer val,integer max returns nothing
		set s__Savecode_digits[this]=s__Savecode_digits[this] + log(max + 1 , Savecode___BASE())
		call s__BigNum_MulSmall(s__Savecode_bignum[this],max + 1)
		call s__BigNum_AddSmall(s__Savecode_bignum[this],val)
 endfunction
	
 function s__Savecode_Decode takes integer this,integer max returns integer
		return s__BigNum_DivSmall(s__Savecode_bignum[this],max + 1)
 endfunction
	
 function s__Savecode_IsEmpty takes integer this returns boolean
		return s__BigNum_IsZero(s__Savecode_bignum[this])
 endfunction
	
 function s__Savecode_Length takes integer this returns real
		return s__Savecode_digits[this]
 endfunction
	
 function s__Savecode_Clean takes integer this returns nothing
		call s__BigNum_Clean(s__Savecode_bignum[this])
 endfunction
    
    	//These functions get too intimate with BigNum_l
 function s__Savecode_Pad takes integer this returns nothing
  local integer cur= s__BigNum_list[s__Savecode_bignum[this]]
  local integer prev
  local integer maxlen= R2I(1.0 + s__Savecode_Length(this))
		
		loop
			exitwhen cur == 0
			set prev=cur
			set cur=s__BigNum_l_next[cur]
			set maxlen=maxlen - 1
		endloop
		loop
			exitwhen maxlen <= 0
			set s__BigNum_l_next[prev]=s__BigNum_l_create()
			set prev=s__BigNum_l_next[prev]
			set maxlen=maxlen - 1
		endloop
 endfunction
	
 function s__Savecode_ToString takes integer this returns string
  local integer cur= s__BigNum_list[s__Savecode_bignum[this]]
  local string s= ""
		loop
			exitwhen cur == 0
			set s=Savecode___itochar(s__BigNum_l_leaf[cur]) + s
			set cur=s__BigNum_l_next[cur]
		endloop
		return s
 endfunction
	
 function s__Savecode_FromString takes integer this,string s returns nothing
  local integer i= StringLength(s) - 1
  local integer cur= s__BigNum_l_create()
		set s__BigNum_list[s__Savecode_bignum[this]]=cur
		loop
			set s__BigNum_l_leaf[cur]=Savecode___chartoi(SubString(s, i, i + 1))
			exitwhen i <= 0
			set s__BigNum_l_next[cur]=s__BigNum_l_create()
			set cur=s__BigNum_l_next[cur]
			set i=i - 1
		endloop
 endfunction
	
 function s__Savecode_Hash takes integer this returns integer
  local integer hash= 0
  local integer x
  local integer cur= s__BigNum_list[s__Savecode_bignum[this]]
		loop
			exitwhen cur == 0
			set x=s__BigNum_l_leaf[cur]
			set hash=ModuloInteger(hash + 79 * hash / ( x + 1 ) + 293 * x / ( 1 + hash - ( hash / Savecode___BASE() ) * Savecode___BASE() ) + 479, Savecode___HASHN())
			set cur=s__BigNum_l_next[cur]
		endloop
		return hash
 endfunction

	//this is not cryptographic which is fine for this application
	//sign = 1 is forward
	//sign = -1 is backward
 function s__Savecode_Obfuscate takes integer this,integer key,integer sign returns nothing
  local integer seed= GetRandomInt(0, Savecode___MAXINT())
  local integer advance
  local integer x
  local integer cur= s__BigNum_list[s__Savecode_bignum[this]]
	
	
		if sign == - 1 then
			call SetRandomSeed(s__BigNum_LastDigit(s__Savecode_bignum[this]))
			set s__BigNum_l_leaf[cur]=Savecode___modb(s__BigNum_l_leaf[cur] + sign * GetRandomInt(0, Savecode___BASE() - 1))
			set x=s__BigNum_l_leaf[cur]
		endif
		
		call SetRandomSeed(key)
		loop
			exitwhen cur == 0
			
			if sign == - 1 then
				set advance=s__BigNum_l_leaf[cur]
			endif
			set s__BigNum_l_leaf[cur]=Savecode___modb(s__BigNum_l_leaf[cur] + sign * GetRandomInt(0, Savecode___BASE() - 1))
			if sign == 1 then
				set advance=s__BigNum_l_leaf[cur]
			endif
			set advance=advance + GetRandomInt(0, Savecode___BASE() - 1)
			call SetRandomSeed(advance)
			
			set x=s__BigNum_l_leaf[cur]
			set cur=s__BigNum_l_next[cur]
		endloop
		
		if sign == 1 then
			call SetRandomSeed(x)
			set s__BigNum_l_leaf[s__BigNum_list[s__Savecode_bignum[this]]]=Savecode___modb(s__BigNum_l_leaf[s__BigNum_list[s__Savecode_bignum[this]]] + sign * GetRandomInt(0, Savecode___BASE() - 1))
		endif
		
		call SetRandomSeed(seed)
 endfunction
	
 function s__Savecode_Dump takes integer this returns nothing
  local integer cur= s__BigNum_list[s__Savecode_bignum[this]]
  local string s= ""
		set s="max: " + R2S(s__Savecode_digits[this])
		
		loop
			exitwhen cur == 0
			set s=I2S(s__BigNum_l_leaf[cur]) + " " + s
			set cur=s__BigNum_l_next[cur]
		endloop
		call BJDebugMsg(s)
 endfunction
	
 function s__Savecode_Save takes integer this,string p,integer loadtype returns string
  local integer key= Savecode___scommhash(p) + loadtype * 73
  local string s
  local integer hash
		call s__Savecode_Clean(this)
		set hash=s__Savecode_Hash(this)
		call s__Savecode_Encode(this,hash , Savecode___HASHN())
		call s__Savecode_Clean(this)
		
		/////////////////////// Save code information.  Comment out next two lines in implementation
		//debug call BJDebugMsg("Expected length: " +I2S(R2I(1.0+.Length())))
		//debug call BJDebugMsg("Room left in last char: "+R2S(1.-ModuloReal((.Length()),1)))
		///////////////////////
		
		call s__Savecode_Pad(this)
		call s__Savecode_Obfuscate(this,key , 1)
		return s__Savecode_ToString(this)
 endfunction
	
 function s__Savecode_Load takes integer this,string ps,string s,integer loadtype returns boolean
  local integer ikey= Savecode___scommhash(ps) + loadtype * 73
  local integer inputhash
		
		call s__Savecode_FromString(this,s)
		call s__Savecode_Obfuscate(this,ikey , - 1)
		set inputhash=s__Savecode_Decode(this,Savecode___HASHN())
		
		call s__Savecode_Clean(this)
		
		return inputhash == s__Savecode_Hash(this)
 endfunction
function Savecode___isupper takes string c returns boolean
	return c == StringCase(c, true)
endfunction

function Savecode___ischar takes string c returns boolean
	return S2I(c) == 0 and c != "0"
endfunction

function Savecode___chartype takes string c returns integer
	if ( Savecode___ischar(c) ) then
		if Savecode___isupper(c) then
			return 0
		else
			return 1
		endif
	else
		return 2
	endif
endfunction

function Savecode___testchar takes string c returns nothing
	if ( Savecode___ischar(c) ) then
		if Savecode___isupper(c) then
			call BJDebugMsg(c + " isupper")
		else
			call BJDebugMsg(c + " islower")
		endif
	else
		call BJDebugMsg(c + " isnumber")
	endif
endfunction

function ColorizeSaveCode takes string s returns string
 local string out= ""
 local integer i= 0
 local integer len= StringLength(s)
 local integer ctype
 local string c
	loop
		exitwhen i >= len
		set c=SubString(s, i, i + 1)
		set ctype=Savecode___chartype(c)
		if ctype == 0 then
			set out=out + uppercolor() + c + "|r"
		elseif ctype == 1 then
			set out=out + lowercolor() + c + "|r"
		else
			set out=out + numcolor() + c + "|r"
		endif
		set i=i + 1
	endloop
	return out
endfunction

function Savecode___RunTests takes nothing returns nothing
    //debug call Test_Assert(s+"first",proposition.prop_Savecode)
    //debug call Test_Assert(s+"second",proposition.prop_Savecode)   
endfunction


//library Savecode ends
//library FXBlackhole:

    
    
    
    function FXBlackhole___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXKnockbackInverse(GetEnumUnit() , FXBlackhole___UDUM[self] , GetUnitMoveSpeed(GetEnumUnit()) * 0.25 , 0 , 0.30)
    endfunction
    
    function FXBlackhole___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        local real ang
        local real x
        local real y
        if s__Distance_WBP(FXBlackhole___UDUM[self] , FXBlackhole___DSTX[self] , FXBlackhole___DSTY[self]) < FXBlackhole___ASPD[self] then
            set x=FXBlackhole___DSTX[self]
            set y=FXBlackhole___DSTY[self]
            set FXBlackhole___DSTX[self]=GetRandomReal(FXBlackhole___MINX[self], FXBlackhole___MAXX[self])
            set FXBlackhole___DSTY[self]=GetRandomReal(FXBlackhole___MINY[self], FXBlackhole___MAXY[self])
        else
            set ang=s__Angle_WBP(FXBlackhole___UDUM[self] , FXBlackhole___DSTX[self] , FXBlackhole___DSTY[self])
            set x=GetUnitX(FXBlackhole___UDUM[self]) + s__Polar_X(FXBlackhole___ASPD[self] , ang)
            set y=GetUnitY(FXBlackhole___UDUM[self]) + s__Polar_Y(FXBlackhole___ASPD[self] , ang)
        endif
        call SetUnitX(FXBlackhole___UDUM[self], x)
        call SetUnitY(FXBlackhole___UDUM[self], y)
        call SetUnitX(FXBlackhole___UWAR[self], x)
        call SetUnitY(FXBlackhole___UWAR[self], y)
        set FXBlackhole___ITER[self]=FXBlackhole___ITER[self] - 1
        if FXBlackhole___ITER[self] == 0 then
            set FXBlackhole___ITER[self]=10
            call s__splash_range(s__splash_ANY , null , x , y , 500 , function FXBlackhole___EnumSplash)
        endif
    endfunction
    
    function FXRD_FXBlackholeCreate takes real minX,real maxX,real minY,real maxY,real spd returns integer
        local integer self= s__tick_create(0)
        set FXBlackhole___OEXI[self]=true
        set FXBlackhole___ITER[self]=10
        set FXBlackhole___MINX[self]=minX
        set FXBlackhole___MAXX[self]=maxX
        set FXBlackhole___MINY[self]=minY
        set FXBlackhole___MAXY[self]=maxY
        set FXBlackhole___ASPD[self]=spd * 0.03125
        set FXBlackhole___DSTX[self]=GetRandomReal(minX, maxX)
        set FXBlackhole___DSTY[self]=GetRandomReal(minY, maxY)
        set FXBlackhole___UDUM[self]=CreateUnit(FX_PLAYER_DUMMY, FXBlackhole___ABMD, FXBlackhole___DSTX[self], FXBlackhole___DSTY[self], 270)
        call SetUnitVertexColor(FXBlackhole___UDUM[self], 255, 255, 255, 128)
        set FXBlackhole___UWAR[self]=CreateUnit(FX_PLAYER_DUMMY, FXBlackhole___INMD, FXBlackhole___DSTX[self], FXBlackhole___DSTY[self], 270)
        call SetUnitScale(FXBlackhole___UWAR[self], 5, 5, 1)
        call s__tick_start(self,0.03125 , true , function FXBlackhole___OnExpire)
        return self
    endfunction
    
    function FXRD_FXBlackholeDestroy takes integer src returns nothing
        local integer self= src
        if not FXBlackhole___OEXI[self] then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Fatal error: An attempt was made to destroy an FX_BLACKHOLE FXRD object that does not exist.")
            return
        endif
        call KillUnit(FXBlackhole___UDUM[self])
        set FXBlackhole___UDUM[self]=null
        call KillUnit(FXBlackhole___UWAR[self])
        set FXBlackhole___UWAR[self]=null
        set FXBlackhole___OEXI[self]=false
        call s__tick_destroy(self)
    endfunction
    

//library FXBlackhole ends
//library FXBomb:

    
    
    function FXBomb___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 3.00)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXKnockbackFromToPos(GetEnumUnit() , FXBomb___DSTX[self] , FXBomb___DSTY[self] , 500 , 250 , 0.625)
    endfunction
    
    function FXBomb___Destroy takes integer self returns nothing
        set FXBomb___UCAS[self]=null
        set FXBomb___UWAR[self]=null
        call s__tick_destroy(self)
    endfunction
    function FXBomb___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        call KillUnit(FXBomb___UWAR[self])
        if FXBomb___UCAS[self] != null then
            if IsUnitDead(FXBomb___UCAS[self]) then
                call FXBomb___Destroy(self)
                return
            endif
        endif
        call DestroyEffect(AddSpecialEffect("FX\\Nero\\Ultimate.mdl", FXBomb___DSTX[self], FXBomb___DSTY[self]))
        call s__splash_range(s__splash_ANY , null , FXBomb___DSTX[self] , FXBomb___DSTY[self] , 300 , function FXBomb___EnumSplash)
        call FXBomb___Destroy(self)
        return
    endfunction
    
    function FXRD_FXBomb takes unit caster,real x,real y,real radius,real delay returns nothing
        local integer self= s__tick_create(0)
        set FXBomb___DSTX[self]=x
        set FXBomb___DSTY[self]=y
        set FXBomb___DRAD[self]=radius
        set FXBomb___UCAS[self]=caster
        set FXBomb___UWAR[self]=CreateUnit(Player(15), FXBomb___ABMD, FXBomb___DSTX[self], FXBomb___DSTY[self], 270)
        call SetUnitScale(FXBomb___UWAR[self], radius * 0.01, 0, 0)
        call SetUnitVertexColor(FXBomb___UWAR[self], 255, 0, 0, 128)
        call s__tick_start(self,delay , false , function FXBomb___OnExpire)
    endfunction
    

//library FXBomb ends
//library FXCharge:

    
    function FXCharge___Destroy takes integer ATIK returns nothing
        set FXCharge___ADST[ATIK]=null
        call s__tick_destroy(ATIK)
    endfunction

    function FXCharge___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 3.00)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXKnockbackFromPos(GetEnumUnit() , FXCharge___ADSX[self] , FXCharge___ADSY[self] , 500 , 250 , 0.625)
    endfunction
    
    function FXCharge___OnImpact takes nothing returns nothing
        local integer ATIK= s__tick_getExpired()
        if FXCharge___ADST[ATIK] == null then
            call s__splash_range(s__splash_ANY , null , FXCharge___ADSX[ATIK] , FXCharge___ADSY[ATIK] , 500 , function FXCharge___EnumSplash)
        else
            if not IsUnitDead(FXCharge___ADST[ATIK]) then
                set FXCharge___ADSX[ATIK]=GetUnitX(FXCharge___ADST[ATIK])
                set FXCharge___ADSY[ATIK]=GetUnitY(FXCharge___ADST[ATIK])
                call s__splash_range(s__splash_ANY , null , FXCharge___ADSX[ATIK] , FXCharge___ADSY[ATIK] , 500 , function FXCharge___EnumSplash)
            endif
        endif
        call FXCharge___Destroy(ATIK)
    endfunction
    
    function FXCharge___OnCastStart takes nothing returns nothing
        local integer ATIK= s__tick_getExpired()
        local unit u= null
        if FXCharge___ADST[ATIK] == null then
            set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , FXCharge___ADSX[ATIK] , FXCharge___ADSY[ATIK] , 270 , 255 , 0 , 0 , 255 , 5)
            call SetUnitTimeScale(u, FXCharge___ADUR[ATIK] * 0.1)
            call UnitApplyTimedLife(u, 'BHwe', FXCharge___ADUR[ATIK])
        else
            if IsUnitDead(FXCharge___ADST[ATIK]) then
                call FXCharge___Destroy(ATIK)
                return
            endif
            set FXCharge___ADSX[ATIK]=GetUnitX(FXCharge___ADST[ATIK])
            set FXCharge___ADSY[ATIK]=GetUnitY(FXCharge___ADST[ATIK])
            set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , FXCharge___ADSX[ATIK] , FXCharge___ADSY[ATIK] , 270 , 255 , 0 , 0 , 255 , 5)
            call SetUnitTimeScale(u, FXCharge___ADUR[ATIK] * 0.1)
            call FXRD_FXLifeSpanCommon(u , FXCharge___ADUR[ATIK])
            call FXRD_FXBinderBindUnit(u , FXCharge___ADST[ATIK])
            call sc__DummyFollowUnit_cast(u , FXCharge___ADST[ATIK])
        endif
        set u=null
        call s__tick_start(ATIK,FXCharge___ADUR[ATIK] , false , function FXCharge___OnImpact)
    endfunction

    function FXRD_FXCharge takes unit u,real x,real y,real casdur,real dur returns nothing
        local integer ATIK= s__tick_create(0)
        set FXCharge___ADST[ATIK]=u
        set FXCharge___ADSX[ATIK]=x
        set FXCharge___ADSY[ATIK]=y
        set FXCharge___ADUR[ATIK]=dur
        call s__tick_start(ATIK,casdur , false , function FXCharge___OnCastStart)
    endfunction
    
    function FXRD_FXChargeSource takes unit src,real casdur,real dur returns nothing
        call FXRD_FXCharge(src , GetUnitX(src) , GetUnitY(src) , casdur , dur)
    endfunction

//library FXCharge ends
//library FXChate:

    
    
    
    function FXChate___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXKnockbackFrom(GetEnumUnit() , FXChate___UDUM[self] , GetUnitMoveSpeed(GetEnumUnit()) , 250 , 1.00)
    endfunction
    
    function FXChate___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        local unit u=CreateUnit(FX_PLAYER_DUMMY, FXChate___AIMP, GetRectCenterX(FXChate___AREC[self]), GetRectCenterY(FXChate___AREC[self]), 270)
        call SetUnitVertexColor(u, 255, 255, 255, 128)
        call KillUnit(u)
        call SetSoundPosition(gg_snd_HowlOfTerror, GetRectCenterX(FXChate___AREC[self]), GetRectCenterY(FXChate___AREC[self]), 300)
        call StartSound(gg_snd_HowlOfTerror)
        set u=null
        call s__splash_rect(s__splash_ANY , null , FXChate___AREC[self] , function FXChate___EnumSplash)
    endfunction
    
    function FXRD_FXChateCreate takes rect r returns integer
        local integer self= s__tick_create(0)
        set FXChate___OEXI[self]=true
        set FXChate___AREC[self]=r
        set FXChate___UDUM[self]=CreateUnit(FX_PLAYER_DUMMY, FXChate___ABMD, GetRectCenterX(r), GetRectCenterY(r), 270)
        call SetUnitColor(FXChate___UDUM[self], GetPlayerColor(Player(0)))
        call SetUnitVertexColor(FXChate___UDUM[self], 128, 128, 128, 128)
        call s__tick_start(self,3.00 , true , function FXChate___OnExpire)
        return self
    endfunction
    
    function FXRD_FXChateDestroy takes integer src returns nothing
        local integer self= src
        if not FXChate___OEXI[self] then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Fatal error: An attempt was made to destroy an FX_CHATE FXRD object that does not exist.")
            return
        endif
        call KillUnit(FXChate___UDUM[self])
        set FXChate___UDUM[self]=null
        set FXChate___AREC[self]=null
        set FXChate___OEXI[self]=false
        call s__tick_destroy(self)
    endfunction
    

