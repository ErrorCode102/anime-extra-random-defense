    function FXTrigTryGoldGacha___G10Gacha takes nothing returns nothing
        local player p= GetOwningPlayer(GetSellingUnit())
        local integer id= GetPlayerId(p)
        local integer amt= GetRandomInt(0, 100)
        if amt < 10 then
            call DisplayTimedTextToPlayer(p, 0, 0, 10, "|c00FFFF00" + I2S(amt) + "G obtained!|r What a loss...")
            call StartSoundForPlayerBJ(p, gg_snd_GACHA_GOLD_LOST)
        elseif amt == 10 then
            call DisplayTimedTextToPlayer(p, 0, 0, 10, "|c00FFFF00" + I2S(amt) + "G obtained!|r Yay!")
            call StartSoundForPlayerBJ(p, gg_snd_GACHA_GOLD_SAME)
        else
            call DisplayTimedTextToPlayer(p, 0, 0, 10, "|c00FFFF00" + I2S(amt) + "G obtained!|r")
            call StartSoundForPlayerBJ(p, gg_snd_GACHA_GOLD_GET)
        endif
        call AddPlayerGold(p , amt)
        set p=null
    endfunction
    
