    //API
    function s__EV123NeroBrideA_append takes unit src,integer mStk,real dmgexp returns nothing
        local integer this= s__EV123NeroBrideA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV123NeroBrideA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV123NeroBrideA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV123NeroBrideA_onSourceUnitRemove)
        set s__EV123NeroBrideA_myServant[this]=src
        set s__EV123NeroBrideA_atkStack[this]=0
        set s__EV123NeroBrideA_maxStack[this]=mStk
        set s__EV123NeroBrideA_dmgMtpl[this]=dmgexp
        call s__EVServantAttack_addFunction(src , function sc__EV123NeroBrideA_onSourceUnitAttack)
    endfunction
    
    function s__EV123NeroBrideA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if not DEAL_FLAG_LOGIC then
            //Melee Attack
            set this=s__EV123NeroBrideA_getThis(GetUnitUserData(src))
            set s__EV123NeroBrideA_atkStack[this]=s__EV123NeroBrideA_atkStack[this] + 1
            if s__EV123NeroBrideA_atkStack[this] == s__EV123NeroBrideA_maxStack[this] then
                call s__CMPhaks_cast(src , dst , s__EVDamageManager_getFinalDamage(src) * s__EV123NeroBrideA_dmgMtpl[this])
                set s__EV123NeroBrideA_atkStack[this]=0
            endif
        endif
        set src=null
        set dst=null
    endfunction
