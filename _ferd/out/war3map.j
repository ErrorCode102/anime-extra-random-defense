    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILMashuBBuff_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMashuBBuff_rmTrig[this], s__ABILMashuBBuff_rmAct[this])
        set s__ABILMashuBBuff_rmAct[this]=null
        set s__ABILMashuBBuff_rmTrig[this]=null
        call sc__ABILMashuBBuff_onAbilityLost(this)
        call s__tick_destroy(s__ABILMashuBBuff_durTik[this])
        set s__ABILMashuBBuff_source[this]=null
        set s__ABILMashuBBuff_exists[this]=false
    endfunction
    
    function s__ABILMashuBBuff_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMashuBBuff_free(this)
    endfunction
    
    function s__ABILMashuBBuff_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILMashuBBuff_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILMashuBBuff_source[this]) then
            return
        endif
        call sc__ABILMashuBBuff_onAbilityEffect(this)
        call s__tick_start(s__ABILMashuBBuff_durTik[this],s__ABILMashuBBuff_duration[this] , false , function s__ABILMashuBBuff_onExpire)
    endfunction
    
    function s__ABILMashuBBuff_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMashuBBuff_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMashuBBuff_exists[this] then
            set s__ABILMashuBBuff_exists[this]=true
            set s__ABILMashuBBuff_source[this]=src
            set s__ABILMashuBBuff_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMashuBBuff_rmAct[this]=TriggerAddAction(s__ABILMashuBBuff_rmTrig[this], function s__ABILMashuBBuff_OnSourceRemove)
            
            set s__ABILMashuBBuff_duration[this]=dur
            set s__ABILMashuBBuff_defaultDuration[this]=dur
            set s__ABILMashuBBuff_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILMashuBBuff_durTik[this],dur , false , function s__ABILMashuBBuff_onExpire)
            call sc__ABILMashuBBuff_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
    function s__ABILMashuBBuff_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__ABILMashuBBuff_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A09B') > 0 then
            if GetUnitAbilityLevel(GetEnumUnit(), 'A0D1') > 0 then
                return
            endif
        endif
        if GetUnitLevel(GetEnumUnit()) > s__ABILMashuBBuff_LEV then
            set s__ABILMashuBBuff_LEV=GetUnitLevel(GetEnumUnit())
            set s__ABILMashuBBuff_CNT=0
        endif
        if GetRandomInt(0, s__ABILMashuBBuff_CNT) == 0 then
            set s__ABILMashuBBuff_DEST=GetEnumUnit()
        endif
        set s__ABILMashuBBuff_CNT=s__ABILMashuBBuff_CNT + 1
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILMashuBBuff_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMashuBBuff_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMashuBBuff_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if IsUnitDead(s__ABILMashuBBuff_source[this]) then
            return
        endif
        if GetUnitState(s__ABILMashuBBuff_source[this], UNIT_STATE_MANA) < 10.00 then
            return
        endif
        set s__ABILMashuBBuff_DEST=null
        set s__ABILMashuBBuff_CNT=0
        set s__ABILMashuBBuff_LEV=0
        call s__splash_range(s__splash_ALLY , s__ABILMashuBBuff_source[this] , GetUnitX(s__ABILMashuBBuff_source[this]) , GetUnitY(s__ABILMashuBBuff_source[this]) , 800 , function s__ABILMashuBBuff_enumGetTarget)
        if s__ABILMashuBBuff_DEST != null then
            call SetUnitState(s__ABILMashuBBuff_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILMashuBBuff_source[this], UNIT_STATE_MANA) - 10.00)
            call FXRD_FXImmuneStunTimed(s__ABILMashuBBuff_DEST , 10.00)
            call FXRD_FXImmuneKnockbackTimed(s__ABILMashuBBuff_DEST , 10.00)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl", s__ABILMashuBBuff_DEST, "origin"))
        endif
        set s__ABILMashuBBuff_DEST=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　서번트 버프
//==================================================================
//textmacro instance: 버프_선언_개시("LordCamelot")
//end of: 버프_선언_개시("LordCamelot")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFLordCamelot_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFLordCamelot_exist[this] then
            set s__BUFFLordCamelot_exist[this]=true
            set s__BUFFLordCamelot_running[this]=false
            set s__BUFFLordCamelot_source[this]=src
            set s__BUFFLordCamelot_duration[this]=dur
            set s__BUFFLordCamelot_durationTimer[this]=s__tick_create(this)
            set s__BUFFLordCamelot_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFLordCamelot_rmAct[this]=TriggerAddAction(s__BUFFLordCamelot_rmTrig[this], function sc__BUFFLordCamelot_onSourceRemove)
        endif
        if s__BUFFLordCamelot_running[this] then
            if dur < s__tick__get_remaining(s__BUFFLordCamelot_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFLordCamelot_running[this]=true
            call sc__BUFFLordCamelot_onBuffStart(this)
        endif
        set s__BUFFLordCamelot_duration[this]=dur
        call sc__BUFFLordCamelot_onBuffRefresh(this)
        call s__tick_start(s__BUFFLordCamelot_durationTimer[this],s__BUFFLordCamelot_duration[this] , false , function sc__BUFFLordCamelot_onExpire)
    endfunction
    function s__BUFFLordCamelot_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFLordCamelot_running[this]=false
        call sc__BUFFLordCamelot_onBuffEnd(this)
    endfunction
    function s__BUFFLordCamelot_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFLordCamelot_rmTrig[this], s__BUFFLordCamelot_rmAct[this])
        set s__BUFFLordCamelot_rmAct[this]=null
        set s__BUFFLordCamelot_rmTrig[this]=null
        if s__BUFFLordCamelot_running[this] then
            set s__BUFFLordCamelot_running[this]=false
            call sc__BUFFLordCamelot_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFLordCamelot_durationTimer[this])
        set s__BUFFLordCamelot_source[this]=null
        set s__BUFFLordCamelot_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFLordCamelot_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFLordCamelot_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", s__BUFFLordCamelot_source[this], "chest")
        call UnitAddAbility(s__BUFFLordCamelot_source[this], s__BUFFLordCamelot_ABILITY)
        call sc__EVDamageManager_addBonus(s__BUFFLordCamelot_source[this] , s__BUFFLordCamelot_ATBO)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFLordCamelot_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFLordCamelot_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFLordCamelot_source[this]) then
            call sc__EVDamageManager_addBonus(s__BUFFLordCamelot_source[this] , - s__BUFFLordCamelot_ATBO)
            call UnitRemoveAbility(s__BUFFLordCamelot_source[this], s__BUFFLordCamelot_ABILITY)
            call UnitRemoveAbility(s__BUFFLordCamelot_source[this], s__BUFFLordCamelot_BUFF)
        endif
        call DestroyEffect(s__BUFFLordCamelot_fx[this])
        set s__BUFFLordCamelot_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
//end of: 버프_선언_끝()//===========================================================================
// Trigger: Servant LionKing
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("LIONKING","LK")
// scope SVLIONKING begins
//end of: 서번트_선언_개시("LIONKING","LK")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVLIONKING___OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call sc__TLLionKingMelee_apply(src)
            call DestroyEffect(AddSpecialEffectTarget("FX\\CrossGlowYellow\\glow" + I2S(GetRandomInt(1, 4)) + ".mdl", dst, "origin"))
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVLIONKING___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVLIONKING___OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVLIONKING___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVLIONKING___MeleeAttack)
            //Adding Special Skillz
            call sc__ABILLionKingCBeam_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0ED')
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVLIONKING___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVLIONKING___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVLIONKING___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVLIONKING___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("8","6840","Anylevel")
        set SVLIONKING___SERVANT_DAMAGE[8]=6840
        call s__eventServantAdd_register(SVLIONKING___SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVLIONKING___Anylevel)
//end of: 서번트_등록("8","6840","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVLIONKING ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("LionKingCBeam")
//end of: 어빌리티_선언_개시("LionKingCBeam")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0EE")
    
    function s__ABILLionKingCBeam_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILLionKingCBeam_onSpellEffect[this], s__ABILLionKingCBeam_onSpellEffectAction[this])
        set s__ABILLionKingCBeam_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILLionKingCBeam_onSpellEffect[this])
        set s__ABILLionKingCBeam_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILLionKingCBeam_rmTrig[this], s__ABILLionKingCBeam_rmAct[this])
        set s__ABILLionKingCBeam_rmAct[this]=null
        set s__ABILLionKingCBeam_rmTrig[this]=null
        call sc__ABILLionKingCBeam_onAbilityLost(this)
        set s__ABILLionKingCBeam_source[this]=null
        set s__ABILLionKingCBeam_exists[this]=false
    endfunction
    
    function s__ABILLionKingCBeam_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILLionKingCBeam_free(this)
    endfunction
    
    function s__ABILLionKingCBeam_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILLionKingCBeam_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILLionKingCBeam_exists[this] then
            set s__ABILLionKingCBeam_exists[this]=true
            set s__ABILLionKingCBeam_source[this]=src
            set s__ABILLionKingCBeam_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILLionKingCBeam_rmAct[this]=TriggerAddAction(s__ABILLionKingCBeam_rmTrig[this], function s__ABILLionKingCBeam_OnSourceRemove)
            set s__ABILLionKingCBeam_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILLionKingCBeam_onSpellEffect[this], Condition(function sc__ABILLionKingCBeam_conditionSpellEffect))
            set s__ABILLionKingCBeam_onSpellEffectAction[this]=TriggerAddAction(s__ABILLionKingCBeam_onSpellEffect[this], function sc__ABILLionKingCBeam_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILLionKingCBeam_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILLionKingCBeam_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILLionKingCBeam_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILLionKingCBeam_exists[this] then
            return
        endif
        call sc__ABILLionKingCBeam_onAbilityEffect(this)
    endfunction
    
    function s__ABILLionKingCBeam_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILLionKingCBeam_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0EE")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILLionKingCBeam_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILLionKingCBeam_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILLionKingCBeam_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call sc__BUFFLionKingBeam_apply(GetSpellTargetUnit() , s__ABILLionKingCBeam_source[this] , 1.0 , 10)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　서번트 버프
//==================================================================
//textmacro instance: 버프_선언_개시("LionKingBeam")
//end of: 버프_선언_개시("LionKingBeam")
    function s__BUFFLionKingBeam_enumDealt takes nothing returns nothing
        local integer this= s__BUFFLionKingBeam_ENUM
        call s__enemy_dealLogicEx(s__BUFFLionKingBeam_caster[this] , GetEnumUnit() , 100000.0 , true , true , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩됨()
    function s__BUFFLionKingBeam_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= s__tick_create(0)
        set s__BUFFLionKingBeam_source[this]=src
        set s__BUFFLionKingBeam_caster[this]=cas
        set s__BUFFLionKingBeam_duration[this]=dur
        set s__BUFFLionKingBeam_count[this]=cnt
        set s__BUFFLionKingBeam_durationTimer[this]=this
        call sc__BUFFLionKingBeam_onBuffStart(this)
        call s__tick_start(s__BUFFLionKingBeam_durationTimer[this],s__BUFFLionKingBeam_duration[this] , false , function sc__BUFFLionKingBeam_onExpire)
    endfunction
    function s__BUFFLionKingBeam_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__BUFFLionKingBeam_source[this]) then
            call sc__BUFFLionKingBeam_onBuffEnd(this)
            set s__BUFFLionKingBeam_source[this]=null
            set s__BUFFLionKingBeam_caster[this]=null
            call s__tick_destroy(s__BUFFLionKingBeam_durationTimer[this])
            return
        endif
        if s__BUFFLionKingBeam_count[this] > 0 then
            set s__BUFFLionKingBeam_count[this]=s__BUFFLionKingBeam_count[this] - 1
        endif
        call sc__BUFFLionKingBeam_onBuffEffect(this)
        if s__BUFFLionKingBeam_count[this] == 0 then
            call sc__BUFFLionKingBeam_onBuffEnd(this)
            set s__BUFFLionKingBeam_source[this]=null
            set s__BUFFLionKingBeam_caster[this]=null
            call s__tick_destroy(s__BUFFLionKingBeam_durationTimer[this])
            return
        endif
        call s__tick_start(s__BUFFLionKingBeam_durationTimer[this],s__BUFFLionKingBeam_duration[this] , false , function s__BUFFLionKingBeam_onExpire)
    endfunction
//end of: 버프_종류_반복적_중첩됨()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFLionKingBeam_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFLionKingBeam_fx[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o024', GetUnitX(s__BUFFLionKingBeam_source[this]), GetUnitY(s__BUFFLionKingBeam_source[this]), 45.0)
        call SetUnitAnimation(s__BUFFLionKingBeam_fx[this], "Birth")
        call s__TLDummyAnimation_apply(s__BUFFLionKingBeam_fx[this] , "Stand" , 0.867)
        call s__TLDummyFollow_apply(s__BUFFLionKingBeam_fx[this] , s__BUFFLionKingBeam_source[this] , 384.0)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFLionKingBeam_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        set s__BUFFLionKingBeam_ENUM=this
        call s__splash_range(s__splash_ENEMY , s__BUFFLionKingBeam_caster[this] , GetUnitX(s__BUFFLionKingBeam_fx[this]) , GetUnitY(s__BUFFLionKingBeam_fx[this]) , 350.0 , function s__BUFFLionKingBeam_enumDealt)
        set s__BUFFLionKingBeam_ENUM=0
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFLionKingBeam_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFLionKingBeam_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        call KillUnit(s__BUFFLionKingBeam_fx[this])
        set s__BUFFLionKingBeam_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()
//==================================================================
//　서번트 타임라인
//==================================================================
    function s__TLLionKingAttackMissle_onFinal takes integer this returns nothing
        call KillUnit(s__TLLionKingAttackMissle_myDummy[this])
        set s__TLLionKingAttackMissle_myDummy[this]=null
        set s__TLLionKingAttackMissle_caster[this]=null
        set s__TLLionKingAttackMissle_target[this]=null
        call s__tick_destroy(s__TLLionKingAttackMissle_main[this])
    endfunction
    function s__TLLionKingAttackMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang= s__Angle_WBP(s__TLLionKingAttackMissle_myDummy[this] , s__TLLionKingAttackMissle_TX[this] , s__TLLionKingAttackMissle_TY[this])
        call SetUnitFacing(s__TLLionKingAttackMissle_myDummy[this], ang)
        if not IsUnitType(s__TLLionKingAttackMissle_target[this], UNIT_TYPE_DEAD) and GetUnitTypeId(s__TLLionKingAttackMissle_target[this]) != 0 then
            set s__TLLionKingAttackMissle_TX[this]=GetUnitX(s__TLLionKingAttackMissle_target[this])
            set s__TLLionKingAttackMissle_TY[this]=GetUnitY(s__TLLionKingAttackMissle_target[this])
        endif
        if s__Distance_PBW(s__TLLionKingAttackMissle_TX[this] , s__TLLionKingAttackMissle_TY[this] , s__TLLionKingAttackMissle_myDummy[this]) > s__TLLionKingAttackMissle_mySpeed[this] then
            call SetUnitX(s__TLLionKingAttackMissle_myDummy[this], GetUnitX(s__TLLionKingAttackMissle_myDummy[this]) + s__Polar_X(s__TLLionKingAttackMissle_mySpeed[this] , ang))
            call SetUnitY(s__TLLionKingAttackMissle_myDummy[this], GetUnitY(s__TLLionKingAttackMissle_myDummy[this]) + s__Polar_Y(s__TLLionKingAttackMissle_mySpeed[this] , ang))
            return
        endif
        call SetUnitX(s__TLLionKingAttackMissle_myDummy[this], GetUnitX(s__TLLionKingAttackMissle_target[this]))
        call SetUnitY(s__TLLionKingAttackMissle_myDummy[this], GetUnitY(s__TLLionKingAttackMissle_target[this]))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", s__TLLionKingAttackMissle_TX[this], s__TLLionKingAttackMissle_TY[this]))
        call DestroyEffect(AddSpecialEffectTarget("FX\\CrossGlowYellow\\glow" + I2S(GetRandomInt(1, 4)) + ".mdl", s__TLLionKingAttackMissle_target[this], "origin"))
        if not IsUnitType(s__TLLionKingAttackMissle_target[this], UNIT_TYPE_GIANT) then
            call FXRD_FXDebuffShock(s__TLLionKingAttackMissle_target[this] , 1.0)
        endif
        call s__enemy_dealLogic(s__TLLionKingAttackMissle_caster[this] , s__TLLionKingAttackMissle_target[this] , s__TLLionKingAttackMissle_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        
        call s__TLLionKingAttackMissle_onFinal(this)
    endfunction
    function s__TLLionKingAttackMissle_apply takes unit src,unit dst,real ox,real oy,real x,real y,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_PBW(ox , oy , dst)
        set s__TLLionKingAttackMissle_caster[this]=src
        set s__TLLionKingAttackMissle_target[this]=dst
        set s__TLLionKingAttackMissle_damage[this]=dmg
        set s__TLLionKingAttackMissle_TX[this]=x
        set s__TLLionKingAttackMissle_TY[this]=y
        set s__TLLionKingAttackMissle_mySpeed[this]=128
        set s__TLLionKingAttackMissle_main[this]=this
        set s__TLLionKingAttackMissle_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o023', ox + s__Polar_X(64 , ang), oy + s__Polar_Y(64 , ang), ang)
        call SetUnitVertexColor(s__TLLionKingAttackMissle_myDummy[this], 255, 255, 255, 128)
        call s__tick_start(s__TLLionKingAttackMissle_main[this],0.03125 , true , function s__TLLionKingAttackMissle_onFire)
    endfunction

    // 사용자 정의 멤버
    function s__TLLionKingMelee_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__TLLionKingMelee_CNT) == 0 then
            set s__TLLionKingMelee_DEST=GetEnumUnit()
        endif
        set s__TLLionKingMelee_CNT=s__TLLionKingMelee_CNT + 1
    endfunction
    function s__TLLionKingMelee_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real x
        local real y
        local real tx
        local real ty
        local real dmg= sc__EVDamageManager_getFinalDamage(s__TLLionKingMelee_caster[this]) * 2.0
        set s__TLLionKingMelee_count[this]=s__TLLionKingMelee_count[this] - 1
        set s__TLLionKingMelee_DEST=null
        set s__TLLionKingMelee_CNT=0
        call s__splash_range(s__splash_ENEMY , s__TLLionKingMelee_caster[this] , GetUnitX(s__TLLionKingMelee_caster[this]) , GetUnitY(s__TLLionKingMelee_caster[this]) , GetUnitAcquireRange(s__TLLionKingMelee_caster[this]) , function s__TLLionKingMelee_enumGetTarget)
        if s__TLLionKingMelee_DEST != null then
            set x=GetUnitX(s__TLLionKingMelee_caster[this]) + GetRandomReal(- 256, 256)
            set y=GetUnitY(s__TLLionKingMelee_caster[this]) + GetRandomReal(- 256, 256)
            set tx=GetUnitX(s__TLLionKingMelee_DEST) + GetRandomReal(- 64, 64)
            set ty=GetUnitY(s__TLLionKingMelee_DEST) + GetRandomReal(- 64, 64)
            call s__TLLionKingAttackMissle_apply(s__TLLionKingMelee_caster[this] , s__TLLionKingMelee_DEST , x , y , tx , ty , dmg)
        endif
        set s__TLLionKingMelee_DEST=null
        if s__TLLionKingMelee_count[this] == 0 then
            set s__TLLionKingMelee_caster[this]=null
            call s__tick_destroy(s__TLLionKingMelee_main[this])
            return
        endif
    endfunction
    function s__TLLionKingMelee_apply takes unit src returns nothing
        local integer this= s__tick_create(0)
        set s__TLLionKingMelee_count[this]=4
        set s__TLLionKingMelee_caster[this]=src
        set s__TLLionKingMelee_main[this]=this
        call s__tick_start(s__TLLionKingMelee_main[this],0.10 , true , function s__TLLionKingMelee_onFire)
    endfunction
// Trigger: Servant Enkidu
