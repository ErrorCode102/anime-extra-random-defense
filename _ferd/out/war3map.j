    //API
    
    function s__EV147PendragonB_append takes unit src,real manareq,integer obid,string anim returns nothing
        local integer this= s__EV147PendragonB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV147PendragonB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV147PendragonB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV147PendragonB_onSourceUnitRemove)
        set s__EV147PendragonB_myServant[this]=src
        set s__EV147PendragonB_myId[this]=obid
        set s__EV147PendragonB_myAnim[this]=anim
        
        set s__EV147PendragonB_onManaCharge[this]=CreateTrigger()
        set s__EV147PendragonB_onManaChargeAction[this]=TriggerAddAction(s__EV147PendragonB_onManaCharge[this], function sc__EV147PendragonB_actionManaCharge)
        call TriggerRegisterUnitStateEvent(s__EV147PendragonB_onManaCharge[this], src, UNIT_STATE_MANA, GREATER_THAN_OR_EQUAL, manareq)
    endfunction
    
    //구현부
    
    function s__EV147PendragonB_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV147PendragonB_CNT) == 0 then
            set s__EV147PendragonB_DEST=GetEnumUnit()
        endif
        set s__EV147PendragonB_CNT=s__EV147PendragonB_CNT + 1
    endfunction
    
    function s__EV147PendragonB_afterManaCharge takes nothing returns nothing
        local integer t= s__tick_getExpired()
        local integer this= s__EV147PendragonB_getThis(s__tick_data[t])
        local real x= GetUnitX(s__EV147PendragonB_myServant[this]) + s__Polar_X(100 , GetUnitFacing(s__EV147PendragonB_myServant[this]))
        local real y= GetUnitY(s__EV147PendragonB_myServant[this]) + s__Polar_Y(100 , GetUnitFacing(s__EV147PendragonB_myServant[this]))
        call s__tick_destroy(t)
        set s__EV147PendragonB_DEST=null
        set s__EV147PendragonB_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV147PendragonB_myServant[this] , GetUnitX(s__EV147PendragonB_myServant[this]) , GetUnitY(s__EV147PendragonB_myServant[this]) , GetUnitAcquireRange(s__EV147PendragonB_myServant[this]) , function s__EV147PendragonB_enumGetTarget)
        if s__EV147PendragonB_DEST != null then
            set x=GetUnitX(s__EV147PendragonB_DEST)
            set y=GetUnitY(s__EV147PendragonB_DEST)
        endif
        set s__EV147PendragonB_DEST=null
        call s__CMExcal_cast(s__EV147PendragonB_myServant[this] , x , y , s__EVDamageManager_getFinalDamage(s__EV147PendragonB_myServant[this]) * 5.00 , s__EV147PendragonB_myId[this] , s__EV147PendragonB_myAnim[this])
    endfunction
    function s__EV147PendragonB_actionManaCharge takes nothing returns nothing
        local integer this= s__EV147PendragonB_getThis(GetUnitUserData(GetTriggerUnit()))
        call s__tick_start(s__tick_create(GetUnitUserData(GetTriggerUnit())),0.10 , false , function s__EV147PendragonB_afterManaCharge)
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, 0.00)
    endfunction
    function s__EV147PendragonB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV147PendragonB_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EV147PendragonB_onManaCharge[this], s__EV147PendragonB_onManaChargeAction[this])
        set s__EV147PendragonB_onManaChargeAction[this]=null
        call DestroyTrigger(s__EV147PendragonB_onManaCharge[this])
        set s__EV147PendragonB_onManaCharge[this]=null
        set s__EV147PendragonB_myServant[this]=null
        call TriggerUnbindAction(s__EV147PendragonB_onRemoveAction[this])
        set s__EV147PendragonB_onRemoveAction[this]=null
        //종결
        call s__EV147PendragonB_destroy(this)
    endfunction
    

