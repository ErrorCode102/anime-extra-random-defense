        function SVSAKURA__OnKingProtea takes nothing returns nothing
            //call EVServantAttack.addFunction( eventServantAdd.e, function SuperStomp )
            //
            call sc__ABILEXKingProteaAttack_append(s__eventServantAdd_e)
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call sc__ABILEXKingProteaGrowUpGrow_append(s__eventServantAdd_e , 1.0)
            //
            call SetUnitScale(s__eventServantAdd_e, 0.8, 0.8, 0.8)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
