        call s__UnitSelectEvent_Create('n01L' , function UIGameSettingModule__onToggleDiffButton)
        call s__UnitSelectEvent_Create('n01M' , function UIGameSettingModule__onToggleDiffButton)
        call s__UnitSelectEvent_Create('n01N' , function UIGameSettingModule__onToggleDiffButton)
        call s__UnitSelectEvent_Create('n01O' , function UIGameSettingModule__onToggleDiffButton)
        call s__UnitSelectEvent_Create('n01P' , function UIGameSettingModule__onToggleDiffButton)
        call s__UnitSelectEvent_Create('n01Q' , function UIGameSettingModule__onToggleDiffButton)
