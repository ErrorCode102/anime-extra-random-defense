// scope TrigFactionBBServant begins
    //=================================================
    function TrigFactionBBServant__BBGacha takes player p returns nothing
        local integer id= GetPlayerId(p)
        local integer amt= 10
        local integer stat= GetRandomInt(0, 2)
        
        if stat == 0 then
            call SetHeroInt(TrigFactionBBServant__SPECIAL_BB[id], GetHeroInt(TrigFactionBBServant__SPECIAL_BB[id], false) + amt, true)
            call DisplayTextToPlayer(p, 0.0, 0.0, "BB's |c004040FFIntelligence|r이 |c0080808010|r increases!")
            call s__bountyTag_custom(p , s__PosX__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) , s__PosY__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) + 64 , "|c004040FFIntelligence +" + I2S(amt) + "|r")
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIim\\AIimTarget.mdl", TrigFactionBBServant__SPECIAL_BB[id], "origin"))
        endif
        if stat == 1 then
            call SetHeroAgi(TrigFactionBBServant__SPECIAL_BB[id], GetHeroAgi(TrigFactionBBServant__SPECIAL_BB[id], false) + amt, true)
            call DisplayTextToPlayer(p, 0.0, 0.0, "BB's |c0040FF40Agility|r이 |c0080808010|r increases!")
            call s__bountyTag_custom(p , s__PosX__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) , s__PosY__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) + 64 , "|c0040FF40Agility +" + I2S(amt) + "|r")
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", TrigFactionBBServant__SPECIAL_BB[id], "origin"))
        endif
        if stat == 2 then
            call SetHeroStr(TrigFactionBBServant__SPECIAL_BB[id], GetHeroStr(TrigFactionBBServant__SPECIAL_BB[id], false) + amt, true)
            call DisplayTextToPlayer(p, 0.0, 0.0, "BB's |c00FF8000Strength|r이 |c0080808010|r increases!")
            call s__bountyTag_custom(p , s__PosX__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) , s__PosY__staticgetindex(TrigFactionBBServant__SPECIAL_BB[id]) + 64 , "|c00FF8000Strength +" + I2S(amt) + "|r")
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl", TrigFactionBBServant__SPECIAL_BB[id], "origin"))
        endif
    endfunction
    function TrigFactionBBServant__GiveBBXPBounty takes player p,unit vic returns nothing
        local real x= GetUnitX(vic)
        local real y= GetUnitY(vic)
        call s__bountyTag_custom(p , x , y + 64 , "|c00D0D0FF+1 BB XP|r")
        call AddHeroXP(TrigFactionBBServant__SPECIAL_BB[GetPlayerId(p)], 1, true)
    endfunction
    function TrigFactionBBServant__GiveBBServant takes player p returns nothing
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local unit u= CreateUnit(p, 'H014', x, y, 270.0)
        call s__servant_add(p , u , s__servant_QUIET)
        set TrigFactionBBServant__SPECIAL_BB[GetPlayerId(p)]=u
        call SetPlayerHandicapXP(p, 0.0)
        set u=null
    endfunction
    //=================================================
    function TrigFactionBBServant__OnBBGacha takes nothing returns nothing
        local player p= GetOwningPlayer(GetSellingUnit())
        
        call TrigFactionBBServant__BBGacha(p)
        set p=null
    endfunction
    function TrigFactionBBServant__OnLineMobDeath takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) != FX_FACTION_BB then
            return
        endif
        call TrigFactionBBServant__GiveBBXPBounty(s__eventCustom_getTriggerPlayer() , GetTriggerUnit())
    endfunction
    function TrigFactionBBServant__OnConvBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_BB then
            call TrigFactionBBServant__GiveBBServant(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    //=================================================
    function TrigFactionBBServant__main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_3 , function TrigFactionBBServant__OnConvBuilding)
        call s__eventCustom_addAction(EVENT_USER_LINEMOB_DEATH , function TrigFactionBBServant__OnLineMobDeath)
        call s__UnitSellEvent_Create('n01E' , function TrigFactionBBServant__OnBBGacha)
    endfunction
// scope TrigFactionBBServant ends
//===================================================
//      N명의 같은 유닛이 모이면 하나로 합체
//===================================================
// scope TrigFactionBBHoradricCube begins
    function TrigFactionBBHoradricCube__FusionFilter takes nothing returns boolean
        local integer id
        local integer lev
        local integer max
        if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) or GetFilterUnit() == null then
            return false
        endif
        if not IsUnitType(GetFilterUnit(), UNIT_TYPE_TAUREN) then
            return false
        endif
        if GetOwningPlayer(GetFilterUnit()) != TrigFactionBBHoradricCube__FUSION_PLAYER then
            return false
        endif
        set lev=GetUnitLevel(GetFilterUnit())
        if IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) then
            set lev=8
        endif
        if lev < 1 or lev > 5 then
            return false
        endif
        set id=GetPlayerId(TrigFactionBBHoradricCube__FUSION_PLAYER)
        set max=LoadInteger(TrigFactionBBHoradricCube__FUSION_TABLE, lev, - 1)
        call SaveUnitHandle(TrigFactionBBHoradricCube__FUSION_TABLE, lev, max, GetFilterUnit())
        call SaveInteger(TrigFactionBBHoradricCube__FUSION_TABLE, lev, - 1, max + 1)
        return false
    endfunction
    function TrigFactionBBHoradricCube__VoidFusion takes player p returns nothing
        local integer id= GetPlayerId(p)
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local integer result= 0
        local integer i
        local integer j
        local unit u
        set TrigFactionBBHoradricCube__FUSION_TABLE=InitHashtable()
        set TrigFactionBBHoradricCube__FUSION_PLAYER=p
        call GroupEnumUnitsInRange(TrigFactionBBHoradricCube__FUSION_GROUP, x, y, 512.0, TrigFactionBBHoradricCube__FUSION_FILTER)
        call GroupClear(TrigFactionBBHoradricCube__FUSION_GROUP)
        set TrigFactionBBHoradricCube__FUSION_PLAYER=null
        set i=5
        loop
            if LoadInteger(TrigFactionBBHoradricCube__FUSION_TABLE, i, - 1) >= TrigFactionBBHoradricCube__FUSION_COUNT then
                set result=i + 1
                set j=0
                loop
                    exitwhen j == TrigFactionBBHoradricCube__FUSION_COUNT
                    set u=LoadUnitHandle(TrigFactionBBHoradricCube__FUSION_TABLE, i, j)
                    call DestroyEffect(AddSpecialEffect("FX Kiburst\\FX Kiburst Blue.mdl", GetUnitX(u), GetUnitY(u)))
                    call s__servant_remove(p , u)
                    call KillUnit(u)
                    call ShowUnit(u, false)
                    set j=j + 1
                endloop
                set u=null
                exitwhen true
            endif
            exitwhen i == 1
            set i=i - 1
        endloop
        call FlushParentHashtable(TrigFactionBBHoradricCube__FUSION_TABLE)
        set TrigFactionBBHoradricCube__FUSION_TABLE=null
        if result == 0 then
            //call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)+1)
            call DisplayTimedTextToPlayer(p, 0.0, 0.0, 10.0, "|c00FF4040At least " + I2S(TrigFactionBBHoradricCube__FUSION_COUNT) + " units of equal grade must be placed on Fusion Zone.|r")
            return
        endif
        call DestroyEffect(AddSpecialEffect("FX\\ShadowAssault.mdl", x, y))
        set u=s__gacha_do(p , result , x , y , 270.0)
        call s__servant_add(p , u , s__servant_JOHAB)
        call SetUnitVertexColor(u, 32, 32, 32, 255)
        call UnitAddAbility(u, 'A0GM')
        call UnitAddAbility(u, 'A0GN')
        call sc__EVDamageManager_addBonus(u , 50)
        set u=null
    endfunction
    function TrigFactionBBHoradricCube__CheckFusion takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        if FXGetPlayerCurrentFaction(Player(id)) != FX_FACTION_BB then
            return
        endif
        call TrigFactionBBHoradricCube__VoidFusion(Player(id))
    endfunction
    function TrigFactionBBHoradricCube__SetFusionSystem takes player p returns nothing
        local integer id= GetPlayerId(p)
        local unit u= CreateUnit(p, 'n015', GetPlayerStartLocationX(p), GetPlayerStartLocationY(p), 270.0)
        set TrigFactionBBHoradricCube__FUSION_BUILDING[id]=u
        set u=null
        //set FUSION_TIMER[id] = CreateTimer()
        //call TimerStart(FUSION_TIMER[id],1.0,true,function CheckFusion)
    endfunction
    function TrigFactionBBHoradricCube__OnConvBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_BB then
            call TrigFactionBBHoradricCube__SetFusionSystem(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    //=================================================
    function TrigFactionBBHoradricCube__main takes nothing returns nothing
        set TrigFactionBBHoradricCube__FUSION_FILTER=Filter(function TrigFactionBBHoradricCube__FusionFilter)
        call s__AbilityEffectEvent_Create('A0GL' , function TrigFactionBBHoradricCube__CheckFusion)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_3 , function TrigFactionBBHoradricCube__OnConvBuilding)
    endfunction
// scope TrigFactionBBHoradricCube ends
//===================================================
//      N명의 지정된 A급 서번트를 모으면 EX급 해금
//===================================================
// scope TrigFactionBBUnlock begins
    function TrigFactionBBUnlock__CheckReqUnit takes player p returns boolean
        local integer pid= s__PlayerId__staticgetindex(p)
        local integer size= TrigFactionBBUnlock__REQ_SIZE[pid]
        local integer i= 0
        local integer typ
        local integer have
        local integer max
        local integer ins
        local boolean result= true
        loop
            exitwhen i == size
            set typ=TrigFactionBBUnlock__REQ_TYPE[pid * TrigFactionBBUnlock__MAX_REQUIRED + i]
            set have=GetPlayerUnitTypeCount(p, typ)
            set max=TrigFactionBBUnlock__REQ_COUNT[pid * TrigFactionBBUnlock__MAX_REQUIRED + i]
            set ins=max - have
            if ins > 0 then
                call DisplayTextToPlayer(p, 0.0, 0.0, "|cffff4040" + s__trimmer_get(typ) + " " + I2S(ins) + " lacking!|r")
                set result=false
            endif
            set i=i + 1
        endloop
        return result
    endfunction
    function TrigFactionBBUnlock__AddReqUnit takes player p,integer id returns nothing
        local integer pid= s__PlayerId__staticgetindex(p)
        local integer size= TrigFactionBBUnlock__REQ_SIZE[pid]
        if HaveSavedInteger(TrigFactionBBUnlock__REQ_TABLE, pid, id) then
            set size=LoadInteger(TrigFactionBBUnlock__REQ_TABLE, pid, id)
            set TrigFactionBBUnlock__REQ_COUNT[pid * TrigFactionBBUnlock__MAX_REQUIRED + size]=TrigFactionBBUnlock__REQ_COUNT[pid * TrigFactionBBUnlock__MAX_REQUIRED + size] + 1
        else
            set TrigFactionBBUnlock__REQ_TYPE[pid * TrigFactionBBUnlock__MAX_REQUIRED + size]=id
            set TrigFactionBBUnlock__REQ_COUNT[pid * TrigFactionBBUnlock__MAX_REQUIRED + size]=1
            call SaveInteger(TrigFactionBBUnlock__REQ_TABLE, pid, id, size)
            set TrigFactionBBUnlock__REQ_SIZE[pid]=size + 1
        endif
    endfunction
    function TrigFactionBBUnlock__GenRandomEXClass takes player p returns nothing
        local integer pid= s__PlayerId__staticgetindex(p)
        local real x= s__StartLocationX__staticgetindex(p)
        local real y= s__StartLocationY__staticgetindex(p)
        local unit u= s__gacha_do(FX_PLAYER_DUMMY , 7 , x , y , 270.0)
        call UnitAddAbility(u, 'Aloc')
        call UnitAddAbility(u, 'Apiv')
        set TrigFactionBBUnlock__RESULT_UNIT[pid]=u
        set u=null
    endfunction
    function TrigFactionBBUnlock__GenRandomAClasses takes player p returns nothing
        local integer pid= s__PlayerId__staticgetindex(p)
        local integer i= 0
        local real angle= 270.0
        local real x= s__StartLocationX__staticgetindex(p)
        local real y= s__StartLocationY__staticgetindex(p)
        local unit u
        loop
            exitwhen i == TrigFactionBBUnlock__MAX_REQUIRED
            set u=s__gacha_do(FX_PLAYER_DUMMY , 5 , x + 384.0 * Cos(angle * bj_DEGTORAD) , y + 384.0 * Sin(angle * bj_DEGTORAD) , 270.0)
            call UnitAddAbility(u, 'Aloc')
            call UnitAddAbility(u, 'Apiv')
            set TrigFactionBBUnlock__REQUIRED_UNIT[pid * TrigFactionBBUnlock__MAX_REQUIRED + i]=u
            call TrigFactionBBUnlock__AddReqUnit(p , s__UnitId__staticgetindex(u))
            set angle=angle + ( 360.0 / TrigFactionBBUnlock__MAX_REQUIRED )
            set i=i + 1
        endloop
        set u=null
    endfunction
    function TrigFactionBBUnlock__UnlockBBServant takes player p returns nothing
        local integer pid= s__PlayerId__staticgetindex(p)
        local integer i= 0
        local real x= s__StartLocationX__staticgetindex(p)
        local real y= s__StartLocationY__staticgetindex(p)
        local unit u
        loop
            exitwhen i == TrigFactionBBUnlock__MAX_REQUIRED
            call ShowUnit(TrigFactionBBUnlock__REQUIRED_UNIT[pid * TrigFactionBBUnlock__MAX_REQUIRED + i], false)
            call KillUnit(TrigFactionBBUnlock__REQUIRED_UNIT[pid * TrigFactionBBUnlock__MAX_REQUIRED + i])
            set TrigFactionBBUnlock__REQUIRED_UNIT[pid * TrigFactionBBUnlock__MAX_REQUIRED + i]=null
            set i=i + 1
        endloop
        set u=CreateUnit(p, s__UnitId__staticgetindex(TrigFactionBBUnlock__RESULT_UNIT[pid]), x, y, 270.0)
        call s__servant_add(p , u , s__servant_BOUNTY)
        
        set u=null
        call ShowUnit(TrigFactionBBUnlock__RESULT_UNIT[pid], false)
        call KillUnit(TrigFactionBBUnlock__RESULT_UNIT[pid])
        set TrigFactionBBUnlock__RESULT_UNIT[pid]=null
    endfunction
    
    function TrigFactionBBUnlock__OnCheckUnlock takes nothing returns nothing
        local integer id= s__OwnerId__staticgetindex(GetTriggerUnit())
        if FXGetPlayerCurrentFaction(s__ToPlayer__staticgetindex(id)) != FX_FACTION_BB then
            return
        endif
        if TrigFactionBBUnlock__UNLOCKED[id] then
            return
        endif
        if not TrigFactionBBUnlock__CheckReqUnit(s__ToPlayer__staticgetindex(id)) then
            call DisplayTextToPlayer(s__ToPlayer__staticgetindex(id), 0.0, 0.0, "Expected to be acquired: " + s__trimmer_get(s__UnitId__staticgetindex(TrigFactionBBUnlock__RESULT_UNIT[id])) + "|r")
            call StartSoundForPlayerBJ(s__ToPlayer__staticgetindex(id), gg_snd_Error)
            return
        endif
        set TrigFactionBBUnlock__UNLOCKED[id]=true
        call StartSoundForPlayerBJ(s__ToPlayer__staticgetindex(id), gg_snd_gacha_rare)
        call UnitRemoveAbility(GetTriggerUnit(), 'A0GX')
        call TrigFactionBBUnlock__UnlockBBServant(s__ToPlayer__staticgetindex(id))
    endfunction
    function TrigFactionBBUnlock__OnConvBuilding takes nothing returns nothing
        local integer pid= GetPlayerId(s__eventCustom_getTriggerPlayer())
        if FXGetPlayerCurrentFaction(s__ToPlayer__staticgetindex(pid)) != FX_FACTION_BB then
            return
        endif
        // 플레이어가 죽었다면 아무것도 하지 않습니다
        if not USER_IS_PLAYING[pid] then
            return
        endif
        call TrigFactionBBUnlock__GenRandomEXClass(s__ToPlayer__staticgetindex(pid))
        call TrigFactionBBUnlock__GenRandomAClasses(s__ToPlayer__staticgetindex(pid))
    endfunction
    
    function TrigFactionBBUnlock__main takes nothing returns nothing
        call s__AbilityEffectEvent_Create('A0GX' , function TrigFactionBBUnlock__OnCheckUnlock)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_3 , function TrigFactionBBUnlock__OnConvBuilding)
    endfunction
// scope TrigFactionBBUnlock ends
