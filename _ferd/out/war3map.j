        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    //=================================================
    function TrigFactionAlteraBatchBuilding__OnSkillBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_ALTERA then
            call TrigFactionAlteraBatchBuilding__CreateSkillBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    function TrigFactionAlteraBatchBuilding__OnUpgradeBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_ALTERA then
            call TrigFactionAlteraBatchBuilding__CreateUpgradeBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
