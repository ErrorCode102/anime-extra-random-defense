    function FXTrigIngameCommand___togglePingWarn takes player p returns nothing
        local integer id= GetPlayerId(p)
        set USER_USE_WARNPING[id]=not USER_USE_WARNPING[id]
        if USER_USE_WARNPING[id] then
            call DisplayTimedTextToPlayer(p, 0, 0, 5.00, "|c00FF8000Lives Alert Ping |c0080FF80ON|r")
        else
            call DisplayTimedTextToPlayer(p, 0, 0, 5.00, "|c00FF8000Lives Alert Ping |c00FF0000OFF|r")
        endif
    endfunction

    function FXTrigIngameCommand___onChat takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if not GAME_IS_PLAYING then
            return
        endif
        if not USER_IS_PLAYING[id] then
            return
        endif
        if GetEventPlayerChatString() == "-PING" then
            call FXTrigIngameCommand___togglePingWarn(GetTriggerPlayer())
        endif
        if GetEventPlayerChatString() == "-VLD" then
            call FXTrigIngameCommand___togglePingWarn(GetTriggerPlayer())
        endif
        if GetEventPlayerChatString() == "-ping" then
            call FXTrigIngameCommand___togglePingWarn(GetTriggerPlayer())
        endif
        if GetEventPlayerChatString() == "-vld" then
            call FXTrigIngameCommand___togglePingWarn(GetTriggerPlayer())
        endif
        if GetEventPlayerChatString() == "-핑" then
            call FXTrigIngameCommand___togglePingWarn(GetTriggerPlayer())
        endif
    endfunction

    function FXTrigIngameCommand___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterPlayerChatEvent(t, Player(0), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(1), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(2), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(3), "", true)
        call TriggerAddAction(t, function FXTrigIngameCommand___onChat)
        set t=null
    endfunction
// scope FXTrigIngameCommand ends
