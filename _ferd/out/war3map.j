    function FXImmuneKnockback___Free takes integer self returns nothing
        call s__tick_destroy(FXImmuneKnockback___FX_TICK[self])
        call TriggerRemoveAction(FXImmuneKnockback___FX_REMOVETRIG[self], FXImmuneKnockback___FX_REMOVEACTION[self])
        set FXImmuneKnockback___FX_REMOVEACTION[self]=null
        set FXImmuneKnockback___FX_REMOVETRIG[self]=null
        set FXImmuneKnockback___FX_SOURCE[self]=null
        set FXImmuneKnockback___FX_TIMMED[self]=false
        set FXImmuneKnockback___FX_ALWAYS[self]=false
        set FXImmuneKnockback___FX_EXISTS[self]=false
    endfunction
    
    function FXImmuneKnockback___OnRemove takes nothing returns nothing
        local integer self= GetTriggerIndex()
        call FXImmuneKnockback___Free(self)
    endfunction
    
    function FXImmuneKnockback___Allocate takes integer self,unit src returns nothing
        set FXImmuneKnockback___FX_EXISTS[self]=true
        set FXImmuneKnockback___FX_ALWAYS[self]=false
        set FXImmuneKnockback___FX_TIMMED[self]=false
        set FXImmuneKnockback___FX_SOURCE[self]=src
        set FXImmuneKnockback___FX_REMOVETRIG[self]=GetUnitRemoveTrigger(src)
        set FXImmuneKnockback___FX_REMOVEACTION[self]=TriggerAddAction(FXImmuneKnockback___FX_REMOVETRIG[self], function FXImmuneKnockback___OnRemove)
        set FXImmuneKnockback___FX_TICK[self]=s__tick_create(self)
    endfunction
    
    function FXImmuneKnockback___OnExpire takes nothing returns nothing
        local integer self= s__tick_data[s__tick_getExpired()]
        set FXImmuneKnockback___FX_TIMMED[self]=false
        if FXImmuneKnockback___FX_ALWAYS[self] then
            return
        endif
        call UnitRemoveAbility(FXImmuneKnockback___FX_SOURCE[self], FXImmuneKnockback___ID_IMMUNE)
        call UnitRemoveAbility(FXImmuneKnockback___FX_SOURCE[self], FXImmuneKnockback___BUFF_IMMUNE)
    endfunction
    
    function FXRD_FXImmuneKnockback takes unit src,boolean flag returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneKnockback___FX_EXISTS[self] then
            call FXImmuneKnockback___Allocate(self , src)
        endif
        set FXImmuneKnockback___FX_ALWAYS[self]=flag
        //
        if flag then
            if GetUnitAbilityLevel(src, FXImmuneKnockback___ID_IMMUNE) == 0 then
                call UnitAddAbility(src, FXImmuneKnockback___ID_IMMUNE)
            endif
            return
        endif
        //
        if not FXImmuneKnockback___FX_TIMMED[self] then
            call UnitRemoveAbility(src, FXImmuneKnockback___ID_IMMUNE)
            call UnitRemoveAbility(src, FXImmuneKnockback___BUFF_IMMUNE)
        endif
    endfunction
    
    function FXRD_FXImmuneKnockbackForced takes unit src,boolean flag returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneKnockback___FX_EXISTS[self] then
            call FXImmuneKnockback___Allocate(self , src)
        endif
        set FXImmuneKnockback___FX_ALWAYS[self]=flag
        //Forcing over tick control
        if FXImmuneKnockback___FX_TIMMED[self] then
            set FXImmuneKnockback___FX_TIMMED[self]=false
            call s__tick_pause(FXImmuneKnockback___FX_TICK[self])
        endif
        //
        if flag then
            if GetUnitAbilityLevel(src, FXImmuneKnockback___ID_IMMUNE) == 0 then
                call UnitAddAbility(src, FXImmuneKnockback___ID_IMMUNE)
            endif
            return
        endif
        //
        call UnitRemoveAbility(src, FXImmuneKnockback___ID_IMMUNE)
        call UnitRemoveAbility(src, FXImmuneKnockback___BUFF_IMMUNE)
    endfunction
    
    function FXRD_FXImmuneKnockbackTimed takes unit src,real delay returns nothing
        local integer self
        if GetUnitTypeId(src) == 0 then
            return
        endif
        set self=IndexUnit(src)
        if not FXImmuneKnockback___FX_EXISTS[self] then
            call FXImmuneKnockback___Allocate(self , src)
        endif
        //
        if GetUnitAbilityLevel(src, FXImmuneKnockback___ID_IMMUNE) == 0 then
            call UnitAddAbility(src, FXImmuneKnockback___ID_IMMUNE)
        endif
        //
        if FXImmuneKnockback___FX_TIMMED[self] then
            if s__tick__get_remaining(FXImmuneKnockback___FX_TICK[self]) >= delay then
                return
            endif
        endif
        set FXImmuneKnockback___FX_TIMMED[self]=true
        call s__tick_start(FXImmuneKnockback___FX_TICK[self],delay , false , function FXImmuneKnockback___OnExpire)
    endfunction
    
    function FXRD_FXIsImmuneKnockback takes unit src returns boolean
        return GetUnitAbilityLevel(src, FXImmuneKnockback___ID_IMMUNE) > 0
    endfunction
    

