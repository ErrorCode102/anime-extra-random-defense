    endfunction
    function s__CMArmisticeSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMArmisticeSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMArmisticeSingle_myDummy[this], "overhead"))
        else
            //call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl",.target,"chest"))
            call s__enemy_dealLogic(s__CMArmisticeSingle_caster[this] , s__CMArmisticeSingle_target[this] , s__CMArmisticeSingle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMArmisticeSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMArmisticeSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMArmisticeSingle_main[this],0.20 , false , function s__CMArmisticeSingle_onFinal)
    endfunction
    function s__CMArmisticeSingle_cast takes unit src,unit dst,real dmg,real x,real y returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_PBW(x , y , dst)
        set s__CMArmisticeSingle_caster[this]=src
        set s__CMArmisticeSingle_target[this]=dst
        set s__CMArmisticeSingle_damage[this]=dmg
        set s__CMArmisticeSingle_main[this]=this
        set s__CMArmisticeSingle_myDummy[this]=CreateUnit(Player(15), 'o00F', GetUnitX(dst) + s__Polar_X(200 , ang - 180), GetUnitY(dst) + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMArmisticeSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMArmisticeSingle_myDummy[this], "attack")
        call SetUnitTimeScale(s__CMArmisticeSingle_myDummy[this], 1.20)
        call s__tick_start(s__CMArmisticeSingle_main[this],0.40 , true , function s__CMArmisticeSingle_onFire)
    endfunction

    function s__CMArmistice_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMArmistice_loops[this] < 1 or IsUnitType(s__CMArmistice_caster[this], UNIT_TYPE_DEAD) or IsUnitType(s__CMArmistice_target[this], UNIT_TYPE_DEAD) then
            set s__CMArmistice_caster[this]=null
            set s__CMArmistice_target[this]=null
            call s__tick_destroy(s__CMArmistice_main[this])
            return
        endif
        call s__CMArmisticeSingle_cast(s__CMArmistice_caster[this] , s__CMArmistice_target[this] , s__CMArmistice_damage[this] , s__CMArmistice_ox[this] , s__CMArmistice_oy[this])
        set s__CMArmistice_ox[this]=GetUnitX(s__CMArmistice_target[this])
        set s__CMArmistice_oy[this]=GetUnitY(s__CMArmistice_target[this])
        set s__CMArmistice_loops[this]=s__CMArmistice_loops[this] - 1
    endfunction
    function s__CMArmistice_cast takes unit src,unit dst,real dmg,integer cmb returns nothing
        local integer this= s__tick_create(0)
        set s__CMArmistice_caster[this]=src
        set s__CMArmistice_target[this]=dst
        set s__CMArmistice_damage[this]=dmg
        set s__CMArmistice_loops[this]=cmb
        set s__CMArmistice_ox[this]=GetUnitX(dst)
        set s__CMArmistice_oy[this]=GetUnitY(dst)
        set s__CMArmistice_main[this]=this
        call s__tick_start(s__CMArmistice_main[this],0.40 , true , function s__CMArmistice_onFireStart)
    endfunction
