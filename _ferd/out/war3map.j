// Trigger: Trig Sell Servant When Enter Sell Zone
//===========================================================================
// scope TrigSellServantWhenEnterSellZone begins
    function TrigSellServantWhenEnterSellZone___ActionFunc takes nothing returns nothing
        local integer lv= GetUnitLevel(GetEnteringUnit())
        local integer sellSetting= FXGetPlayerServantSellSetting(GetOwningPlayer(GetEnteringUnit()))
        if IsUnitType(GetEnteringUnit(), UNIT_TYPE_HERO) then
            set lv=8
        endif
        if sellSetting == 0 then
            return
        elseif sellSetting == 1 then
            if lv > 3 then
                return
            endif
        elseif sellSetting == 2 then
            if lv > 5 then
                return
            endif
        endif
        call IssueImmediateOrder(GetEnteringUnit(), "neutralinteract")
    endfunction
    function TrigSellServantWhenEnterSellZone___CondFunc takes nothing returns boolean
        return IsUnitType(GetEnteringUnit(), UNIT_TYPE_TAUREN)
    endfunction
    function TrigSellServantWhenEnterSellZone___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        local region rectRegion= CreateRegion()
        call RegionAddRect(rectRegion, gg_rct_SELLPOINT1)
        call RegionAddRect(rectRegion, gg_rct_SELLPOINT2)
        call RegionAddRect(rectRegion, gg_rct_SELLPOINT3)
        call RegionAddRect(rectRegion, gg_rct_SELLPOINT4)
        call TriggerRegisterEnterRegion(t, rectRegion, null)
        call TriggerAddCondition(t, Condition(function TrigSellServantWhenEnterSellZone___CondFunc))
        call TriggerAddAction(t, function TrigSellServantWhenEnterSellZone___ActionFunc)
    endfunction
// scope TrigSellServantWhenEnterSellZone ends
// Trigger: CONT Terrain
//===========================================================================
// Trigger: CONT Panalty
//===========================================================================
//===================================================
//      패널티 - 난수 간섭
//          조합 결과가  동급의 무작위 서번트로 변경됩니다.
//===================================================
// scope TrigPanaltyRandomJohab begins
    function TrigPanaltyRandomJohab___RandomizeJohab takes unit src returns nothing
        local player p= GetOwningPlayer(src)
        local real x= GetUnitX(src)
        local real y= GetUnitY(src)
        local integer lev= GetUnitLevel(src)
        local unit u
        if lev < 4 then
            call DisplayTextToPlayer(p, 0.00, 0.00, "Tried to acquire " + s__trimmer_get(GetUnitTypeId(src)) + " in combination, but...")
        else
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, s__pcs_get(p) + "|r tried to acquire " + s__trimmer_get(GetUnitTypeId(src)) + " Servant in combination...")
        endif
        call ShowUnit(src, false)
        call KillUnit(src)
        call DestroyEffect(AddSpecialEffect("FX\\Kiara\\Burst.mdl", x, y))
        call s__bountyTag_custom(p , x , y , "|c00FF0000『RNG Interference』|r")
        set u=s__gacha_do(p , lev , x , y , 270.00)
        call s__servant_add(p , u , s__servant_JOHAB)
        call DestroyEffect(AddSpecialEffect("FX\\johabTarget.mdl", GetUnitX(u), GetUnitY(u)))
        set p=null
        set u=null
    endfunction
    function TrigPanaltyRandomJohab___OnBeforeJohab takes nothing returns nothing
        if not GetPanalty(PANALTY_JOHAB_BECOME_RANDOM) then
            return
        endif
        if FXGetJohabFlag(JOHAB_FLAG_NO_INTERRUPT) then
            return
        endif
        if GetRandomReal(0.0, 100.0) > 30.0 then
            return
        endif
        //이 패널티는 기존 조합을 취소시킵니다.
        call FXAbortJohab()
        call TrigPanaltyRandomJohab___RandomizeJohab(FXGetJohabUnit())
    endfunction
    function TrigPanaltyRandomJohab___main takes nothing returns nothing
        call FXActionRegisterUnitBeforeJohabEvent(function TrigPanaltyRandomJohab___OnBeforeJohab)
    endfunction
// scope TrigPanaltyRandomJohab ends
//===================================================
//      패널티 - 후폭풍
//          보스가 사망하며 10초 스턴
//===================================================
// scope TrigPanaltyAftermath begins
    function TrigPanaltyAftermath___OnEnum takes nothing returns nothing
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 10.0)
        if s__Distance_WBW(GetEnumUnit() , GetTriggerUnit()) > 1000 then
            return
        endif
        call FXRD_FXKnockbackFromTo(GetEnumUnit() , GetTriggerUnit() , 1000 , 250 , 0.625)
    endfunction
    function TrigPanaltyAftermath___OnAction takes nothing returns nothing
        if not IsUnitType(GetTriggerUnit(), UNIT_TYPE_GIANT) then
            return
        endif
        if not GetPanalty(PANALTY_AFTER_IMPACT) then
            return
        endif
        call CreateDummy('o002' , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , 0.00 , 270 , 3.00 , 255 , 255 , 255 , 255)
        if GetOwningPlayer(GetTriggerUnit()) == Player(11) then
            //StunAll 10s
            call s__splash_rect(s__splash_ANY , GetKillingUnit() , bj_mapInitialPlayableArea , function TrigPanaltyAftermath___OnEnum)
        else
            //StunPlayer - 4
            call s__splash_rect(s__splash_PLAYER , GetKillingUnit() , bj_mapInitialPlayableArea , function TrigPanaltyAftermath___OnEnum)
        endif
    endfunction
    function TrigPanaltyAftermath___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function TrigPanaltyAftermath___OnAction)
        call TriggerRegisterPlayerUnitEvent(t, Player(4), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(5), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(6), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(7), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, FX_PLAYER_ENEMY, EVENT_PLAYER_UNIT_DEATH, null)
        set t=null
    endfunction
// scope TrigPanaltyAftermath ends
//===================================================
//      패널티 - 후유증
//          1킬 = 1초 스턴
//===================================================
// scope TrigPanaltyRevenge begins
    function TrigPanaltyRevenge___OnAction takes nothing returns nothing
        if GetKillingUnit() == null then
            return
        endif
        if not IsUnitType(GetKillingUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if not GetPanalty(PANALTY_SERVANT_STUN) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl", GetKillingUnit(), "chest"))
        call sc__EVDebuffStunServant_apply(GetKillingUnit() , 1.00)
    endfunction
    function TrigPanaltyRevenge___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function TrigPanaltyRevenge___OnAction)
        call TriggerRegisterPlayerUnitEvent(t, Player(4), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(5), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(6), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(7), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, FX_PLAYER_ENEMY, EVENT_PLAYER_UNIT_DEATH, null)
        set t=null
    endfunction
// scope TrigPanaltyRevenge ends
//===================================================
//      패널티 - 서번트 오염됨
//          모든 서번트가 50%만큼 느려집니다.
//===================================================
// scope TrigPanaltyCorrupt begins

    function TrigPanaltyCorrupt___OnAction takes nothing returns nothing
        local unit self
        //FXRD 패널티 - (서번트 오염됨) 패널티 사용 중이 아니라면, 즉시 종료합니다.
        if not GetPanalty(PANALTY_SERVANT_CORRUPT) then
            return
        endif
        set self=s__eventServantAdd_e
        //유닛 - (추가된 서번트)에게 (오염 패널티 능력)을 추가합니다.
        call UnitAddAbility(self, TrigPanaltyCorrupt___ABID)
        //포상 텍스트 - (추가된 서번트의 소유주)에게 (오염 알림)텍스트를 표시합니다 : (추가된 서번트의 좌표)
        call s__bountyTag_custom(s__eventServantAdd_ep , GetUnitX(self) , GetUnitY(self) , TrigPanaltyCorrupt___ATAS)
        set self=null
    endfunction

    function TrigPanaltyCorrupt___main takes nothing returns nothing
        //이벤트 - (종류에 관계없이) 서번트가 추가되면 발동합니다.
        call s__eventServantAdd_register(0 , function TrigPanaltyCorrupt___OnAction)
    endfunction
// scope TrigPanaltyCorrupt ends
//===================================================
//      패널티 - 허수 정지장
//          인접한 모든 서번트를 멈추는 허수 정지장을 소환합니다.
//===================================================
// scope TrigPanaltyStasis begins
    function TrigPanaltyStasis___CreateStasisOnPlayerField takes player p,real x,real y returns nothing
        set x=GetPlayerStartLocationX(p) + x
        set y=GetPlayerStartLocationY(p) + y
        call FXRD_FXStasisField(x , y , 3 , 10)
    endfunction
    
    function TrigPanaltyStasis___OnCast takes nothing returns nothing
        local integer i= 0
        if not GetPanalty(PANALTY_SUMMON_STASIS) then
            call DestroyTimer(GetExpiredTimer())
            return
        endif
        call TimerStart(GetExpiredTimer(), 20.00, false, function TrigPanaltyStasis___OnCast)
        if not GAME_IS_PLAYING then
            return
        endif
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                call TrigPanaltyStasis___CreateStasisOnPlayerField(Player(i) , GetRandomReal(- 960, 960) , GetRandomReal(- 960, 960))
                call TrigPanaltyStasis___CreateStasisOnPlayerField(Player(i) , GetRandomReal(- 960, 960) , GetRandomReal(- 960, 960))
            endif
            set i=i + 1
        endloop
        
    endfunction
    
    function TrigPanaltyStasis___OnAction takes nothing returns nothing
        call TimerStart(CreateTimer(), 10.00, false, function TrigPanaltyStasis___OnCast)
    endfunction
    
    function TrigPanaltyStasis___main takes nothing returns nothing
        //게임 초기화 시 발동합니다.
        call s__eventCustom_addAction(EVENT_GAME_INIT , function TrigPanaltyStasis___OnAction)
    endfunction
// scope TrigPanaltyStasis ends
//===================================================
//      패널티 - 전뇌 폭풍
//          인접한 모든 서번트를 튕겨내는 전뇌 폭풍을 소환합니다.
//===================================================
// scope TrigPanaltyTyphoon begins
    
    function TrigPanaltyTyphoon___OnExpire takes nothing returns nothing
        local integer t= s__tick_getExpired()
        if USER_IS_PLAYING[TrigPanaltyTyphoon___POWN[t]] then
            return
        endif
        if ( TrigPanaltyTyphoon___POWN[t] == 11 ) and GAME_IS_PLAYING then
            return
        endif
        call FXRD_FXTyphoonDestroy(TrigPanaltyTyphoon___PATY1[t])
        call FXRD_FXTyphoonDestroy(TrigPanaltyTyphoon___PATY2[t])
        call s__tick_destroy(t)
    endfunction
    
    function TrigPanaltyTyphoon___CreateStorm takes player p returns nothing
        local integer t= s__tick_create(0)
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        set TrigPanaltyTyphoon___POWN[t]=GetPlayerId(p)
        set TrigPanaltyTyphoon___PATY1[t]=FXRD_FXTyphoonCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
        set TrigPanaltyTyphoon___PATY2[t]=FXRD_FXTyphoonCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
        call s__tick_start(t,1.00 , true , function TrigPanaltyTyphoon___OnExpire)
    endfunction
    
    function TrigPanaltyTyphoon___StartPanalty takes nothing returns nothing
        local integer i= 0
        if not GAME_IS_PLAYING then
            return
        endif
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                call TrigPanaltyTyphoon___CreateStorm(Player(i))
            endif
            set i=i + 1
        endloop
        
    endfunction
    
    function TrigPanaltyTyphoon___OnCast takes nothing returns nothing
        call DestroyTimer(GetExpiredTimer())
        if not GetPanalty(PANALTY_SUMMON_STORM) then
            return
        endif
        call TrigPanaltyTyphoon___StartPanalty()
    endfunction
    
    function TrigPanaltyTyphoon___OnAction takes nothing returns nothing
        call TimerStart(CreateTimer(), 3.00, false, function TrigPanaltyTyphoon___OnCast)
    endfunction
    
    function TrigPanaltyTyphoon___main takes nothing returns nothing
        //게임 초기화 시 발동합니다.
        call s__eventCustom_addAction(EVENT_GAME_INIT , function TrigPanaltyTyphoon___OnAction)
    endfunction
// scope TrigPanaltyTyphoon ends
