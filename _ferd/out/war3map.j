// Trigger: EV 148 PendragonAlterB
//===========================================================================

    
    function s__EV148PendragonAlterB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV148PendragonAlterB_STRUCT_ID)
    endfunction
    
    function s__EV148PendragonAlterB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV148PendragonAlterB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV148PendragonAlterB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV148PendragonAlterB__allocate()
        set s__EV148PendragonAlterB_ID[this]=GetUnitUserData(src)
        call s__EV148PendragonAlterB_setThis(s__EV148PendragonAlterB_ID[this] , this)
        return this
    endfunction
    
    function s__EV148PendragonAlterB_destroy takes integer this returns nothing
        call s__EV148PendragonAlterB_setThis(s__EV148PendragonAlterB_ID[this] , 0)
        call s__EV148PendragonAlterB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV148PendragonAlterB_append takes unit src returns nothing
        local integer this= s__EV148PendragonAlterB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV148PendragonAlterB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV148PendragonAlterB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV148PendragonAlterB_onSourceUnitRemove)
        set s__EV148PendragonAlterB_myServant[this]=src
        
        call s__EVServantAttack_addFunction(src , function sc__EV148PendragonAlterB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV148PendragonAlterB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        local integer cmb
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV148PendragonAlterB_getThis(GetUnitUserData(src))
        //Cast it
        if GetUnitState(src, UNIT_STATE_MANA) >= 50 then
            call SetUnitState(src, UNIT_STATE_MANA, 0.00)
            call s__CMExcalMorgan_cast(src , s__EVDamageManager_getFinalDamage(src) , 5)
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV148PendragonAlterB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV148PendragonAlterB_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV148PendragonAlterB_myServant[this]=null
        call TriggerUnbindAction(s__EV148PendragonAlterB_onRemoveAction[this])
        set s__EV148PendragonAlterB_onRemoveAction[this]=null
        //종결
        call s__EV148PendragonAlterB_destroy(this)
    endfunction

