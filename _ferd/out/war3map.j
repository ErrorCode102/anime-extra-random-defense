// scope SvAlexander begins
    //기본 서번트 스탯 설정
    //구현부
    function SvAlexander___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvAlexander___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvAlexander___ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAlexander___onAttack)
        //Adding Special Skillz
        if lv == 4 then
            call sc__EV138AlexanderA_append(s__eventServantAdd_e , 400 , 1.00 , 0)
        endif
        if lv == 5 then
            call sc__EV138AlexanderA_append(s__eventServantAdd_e , 0 , 1.00 , 0.5)
            call sc__EV139AlexanderB_append(s__eventServantAdd_e , 30 , 10)
            call s__EVDamageManager_addBonus(s__eventServantAdd_e , 100)
        endif
        if lv == 6 then
            call sc__EV138AlexanderA_append(s__eventServantAdd_e , 0 , 1.00 , 1.0)
            call sc__EV139AlexanderB_append(s__eventServantAdd_e , 15 , 10)
            call s__EVDamageManager_addBonus(s__eventServantAdd_e , 200)
        endif
    endfunction
    //초기화
    function SvAlexander___main takes nothing returns nothing
        set SvAlexander___ODMG[3]=105
        set SvAlexander___ODMG[4]=210
        set SvAlexander___ODMG[5]=525
        set SvAlexander___ODMG[6]=1680
        call s__eventServantAdd_register(SV_ALEXANDER + OFF_C , function SvAlexander___onServantGet)
        call s__eventServantAdd_register(SV_ALEXANDER + OFF_B , function SvAlexander___onServantGet)
        call s__eventServantAdd_register(SV_ALEXANDER + OFF_A , function SvAlexander___onServantGet)
        call s__eventServantAdd_register(SV_ALEXANDER + OFF_S , function SvAlexander___onServantGet)
    endfunction
