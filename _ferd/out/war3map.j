        set s__ABILHeroineXTrack_rmTrig[this]=null
        call sc__ABILHeroineXTrack_onAbilityLost(this)
        set s__ABILHeroineXTrack_source[this]=null
        set s__ABILHeroineXTrack_exists[this]=false
    endfunction
    
    function s__ABILHeroineXTrack_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILHeroineXTrack_free(this)
    endfunction
    
    function s__ABILHeroineXTrack_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILHeroineXTrack_onAbilityEffect(this)
    endfunction
    
    function s__ABILHeroineXTrack_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILHeroineXTrack_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILHeroineXTrack_exists[this] then
            set s__ABILHeroineXTrack_exists[this]=true
            set s__ABILHeroineXTrack_source[this]=src
            set s__ABILHeroineXTrack_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILHeroineXTrack_rmAct[this]=TriggerAddAction(s__ABILHeroineXTrack_rmTrig[this], function s__ABILHeroineXTrack_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILHeroineXTrack_onSourceUnitAttack)
            call sc__ABILHeroineXTrack_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    function s__ABILHeroineXTrack_TestCM takes unit src,unit dst returns nothing
        local real dir= s__Angle_WBW(src , dst)
        local real dist= s__Distance_WBW(src , dst) - 200.0
        call sc__DummyColorChanger_cast(src , 0 , 0 , 0 , 0 , 255 , 255 , 255 , 255 , 0.10)
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            call SetSafeXY(GetUnitX(src) + s__Polar_X(dist , dir) , GetUnitY(src) + s__Polar_Y(dist , dir))
            call SetUnitX(src, GetSafeX())
            call SetUnitY(src, GetSafeY())
        endif
        call SetUnitAnimation(src, "attack slam")
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02C', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02C', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
        call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Blue\\lianzhan.mdl", dst, "origin"))
        call s__enemy_dealLogicEx(src , dst , sc__EVDamageManager_getFinalDamage(src) , true , true , WEAPON_TYPE_METAL_HEAVY_STAB , 1)
    endfunction
    function s__ABILHeroineXTrack_enumFunction takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__ABILHeroineXTrack_source[this]) then
            return
        endif
        if GetUnitAbilityLevel(s__ABILHeroineXTrack_source[this], 'A0FH') < 3 then
            return
        endif
        if IsUnitDead(s__ABILHeroineXTrack_MarkedTarget[this]) then
            set s__ABILHeroineXTrack_MarkedTarget[this]=null
            return
        endif
        if IsUnitInRangeXY(s__ABILHeroineXTrack_MarkedTarget[this], GetUnitX(s__ABILHeroineXTrack_source[this]), GetUnitY(s__ABILHeroineXTrack_source[this]), GetUnitAcquireRange(s__ABILHeroineXTrack_source[this]) - 200.0) then
            return
        endif
        call s__ABILHeroineXTrack_TestCM(s__ABILHeroineXTrack_source[this] , s__ABILHeroineXTrack_MarkedTarget[this])
        set s__ABILHeroineXTrack_MarkedTarget[this]=null
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILHeroineXTrack_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILHeroineXTrack_MarkedTarget[this]=null
        set s__ABILHeroineXTrack_MarkTick[this]=s__tick_create(this)
        call s__tick_start(s__ABILHeroineXTrack_MarkTick[this],1.0 , true , function s__ABILHeroineXTrack_enumFunction)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILHeroineXTrack_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        set s__ABILHeroineXTrack_MarkedTarget[this]=null
        call s__tick_destroy(s__ABILHeroineXTrack_MarkTick[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILHeroineXTrack_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        set s__ABILHeroineXTrack_MarkedTarget[this]=dst
        set src=null
        set dst=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　연출
//==================================================================
    function s__CMHeroineXCosmos_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMHeroineXCosmos_caster[this]=null
        set s__CMHeroineXCosmos_target[this]=null
        call s__tick_destroy(s__CMHeroineXCosmos_main[this])
    endfunction
    function s__CMHeroineXCosmos_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl", GetEnumUnit(), "chest"))
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            call FXRD_FXDebuffShock(GetEnumUnit() , 5.00)
        endif
        call s__enemy_dealLogic(s__CMHeroineXCosmos_caster[this] , GetEnumUnit() , s__CMHeroineXCosmos_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMHeroineXCosmos_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real x= GetUnitX(s__CMHeroineXCosmos_caster[this])
        local real y= GetUnitY(s__CMHeroineXCosmos_caster[this])
        call s__tick_start(s__CMHeroineXCosmos_main[this],0.20 , false , function s__CMHeroineXCosmos_onFinal)
        if IsUnitDead(s__CMHeroineXCosmos_caster[this]) then
            return
        endif
        if IsUnitAlive(s__CMHeroineXCosmos_target[this]) then
            set x=GetUnitX(s__CMHeroineXCosmos_target[this])
            set y=GetUnitY(s__CMHeroineXCosmos_target[this])
        endif
        call SetSoundPosition(gg_snd_Puicell_4, x, y, 300.00)
        call StartSound(gg_snd_Puicell_4)
        call SetSoundPosition(gg_snd_Puicell_5, x, y, 300.00)
        call StartSound(gg_snd_Puicell_5)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01Z', x, y, 270.00))
        call s__splash_range(s__splash_ENEMY , s__CMHeroineXCosmos_caster[this] , x , y , 1000.0 , function s__CMHeroineXCosmos_enumDealt)
    endfunction
    function s__CMHeroineXCosmos_onCharge takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__CMHeroineXCosmos_caster[this]) then
            call s__tick_start(s__CMHeroineXCosmos_main[this],0.20 , false , function s__CMHeroineXCosmos_onFinal)
            return
        endif
        set s__CMHeroineXCosmos_stage[this]=s__CMHeroineXCosmos_stage[this] + 1
        call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", s__CMHeroineXCosmos_caster[this], "hand left"))
        call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", s__CMHeroineXCosmos_caster[this], "hand right"))
        if s__CMHeroineXCosmos_stage[this] == 15 then
            call s__tick_start(s__CMHeroineXCosmos_main[this],0.50 , false , function s__CMHeroineXCosmos_onFire)
        endif
    endfunction
    function s__CMHeroineXCosmos_cast takes unit src,real dmg,unit dst returns nothing
        local integer this= s__tick_create(0)
        set s__CMHeroineXCosmos_main[this]=this
        set s__CMHeroineXCosmos_caster[this]=src
        set s__CMHeroineXCosmos_target[this]=dst
        set s__CMHeroineXCosmos_damage[this]=dmg
        set s__CMHeroineXCosmos_stage[this]=0
        call s__tick_start(s__CMHeroineXCosmos_main[this],0.10 , true , function s__CMHeroineXCosmos_onCharge)
    endfunction
    
    function s__CMHeroineXSecretSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMHeroineXSecretSingle_myDummy[this])
        call ShowUnit(s__CMHeroineXSecretSingle_myDummy[this], false)
        set s__CMHeroineXSecretSingle_myDummy[this]=null
        set s__CMHeroineXSecretSingle_target[this]=null
        set s__CMHeroineXSecretSingle_caster[this]=null
        call s__tick_destroy(s__CMHeroineXSecretSingle_main[this])
    endfunction
    function s__CMHeroineXSecretSingle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget(s__CMHeroineXSecretSingle_fxSlashHit[this], GetEnumUnit(), "origin"))
        call s__enemy_dealLogic(s__CMHeroineXSecretSingle_caster[this] , GetEnumUnit() , s__CMHeroineXSecretSingle_damage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function s__CMHeroineXSecretSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call sc__DummyColorChanger_cast(s__CMHeroineXSecretSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMHeroineXSecretSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMHeroineXSecretSingle_main[this],0.20 , false , function s__CMHeroineXSecretSingle_onFinal)
        if IsUnitDead(s__CMHeroineXSecretSingle_caster[this]) or IsUnitDead(s__CMHeroineXSecretSingle_target[this]) then
            return
        endif
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), s__CMHeroineXSecretSingle_fxSlashDummy[this], GetUnitX(s__CMHeroineXSecretSingle_myDummy[this]), GetUnitY(s__CMHeroineXSecretSingle_myDummy[this]), GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), s__CMHeroineXSecretSingle_fxSlashDummy[this], GetUnitX(s__CMHeroineXSecretSingle_myDummy[this]), GetUnitY(s__CMHeroineXSecretSingle_myDummy[this]), GetRandomReal(0.00, 360.00)))
        call DestroyEffect(AddSpecialEffectTarget(s__CMHeroineXSecretSingle_fxSlashHit[this], s__CMHeroineXSecretSingle_target[this], "origin"))
        call s__enemy_dealLogic(s__CMHeroineXSecretSingle_caster[this] , s__CMHeroineXSecretSingle_target[this] , s__CMHeroineXSecretSingle_damage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
        //call splash.range( splash.ENEMY, .caster, GetUnitX(.myDummy), GetUnitY(.myDummy), 600.0, function thistype.enumDealt )
    endfunction
    function s__CMHeroineXSecretSingle_cast takes unit src,unit dst,real dstx,real dsty,real dmg,real x,real y,integer typ returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_PBP(x , y , dstx , dsty)
        set s__CMHeroineXSecretSingle_caster[this]=src
        set s__CMHeroineXSecretSingle_target[this]=dst
        set s__CMHeroineXSecretSingle_damage[this]=dmg
        set s__CMHeroineXSecretSingle_main[this]=this
        set s__CMHeroineXSecretSingle_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02E', dstx + s__Polar_X(200 , ang - 180), dsty + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMHeroineXSecretSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMHeroineXSecretSingle_myDummy[this], "attack")
        call SetUnitTimeScale(s__CMHeroineXSecretSingle_myDummy[this], 1.50)
        if typ == 0 then
            set s__CMHeroineXSecretSingle_fxSlashDummy[this]='o02D'
            set s__CMHeroineXSecretSingle_fxSlashHit[this]="FX Slash Cross Blue\\lianzhan.mdl"
        else
            set s__CMHeroineXSecretSingle_fxSlashDummy[this]='o02C'
            set s__CMHeroineXSecretSingle_fxSlashHit[this]="FX Slash Cross Red\\lianzhan.mdl"
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", s__CMHeroineXSecretSingle_myDummy[this], "hand left"))
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", s__CMHeroineXSecretSingle_myDummy[this], "hand right"))
        endif
        call s__tick_start(s__CMHeroineXSecretSingle_main[this],0.40 , true , function s__CMHeroineXSecretSingle_onFire)
    endfunction
    function s__CMHeroineXSecret_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMHeroineXSecret_loops[this] < 1 or IsUnitDead(s__CMHeroineXSecret_caster[this]) or IsUnitDead(s__CMHeroineXSecret_target[this]) then
            set s__CMHeroineXSecret_caster[this]=null
            set s__CMHeroineXSecret_target[this]=null
            call s__tick_destroy(s__CMHeroineXSecret_main[this])
            return
        endif
        call s__CMHeroineXSecretSingle_cast(s__CMHeroineXSecret_caster[this] , s__CMHeroineXSecret_target[this] , GetUnitX(s__CMHeroineXSecret_target[this]) , GetUnitY(s__CMHeroineXSecret_target[this]) , s__CMHeroineXSecret_damage[this] , s__CMHeroineXSecret_ox[this] , s__CMHeroineXSecret_oy[this] , s__CMHeroineXSecret_typ[this])
        set s__CMHeroineXSecret_od[this]=s__Angle_PBP(s__CMHeroineXSecret_ox[this] , s__CMHeroineXSecret_oy[this] , GetUnitX(s__CMHeroineXSecret_target[this]) , GetUnitY(s__CMHeroineXSecret_target[this]))
        set s__CMHeroineXSecret_ox[this]=GetUnitX(s__CMHeroineXSecret_target[this])
        set s__CMHeroineXSecret_oy[this]=GetUnitY(s__CMHeroineXSecret_target[this])
        set s__CMHeroineXSecret_loops[this]=s__CMHeroineXSecret_loops[this] - 1
    endfunction
    function s__CMHeroineXSecret_cast takes unit src,unit dst,real dmg,integer cmb,integer typ2 returns nothing
        local integer this= s__tick_create(0)
        set s__CMHeroineXSecret_caster[this]=src
        set s__CMHeroineXSecret_target[this]=dst
        set s__CMHeroineXSecret_damage[this]=dmg
        set s__CMHeroineXSecret_typ[this]=typ2
        set s__CMHeroineXSecret_loops[this]=cmb
        set s__CMHeroineXSecret_ox[this]=GetUnitX(dst)
        set s__CMHeroineXSecret_oy[this]=GetUnitY(dst)
        set s__CMHeroineXSecret_od[this]=GetUnitFacing(src)
        set s__CMHeroineXSecret_main[this]=this
        call s__tick_start(s__CMHeroineXSecret_main[this],0.20 , true , function s__CMHeroineXSecret_onFireStart)
    endfunction
// Trigger: Servant Medusa
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("MEDUSA","MD")
// scope SVMEDUSA begins
//end of: 서번트_선언_개시("MEDUSA","MD")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_일반("OnMeleeAttack")
        function SVMEDUSA__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_일반("OnMeleeAttack")
        function SVMEDUSA__OnSpecialAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            local real mtpl= 1.0
            if GetUnitAbilityLevel(dst, 'A05D') > 0 then
                set mtpl=mtpl + 1.0
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) * mtpl , WEAPON_TYPE_WHOKNOWS , 0)
            if GetUnitAbilityLevel(dst, 'A05J') > 0 then
                call sc__CMCybelebuff_cast(src , 2.0)
            endif
            set src=null
            set dst=null
        endfunction
        function SVMEDUSA__enumDealt takes nothing returns nothing
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\StrongDrink\\BrewmasterMissile.mdl", GetEnumUnit(), "origin"))
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 1.0)
            call FXRD_FXDebuffShock(GetEnumUnit() , 0.2)
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
        endfunction
        function SVMEDUSA__OnMaidAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            local real ang
            if GetUnitAbilityLevel(src, 'A0GY') == 0 then
                set ang=s__Angle_WBW(src , dst)
                call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02L', GetUnitX(src), GetUnitY(src), ang))
                call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02M', GetUnitX(src), GetUnitY(src), ang))
            else
                call DestroyEffect(AddSpecialEffect("FX\\ShadowAssault.mdl", GetUnitX(dst), GetUnitY(dst)))
            endif
            call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Other\\ToonBoom\\ToonBoom.mdl", dst, "origin"))
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(dst) , GetUnitY(dst) , 100.0 , function SVMEDUSA__enumDealt)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVMEDUSA__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVMEDUSA__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
//textmacro instance: 서번트_공격방식_선언("SpecialAttack", "OnSpecialAttack")
    function SVMEDUSA__SpecialAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVMEDUSA__OnSpecialAttack()
    endfunction
//end of: 서번트_공격방식_선언("SpecialAttack", "OnSpecialAttack")
//textmacro instance: 서번트_공격방식_선언("MaidAttack", "OnMaidAttack")
    function SVMEDUSA__MaidAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVMEDUSA__OnMaidAttack()
    endfunction
//end of: 서번트_공격방식_선언("MaidAttack", "OnMaidAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVMEDUSA__OnFormalLevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMEDUSA__MeleeAttack)
        endfunction
        function SVMEDUSA__OnHigherLevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMEDUSA__SpecialAttack)
            //Adding Special Skillz
            if lv == 4 then
                call sc__EV153MedusaA_append(s__eventServantAdd_e , 5.0)
                return
            endif
            if lv == 5 then
                call sc__EV153MedusaA_append(s__eventServantAdd_e , 5.0)
                call sc__EV154MedusaB_append(s__eventServantAdd_e , 5000 , 10.0 , 5)
                return
            endif
            if lv == 6 then
                call sc__EV153MedusaA_append(s__eventServantAdd_e , 5.0)
                call sc__EV154MedusaB_append(s__eventServantAdd_e , 16000 , 10.0 , 25)
                return
            endif
        endfunction
        function SVMEDUSA__OnMaid takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMEDUSA__MaidAttack)
            //
            call sc__ABILMedusaBHold_append(s__eventServantAdd_e , 1.0)
            call sc__ABILMedusaCSelf_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0H2')
            call sc__ABILMedusaDCybele_append(s__eventServantAdd_e , 5.0)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("D2C", "OnFormalLevel")
    function SVMEDUSA__D2C takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVMEDUSA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVMEDUSA__OnFormalLevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("D2C", "OnFormalLevel")
//textmacro instance: 서번트_획득_이벤트_선언("B2S", "OnHigherLevel")
    function SVMEDUSA__B2S takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVMEDUSA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVMEDUSA__OnHigherLevel()
    endfunction
