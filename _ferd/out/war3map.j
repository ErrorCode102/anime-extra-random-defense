function RRRegisterResponseEvent takes integer res,code c returns triggercondition
    if not HaveSavedHandle(RRSystem___RRTABLE, 1, res) then
        call SaveTriggerHandle(RRSystem___RRTABLE, 1, res, CreateTrigger())
    endif
    return TriggerAddCondition(LoadTriggerHandle(RRSystem___RRTABLE, 1, res), Condition(c))
endfunction
function RRRegisterAnyResponseEvent takes code c returns triggercondition
    return TriggerAddCondition(RRSystem___ARES, Condition(c))
endfunction

function RRResponseEx takes integer res,player ap1,unit au1,item at1,integer ai1,player ap2,unit au2,item at2,integer ai2 returns nothing
    local integer p_res= RRSystem___RES
    local player p_p1= RRSystem___res_p1
    local unit p_u1= RRSystem___res_u1
    local item p_t1= RRSystem___res_t1
    local integer p_i1= RRSystem___res_i1
    local player p_p2= RRSystem___res_p2
    local unit p_u2= RRSystem___res_u2
    local item p_t2= RRSystem___res_t2
    local integer p_i2= RRSystem___res_i2
    set RRSystem___RES=res
    set RRSystem___res_p1=ap1
    set RRSystem___res_u1=au1
    set RRSystem___res_t1=at1
    set RRSystem___res_i1=ai1
    set RRSystem___res_p2=ap2
    set RRSystem___res_u2=au2
    set RRSystem___res_t2=at2
    set RRSystem___res_i2=ai2
    call TriggerEvaluate(RRSystem___ARES)
    call TriggerEvaluate(LoadTriggerHandle(RRSystem___RRTABLE, 1, res))
    set RRSystem___RES=p_res
    set RRSystem___res_p1=p_p1
    set RRSystem___res_u1=p_u1
    set RRSystem___res_t1=p_t1
    set RRSystem___res_i1=p_i1
    set RRSystem___res_p2=p_p2
    set RRSystem___res_u2=p_u2
    set RRSystem___res_t2=p_t2
    set RRSystem___res_i2=p_i2
    set p_p1=null
    set p_u1=null
    set p_t1=null
    set p_p2=null
    set p_u2=null
    set p_t2=null
endfunction
function RRResponsePlayer takes integer res,player ap1 returns nothing
    call RRResponseEx(res , ap1 , null , null , 0 , null , null , null , 0)
endfunction
function RRResponsePlayerId takes integer res,player ap1,integer ai1 returns nothing
    call RRResponseEx(res , ap1 , null , null , ai1 , null , null , null , 0)
endfunction
function RRResponse takes integer res returns nothing
    call RRResponseEx(res , null , null , null , 0 , null , null , null , 0)
endfunction


