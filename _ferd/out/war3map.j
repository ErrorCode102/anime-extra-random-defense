// Trigger: FX Trig Wisp Enters Gacha
//===========================================================================
// scope FXTrigWispEntersGacha begins

    
    function FXTrigWispEntersGacha___onGachaGold takes player p,unit u returns nothing
        local integer id= GetPlayerId(p)
        local integer wav= GetUserWave(p)
        local integer amt= GetRandomInt(50 + wav * 2, 100 + wav * 10)
        call SetUnitTimeScale(u, 1.0)
        call KillUnit(u)
        call AddPlayerGold(Player(id) , amt)
        call DisplayTextToPlayer(Player(id), 0.0, 0.0, FXTrigWispEntersGacha___STR_GOLD_PREFIX + I2S(amt) + FXTrigWispEntersGacha___STR_GOLD_SUFFIX)
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetUnitX(u), GetUnitY(u)))
        call SetSoundPosition(gg_snd_Gold, GetUnitX(u), GetUnitY(u), 200)
        call StartSoundForPlayerBJ(Player(id), gg_snd_Gold)
    endfunction
    
    function FXTrigWispEntersGacha___onGachaLumber takes player p,unit u returns nothing
        local integer id= GetPlayerId(p)
        local integer wav= GetUserWave(p)
        local integer amt= GetRandomInt(1, 5)
        call SetUnitTimeScale(u, 1.0)
        call KillUnit(u)
        call AddPlayerLumber(Player(id) , amt)
        call DisplayTextToPlayer(Player(id), 0.0, 0.0, FXTrigWispEntersGacha___STR_LUMBER_PREFIX + I2S(amt) + FXTrigWispEntersGacha___STR_LUMBER_SUFFIX)
        call SetSoundPosition(gg_snd_ServantPoint2, GetUnitX(u), GetUnitY(u), 200)
        call StartSoundForPlayerBJ(Player(id), gg_snd_ServantPoint2)
    endfunction
    
    function FXTrigWispEntersGacha___onEDClassGacha takes player p,unit wisp returns nothing
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local integer rank= GetRandomInt(1, 2)
        local unit u
        call SetUnitTimeScale(wisp, 1.0)
        call KillUnit(wisp)
        if GetUserWave(p) < 15 then
            set rank=1
        else
            set x=GetPlayerStartLocationX(Player(GetPlayerId(p) + 4))
            set y=GetPlayerStartLocationY(Player(GetPlayerId(p) + 4))
        endif
        if GetPanalty(PANALTY_GACHA_ONLY_E) then
            set rank=1
        endif
        set u=s__gacha_do(p , rank , x , y , 270.0)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", u, "origin"))
        call s__servant_add(p , u , s__servant_GACHA)
        set u=null
    endfunction
    
    function FXTrigWispEntersGacha___onEClassGacha takes player p,unit wisp returns nothing
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local unit u
        call SetUnitTimeScale(wisp, 1.0)
        call KillUnit(wisp)
        if GetUserWave(p) >= 15 then
            set x=GetPlayerStartLocationX(Player(GetPlayerId(p) + 4))
            set y=GetPlayerStartLocationY(Player(GetPlayerId(p) + 4))
        endif
        set u=s__gacha_do(p , 1 , x , y , 270.0)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", u, "origin"))
        call s__servant_add(p , u , s__servant_GACHA)
        set u=null
    endfunction
    
    function FXTrigWispEntersGacha___evGold takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetEnteringUnit()))
        if GetUnitAbilityLevel(GetEnteringUnit(), FXTrigWispEntersGacha___ID_SERVANT) == 0 then
            return
        endif
        call FXTrigWispEntersGacha___onGachaGold(Player(id) , GetEnteringUnit())
    endfunction
    function FXTrigWispEntersGacha___evLumber takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetEnteringUnit()))
        if GetUnitAbilityLevel(GetEnteringUnit(), FXTrigWispEntersGacha___ID_SERVANT) == 0 then
            return
        endif
        call FXTrigWispEntersGacha___onGachaLumber(Player(id) , GetEnteringUnit())
    endfunction
    function FXTrigWispEntersGacha___evGacha takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetEnteringUnit()))
        if GetUnitAbilityLevel(GetEnteringUnit(), FXTrigWispEntersGacha___ID_SERVANT) == 0 then
            return
        endif
        call FXTrigWispEntersGacha___onEDClassGacha(Player(id) , GetEnteringUnit())
    endfunction
    
    function FXTrigWispEntersGacha___evEGacha takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetEnteringUnit()))
        if GetUnitAbilityLevel(GetEnteringUnit(), FXTrigWispEntersGacha___ID_SERVANT) == 0 then
            return
        endif
        call FXTrigWispEntersGacha___onEClassGacha(Player(id) , GetEnteringUnit())
    endfunction
    
    function FXTrigWispEntersGacha___enterEvent takes region r,code c returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterEnterRegion(t, r, null)
        call TriggerAddCondition(t, Filter(c))
        set t=null
    endfunction
    
    function FXTrigWispEntersGacha___main takes nothing returns nothing
        set FXTrigWispEntersGacha___TOGOLD=CreateRegion()
        call RegionAddRect(FXTrigWispEntersGacha___TOGOLD, gg_rct_Gacha_Gold)
        set FXTrigWispEntersGacha___TOLUMBER=CreateRegion()
        call RegionAddRect(FXTrigWispEntersGacha___TOLUMBER, gg_rct_Gacha_Lumber)
        set FXTrigWispEntersGacha___TOGACHA=CreateRegion()
        call RegionAddRect(FXTrigWispEntersGacha___TOGACHA, gg_rct_Gacha_Gacha)
        set FXTrigWispEntersGacha___TOEGACHA=CreateRegion()
        call RegionAddRect(FXTrigWispEntersGacha___TOEGACHA, gg_rct_Gacha_EGacha)
        call FXTrigWispEntersGacha___enterEvent(FXTrigWispEntersGacha___TOGOLD , function FXTrigWispEntersGacha___evGold)
        call FXTrigWispEntersGacha___enterEvent(FXTrigWispEntersGacha___TOLUMBER , function FXTrigWispEntersGacha___evLumber)
        call FXTrigWispEntersGacha___enterEvent(FXTrigWispEntersGacha___TOGACHA , function FXTrigWispEntersGacha___evGacha)
        call FXTrigWispEntersGacha___enterEvent(FXTrigWispEntersGacha___TOEGACHA , function FXTrigWispEntersGacha___evEGacha)
    endfunction
    
// scope FXTrigWispEntersGacha ends
// Trigger: FX Trig upgradebooster
//===========================================================================
// scope FXupgradebooster begins
    function FXupgradebooster___UPGID2LV takes integer id returns integer
        local integer i= 0
        loop
            exitwhen i == 8
            if FXupgradebooster___UPGID[i] == id then
                return i
            endif
            set i=i + 1
        endloop
        return - 1
    endfunction
    function FXupgradebooster___onFilter takes nothing returns boolean
        if GetUnitLevel(GetFilterUnit()) != FXupgradebooster___LV then
            return false
        endif
        if IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) then
            return false
        endif
        if not IsUnitType(GetFilterUnit(), UNIT_TYPE_TAUREN) then
            return false
        endif
        call s__EVDamageManager_addPercent(GetFilterUnit() , FXupgradebooster___UPGMTPL[FXupgradebooster___LV])
        return false
    endfunction
    function FXupgradebooster___onUpgradeStart takes nothing returns nothing
        local player p= GetOwningPlayer(GetResearchingUnit())
        local integer level= GetPlayerTechCount(p, GetResearched(), false) + 1
        call SetPlayerTechResearched(p, GetResearched(), level)
        //
        set FXupgradebooster___LV=FXupgradebooster___UPGID2LV(GetResearched())
        if FXupgradebooster___LV == - 1 then
            return
        endif
        if FXupgradebooster___UPGMAX[FXupgradebooster___LV] == level then
            set FXupgradebooster___PLAYERUPGDONE[GetPlayerId(p)]=FXupgradebooster___PLAYERUPGDONE[GetPlayerId(p)] + 1
            if FXupgradebooster___PLAYERUPGDONE[GetPlayerId(p)] == 7 then
                call SetPlayerTechResearched(p, 'R00F', 1)
            endif
        endif
        //
        call GroupEnumUnitsOfPlayer(FXupgradebooster___G, p, Filter(function FXupgradebooster___onFilter))
        call GroupClear(FXupgradebooster___G)
    endfunction
    function FXupgradebooster___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        call s__EVDamageManager_addPercent(s__eventServantAdd_e , GetPlayerTechCount(s__eventServantAdd_ep, FXupgradebooster___UPGID[lv], false) * FXupgradebooster___UPGMTPL[lv])
    endfunction
    function FXupgradebooster___main takes nothing returns nothing
        set FXupgradebooster___UPGID[1]='R00E'
        set FXupgradebooster___UPGMTPL[1]=5
        set FXupgradebooster___UPGMAX[1]=50
        set FXupgradebooster___UPGID[2]='R00D'
        set FXupgradebooster___UPGMTPL[2]=5
        set FXupgradebooster___UPGMAX[2]=50
        set FXupgradebooster___UPGID[3]='R00C'
        set FXupgradebooster___UPGMTPL[3]=5
        set FXupgradebooster___UPGMAX[3]=50
        set FXupgradebooster___UPGID[4]='R00B'
        set FXupgradebooster___UPGMTPL[4]=5
        set FXupgradebooster___UPGMAX[4]=60
        set FXupgradebooster___UPGID[5]='R00A'
        set FXupgradebooster___UPGMTPL[5]=5
        set FXupgradebooster___UPGMAX[5]=60
        set FXupgradebooster___UPGID[6]='R00S'
        set FXupgradebooster___UPGMTPL[6]=5
        set FXupgradebooster___UPGMAX[6]=60
        set FXupgradebooster___UPGID[7]='R0EX'
        set FXupgradebooster___UPGMTPL[7]=5
        set FXupgradebooster___UPGMAX[7]=60
        call s__ResearchStartEvent_Create(0 , function FXupgradebooster___onUpgradeStart)
        call s__eventServantAdd_register(0 , function FXupgradebooster___onServantGet)
    endfunction
// scope FXupgradebooster ends
// Trigger: FX Trig tryjohab
//===========================================================================
// scope FXtryjohab begins
    function FXtryjohab___onFreeJohab takes nothing returns nothing
        local integer id= s__tick_data[s__tick_getExpired()]
        set FXtryjohab___LASTJOHAB[id]=0
    endfunction
    //오브젝트 에디터 - 능력 오브젝트의 그림(A)-스페셜 항목에 기재된 태그를 읽어들인 다음, 일치하는 플래그를 세웁니다.
    function FXtryjohab___FlagJohabAbility takes integer id returns nothing
        local integer i= 0
        local string s= "ends"
        local string ts= null
        call FXClearJohabFlags()
        if GetAbilityEffectById(id, EFFECT_TYPE_SPECIAL, 0) == null then
            return
        endif
        loop
            set ts=GetAbilityEffectById(id, EFFECT_TYPE_SPECIAL, i)
            exitwhen ts == null
            exitwhen ts == s
            set s=ts
            call FXSetJohabFlag(StringHash(ts))
            set i=i + 1
        endloop
    endfunction
        function FXtryjohab___onCast takes nothing returns nothing
            local player p
            local unit u
            local real x
            local real y
            local integer lev
            local string oldname
            local integer id= GetSpellAbilityId()
            local integer pid= GetPlayerId(GetOwningPlayer(GetSpellAbilityUnit()))
            if GetObjectName(id) != "[Merge]" then
                return
            endif
            //이 조합식에 대한 특수 플래그를 등록합니다.
            call FXtryjohab___FlagJohabAbility(id)
            set p=Player(pid)
            //플래그 FLAG_UNIQUE가 존재한다면, 이미 보유한 개체인지 확인합니다.
            if FXGetJohabFlag(JOHAB_FLAG_UNIQUE) then
                if s__servant_count(p , S2A(GetAbilityEffectById(id, EFFECT_TYPE_TARGET, 0))) > 0 then
                    call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff0000This Servant can no longer be combined.|r")
                    call StartSoundForPlayerBJ(p, gg_snd_Error)
                    call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
                    set p=null
                    return
                endif
            endif
            //중복조합 방지
            if FXtryjohab___LASTJOHAB[pid] == id then
                return
            endif
            set FXtryjohab___LASTJOHAB[pid]=id
            call s__tick_start(FXtryjohab___JOHABCUT[pid],0.03125 , false , function FXtryjohab___onFreeJohab)
            //구현 끝
            set u=GetTriggerUnit()
            if s__Johab_recipeChk(p , id , s__servant_getOriginalType(p , u)) then
                set x=GetUnitX(u)
                set y=GetUnitY(u)
                call s__servant_remove(p , u)
                call KillUnit(u)
                call ShowUnit(u, false)
                call s__Johab_try(p , u , id)
                //
                set u=CreateUnit(p, S2A(GetAbilityEffectById(id, EFFECT_TYPE_TARGET, 0)), x, y, 270.00)
                if FXFireUnitBeforeJohabEvent(u) then
                    call s__servant_add(p , u , s__servant_JOHAB)
                    if GetUnitLevel(u) < 5 then
                        call DestroyEffect(AddSpecialEffect("FX\\johabTarget.mdl", GetUnitX(u), GetUnitY(u)))
                    else
                        call DestroyEffect(AddSpecialEffect("FX\\Nero\\Ultimate.mdl", GetUnitX(u), GetUnitY(u)))
                    endif
                endif
            else
                if FXGetJohabFlag(JOHAB_FLAG_HIDDEN) then
                    call DisplayTextToPlayer(p, 0.00, 0.00, "|c00FF0000Did not meet the Holy Grail opening conditions|r")
                else
                    call DisplayTextToPlayer(p, 0.00, 0.00, "|c00FF0000Don't have enough Servants: " + s__trimmer_get(s__Johab_ERRORCODE) + "|r")
                endif
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
            endif
            call s__Johab_flush()
            set p=null
            set u=null
    endfunction
    
    function FXtryjohab___main takes nothing returns nothing
        set FXtryjohab___LASTJOHAB[0]=0
        set FXtryjohab___LASTJOHAB[1]=0
        set FXtryjohab___LASTJOHAB[2]=0
        set FXtryjohab___LASTJOHAB[3]=0
        set FXtryjohab___JOHABCUT[0]=s__tick_create(0)
        set FXtryjohab___JOHABCUT[1]=s__tick_create(1)
        set FXtryjohab___JOHABCUT[2]=s__tick_create(2)
        set FXtryjohab___JOHABCUT[3]=s__tick_create(3)
        call s__AbilityEffectEvent_Create(0 , function FXtryjohab___onCast)
    endfunction
    
// scope FXtryjohab ends
// Trigger: FX Trig johabsick
//===========================================================================
// scope PLAYJohabSick begins
    function PLAYJohabSick___addPedestal takes integer id,real x,real y,real r returns nothing
        set PLAYJohabSick___ID[PLAYJohabSick___MX]=id
        set PLAYJohabSick___X[PLAYJohabSick___MX]=x
        set PLAYJohabSick___Y[PLAYJohabSick___MX]=y
        set PLAYJohabSick___R[PLAYJohabSick___MX]=r
        set PLAYJohabSick___HD[PLAYJohabSick___MX]=false
        set PLAYJohabSick___MX=PLAYJohabSick___MX + 1
    endfunction
    function PLAYJohabSick___addSSPedestal takes integer id,real x,real y,real r returns nothing
        set PLAYJohabSick___ID[PLAYJohabSick___MX]=id
        set PLAYJohabSick___X[PLAYJohabSick___MX]=x
        set PLAYJohabSick___Y[PLAYJohabSick___MX]=y
        set PLAYJohabSick___R[PLAYJohabSick___MX]=r
        set PLAYJohabSick___HD[PLAYJohabSick___MX]=true
        set PLAYJohabSick___MX=PLAYJohabSick___MX + 1
    endfunction
    function PLAYJohabSick___onExpire takes nothing returns nothing
        local unit u= null
        local integer lev
        if PLAYJohabSick___IND >= PLAYJohabSick___MX then
            call s__tick_destroy(s__tick_getExpired())
            return
        endif
        if IsObjectExists(PLAYJohabSick___ID[PLAYJohabSick___IND]) then
            call BlinkSpecialEffect(null , "FX\\GodKnows.mdl" , PLAYJohabSick___X[PLAYJohabSick___IND] , PLAYJohabSick___Y[PLAYJohabSick___IND])
            set u=CreateUnit(PLAYJohabSick___OWNER, PLAYJohabSick___ID[PLAYJohabSick___IND], PLAYJohabSick___X[PLAYJohabSick___IND], PLAYJohabSick___Y[PLAYJohabSick___IND], PLAYJohabSick___R[PLAYJohabSick___IND])
            call UnitAddType(u, UNIT_TYPE_SUMMONED)
            if PLAYJohabSick___HD[PLAYJohabSick___IND] then
                call SetUnitVertexColor(u, 255, 255, 255, 128)
            endif
            call SetUnitInvulnerable(u, true)
            call UnitAddAbility(u, 'Aneu')
            call PauseUnit(u, true)
            set u=null
        endif
        set PLAYJohabSick___IND=PLAYJohabSick___IND + 1
    endfunction
    function PLAYJohabSick___enumDests takes nothing returns nothing
        call SetDestructableInvulnerable(GetEnumDestructable(), true)
    endfunction
    function PLAYJohabSick___atGameStart takes nothing returns nothing
        //조합식 장식물 무적으로
        call EnumDestructablesInRect(bj_mapInitialPlayableArea, null, function PLAYJohabSick___enumDests)
        //
        set PLAYJohabSick___T=s__tick_create(0)
        set PLAYJohabSick___IND=0
        call s__tick_start(PLAYJohabSick___T,0.10 , true , function PLAYJohabSick___onExpire)
    endfunction
    
