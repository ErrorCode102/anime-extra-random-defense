    function s__FXNeroBride_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__FXNeroBride_caster[this]=null
        call s__tick_destroy(s__FXNeroBride_main[this])
    endfunction
    function s__FXNeroBride_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang
        if not IsUnitType(s__FXNeroBride_caster[this], UNIT_TYPE_DEAD) then
            set s__FXNeroBride_loops[this]=s__FXNeroBride_loops[this] - 1
            set ang=GetUnitFacing(s__FXNeroBride_caster[this]) - 90 + 180 * ( s__FXNeroBride_loops[this] * 0.25 )
            call DestroyEffect(AddSpecialEffect("FX\\Nero\\Ultimate.mdl", GetUnitX(s__FXNeroBride_caster[this]) + s__Polar_X(256 , ang), GetUnitY(s__FXNeroBride_caster[this]) + s__Polar_Y(256 , ang)))
            if s__FXNeroBride_loops[this] > 0 then
                return
            endif
        endif
        call s__tick_start(s__FXNeroBride_main[this],0.20 , false , function s__FXNeroBride_onFinal)
    endfunction
    function s__FXNeroBride_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        call s__EVDebuffStunServant_apply(src , 1.20)
        call SetSoundPosition(gg_snd_servant_spawn_rare, GetUnitX(src), GetUnitY(src), 300)
        call StartSound(gg_snd_servant_spawn_rare)
        call SetUnitAnimation(src, "spell two")
        set s__FXNeroBride_caster[this]=src
        set s__FXNeroBride_loops[this]=5
        set s__FXNeroBride_main[this]=this
        call s__tick_start(s__FXNeroBride_main[this],0.20 , true , function s__FXNeroBride_onFire)
    endfunction

    function s__CMPhaks_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMPhaks_myDummy[this])
        call ShowUnit(s__CMPhaks_myDummy[this], false)
        set s__CMPhaks_myDummy[this]=null
        set s__CMPhaks_caster[this]=null
        set s__CMPhaks_target[this]=null
        call s__tick_destroy(s__CMPhaks_main[this])
    endfunction
    function s__CMPhaks_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\NecromancerMissile\\NecromancerMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXDebuffShock(GetEnumUnit() , 1.00)
        call s__EVDebuffSlow_apply(GetEnumUnit() , 5.00)
        call s__enemy_dealLogic(s__CMPhaks_caster[this] , GetEnumUnit() , s__CMPhaks_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMPhaks_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffect("FX\\SvShirou\\Break.mdl", GetUnitX(s__CMPhaks_target[this]), GetUnitY(s__CMPhaks_target[this])))
        call s__splash_range(s__splash_ENEMY , s__CMPhaks_caster[this] , GetUnitX(s__CMPhaks_target[this]) , GetUnitY(s__CMPhaks_target[this]) , 450.0 , function s__CMPhaks_enumDealt)
        call sc__DummyColorChanger_cast(s__CMPhaks_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMPhaks_myDummy[this], 0.00)
        call s__tick_start(s__CMPhaks_main[this],0.20 , false , function s__CMPhaks_onFinal)
    endfunction
    function s__CMPhaks_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMPhaks_caster[this]=src
        set s__CMPhaks_target[this]=dst
        set s__CMPhaks_damage[this]=dmg
        set s__CMPhaks_main[this]=this
        set s__CMPhaks_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o00O', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst))
        call sc__DummyColorChanger_cast(s__CMPhaks_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMPhaks_myDummy[this], "attack slam")
        call SetUnitTimeScale(s__CMPhaks_myDummy[this], 1.20)
        call s__tick_start(s__CMPhaks_main[this],0.40 , true , function s__CMPhaks_onFire)
    endfunction
// Trigger: Sv A NeroBride
//===========================================================================
// scope SvNeroBride begins
    //기본 서번트 스탯 설정
    //구현부
    function SvNeroBride__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvNeroBride__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvNeroBride__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvNeroBride__onAttack)
        //Adding Special Skillz
        if lv == 5 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A030')
            call UnitAddAbility(s__eventServantAdd_e, 'S003')
            call sc__EV123NeroBrideA_append(s__eventServantAdd_e , 3 , 3.0)
            call s__FXNeroBride_cast(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A02U')
            call UnitAddAbility(s__eventServantAdd_e, 'S003')
            call SetUnitAbilityLevel(s__eventServantAdd_e, 'S003', 2)
            call sc__EV123NeroBrideA_append(s__eventServantAdd_e , 3 , 5.0)
            call s__FXNeroBride_cast(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvNeroBride__main takes nothing returns nothing
        set SvNeroBride__ODMG[5]=575
        set SvNeroBride__ODMG[6]=1840
        call s__eventServantAdd_register(SV_NEROBRIDE + OFF_A , function SvNeroBride__onServantGet)
        call s__eventServantAdd_register(SV_NEROBRIDE + OFF_S , function SvNeroBride__onServantGet)
    endfunction
// scope SvNeroBride ends
// Trigger: Common JeanneAlter
//===========================================================================
    function s__FXJeanneAlter_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(s__FXJeanneAlter_myFx[this])
        set s__FXJeanneAlter_myFx[this]=null
        set s__FXJeanneAlter_caster[this]=null
        call s__tick_destroy(s__FXJeanneAlter_main[this])
    endfunction
    function s__FXJeanneAlter_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__FXJeanneAlter_caster[this], UNIT_TYPE_DEAD) then
            call ShowUnit(s__FXJeanneAlter_caster[this], true)
            call s__EVDebuffStunServant_apply(s__FXJeanneAlter_caster[this] , 2.30)
            call SetUnitAnimation(s__FXJeanneAlter_caster[this], "spell two")
            set s__FXJeanneAlter_myFx[this]=AddSpecialEffectTarget("FX\\Okita\\Aura1.mdl", s__FXJeanneAlter_caster[this], "origin")
        endif
        call s__tick_start(s__FXJeanneAlter_main[this],1.90 , true , function s__FXJeanneAlter_onFinal)
    endfunction
    function s__FXJeanneAlter_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        call ShowUnit(src, false)
        call SetSoundPosition(gg_snd_servant_spawn_rare, GetUnitX(src), GetUnitY(src), 300)
        call StartSound(gg_snd_servant_spawn_rare)
        call KillUnit(CreateUnit(Player(15), 'o00M', GetUnitX(src), GetUnitY(src), 270))
        set s__FXJeanneAlter_myFx[this]=null
        set s__FXJeanneAlter_caster[this]=src
        set s__FXJeanneAlter_main[this]=this
        call s__tick_start(s__FXJeanneAlter_main[this],2.00 , true , function s__FXJeanneAlter_onFire)
    endfunction

    function s__CMCurseStrikeSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMCurseStrikeSingle_myDummy[this])
        call ShowUnit(s__CMCurseStrikeSingle_myDummy[this], false)
        set s__CMCurseStrikeSingle_myDummy[this]=null
        set s__CMCurseStrikeSingle_caster[this]=null
        set s__CMCurseStrikeSingle_target[this]=null
        call s__tick_destroy(s__CMCurseStrikeSingle_main[this])
    endfunction
    function s__CMCurseStrikeSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMCurseStrikeSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMCurseStrikeSingle_myDummy[this], "overhead"))
        else
            call FXRD_FXDebuffShock(s__CMCurseStrikeSingle_target[this] , 1.00)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__CMCurseStrikeSingle_target[this], "chest"))
            call s__enemy_dealLogic(s__CMCurseStrikeSingle_caster[this] , s__CMCurseStrikeSingle_target[this] , s__CMCurseStrikeSingle_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMCurseStrikeSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMCurseStrikeSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMCurseStrikeSingle_main[this],0.20 , false , function s__CMCurseStrikeSingle_onFinal)
    endfunction
    function s__CMCurseStrikeSingle_cast takes unit src,unit dst,real dmg,real x,real y returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_PBW(x , y , dst)
        set s__CMCurseStrikeSingle_caster[this]=src
        set s__CMCurseStrikeSingle_target[this]=dst
        set s__CMCurseStrikeSingle_damage[this]=dmg
        set s__CMCurseStrikeSingle_main[this]=this
        set s__CMCurseStrikeSingle_myDummy[this]=CreateUnit(Player(15), 'o00L', GetUnitX(dst) + s__Polar_X(200 , ang - 180), GetUnitY(dst) + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMCurseStrikeSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMCurseStrikeSingle_myDummy[this], "attack slam")
        call SetUnitTimeScale(s__CMCurseStrikeSingle_myDummy[this], 1.20)
        call s__tick_start(s__CMCurseStrikeSingle_main[this],0.40 , true , function s__CMCurseStrikeSingle_onFire)
    endfunction

    function s__CMCurseStrike_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMCurseStrike_loops[this] < 1 or IsUnitType(s__CMCurseStrike_caster[this], UNIT_TYPE_DEAD) or IsUnitType(s__CMCurseStrike_target[this], UNIT_TYPE_DEAD) then
            set s__CMCurseStrike_caster[this]=null
            set s__CMCurseStrike_target[this]=null
            call s__tick_destroy(s__CMCurseStrike_main[this])
            return
        endif
        call s__CMCurseStrikeSingle_cast(s__CMCurseStrike_caster[this] , s__CMCurseStrike_target[this] , s__CMCurseStrike_damage[this] , s__CMCurseStrike_ox[this] , s__CMCurseStrike_oy[this])
        set s__CMCurseStrike_ox[this]=GetUnitX(s__CMCurseStrike_target[this])
        set s__CMCurseStrike_oy[this]=GetUnitY(s__CMCurseStrike_target[this])
        set s__CMCurseStrike_loops[this]=s__CMCurseStrike_loops[this] - 1
        call s__tick_start(s__CMCurseStrike_main[this],1.00 , false , function s__CMCurseStrike_onFireStart)
    endfunction
    function s__CMCurseStrike_cast takes unit src,unit dst,real dmg,integer cmb returns nothing
        local integer this= s__tick_create(0)
        set s__CMCurseStrike_caster[this]=src
        set s__CMCurseStrike_target[this]=dst
        set s__CMCurseStrike_damage[this]=dmg
        set s__CMCurseStrike_loops[this]=cmb
        set s__CMCurseStrike_ox[this]=GetUnitX(dst)
        set s__CMCurseStrike_oy[this]=GetUnitY(dst)
        set s__CMCurseStrike_main[this]=this
        call s__tick_start(s__CMCurseStrike_main[this],0.40 , false , function s__CMCurseStrike_onFireStart)
    endfunction

    function s__CMHeineMissle_onFinal takes integer this returns nothing
        call KillUnit(s__CMHeineMissle_myDummy[this])
        set s__CMHeineMissle_myDummy[this]=null
        set s__CMHeineMissle_caster[this]=null
        set s__CMHeineMissle_target[this]=null
        call s__tick_destroy(s__CMHeineMissle_main[this])
    endfunction
    function s__CMHeineMissle_onFinalHit takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMHeineMissle_target[this], UNIT_TYPE_DEAD) then
            call s__CMHeineMissle_onFinal(this)
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", s__CMHeineMissle_target[this], "origin"))
        call s__enemy_dealLogic(s__CMHeineMissle_caster[this] , s__CMHeineMissle_target[this] , s__CMHeineMissle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        call s__CMHeineMissle_onFinal(this)
    endfunction
    function s__CMHeineMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang
        if IsUnitType(s__CMHeineMissle_target[this], UNIT_TYPE_DEAD) then
            call s__CMHeineMissle_onFinal(this)
            return
        endif
        set ang=s__Angle_WBW(s__CMHeineMissle_myDummy[this] , s__CMHeineMissle_target[this])
        call SetUnitFacing(s__CMHeineMissle_myDummy[this], ang)
        if s__Distance_WBW(s__CMHeineMissle_target[this] , s__CMHeineMissle_myDummy[this]) > s__CMHeineMissle_mySpeed[this] then
            call SetUnitX(s__CMHeineMissle_myDummy[this], GetUnitX(s__CMHeineMissle_myDummy[this]) + s__Polar_X(s__CMHeineMissle_mySpeed[this] , ang))
            call SetUnitY(s__CMHeineMissle_myDummy[this], GetUnitY(s__CMHeineMissle_myDummy[this]) + s__Polar_Y(s__CMHeineMissle_mySpeed[this] , ang))
            set s__CMHeineMissle_mySpeed[this]=s__CMHeineMissle_mySpeed[this] + 1.00
            return
        endif
        call SetUnitX(s__CMHeineMissle_myDummy[this], GetUnitX(s__CMHeineMissle_target[this]))
        call SetUnitY(s__CMHeineMissle_myDummy[this], GetUnitY(s__CMHeineMissle_target[this]))
        call FXRD_FXDebuffShock(s__CMHeineMissle_target[this] , 3.00)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__CMHeineMissle_target[this], "chest"))
        call DestroyEffect(AddSpecialEffectTarget("FXRD\\FX\\JeanneAlterSpell\\JeanneAlterSpell2.mdl", s__CMHeineMissle_target[this], "origin"))
        call s__tick_start(s__CMHeineMissle_main[this],1.00 , false , function s__CMHeineMissle_onFinalHit)
    endfunction
    function s__CMHeineMissle_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMHeineMissle_caster[this]=src
        set s__CMHeineMissle_target[this]=dst
        set s__CMHeineMissle_damage[this]=dmg
        set s__CMHeineMissle_mySpeed[this]=10
        set s__CMHeineMissle_main[this]=this
        set s__CMHeineMissle_myDummy[this]=CreateUnit(Player(15), 'o00N', GetUnitX(src) + s__Polar_X(100 , ang - 180), GetUnitY(src) + s__Polar_Y(100 , ang - 180), ang)
        call s__tick_start(s__CMHeineMissle_main[this],0.03125 , true , function s__CMHeineMissle_onFire)
    endfunction

    function s__CMHeine_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMHeine_myDummy[this])
        call ShowUnit(s__CMHeine_myDummy[this], false)
        set s__CMHeine_myDummy[this]=null
        set s__CMHeine_caster[this]=null
        set s__CMHeine_target[this]=null
        call s__tick_destroy(s__CMHeine_main[this])
    endfunction
    function s__CMHeine_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMHeine_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMHeine_myDummy[this], "overhead"))
        else
            call s__CMHeineMissle_cast(s__CMHeine_caster[this] , s__CMHeine_target[this] , s__CMHeine_damage[this])
        endif
        call sc__DummyColorChanger_cast(s__CMHeine_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMHeine_myDummy[this], 0.00)
        call s__tick_start(s__CMHeine_main[this],0.20 , false , function s__CMHeine_onFinal)
    endfunction
    function s__CMHeine_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMHeine_caster[this]=src
        set s__CMHeine_target[this]=dst
        set s__CMHeine_damage[this]=dmg
        set s__CMHeine_main[this]=this
        set s__CMHeine_myDummy[this]=CreateUnit(Player(15), 'o00L', GetUnitX(src) + s__Polar_X(200 , ang - 180), GetUnitY(src) + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMHeine_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMHeine_myDummy[this], "spell one")
        call SetUnitTimeScale(s__CMHeine_myDummy[this], 1.20)
        call s__tick_start(s__CMHeine_main[this],0.40 , false , function s__CMHeine_onFire)
    endfunction
// Trigger: Sv A JeanneAlter
//===========================================================================
// scope SvJeanneAlter begins
    //기본 서번트 스탯 설정
    //구현부
    function SvJeanneAlter__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvJeanneAlter__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvJeanneAlter__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvJeanneAlter__onAttack)
        //Adding Special Skillz
        if lv == 5 then
            call sc__EV120JeanneAlterA_append(s__eventServantAdd_e , 500 , true , false)
            call sc__EV121JeanneAlterA2_append(s__eventServantAdd_e , 1)
            call sc__EV122JeanneAlterB_append(s__eventServantAdd_e , 5000 , 10.00)
            call s__FXJeanneAlter_cast(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call sc__EV120JeanneAlterA_append(s__eventServantAdd_e , 1600 , true , true)
            call sc__EV121JeanneAlterA2_append(s__eventServantAdd_e , 2)
            call sc__EV122JeanneAlterB_append(s__eventServantAdd_e , 32000 , 10.00)
            call s__FXJeanneAlter_cast(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvJeanneAlter__main takes nothing returns nothing
        set SvJeanneAlter__ODMG[5]=400
        set SvJeanneAlter__ODMG[6]=1280
        call s__eventServantAdd_register(SV_JEANNEALTER + OFF_A , function SvJeanneAlter__onServantGet)
        call s__eventServantAdd_register(SV_JEANNEALTER + OFF_S , function SvJeanneAlter__onServantGet)
    endfunction
// scope SvJeanneAlter ends
// Trigger: EV 155 BathoryAlterA
//===========================================================================

    
    function s__EV155BathoryAlterA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV155BathoryAlterA_STRUCT_ID)
    endfunction
    
    function s__EV155BathoryAlterA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV155BathoryAlterA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV155BathoryAlterA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV155BathoryAlterA__allocate()
        set s__EV155BathoryAlterA_ID[this]=GetUnitUserData(src)
        call s__EV155BathoryAlterA_setThis(s__EV155BathoryAlterA_ID[this] , this)
        return this
    endfunction
    
    function s__EV155BathoryAlterA_destroy takes integer this returns nothing
        call s__EV155BathoryAlterA_setThis(s__EV155BathoryAlterA_ID[this] , 0)
        call s__EV155BathoryAlterA_deallocate(this)
    endfunction
    
    //API
    
    function s__EV155BathoryAlterA_append takes unit src,integer mxbonus returns nothing
        local integer this= s__EV155BathoryAlterA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV155BathoryAlterA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV155BathoryAlterA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV155BathoryAlterA_onSourceUnitRemove)
        set s__EV155BathoryAlterA_myServant[this]=src
        set s__EV155BathoryAlterA_maxBonus[this]=mxbonus
        set s__EV155BathoryAlterA_prevBonus[this]=0
        
        set s__EV155BathoryAlterA_myTick[this]=s__tick_create(this)
        call s__tick_start(s__EV155BathoryAlterA_myTick[this],0.50 , true , function sc__EV155BathoryAlterA_onChangeMana)
    endfunction
    
    //구현부
    function s__EV155BathoryAlterA_onChangeMana takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not IsUnitType(s__EV155BathoryAlterA_myServant[this], UNIT_TYPE_DEAD) then
            call s__EVDamageManager_addBonus(s__EV155BathoryAlterA_myServant[this] , - s__EV155BathoryAlterA_prevBonus[this] / 10)
            set s__EV155BathoryAlterA_prevBonus[this]=R2I(s__EV155BathoryAlterA_maxBonus[this] * GetUnitState(s__EV155BathoryAlterA_myServant[this], UNIT_STATE_MANA) / GetUnitState(s__EV155BathoryAlterA_myServant[this], UNIT_STATE_MAX_MANA))
            call s__EVDamageManager_addBonus(s__EV155BathoryAlterA_myServant[this] , s__EV155BathoryAlterA_prevBonus[this] / 10)
        endif
    endfunction
    
    function s__EV155BathoryAlterA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV155BathoryAlterA_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV155BathoryAlterA_myServant[this]=null
        call TriggerUnbindAction(s__EV155BathoryAlterA_onRemoveAction[this])
        set s__EV155BathoryAlterA_onRemoveAction[this]=null
        //종결
        call s__EV155BathoryAlterA_destroy(this)
    endfunction
    

//===========================================================================
// Trigger: EV 156 BathoryAlterB
//===========================================================================

    
    function s__EV156BathoryAlterB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV156BathoryAlterB_STRUCT_ID)
    endfunction
    
    function s__EV156BathoryAlterB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV156BathoryAlterB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV156BathoryAlterB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV156BathoryAlterB__allocate()
        set s__EV156BathoryAlterB_ID[this]=GetUnitUserData(src)
        call s__EV156BathoryAlterB_setThis(s__EV156BathoryAlterB_ID[this] , this)
        return this
    endfunction
    
    function s__EV156BathoryAlterB_destroy takes integer this returns nothing
        call s__EV156BathoryAlterB_setThis(s__EV156BathoryAlterB_ID[this] , 0)
        call s__EV156BathoryAlterB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV156BathoryAlterB_append takes unit src,real percent returns nothing
        local integer this= s__EV156BathoryAlterB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV156BathoryAlterB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV156BathoryAlterB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV156BathoryAlterB_onSourceUnitRemove)
        set s__EV156BathoryAlterB_myServant[this]=src
        set s__EV156BathoryAlterB_myPercent[this]=percent
        
        call s__EVServantAttack_addFunction(src , function sc__EV156BathoryAlterB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV156BathoryAlterB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV156BathoryAlterB_getThis(GetUnitUserData(src))
        //Cast it
        if GetRandomReal(0.0, 100.0) < s__EV156BathoryAlterB_myPercent[this] then
            call sc__CMSalgovar_cast(src , dst , s__EVDamageManager_getFinalDamage(src))
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV156BathoryAlterB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV156BathoryAlterB_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV156BathoryAlterB_myServant[this]=null
        call TriggerUnbindAction(s__EV156BathoryAlterB_onRemoveAction[this])
        set s__EV156BathoryAlterB_onRemoveAction[this]=null
        //종결
        call s__EV156BathoryAlterB_destroy(this)
    endfunction
    
//===========================================================================
// Trigger: Sv A BathoryAlter
//===========================================================================
// scope SvBathoryalter begins
    //기본 서번트 스탯 설정
    //구현부
    function SvBathoryalter__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1.0)
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvBathoryalter__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvBathoryalter__ODMG[lv])
        //Adding Base Attack
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvBathoryalter__onAttack)
        //Adding Special Skillz
        if lv == 5 then
            call s__EV155BathoryAlterA_append(s__eventServantAdd_e , 2000)
            call s__EV156BathoryAlterB_append(s__eventServantAdd_e , 100.0)
        endif
        if lv == 6 then
            call s__EV155BathoryAlterA_append(s__eventServantAdd_e , 4000)
            call s__EV156BathoryAlterB_append(s__eventServantAdd_e , 100.0)
            call sc__ABILBathoryAlterHemorrhage_append(s__eventServantAdd_e , 1.00)
        endif
    endfunction
    //초기화
    function SvBathoryalter__main takes nothing returns nothing
        set SvBathoryalter__ODMG[5]=650
        set SvBathoryalter__ODMG[6]=2080
        call s__eventServantAdd_register(SV_BATHORYALTER + OFF_A , function SvBathoryalter__onServantGet)
        call s__eventServantAdd_register(SV_BATHORYALTER + OFF_S , function SvBathoryalter__onServantGet)
    endfunction
// scope SvBathoryalter ends

//textmacro instance: 어빌리티_선언_개시("BathoryAlterHemorrhage")
//end of: 어빌리티_선언_개시("BathoryAlterHemorrhage")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILBathoryAlterHemorrhage_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBathoryAlterHemorrhage_rmTrig[this], s__ABILBathoryAlterHemorrhage_rmAct[this])
        set s__ABILBathoryAlterHemorrhage_rmAct[this]=null
        set s__ABILBathoryAlterHemorrhage_rmTrig[this]=null
        call sc__ABILBathoryAlterHemorrhage_onAbilityLost(this)
        call s__tick_destroy(s__ABILBathoryAlterHemorrhage_durTik[this])
        set s__ABILBathoryAlterHemorrhage_source[this]=null
        set s__ABILBathoryAlterHemorrhage_exists[this]=false
    endfunction
    
    function s__ABILBathoryAlterHemorrhage_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBathoryAlterHemorrhage_free(this)
    endfunction
    
    function s__ABILBathoryAlterHemorrhage_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILBathoryAlterHemorrhage_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILBathoryAlterHemorrhage_source[this]) then
            return
        endif
        call sc__ABILBathoryAlterHemorrhage_onAbilityEffect(this)
        call s__tick_start(s__ABILBathoryAlterHemorrhage_durTik[this],s__ABILBathoryAlterHemorrhage_duration[this] , false , function s__ABILBathoryAlterHemorrhage_onExpire)
    endfunction
    
    function s__ABILBathoryAlterHemorrhage_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBathoryAlterHemorrhage_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBathoryAlterHemorrhage_exists[this] then
            set s__ABILBathoryAlterHemorrhage_exists[this]=true
            set s__ABILBathoryAlterHemorrhage_source[this]=src
            set s__ABILBathoryAlterHemorrhage_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBathoryAlterHemorrhage_rmAct[this]=TriggerAddAction(s__ABILBathoryAlterHemorrhage_rmTrig[this], function s__ABILBathoryAlterHemorrhage_OnSourceRemove)
            
            set s__ABILBathoryAlterHemorrhage_duration[this]=dur
            set s__ABILBathoryAlterHemorrhage_defaultDuration[this]=dur
            set s__ABILBathoryAlterHemorrhage_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILBathoryAlterHemorrhage_durTik[this],dur , false , function s__ABILBathoryAlterHemorrhage_onExpire)
            call sc__ABILBathoryAlterHemorrhage_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILBathoryAlterHemorrhage_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILBathoryAlterHemorrhage_MarkedTarget[this]=null
        set s__ABILBathoryAlterHemorrhage_VampireChain[this]=null
        set s__ABILBathoryAlterHemorrhage_MarkCounter[this]=0
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILBathoryAlterHemorrhage_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        set s__ABILBathoryAlterHemorrhage_MarkedTarget[this]=null
        if s__ABILBathoryAlterHemorrhage_VampireChain[this] != null then
            call DestroyLightning(s__ABILBathoryAlterHemorrhage_VampireChain[this])
            set s__ABILBathoryAlterHemorrhage_VampireChain[this]=null
        endif
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_모듈_필터_무작위_아크에너미_선정("ArchEnemyFilter")
    function s__ABILBathoryAlterHemorrhage_EnumArchEnemyFilter takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            return
        endif
        if GetRandomInt(0, s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_CNT) == 0 then
            set s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_TARGET=GetEnumUnit()
        endif
        set s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_CNT=s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_CNT + 1
    endfunction
    function s__ABILBathoryAlterHemorrhage_ArchEnemyFilter takes boolexpr f,unit src,real x,real y,real rng returns unit
        set s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_TARGET=null
        set s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_CNT=0
        call s__splash_range(f , src , x , y , rng , function s__ABILBathoryAlterHemorrhage_EnumArchEnemyFilter)
        set src=s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_TARGET
        set s__ABILBathoryAlterHemorrhage_ArchEnemyFilter_TARGET=null
        return src
    endfunction
//end of: 어빌리티_모듈_필터_무작위_아크에너미_선정("ArchEnemyFilter")
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBathoryAlterHemorrhage_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local boolean targetLost= ( s__ABILBathoryAlterHemorrhage_MarkedTarget[this] == null )
        if not targetLost then
            if IsUnitDead(s__ABILBathoryAlterHemorrhage_MarkedTarget[this]) then
                // 이펙트 삭제
                if s__ABILBathoryAlterHemorrhage_VampireChain[this] != null then
                    call DestroyLightning(s__ABILBathoryAlterHemorrhage_VampireChain[this])
                    set s__ABILBathoryAlterHemorrhage_VampireChain[this]=null
                endif
                set targetLost=true
                set s__ABILBathoryAlterHemorrhage_MarkedTarget[this]=null
            endif
        endif
        if targetLost then
            set s__ABILBathoryAlterHemorrhage_MarkedTarget[this]=s__ABILBathoryAlterHemorrhage_ArchEnemyFilter(s__splash_ENEMY , s__ABILBathoryAlterHemorrhage_source[this] , GetUnitX(s__ABILBathoryAlterHemorrhage_source[this]) , GetUnitY(s__ABILBathoryAlterHemorrhage_source[this]) , 700.0)
            set s__ABILBathoryAlterHemorrhage_MarkCounter[this]=0
            if IsUnitDead(s__ABILBathoryAlterHemorrhage_MarkedTarget[this]) then
                set s__ABILBathoryAlterHemorrhage_duration[this]=1.0
                return
            else
                // 이펙트 생성
                set s__ABILBathoryAlterHemorrhage_VampireChain[this]=AddLightningExSimple("AFOD" , s__ABILBathoryAlterHemorrhage_source[this] , 60.0 , s__ABILBathoryAlterHemorrhage_MarkedTarget[this] , 120.0)
            endif
        endif
        // 이펙트 갱신
        call MoveLightningExSimple(s__ABILBathoryAlterHemorrhage_VampireChain[this] , s__ABILBathoryAlterHemorrhage_source[this] , 60.0 , s__ABILBathoryAlterHemorrhage_MarkedTarget[this] , 120.0)
        if s__ABILBathoryAlterHemorrhage_MarkCounter[this] == 16 then
            // 타격 이펙트
            call SetUnitState(s__ABILBathoryAlterHemorrhage_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILBathoryAlterHemorrhage_source[this], UNIT_STATE_MANA) + 1.0)
            call s__EVDebuffSlow_apply(s__ABILBathoryAlterHemorrhage_MarkedTarget[this] , 1.0)
            call s__enemy_dealLogicEx(s__ABILBathoryAlterHemorrhage_source[this] , s__ABILBathoryAlterHemorrhage_MarkedTarget[this] , s__EVDamageManager_getFinalDamage(s__ABILBathoryAlterHemorrhage_source[this]) * 0.5 , true , false , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
            set s__ABILBathoryAlterHemorrhage_MarkCounter[this]=0
        endif
        set s__ABILBathoryAlterHemorrhage_MarkCounter[this]=s__ABILBathoryAlterHemorrhage_MarkCounter[this] + 1
        set s__ABILBathoryAlterHemorrhage_duration[this]=0.03125
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

    function s__CMSalgovar_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMSalgovar_myDummy[this])
        call ShowUnit(s__CMSalgovar_myDummy[this], false)
        set s__CMSalgovar_myDummy[this]=null
        set s__CMSalgovar_caster[this]=null
        call s__tick_destroy(s__CMSalgovar_main[this])
    endfunction
    function s__CMSalgovar_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , 1.00)
        call s__enemy_dealLogic(s__CMSalgovar_caster[this] , GetEnumUnit() , s__CMSalgovar_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMSalgovar_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(CreateUnit(Player(15), 'h00A', s__CMSalgovar_myX[this], s__CMSalgovar_myY[this], 270))
        call KillUnit(CreateUnit(Player(15), 'h00B', s__CMSalgovar_myX[this], s__CMSalgovar_myY[this], 270))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", s__CMSalgovar_myX[this], s__CMSalgovar_myY[this]))
        call s__splash_range(s__splash_ENEMY , s__CMSalgovar_caster[this] , s__CMSalgovar_myX[this] , s__CMSalgovar_myY[this] , 500 , function s__CMSalgovar_enumDealt)
        call sc__DummyColorChanger_cast(s__CMSalgovar_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMSalgovar_myDummy[this], 0.00)
        call s__tick_start(s__CMSalgovar_main[this],0.20 , false , function s__CMSalgovar_onFinal)
    endfunction
    function s__CMSalgovar_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMSalgovar_caster[this]=src
        set s__CMSalgovar_myX[this]=GetUnitX(dst)
        set s__CMSalgovar_myY[this]=GetUnitY(dst)
        set s__CMSalgovar_damage[this]=dmg
        set s__CMSalgovar_main[this]=this
        set s__CMSalgovar_myDummy[this]=CreateUnit(Player(15), 'h00L', GetUnitX(src), GetUnitY(src), ang)
        call sc__DummyKnockback_cast(s__CMSalgovar_myDummy[this] , RMaxBJ(0, s__Distance_WBW(src , dst) - 150) , ang , 0 , 0.90)
        call sc__DummyColorChanger_cast(s__CMSalgovar_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMSalgovar_myDummy[this], "spell slam")
        call s__tick_start(s__CMSalgovar_main[this],0.90 , false , function s__CMSalgovar_onFire)
    endfunction
//===========================================================================
// Trigger: Sv XS MoonCell
//===========================================================================
// scope SvMoonCell begins
    //기본 서번트 스탯 설정
    //구현부
    function SvMoonCell__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call FXRD_FXDebuffShock(dst , 0.10)
        call s__enemy_dealLogicEx(src , dst , s__EVDamageManager_getFinalDamage(src) , true , false , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvMoonCell__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvMoonCell__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvMoonCell__onAttack)
        //Adding Special Skillz
        if lv == 8 then
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A05Y')
            call UnitAddAbility(s__eventServantAdd_e, 'S000')
            call UnitRemoveAbility(s__eventServantAdd_e, 'A08L')
            call UnitAddAbility(s__eventServantAdd_e, 'A05B')
            call sc__EV125MooncellD_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvMoonCell__main takes nothing returns nothing
        set SvMoonCell__ODMG[8]=2500
        call s__eventServantAdd_register(SV_MOONCELL + OFF_XS , function SvMoonCell__onServantGet)
    endfunction
// scope SvMoonCell ends
// Trigger: Common Dummy Library
//===========================================================================
    function s__DummyColorChanger_atChangeAlpha takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__DummyColorChanger_loops[this] < 1 then
            call SetUnitVertexColor(s__DummyColorChanger_myCaster[this], s__DummyColorChanger_tr[this], s__DummyColorChanger_tg[this], s__DummyColorChanger_tb[this], s__DummyColorChanger_ta[this])
            set s__DummyColorChanger_myCaster[this]=null
            call s__tick_destroy(s__DummyColorChanger_mainFlow[this])
            return
        endif
        set s__DummyColorChanger_loops[this]=s__DummyColorChanger_loops[this] - 1
        set s__DummyColorChanger_rr[this]=s__DummyColorChanger_rr[this] + s__DummyColorChanger_dr[this]
        set s__DummyColorChanger_rg[this]=s__DummyColorChanger_rg[this] + s__DummyColorChanger_dg[this]
        set s__DummyColorChanger_rb[this]=s__DummyColorChanger_rb[this] + s__DummyColorChanger_db[this]
        set s__DummyColorChanger_ra[this]=s__DummyColorChanger_ra[this] + s__DummyColorChanger_da[this]
        call SetUnitVertexColor(s__DummyColorChanger_myCaster[this], s__DummyColorChanger_rr[this], s__DummyColorChanger_rg[this], s__DummyColorChanger_rb[this], s__DummyColorChanger_ra[this])
    endfunction
    function s__DummyColorChanger_cast takes unit src,integer sr,integer sg,integer sb,integer sa,integer er,integer eg,integer eb,integer ea,real d returns nothing
        local integer this= s__tick_create(0)
        set s__DummyColorChanger_myCaster[this]=src
        call SetUnitVertexColor(src, sr, sg, sb, sa)
        set s__DummyColorChanger_loops[this]=R2I(d * 25)
        set s__DummyColorChanger_tr[this]=er
        set s__DummyColorChanger_tg[this]=eg
        set s__DummyColorChanger_tb[this]=eb
        set s__DummyColorChanger_ta[this]=ea
        set s__DummyColorChanger_rr[this]=sr
        set s__DummyColorChanger_rg[this]=sg
        set s__DummyColorChanger_rb[this]=sb
        set s__DummyColorChanger_ra[this]=sa
        if s__DummyColorChanger_loops[this] > 0 then
            set s__DummyColorChanger_dr[this]=( er - sr ) / s__DummyColorChanger_loops[this]
            set s__DummyColorChanger_dg[this]=( eg - sg ) / s__DummyColorChanger_loops[this]
            set s__DummyColorChanger_db[this]=( eb - sb ) / s__DummyColorChanger_loops[this]
            set s__DummyColorChanger_da[this]=( ea - sa ) / s__DummyColorChanger_loops[this]
        endif
        set s__DummyColorChanger_mainFlow[this]=this
        call s__tick_start(s__DummyColorChanger_mainFlow[this],0.04 , true , function s__DummyColorChanger_atChangeAlpha)
    endfunction

    function s__DummyLightning_onLightningExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__DummyLightning_loops[this] < 1 then
            call DestroyLightning(s__DummyLightning_beam[this])
            call s__tick_destroy(s__DummyLightning_main[this])
            return
        endif
        set s__DummyLightning_loops[this]=s__DummyLightning_loops[this] - 1
        set s__DummyLightning_oa[this]=s__DummyLightning_oa[this] - s__DummyLightning_da[this]
        call SetLightningColor(s__DummyLightning_beam[this], s__DummyLightning_cr[this], s__DummyLightning_cg[this], s__DummyLightning_cb[this], s__DummyLightning_oa[this])
    endfunction
    function s__DummyLightning_cast takes string id,real r,real g,real b,real x,real y,real z,real x2,real y2,real z2,real d returns nothing
        local integer this= s__tick_create(0)
        set s__DummyLightning_main[this]=this
        set s__DummyLightning_beam[this]=AddLightningEx(id, true, x, y, z, x2, y2, z2)
        call SetLightningColor(s__DummyLightning_beam[this], r, g, b, 1)
        set s__DummyLightning_cr[this]=r
        set s__DummyLightning_cg[this]=g
        set s__DummyLightning_cb[this]=b
        set s__DummyLightning_loops[this]=R2I(d * 32)
        set s__DummyLightning_oa[this]=1
        set s__DummyLightning_da[this]=1.00 / s__DummyLightning_loops[this]
        call s__tick_start(s__DummyLightning_main[this],0.03125 , true , function s__DummyLightning_onLightningExpire)
    endfunction

    function s__DummyOffsetUnit_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real dsin
        local real dcos
        if IsUnitType(s__DummyOffsetUnit_other[this], UNIT_TYPE_DEAD) or IsUnitType(s__DummyOffsetUnit_me[this], UNIT_TYPE_DEAD) then
            set s__DummyOffsetUnit_me[this]=null
            set s__DummyOffsetUnit_other[this]=null
            call s__tick_destroy(s__DummyOffsetUnit_main[this])
            return
        endif
        set dsin=Sin(GetUnitFacing(s__DummyOffsetUnit_other[this]) * bj_DEGTORAD)
        set dcos=Cos(GetUnitFacing(s__DummyOffsetUnit_other[this]) * bj_DEGTORAD)
        call SetUnitX(s__DummyOffsetUnit_me[this], GetUnitX(s__DummyOffsetUnit_other[this]) + dcos * s__DummyOffsetUnit_ox[this] - dsin * s__DummyOffsetUnit_oy[this])
        call SetUnitY(s__DummyOffsetUnit_me[this], GetUnitY(s__DummyOffsetUnit_other[this]) + dsin * s__DummyOffsetUnit_ox[this] + dcos * s__DummyOffsetUnit_oy[this])
        call SetUnitFlyHeight(s__DummyOffsetUnit_me[this], GetUnitFlyHeight(s__DummyOffsetUnit_other[this]) + s__DummyOffsetUnit_oz[this], 0.00)
    endfunction
    function s__DummyOffsetUnit_cast takes unit src,unit dst,real dx,real dy,real dz returns nothing
        local integer this= s__tick_create(0)
        set s__DummyOffsetUnit_main[this]=this
        set s__DummyOffsetUnit_me[this]=src
        set s__DummyOffsetUnit_other[this]=dst
        set s__DummyOffsetUnit_ox[this]=dx
        set s__DummyOffsetUnit_oy[this]=dy
        set s__DummyOffsetUnit_oz[this]=dz
        call s__tick_start(s__DummyOffsetUnit_main[this],0.03125 , true , function s__DummyOffsetUnit_onExpire)
    endfunction

    function s__DummyFollowUnit_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if GetUnitTypeId(s__DummyFollowUnit_other[this]) == 0 or GetUnitTypeId(s__DummyFollowUnit_me[this]) == 0 then
            set s__DummyFollowUnit_me[this]=null
            set s__DummyFollowUnit_other[this]=null
            call s__tick_destroy(s__DummyFollowUnit_main[this])
            return
        endif
        call SetUnitX(s__DummyFollowUnit_me[this], GetUnitX(s__DummyFollowUnit_other[this]))
        call SetUnitY(s__DummyFollowUnit_me[this], GetUnitY(s__DummyFollowUnit_other[this]))
    endfunction
    function s__DummyFollowUnit_cast takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        set s__DummyFollowUnit_main[this]=this
        set s__DummyFollowUnit_me[this]=src
        set s__DummyFollowUnit_other[this]=dst
        call s__tick_start(s__DummyFollowUnit_main[this],0.03125 , true , function s__DummyFollowUnit_onExpire)
    endfunction

    function s__DummyKnockback_onKnockbackExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__DummyKnockback_dl[this] < 1 or IsUnitType(s__DummyKnockback_me[this], UNIT_TYPE_DEAD) then
            call SetUnitX(s__DummyKnockback_me[this], s__DummyKnockback_tx[this])
            call SetUnitY(s__DummyKnockback_me[this], s__DummyKnockback_ty[this])
            call SetUnitFlyHeight(s__DummyKnockback_me[this], s__DummyKnockback_oz[this], 0.00)
            set s__DummyKnockback_me[this]=null
            call s__tick_destroy(s__DummyKnockback_main[this])
            return
        endif
        set s__DummyKnockback_dl[this]=s__DummyKnockback_dl[this] - 1
        call SetUnitX(s__DummyKnockback_me[this], GetUnitX(s__DummyKnockback_me[this]) + s__DummyKnockback_dx[this])
        call SetUnitY(s__DummyKnockback_me[this], GetUnitY(s__DummyKnockback_me[this]) + s__DummyKnockback_dy[this])
        call SetUnitFlyHeight(s__DummyKnockback_me[this], s__DummyKnockback_oz[this] + s__DummyKnockback_tz[this] * Sin(3.14 - ( s__DummyKnockback_dl[this] * s__DummyKnockback_dd[this] * 3.14 )), 0.00)
    endfunction
    function s__DummyKnockback_cast takes unit src,real d,real r,real z,real t returns nothing
        local integer this= s__tick_create(0)
        call UnitAddAbility(src, 'Amrf')
        call UnitRemoveAbility(src, 'Amrf')
        set s__DummyKnockback_main[this]=this
        set s__DummyKnockback_oz[this]=GetUnitDefaultFlyHeight(src)
        set s__DummyKnockback_me[this]=src
        set s__DummyKnockback_tx[this]=GetUnitX(src) + s__Polar_X(d , r)
        set s__DummyKnockback_ty[this]=GetUnitY(src) + s__Polar_Y(d , r)
        set s__DummyKnockback_tz[this]=z
        set d=s__Distance_WBP(src , s__DummyKnockback_tx[this] , s__DummyKnockback_ty[this])
        set r=s__Angle_WBP(src , s__DummyKnockback_tx[this] , s__DummyKnockback_ty[this])
        set s__DummyKnockback_dl[this]=R2I(t * 32)
        set s__DummyKnockback_dx[this]=s__Polar_X(d / s__DummyKnockback_dl[this] , r)
        set s__DummyKnockback_dy[this]=s__Polar_Y(d / s__DummyKnockback_dl[this] , r)
        if s__DummyKnockback_dl[this] > 0 then
            set s__DummyKnockback_dd[this]=1.00 / s__DummyKnockback_dl[this]
        endif
        call s__tick_start(s__DummyKnockback_main[this],0.03125 , true , function s__DummyKnockback_onKnockbackExpire)
    endfunction

    function s__DummyLightningChaser_onLightningExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real x= s__DummyLightningChaser_srcX[this]
        local real y= s__DummyLightningChaser_srcY[this]
        local real z= s__DummyLightningChaser_srcZ[this]
        local real x2= s__DummyLightningChaser_dstX[this]
        local real y2= s__DummyLightningChaser_dstY[this]
        local real z2= s__DummyLightningChaser_dstZ[this]
        if s__DummyLightningChaser_loops[this] < 1 then
            call DestroyLightning(s__DummyLightningChaser_beam[this])
            call s__tick_destroy(s__DummyLightningChaser_main[this])
            return
        endif
        if GetUnitTypeId(s__DummyLightningChaser_src[this]) != 0 then
            set x=GetWidgetX(s__DummyLightningChaser_src[this]) + x
            set y=GetWidgetY(s__DummyLightningChaser_src[this]) + y
            set z=GetUnitFlyHeight(s__DummyLightningChaser_src[this]) + z
        endif
        if GetUnitTypeId(s__DummyLightningChaser_dst[this]) != 0 then
            set x2=GetWidgetX(s__DummyLightningChaser_dst[this]) + x2
            set y2=GetWidgetY(s__DummyLightningChaser_dst[this]) + y2
            set z2=GetUnitFlyHeight(s__DummyLightningChaser_dst[this]) + z2
        endif
        set s__DummyLightningChaser_loops[this]=s__DummyLightningChaser_loops[this] - 1
        set s__DummyLightningChaser_oa[this]=s__DummyLightningChaser_oa[this] - s__DummyLightningChaser_da[this]
        call SetLightningColor(s__DummyLightningChaser_beam[this], s__DummyLightningChaser_cr[this], s__DummyLightningChaser_cg[this], s__DummyLightningChaser_cb[this], s__DummyLightningChaser_oa[this])
        call MoveLightningEx(s__DummyLightningChaser_beam[this], false, x, y, z, x2, y2, z2)
    endfunction
    function s__DummyLightningChaser_cast takes string id,real r,real g,real b,unit s,real x,real y,real z,unit ds,real x2,real y2,real z2,real d returns nothing
        local integer this= s__tick_create(0)
        set s__DummyLightningChaser_main[this]=this
        //
        set s__DummyLightningChaser_src[this]=s
        set s__DummyLightningChaser_srcX[this]=x
        set s__DummyLightningChaser_srcY[this]=y
        set s__DummyLightningChaser_srcZ[this]=z
        set s__DummyLightningChaser_dst[this]=ds
        set s__DummyLightningChaser_dstX[this]=x2
        set s__DummyLightningChaser_dstY[this]=y2
        set s__DummyLightningChaser_dstZ[this]=z2
        if GetUnitTypeId(s__DummyLightningChaser_src[this]) != 0 then
            set x=GetWidgetX(s__DummyLightningChaser_src[this]) + x
            set y=GetWidgetY(s__DummyLightningChaser_src[this]) + y
            set z=GetUnitFlyHeight(s__DummyLightningChaser_src[this]) + z
        endif
        if GetUnitTypeId(s__DummyLightningChaser_dst[this]) != 0 then
            set x2=GetWidgetX(s__DummyLightningChaser_dst[this]) + x2
            set y2=GetWidgetY(s__DummyLightningChaser_dst[this]) + y2
            set z2=GetUnitFlyHeight(s__DummyLightningChaser_dst[this]) + z2
        endif
        //
        set s__DummyLightningChaser_beam[this]=AddLightningEx(id, true, x, y, z, x2, y2, z2)
        call SetLightningColor(s__DummyLightningChaser_beam[this], r, g, b, 1)
        set s__DummyLightningChaser_cr[this]=r
        set s__DummyLightningChaser_cg[this]=g
        set s__DummyLightningChaser_cb[this]=b
        set s__DummyLightningChaser_loops[this]=R2I(d * 32)
        set s__DummyLightningChaser_oa[this]=1
        set s__DummyLightningChaser_da[this]=1.00 / s__DummyLightningChaser_loops[this]
        call s__tick_start(s__DummyLightningChaser_main[this],0.03125 , true , function s__DummyLightningChaser_onLightningExpire)
    endfunction

    function s__DummyMissileTimed_onKnockbackExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ex= s__DummyMissileTimed_tx[this]
        local real ey= s__DummyMissileTimed_ty[this]
        local real ez= s__DummyMissileTimed_tz[this]
        local real perc
        local real dist
        local real ang
        if s__DummyMissileTimed_dst[this] != null then
            set ex=ex + GetUnitX(s__DummyMissileTimed_dst[this])
            set ey=ey + GetUnitY(s__DummyMissileTimed_dst[this])
            set ez=ez + GetUnitFlyHeight(s__DummyMissileTimed_dst[this])
        endif
        set s__DummyMissileTimed_cur[this]=s__DummyMissileTimed_cur[this] + 1
        set perc=s__DummyMissileTimed_cur[this] * 1.00 / s__DummyMissileTimed_loops[this]
        set ang=s__Angle_PBP(s__DummyMissileTimed_ox[this] , s__DummyMissileTimed_oy[this] , ex , ey)
        set dist=s__Distance_PBP(s__DummyMissileTimed_ox[this] , s__DummyMissileTimed_oy[this] , ex , ey) * perc
        call SetUnitFacing(s__DummyMissileTimed_me[this], ang)
        call SetUnitX(s__DummyMissileTimed_me[this], s__DummyMissileTimed_ox[this] + s__Polar_X(dist , ang))
        call SetUnitY(s__DummyMissileTimed_me[this], s__DummyMissileTimed_oy[this] + s__Polar_Y(dist , ang))
        call SetUnitFlyHeight(s__DummyMissileTimed_me[this], s__DummyMissileTimed_oz[this] + ( ez - s__DummyMissileTimed_oz[this] ) * perc, 0.00)
        if s__DummyMissileTimed_cur[this] == s__DummyMissileTimed_loops[this] then
            set s__DummyMissileTimed_me[this]=null
            set s__DummyMissileTimed_dst[this]=null
            call s__tick_destroy(s__DummyMissileTimed_main[this])
            return
        endif
    endfunction
    function s__DummyMissileTimed_cast takes unit src,unit trg,real dx,real dy,real dz,real delay returns nothing
        local integer this= s__tick_create(0)
        call UnitAddAbility(src, 'Amrf')
        call UnitRemoveAbility(src, 'Amrf')
        set s__DummyMissileTimed_main[this]=this
        set s__DummyMissileTimed_me[this]=src
        set s__DummyMissileTimed_ox[this]=GetUnitX(src)
        set s__DummyMissileTimed_oy[this]=GetUnitY(src)
        set s__DummyMissileTimed_oz[this]=GetUnitFlyHeight(src)
        set s__DummyMissileTimed_dst[this]=trg
        set s__DummyMissileTimed_tx[this]=dx
        set s__DummyMissileTimed_ty[this]=dy
        set s__DummyMissileTimed_tz[this]=dz
        set s__DummyMissileTimed_cur[this]=0
        set s__DummyMissileTimed_loops[this]=IMaxBJ(1, R2I(delay * 32))
        call s__tick_start(s__DummyMissileTimed_main[this],0.03125 , true , function s__DummyMissileTimed_onKnockbackExpire)
    endfunction
//===========================================================================
// Trigger: EV 100 AndersenC
//===========================================================================

    
    function s__EV100AndersenC_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV100AndersenC_STRUCT_ID)
    endfunction
    
    function s__EV100AndersenC_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV100AndersenC_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV100AndersenC_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV100AndersenC__allocate()
        set s__EV100AndersenC_ID[this]=GetUnitUserData(src)
        call s__EV100AndersenC_setThis(s__EV100AndersenC_ID[this] , this)
        return this
    endfunction
    
    function s__EV100AndersenC_destroy takes integer this returns nothing
        call s__EV100AndersenC_setThis(s__EV100AndersenC_ID[this] , 0)
        call s__EV100AndersenC_deallocate(this)
    endfunction
    
    //API
    
    function s__EV100AndersenC_append takes unit src returns nothing
        local integer this= s__EV100AndersenC_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV100AndersenC failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV100AndersenC_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV100AndersenC_onSourceUnitRemove)
        set s__EV100AndersenC_myServant[this]=src
        set s__EV100AndersenC_prevTarget[this]=null
        
        set s__EV100AndersenC_onSpellEffect[this]=CreateTrigger()
        call TriggerAddCondition(s__EV100AndersenC_onSpellEffect[this], Condition(function sc__EV100AndersenC_conditionSpellEffect))
        set s__EV100AndersenC_onSpellEffectAction[this]=TriggerAddAction(s__EV100AndersenC_onSpellEffect[this], function sc__EV100AndersenC_actionSpellEffect)
        call TriggerRegisterUnitEvent(s__EV100AndersenC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
        
        set s__EV100AndersenC_onSpellCast[this]=CreateTrigger()
        call TriggerAddCondition(s__EV100AndersenC_onSpellCast[this], Condition(function sc__EV100AndersenC_conditionSpellEffect))
        set s__EV100AndersenC_onSpellCastAction[this]=TriggerAddAction(s__EV100AndersenC_onSpellCast[this], function sc__EV100AndersenC_actionSpellCast)
        call TriggerRegisterUnitEvent(s__EV100AndersenC_onSpellCast[this], src, EVENT_UNIT_SPELL_CAST)
    endfunction
    
    //구현부
    
    function s__EV100AndersenC_actionSpellCast takes nothing returns nothing
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            if GetUnitAbilityLevel(GetSpellTargetUnit(), s__EV100AndersenC_BFAB) == 0 then
                return
            endif
        endif
        call UnitRemoveAbility(GetTriggerUnit(), s__EV100AndersenC_ABID)
        call UnitAddAbility(GetTriggerUnit(), s__EV100AndersenC_ABID)
        call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
    endfunction
    function s__EV100AndersenC_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV100AndersenC_getThis(GetUnitUserData(GetTriggerUnit()))
        //
        if not IsUnitDead(s__EV100AndersenC_prevTarget[this]) then
            call s__EVDamageManager_addBonus(s__EV100AndersenC_prevTarget[this] , - s__EV100AndersenC_DMGB)
            call UnitRemoveAbility(s__EV100AndersenC_prevTarget[this], s__EV100AndersenC_BFAB)
            call UnitRemoveAbility(s__EV100AndersenC_prevTarget[this], s__EV100AndersenC_BFID)
        endif
        //
        set s__EV100AndersenC_prevTarget[this]=GetSpellTargetUnit()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetTriggerUnit(), "origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetSpellTargetUnit(), "origin"))
        call UnitAddAbility(GetSpellTargetUnit(), s__EV100AndersenC_BFAB)
        call s__EVDamageManager_addBonus(GetSpellTargetUnit() , s__EV100AndersenC_DMGB)
        //
    endfunction
    function s__EV100AndersenC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__EV100AndersenC_ABID
    endfunction
    function s__EV100AndersenC_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV100AndersenC_getThis(s__EVUnitRemove_e)
        //
        if not IsUnitDead(s__EV100AndersenC_prevTarget[this]) then
            call s__EVDamageManager_addBonus(s__EV100AndersenC_prevTarget[this] , - 100)
            call UnitRemoveAbility(GetTriggerUnit(), s__EV100AndersenC_BFAB)
            call UnitRemoveAbility(GetTriggerUnit(), s__EV100AndersenC_BFID)
        endif
        //누수처리
        set s__EV100AndersenC_prevTarget[this]=null
        call TriggerRemoveAction(s__EV100AndersenC_onSpellEffect[this], s__EV100AndersenC_onSpellEffectAction[this])
        set s__EV100AndersenC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV100AndersenC_onSpellEffect[this])
        set s__EV100AndersenC_onSpellEffect[this]=null
        call TriggerRemoveAction(s__EV100AndersenC_onSpellCast[this], s__EV100AndersenC_onSpellCastAction[this])
        set s__EV100AndersenC_onSpellCastAction[this]=null
        call DestroyTrigger(s__EV100AndersenC_onSpellCast[this])
        set s__EV100AndersenC_onSpellCast[this]=null
        set s__EV100AndersenC_myServant[this]=null
        call TriggerUnbindAction(s__EV100AndersenC_onRemoveAction[this])
        set s__EV100AndersenC_onRemoveAction[this]=null
        //종결
        call s__EV100AndersenC_destroy(this)
    endfunction
    
    

//===========================================================================
// Trigger: EV 102 BB A
//===========================================================================

    
    function s__EV102BBA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV102BBA_STRUCT_ID)
    endfunction
    
    function s__EV102BBA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV102BBA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV102BBA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV102BBA__allocate()
        set s__EV102BBA_ID[this]=GetUnitUserData(src)
        call s__EV102BBA_setThis(s__EV102BBA_ID[this] , this)
        return this
    endfunction
    
    function s__EV102BBA_destroy takes integer this returns nothing
        call s__EV102BBA_setThis(s__EV102BBA_ID[this] , 0)
        call s__EV102BBA_deallocate(this)
    endfunction
    
    //API
    function s__EV102BBA_append takes unit src,integer mStk,boolean buf,integer dmgexp returns nothing
        local integer this= s__EV102BBA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV102BBA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV102BBA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV102BBA_onSourceUnitRemove)
        set s__EV102BBA_myServant[this]=src
        set s__EV102BBA_atkStack[this]=0
        set s__EV102BBA_myBuff[this]=buf
        set s__EV102BBA_maxStack[this]=mStk
        set s__EV102BBA_dmgBonus[this]=dmgexp
        call s__EVServantAttack_addFunction(src , function sc__EV102BBA_onSourceUnitAttack)
    endfunction
    
    function s__EV102BBA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if not DEAL_FLAG_LOGIC then
            //Melee Attack
            set this=s__EV102BBA_getThis(GetUnitUserData(src))
            set s__EV102BBA_atkStack[this]=s__EV102BBA_atkStack[this] + 1
            if s__EV102BBA_atkStack[this] == s__EV102BBA_maxStack[this] then
                if IsUnitType(dst, UNIT_TYPE_GIANT) and s__EV102BBA_myBuff[this] then
                    call UnitAddAbility(dst, 'A07G')
                endif
                call s__EVDamageManager_addBonus(src , - s__EV102BBA_dmgBonus[this])
                call FXRD_FXDebuffShock(dst , 1.0)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", dst, "origin"))
                call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o000', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst)))
                set s__EV102BBA_atkStack[this]=0
            else
                call s__EVDebuffSlow_apply(dst , 1.0)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
            endif
            if s__EV102BBA_atkStack[this] == s__EV102BBA_maxStack[this] - 1 then
                call s__EVDamageManager_addBonus(src , s__EV102BBA_dmgBonus[this])
            endif
        endif
        set src=null
        set dst=null
    endfunction
    //구현부
    function s__EV102BBA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV102BBA_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV102BBA_myServant[this]=null
        call TriggerUnbindAction(s__EV102BBA_onRemoveAction[this])
        set s__EV102BBA_onRemoveAction[this]=null
        //종결
        call s__EV102BBA_destroy(this)
    endfunction
    

//===========================================================================
// Trigger: EV 103 SakuraB
//===========================================================================

    
    function s__EV103SakuraB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV103SakuraB_STRUCT_ID)
    endfunction
    
    function s__EV103SakuraB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV103SakuraB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV103SakuraB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV103SakuraB__allocate()
        set s__EV103SakuraB_ID[this]=GetUnitUserData(src)
        call s__EV103SakuraB_setThis(s__EV103SakuraB_ID[this] , this)
        return this
    endfunction
    
    function s__EV103SakuraB_destroy takes integer this returns nothing
        call s__EV103SakuraB_setThis(s__EV103SakuraB_ID[this] , 0)
        call s__EV103SakuraB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV103SakuraB_append takes unit src,integer targets,integer cmax returns nothing
        local integer this= s__EV103SakuraB_create(src)
        local integer i= 0
        local real arc
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV103SakuraB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV103SakuraB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV103SakuraB_onSourceUnitRemove)
        set s__EV103SakuraB_myServant[this]=src
        set s__EV103SakuraB_myTargets[this]=targets
        
        set arc=360.00 / targets
        loop
            exitwhen i == targets
            set s___EV103SakuraB_myDummy[s__EV103SakuraB_myDummy[this]+i]=CreateUnit(Player(15), 'o00V', GetUnitX(src), GetUnitY(src), 270.00)
            call s__DummyOffsetUnit_cast(s___EV103SakuraB_myDummy[s__EV103SakuraB_myDummy[this]+i] , src , s__Polar_X(125 , arc * ( i + 0.50 )) , s__Polar_Y(125 , arc * ( i + 0.50 )) , 300)
            set i=i + 1
        endloop
        
        call s__EVServantAttack_addFunction(src , function sc__EV103SakuraB_onSourceUnitAttack)
    endfunction
    
    //구현부
    
    function s__EV103SakuraB_enumGetTarget takes nothing returns nothing
        local integer this= s__EV103SakuraB_getThis(GetUnitUserData(s__splash__get_src()))
        if s__EV103SakuraB_CNT == s__EV103SakuraB_myTargets[this] then
            return
        endif
        call s__CMPhotonLaserSingle_cast(s__EV103SakuraB_myServant[this] , GetEnumUnit() , s__EVDamageManager_getFinalDamage(s__EV103SakuraB_myServant[this]) , s___EV103SakuraB_myDummy[s__EV103SakuraB_myDummy[this]+s__EV103SakuraB_CNT])
        set s__EV103SakuraB_CNT=s__EV103SakuraB_CNT + 1
    endfunction
    
    function s__EV103SakuraB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV103SakuraB_getThis(GetUnitUserData(src))
        //빔캐스트
        set s__EV103SakuraB_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV103SakuraB_myServant[this] , GetUnitX(s__EV103SakuraB_myServant[this]) , GetUnitY(s__EV103SakuraB_myServant[this]) , GetUnitAcquireRange(s__EV103SakuraB_myServant[this]) + 100 , function s__EV103SakuraB_enumGetTarget)
        set src=null
        set dst=null
    endfunction
    
    function s__EV103SakuraB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV103SakuraB_getThis(s__EVUnitRemove_e)
        local integer i= 0
        //누수처리
        loop
            exitwhen i == s__EV103SakuraB_myTargets[this]
            call KillUnit(s___EV103SakuraB_myDummy[s__EV103SakuraB_myDummy[this]+i])
            set s___EV103SakuraB_myDummy[s__EV103SakuraB_myDummy[this]+i]=null
            set i=i + 1
        endloop
        set s__EV103SakuraB_myServant[this]=null
        call TriggerUnbindAction(s__EV103SakuraB_onRemoveAction[this])
        set s__EV103SakuraB_onRemoveAction[this]=null
        //종결
        call s__EV103SakuraB_destroy(this)
    endfunction
    
    

//===========================================================================
// Trigger: EV 104 SpecialTower
//===========================================================================

    
    function s__EV104SpecialTower_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV104SpecialTower_STRUCT_ID)
    endfunction
    
    function s__EV104SpecialTower_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV104SpecialTower_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV104SpecialTower_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV104SpecialTower__allocate()
        set s__EV104SpecialTower_ID[this]=GetUnitUserData(src)
        call s__EV104SpecialTower_setThis(s__EV104SpecialTower_ID[this] , this)
        return this
    endfunction
    
    function s__EV104SpecialTower_destroy takes integer this returns nothing
        call s__EV104SpecialTower_setThis(s__EV104SpecialTower_ID[this] , 0)
        call s__EV104SpecialTower_deallocate(this)
    endfunction
    
    //API
    //
    //
    function s__EV104SpecialTower_append takes unit src returns nothing
        local integer this= s__EV104SpecialTower_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV104SpecialTower failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV104SpecialTower_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV104SpecialTower_onSourceUnitRemove)
        set s__EV104SpecialTower_myServant[this]=src
        set s__EV104SpecialTower_myId[this]=GetPlayerId(GetOwningPlayer(src))
        set s__EV104SpecialTower_ox[this]=GetUnitX(src)
        set s__EV104SpecialTower_oy[this]=GetUnitY(src)
        set s__EV104SpecialTower_isCharged[this]=0
        set s__EV104SpecialTower_prevTarget[this]=null
        set s__EV104SpecialTower_myBeam[this]=AddLightning("AFOD", true, 1, 8, 2, 5)
        call SetLightningColor(s__EV104SpecialTower_myBeam[this], 1, 1, 1, 0)
        set s__EV104SpecialTower_chargeTick[this]=s__tick_create(this)
        set s__EV104SpecialTower_weakTick[this]=s__tick_create(this)
        call s__EVServantAttack_addFunction(src , function sc__EV104SpecialTower_onSourceUnitAttack)
    endfunction
    
    function s__EV104SpecialTower_onChargeComp takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__EV104SpecialTower_isCharged[this]=IMinBJ(4, s__EV104SpecialTower_isCharged[this] + 1)
        set s__EV104SpecialTower_maxAlpha[this]=RMinBJ(1, 0.25 * s__EV104SpecialTower_isCharged[this])
    endfunction
    
    function s__EV104SpecialTower_onChargeWeak takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__EV104SpecialTower_curAlpha[this]=RMaxBJ(0, s__EV104SpecialTower_curAlpha[this] - 0.10)
        if s__EV104SpecialTower_curAlpha[this] == 0 then
            call s__tick_pause(s__EV104SpecialTower_weakTick[this])
        endif
        call SetLightningColor(s__EV104SpecialTower_myBeam[this], 1, 1, 1, s__EV104SpecialTower_curAlpha[this])
    endfunction
    
    function s__EV104SpecialTower_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        local real bdmg
        local integer best
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV104SpecialTower_getThis(GetUnitUserData(src))
        set best=FXRD_SERVANT_BEST[s__EV104SpecialTower_myId[this]]
        if best > 0 then
            if s__EV104SpecialTower_prevTarget[this] == dst then
                set s__EV104SpecialTower_curAlpha[this]=s__EV104SpecialTower_maxAlpha[this]
                call SetLightningColor(s__EV104SpecialTower_myBeam[this], 1, 1, 1, s__EV104SpecialTower_curAlpha[this])
                call MoveLightningEx(s__EV104SpecialTower_myBeam[this], true, s__EV104SpecialTower_ox[this], s__EV104SpecialTower_oy[this], 900, GetUnitX(dst), GetUnitY(dst), 60)
                if s__EV104SpecialTower_isCharged[this] > 0 then
                    set bdmg=50 + GetPlayerTechCount(GetOwningPlayer(src), 'R0TO', false) * 50
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", dst, "origin"))
                    call s__enemy_dealLogic(src , dst , bdmg * 0.10 * s__EV104SpecialTower_isCharged[this] , WEAPON_TYPE_WHOKNOWS , 0)
                endif
                call s__tick_start(s__EV104SpecialTower_weakTick[this],0.10 , true , function s__EV104SpecialTower_onChargeWeak)
            else
                set s__EV104SpecialTower_prevTarget[this]=dst
                set s__EV104SpecialTower_isCharged[this]=0
                set s__EV104SpecialTower_maxAlpha[this]=0
                set s__EV104SpecialTower_curAlpha[this]=0
                call SetLightningColor(s__EV104SpecialTower_myBeam[this], 255, 255, 255, 0)
                call s__tick_start(s__EV104SpecialTower_chargeTick[this],3.00 , true , function s__EV104SpecialTower_onChargeComp)
            endif
        endif
        set src=null
        set dst=null
    endfunction
    //구현부
    function s__EV104SpecialTower_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV104SpecialTower_getThis(s__EVUnitRemove_e)
        //누수처리
        call DestroyLightning(s__EV104SpecialTower_myBeam[this])
        set s__EV104SpecialTower_myBeam[this]=null
        set s__EV104SpecialTower_prevTarget[this]=null
        call s__tick_destroy(s__EV104SpecialTower_chargeTick[this])
        call s__tick_destroy(s__EV104SpecialTower_weakTick[this])
        set s__EV104SpecialTower_myServant[this]=null
        call TriggerUnbindAction(s__EV104SpecialTower_onRemoveAction[this])
        set s__EV104SpecialTower_onRemoveAction[this]=null
        //종결
        call s__EV104SpecialTower_destroy(this)
    endfunction
    

