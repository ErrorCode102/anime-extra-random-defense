        call DestroyEffect(AddSpecialEffectTarget("FX\\Slash\\Red.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__CMBladestormSingle_caster[this] , GetEnumUnit() , s__CMBladestormSingle_damage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function s__CMBladestormSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(CreateUnit(Player(15), 'o011', GetUnitX(s__CMBladestormSingle_caster[this]), GetUnitY(s__CMBladestormSingle_caster[this]), GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(Player(15), 'o011', GetUnitX(s__CMBladestormSingle_caster[this]), GetUnitY(s__CMBladestormSingle_caster[this]), GetRandomReal(0.00, 360.00)))
        call s__splash_range(s__splash_ENEMY , s__CMBladestormSingle_caster[this] , GetUnitX(s__CMBladestormSingle_caster[this]) , GetUnitY(s__CMBladestormSingle_caster[this]) , 400 , function s__CMBladestormSingle_enumDealt)
        call s__tick_start(s__CMBladestormSingle_main[this],0.20 , false , function s__CMBladestormSingle_onFinal)
    endfunction
    function s__CMBladestormSingle_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMBladestormSingle_caster[this]=src
        set s__CMBladestormSingle_damage[this]=dmg
        set s__CMBladestormSingle_main[this]=this
        call SetSoundPosition(gg_snd_weapon_swing_1, GetUnitX(s__CMBladestormSingle_caster[this]), GetUnitY(s__CMBladestormSingle_caster[this]), 300)
        call StopSound(gg_snd_weapon_swing_1, false, false)
        call StartSound(gg_snd_weapon_swing_1)
        call s__tick_start(s__CMBladestormSingle_main[this],0.40 , false , function s__CMBladestormSingle_onFire)
    endfunction

    function s__CMBladestorm_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMBladestorm_loops[this] < 1 or IsUnitType(s__CMBladestorm_caster[this], UNIT_TYPE_DEAD) then
            set s__CMBladestorm_caster[this]=null
            call s__tick_destroy(s__CMBladestorm_main[this])
            return
        endif
        call s__CMBladestormSingle_cast(s__CMBladestorm_caster[this] , s__CMBladestorm_damage[this])
        set s__CMBladestorm_loops[this]=s__CMBladestorm_loops[this] - 1
    endfunction
