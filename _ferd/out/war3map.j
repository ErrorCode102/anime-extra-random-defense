// Trigger: EV 163 ChulainnA
//===========================================================================

    
    function s__EV163ChulainnA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV163ChulainnA_STRUCT_ID)
