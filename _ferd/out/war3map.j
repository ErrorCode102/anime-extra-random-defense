    function FXTrigUsingWispCtrlTool__RegisterCommandTrigger takes code left,code right,code up,code down,code stop returns nothing
        local integer i= 0
        call TriggerAddAction(FXTrigUsingWispCtrlTool__LEFT, left)
        call TriggerAddAction(FXTrigUsingWispCtrlTool__RIGHT, right)
        call TriggerAddAction(FXTrigUsingWispCtrlTool__UP, up)
        call TriggerAddAction(FXTrigUsingWispCtrlTool__DOWN, down)
        call TriggerAddAction(FXTrigUsingWispCtrlTool__STOP, stop)
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__LEFT, Player(i), "-l", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__LEFT, Player(i), "-ㅣ", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__RIGHT, Player(i), "-r", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__RIGHT, Player(i), "-ㄱ", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__UP, Player(i), "-u", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__UP, Player(i), "-ㅕ", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__DOWN, Player(i), "-d", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__DOWN, Player(i), "-ㅇ", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__STOP, Player(i), "-s", true)
            call TriggerRegisterPlayerChatEvent(FXTrigUsingWispCtrlTool__STOP, Player(i), "-ㄴ", true)
            set i=i + 1
        endloop
    endfunction
    
    
    function FXTrigUsingWispCtrlTool__autostop takes player p returns nothing
        local integer id= GetPlayerId(p)
        set FXRD_AUTOWISP[id]=0
        call DisplayTextToPlayer(p, 0, 0, "|c0000ff80Automatic Wisp Command canceled|r")
    endfunction
    function FXTrigUsingWispCtrlTool__autolumber takes player p returns nothing
