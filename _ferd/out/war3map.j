// Trigger: FACTION 01 Nero
//===========================================================================
//==========================================================================
// 이 곳에 세력의 [코드명]과 [등록번호]를 기재하고, 세력 상세정보를 기술합니다.
// 이 번호가 다른 세력과 겹치면, 대참사가 발생하게 됩니다.
//===================================================
//textmacro instance: FACTION_DECLARATION_START("NERO", "1")
// scope FXFACTIONNERO begins
    function FXFACTIONNERO__main takes nothing returns nothing
        call FXCreateFaction(FXFACTIONNERO__FACTION_SELF)
        call FXSetFactionName(FXFACTIONNERO__FACTION_SELF , FXFACTIONNERO__NAME)
        call FXSetFactionIcon(FXFACTIONNERO__FACTION_SELF , FXFACTIONNERO__ICON)
        call FXSetFactionMasterName(FXFACTIONNERO__FACTION_SELF , FXFACTIONNERO__MASTER_NAME)
        call FXSetFactionMasterIcon(FXFACTIONNERO__FACTION_SELF , FXFACTIONNERO__MASTER_ICON)
    endfunction
// scope FXFACTIONNERO ends
//end of: FACTION_DECLARATION_END()
//===================================================
//      네로 - 시설물 배치
//===================================================
// scope TrigFactionNeroBatchBuilding begins
    function TrigFactionNeroBatchBuilding__DoLineDesign takes player p returns nothing
        local integer i= GetPlayerId(p)
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        local integer typeId= IntegerTertiaryOp(FXIsPlayerCurrentFactionMastered(p), 'n016', 'n017')
        local unit u= CreateUnit(Player(i), typeId, x, y, 270.0)
        call SetUnitVertexColor(u, 255, 255, 255, 32)
        call SetUnitAnimation(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o029', x, y, 270.00), "Birth")
        set u=null
    endfunction
    
    function TrigFactionNeroBatchBuilding__CreateSkillBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 0)
        local real y= FXGetPlayerBuildingLocationY(p , 0)
        local unit u= CreateUnit(p, 'H004', x, y, 270)
        call SuspendHeroXP(u, true)
        set FXRD_TOWER[GetPlayerId(p)]=u
        set u=null
    endfunction
    function TrigFactionNeroBatchBuilding__CreateUpgradeBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 1)
        local real y= FXGetPlayerBuildingLocationY(p , 1)
        local unit u= CreateUnit(p, 'H009', x, y, 270)
        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    function TrigFactionNeroBatchBuilding__CreateGachaBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 2)
        local real y= FXGetPlayerBuildingLocationY(p , 2)
        local unit u= CreateUnit(p, IntegerTertiaryOp(GetPanalty(PANALTY_NURF_GACHA), 'H002', 'H00F'), x, y, 270)
        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    function TrigFactionNeroBatchBuilding__CreateConvBuilding takes player p returns nothing
        local real x= FXGetPlayerBuildingLocationX(p , 3)
        local real y= FXGetPlayerBuildingLocationY(p , 3)
        local unit u= CreateUnit(p, 'H001', x, y, 270)
        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    //=================================================
    function TrigFactionNeroBatchBuilding__OnSkillBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_NERO then
            call TrigFactionNeroBatchBuilding__CreateSkillBuilding(s__eventCustom_getTriggerPlayer())
            
            call TrigFactionNeroBatchBuilding__DoLineDesign(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    function TrigFactionNeroBatchBuilding__OnUpgradeBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_NERO then
            call TrigFactionNeroBatchBuilding__CreateUpgradeBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    function TrigFactionNeroBatchBuilding__OnGachaBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_NERO then
            call TrigFactionNeroBatchBuilding__CreateGachaBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    function TrigFactionNeroBatchBuilding__OnConvBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_NERO then
            call TrigFactionNeroBatchBuilding__CreateConvBuilding(s__eventCustom_getTriggerPlayer())
        endif
    endfunction
    //=================================================
    function TrigFactionNeroBatchBuilding__main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_0 , function TrigFactionNeroBatchBuilding__OnSkillBuilding)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_1 , function TrigFactionNeroBatchBuilding__OnUpgradeBuilding)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_2 , function TrigFactionNeroBatchBuilding__OnGachaBuilding)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_3 , function TrigFactionNeroBatchBuilding__OnConvBuilding)
    endfunction
// scope TrigFactionNeroBatchBuilding ends
