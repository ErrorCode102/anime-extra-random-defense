//library FXStasisField:



    function FXStasisField___OnExpire takes nothing returns nothing
        local integer ATIK= sc__tick_getExpired()
        call KillUnit(FXStasisField___ADUM[ATIK])
        set FXStasisField___ADUM[ATIK]=null
        call sc__tick_destroy(ATIK)
    endfunction

    function FXStasisField___OnImpact takes nothing returns nothing
        local integer ATIK= sc__tick_getExpired()
        local unit u= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), FXStasisField___STMD, GetUnitX(FXStasisField___ADUM[ATIK]), GetUnitY(FXStasisField___ADUM[ATIK]), 270)
        call UnitApplyTimedLife(u, 'BHwe', FXStasisField___ADUR[ATIK])
        call SetUnitVertexColor(u, 255, 255, 255, 128)
        call SetUnitAnimation(u, "birth")
        set u=null
        call ShowUnit(FXStasisField___ADUM[ATIK], false)
        call sc__tick_start(ATIK,RMaxBJ(0.04, FXStasisField___ADUR[ATIK] - 3.50) , false , function FXStasisField___OnExpire)
    endfunction

    function FXStasisField___OnCastFinish takes nothing returns nothing
        local integer ATIK= sc__tick_getExpired()
        call UnitAddAbility(FXStasisField___ADUM[ATIK], FXStasisField___ABID)
        call sc__tick_start(ATIK,0.50 , false , function FXStasisField___OnImpact)
    endfunction

    function FXRD_FXStasisField takes real x,real y,real casdur,real dur returns nothing
        local integer ATIK= sc__tick_create(0)
        set FXStasisField___ADUR[ATIK]=dur
        set FXStasisField___ADUM[ATIK]=CreateUnit(Player(11), FXStasisField___INMD, x, y, 270)
        call SetUnitTimeScale(FXStasisField___ADUM[ATIK], FXStasisField___INTS / casdur)
        call sc__tick_start(ATIK,RMaxBJ(0.04, casdur - 0.50) , false , function FXStasisField___OnCastFinish)
    endfunction

//library FXStasisField ends
//library FXWisp:
        function s__FXWisp___WispModelsInitializer_onInit takes nothing returns nothing
            call SaveInteger(FXWisp___WISP_MODELS, StringHash("escaco"), 0, 'A0HB')
            // Credits
            call SaveInteger(FXWisp___WISP_MODELS, StringHash("Arterion"), 0, 'A0HB')
            call SaveInteger(FXWisp___WISP_MODELS, StringHash("Vo.Shecil"), 0, 'A0HB')
            call SaveInteger(FXWisp___WISP_MODELS, StringHash("Morikubo"), 0, 'A0HA')
        endfunction
    function CreateWisp takes player p,integer amt returns nothing
        local integer i= 0
        local integer order= FXRD_AUTOWISP[GetPlayerId(p)]
        local real x= - 6144.00
        local real y= 0
        local boolean hasSkin= HaveSavedInteger(FXWisp___WISP_MODELS, StringHash(USER_NAME[GetPlayerId(p)]), 0)
        local integer skin= LoadInteger(FXWisp___WISP_MODELS, StringHash(USER_NAME[GetPlayerId(p)]), 0)
        local unit u
        loop
            exitwhen i >= amt
            set u=CreateUnit(p, 'wisp', x, y, 270)
            call UnitAddAbility(u, 'A02L')
            call SetUnitTimeScale(u, 0.0)
            if GetLocalPlayer() != p then
                call SetUnitVertexColor(u, 255, 255, 255, 32)
                call SetUnitScale(u, 0.1, 0.1, 0.1)
            endif
            if hasSkin then
                call UnitAddAbility(u, skin)
            endif
            if order > 0 then
                call IssuePointOrder(u, "move", x + sc__Polar_X(512.00 , 90.00 * order), y + sc__Polar_Y(512.00 , 90.00 * order))
            endif
            set i=i + 1
        endloop
        set u=null
    endfunction

