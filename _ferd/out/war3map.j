function sa__EV104SpecialTower_onSourceUnitAttack takes nothing returns boolean

        local integer this
        local unit src
        local unit dst
        local real bdmg
        local integer best
        if not DEAL_FLAG_ATTACKING then
return true
        endif
        if DEAL_FLAG_LOGIC then
return true
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set this=s__EV104SpecialTower_getThis(GetUnitUserData(src))
        set best=FXRD_SERVANT_BEST[s__EV104SpecialTower_myId[this]]
        if best > 0 then
            if s__EV104SpecialTower_prevTarget[this] == dst then
                set s__EV104SpecialTower_curAlpha[this]=s__EV104SpecialTower_maxAlpha[this]
                call SetLightningColor(s__EV104SpecialTower_myBeam[this], 1, 1, 1, s__EV104SpecialTower_curAlpha[this])
                call MoveLightningEx(s__EV104SpecialTower_myBeam[this], true, s__EV104SpecialTower_ox[this], s__EV104SpecialTower_oy[this], 900, GetUnitX(dst), GetUnitY(dst), 60)
                if s__EV104SpecialTower_isCharged[this] > 0 then
                    set bdmg=50 + GetPlayerTechCount(GetOwningPlayer(src), 'R0TO', false) * 50
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", dst, "origin"))
                    call s__enemy_dealLogic(src , dst , bdmg * 0.10 * s__EV104SpecialTower_isCharged[this] , WEAPON_TYPE_WHOKNOWS , 0)
                endif
                call s__tick_start(s__EV104SpecialTower_weakTick[this],0.10 , true , function s__EV104SpecialTower_onChargeWeak)
            else
                set s__EV104SpecialTower_prevTarget[this]=dst
                set s__EV104SpecialTower_isCharged[this]=0
                set s__EV104SpecialTower_maxAlpha[this]=0
                set s__EV104SpecialTower_curAlpha[this]=0
                call SetLightningColor(s__EV104SpecialTower_myBeam[this], 255, 255, 255, 0)
                call s__tick_start(s__EV104SpecialTower_chargeTick[this],3.00 , true , function s__EV104SpecialTower_onChargeComp)
            endif
        endif
        set src=null
        set dst=null
   return true
endfunction
function sa__EV104SpecialTower_onSourceUnitRemove takes nothing returns boolean

        local integer this= s__EV104SpecialTower_getThis(s__EVUnitRemove_e)
        call DestroyLightning(s__EV104SpecialTower_myBeam[this])
        set s__EV104SpecialTower_myBeam[this]=null
        set s__EV104SpecialTower_prevTarget[this]=null
        call s__tick_destroy(s__EV104SpecialTower_chargeTick[this])
        call s__tick_destroy(s__EV104SpecialTower_weakTick[this])
        set s__EV104SpecialTower_myServant[this]=null
        call TriggerUnbindAction(s__EV104SpecialTower_onRemoveAction[this])
        set s__EV104SpecialTower_onRemoveAction[this]=null
        call s__EV104SpecialTower_destroy(this)
   return true
endfunction
