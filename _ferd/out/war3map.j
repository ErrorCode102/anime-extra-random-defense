//textmacro instance: 어빌리티_선언_개시("EXDrakeAttack")
//end of: 어빌리티_선언_개시("EXDrakeAttack")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILEXDrakeAttack_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXDrakeAttack_rmTrig[this], s__ABILEXDrakeAttack_rmAct[this])
        set s__ABILEXDrakeAttack_rmAct[this]=null
        set s__ABILEXDrakeAttack_rmTrig[this]=null
        call sc__ABILEXDrakeAttack_onAbilityLost(this)
        set s__ABILEXDrakeAttack_source[this]=null
        set s__ABILEXDrakeAttack_exists[this]=false
    endfunction
    
    function s__ABILEXDrakeAttack_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXDrakeAttack_free(this)
    endfunction
    
    function s__ABILEXDrakeAttack_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILEXDrakeAttack_onAbilityEffect(this)
    endfunction
    
    function s__ABILEXDrakeAttack_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXDrakeAttack_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXDrakeAttack_exists[this] then
            set s__ABILEXDrakeAttack_exists[this]=true
            set s__ABILEXDrakeAttack_source[this]=src
            set s__ABILEXDrakeAttack_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXDrakeAttack_rmAct[this]=TriggerAddAction(s__ABILEXDrakeAttack_rmTrig[this], function s__ABILEXDrakeAttack_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILEXDrakeAttack_onSourceUnitAttack)
            call sc__ABILEXDrakeAttack_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
        function s__ABILEXDrakeAttack_OnBuffCheck takes nothing returns nothing
            local integer this= GetHandleUserData(GetExpiredTimer())
            if this == 0 then
                return
            endif
            if not s__ABILEXDrakeAttack_DoBoost[this] then
                return
            endif
            set s__ABILEXDrakeAttack_DoBoost[this]=false
            call sc__BUFFEXDrakeBoost_apply(s__ABILEXDrakeAttack_source[this] , 5.0)
        endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXDrakeAttack_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXDrakeAttack_DoBoost[this]=false
        set s__ABILEXDrakeAttack_BoostTimer[this]=CreateTimer()
        call SetHandleUserData(s__ABILEXDrakeAttack_BoostTimer[this] , this)
        call TimerStart(s__ABILEXDrakeAttack_BoostTimer[this], 1.0, true, function s__ABILEXDrakeAttack_OnBuffCheck)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXDrakeAttack_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        set s__ABILEXDrakeAttack_DoBoost[this]=false
        call ClearHandleUserData(s__ABILEXDrakeAttack_BoostTimer[this])
        call DestroyTimer(s__ABILEXDrakeAttack_BoostTimer[this])
        set s__ABILEXDrakeAttack_BoostTimer[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXDrakeAttack_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit source= GetTriggerUnit()
        local unit target= GetEventDamageSource()
        call s__enemy_dealLogic(source , target , sc__EVDamageManager_getFinalDamage(source) , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        if GetRandomInt(0, 100) < 5 then
            set s__ABILEXDrakeAttack_DoBoost[this]=true
        endif
        set source=null
        set target=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("EXDrakeCannons")
//end of: 어빌리티_선언_개시("EXDrakeCannons")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILEXDrakeCannons_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXDrakeCannons_rmTrig[this], s__ABILEXDrakeCannons_rmAct[this])
        set s__ABILEXDrakeCannons_rmAct[this]=null
        set s__ABILEXDrakeCannons_rmTrig[this]=null
        call sc__ABILEXDrakeCannons_onAbilityLost(this)
        call s__tick_destroy(s__ABILEXDrakeCannons_durTik[this])
        set s__ABILEXDrakeCannons_source[this]=null
        set s__ABILEXDrakeCannons_exists[this]=false
    endfunction
    
    function s__ABILEXDrakeCannons_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXDrakeCannons_free(this)
    endfunction
    
    function s__ABILEXDrakeCannons_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILEXDrakeCannons_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILEXDrakeCannons_source[this]) then
            return
        endif
        call sc__ABILEXDrakeCannons_onAbilityEffect(this)
        call s__tick_start(s__ABILEXDrakeCannons_durTik[this],s__ABILEXDrakeCannons_duration[this] , false , function s__ABILEXDrakeCannons_onExpire)
    endfunction
    
    function s__ABILEXDrakeCannons_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXDrakeCannons_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXDrakeCannons_exists[this] then
            set s__ABILEXDrakeCannons_exists[this]=true
            set s__ABILEXDrakeCannons_source[this]=src
            set s__ABILEXDrakeCannons_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXDrakeCannons_rmAct[this]=TriggerAddAction(s__ABILEXDrakeCannons_rmTrig[this], function s__ABILEXDrakeCannons_OnSourceRemove)
            
            set s__ABILEXDrakeCannons_duration[this]=dur
            set s__ABILEXDrakeCannons_defaultDuration[this]=dur
            set s__ABILEXDrakeCannons_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILEXDrakeCannons_durTik[this],dur , false , function s__ABILEXDrakeCannons_onExpire)
            call sc__ABILEXDrakeCannons_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXDrakeCannons_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXDrakeCannons_HasCannon[this]=false
        set s__ABILEXDrakeCannons_SHIP[this]=null
        set s__ABILEXDrakeCannons_CANNON0[this]=null
        set s__ABILEXDrakeCannons_CANNON1[this]=null
        set s__ABILEXDrakeCannons_CANNON2[this]=null
        set s__ABILEXDrakeCannons_CANNON3[this]=null
        set s__ABILEXDrakeCannons_PrevBonus[this]=0
        call sc__EVDamageManager_addAdditive(s__ABILEXDrakeCannons_source[this] , s__ABILEXDrakeCannons_PrevBonus[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXDrakeCannons_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        call KillUnit(s__ABILEXDrakeCannons_SHIP[this])
        if not IsUnitDead(s__ABILEXDrakeCannons_CANNON0[this]) then
            call s__servant_kill(s__ABILEXDrakeCannons_CANNON0[this] , false)
        endif
        if not IsUnitDead(s__ABILEXDrakeCannons_CANNON1[this]) then
            call s__servant_kill(s__ABILEXDrakeCannons_CANNON1[this] , false)
        endif
        if not IsUnitDead(s__ABILEXDrakeCannons_CANNON2[this]) then
            call s__servant_kill(s__ABILEXDrakeCannons_CANNON2[this] , false)
        endif
        if not IsUnitDead(s__ABILEXDrakeCannons_CANNON3[this]) then
            call s__servant_kill(s__ABILEXDrakeCannons_CANNON3[this] , false)
        endif
        set s__ABILEXDrakeCannons_SHIP[this]=null
        set s__ABILEXDrakeCannons_CANNON0[this]=null
        set s__ABILEXDrakeCannons_CANNON1[this]=null
        set s__ABILEXDrakeCannons_CANNON2[this]=null
        set s__ABILEXDrakeCannons_CANNON3[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXDrakeCannons_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILEXDrakeCannons_source[this])
        local real x= GetUnitX(s__ABILEXDrakeCannons_source[this])
        local real y= GetUnitY(s__ABILEXDrakeCannons_source[this])
        call sc__EVDamageManager_addAdditive(s__ABILEXDrakeCannons_source[this] , - s__ABILEXDrakeCannons_PrevBonus[this])
        set s__ABILEXDrakeCannons_PrevBonus[this]=GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) / 4
        call sc__EVDamageManager_addAdditive(s__ABILEXDrakeCannons_source[this] , s__ABILEXDrakeCannons_PrevBonus[this])
        if not s__ABILEXDrakeCannons_HasCannon[this] then
            set s__ABILEXDrakeCannons_HasCannon[this]=true
            set s__ABILEXDrakeCannons_SHIP[this]=CreateUnit(FX_PLAYER_DUMMY, 'o02O', x, y, 270.0)
            call SetUnitColor(s__ABILEXDrakeCannons_SHIP[this], GetPlayerColor(p))
            call SetUnitVertexColor(s__ABILEXDrakeCannons_SHIP[this], 255, 255, 255, 64)
            set x=x + GetRandomReal(- 256.0, 256.0)
            set y=y + GetRandomReal(- 256.0, 256.0)
            set s__ABILEXDrakeCannons_CANNON0[this]=CreateUnit(p, 'h015', x, y, GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            call s__servant_add(p , s__ABILEXDrakeCannons_CANNON0[this] , s__servant_QUIET)
            set x=x + GetRandomReal(- 256.0, 256.0)
            set y=y + GetRandomReal(- 256.0, 256.0)
            set s__ABILEXDrakeCannons_CANNON1[this]=CreateUnit(p, 'h015', x, y, GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            call s__servant_add(p , s__ABILEXDrakeCannons_CANNON1[this] , s__servant_QUIET)
            set x=x + GetRandomReal(- 256.0, 256.0)
            set y=y + GetRandomReal(- 256.0, 256.0)
            set s__ABILEXDrakeCannons_CANNON2[this]=CreateUnit(p, 'h015', x, y, GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            call s__servant_add(p , s__ABILEXDrakeCannons_CANNON2[this] , s__servant_QUIET)
            set x=x + GetRandomReal(- 256.0, 256.0)
            set y=y + GetRandomReal(- 256.0, 256.0)
            set s__ABILEXDrakeCannons_CANNON3[this]=CreateUnit(p, 'h015', x, y, GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            call s__servant_add(p , s__ABILEXDrakeCannons_CANNON3[this] , s__servant_QUIET)
        else
            set x=x - s__Polar_X(256.0 , GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            set y=y - s__Polar_Y(256.0 , GetUnitFacing(s__ABILEXDrakeCannons_source[this]))
            if not IsUnitInRangeXY(s__ABILEXDrakeCannons_SHIP[this], x, y, 256.0) then
                call IssuePointOrder(s__ABILEXDrakeCannons_SHIP[this], "move", x, y)
            endif
            set x=GetUnitX(s__ABILEXDrakeCannons_SHIP[this])
            set y=GetUnitY(s__ABILEXDrakeCannons_SHIP[this])
            call SetSafeXY(x + GetRandomReal(- 128.0, 128.0) , y + GetRandomReal(- 128.0, 128.0))
            call SetUnitPosition(s__ABILEXDrakeCannons_CANNON0[this], GetSafeX(), GetSafeY())
            call SetUnitFlyHeight(s__ABILEXDrakeCannons_CANNON0[this], GetRandomReal(90.0, 150.0), 0.0)
            call SetSafeXY(x + GetRandomReal(- 128.0, 128.0) , y + GetRandomReal(- 128.0, 128.0))
            call SetUnitPosition(s__ABILEXDrakeCannons_CANNON1[this], GetSafeX(), GetSafeY())
            call SetUnitFlyHeight(s__ABILEXDrakeCannons_CANNON1[this], GetRandomReal(90.0, 150.0), 0.0)
            call SetSafeXY(x + GetRandomReal(- 128.0, 128.0) , y + GetRandomReal(- 128.0, 128.0))
            call SetUnitPosition(s__ABILEXDrakeCannons_CANNON2[this], GetSafeX(), GetSafeY())
            call SetUnitFlyHeight(s__ABILEXDrakeCannons_CANNON2[this], GetRandomReal(90.0, 150.0), 0.0)
            call SetSafeXY(x + GetRandomReal(- 128.0, 128.0) , y + GetRandomReal(- 128.0, 128.0))
            call SetUnitPosition(s__ABILEXDrakeCannons_CANNON3[this], GetSafeX(), GetSafeY())
            call SetUnitFlyHeight(s__ABILEXDrakeCannons_CANNON3[this], GetRandomReal(90.0, 150.0), 0.0)
            if GetUnitAbilityLevel(s__ABILEXDrakeCannons_source[this], 'A0HI') > 0 then
                call sc__BUFFEXDrakeBoost_apply(s__ABILEXDrakeCannons_CANNON0[this] , 1.1)
                call sc__BUFFEXDrakeBoost_apply(s__ABILEXDrakeCannons_CANNON1[this] , 1.1)
                call sc__BUFFEXDrakeBoost_apply(s__ABILEXDrakeCannons_CANNON2[this] , 1.1)
                call sc__BUFFEXDrakeBoost_apply(s__ABILEXDrakeCannons_CANNON3[this] , 1.1)
            endif
        endif
        set p=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　서번트 버프
//==================================================================
//textmacro instance: 버프_선언_개시("EXDrakeBoost")
//end of: 버프_선언_개시("EXDrakeBoost")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFEXDrakeBoost_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFEXDrakeBoost_exist[this] then
            set s__BUFFEXDrakeBoost_exist[this]=true
            set s__BUFFEXDrakeBoost_running[this]=false
            set s__BUFFEXDrakeBoost_source[this]=src
            set s__BUFFEXDrakeBoost_duration[this]=dur
            set s__BUFFEXDrakeBoost_durationTimer[this]=s__tick_create(this)
            set s__BUFFEXDrakeBoost_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFEXDrakeBoost_rmAct[this]=TriggerAddAction(s__BUFFEXDrakeBoost_rmTrig[this], function sc__BUFFEXDrakeBoost_onSourceRemove)
        endif
        if s__BUFFEXDrakeBoost_running[this] then
            if dur < s__tick__get_remaining(s__BUFFEXDrakeBoost_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFEXDrakeBoost_running[this]=true
            call sc__BUFFEXDrakeBoost_onBuffStart(this)
        endif
        set s__BUFFEXDrakeBoost_duration[this]=dur
        call sc__BUFFEXDrakeBoost_onBuffRefresh(this)
        call s__tick_start(s__BUFFEXDrakeBoost_durationTimer[this],s__BUFFEXDrakeBoost_duration[this] , false , function sc__BUFFEXDrakeBoost_onExpire)
    endfunction
    function s__BUFFEXDrakeBoost_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFEXDrakeBoost_running[this]=false
        call sc__BUFFEXDrakeBoost_onBuffEnd(this)
    endfunction
    function s__BUFFEXDrakeBoost_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFEXDrakeBoost_rmTrig[this], s__BUFFEXDrakeBoost_rmAct[this])
        set s__BUFFEXDrakeBoost_rmAct[this]=null
        set s__BUFFEXDrakeBoost_rmTrig[this]=null
        if s__BUFFEXDrakeBoost_running[this] then
            set s__BUFFEXDrakeBoost_running[this]=false
            call sc__BUFFEXDrakeBoost_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFEXDrakeBoost_durationTimer[this])
        set s__BUFFEXDrakeBoost_source[this]=null
        set s__BUFFEXDrakeBoost_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFEXDrakeBoost_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFEXDrakeBoost_fx1[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", s__BUFFEXDrakeBoost_source[this], "hand left")
        set s__BUFFEXDrakeBoost_fx2[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustSpecial.mdl", s__BUFFEXDrakeBoost_source[this], "hand right")
        call UnitAddAbility(s__BUFFEXDrakeBoost_source[this], s__BUFFEXDrakeBoost_ABILITY)
        call sc__EVDamageManager_addBonus(s__BUFFEXDrakeBoost_source[this] , s__BUFFEXDrakeBoost_ATBO)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFEXDrakeBoost_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFEXDrakeBoost_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFEXDrakeBoost_source[this]) then
            call sc__EVDamageManager_addBonus(s__BUFFEXDrakeBoost_source[this] , - s__BUFFEXDrakeBoost_ATBO)
            call UnitRemoveAbility(s__BUFFEXDrakeBoost_source[this], s__BUFFEXDrakeBoost_ABILITY)
            call UnitRemoveAbility(s__BUFFEXDrakeBoost_source[this], s__BUFFEXDrakeBoost_BUFF)
        endif
        call DestroyEffect(s__BUFFEXDrakeBoost_fx1[this])
        call DestroyEffect(s__BUFFEXDrakeBoost_fx2[this])
        set s__BUFFEXDrakeBoost_fx1[this]=null
        set s__BUFFEXDrakeBoost_fx2[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
//end of: 버프_선언_끝()//===========================================================================
// Trigger: Servant Francis Drake Cannon
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 준_서번트_선언_개시( 코드명 )
//textmacro instance: 준_서번트_선언_개시("DRAKECANNONSPAWN")
// scope SVDRAKECANNONSPAWN begins
//end of: 준_서번트_선언_개시("DRAKECANNONSPAWN")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVDRAKECANNONSPAWN__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call FXRD_FXDebuffShock(dst , 0.1)
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVDRAKECANNONSPAWN__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVDRAKECANNONSPAWN__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVDRAKECANNONSPAWN__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVDRAKECANNONSPAWN__MeleeAttack)
            //
            //call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl",GetUnitX(eventServantAdd.e),GetUnitY(eventServantAdd.e)))
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVDRAKECANNONSPAWN__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVDRAKECANNONSPAWN__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVDRAKECANNONSPAWN__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVDRAKECANNONSPAWN__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록_확장("h015","7","1150","Anylevel")
        set SVDRAKECANNONSPAWN__SERVANT_DAMAGE[7]=1150
        call s__eventServantAdd_register('h015' , function SVDRAKECANNONSPAWN__Anylevel)
//end of: 서번트_등록_확장("h015","7","1150","Anylevel")
        
//textmacro instance: 서번트_선언_끝()//===========================================================================
    endfunction
// scope SVDRAKECANNONSPAWN ends
//end of: 서번트_선언_끝()//===========================================================================
// Trigger: Common Francis
//===========================================================================
    function s__CMCannonMissle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__enemy_dealLogic(s__CMCannonMissle_caster[this] , GetEnumUnit() , s__CMCannonMissle_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function s__CMCannonMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__splash_range(s__splash_ENEMY , s__CMCannonMissle_caster[this] , s__CMCannonMissle_myX[this] , s__CMCannonMissle_myY[this] , 300 , function s__CMCannonMissle_enumDealt)
        call KillUnit(s__CMCannonMissle_myDummy[this])
        set s__CMCannonMissle_myDummy[this]=null
        set s__CMCannonMissle_caster[this]=null
        call s__tick_destroy(s__CMCannonMissle_main[this])
    endfunction
    function s__CMCannonMissle_cast takes unit src,real tx,real ty,real dmg,unit dum returns nothing
        local integer this= s__tick_create(0)
        set s__CMCannonMissle_caster[this]=src
        set s__CMCannonMissle_myX[this]=tx
        set s__CMCannonMissle_myY[this]=ty
        set s__CMCannonMissle_damage[this]=dmg
        set s__CMCannonMissle_main[this]=this
        set s__CMCannonMissle_myDummy[this]=CreateUnit(Player(15), 'o010', GetUnitX(dum), GetUnitY(dum), GetUnitFacing(dum))
        call sc__DummyKnockback_cast(s__CMCannonMissle_myDummy[this] , s__Distance_WBP(dum , tx , ty) , s__Angle_WBP(dum , tx , ty) , 300 , 1.00)
        call s__tick_start(s__CMCannonMissle_main[this],1.00 , false , function s__CMCannonMissle_onFire)
    endfunction

    function s__CMCannonSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMCannonSingle_myDummy[this])
        call ShowUnit(s__CMCannonSingle_myDummy[this], false)
        set s__CMCannonSingle_myDummy[this]=null
        set s__CMCannonSingle_caster[this]=null
        call s__tick_destroy(s__CMCannonSingle_main[this])
    endfunction
    function s__CMCannonSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__CMCannonMissle_cast(s__CMCannonSingle_caster[this] , s__CMCannonSingle_myX[this] , s__CMCannonSingle_myY[this] , s__CMCannonSingle_damage[this] , s__CMCannonSingle_myDummy[this])
        call sc__DummyColorChanger_cast(s__CMCannonSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMCannonSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMCannonSingle_main[this],0.20 , false , function s__CMCannonSingle_onFinal)
    endfunction
    function s__CMCannonSingle_cast takes unit src,real tx,real ty,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real dis= GetRandomReal(100.00, 400.00)
        local real ang= s__Angle_WBP(src , tx , ty) - 180 + GetRandomReal(- 90, 90)
        set s__CMCannonSingle_caster[this]=src
        set s__CMCannonSingle_myX[this]=tx
        set s__CMCannonSingle_myY[this]=ty
        set s__CMCannonSingle_damage[this]=dmg
        set s__CMCannonSingle_main[this]=this
        call SetSafeXY(GetUnitX(src) + s__Polar_X(dis , ang) , GetUnitY(src) + s__Polar_Y(dis , ang))
        set ang=s__Angle_PBP(GetSafeX() , GetSafeY() , tx , ty)
        set s__CMCannonSingle_myDummy[this]=CreateUnit(Player(15), 'o00Z', GetSafeX(), GetSafeY(), ang)
        call sc__DummyColorChanger_cast(s__CMCannonSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMCannonSingle_myDummy[this], "attack")
        call s__tick_start(s__CMCannonSingle_main[this],0.20 , false , function s__CMCannonSingle_onFire)
    endfunction

    //
    function s__CMCannon_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__CMCannon_CNT) == 0 then
            set s__CMCannon_DEST=GetEnumUnit()
        endif
        set s__CMCannon_CNT=s__CMCannon_CNT + 1
    endfunction
    function s__CMCannon_GetRandomEnemy takes unit src,real x,real y,real r returns unit
        set s__CMCannon_DEST=null
        set s__CMCannon_CNT=0
        call s__splash_range(s__splash_ENEMY , src , x , y , r , function s__CMCannon_enumGetTarget)
        return s__CMCannon_DEST
    endfunction
    //
    function s__CMCannon_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMCannon_loops[this] < 1 or IsUnitType(s__CMCannon_caster[this], UNIT_TYPE_DEAD) then
            set s__CMCannon_caster[this]=null
            call s__tick_destroy(s__CMCannon_main[this])
            return
        endif
        call s__CMCannon_GetRandomEnemy(s__CMCannon_caster[this] , GetUnitX(s__CMCannon_caster[this]) , GetUnitY(s__CMCannon_caster[this]) , GetUnitAcquireRange(s__CMCannon_caster[this]) + 100)
        if s__CMCannon_DEST != null then
            call s__CMCannonSingle_cast(s__CMCannon_caster[this] , GetUnitX(s__CMCannon_DEST) , GetUnitY(s__CMCannon_DEST) , s__CMCannon_damage[this])
        endif
        set s__CMCannon_DEST=null
        set s__CMCannon_loops[this]=s__CMCannon_loops[this] - 1
    endfunction
    function s__CMCannon_cast takes unit src,real dmg,integer cmb returns nothing
        local integer this= s__tick_create(0)
        set s__CMCannon_caster[this]=src
        set s__CMCannon_damage[this]=dmg
        set s__CMCannon_loops[this]=cmb
        set s__CMCannon_main[this]=this
        call s__tick_start(s__CMCannon_main[this],0.20 , true , function s__CMCannon_onFireStart)
    endfunction
// Trigger: Servant Gawain
