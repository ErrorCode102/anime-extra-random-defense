    endfunction
    
    function s__ABILTSCharm_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILTSCharm_exists[this] then
            return
        endif
        call sc__ABILTSCharm_onAbilityEffect(this)
    endfunction
    
    function s__ABILTSCharm_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILTSCharm_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0FF")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILTSCharm_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILTSCharm_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILTSCharm_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call FXRD_FXPauseShield(GetSpellTargetUnit() , 5.00)
        call FXRD_FXDebuffShock(GetSpellTargetUnit() , 5.00)
        call sc__BUFFTSCharm_apply(GetTriggerUnit() , GetSpellTargetUnit() , 1.00 , 5)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("TSGoddessMetamorphosis")
//end of: 어빌리티_선언_개시("TSGoddessMetamorphosis")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0FG")
    
    function s__ABILTSGoddessMetamorphosis_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILTSGoddessMetamorphosis_onSpellEffect[this], s__ABILTSGoddessMetamorphosis_onSpellEffectAction[this])
        set s__ABILTSGoddessMetamorphosis_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILTSGoddessMetamorphosis_onSpellEffect[this])
        set s__ABILTSGoddessMetamorphosis_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILTSGoddessMetamorphosis_rmTrig[this], s__ABILTSGoddessMetamorphosis_rmAct[this])
        set s__ABILTSGoddessMetamorphosis_rmAct[this]=null
        set s__ABILTSGoddessMetamorphosis_rmTrig[this]=null
        call sc__ABILTSGoddessMetamorphosis_onAbilityLost(this)
        set s__ABILTSGoddessMetamorphosis_source[this]=null
        set s__ABILTSGoddessMetamorphosis_exists[this]=false
    endfunction
    
    function s__ABILTSGoddessMetamorphosis_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILTSGoddessMetamorphosis_free(this)
    endfunction
    
    function s__ABILTSGoddessMetamorphosis_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILTSGoddessMetamorphosis_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILTSGoddessMetamorphosis_exists[this] then
            set s__ABILTSGoddessMetamorphosis_exists[this]=true
            set s__ABILTSGoddessMetamorphosis_source[this]=src
            set s__ABILTSGoddessMetamorphosis_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILTSGoddessMetamorphosis_rmAct[this]=TriggerAddAction(s__ABILTSGoddessMetamorphosis_rmTrig[this], function s__ABILTSGoddessMetamorphosis_OnSourceRemove)
            set s__ABILTSGoddessMetamorphosis_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILTSGoddessMetamorphosis_onSpellEffect[this], Condition(function sc__ABILTSGoddessMetamorphosis_conditionSpellEffect))
            set s__ABILTSGoddessMetamorphosis_onSpellEffectAction[this]=TriggerAddAction(s__ABILTSGoddessMetamorphosis_onSpellEffect[this], function sc__ABILTSGoddessMetamorphosis_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILTSGoddessMetamorphosis_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILTSGoddessMetamorphosis_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILTSGoddessMetamorphosis_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILTSGoddessMetamorphosis_exists[this] then
            return
        endif
        call sc__ABILTSGoddessMetamorphosis_onAbilityEffect(this)
    endfunction
    
    function s__ABILTSGoddessMetamorphosis_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILTSGoddessMetamorphosis_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0FG")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILTSGoddessMetamorphosis_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILTSGoddessMetamorphosis_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILTSGoddessMetamorphosis_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetTriggerUnit(), "origin"))
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, 50.00)
        call sc__BUFFTSGoddessMetamorphosis_apply(GetTriggerUnit() , 5.00)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("TSGoddessMetamorphosis")
//end of: 버프_선언_개시("TSGoddessMetamorphosis")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFTSGoddessMetamorphosis_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFTSGoddessMetamorphosis_exist[this] then
            set s__BUFFTSGoddessMetamorphosis_exist[this]=true
            set s__BUFFTSGoddessMetamorphosis_running[this]=false
            set s__BUFFTSGoddessMetamorphosis_source[this]=src
            set s__BUFFTSGoddessMetamorphosis_duration[this]=dur
            set s__BUFFTSGoddessMetamorphosis_durationTimer[this]=s__tick_create(this)
            set s__BUFFTSGoddessMetamorphosis_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFTSGoddessMetamorphosis_rmAct[this]=TriggerAddAction(s__BUFFTSGoddessMetamorphosis_rmTrig[this], function sc__BUFFTSGoddessMetamorphosis_onSourceRemove)
        endif
        if s__BUFFTSGoddessMetamorphosis_running[this] then
            if dur < s__tick__get_remaining(s__BUFFTSGoddessMetamorphosis_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFTSGoddessMetamorphosis_running[this]=true
            call sc__BUFFTSGoddessMetamorphosis_onBuffStart(this)
        endif
        set s__BUFFTSGoddessMetamorphosis_duration[this]=dur
        call sc__BUFFTSGoddessMetamorphosis_onBuffRefresh(this)
        call s__tick_start(s__BUFFTSGoddessMetamorphosis_durationTimer[this],s__BUFFTSGoddessMetamorphosis_duration[this] , false , function sc__BUFFTSGoddessMetamorphosis_onExpire)
    endfunction
    function s__BUFFTSGoddessMetamorphosis_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFTSGoddessMetamorphosis_running[this]=false
        call sc__BUFFTSGoddessMetamorphosis_onBuffEnd(this)
    endfunction
    function s__BUFFTSGoddessMetamorphosis_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFTSGoddessMetamorphosis_rmTrig[this], s__BUFFTSGoddessMetamorphosis_rmAct[this])
        set s__BUFFTSGoddessMetamorphosis_rmAct[this]=null
        set s__BUFFTSGoddessMetamorphosis_rmTrig[this]=null
        if s__BUFFTSGoddessMetamorphosis_running[this] then
            set s__BUFFTSGoddessMetamorphosis_running[this]=false
            call sc__BUFFTSGoddessMetamorphosis_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFTSGoddessMetamorphosis_durationTimer[this])
        set s__BUFFTSGoddessMetamorphosis_source[this]=null
        set s__BUFFTSGoddessMetamorphosis_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
    //private effect fx
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFTSGoddessMetamorphosis_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        //set .fx = AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",.source,"overhead")
        call UnitAddAbility(s__BUFFTSGoddessMetamorphosis_source[this], s__BUFFTSGoddessMetamorphosis_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFTSGoddessMetamorphosis_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
        // 기간제 기절/넉백 면역 효과 습득
        call FXRD_FXImmuneStunTimed(s__BUFFTSGoddessMetamorphosis_source[this] , s__BUFFTSGoddessMetamorphosis_duration[this])
        call FXRD_FXImmuneKnockbackTimed(s__BUFFTSGoddessMetamorphosis_source[this] , s__BUFFTSGoddessMetamorphosis_duration[this])
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFTSGoddessMetamorphosis_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFTSGoddessMetamorphosis_source[this]) then
            call UnitRemoveAbility(s__BUFFTSGoddessMetamorphosis_source[this], s__BUFFTSGoddessMetamorphosis_ABILITY)
            call UnitRemoveAbility(s__BUFFTSGoddessMetamorphosis_source[this], s__BUFFTSGoddessMetamorphosis_BUFF)
        endif
        //call DestroyEffect(.fx)
        //set .fx = null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 버프_선언_개시("TSCharm")
//end of: 버프_선언_개시("TSCharm")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩됨()
    function s__BUFFTSCharm_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= s__tick_create(0)
        set s__BUFFTSCharm_source[this]=src
        set s__BUFFTSCharm_caster[this]=cas
        set s__BUFFTSCharm_duration[this]=dur
        set s__BUFFTSCharm_count[this]=cnt
        set s__BUFFTSCharm_durationTimer[this]=this
        call sc__BUFFTSCharm_onBuffStart(this)
        call s__tick_start(s__BUFFTSCharm_durationTimer[this],s__BUFFTSCharm_duration[this] , false , function sc__BUFFTSCharm_onExpire)
    endfunction
    function s__BUFFTSCharm_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__BUFFTSCharm_source[this]) then
            call sc__BUFFTSCharm_onBuffEnd(this)
            set s__BUFFTSCharm_source[this]=null
            set s__BUFFTSCharm_caster[this]=null
            call s__tick_destroy(s__BUFFTSCharm_durationTimer[this])
            return
        endif
        if s__BUFFTSCharm_count[this] > 0 then
            set s__BUFFTSCharm_count[this]=s__BUFFTSCharm_count[this] - 1
        endif
        call sc__BUFFTSCharm_onBuffEffect(this)
        if s__BUFFTSCharm_count[this] == 0 then
            call sc__BUFFTSCharm_onBuffEnd(this)
            set s__BUFFTSCharm_source[this]=null
            set s__BUFFTSCharm_caster[this]=null
            call s__tick_destroy(s__BUFFTSCharm_durationTimer[this])
            return
        endif
        call s__tick_start(s__BUFFTSCharm_durationTimer[this],s__BUFFTSCharm_duration[this] , false , function s__BUFFTSCharm_onExpire)
    endfunction
//end of: 버프_종류_반복적_중첩됨()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
    //private effect fx
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFTSCharm_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        if IsUnitDead(s__BUFFTSCharm_caster[this]) then
            return
        endif
        call s__enemy_dealLogic(s__BUFFTSCharm_source[this] , s__BUFFTSCharm_caster[this] , sc__EVDamageManager_getFinalDamage(s__BUFFTSCharm_source[this]) * 5.00 , WEAPON_TYPE_WHOKNOWS , 1)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFTSCharm_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        //set .fx = AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl",.source,"overhead")
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFTSCharm_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFTSCharm_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        //call DestroyEffect(.fx)
        //set .fx = null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
//end of: 버프_선언_끝()//===========================================================================
// Trigger: Servant Tamamo Cathedral
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("TAMAMOCATHEDRAL","TC")
// scope SVTAMAMOCATHEDRAL begins
//end of: 서번트_선언_개시("TAMAMOCATHEDRAL","TC")
        
        function SVTAMAMOCATHEDRAL__SummonEnd takes nothing returns nothing
            local integer t= s__tick_getExpired()
            if not IsUnitDead(SVTAMAMOCATHEDRAL__MIR_U[t]) then
                call s__servant_kill(SVTAMAMOCATHEDRAL__MIR_U[t] , false)
            endif
            set SVTAMAMOCATHEDRAL__MIR_U[t]=null
            set SVTAMAMOCATHEDRAL__MIR_P[t]=null
            call s__tick_destroy(t)
        endfunction
        function SVTAMAMOCATHEDRAL__SummonMirror takes nothing returns nothing
            local integer t= s__tick_getExpired()
            set SVTAMAMOCATHEDRAL__MIR_U[t]=CreateUnit(SVTAMAMOCATHEDRAL__MIR_P[t], '-TCS', SVTAMAMOCATHEDRAL__MIR_X[t], SVTAMAMOCATHEDRAL__MIR_Y[t], SVTAMAMOCATHEDRAL__MIR_F[t])
            call UnitAddAbility(SVTAMAMOCATHEDRAL__MIR_U[t], 'Aloc')
            call SetUnitPropWindow(SVTAMAMOCATHEDRAL__MIR_U[t], 0.0)
            call SetUnitVertexColor(SVTAMAMOCATHEDRAL__MIR_U[t], 128, 128, 255, 128)
            call s__servant_add(SVTAMAMOCATHEDRAL__MIR_P[t] , SVTAMAMOCATHEDRAL__MIR_U[t] , s__servant_QUIET)
            call s__tick_start(t,10.0 , false , function SVTAMAMOCATHEDRAL__SummonEnd)
        endfunction

        function SVTAMAMOCATHEDRAL__KiBurst takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            local real mtpl= 1.00
            local integer t
            if GetUnitState(src, UNIT_STATE_MANA) >= 100.0 then
                if GetRandomInt(0, 1) == 0 then
                    set mtpl=8.88
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl", dst, "origin"))
                else
                    set t=s__tick_create(0)
                    set SVTAMAMOCATHEDRAL__MIR_X[t]=GetUnitX(src)
                    set SVTAMAMOCATHEDRAL__MIR_Y[t]=GetUnitY(src)
                    set SVTAMAMOCATHEDRAL__MIR_F[t]=GetUnitFacing(src)
                    set SVTAMAMOCATHEDRAL__MIR_P[t]=GetOwningPlayer(src)
                    call s__tick_start(t,0.10 , false , function SVTAMAMOCATHEDRAL__SummonMirror)
                endif
                call SetUnitState(src, UNIT_STATE_MANA, 0.0)
            else
                call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5.0)
            endif
            if GetRandomInt(0, 100) < 2 then
                call DestroyEffect(AddSpecialEffectTarget("FX Kiburst\\FX Kiburst Yellow.mdl", src, "origin"))
                call sc__BUFFGreatChaosHeaven_apply(src , 3.00)
                call FXRD_FXDebuffShock(dst , 3.00)
            endif
            call s__enemy_dealLogicEx(src , dst , sc__EVDamageManager_getFinalDamage(src) * mtpl , true , true , WEAPON_TYPE_WOOD_HEAVY_BASH , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "KiBurst")
    function SVTAMAMOCATHEDRAL__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVTAMAMOCATHEDRAL__KiBurst()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "KiBurst")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVTAMAMOCATHEDRAL__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVTAMAMOCATHEDRAL__MeleeAttack)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVTAMAMOCATHEDRAL__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVTAMAMOCATHEDRAL__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVTAMAMOCATHEDRAL__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVTAMAMOCATHEDRAL__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("6","999","Anylevel")
        set SVTAMAMOCATHEDRAL__SERVANT_DAMAGE[6]=999
        call s__eventServantAdd_register(SVTAMAMOCATHEDRAL__SERVANT_ID + FX_SERVANT_LEVEL_6 , function SVTAMAMOCATHEDRAL__Anylevel)
//end of: 서번트_등록("6","999","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVTAMAMOCATHEDRAL ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 버프_선언_개시("GreatChaosHeaven")
//end of: 버프_선언_개시("GreatChaosHeaven")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFGreatChaosHeaven_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFGreatChaosHeaven_exist[this] then
            set s__BUFFGreatChaosHeaven_exist[this]=true
            set s__BUFFGreatChaosHeaven_running[this]=false
            set s__BUFFGreatChaosHeaven_source[this]=src
            set s__BUFFGreatChaosHeaven_duration[this]=dur
            set s__BUFFGreatChaosHeaven_durationTimer[this]=s__tick_create(this)
            set s__BUFFGreatChaosHeaven_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFGreatChaosHeaven_rmAct[this]=TriggerAddAction(s__BUFFGreatChaosHeaven_rmTrig[this], function sc__BUFFGreatChaosHeaven_onSourceRemove)
        endif
        if s__BUFFGreatChaosHeaven_running[this] then
            if dur < s__tick__get_remaining(s__BUFFGreatChaosHeaven_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFGreatChaosHeaven_running[this]=true
            call sc__BUFFGreatChaosHeaven_onBuffStart(this)
        endif
        set s__BUFFGreatChaosHeaven_duration[this]=dur
        call sc__BUFFGreatChaosHeaven_onBuffRefresh(this)
        call s__tick_start(s__BUFFGreatChaosHeaven_durationTimer[this],s__BUFFGreatChaosHeaven_duration[this] , false , function sc__BUFFGreatChaosHeaven_onExpire)
    endfunction
    function s__BUFFGreatChaosHeaven_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFGreatChaosHeaven_running[this]=false
        call sc__BUFFGreatChaosHeaven_onBuffEnd(this)
    endfunction
    function s__BUFFGreatChaosHeaven_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFGreatChaosHeaven_rmTrig[this], s__BUFFGreatChaosHeaven_rmAct[this])
        set s__BUFFGreatChaosHeaven_rmAct[this]=null
        set s__BUFFGreatChaosHeaven_rmTrig[this]=null
        if s__BUFFGreatChaosHeaven_running[this] then
            set s__BUFFGreatChaosHeaven_running[this]=false
            call sc__BUFFGreatChaosHeaven_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFGreatChaosHeaven_durationTimer[this])
        set s__BUFFGreatChaosHeaven_source[this]=null
        set s__BUFFGreatChaosHeaven_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFGreatChaosHeaven_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFGreatChaosHeaven_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl", s__BUFFGreatChaosHeaven_source[this], "overhead")
        call UnitAddAbility(s__BUFFGreatChaosHeaven_source[this], s__BUFFGreatChaosHeaven_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFGreatChaosHeaven_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFGreatChaosHeaven_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFGreatChaosHeaven_source[this]) then
            call UnitRemoveAbility(s__BUFFGreatChaosHeaven_source[this], s__BUFFGreatChaosHeaven_ABILITY)
            call UnitRemoveAbility(s__BUFFGreatChaosHeaven_source[this], s__BUFFGreatChaosHeaven_BUFF)
        endif
        call DestroyEffect(s__BUFFGreatChaosHeaven_fx[this])
        set s__BUFFGreatChaosHeaven_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()//===========================================================================
//end of: 버프_선언_끝()//===========================================================================
// Trigger: Servant Void
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("VOID","VO")
// scope SVVOID begins
//end of: 서번트_선언_개시("VOID","VO")
        
//textmacro instance: 서번트_무기_일반("OnDrakenAttack")
        function SVVOID__OnDrakenAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_일반("OnDrakenAttack")
//textmacro instance: 서번트_공격방식_선언("DrakenAttack", "OnDrakenAttack")
    function SVVOID__DrakenAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVVOID__OnDrakenAttack()
    endfunction
//end of: 서번트_공격방식_선언("DrakenAttack", "OnDrakenAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVVOID__OnCvoid takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVVOID__DrakenAttack)
            call sc__EV145Trans_append(s__eventServantAdd_e , 3)
        endfunction
        
        function SVVOID__OnAvoid takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVVOID__DrakenAttack)
            call sc__EV145Trans_append(s__eventServantAdd_e , 5)
        endfunction
        
        function SVVOID__OnSSvoid takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVVOID__DrakenAttack)
            call SetUnitScale(s__eventServantAdd_e, 1.0, 1.0, 1.0)
            call SetUnitVertexColor(s__eventServantAdd_e, 255, 255, 255, 128)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0FU')
            call sc__ABILSSVoidAntiSeraph_append(s__eventServantAdd_e , 10.0)
            call sc__ABILSSVoidSummonEx_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("CVoid", "OnCvoid")
    function SVVOID__CVoid takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVVOID__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVVOID__OnCvoid()
    endfunction
//end of: 서번트_획득_이벤트_선언("CVoid", "OnCvoid")
//textmacro instance: 서번트_획득_이벤트_선언("AVoid", "OnAvoid")
    function SVVOID__AVoid takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVVOID__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVVOID__OnAvoid()
    endfunction
//end of: 서번트_획득_이벤트_선언("AVoid", "OnAvoid")
//textmacro instance: 서번트_획득_이벤트_선언("SSVoid", "OnSSvoid")
    function SVVOID__SSVoid takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVVOID__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVVOID__OnSSvoid()
    endfunction
//end of: 서번트_획득_이벤트_선언("SSVoid", "OnSSvoid")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVVOID__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("3","5","CVoid")
        set SVVOID__SERVANT_DAMAGE[3]=5
        call s__eventServantAdd_register(SVVOID__SERVANT_ID + FX_SERVANT_LEVEL_3 , function SVVOID__CVoid)
//end of: 서번트_등록("3","5","CVoid")
//textmacro instance: 서번트_등록("5","25","AVoid")
        set SVVOID__SERVANT_DAMAGE[5]=25
        call s__eventServantAdd_register(SVVOID__SERVANT_ID + FX_SERVANT_LEVEL_5 , function SVVOID__AVoid)
//end of: 서번트_등록("5","25","AVoid")
//textmacro instance: 서번트_등록("8","500","SSVoid")
        set SVVOID__SERVANT_DAMAGE[8]=500
        call s__eventServantAdd_register(SVVOID__SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVVOID__SSVoid)
//end of: 서번트_등록("8","500","SSVoid")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVVOID ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("SSVoidSummonEx")
//end of: 어빌리티_선언_개시("SSVoidSummonEx")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0FV")
    
    function s__ABILSSVoidSummonEx_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSSVoidSummonEx_onSpellEffect[this], s__ABILSSVoidSummonEx_onSpellEffectAction[this])
        set s__ABILSSVoidSummonEx_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILSSVoidSummonEx_onSpellEffect[this])
        set s__ABILSSVoidSummonEx_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILSSVoidSummonEx_rmTrig[this], s__ABILSSVoidSummonEx_rmAct[this])
        set s__ABILSSVoidSummonEx_rmAct[this]=null
        set s__ABILSSVoidSummonEx_rmTrig[this]=null
        call sc__ABILSSVoidSummonEx_onAbilityLost(this)
        set s__ABILSSVoidSummonEx_source[this]=null
        set s__ABILSSVoidSummonEx_exists[this]=false
    endfunction
    
    function s__ABILSSVoidSummonEx_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSSVoidSummonEx_free(this)
    endfunction
    
    function s__ABILSSVoidSummonEx_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSSVoidSummonEx_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSSVoidSummonEx_exists[this] then
            set s__ABILSSVoidSummonEx_exists[this]=true
            set s__ABILSSVoidSummonEx_source[this]=src
            set s__ABILSSVoidSummonEx_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSSVoidSummonEx_rmAct[this]=TriggerAddAction(s__ABILSSVoidSummonEx_rmTrig[this], function s__ABILSSVoidSummonEx_OnSourceRemove)
            set s__ABILSSVoidSummonEx_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILSSVoidSummonEx_onSpellEffect[this], Condition(function sc__ABILSSVoidSummonEx_conditionSpellEffect))
            set s__ABILSSVoidSummonEx_onSpellEffectAction[this]=TriggerAddAction(s__ABILSSVoidSummonEx_onSpellEffect[this], function sc__ABILSSVoidSummonEx_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILSSVoidSummonEx_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILSSVoidSummonEx_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILSSVoidSummonEx_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILSSVoidSummonEx_exists[this] then
            return
        endif
        call sc__ABILSSVoidSummonEx_onAbilityEffect(this)
    endfunction
    
    function s__ABILSSVoidSummonEx_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILSSVoidSummonEx_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0FV")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILSSVoidSummonEx_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILSSVoidSummonEx_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSSVoidSummonEx_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILSSVoidSummonEx_source[this])
        local real x= GetUnitX(s__ABILSSVoidSummonEx_source[this])
        local real y= GetUnitY(s__ABILSSVoidSummonEx_source[this])
        local unit u
        call UnitRemoveAbility(s__ABILSSVoidSummonEx_source[this], s__ABILSSVoidSummonEx_ABILITY)
        call UnitAddAbility(s__ABILSSVoidSummonEx_source[this], 'A0FT')
        set u=s__gacha_do(p , 7 , x , y , 270)
        call s__servant_add(p , u , s__servant_CHANGE)
        call SetUnitVertexColor(u, 32, 32, 32, 255)
        call UnitAddAbility(u, 'A0GO')
        call UnitAddAbility(u, 'A0GN')
        call sc__EVDamageManager_addBonus(u , 50)
        set u=null
        set p=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//textmacro instance: 어빌리티_선언_개시("SSVoidAntiSeraph")
//end of: 어빌리티_선언_개시("SSVoidAntiSeraph")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILSSVoidAntiSeraph_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILSSVoidAntiSeraph_rmTrig[this], s__ABILSSVoidAntiSeraph_rmAct[this])
        set s__ABILSSVoidAntiSeraph_rmAct[this]=null
        set s__ABILSSVoidAntiSeraph_rmTrig[this]=null
        call sc__ABILSSVoidAntiSeraph_onAbilityLost(this)
        call s__tick_destroy(s__ABILSSVoidAntiSeraph_durTik[this])
        set s__ABILSSVoidAntiSeraph_source[this]=null
        set s__ABILSSVoidAntiSeraph_exists[this]=false
    endfunction
    
    function s__ABILSSVoidAntiSeraph_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILSSVoidAntiSeraph_free(this)
    endfunction
    
    function s__ABILSSVoidAntiSeraph_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILSSVoidAntiSeraph_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILSSVoidAntiSeraph_source[this]) then
            return
        endif
        call sc__ABILSSVoidAntiSeraph_onAbilityEffect(this)
        call s__tick_start(s__ABILSSVoidAntiSeraph_durTik[this],s__ABILSSVoidAntiSeraph_duration[this] , false , function s__ABILSSVoidAntiSeraph_onExpire)
    endfunction
    
    function s__ABILSSVoidAntiSeraph_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILSSVoidAntiSeraph_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILSSVoidAntiSeraph_exists[this] then
            set s__ABILSSVoidAntiSeraph_exists[this]=true
            set s__ABILSSVoidAntiSeraph_source[this]=src
            set s__ABILSSVoidAntiSeraph_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILSSVoidAntiSeraph_rmAct[this]=TriggerAddAction(s__ABILSSVoidAntiSeraph_rmTrig[this], function s__ABILSSVoidAntiSeraph_OnSourceRemove)
            
            set s__ABILSSVoidAntiSeraph_duration[this]=dur
            set s__ABILSSVoidAntiSeraph_defaultDuration[this]=dur
            set s__ABILSSVoidAntiSeraph_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILSSVoidAntiSeraph_durTik[this],dur , false , function s__ABILSSVoidAntiSeraph_onExpire)
            call sc__ABILSSVoidAntiSeraph_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILSSVoidAntiSeraph_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILSSVoidAntiSeraph_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILSSVoidAntiSeraph_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call sc__CMSSVoidAntiSeraph_cast(s__ABILSSVoidAntiSeraph_source[this] , sc__EVDamageManager_getFinalDamage(s__ABILSSVoidAntiSeraph_source[this]) * 10.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　서번트 연출
//==================================================================
    function s__CMSSVoidAntiSeraph_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMSSVoidAntiSeraph_caster[this]=null
        call s__tick_destroy(s__CMSSVoidAntiSeraph_main[this])
    endfunction
    function s__CMSSVoidAntiSeraph_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl", GetEnumUnit(), "chest"))
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            call FXRD_FXDebuffShock(GetEnumUnit() , 1.00)
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 3.00)
        endif
        call s__enemy_dealLogicEx(s__CMSSVoidAntiSeraph_caster[this] , GetEnumUnit() , s__CMSSVoidAntiSeraph_damage[this] , true , true , WEAPON_TYPE_METAL_MEDIUM_BASH , 1)
    endfunction
    function s__CMSSVoidAntiSeraph_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitAlive(s__CMSSVoidAntiSeraph_caster[this]) then
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02B', GetUnitX(s__CMSSVoidAntiSeraph_caster[this]), GetUnitY(s__CMSSVoidAntiSeraph_caster[this]), 270.0))
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01F', GetUnitX(s__CMSSVoidAntiSeraph_caster[this]), GetUnitY(s__CMSSVoidAntiSeraph_caster[this]), 270.0))
            call s__splash_range(s__splash_ENEMY , s__CMSSVoidAntiSeraph_caster[this] , GetUnitX(s__CMSSVoidAntiSeraph_caster[this]) , GetUnitY(s__CMSSVoidAntiSeraph_caster[this]) , 1000.0 , function s__CMSSVoidAntiSeraph_enumDealt)
        endif
        call s__tick_start(s__CMSSVoidAntiSeraph_main[this],0.20 , false , function s__CMSSVoidAntiSeraph_onFinal)
    endfunction
    function s__CMSSVoidAntiSeraph_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMSSVoidAntiSeraph_main[this]=this
        set s__CMSSVoidAntiSeraph_caster[this]=src
        set s__CMSSVoidAntiSeraph_damage[this]=dmg
        call s__tick_start(s__CMSSVoidAntiSeraph_main[this],1.00 , true , function s__CMSSVoidAntiSeraph_onFire)
    endfunction
//===========================================================================
// Trigger: Servant Tosaka
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("TOSAKA","TO")
// scope SVTOSAKA begins
//end of: 서번트_선언_개시("TOSAKA","TO")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_일반("OnMeleeAttack")
        function SVTOSAKA__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_일반("OnMeleeAttack")
        function SVTOSAKA__OnJewletAttack takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
            call sc__FXJewlet_cast(source , GetUnitX(target) , GetUnitY(target) , sc__EVDamageManager_getFinalDamage(source))
            set source=null
            set target=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVTOSAKA__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVTOSAKA__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
//textmacro instance: 서번트_공격방식_선언("JewletAttack", "OnJewletAttack")
    function SVTOSAKA__JewletAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVTOSAKA__OnJewletAttack()
    endfunction
//end of: 서번트_공격방식_선언("JewletAttack", "OnJewletAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVTOSAKA__OnFormalLevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            //Adding Special Skillz
            if lv == 3 then
                call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVTOSAKA__MeleeAttack)
                return
            endif
            call sc__ABILTosakaLightning_append(s__eventServantAdd_e)
        endfunction
        function SVTOSAKA__OnJewlet takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVTOSAKA__JewletAttack)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("C2S", "OnFormalLevel")
    function SVTOSAKA__C2S takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVTOSAKA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVTOSAKA__OnFormalLevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("C2S", "OnFormalLevel")
//textmacro instance: 서번트_획득_이벤트_선언("EX", "OnJewlet")
    function SVTOSAKA__EX takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVTOSAKA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVTOSAKA__OnJewlet()
    endfunction
//end of: 서번트_획득_이벤트_선언("EX", "OnJewlet")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVTOSAKA__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("3","50","C2S")
        set SVTOSAKA__SERVANT_DAMAGE[3]=50
        call s__eventServantAdd_register(SVTOSAKA__SERVANT_ID + FX_SERVANT_LEVEL_3 , function SVTOSAKA__C2S)
//end of: 서번트_등록("3","50","C2S")
//textmacro instance: 서번트_등록("4","250","C2S")
        set SVTOSAKA__SERVANT_DAMAGE[4]=250
        call s__eventServantAdd_register(SVTOSAKA__SERVANT_ID + FX_SERVANT_LEVEL_4 , function SVTOSAKA__C2S)
//end of: 서번트_등록("4","250","C2S")
//textmacro instance: 서번트_등록("5","625","C2S")
        set SVTOSAKA__SERVANT_DAMAGE[5]=625
        call s__eventServantAdd_register(SVTOSAKA__SERVANT_ID + FX_SERVANT_LEVEL_5 , function SVTOSAKA__C2S)
//end of: 서번트_등록("5","625","C2S")
//textmacro instance: 서번트_등록("6","2000","C2S")
        set SVTOSAKA__SERVANT_DAMAGE[6]=2000
        call s__eventServantAdd_register(SVTOSAKA__SERVANT_ID + FX_SERVANT_LEVEL_6 , function SVTOSAKA__C2S)
//end of: 서번트_등록("6","2000","C2S")
//textmacro instance: 서번트_등록("7","11500","EX")
        set SVTOSAKA__SERVANT_DAMAGE[7]=11500
        call s__eventServantAdd_register(SVTOSAKA__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVTOSAKA__EX)
//end of: 서번트_등록("7","11500","EX")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVTOSAKA ends
//end of: 서번트_선언_끝()
//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("TosakaLightning")
//end of: 어빌리티_선언_개시("TosakaLightning")
    
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILTosakaLightning_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILTosakaLightning_rmTrig[this], s__ABILTosakaLightning_rmAct[this])
        set s__ABILTosakaLightning_rmAct[this]=null
        set s__ABILTosakaLightning_rmTrig[this]=null
        call sc__ABILTosakaLightning_onAbilityLost(this)
        set s__ABILTosakaLightning_source[this]=null
        set s__ABILTosakaLightning_exists[this]=false
    endfunction
    
    function s__ABILTosakaLightning_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILTosakaLightning_free(this)
    endfunction
    
    function s__ABILTosakaLightning_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILTosakaLightning_onAbilityEffect(this)
    endfunction
    
    function s__ABILTosakaLightning_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILTosakaLightning_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILTosakaLightning_exists[this] then
            set s__ABILTosakaLightning_exists[this]=true
            set s__ABILTosakaLightning_source[this]=src
            set s__ABILTosakaLightning_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILTosakaLightning_rmAct[this]=TriggerAddAction(s__ABILTosakaLightning_rmTrig[this], function s__ABILTosakaLightning_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILTosakaLightning_onSourceUnitAttack)
            call sc__ABILTosakaLightning_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILTosakaLightning_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        local real lv= GetUnitLevel(s__ABILTosakaLightning_source[this])
        local real x= GetUnitX(s__ABILTosakaLightning_source[this])
        local real y= GetUnitY(s__ABILTosakaLightning_source[this])
        set s__ABILTosakaLightning_myTargets[this]=2
        set s__ABILTosakaLightning_myComboMax[this]=1
        set s__ABILTosakaLightning_myDummy1[this]=CreateUnit(Player(15), 'o00H', x, y, 270.00)
        call sc__DummyOffsetUnit_cast(s__ABILTosakaLightning_myDummy1[this] , s__ABILTosakaLightning_source[this] , - 150 , 100 , 300)
        set s__ABILTosakaLightning_myDummy2[this]=CreateUnit(Player(15), 'o00H', x, y, 270.00)
        call sc__DummyOffsetUnit_cast(s__ABILTosakaLightning_myDummy2[this] , s__ABILTosakaLightning_source[this] , - 150 , - 100 , 300)
        if lv < 5 then
            return
        endif
        set s__ABILTosakaLightning_myComboMax[this]=2
        if lv < 6 then
            return
        endif
        set s__ABILTosakaLightning_myComboMax[this]=3
        set s__ABILTosakaLightning_myTargets[this]=4
        set s__ABILTosakaLightning_myDummy3[this]=CreateUnit(Player(15), 'o00H', x, y, 270.00)
        call sc__DummyOffsetUnit_cast(s__ABILTosakaLightning_myDummy3[this] , s__ABILTosakaLightning_source[this] , - 75 , 150 , 300)
        set s__ABILTosakaLightning_myDummy4[this]=CreateUnit(Player(15), 'o00H', x, y, 270.00)
        call sc__DummyOffsetUnit_cast(s__ABILTosakaLightning_myDummy4[this] , s__ABILTosakaLightning_source[this] , - 75 , - 150 , 300)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILTosakaLightning_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        call KillUnit(s__ABILTosakaLightning_myDummy1[this])
        call KillUnit(s__ABILTosakaLightning_myDummy2[this])
        call KillUnit(s__ABILTosakaLightning_myDummy3[this])
        call KillUnit(s__ABILTosakaLightning_myDummy4[this])
        set s__ABILTosakaLightning_myDummy1[this]=null
        set s__ABILTosakaLightning_myDummy2[this]=null
        set s__ABILTosakaLightning_myDummy3[this]=null
        set s__ABILTosakaLightning_myDummy4[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILTosakaLightning_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real dmg= sc__EVDamageManager_getFinalDamage(s__ABILTosakaLightning_source[this])
        //토오사카 빔캐스트
        call sc__CMLaser_cast(s__ABILTosakaLightning_source[this] , GetEventDamageSource() , dmg , s__ABILTosakaLightning_myComboMax[this] , s__ABILTosakaLightning_myDummy1[this])
        call sc__CMLaser_cast(s__ABILTosakaLightning_source[this] , GetEventDamageSource() , dmg , s__ABILTosakaLightning_myComboMax[this] , s__ABILTosakaLightning_myDummy2[this])
        if s__ABILTosakaLightning_myTargets[this] > 2 then
            call sc__CMLaser_cast(s__ABILTosakaLightning_source[this] , GetEventDamageSource() , dmg , s__ABILTosakaLightning_myComboMax[this] , s__ABILTosakaLightning_myDummy3[this])
            call sc__CMLaser_cast(s__ABILTosakaLightning_source[this] , GetEventDamageSource() , dmg , s__ABILTosakaLightning_myComboMax[this] , s__ABILTosakaLightning_myDummy4[this])
        endif
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

    function s__FXJewlet_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitInGroup(GetEnumUnit(), s__FXJewlet_myG[this]) then
            return
        endif
        call GroupAddUnit(s__FXJewlet_myG[this], GetEnumUnit())
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 3.00)
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            call s__enemy_dealLogicEx(s__FXJewlet_caster[this] , GetEnumUnit() , s__FXJewlet_damage[this] * 0.5 , true , true , WEAPON_TYPE_METAL_HEAVY_BASH , 0)
        else
            call s__enemy_dealLogicEx(s__FXJewlet_caster[this] , GetEnumUnit() , s__FXJewlet_damage[this] , true , true , WEAPON_TYPE_METAL_HEAVY_BASH , 0)
        endif
    endfunction
    function s__FXJewlet_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__FXJewlet_caster[this], UNIT_TYPE_DEAD) or s__FXJewlet_count[this] >= 10 then
            call KillUnit(s__FXJewlet_myDummy[this])
            set s__FXJewlet_myDummy[this]=null
            call GroupClear(s__FXJewlet_myG[this])
            call DestroyGroup(s__FXJewlet_myG[this])
            set s__FXJewlet_myG[this]=null
            set s__FXJewlet_caster[this]=null
            call s__tick_destroy(s__FXJewlet_main[this])
            return
        endif
        set s__FXJewlet_count[this]=s__FXJewlet_count[this] + 1
        call s__splash_range(s__splash_ENEMY , s__FXJewlet_caster[this] , GetUnitX(s__FXJewlet_myDummy[this]) , GetUnitY(s__FXJewlet_myDummy[this]) , 500 , function s__FXJewlet_enumDealt)
    endfunction
    function s__FXJewlet_cast takes unit src,real tx,real ty,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBP(src , tx , ty)
        set s__FXJewlet_caster[this]=src
        set s__FXJewlet_damage[this]=dmg
        set s__FXJewlet_count[this]=0
        set s__FXJewlet_myG[this]=CreateGroup()
        set s__FXJewlet_main[this]=this
        set s__FXJewlet_myDummy[this]=CreateUnit(Player(15), 'o028', GetUnitX(src) + s__Polar_X(200 , ang), GetUnitY(src) + s__Polar_Y(200 , ang), ang)
        call SetUnitAnimation(s__FXJewlet_myDummy[this], "birth")
        call sc__DummyKnockback_cast(s__FXJewlet_myDummy[this] , GetUnitAcquireRange(src) + 100 , ang , 0 , 0.50)
        call s__tick_start(s__FXJewlet_main[this],0.05 , true , function s__FXJewlet_onFire)
    endfunction
// Trigger: Common Tosaka
//===========================================================================
    function s__CMLaserSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMLaserSingle_caster[this]=null
        set s__CMLaserSingle_target[this]=null
        set s__CMLaserSingle_dummy[this]=null
        call s__tick_destroy(s__CMLaserSingle_mainFlow[this])
    endfunction
    function s__CMLaserSingle_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMLaserSingle_myCombo[this] <= 0 then
            call s__tick_start(s__CMLaserSingle_mainFlow[this],0.40 , false , function s__CMLaserSingle_onFinal)
            return
        endif
        set s__CMLaserSingle_myCombo[this]=s__CMLaserSingle_myCombo[this] - 1
        if not IsUnitType(s__CMLaserSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", s__CMLaserSingle_target[this], "origin"))
            call sc__DummyLightningChaser_cast("CLPB" , 1 , 1 , 1 , s__CMLaserSingle_dummy[this] , 0 , 0 , 0 , s__CMLaserSingle_target[this] , 0 , 0 , 60 , 0.30)
            call s__enemy_dealLogic(s__CMLaserSingle_caster[this] , s__CMLaserSingle_target[this] , s__CMLaserSingle_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        endif
    endfunction
    function s__CMLaserSingle_cast takes unit src,unit dst,real dmg,integer combo,unit dum returns nothing
        local integer this= s__tick_create(0)
        set s__CMLaserSingle_caster[this]=src
        set s__CMLaserSingle_target[this]=dst
        set s__CMLaserSingle_damage[this]=dmg
        set s__CMLaserSingle_myCombo[this]=combo
        set s__CMLaserSingle_dummy[this]=dum
        set s__CMLaserSingle_mainFlow[this]=this
        call s__tick_start(s__CMLaserSingle_mainFlow[this],0.20 , true , function s__CMLaserSingle_onFireStart)
    endfunction

    //
    function s__CMLaser_enumGetTarget takes nothing returns nothing
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_DEAD) then
            return
        endif
        if GetRandomInt(0, s__CMLaser_CNT) == 0 then
            set s__CMLaser_DEST=GetEnumUnit()
        endif
        set s__CMLaser_CNT=s__CMLaser_CNT + 1
    endfunction
    //
    function s__CMLaser_cast takes unit src,unit pri,real dmg,integer combo,unit dum returns nothing
        local unit dst= pri
        if IsUnitType(pri, UNIT_TYPE_UNDEAD) then
            set s__CMLaser_DEST=null
            set s__CMLaser_CNT=0
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(src) , GetUnitY(src) , GetUnitAcquireRange(src) + 100 , function s__CMLaser_enumGetTarget)
            set dst=s__CMLaser_DEST
            set s__CMLaser_DEST=null
        else
            set combo=1
        endif
        call s__CMLaserSingle_cast(src , dst , dmg , combo , dum)
        set dst=null
    endfunction
// Trigger: Servant Nursery Rhyme
