//==================================================================
//textmacro instance: 어빌리티_선언_개시("FrankenCharge")
//end of: 어빌리티_선언_개시("FrankenCharge")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0F5")
    
    function s__ABILFrankenCharge_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILFrankenCharge_onSpellEffect[this], s__ABILFrankenCharge_onSpellEffectAction[this])
        set s__ABILFrankenCharge_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILFrankenCharge_onSpellEffect[this])
        set s__ABILFrankenCharge_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILFrankenCharge_rmTrig[this], s__ABILFrankenCharge_rmAct[this])
        set s__ABILFrankenCharge_rmAct[this]=null
        set s__ABILFrankenCharge_rmTrig[this]=null
        call sc__ABILFrankenCharge_onAbilityLost(this)
        set s__ABILFrankenCharge_source[this]=null
        set s__ABILFrankenCharge_exists[this]=false
    endfunction
    
    function s__ABILFrankenCharge_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILFrankenCharge_free(this)
    endfunction
    
    function s__ABILFrankenCharge_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILFrankenCharge_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILFrankenCharge_exists[this] then
            set s__ABILFrankenCharge_exists[this]=true
            set s__ABILFrankenCharge_source[this]=src
            set s__ABILFrankenCharge_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILFrankenCharge_rmAct[this]=TriggerAddAction(s__ABILFrankenCharge_rmTrig[this], function s__ABILFrankenCharge_OnSourceRemove)
            set s__ABILFrankenCharge_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILFrankenCharge_onSpellEffect[this], Condition(function sc__ABILFrankenCharge_conditionSpellEffect))
            set s__ABILFrankenCharge_onSpellEffectAction[this]=TriggerAddAction(s__ABILFrankenCharge_onSpellEffect[this], function sc__ABILFrankenCharge_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILFrankenCharge_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILFrankenCharge_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILFrankenCharge_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILFrankenCharge_exists[this] then
            return
        endif
        call sc__ABILFrankenCharge_onAbilityEffect(this)
    endfunction
    
    function s__ABILFrankenCharge_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILFrankenCharge_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0F5")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILFrankenCharge_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILFrankenCharge_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILFrankenCharge_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetTriggerUnit(), "origin"))
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) + 200.00)
        call sc__BUFFFrankenCharge_cast(GetTriggerUnit())
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

    function s__BUFFFrankenCharge_EnumShock takes nothing returns nothing
        call FXRD_FXDebuffShock(GetEnumUnit() , 0.20)
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 2.00)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__splash__get_src() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(s__splash__get_src()) * 4 , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function s__BUFFFrankenCharge_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local integer i= 8
        local real d
        local real r
        local real x
        local real y
        if s__BUFFFrankenCharge_loops[this] < 1 or IsUnitType(s__BUFFFrankenCharge_caster[this], UNIT_TYPE_DEAD) then
            set s__BUFFFrankenCharge_caster[this]=null
            call s__tick_destroy(s__BUFFFrankenCharge_main[this])
            return
        endif
        loop
            set i=i - 1
            set d=SquareRoot(GetRandomReal(0.00, 1.00))
            set r=GetRandomReal(0.00, 360.00)
            set x=s__BUFFFrankenCharge_ox[this] + s__Polar_X(d * 800 , r)
            set y=s__BUFFFrankenCharge_oy[this] + s__Polar_Y(d * 800 , r)
            call DestroyEffect(AddSpecialEffect("V2\\Milchun\\Milchun.mdl", x, y))
            exitwhen i == 0
        endloop
        call s__splash_range(s__splash_ENEMY , s__BUFFFrankenCharge_caster[this] , s__BUFFFrankenCharge_ox[this] , s__BUFFFrankenCharge_oy[this] , 850 , function s__BUFFFrankenCharge_EnumShock)
        set s__BUFFFrankenCharge_loops[this]=s__BUFFFrankenCharge_loops[this] - 1
    endfunction
    function s__BUFFFrankenCharge_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        set s__BUFFFrankenCharge_caster[this]=src
        set s__BUFFFrankenCharge_loops[this]=5
        set s__BUFFFrankenCharge_ox[this]=GetUnitX(src)
        set s__BUFFFrankenCharge_oy[this]=GetUnitY(src)
        set s__BUFFFrankenCharge_main[this]=this
        call s__tick_start(s__BUFFFrankenCharge_main[this],0.1 , true , function s__BUFFFrankenCharge_onFireStart)
    endfunction

//textmacro instance: 어빌리티_선언_개시("FrankenTree")
//end of: 어빌리티_선언_개시("FrankenTree")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0F6")
    
    function s__ABILFrankenTree_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILFrankenTree_onSpellEffect[this], s__ABILFrankenTree_onSpellEffectAction[this])
        set s__ABILFrankenTree_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILFrankenTree_onSpellEffect[this])
        set s__ABILFrankenTree_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILFrankenTree_rmTrig[this], s__ABILFrankenTree_rmAct[this])
        set s__ABILFrankenTree_rmAct[this]=null
        set s__ABILFrankenTree_rmTrig[this]=null
        call sc__ABILFrankenTree_onAbilityLost(this)
        set s__ABILFrankenTree_source[this]=null
        set s__ABILFrankenTree_exists[this]=false
    endfunction
    
    function s__ABILFrankenTree_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILFrankenTree_free(this)
    endfunction
    
    function s__ABILFrankenTree_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILFrankenTree_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILFrankenTree_exists[this] then
            set s__ABILFrankenTree_exists[this]=true
            set s__ABILFrankenTree_source[this]=src
            set s__ABILFrankenTree_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILFrankenTree_rmAct[this]=TriggerAddAction(s__ABILFrankenTree_rmTrig[this], function s__ABILFrankenTree_OnSourceRemove)
            set s__ABILFrankenTree_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILFrankenTree_onSpellEffect[this], Condition(function sc__ABILFrankenTree_conditionSpellEffect))
            set s__ABILFrankenTree_onSpellEffectAction[this]=TriggerAddAction(s__ABILFrankenTree_onSpellEffect[this], function sc__ABILFrankenTree_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILFrankenTree_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILFrankenTree_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILFrankenTree_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILFrankenTree_exists[this] then
            return
        endif
        call sc__ABILFrankenTree_onAbilityEffect(this)
    endfunction
    
    function s__ABILFrankenTree_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILFrankenTree_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0F6")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILFrankenTree_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILFrankenTree_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILFrankenTree_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call sc__BUFFFrankenTree_cast(GetTriggerUnit() , GetSpellTargetX() , GetSpellTargetY() , GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA))
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, 0.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

    function s__BUFFFrankenTree_EnumShock takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__BUFFFrankenTree_caster[this] , GetEnumUnit() , s__BUFFFrankenTree_dmg[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__BUFFFrankenTree_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitAlive(s__BUFFFrankenTree_caster[this]) then
            call s__splash_range(s__splash_ENEMY , s__BUFFFrankenTree_caster[this] , s__BUFFFrankenTree_ox[this] , s__BUFFFrankenTree_oy[this] , 1200.0 , function s__BUFFFrankenTree_EnumShock)
        endif
        set s__BUFFFrankenTree_caster[this]=null
        call s__tick_destroy(s__BUFFFrankenTree_main[this])
    endfunction
    function s__BUFFFrankenTree_cast takes unit src,real x,real y,real mp returns nothing
        local integer this= s__tick_create(0)
        set s__BUFFFrankenTree_caster[this]=src
        set s__BUFFFrankenTree_ox[this]=x
        set s__BUFFFrankenTree_oy[this]=y
        set s__BUFFFrankenTree_dmg[this]=sc__EVDamageManager_getFinalDamage(src) * ( mp * 0.05 )
        set s__BUFFFrankenTree_main[this]=this
        call s__tick_start(s__BUFFFrankenTree_main[this],6.6 , true , function s__BUFFFrankenTree_onFireStart)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02H', x, y, 270.0))
    endfunction
// Trigger: Servant Tamamo Summer
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("TAMAMOSUMMER","TS")
// scope SVTAMAMOSUMMER begins
//end of: 서번트_선언_개시("TAMAMOSUMMER","TS")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVTAMAMOSUMMER__SummerWeapon takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
            local real mtpl= 1.00
            if GetRandomReal(0.00, 100.00) < 15.00 then
                if GetUnitAbilityLevel(source, 'A0FI') > 0 then
                    set mtpl=10.50
                    call SetUnitState(source, UNIT_STATE_MANA, GetUnitState(source, UNIT_STATE_MANA) + 15)
                else
                    set mtpl=7.00
                    call SetUnitState(source, UNIT_STATE_MANA, GetUnitState(source, UNIT_STATE_MANA) + 10)
                endif
                call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Red\\lianzhan.mdl", target, "origin"))
            else
                call SetUnitState(source, UNIT_STATE_MANA, GetUnitState(source, UNIT_STATE_MANA) + 5)
            endif
            call s__enemy_dealLogic(source , target , sc__EVDamageManager_getFinalDamage(source) * mtpl , WEAPON_TYPE_WHOKNOWS , 1)
            set source=null
            set target=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "SummerWeapon")
    function SVTAMAMOSUMMER__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVTAMAMOSUMMER__SummerWeapon()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "SummerWeapon")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVTAMAMOSUMMER__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVTAMAMOSUMMER__MeleeAttack)
            //Adding Special Skillz
            call sc__EVDamageManager_addBonus(s__eventServantAdd_e , 100)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0FD')
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0FC')
            call sc__ABILTSCharm_append(s__eventServantAdd_e)
            call sc__ABILTSGoddessMetamorphosis_append(s__eventServantAdd_e)
            call sc__ABILTSUpDownSunLight_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVTAMAMOSUMMER__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVTAMAMOSUMMER__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVTAMAMOSUMMER__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVTAMAMOSUMMER__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("7","2300","Anylevel")
        set SVTAMAMOSUMMER__SERVANT_DAMAGE[7]=2300
        call s__eventServantAdd_register(SVTAMAMOSUMMER__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVTAMAMOSUMMER__Anylevel)
//end of: 서번트_등록("7","2300","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVTAMAMOSUMMER ends
//end of: 서번트_선언_끝()
