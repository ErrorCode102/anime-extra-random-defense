//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("JEANNE","JE")
// scope SVJEANNE begins
//end of: 서번트_선언_개시("JEANNE","JE")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_마나수급형("OnMeleeAttack","5")
        function SVJEANNE__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_마나수급형("OnMeleeAttack","5")
        
    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVJEANNE__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVJEANNE__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVJEANNE__OnFormalLevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVJEANNE__MeleeAttack)
            //Adding Special Skillz
            if lv == 4 then
                call sc__EV149JeanneA_append(s__eventServantAdd_e , 5.00 , 5)
                return
            endif
            if lv == 5 then
                call sc__EV149JeanneA_append(s__eventServantAdd_e , 2.50 , 5)
                call sc__EV150JeanneB_append(s__eventServantAdd_e , 50000 , 10)
                return
            endif
            if lv == 6 then
                call sc__EV149JeanneA_append(s__eventServantAdd_e , 1.00 , 5)
                call sc__EV150JeanneB_append(s__eventServantAdd_e , 320000 , 20)
                return
            endif
        endfunction
        
        function SVJEANNE__OnExAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                call sc__EVDebuffSlow_apply(dst , 0.5)
            else
                call FXRD_FXDebuffShock(dst , 0.5)
                call sc__EVDebuffSlow_apply(dst , 1.0)
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
        
//textmacro instance: 서번트_공격방식_선언("ExAttack", "OnExAttack")
    function SVJEANNE__ExAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVJEANNE__OnExAttack()
    endfunction
//end of: 서번트_공격방식_선언("ExAttack", "OnExAttack")
        
        function SVJEANNE__OnEXJeanne takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVJEANNE__ExAttack)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0G8')
            call sc__EV149JeanneA_append(s__eventServantAdd_e , 1.0 , 5)
            call sc__ABILJeanneFire_append(s__eventServantAdd_e)
            call sc__ABILJeanneCARI_append(s__eventServantAdd_e , 1.0)
            call sc__ABILJeanneLPUC_append(s__eventServantAdd_e)
            //
            call SetUnitAnimation(s__eventServantAdd_e, "Dissipate")
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("B2S", "OnFormalLevel")
    function SVJEANNE__B2S takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVJEANNE__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVJEANNE__OnFormalLevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("B2S", "OnFormalLevel")
//textmacro instance: 서번트_획득_이벤트_선언("EX", "OnEXJeanne")
    function SVJEANNE__EX takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVJEANNE__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVJEANNE__OnEXJeanne()
    endfunction
//end of: 서번트_획득_이벤트_선언("EX", "OnEXJeanne")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVJEANNE__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("4","210","B2S")
        set SVJEANNE__SERVANT_DAMAGE[4]=210
        call s__eventServantAdd_register(SVJEANNE__SERVANT_ID + FX_SERVANT_LEVEL_4 , function SVJEANNE__B2S)
//end of: 서번트_등록("4","210","B2S")
//textmacro instance: 서번트_등록("5","525","B2S")
        set SVJEANNE__SERVANT_DAMAGE[5]=525
        call s__eventServantAdd_register(SVJEANNE__SERVANT_ID + FX_SERVANT_LEVEL_5 , function SVJEANNE__B2S)
//end of: 서번트_등록("5","525","B2S")
//textmacro instance: 서번트_등록("6","1680","B2S")
        set SVJEANNE__SERVANT_DAMAGE[6]=1680
        call s__eventServantAdd_register(SVJEANNE__SERVANT_ID + FX_SERVANT_LEVEL_6 , function SVJEANNE__B2S)
//end of: 서번트_등록("6","1680","B2S")
//textmacro instance: 서번트_등록("7","2300","EX")
        set SVJEANNE__SERVANT_DAMAGE[7]=2300
        call s__eventServantAdd_register(SVJEANNE__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVJEANNE__EX)
//end of: 서번트_등록("7","2300","EX")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVJEANNE ends
