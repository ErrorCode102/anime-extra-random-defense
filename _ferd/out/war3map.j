//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("KiaraCCCC")
//end of: 어빌리티_선언_개시("KiaraCCCC")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0D3")
    
    function s__ABILKiaraCCCC_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILKiaraCCCC_onSpellEffect[this], s__ABILKiaraCCCC_onSpellEffectAction[this])
        set s__ABILKiaraCCCC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILKiaraCCCC_onSpellEffect[this])
        set s__ABILKiaraCCCC_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILKiaraCCCC_rmTrig[this], s__ABILKiaraCCCC_rmAct[this])
        set s__ABILKiaraCCCC_rmAct[this]=null
        set s__ABILKiaraCCCC_rmTrig[this]=null
        call sc__ABILKiaraCCCC_onAbilityLost(this)
        set s__ABILKiaraCCCC_source[this]=null
        set s__ABILKiaraCCCC_exists[this]=false
    endfunction
    
    function s__ABILKiaraCCCC_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILKiaraCCCC_free(this)
    endfunction
    
    function s__ABILKiaraCCCC_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILKiaraCCCC_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILKiaraCCCC_exists[this] then
            set s__ABILKiaraCCCC_exists[this]=true
            set s__ABILKiaraCCCC_source[this]=src
            set s__ABILKiaraCCCC_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILKiaraCCCC_rmAct[this]=TriggerAddAction(s__ABILKiaraCCCC_rmTrig[this], function s__ABILKiaraCCCC_OnSourceRemove)
            set s__ABILKiaraCCCC_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILKiaraCCCC_onSpellEffect[this], Condition(function sc__ABILKiaraCCCC_conditionSpellEffect))
            set s__ABILKiaraCCCC_onSpellEffectAction[this]=TriggerAddAction(s__ABILKiaraCCCC_onSpellEffect[this], function sc__ABILKiaraCCCC_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILKiaraCCCC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILKiaraCCCC_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILKiaraCCCC_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILKiaraCCCC_exists[this] then
            return
        endif
        call sc__ABILKiaraCCCC_onAbilityEffect(this)
    endfunction
    
    function s__ABILKiaraCCCC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILKiaraCCCC_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0D3")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILKiaraCCCC_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILKiaraCCCC_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILKiaraCCCC_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitAbilityLevel(GetSpellTargetUnit(), s__BUFFCCC_ABILITY) > 0 then
            call UnitRemoveAbility(GetTriggerUnit(), s__ABILKiaraCCCC_ABILITY)
            call UnitAddAbility(GetTriggerUnit(), s__ABILKiaraCCCC_ABILITY)
            return
        endif
        call sc__BUFFCCC_apply(GetSpellTargetUnit() , s__ABILKiaraCCCC_source[this] , 1.00 , - 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("CCC")
//end of: 버프_선언_개시("CCC")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩안됨()
    function s__BUFFCCC_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFCCC_exist[this] then
            set s__BUFFCCC_exist[this]=true
            set s__BUFFCCC_source[this]=src
            set s__BUFFCCC_caster[this]=cas
            set s__BUFFCCC_duration[this]=dur
            set s__BUFFCCC_count[this]=cnt
            set s__BUFFCCC_running[this]=false
            set s__BUFFCCC_durationTimer[this]=s__tick_create(this)
            set s__BUFFCCC_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFCCC_rmAct[this]=TriggerAddAction(s__BUFFCCC_rmTrig[this], function sc__BUFFCCC_onSourceRemove)
        endif
        if s__BUFFCCC_running[this] then
            if s__BUFFCCC_count[this] < 0 then
                return
            endif
            if dur * cnt < s__BUFFCCC_count[this] * s__BUFFCCC_duration[this] then
                return
            endif
            set s__BUFFCCC_count[this]=cnt
            set s__BUFFCCC_duration[this]=dur
        else
            set s__BUFFCCC_running[this]=true
            set s__BUFFCCC_count[this]=cnt
            set s__BUFFCCC_duration[this]=dur
            call sc__BUFFCCC_onBuffStart(this)
            call s__tick_start(s__BUFFCCC_durationTimer[this],s__BUFFCCC_duration[this] , false , function sc__BUFFCCC_onExpire)
        endif
        call sc__BUFFCCC_onBuffRefresh(this)
    endfunction
    
    function s__BUFFCCC_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__BUFFCCC_source[this]) then
            set s__BUFFCCC_running[this]=false
            call sc__BUFFCCC_onBuffEnd(this)
            return
        endif
        if s__BUFFCCC_count[this] > 0 then
            set s__BUFFCCC_count[this]=s__BUFFCCC_count[this] - 1
        endif
        call sc__BUFFCCC_onBuffEffect(this)
        if s__BUFFCCC_count[this] == 0 then
            set s__BUFFCCC_running[this]=false
            call sc__BUFFCCC_onBuffEnd(this)
            return
        endif
        call s__tick_start(s__BUFFCCC_durationTimer[this],s__BUFFCCC_duration[this] , false , function s__BUFFCCC_onExpire)
    endfunction
    
    function s__BUFFCCC_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFCCC_rmTrig[this], s__BUFFCCC_rmAct[this])
        set s__BUFFCCC_rmAct[this]=null
        set s__BUFFCCC_rmTrig[this]=null
        if s__BUFFCCC_running[this] then
            set s__BUFFCCC_running[this]=false
            call sc__BUFFCCC_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFCCC_durationTimer[this])
        set s__BUFFCCC_source[this]=null
        set s__BUFFCCC_caster[this]=null
        set s__BUFFCCC_exist[this]=false
    endfunction
//end of: 버프_종류_반복적_중첩안됨()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFCCC_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFCCC_damage[this]=0
        set s__BUFFCCC_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Possession\\PossessionCaster.mdl", s__BUFFCCC_source[this], "origin")
        call UnitAddAbility(s__BUFFCCC_source[this], s__BUFFCCC_ABILITY)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
    function s__BUFFCCC_EnumKiara takes nothing returns nothing
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SludgeMissile\\SludgeMissile.mdl", GetEnumUnit(), "chest"))
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 1.00)
        call s__enemy_dealLogicEx(s__splash__get_src() , GetEnumUnit() , s__BUFFCCC_ENUM_DAMAGE , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFCCC_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        if IsUnitDead(s__BUFFCCC_caster[this]) then
            return
        endif
        set s__BUFFCCC_damage[this]=s__BUFFCCC_damage[this] + 100
        set s__BUFFCCC_ENUM_DAMAGE=s__BUFFCCC_damage[this]
        call s__splash_range(s__splash_ENEMY , s__BUFFCCC_caster[this] , GetUnitX(s__BUFFCCC_source[this]) , GetUnitY(s__BUFFCCC_source[this]) , 700 , function s__BUFFCCC_EnumKiara)
        call KillUnit(CreateUnit(Player(15), 'o02A', GetUnitX(s__BUFFCCC_source[this]), GetUnitY(s__BUFFCCC_source[this]), GetRandomReal(0.00, 360.00)))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Demon\\DemonBoltImpact\\DemonBoltImpact.mdl", s__BUFFCCC_source[this], "origin"))
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFCCC_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFCCC_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFCCC_source[this]) then
            call UnitRemoveAbility(s__BUFFCCC_source[this], s__BUFFCCC_ABILITY)
            call UnitRemoveAbility(s__BUFFCCC_source[this], s__BUFFCCC_BUFF)
        endif
        call DestroyEffect(s__BUFFCCC_fx[this])
        set s__BUFFCCC_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

    function s__FXKiara_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(s__FXKiara_myFx[this])
        set s__FXKiara_myFx[this]=null
        set s__FXKiara_caster[this]=null
        call s__tick_destroy(s__FXKiara_main[this])
    endfunction
    function s__FXKiara_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__FXKiara_caster[this], UNIT_TYPE_DEAD) then
            call ShowUnit(s__FXKiara_caster[this], true)
        endif
        call s__tick_start(s__FXKiara_main[this],3.00 , true , function s__FXKiara_onFinal)
    endfunction
    function s__FXKiara_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        call sc__EVDebuffStunServant_apply(src , 4.00)
        call ShowUnit(src, false)
        call SetSoundPosition(gg_snd_servant_spawn_rare, GetUnitX(src), GetUnitY(src), 300)
        call StartSound(gg_snd_servant_spawn_rare)
        set s__FXKiara_myFx[this]=AddSpecialEffect("FX\\BB\\CCC.mdl", GetUnitX(src), GetUnitY(src))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\FlameStrike\\FlameStrikeTarget.mdl", GetUnitX(src), GetUnitY(src)))
        //call KillUnit(CreateUnit(Player(15),'o00M',GetUnitX(src),GetUnitY(src),270))
        set s__FXKiara_caster[this]=src
        set s__FXKiara_main[this]=this
        call s__tick_start(s__FXKiara_main[this],3.00 , true , function s__FXKiara_onFire)
    endfunction
// Trigger: Servant FrankenStien
