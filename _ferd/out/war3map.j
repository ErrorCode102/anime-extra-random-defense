// Trigger: FX Trig Try Base Skillz
//===========================================================================
// scope PLAYbaseskillz begins
    function PLAYbaseskillz___onEnumTrue takes nothing returns nothing
        local real maxdmg= GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_LIFE) * PLAYbaseskillz___HPDMG
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            set maxdmg=0.0
        endif
        call s__enemy_dealLogicEx(PLAYbaseskillz___SRC , GetEnumUnit() , RMaxBJ(PLAYbaseskillz___DMG, maxdmg) , true , false , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function PLAYbaseskillz___dealTrue takes unit src,rect r,real dmg,real hpdmg returns nothing
        local unit psrc= PLAYbaseskillz___SRC
        local real pdmg= PLAYbaseskillz___DMG
        local real phpdmg= PLAYbaseskillz___HPDMG
        set PLAYbaseskillz___SRC=src
        set PLAYbaseskillz___DMG=dmg
        set PLAYbaseskillz___HPDMG=hpdmg
        call s__splash_rect(s__splash_ENEMY , PLAYbaseskillz___SRC , r , function PLAYbaseskillz___onEnumTrue)
        set PLAYbaseskillz___SRC=psrc
        set PLAYbaseskillz___DMG=pdmg
        set PLAYbaseskillz___HPDMG=phpdmg
        set psrc=null
    endfunction
    function PLAYbaseskillz___FillTo takes unit u,real r returns nothing
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetUnitX(u), GetUnitY(u)))
        call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MANA) + r)
        if GetUnitState(u, UNIT_STATE_MANA) >= GetUnitState(u, UNIT_STATE_MAX_MANA) then
            call DisplayTextToPlayer(GetOwningPlayer(u), 0.00, 0.00, "|c00ff4040Mana is full|r")
        endif
    endfunction
    function PLAYbaseskillz___mpFill takes nothing returns nothing
        call PLAYbaseskillz___FillTo(GetTriggerUnit() , 100)
    endfunction
    function PLAYbaseskillz___starFall takes rect r returns nothing
        local integer i= 0
        local real x
        local real y
        local real minx= GetRectMinX(r)
        local real maxx= GetRectMaxX(r)
        local real miny= GetRectMinY(r)
        local real maxy= GetRectMaxY(r)
        loop
            set x=GetRandomReal(minx, maxx)
            set y=GetRandomReal(miny, maxy)
            call DestroyEffect(AddSpecialEffect("V2\\Milchun\\Milchun.mdl", x, y))
            set i=i + 1
            exitwhen i == 100
        endloop
    endfunction
    function PLAYbaseskillz___starFallCast takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call PLAYbaseskillz___starFall(PLAYER_ZONE_LINE[id])
        call PLAYbaseskillz___dealTrue(GetTriggerUnit() , PLAYER_ZONE_LINE[id] , 2000.0 , 0.0)
    endfunction
    function PLAYbaseskillz___nuclear takes rect r,integer id returns nothing
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), id, x, y, 270))
    endfunction
    function PLAYbaseskillz___nuclearCast takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call PLAYbaseskillz___nuclear(PLAYER_ZONE_LINE[id] , 'h003')
        call PLAYbaseskillz___dealTrue(GetTriggerUnit() , PLAYER_ZONE_LINE[id] , 20000.0 , 0.3)
    endfunction
    function PLAYbaseskillz___boost takes player p,rect r,real d,integer id returns nothing
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        local unit u= CreateUnit(p, 'h000', x, y, 270.00)
        call UnitApplyTimedLife(u, 'BHwe', d)
        call SetUnitAnimation(u, "birth")
        call SetUnitTimeScale(u, 60.0 / d)
        if id != 0 then
            call UnitAddAbility(u, id)
        endif
        set u=null
    endfunction
    function PLAYbaseskillz___boostCast takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        call PLAYbaseskillz___boost(Player(id) , PLAYER_ZONE_LINE[id] , 10.0 , 0)
    endfunction
    
    function PLAYbaseskillz___main takes nothing returns nothing
        call s__AbilityEffectEvent_Create('A05Q' , function PLAYbaseskillz___mpFill)
        call s__AbilityEffectEvent_Create('A02B' , function PLAYbaseskillz___starFallCast)
        call s__AbilityEffectEvent_Create('A02C' , function PLAYbaseskillz___nuclearCast)
        call s__AbilityEffectEvent_Create('A02D' , function PLAYbaseskillz___boostCast)
    endfunction
