        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_EASY , 'n01F' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY + 320.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_NORMAL , 'n01G' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY + 256.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_HARD , 'n01H' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY + 192.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_BRUTAL , 'n01I' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY + 128.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_ELITE_1 , 'n01J' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY + 64.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_ELITE_2 , 'n01K' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_ELITE_3 , 'n01L' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 64.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_ELITE_4 , 'n01M' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 128.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_HELL_1 , 'n01N' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 192.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_HELL_2 , 'n01O' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 256.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_HELL_3 , 'n01P' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 320.0)
        call s__UIGameSettingV2_CreateDiffMenuSubBtnSimple(this,LEVEL_HELL_4 , 'n01Q' , CONF_UI_CENTERX + 192.0 , CONF_UI_CENTERY - 384.0)
        
        loop
            call SetUnitScale(s__UIGameSettingV2_btn_diffmenu_button[i], 0.0, 0.0, 0.0)
            call SetUnitUserData(s__UIGameSettingV2_btn_diffmenu_button[i], i)
            call ShowDestructable(s__UIGameSettingV2_spr_diffmenu_button[i], false)
            call ShowDestructable(s__UIGameSettingV2_msg_diffmenu_button[i], false)
            exitwhen i == LEVEL_MAX
            set i=i + 1
        endloop
    endfunction
    
    function s__UIGameSettingV2_destroy takes integer this returns nothing
        call ShowUnit(s__UIGameSettingV2_btn_ready[this], false)
        call KillUnit(s__UIGameSettingV2_btn_ready[this])
        call ShowUnit(s__UIGameSettingV2_btn_mode[this], false)
        call KillUnit(s__UIGameSettingV2_btn_mode[this])
        call ShowUnit(s__UIGameSettingV2_btn_diff[this], false)
        call KillUnit(s__UIGameSettingV2_btn_diff[this])
        call ShowUnit(s__UIGameSettingV2_btn_chal[this], false)
        call KillUnit(s__UIGameSettingV2_btn_chal[this])
        set s__UIGameSettingV2_btn_ready[this]=null
        set s__UIGameSettingV2_btn_mode[this]=null
        set s__UIGameSettingV2_btn_diff[this]=null
        set s__UIGameSettingV2_btn_chal[this]=null
        
        call s__UIGameSettingV2_DestroyFactionUI()
        
        call s__UIGameSettingV2_DestroyPlayerUI()
        
        call RemoveDestructable(s__UIGameSettingV2_spr_milestone[this])
        call RemoveDestructable(s__UIGameSettingV2_spr_milestone_master[this])
        call RemoveDestructable(s__UIGameSettingV2_spr_milestone_max[this])
        set s__UIGameSettingV2_spr_milestone[this]=null
        set s__UIGameSettingV2_spr_milestone_master[this]=null
        set s__UIGameSettingV2_spr_milestone_max[this]=null
        
        call sc__UIBTNLevel_destroy(s__UIGameSettingV2_spr_btndiff[this])
        call sc__UIMSGLevel_destroy(s__UIGameSettingV2_msg_btndiff[this])
        
        call RemoveDestructable(s__UIGameSettingV2_spr_btnready[this])
        call RemoveDestructable(s__UIGameSettingV2_spr_btnmode[this])
        call RemoveDestructable(s__UIGameSettingV2_msg_btnmode[this])
        call RemoveDestructable(s__UIGameSettingV2_spr_btnchal[this])
        set s__UIGameSettingV2_spr_btnready[this]=null
        set s__UIGameSettingV2_spr_btnmode[this]=null
        set s__UIGameSettingV2_msg_btnmode[this]=null
        set s__UIGameSettingV2_spr_btnchal[this]=null
        
        call s__UIGameSettingV2_DestroyChallengeUI(this)
        
        call s__UIGameSettingV2_DestroyDiffMenuUI(this)
    endfunction
    
    function s__UIGameSettingV2_create takes nothing returns integer
        //Union 객체로 할당
        local integer this= 1
        
        set s__UIGameSettingV2_btn_ready[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n001', 5632 - 192, - 320.00, 270)
        call SetUnitVertexColor(s__UIGameSettingV2_btn_ready[this], 0, 0, 0, 1)
        set s__UIGameSettingV2_btn_mode[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n003', 5888 - 192, - 320.00, 270)
        call SetUnitVertexColor(s__UIGameSettingV2_btn_mode[this], 0, 0, 0, 1)
        set s__UIGameSettingV2_btn_diff[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n004', 6144 - 192, - 320.00, 270)
        call SetUnitVertexColor(s__UIGameSettingV2_btn_diff[this], 0, 0, 0, 1)
        set s__UIGameSettingV2_btn_chal[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n005', 5632 - 192, - 384.0, 270.0)
        call SetUnitVertexColor(s__UIGameSettingV2_btn_chal[this], 0, 0, 0, 1)
        
        set s__UIGameSettingV2_spr_milestone[this]=CreateDestructableZ('B007', 5408, - 192.0, 0.0, 270, 1.50, 0)
        call ShowDestructable(s__UIGameSettingV2_spr_milestone[this], false)
        set s__UIGameSettingV2_spr_milestone_master[this]=CreateDestructableZ('B02A', 5408, - 192.0, 0.0, 270, 1.50, 0)
        call ShowDestructable(s__UIGameSettingV2_spr_milestone_master[this], false)
        set s__UIGameSettingV2_spr_milestone_max[this]=CreateDestructableZ('B02B', 5408, - 192.0, 0.0, 270, 1.50, 0)
        call ShowDestructable(s__UIGameSettingV2_spr_milestone_max[this], false)
        
        set s__UIGameSettingV2_spr_btnready[this]=CreateDestructableZ('B00B', 5632 - 192, - 320.0, 1.0, 270, 0.95, 0)
        set s__UIGameSettingV2_spr_btnmode[this]=CreateDestructableZ('B00C', 5888 - 192, - 320.0, 1.0, 270, 0.95, 0)
        call SetDestructableAnimation(s__UIGameSettingV2_spr_btnmode[this], "stand alternate")
        set s__UIGameSettingV2_msg_btnmode[this]=CreateDestructableZ('B012', 5888 - 192, - 384.0, 1.0, 270, 0.95, 0)
        
        set s__UIGameSettingV2_spr_btndiff[this]=sc__UIBTNLevel_create(6144 - 192 , - 320.0 , 270.0 , 0.95)
        set s__UIGameSettingV2_msg_btndiff[this]=sc__UIMSGLevel_create(6144 - 192 , - 384.0 , 270.0 , 0.95)
        
        set s__UIGameSettingV2_spr_btnchal[this]=CreateDestructableZ('B014', 5632 - 192, - 384.0, 1.0, 270, 0.95, 0)
        call ShowDestructable(s__UIGameSettingV2_spr_btnchal[this], false)
        
        call s__UIGameSettingV2_CreateFactionUI(this)
        
        call s__UIGameSettingV2_CreatePlayerUI(this)
        
        call s__UIGameSettingV2_CreateChallengeUI(this)
        
        call s__UIGameSettingV2_CreateDiffMenuUI(this)
        
        return this
    endfunction

    function s__UIGameSettingV2_RefreshHighlights takes integer this,player p returns nothing
        local integer myFax= FXGetPlayerCurrentFaction(p)
        if GetLocalPlayer() == p then
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_highlight[myFax], true)
            call SetDestructableAnimation(s__UIGameSettingV2_spr_highlight[myFax], ANI_BIRTH)
        endif
    endfunction
    
    function s__UIGameSettingV2_RefreshLevel takes integer this returns nothing
        local integer i= 0
        local integer fmax
        local integer myLv
        local integer myFax
        loop
            set myFax=FXGetPlayerCurrentFaction(Player(i))
            if myFax == 0 then
                set fmax=FXCountPlayerFactionMastered(Player(i))
                if fmax < FX_FACTION_MAX then
                    call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_lv[i],"FXRD\\Numbers\\BlueNeon\\")
                    call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lv[i],I2S(fmax) + "S" + I2S(FX_FACTION_MAX))
                else
                    set myLv=FXGetPlayerMasterLevel(Player(i))
                    //if myLv == FX_MASTER_MAX_LEVEL then
                    //    set num_lv[i].text = ""
                    //else
                        call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_lv[i],"FXRD\\Numbers\\GoldNeon\\")
                        call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lv[i],I2S(myLv))
                    //endif
                endif
            else
                set myLv=FXGetPlayerLevel(Player(i))
                if FXIsPlayerFactionMastered(Player(i) , myFax) then
                    call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_lv[i],"FXRD\\Numbers\\GoldNeon\\")
                    //if myLv == FX_MASTER_MAX_LEVEL then
                    //    set num_lv[i].text = ""
                    //else
                        call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lv[i],I2S(myLv))
                    //endif
                else
                    call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_lv[i],"FXRD\\Numbers\\BlueNeon\\")
                    call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lv[i],I2S(myLv))
                endif
            endif
            set i=i + 1
            exitwhen i == 4
        endloop
    endfunction
    function s__UIGameSettingV2_RefreshTierXp takes integer this returns nothing
        local integer i= 0
        local integer myFax
        local integer myLv
        local integer myXp
        local integer myXpReq
        loop
            set myFax=FXGetPlayerCurrentFaction(Player(i))
            if myFax == 0 then
                call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_xp[i],"")
            else
                set myLv=FXGetPlayerLevel(Player(i))
                set myXp=FXGetPlayerXp(Player(i))
                if FXIsPlayerFactionMastered(Player(i) , myFax) then
                    set myXpReq=FXGetMasterXpReq(myLv)
                    call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_xp[i],"FXRD\\Numbers\\GoldNeon\\")
                    if myLv == FX_MASTER_MAX_LEVEL then
                        call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_xp[i],"")
                    else
                        call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_xp[i],I2S(myXp) + "S" + I2S(myXpReq))
                    endif
                else
                    set myXpReq=FXGetXpReq(myLv)
                    call sc__InterfaceNumpad__set_path(s__UIGameSettingV2_num_xp[i],"FXRD\\Numbers\\BlueNeon\\")
                    call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_xp[i],I2S(myXp) + "S" + I2S(myXpReq))
                endif
            endif
            set i=i + 1
            exitwhen i == 4
        endloop
    endfunction
    function s__UIGameSettingV2_RefreshMilestone takes integer this,player p returns nothing
        local integer id= GetPlayerId(p)
        local integer myFax= FXGetPlayerCurrentFaction(p)
        local boolean isMastered= false
        local boolean isMaxed= false
        if myFax == 0 then
            
            set isMastered=( FXCountPlayerFactionMastered(p) == FX_FACTION_MAX )
            set isMaxed=FXGetPlayerMasterLevel(p) == FX_MASTER_MAX_LEVEL
        else
            set isMastered=FXIsPlayerFactionMastered(p , myFax)
            set isMaxed=FXGetPlayerLevel(p) == FX_MASTER_MAX_LEVEL
        endif
        if GetLocalPlayer() == p then
            call ShowDestructable(s__UIGameSettingV2_spr_milestone[this], false)
            call ShowDestructable(s__UIGameSettingV2_spr_milestone_master[this], false)
            call ShowDestructable(s__UIGameSettingV2_spr_milestone_max[this], false)
            if isMastered then
                if isMaxed then
                    call ShowDestructable(s__UIGameSettingV2_spr_milestone_max[this], true)
                else
                    call ShowDestructable(s__UIGameSettingV2_spr_milestone_master[this], true)
                endif
            else
                call ShowDestructable(s__UIGameSettingV2_spr_milestone[this], true)
            endif
        endif
    endfunction
    
    function s__UIGameSettingV2_RefreshFactionFocus takes integer this returns nothing
        local integer i= 0
        local integer myFax
        local integer array dsid
        set dsid[0]='B00Y'
        set dsid[1]='B00Z'
        set dsid[2]='B010'
        set dsid[3]='B011'
        loop
            if s__s__UIGameSettingV2_spr_dock[i] != null then
                call RemoveDestructable(s__s__UIGameSettingV2_spr_dock[i])
                set s__s__UIGameSettingV2_spr_dock[i]= null
            endif
            if IsPlayerPlaying(Player(i)) and UI_READY[i] then
                set myFax=FXGetPlayerCurrentFaction(Player(i))
                if myFax == 0 then
                    set s__s__UIGameSettingV2_spr_dock[i]= CreateDestructableZ(dsid[i], 5350 + 192 * ModuloInteger(8 - 1, 4) + 32 * i, 192 - 288, 2.00, 0, 1.00, 0)
                else
                    set myFax=myFax - 1
                    set s__s__UIGameSettingV2_spr_dock[i]= CreateDestructableZ(dsid[i], 5350 + 192 * ModuloInteger(myFax, 4) + 32 * i, 192 - 288 * ( myFax / 4 ), 2.00, 0, 1.00, 0)
                endif
            endif
            set i=i + 1
            exitwhen i == 4
        endloop
    endfunction
    
    function s__UIGameSettingV2_RefreshFactionListLevel takes integer this returns nothing
        local integer i= 0
        local integer f= 0
        local integer myLv
        local boolean anotherUnlocked= false
        loop
            set anotherUnlocked=FXIsPlayerMaster(Player(i))
            //Newleds
            set f=1
            loop
                if FXIsPlayerFactionMastered(Player(i) , f) then
                    call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f],"")
                else
                    if f >= FX_FACTION_ANOTHER then
                        if anotherUnlocked then
                            call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f],I2S(FXGetPlayerFactionLevel(Player(i) , f)))
                        else
                            call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f],"")
                        endif
                    else
                        call sc__InterfaceNumpad__set_text(s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f],I2S(FXGetPlayerFactionLevel(Player(i) , f)))
                    endif
                endif
                exitwhen f == FX_FACTION_MAX
                set f=f + 1
            endloop
            //
            set i=i + 1
            exitwhen i == 4
        endloop
    endfunction
    function s__UIGameSettingV2_RefreshFactionList takes integer this,player p returns nothing
        local integer id= GetPlayerId(p)
        local boolean iAmReady= UI_READY[id]
        local boolean iAmUnclickable= iAmReady
        local boolean iAmEnabled
        local boolean iAmMastered
        local integer i= 0
        loop
            set iAmEnabled=not iAmUnclickable
            set iAmMastered=FXIsPlayerFactionMastered(p , i)
            if i == 0 then
                
                set iAmMastered=( FXCountPlayerFactionMastered(p) == FX_FACTION_MAX )
            endif
            if i >= FX_FACTION_ANOTHER then
                if not FXIsPlayerMaster(p) then
                    set iAmEnabled=false
                endif
            endif
            if GetLocalPlayer() == p then
                if iAmUnclickable then
                    call SetUnitScale(s__UIGameSettingV2_btn_faction[i], 0, 0, 0)
                else
                    call SetUnitScale(s__UIGameSettingV2_btn_faction[i], 1, 1, 1)
                endif
                if iAmEnabled then
                    if iAmMastered then
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_faction[i], ANI_BIRTH)
                    else
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_faction[i], ANI_STAND)
                    endif
                else
                    if iAmMastered then
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_faction[i], ANI_DECAY)
                    else
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_faction[i], ANI_DEATH)
                    endif
                endif
            endif
            exitwhen i == FX_FACTION_MAX
            set i=i + 1
        endloop
    endfunction
    
    function s__UIGameSettingV2_RefreshImageIconTag takes integer this,player p returns nothing
        local string array aniStrFaction
        local integer myFax= FXGetPlayerCurrentFaction(p)
        local boolean isMastered= FXIsPlayerFactionMastered(p , myFax)
        local integer id= GetPlayerId(p)
        local boolean aniRequired= UI_FACTION_PREV[id] != myFax
        set UI_FACTION_PREV[id]=myFax
        if myFax == 0 then
            
            set isMastered=( FXCountPlayerFactionMastered(p) == FX_FACTION_MAX )
        endif
        if GetLocalPlayer() == p then
            call ShowDestructable(s__UIGameSettingV2_spr_icon[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_port[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_sport[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[0], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[1], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[2], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[3], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[4], false)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[5], false)
            call ShowDestructable(s__UIGameSettingV2_spr_tag[myFax], true)
            call ShowDestructable(s__UIGameSettingV2_spr_dscr[myFax], true)
            call ShowDestructable(s__UIGameSettingV2_spr_icon[myFax], true)
            if isMastered then
                call SetDestructableAnimation(s__UIGameSettingV2_spr_tag[myFax], ANI_DEATH)
                call ShowDestructable(s__UIGameSettingV2_spr_sport[myFax], true)
                if aniRequired then
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_icon[myFax], ANI_WALK)
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_sport[myFax], ANI_BIRTH)
                endif
            else
                call SetDestructableAnimation(s__UIGameSettingV2_spr_tag[myFax], ANI_STAND)
                call ShowDestructable(s__UIGameSettingV2_spr_port[myFax], true)
                if aniRequired then
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_icon[myFax], ANI_WALK)
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_port[myFax], ANI_BIRTH)
                endif
            endif
        endif
    endfunction
   
    function s__UIGameSettingV2_RefreshReadyButton takes integer this,player p returns nothing
        local integer id= GetPlayerId(p)
        local boolean iAmBJ= UI_BANGJANG == p
        local boolean iAmReady= UI_READY[id]
        local boolean readyEnabled= true
        if GetLocalPlayer() == p then
            if iAmReady then
                call SetDestructableAnimation(s__UIGameSettingV2_spr_btnready[this], ANI_BIRTH)
                call SetUnitScale(s__UIGameSettingV2_btn_ready[this], 0.95, 1, 1)
            else
                if FXGetPlayerCurrentFaction(p) >= FX_FACTION_ANOTHER and not FXIsPlayerMaster(p) then
                    set readyEnabled=false
                endif
                if readyEnabled then
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_btnready[this], ANI_STAND)
                    call SetUnitScale(s__UIGameSettingV2_btn_ready[this], 0.95, 1, 1)
                else
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_btnready[this], ANI_DEATH)
                    call SetUnitScale(s__UIGameSettingV2_btn_ready[this], 0, 0, 0)
                endif
            endif
        endif
    endfunction
    
    function s__UIGameSettingV2_RefreshModeDiffButton takes integer this returns nothing
        local player p= GetLocalPlayer()
        local integer id= GetPlayerId(p)
        local boolean iAmBJ= UI_BANGJANG == p
        local boolean iAmReady= UI_READY[id]
        local string array moTabOk
        local string array moTabNo
        local boolean modeDiffEnabled= true
        local boolean chalEnabled= true
        set moTabOk[1]="stand"
        set moTabOk[2]="spell two"
        set moTabOk[3]="spell one"
        set moTabOk[4]="spell three"
        set moTabNo[1]="stand alternate"
        set moTabNo[2]="spell alternate two"
        set moTabNo[3]="spell alternate one"
        set moTabNo[4]="spell alternate three"
        
        call sc__UIBTNLevel__set_Level(s__UIGameSettingV2_spr_btndiff[this],LEVEL_CURRENT)
        call sc__UIMSGLevel__set_Level(s__UIGameSettingV2_msg_btndiff[this],LEVEL_CURRENT)
        
        if GetLocalPlayer() == p then
            if not iAmBJ then
                set modeDiffEnabled=false
            endif
            if MODE_CURRENT == MODE_SPEEDRUN then
                set chalEnabled=false
            endif
            if iAmReady then
                set modeDiffEnabled=false
            endif
            if modeDiffEnabled then
                call SetDestructableAnimation(s__UIGameSettingV2_spr_btnmode[this], moTabOk[MODE_CURRENT])
                call SetDestructableAnimation(s__UIBTNLevel_destructable[s__UIGameSettingV2_spr_btndiff[this]], ANI_STAND)
                call SetUnitScale(s__UIGameSettingV2_btn_mode[this], 0.95, 1, 1)
                call SetUnitScale(s__UIGameSettingV2_btn_diff[this], 0.95, 1, 1)
            else
                call SetDestructableAnimation(s__UIGameSettingV2_spr_btnmode[this], moTabNo[MODE_CURRENT])
                call SetDestructableAnimation(s__UIBTNLevel_destructable[s__UIGameSettingV2_spr_btndiff[this]], ANI_DEATH)
                call SetUnitScale(s__UIGameSettingV2_btn_mode[this], 0, 0, 0)
                call SetUnitScale(s__UIGameSettingV2_btn_diff[this], 0, 0, 0)
            endif
            if chalEnabled then
                call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchal[this], ANI_STAND)
                call SetUnitScale(s__UIGameSettingV2_btn_chal[this], 0.95, 1, 1)
            else
                call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchal[this], ANI_DEATH)
                call SetUnitScale(s__UIGameSettingV2_btn_chal[this], 0, 0, 0)
            endif
            call ShowDestructable(s__UIBTNLevel_destructable[s__UIGameSettingV2_spr_btndiff[this]], true)
            call ShowDestructable(s__UIMSGLevel_destructable[s__UIGameSettingV2_msg_btndiff[this]], true)
            call SetDestructableAnimation(s__UIGameSettingV2_msg_btnmode[this], moTabOk[MODE_CURRENT])
            call ShowDestructable(s__UIGameSettingV2_spr_btnchal[this], chalEnabled)
        endif
        set p=null
    endfunction
    
    function s__UIGameSettingV2_RefreshDiffMenu takes integer this returns nothing
        local player p= GetLocalPlayer()
        local integer id= GetPlayerId(p)
        local boolean isReady= UI_READY[id]
        local boolean iAmBJ= UI_BANGJANG == p
        local boolean isEnable= iAmBJ and not isReady
        local boolean isCurrentWindow= UI_SETTING_MODE[id] == UI_SETTING_MODE_DIFFMENU
        local integer i= 1
    
        if GetLocalPlayer() == p then
            call ShowDestructable(s__UIGameSettingV2_spr_diffmenu_backdrop[this], isCurrentWindow)
            loop
                call ShowDestructable(s__UIGameSettingV2_spr_diffmenu_button[i], isCurrentWindow)
                call ShowDestructable(s__UIGameSettingV2_msg_diffmenu_button[i], isCurrentWindow)
                if isCurrentWindow then
                    call SetUnitScale(s__UIGameSettingV2_btn_diffmenu_button[i], 1.0, 1.0, 1.0)
                else
                    call SetUnitScale(s__UIGameSettingV2_btn_diffmenu_button[i], 0.0, 0.0, 0.0)
                endif
                if isEnable then
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_diffmenu_button[i], ANI_STAND)
                else
                    call SetDestructableAnimation(s__UIGameSettingV2_spr_diffmenu_button[i], ANI_DEATH)
                endif
                exitwhen i == LEVEL_MAX
                set i=i + 1
            endloop
        endif
        set p=null
    endfunction
    
    function s__UIGameSettingV2_RefreshChallengeSubWindow takes integer this returns nothing
        local player p= GetLocalPlayer()
        local integer id= GetPlayerId(p)
        local boolean isReady= UI_READY[id]
        local boolean iAmBJ= UI_BANGJANG == p
        local boolean isEnable= iAmBJ and not isReady
        local boolean isChallengeWindow= UI_SETTING_MODE[id] == UI_SETTING_MODE_CHALLENGE
        local integer i= 1
        local string array PAN_TAG
        local integer panCount= IMinBJ(5, CountPanalty())
        set PAN_TAG[0]="Stand"
        set PAN_TAG[1]="Stand Upgrade First"
        set PAN_TAG[2]="Stand Upgrade Second"
        set PAN_TAG[3]="Stand Upgrade Third"
        set PAN_TAG[4]="Stand Upgrade Fourth"
        set PAN_TAG[5]="Stand Upgrade Fifth"
        if GetLocalPlayer() == p then
            call ShowDestructable(s__UIGameSettingV2_spr_challenge_backdrop[this], isChallengeWindow)
            call ShowDestructable(s__UIGameSettingV2_msg_btnchal[this], isChallengeWindow)
            call SetDestructableAnimation(s__UIGameSettingV2_msg_btnchal[this], PAN_TAG[panCount])
            loop
                call ShowDestructable(s__UIGameSettingV2_spr_btnchallenge[i], isChallengeWindow)
                if isChallengeWindow then
                    call SetUnitScale(s__UIGameSettingV2_btn_btnchallenge[i], 1.0, 1.0, 1.0)
                else
                    call SetUnitScale(s__UIGameSettingV2_btn_btnchallenge[i], 0.0, 0.0, 0.0)
                endif
                if isEnable then
                    if PANALTY[i] then
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchallenge[i], ANI_STAND)
                    else
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchallenge[i], ANI_BIRTH)
                    endif
                else
                    if PANALTY[i] then
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchallenge[i], ANI_DEATH)
                    else
                        call SetDestructableAnimation(s__UIGameSettingV2_spr_btnchallenge[i], ANI_DECAY)
                    endif
                endif
                exitwhen i == PANALTY_MAX
                set i=i + 1
            endloop
        endif
        set p=null
    endfunction
    
    function s__UIGameSettingV2_RefreshPlayer takes integer this,player p returns nothing
        call s__UIGameSettingV2_RefreshReadyButton(this,p)
        call s__UIGameSettingV2_RefreshHighlights(this,p)
        call s__UIGameSettingV2_RefreshMilestone(this,p)
        call s__UIGameSettingV2_RefreshFactionList(this,p)
        call s__UIGameSettingV2_RefreshImageIconTag(this,p)
        
        call s__UIGameSettingV2_RefreshModeDiffButton(this)
        call s__UIGameSettingV2_RefreshLevel(this)
        call s__UIGameSettingV2_RefreshTierXp(this)
        call s__UIGameSettingV2_RefreshFactionListLevel(this)
        call s__UIGameSettingV2_RefreshFactionFocus(this)
        call s__UIGameSettingV2_RefreshChallengeSubWindow(this)
        call s__UIGameSettingV2_RefreshDiffMenu(this)
    endfunction
    
    function s__UIGameSettingV2_Refresh takes integer this returns nothing
        local integer i= 0
        loop
            exitwhen i == 4
            call s__UIGameSettingV2_RefreshReadyButton(this,Player(i))
            call s__UIGameSettingV2_RefreshHighlights(this,Player(i))
            call s__UIGameSettingV2_RefreshMilestone(this,Player(i))
            call s__UIGameSettingV2_RefreshFactionList(this,Player(i))
            call s__UIGameSettingV2_RefreshImageIconTag(this,Player(i))
            set i=i + 1
        endloop
        
        call s__UIGameSettingV2_RefreshModeDiffButton(this)
        call s__UIGameSettingV2_RefreshLevel(this)
        call s__UIGameSettingV2_RefreshTierXp(this)
        call s__UIGameSettingV2_RefreshFactionListLevel(this)
        call s__UIGameSettingV2_RefreshFactionFocus(this)
        call s__UIGameSettingV2_RefreshChallengeSubWindow(this)
        call s__UIGameSettingV2_RefreshDiffMenu(this)
    endfunction
// Trigger: Mod FXGameSettingV2
//===========================================================================

// scope UIGameSettingModule begins

    
    function UIGameSettingModule__onScreenRelease takes nothing returns nothing
        call SetCineFilterTexture("Textures\\Black32.blp")
        call SetCineFilterBlendMode(BLEND_MODE_BLEND)
        call SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE)
        call SetCineFilterStartUV(0, 0, 1, 1)
        call SetCineFilterEndUV(0, 0, 1, 1)
        call SetCineFilterStartColor(255, 255, 255, 255)
        call SetCineFilterEndColor(255, 255, 255, 0)
        call SetCineFilterDuration(1.00)
        call DisplayCineFilter(true)
        call DestroyTimer(GetExpiredTimer())
    endfunction
    function UIGameSettingModule__onAllReady takes nothing returns nothing
        //브금변경
        call PlayMusic("Sound\\Music\\mp3Music\\PursuitTheme.mp3")
        call ResumeMusic()
        //화면개시
        call RRRequest(REQUEST_GAME_SET)
        call EnableDragSelect(true, true)
        call FixCameraForPlayer(GetLocalPlayer() , null)
        call ResetToGameCamera(0.00)
        call EnableSmartSeeya(true)
        call PanCameraToTimed(- 6144.00, 0, 0.00)
        call s__eventCustom_evaluate(EVENT_GAME_INIT , null , null , null , 0)
        call TimerStart(GetExpiredTimer(), 2.00, false, function UIGameSettingModule__onScreenRelease)
    endfunction
    function UIGameSettingModule__SPPseudoSelectReadyButton takes player p returns nothing
        local integer myFaction= FXGetPlayerCurrentFaction(p)
        local integer id= GetPlayerId(p)
        local integer i= 0
        if not GAME_IS_SETTING then
            return
        endif
        if myFaction >= FX_FACTION_ANOTHER and not FXIsPlayerMaster(p) then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(p, gg_snd_Error)
            return
        endif
        set UI_READY[id]=not UI_READY[id]
        call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,p)
        set GAME_IS_SETTING=false
        loop
            exitwhen i == 4
            if IsPlayerPlaying(Player(i)) and not UI_READY[i] then
                set GAME_IS_SETTING=true
                return
            endif
            set i=i + 1
        endloop
        call SetCineFilterTexture("Textures\\Black32.blp")
        call SetCineFilterBlendMode(BLEND_MODE_BLEND)
        call SetCineFilterTexMapFlags(TEXMAP_FLAG_NONE)
        call SetCineFilterStartUV(0, 0, 1, 1)
        call SetCineFilterEndUV(0, 0, 1, 1)
        call SetCineFilterStartColor(255, 255, 255, 255)
        call SetCineFilterEndColor(255, 255, 255, 255)
        call SetCineFilterDuration(0)
        call DisplayCineFilter(true)
        call TimerStart(CreateTimer(), 0.50, false, function UIGameSettingModule__onAllReady)
    endfunction
    function UIGameSettingModule__onSelectReadyButton takes nothing returns nothing
        call UIGameSettingModule__SPPseudoSelectReadyButton(GetTriggerPlayer())
    endfunction
    
    function UIGameSettingModule__onSelectFactionButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer v1= GetUnitUserData(GetTriggerUnit())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            return
        endif
        call FXSetPlayerCurrentFaction(Player(id) , v1)
        call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,Player(id))
    endfunction
    
    function UIGameSettingModule__onGameSet takes nothing returns nothing
        call PauseTimer(UIGameSettingModule__BANGJANG_TIMER)
        if UIGameSettingModule__singleton == 0 then
            return
        endif
        set GAME_IS_SETTING=false
        call s__UIGameSettingV2_destroy(UIGameSettingModule__singleton)
        set UIGameSettingModule__singleton=0
    endfunction
    
    function UIGameSettingModule__AI_PSEUDO_FUNCTION_AUTO_READY takes nothing returns nothing
        local integer id= 0
        loop
            if GetPlayerSlotState(Player(id)) == PLAYER_SLOT_STATE_PLAYING then
                if GetPlayerController(Player(id)) == MAP_CONTROL_COMPUTER then
                    if not UI_READY[id] then
                        call UIGameSettingModule__SPPseudoSelectReadyButton(Player(id))
                    endif
                endif
            endif
            set id=id + 1
            exitwhen id == 4
        endloop
    endfunction
    function UIGameSettingModule__RefreshBangJang takes nothing returns nothing
        local integer i
        if not GAME_IS_SETTING then
            return
        endif
        if UIGameSettingModule__singleton == 0 then
            return
        endif
        set i=0
        loop
            exitwhen i == 4
            if IsPlayingUser(Player(i)) then
            //if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then /*컴퓨터도 포함하고 싶을 때*/
                set UI_BANGJANG=Player(i)
                exitwhen true
            endif
            set i=i + 1
        endloop
        call UIGameSettingModule__AI_PSEUDO_FUNCTION_AUTO_READY()
        if UI_BANGJANG == UI_BANGJANG_PREV then
            return
        endif
        set UI_BANGJANG_PREV=UI_BANGJANG
        call s__UIGameSettingV2_Refresh(UIGameSettingModule__singleton)
    endfunction
    function UIGameSettingModule__onGameSetting takes nothing returns nothing
        if UIGameSettingModule__singleton > 0 then
            call s__UIGameSettingV2_destroy(UIGameSettingModule__singleton)
        endif
        set UI_SETTING_MODE[0]=UI_SETTING_MODE_IDLE
        set UI_SETTING_MODE[1]=UI_SETTING_MODE_IDLE
        set UI_SETTING_MODE[2]=UI_SETTING_MODE_IDLE
        set UI_SETTING_MODE[3]=UI_SETTING_MODE_IDLE
        set UIGameSettingModule__singleton=s__UIGameSettingV2_create()
        call s__UIGameSettingV2_Refresh(UIGameSettingModule__singleton)
        set GAME_IS_SETTING=true
        call TimerStart(UIGameSettingModule__BANGJANG_TIMER, UIGameSettingModule__BANGJANG_TIMEOUT, true, function UIGameSettingModule__RefreshBangJang)
    endfunction
    
    function UIGameSettingModule__atChat takes player p returns nothing
        local integer id= GetPlayerId(p)
        if not GAME_IS_SETTING then
            return
        endif
        if UI_ERROR[id] then
            return
        endif
        if not USER_IS_FIRSTPLAY[id] then
            call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,p)
        endif
    endfunction
    function UIGameSettingModule__onChat takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            return
        endif
        if SubString(GetEventPlayerChatString(), 0, 5) == "-LOAD" then
            call s__SaveData_decode(GetTriggerPlayer() , SubString(GetEventPlayerChatString(), 6, StringLength(( GetEventPlayerChatString() ))))
            call UIGameSettingModule__atChat(GetTriggerPlayer())
            return
        endif
        if SubString(GetEventPlayerChatString(), 0, 5) == "-load" then
            call s__SaveData_decode(GetTriggerPlayer() , SubString(GetEventPlayerChatString(), 6, StringLength(( GetEventPlayerChatString() ))))
            call UIGameSettingModule__atChat(GetTriggerPlayer())
        endif
    endfunction
    function UIGameSettingModule__ChatLoadEventInit takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterPlayerChatEvent(t, Player(0), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(1), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(2), "", true)
        call TriggerRegisterPlayerChatEvent(t, Player(3), "", true)
        call TriggerAddAction(t, function UIGameSettingModule__onChat)
        set t=null
    endfunction
    
    
    function UIGameSettingModule__onSelectModeButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer v1= R2I(GetUnitPropWindow(GetTriggerUnit()))
        local integer i= 0
        if not GAME_IS_SETTING then
            return
        endif
        if UI_BANGJANG != GetTriggerPlayer() then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(GetTriggerPlayer(), gg_snd_Error)
            return
        endif
        if UI_READY[id] then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(GetTriggerPlayer(), gg_snd_Error)
            return
        endif
        set MODE_CURRENT=MODE_CURRENT + 1
        if MODE_CURRENT > MODE_MAX then
            set MODE_CURRENT=1
        endif
        loop
            exitwhen i == 4
            set UI_SETTING_MODE[i]=UI_SETTING_MODE_IDLE
            set i=i + 1
        endloop
        call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,Player(id))
    endfunction
    
    function UIGameSettingModule__onSelectDiffButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            return
        endif
        if UI_SETTING_MODE[id] == UI_SETTING_MODE_DIFFMENU then
            set UI_SETTING_MODE[id]=UI_SETTING_MODE_IDLE
        else
            set UI_SETTING_MODE[id]=UI_SETTING_MODE_DIFFMENU
        endif
        call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,Player(id))
    endfunction
    
    function UIGameSettingModule__onToggleDiffButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer v1= GetUnitUserData(GetTriggerUnit())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            return
        endif
        if UI_SETTING_MODE[id] != UI_SETTING_MODE_DIFFMENU then
            return
        endif
        if UI_BANGJANG != GetTriggerPlayer() then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(GetTriggerPlayer(), gg_snd_Error)
            return
        endif
        set LEVEL_CURRENT=v1
        if UI_SETTING_MODE[id] == UI_SETTING_MODE_DIFFMENU then
            set UI_SETTING_MODE[id]=UI_SETTING_MODE_IDLE
        endif
        call s__UIGameSettingV2_Refresh(UIGameSettingModule__singleton)
    endfunction
    
    function UIGameSettingModule__onSelectPanaltyButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            return
        endif
        if UI_SETTING_MODE[id] == UI_SETTING_MODE_CHALLENGE then
            set UI_SETTING_MODE[id]=UI_SETTING_MODE_IDLE
        else
            set UI_SETTING_MODE[id]=UI_SETTING_MODE_CHALLENGE
        endif
        call s__UIGameSettingV2_RefreshPlayer(UIGameSettingModule__singleton,Player(id))
    endfunction
    
    function UIGameSettingModule__onTogglePanaltyButton takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer v1= GetUnitUserData(GetTriggerUnit())
        if not GAME_IS_SETTING then
            return
        endif
        if UI_READY[id] then
            return
        endif
        if UI_SETTING_MODE[id] != UI_SETTING_MODE_CHALLENGE then
            return
        endif
        if UI_BANGJANG != GetTriggerPlayer() then
            //SOUND : ERROR
            call StartSoundForPlayerBJ(GetTriggerPlayer(), gg_snd_Error)
            return
        endif
        call TogglePanalty(v1)
        call s__UIGameSettingV2_Refresh(UIGameSettingModule__singleton)
    endfunction
    
    function UIGameSettingModule__CheatAction takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        if GetEventPlayerChatString() == "-kick 1" then
            call RemovePlayer(Player(0), PLAYER_GAME_RESULT_DEFEAT)
        endif
        if GetEventPlayerChatString() == "-kick 2" then
            call RemovePlayer(Player(1), PLAYER_GAME_RESULT_DEFEAT)
        endif
        if GetEventPlayerChatString() == "-kick 3" then
            call RemovePlayer(Player(2), PLAYER_GAME_RESULT_DEFEAT)
        endif
        if GetEventPlayerChatString() == "-kick 4" then
            call RemovePlayer(Player(3), PLAYER_GAME_RESULT_DEFEAT)
        endif
        if GetEventPlayerChatString() == "-ready 1" then
            call UIGameSettingModule__SPPseudoSelectReadyButton(Player(0))
        endif
        if GetEventPlayerChatString() == "-ready 2" then
            call UIGameSettingModule__SPPseudoSelectReadyButton(Player(1))
        endif
        if GetEventPlayerChatString() == "-ready 3" then
            call UIGameSettingModule__SPPseudoSelectReadyButton(Player(2))
        endif
        if GetEventPlayerChatString() == "-ready 4" then
            call UIGameSettingModule__SPPseudoSelectReadyButton(Player(3))
        endif
    endfunction
    function UIGameSettingModule__CheatEventInit takes nothing returns nothing
        local trigger t= CreateTrigger()
    endfunction
    
    function UIGameSettingModule__main takes nothing returns nothing
        
        call UIGameSettingModule__ChatLoadEventInit()
        
        call s__UnitSelectEvent_Create('n001' , function UIGameSettingModule__onSelectReadyButton)
