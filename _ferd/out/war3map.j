//library LifeMod:
        function s__lifeMod_onInit takes nothing returns nothing
            set s__lifeMod_ID[0]='A08W'
            set s__lifeMod_ID[1]='A08X'
            set s__lifeMod_ID[2]='A08Y'
            set s__lifeMod_ID[3]='A08Z'
            set s__lifeMod_ID[4]='A090'
            set s__lifeMod_ID[5]='A091'
            set s__lifeMod_ID[6]='A092'
            set s__lifeMod_ID[7]='A093'
            set s__lifeMod_ID[8]='A094'
        endfunction
        function s__lifeMod_apply takes unit u,integer hp returns nothing
            local integer m= 0
            set hp=hp - R2I(GetUnitState(u, UNIT_STATE_MAX_LIFE))
            loop
                exitwhen hp == 0
                call UnitAddAbility(u, s__lifeMod_ID[m])
                call SetUnitAbilityLevel(u, s__lifeMod_ID[m], hp - ( hp / 10 * 10 ) + 1)
                call UnitRemoveAbility(u, s__lifeMod_ID[m])
                set m=m + 1
                set hp=hp / 10
            endloop
        endfunction
        function s__lifeMod_preload takes unit u returns nothing
            call UnitAddAbility(u, s__lifeMod_ID[0])
            call UnitAddAbility(u, s__lifeMod_ID[1])
            call UnitAddAbility(u, s__lifeMod_ID[2])
            call UnitAddAbility(u, s__lifeMod_ID[3])
            call UnitAddAbility(u, s__lifeMod_ID[4])
            call UnitAddAbility(u, s__lifeMod_ID[5])
            call UnitAddAbility(u, s__lifeMod_ID[6])
            call UnitAddAbility(u, s__lifeMod_ID[7])
            call UnitAddAbility(u, s__lifeMod_ID[8])
        endfunction

//library LifeMod ends
//library ManaMod:
        function s__manaMod_onInit takes nothing returns nothing
            set s__manaMod_ID[0]='A05S'
            set s__manaMod_ID[1]='A05W'
            set s__manaMod_ID[2]='A05Z'
            set s__manaMod_ID[3]='A064'
            set s__manaMod_ID[4]='A04E'
            set s__manaMod_ID[5]='A04F'
            set s__manaMod_ID[6]='A04G'
        endfunction
        function s__manaMod_apply takes unit u,integer hp returns nothing
            local integer m= 0
            set hp=hp - R2I(GetUnitState(u, UNIT_STATE_MAX_MANA))
            loop
                exitwhen hp == 0
                call UnitAddAbility(u, s__manaMod_ID[m])
                call SetUnitAbilityLevel(u, s__manaMod_ID[m], hp - ( hp / 10 * 10 ) + 1)
                call UnitRemoveAbility(u, s__manaMod_ID[m])
                set m=m + 1
                set hp=hp / 10
            endloop
            call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))
        endfunction
        function s__manaMod_preload takes unit u returns nothing
            call UnitAddAbility(u, s__manaMod_ID[0])
            call UnitAddAbility(u, s__manaMod_ID[1])
            call UnitAddAbility(u, s__manaMod_ID[2])
            call UnitAddAbility(u, s__manaMod_ID[3])
            call UnitAddAbility(u, s__manaMod_ID[4])
            call UnitAddAbility(u, s__manaMod_ID[5])
            call UnitAddAbility(u, s__manaMod_ID[6])
        endfunction

//library ManaMod ends
//library MiscEvents:
        function s__EnterEvent_Create takes rect r,code c returns nothing
            local trigger t= CreateTrigger()
            local region rectRegion= CreateRegion()
            call RegionAddRect(rectRegion, r)
            call TriggerAddCondition(t, Filter(c))
            call TriggerRegisterEnterRegion(t, rectRegion, null)
            set t=null
            set rectRegion=null
        endfunction
        function s__RegionEnterEvent_Create takes region r,code c returns nothing
            local trigger t= CreateTrigger()
            call TriggerAddCondition(t, Filter(c))
            call TriggerRegisterEnterRegion(t, r, null)
            set t=null
        endfunction
        function s__TimedEvent_Create takes real r,boolean f,code c returns nothing
            local trigger t= CreateTrigger()
            call TriggerAddCondition(t, Filter(c))
            call TriggerRegisterTimerEvent(t, r, f)
            set t=null
        endfunction
        function s__KilledEvent_Create takes unit u,code c returns nothing
            local trigger t= CreateTrigger()
            call TriggerAddCondition(t, Filter(c))
            call TriggerRegisterUnitEvent(t, u, EVENT_UNIT_DEATH)
            set t=null
        endfunction
        function s__EmptyEvent_Create takes trigger t,code c returns trigger
            if t == null then
                set t=CreateTrigger()
            endif
            call TriggerAddCondition(t, Filter(c))
            return t
        endfunction
    
//textmacro instance: EventEx( "Unit", "Select", "EVENT_PLAYER_UNIT_SELECTED", "GetUnitTypeId(GetTriggerUnit())" )
        function s__UnitSelectEvent_Evaluate takes nothing returns boolean
            local integer this= sc__UnitTypeId_get(GetUnitTypeId(GetTriggerUnit()))
            call TriggerEvaluate(s__UnitSelectEvent_T[this])
            call TriggerEvaluate(s__UnitSelectEvent_ALL)
            return false
        endfunction
        function s__UnitSelectEvent_onInit takes nothing returns nothing
            local integer i= 0
            call TriggerAddCondition(s__UnitSelectEvent_EXC, Filter(function s__UnitSelectEvent_Evaluate))
            loop
                call TriggerRegisterPlayerUnitEvent(s__UnitSelectEvent_EXC, Player(i), EVENT_PLAYER_UNIT_SELECTED, null)
                set i=i + 1
                exitwhen i == bj_MAX_PLAYER_SLOTS
            endloop
        endfunction
        function s__UnitSelectEvent_Create takes integer id,code c returns nothing
            local integer this
            if id == 0 then
                call TriggerAddCondition(s__UnitSelectEvent_ALL, Filter(c))
                return
            endif
            set this=sc__UnitTypeId_convert(id)
            if s__UnitSelectEvent_T[this] == null then
                set s__UnitSelectEvent_T[this]=CreateTrigger()
            endif
            call TriggerAddCondition(s__UnitSelectEvent_T[this], Filter(c))
        endfunction
//end of: EventEx( "Unit", "Select", "EVENT_PLAYER_UNIT_SELECTED", "GetUnitTypeId(GetTriggerUnit())" )
//textmacro instance: EventEx( "Unit", "Sell", "EVENT_PLAYER_UNIT_SELL", "GetUnitTypeId(GetSoldUnit())" )
        function s__UnitSellEvent_Evaluate takes nothing returns boolean
            local integer this= sc__UnitTypeId_get(GetUnitTypeId(GetSoldUnit()))
            call TriggerEvaluate(s__UnitSellEvent_T[this])
            call TriggerEvaluate(s__UnitSellEvent_ALL)
            return false
        endfunction
        function s__UnitSellEvent_onInit takes nothing returns nothing
