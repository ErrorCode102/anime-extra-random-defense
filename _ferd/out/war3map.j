// scope FXTrig3StartRound begins
    function FXTrig3StartRound___onCreateWisp takes nothing returns nothing
        local integer i= 0
        local integer amt
        if PANALTY_COUNT > 0 then
            call CONTSetTerrainPanaltyMode()
        endif
        call CONTShowTerrainGacha()
        call CONTRefreshTerrainFence()
        call SetDoodadAnimation(- 6144.00, 0.00, 32, 'D001', true, "birth", false)
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                set amt=4
                if FXGetPlayerCurrentFaction(Player(i)) == FX_FACTION_ANOTHER then
                    set amt=15
                endif
                call CreateWisp(Player(i) , amt)
            endif
            set i=i + 1
        endloop
        call DestroyTimer(FXTrig3StartRound___t)
        //플레이타임 개시
        call s__playtime_start()
        //게임 라운드 개시
        call StartGameRound()
        set FXTrig3StartRound___t=null
    endfunction
    function FXTrig3StartRound___onGameInit takes nothing returns nothing
        //위습존 애니메이션 대응
        call CONTHideTerrainGacha()
        call SetDoodadAnimation(- 6144.00, 0.00, 32, 'D001', true, "death", false)
        call TimerStart(FXTrig3StartRound___t, 3.00, false, function FXTrig3StartRound___onCreateWisp)
    endfunction
    function FXTrig3StartRound___main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXTrig3StartRound___onGameInit)
    endfunction
