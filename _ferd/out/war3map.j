    function s__CMWeaponrain_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMWeaponrain_caster[this]=null
        call s__tick_destroy(s__CMWeaponrain_mainFlow[this])
        call s__tick_destroy(s__CMWeaponrain_subFlow[this])
    endfunction
    function s__CMWeaponrain_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__enemy_dealLogic(s__CMWeaponrain_caster[this] , GetEnumUnit() , s__CMWeaponrain_myDamage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function s__CMWeaponrain_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMWeaponrain_caster[this], UNIT_TYPE_DEAD) or s__CMWeaponrain_myCombo[this] == 0 then
            call s__tick_start(s__CMWeaponrain_mainFlow[this],0.10 , false , function s__CMWeaponrain_onFinal)
            return
        endif
        set s__CMWeaponrain_myCombo[this]=s__CMWeaponrain_myCombo[this] - 1
        call SetSoundPosition(gg_snd_weaponrain, s__CMWeaponrain_myX[this], s__CMWeaponrain_myY[this], 300.0)
        call StartSound(gg_snd_weaponrain)
        call s__splash_range(s__splash_ENEMY , s__CMWeaponrain_caster[this] , s__CMWeaponrain_myX[this] , s__CMWeaponrain_myY[this] , s__CMWeaponrain_myRange[this] , function s__CMWeaponrain_enumDealt)
        if s__CMWeaponrain_myCombo[this] > 0 then
            call s__tick_start(s__CMWeaponrain_mainFlow[this],s__CMWeaponrain_myDelay[this] , false , function s__CMWeaponrain_onFireStart)
        else
            call s__tick_start(s__CMWeaponrain_mainFlow[this],0.1 , false , function s__CMWeaponrain_onFinal)
        endif
    endfunction
    function s__CMWeaponrain_onEffectDrop takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local real ang= GetRandomReal(0.0, 360.0)
        local real dist= s__CMWeaponrain_myRange[this] * SquareRoot(GetRandomReal(0.0, 1.0))
        call DestroyEffect(AddSpecialEffect("FX\\Gilgamesh\\Shower.mdl", s__CMWeaponrain_myX[this] + s__Polar_X(dist , ang), s__CMWeaponrain_myY[this] + s__Polar_Y(dist , ang)))
        set ang=GetRandomReal(0.0, 360.0)
        set dist=s__CMWeaponrain_myRange[this] * SquareRoot(GetRandomReal(0.0, 1.0))
        call DestroyEffect(AddSpecialEffect("FX\\Gilgamesh\\Shower.mdl", s__CMWeaponrain_myX[this] + s__Polar_X(dist , ang), s__CMWeaponrain_myY[this] + s__Polar_Y(dist , ang)))
    endfunction
    function s__CMWeaponrain_cast takes unit src,real tx,real ty,real r,real dmg,integer combo,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMWeaponrain_caster[this]=src
        set s__CMWeaponrain_myX[this]=tx
        set s__CMWeaponrain_myY[this]=ty
        set s__CMWeaponrain_myRange[this]=r
        set s__CMWeaponrain_myDamage[this]=dmg
        set s__CMWeaponrain_myCombo[this]=combo
        set s__CMWeaponrain_myDelay[this]=delay
        //
        set s__CMWeaponrain_mainFlow[this]=this
        call s__tick_start(s__CMWeaponrain_mainFlow[this],1.0 , false , function s__CMWeaponrain_onFireStart)
        set s__CMWeaponrain_subFlow[this]=s__tick_create(this)
        call s__tick_start(s__CMWeaponrain_subFlow[this],0.1 , true , function s__CMWeaponrain_onEffectDrop)
    endfunction

    function s__CMEnuma_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMEnuma_myDummy[this])
        call ShowUnit(s__CMEnuma_myDummy[this], false)
        set s__CMEnuma_myDummy[this]=null
        set s__CMEnuma_caster[this]=null
        set s__CMEnuma_target[this]=null
        call s__tick_destroy(s__CMEnuma_main[this])
    endfunction
    function s__CMEnuma_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMEnuma_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMEnuma_myDummy[this], "overhead"))
        else
            call DestroyEffect(AddSpecialEffectTarget("FX\\Elizabeth\\Sonic.mdl", s__CMEnuma_target[this], "origin"))
            call FXRD_FXDebuffShock(s__CMEnuma_target[this] , 1.00)
            call s__enemy_dealLogic(s__CMEnuma_caster[this] , s__CMEnuma_target[this] , s__CMEnuma_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMEnuma_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMEnuma_myDummy[this], 0.00)
        call s__tick_start(s__CMEnuma_main[this],0.20 , false , function s__CMEnuma_onFinal)
    endfunction
    function s__CMEnuma_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMEnuma_caster[this]=src
        set s__CMEnuma_target[this]=dst
        set s__CMEnuma_damage[this]=dmg
        set s__CMEnuma_main[this]=this
        set s__CMEnuma_myDummy[this]=CreateUnit(Player(15), 'o00U', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst))
        call sc__DummyColorChanger_cast(s__CMEnuma_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMEnuma_myDummy[this], "attack gold")
        call SetUnitTimeScale(s__CMEnuma_myDummy[this], 1.50)
        call s__tick_start(s__CMEnuma_main[this],1.30 , true , function s__CMEnuma_onFire)
    endfunction

    function s__CMEnkidu_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(s__CMEnkidu_fx[this])
        set s__CMEnkidu_fx[this]=null
        set s__CMEnkidu_caster[this]=null
        set s__CMEnkidu_target[this]=null
        call s__tick_destroy(s__CMEnkidu_mainFlow[this])
    endfunction
    function s__CMEnkidu_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMEnkidu_caster[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMEnkidu_mainFlow[this],1.00 , false , function s__CMEnkidu_onFinal)
            return
        endif
        if IsUnitType(s__CMEnkidu_target[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMEnkidu_mainFlow[this],1.00 , false , function s__CMEnkidu_onFinal)
            return
        endif
        if s__CMEnkidu_myLoops[this] <= 0 then
            call s__tick_start(s__CMEnkidu_mainFlow[this],1.00 , false , function s__CMEnkidu_onFinal)
            return
        endif
        call FXRD_FXDebuffShock(s__CMEnkidu_target[this] , 1.10)
        call s__enemy_dealLogic(s__CMEnkidu_caster[this] , s__CMEnkidu_target[this] , s__CMEnkidu_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        set s__CMEnkidu_myLoops[this]=s__CMEnkidu_myLoops[this] - 1
    endfunction
    function s__CMEnkidu_cast takes unit src,unit dst,real dmg,integer loops returns nothing
        local integer this= s__tick_create(0)
        set s__CMEnkidu_caster[this]=src
        set s__CMEnkidu_target[this]=dst
        set s__CMEnkidu_myLoops[this]=loops
        set s__CMEnkidu_damage[this]=dmg
        set s__CMEnkidu_fx[this]=AddSpecialEffectTarget("FX\\Elkidu\\Mr.War3_JSSSL.mdl", dst, "origin")
        set s__CMEnkidu_mainFlow[this]=this
        call s__tick_start(s__CMEnkidu_mainFlow[this],1.00 , true , function s__CMEnkidu_onFire)
    endfunction
