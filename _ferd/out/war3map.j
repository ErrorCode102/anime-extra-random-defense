    function s__TLEnkiduEnuma_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local integer enumatime= 10
        if IS_PLAYER_HAVE_EX_GILGAMESH[GetPlayerId(GetOwningPlayer(s__TLEnkiduEnuma_caster[this]))] then
            set enumatime=15
        endif
        if IsUnitType(s__TLEnkiduEnuma_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__TLEnkiduEnuma_myDummy[this], "overhead"))
        else
            call s__BUFFEnkiduEnuma_apply(s__TLEnkiduEnuma_target[this] , s__TLEnkiduEnuma_caster[this] , 1.00 , enumatime)
        endif
        set s__TLEnkiduEnuma_myDummy[this]=null
        set s__TLEnkiduEnuma_caster[this]=null
        set s__TLEnkiduEnuma_target[this]=null
        call s__tick_destroy(s__TLEnkiduEnuma_main[this])
    endfunction
    function s__TLEnkiduEnuma_apply takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        set s__TLEnkiduEnuma_caster[this]=src
        set s__TLEnkiduEnuma_target[this]=dst
        set s__TLEnkiduEnuma_main[this]=this
        set s__TLEnkiduEnuma_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o021', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst))
        call SetUnitAnimation(s__TLEnkiduEnuma_myDummy[this], "Spell One")
        call s__TLDummyLife_apply(s__TLEnkiduEnuma_myDummy[this] , 1.70)
        call s__TLDummyFade_apply(s__TLEnkiduEnuma_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call s__TLDummyFadespan_apply(s__TLEnkiduEnuma_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 1.40 , 1.60)
        call s__tick_start(s__TLEnkiduEnuma_main[this],0.30 , true , function s__TLEnkiduEnuma_onFire)
    endfunction
// Trigger: Servant Meltlilith
