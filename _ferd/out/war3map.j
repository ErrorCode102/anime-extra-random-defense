//textmacro instance: 월드_초기화_시작("GAMETIME")
// scope WORLDINITGAMETIME begins
    function WORLDINITGAMETIME__main takes nothing returns nothing
//end of: 월드_초기화_시작("GAMETIME")
    //게임 시간 설정 : 시간이 흘러가지 않음 / 오후 12시로 고정
    call SuspendTimeOfDay(true)
    call SetFloatGameState(GAME_STATE_TIME_OF_DAY, 12.00)
//textmacro instance: 월드_초기화_끝()//===========================================================================
    endfunction
