//library SmartSeeya:

    
    function SmartSeeya___RegisterCommandTrigger takes code c returns nothing
        local integer i= 0
        call TriggerAddAction(SmartSeeya___COMMAND, c)
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "!cam ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "!ㅊ므 ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-cam ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-ㅊ므 ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-시야 ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-tldi ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "!c ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "!ㅊ ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-c ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-ㅊ ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-t ", false)
            call TriggerRegisterPlayerChatEvent(SmartSeeya___COMMAND, Player(i), "-ㅅ ", false)
            set i=i + 1
        endloop
    endfunction
    
    

    function ChangeSmartSeeyaSettingForPlayer takes player p,integer min,integer max,integer cut returns nothing
        if GetLocalPlayer() == p then
            set SmartSeeya___DMIN=min
            set SmartSeeya___DMAX=max
            set SmartSeeya___DCUR=cut
        endif
    endfunction
    
    function ChangeSmartSeeyaSetting takes integer min,integer max,integer cut returns nothing
        set SmartSeeya___DMIN=min
        set SmartSeeya___DMAX=max
        set SmartSeeya___DCUR=cut
    endfunction
    
    function EnableSmartSeeyaForPlayer takes player p,boolean b returns nothing
        if GetLocalPlayer() == p then
            set SmartSeeya___enabled=b
        endif
    endfunction
    
    function EnableSmartSeeya takes boolean b returns nothing
        set SmartSeeya___enabled=b
    endfunction

    function SmartSeeya___onCallback takes nothing returns nothing
        if not SmartSeeya___enabled then
            return
        endif
        call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, SmartSeeya___DCUR, 0.0)
        call SetCameraField(CAMERA_FIELD_FARZ, 6000.0, 0.00)
        if R2I(GetCameraField(CAMERA_FIELD_ROTATION) * bj_RADTODEG) == 90 then
            return
        endif
        if GetCameraField(CAMERA_FIELD_ROTATION) > 1.571 then
            set SmartSeeya___DCUR=IMaxBJ(SmartSeeya___DMIN, SmartSeeya___DCUR - 250)
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "FoV increased: " + I2S(SmartSeeya___DCUR))
       else
            set SmartSeeya___DCUR=IMinBJ(SmartSeeya___DMAX, SmartSeeya___DCUR + 250)
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "FoV reduced: " + I2S(SmartSeeya___DCUR))
        endif
        call ResetToGameCamera(0.0)
        call SetCameraField(CAMERA_FIELD_ROTATION, 90, 0.0)
    endfunction
    
    function SmartSeeya___onCommandChat takes nothing returns nothing
        local player p= GetTriggerPlayer()
        local string chat= GetEventPlayerChatString()
        local string cmd= GetEventPlayerChatStringMatched()
        local string arg= SubString(chat, StringLength(cmd), StringLength(chat))
        local integer iArg= S2I(arg)
        if ( iArg < 50 ) or ( iArg > 300 ) then
            call DisplayTextToPlayer(p, 0.0, 0.0, "|c00ff8000Please, enter the FoV value between 50 and 300!|r")
            call StartSoundForPlayerBJ(p, gg_snd_Error)
        else
            call DisplayTextToPlayer(p, 0.0, 0.0, "|c00ff8000FoV has been adjusted|r")
            if GetLocalPlayer() == p then
                set SmartSeeya___DCUR=iArg * 10
            endif
        endif
        set p=null
    endfunction
    
    function SmartSeeya___main takes nothing returns nothing
        call TriggerRegisterTimerEvent(SmartSeeya___T, 0.10, true)
        call TriggerAddAction(SmartSeeya___T, function SmartSeeya___onCallback)
        call SmartSeeya___RegisterCommandTrigger(function SmartSeeya___onCommandChat)
    endfunction
    

//library SmartSeeya ends
//library Splash:

        function s__Splash___filter_E takes nothing returns boolean
            if not IsUnitEnemy(GetFilterUnit(), Splash___PSRC) then
                return false
            endif
            if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) then
                return false
            endif
            return true
        endfunction
        function s__Splash___filter_O takes nothing returns boolean
            if GetOwningPlayer(GetFilterUnit()) != Splash___PSRC then
                return false
            endif
            if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) then
                return false
            endif
            return true
        endfunction
        function s__Splash___filter_A takes nothing returns boolean
            if not IsUnitAlly(GetFilterUnit(), Splash___PSRC) then
                return false
            endif
            if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) then
                return false
            endif
            return true
        endfunction
        function s__Splash___filter_W takes nothing returns boolean
            return not IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD)
        endfunction
        function s__Splash___filter_ANOT takes nothing returns boolean
            if not IsUnitAlly(GetFilterUnit(), Splash___PSRC) then
                return false
            endif
            if GetFilterUnit() == Splash___SRC then
                return false
            endif
            if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) then
                return false
            endif
            return true
        endfunction
        function s__Splash___filter_PNOT takes nothing returns boolean
            if GetOwningPlayer(GetFilterUnit()) != Splash___PSRC then
                return false
            endif
            if GetFilterUnit() == Splash___SRC then
                return false
            endif
            if IsUnitType(GetFilterUnit(), UNIT_TYPE_DEAD) then
                return false
            endif
            return true
        endfunction

        //private static trigger PTRG = null
        function s__splash_onInit takes nothing returns nothing
            set s__splash_ENEMY=Filter(function s__Splash___filter_E)
            set s__splash_PLAYER=Filter(function s__Splash___filter_O)
            set s__splash_ALLY=Filter(function s__Splash___filter_A)
            set s__splash_ANY=Filter(function s__Splash___filter_W)
            set s__splash_ALLYNOTME=Filter(function s__Splash___filter_ANOT)
            set s__splash_PLAYERNOTME=Filter(function s__Splash___filter_PNOT)
        endfunction
        function s__splash__get_src takes nothing returns unit
            return Splash___SRC
        endfunction
        function s__splash__get_srcOwner takes nothing returns player
            return Splash___PSRC
        endfunction
        function s__splash_range takes boolexpr f,unit src,real x,real y,real rng,code c returns nothing
            local group ul= CreateGroup()
            local player ppsrc= Splash___PSRC
            local unit psrc= Splash___SRC
            set Splash___SRC=src
            set Splash___PSRC=GetOwningPlayer(src)
            call GroupEnumUnitsInRange(ul, x, y, rng, f)
            call ForGroup(ul, c)
            call DestroyGroup(ul)
            set ul=null
            set Splash___SRC=psrc
            set Splash___PSRC=ppsrc
            set psrc=null
            set ppsrc=null
        endfunction
        function s__splash_zone takes boolexpr f,unit src,real x,real y,real w,real h,code c returns nothing
            local group ul= CreateGroup()
            //unitList.create()
            local player ppsrc= Splash___PSRC
            local rect r= Rect(x - w / 2, y - h / 2, x + w / 2, y + h / 2)
            set Splash___PSRC=GetOwningPlayer(src)
            call GroupEnumUnitsInRect(ul, r, f)
            call ForGroup(ul, c)
            call DestroyGroup(ul)
            call RemoveRect(r)
            set r=null
            set ul=null
            set Splash___PSRC=ppsrc
            set ppsrc=null
        endfunction
        function s__splash_rect takes boolexpr f,unit src,rect r,code c returns nothing
            local group ul= CreateGroup()
            //unitList.create()
            local player ppsrc= Splash___PSRC
            set Splash___PSRC=GetOwningPlayer(src)
            call GroupEnumUnitsInRect(ul, r, f)
            call ForGroup(ul, c)
            call DestroyGroup(ul)
            set ul=null
            set Splash___PSRC=ppsrc
            set ppsrc=null
        endfunction
    

