    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILEXKingProteaAttack_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXKingProteaAttack_rmTrig[this], s__ABILEXKingProteaAttack_rmAct[this])
        set s__ABILEXKingProteaAttack_rmAct[this]=null
        set s__ABILEXKingProteaAttack_rmTrig[this]=null
        call sc__ABILEXKingProteaAttack_onAbilityLost(this)
        set s__ABILEXKingProteaAttack_source[this]=null
        set s__ABILEXKingProteaAttack_exists[this]=false
    endfunction
    
    function s__ABILEXKingProteaAttack_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXKingProteaAttack_free(this)
    endfunction
    
    function s__ABILEXKingProteaAttack_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILEXKingProteaAttack_onAbilityEffect(this)
    endfunction
    
    function s__ABILEXKingProteaAttack_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXKingProteaAttack_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXKingProteaAttack_exists[this] then
            set s__ABILEXKingProteaAttack_exists[this]=true
            set s__ABILEXKingProteaAttack_source[this]=src
            set s__ABILEXKingProteaAttack_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXKingProteaAttack_rmAct[this]=TriggerAddAction(s__ABILEXKingProteaAttack_rmTrig[this], function s__ABILEXKingProteaAttack_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILEXKingProteaAttack_onSourceUnitAttack)
            call sc__ABILEXKingProteaAttack_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    
    function s__ABILEXKingProteaAttack_EnumShock takes nothing returns nothing
        //call FXRD_FXDebuffShock( GetEnumUnit(), 1.0 )
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 2.0)
        call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) * 0.25 , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXKingProteaAttack_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXKingProteaAttack_LastAttackWasGiant[this]=false
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXKingProteaAttack_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXKingProteaAttack_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit source= GetTriggerUnit()
        local unit target= GetEventDamageSource()
        local real punchBonus
        local real x= GetUnitX(source) + s__Polar_X(250.0 , GetUnitFacing(source))
        local real y= GetUnitY(source) + s__Polar_Y(250.0 , GetUnitFacing(source))
        if IsUnitType(target, UNIT_TYPE_GIANT) then
            if s__ABILEXKingProteaAttack_LastAttackWasGiant[this] != true then
                set s__ABILEXKingProteaAttack_LastAttackWasGiant[this]=true
                call AddUnitAnimationProperties(source, "alternate", true)
                call SetUnitAnimation(source, "attack alternate")
            endif
            set punchBonus=1.7 + 0.1 * GetUnitAbilityLevel(s__ABILEXKingProteaAttack_source[this], 'A0H7')
            call FXRD_FXDebuffShock(target , 1.0)
            call sc__EVDebuffSlow_apply(target , 3.0)
            call s__enemy_dealLogicEx(source , target , sc__EVDamageManager_getFinalDamage(source) * punchBonus , true , true , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        else
            if s__ABILEXKingProteaAttack_LastAttackWasGiant[this] != false then
                set s__ABILEXKingProteaAttack_LastAttackWasGiant[this]=false
                call AddUnitAnimationProperties(source, "alternate", false)
                call SetUnitAnimation(source, "attack")
            endif
            call DestroyEffect(AddSpecialEffect("FX\\ElizabethAlter\\Wave.mdl", x, y))
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", x, y))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\MeatwagonMissile\\MeatwagonMissile.mdl", target, "chest"))
            call s__enemy_dealLogicEx(source , target , 99999999.0 , true , false , WEAPON_TYPE_WHOKNOWS , 1)
            call s__splash_range(s__splash_ENEMY , source , x , y , 750.0 , function s__ABILEXKingProteaAttack_EnumShock)
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o01E', x, y, GetRandomReal(0.0, 360.0)))
        endif
        set source=null
        set target=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("EXKingProteaGrowUpGrow")
//end of: 어빌리티_선언_개시("EXKingProteaGrowUpGrow")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILEXKingProteaGrowUpGrow_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXKingProteaGrowUpGrow_rmTrig[this], s__ABILEXKingProteaGrowUpGrow_rmAct[this])
        set s__ABILEXKingProteaGrowUpGrow_rmAct[this]=null
        set s__ABILEXKingProteaGrowUpGrow_rmTrig[this]=null
        call sc__ABILEXKingProteaGrowUpGrow_onAbilityLost(this)
        call s__tick_destroy(s__ABILEXKingProteaGrowUpGrow_durTik[this])
        set s__ABILEXKingProteaGrowUpGrow_source[this]=null
        set s__ABILEXKingProteaGrowUpGrow_exists[this]=false
    endfunction
    
    function s__ABILEXKingProteaGrowUpGrow_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXKingProteaGrowUpGrow_free(this)
    endfunction
    
    function s__ABILEXKingProteaGrowUpGrow_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILEXKingProteaGrowUpGrow_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILEXKingProteaGrowUpGrow_source[this]) then
            return
        endif
        call sc__ABILEXKingProteaGrowUpGrow_onAbilityEffect(this)
        call s__tick_start(s__ABILEXKingProteaGrowUpGrow_durTik[this],s__ABILEXKingProteaGrowUpGrow_duration[this] , false , function s__ABILEXKingProteaGrowUpGrow_onExpire)
    endfunction
    
    function s__ABILEXKingProteaGrowUpGrow_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXKingProteaGrowUpGrow_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXKingProteaGrowUpGrow_exists[this] then
            set s__ABILEXKingProteaGrowUpGrow_exists[this]=true
            set s__ABILEXKingProteaGrowUpGrow_source[this]=src
            set s__ABILEXKingProteaGrowUpGrow_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXKingProteaGrowUpGrow_rmAct[this]=TriggerAddAction(s__ABILEXKingProteaGrowUpGrow_rmTrig[this], function s__ABILEXKingProteaGrowUpGrow_OnSourceRemove)
            
            set s__ABILEXKingProteaGrowUpGrow_duration[this]=dur
            set s__ABILEXKingProteaGrowUpGrow_defaultDuration[this]=dur
            set s__ABILEXKingProteaGrowUpGrow_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILEXKingProteaGrowUpGrow_durTik[this],dur , false , function s__ABILEXKingProteaGrowUpGrow_onExpire)
            call sc__ABILEXKingProteaGrowUpGrow_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXKingProteaGrowUpGrow_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXKingProteaGrowUpGrow_PrevBonus[this]=0
        call sc__EVDamageManager_addAdditive(s__ABILEXKingProteaGrowUpGrow_source[this] , s__ABILEXKingProteaGrowUpGrow_PrevBonus[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXKingProteaGrowUpGrow_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXKingProteaGrowUpGrow_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer playerGiants= 0
        local real scale
        local integer sizeLevel
        set playerGiants=playerGiants + GetPlayerUnitTypeCount(GetOwningPlayer(s__ABILEXKingProteaGrowUpGrow_source[this]), '-SAX')
        set playerGiants=playerGiants + GetPlayerUnitTypeCount(GetOwningPlayer(s__ABILEXKingProteaGrowUpGrow_source[this]), '-ALX')
        //set playerGiants = GetPlayerUnitTypeCount(GetOwningPlayer(.source),'-SAX') /*거신 다크에르*/
        if playerGiants > 1 then
            return
        endif
        call sc__EVDamageManager_addAdditive(s__ABILEXKingProteaGrowUpGrow_source[this] , - s__ABILEXKingProteaGrowUpGrow_PrevBonus[this])
        set s__ABILEXKingProteaGrowUpGrow_PrevBonus[this]=s__ABILEXKingProteaGrowUpGrow_PrevBonus[this] + 10
        
        call sc__EVDamageManager_addAdditive(s__ABILEXKingProteaGrowUpGrow_source[this] , s__ABILEXKingProteaGrowUpGrow_PrevBonus[this])
        set scale=0.8 + s__ABILEXKingProteaGrowUpGrow_PrevBonus[this] * 0.0002
        call SetUnitScale(s__ABILEXKingProteaGrowUpGrow_source[this], scale, scale, scale)
        set sizeLevel=1 + ( s__ABILEXKingProteaGrowUpGrow_PrevBonus[this] / 200 )
        call SetUnitAbilityLevel(s__ABILEXKingProteaGrowUpGrow_source[this], 'A0H7', IMinBJ(10, sizeLevel))
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
