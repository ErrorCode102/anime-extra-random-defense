        function SVRHYME__EnumSplashB takes nothing returns nothing
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\FrostBolt\\FrostBoltMissile.mdl", GetEnumUnit(), "chest"))
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 1.0)
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
        endfunction
        function SVRHYME__EnumSplashA takes nothing returns nothing
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\FrostBolt\\FrostBoltMissile.mdl", GetEnumUnit(), "chest"))
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 2.0)
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
        endfunction
        function SVRHYME__EnumSplashS takes nothing returns nothing
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\FrostBolt\\FrostBoltMissile.mdl", GetEnumUnit(), "chest"))
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 3.0)
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
        endfunction
//textmacro instance: 서번트_무기_범위형("OnSplashAttackB","300","EnumSplashB")
        function SVRHYME__OnSplashAttackB takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
