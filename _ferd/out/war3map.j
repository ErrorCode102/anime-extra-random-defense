    function FXTrig0SGameSetting___diagnoseChallenge takes nothing returns nothing
        if MODE_CURRENT > MODE_TEAM then
            call ClearPanalty()
            return
        endif
        //페널티 5개부터 보너스 경험치 100% 적용
        if PANALTY_COUNT > 4 then
            set USER_XP_BONUS[0]=USER_XP_BONUS[0] + 100
            set USER_XP_BONUS[1]=USER_XP_BONUS[1] + 100
            set USER_XP_BONUS[2]=USER_XP_BONUS[2] + 100
            set USER_XP_BONUS[3]=USER_XP_BONUS[3] + 100
        endif
    endfunction
    
    function FXTrig0SGameSetting___setUserTitle takes player p returns nothing
        local integer id= GetPlayerId(p)
        local integer hash= StringHash(USER_NAME[id])
        local string name= GetPlayerName(p)
        local string prefix= ""
        local integer maxx= FXCountPlayerFactionMastered(p)
        local boolean haveTitle= false
        if HaveSavedString(FXTrig0SGameSetting___T, 0, hash) then
            set haveTitle=true
            set name=LoadStr(FXTrig0SGameSetting___T, 0, hash)
        endif
        set USER_NAME_CURRENT[id]=name
        call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 1)
        if not USER_IS_FIRSTPLAY[id] then
            set prefix="Frame "
            if maxx == 1 then
                set prefix="Count "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 2)
            endif
            if maxx == 2 then
                set prefix="Cause "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 2)
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_GOLD, 100)
            endif
            if maxx == 3 or maxx == 4 then
                set prefix="Fes "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 2)
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_GOLD, 200)
            endif
            if maxx == 5 then
                set prefix="Pride "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 3)
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_GOLD, 200)
            endif
            if FXGetPlayerMasterLevel(p) >= 90 then
                set prefix="Brand "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 4)
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_GOLD, 300)
            endif
            if FXGetPlayerMasterLevel(p) == 1000 then
                set prefix="Grand "
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_LUMBER, 4)
                call SetPlayerState(Player(id), PLAYER_STATE_RESOURCE_GOLD, 300)
            endif
        endif
        if haveTitle then
            set prefix=""
        endif
        if DATA_SESSION[id] == 0 then
            set prefix="|c00000000" + prefix
        endif
        call SetPlayerName(p, prefix + name)
    endfunction
    function FXTrig0SGameSetting___diagnosePlayer takes nothing returns nothing
        local integer i= 0
        local integer myFax
        loop
            exitwhen i == 4
            set USER_IS_PLAYING[i]=IsPlayerPlaying(Player(i))
            if USER_IS_PLAYING[i] then
                set myFax=FXGetPlayerCurrentFaction(Player(i))
                
                if myFax == 0 then
                    if FXIsPlayerMaster(Player(i)) then
                        
                        call FXSetPlayerCurrentFaction(Player(i) , GetRandomInt(1, 5))
                    else
                        
                        call FXSetPlayerCurrentFaction(Player(i) , GetRandomInt(1, 3))
                    endif
                    set myFax=FXGetPlayerCurrentFaction(Player(i))
                endif
                
                //마스터 보너스 적용 여부
                if FXIsPlayerCurrentFactionMastered(Player(i)) then
                    set USER_IS_MASTER[i]=true
                endif
                //각 세력 보너스 적용 여부
                if myFax == 3 then
                    call SetPlayerTechResearched(Player(i), 'R00E', 15)
                    call SetPlayerTechResearched(Player(i), 'R00D', 15)
                    call SetPlayerTechResearched(Player(i), 'R00C', 15)
                    call SetPlayerTechResearched(Player(i), 'R00B', 15)
                    call SetPlayerTechResearched(Player(i), 'R00A', 15)
                    call SetPlayerTechResearched(Player(i), 'R00S', 15)
                    call SetPlayerTechResearched(Player(i), 'R0EX', 15)
                    call SetPlayerTechResearched(Player(i), 'R0XS', 15)
                endif
                call FXTrig0SGameSetting___setUserTitle(Player(i))
            endif
            set i=i + 1
        endloop
    endfunction
    
    function FXTrig0SGameSetting___diagnoseGame takes nothing returns nothing
        local integer myLife
        if MODE_CURRENT == MODE_SPEEDRUN then
            call CONTHideTerrainCenter()
            set FXRD_UNION_WAVE=false
        endif
        if MODE_CURRENT == MODE_TEAM then
            set FXRD_UNION_LINE=true
            set FXRD_UNION_LIFE=true
        else
            call CONTHideTerrainBridge()
        endif
        //Diagnose Level
        call SetPlayerName(Player(4), "Enemy|n" + LEVEL_NAME[LEVEL_CURRENT])
        call SetPlayerName(Player(5), "Enemy|n" + LEVEL_NAME[LEVEL_CURRENT])
        call SetPlayerName(Player(6), "Enemy|n" + LEVEL_NAME[LEVEL_CURRENT])
        call SetPlayerName(Player(7), "Enemy|n" + LEVEL_NAME[LEVEL_CURRENT])
        set myLife=LEVEL_LIFE[LEVEL_CURRENT]
        if GetPanalty(PANALTY_LIFE_HALF) then
            set myLife=myLife / 2
        endif
        set FXRD_LIFE[0]=myLife
        set FXRD_LIFE[1]=myLife
        set FXRD_LIFE[2]=myLife
        set FXRD_LIFE[3]=myLife
        if FXRD_UNION_LIFE then
            set FXRD_LIFE[11]=myLife * CountInGameUser()
        endif
    endfunction
    
    function FXTrig0SGameSetting___onGameInit takes nothing returns nothing
        set GAME_IS_PLAYING=true
        call FXTrig0SGameSetting___diagnoseChallenge()
        call FXTrig0SGameSetting___diagnosePlayer()
        call FXTrig0SGameSetting___diagnoseGame()
        // 게임 시간 흐름
        call SuspendTimeOfDay(false)
        // 도움말 표시
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, "|c000FA3F0※TIP : Help & commands can be found by pressing |c00FF8000ALT + H|r")
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10.0, GAME_WELCOME)
    endfunction
    
    function FXTrig0SGameSetting___main takes nothing returns nothing
        // KOR/ENG version name data
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("escaco"), "동동주")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("anongs"), "사각오리")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("dasboots"), "다스부츠")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("konan"), "코난")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("J"), "제이")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("WhiteSpirit"), "|c00A9D6E8정|c00FF80FF령|r")
        // Credits
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("Arterion"), "|cffff0303(구)노예 알테리온|r")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("Vo.Shecil"), "|cff540081코노트의 성녀 여우 세실|r")
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("Morikubo"), "|cff368bc1빙하의 유명인사 멜트|r")
        // Model 후원
        call SaveStr(FXTrig0SGameSetting___T, 0, StringHash("Devil"), "|c00FF4040[Devil] |c00404040Semiramis|c00FF4040♥|r")
        // NB version name data
        // -END-
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXTrig0SGameSetting___onGameInit)
    endfunction
// scope FXTrig0SGameSetting ends
