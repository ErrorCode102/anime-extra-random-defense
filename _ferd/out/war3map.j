        set PLAYtryboss___PREFIX[1]="D"
        set PLAYtryboss___PREFIX[2]="C"
        set PLAYtryboss___PREFIX[3]="B"
        set PLAYtryboss___PREFIX[4]="A"
        set PLAYtryboss___PREFIX[5]="S"
        set PLAYtryboss___PREFIX[6]="EX"
        set PLAYtryboss___PREFIX[7]="★"
        set PLAYtryboss___PREFIX[8]="CCC"
        set PLAYtryboss___PREFIX[9]="Hidden"
        set PLAYtryboss___PREFIX[10]="FINAL"
        
        set PLAYtryboss___UMOTION[1]=1
