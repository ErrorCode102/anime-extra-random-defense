        call s__tick_start(s__BossSkillSplash_coolTick[this],delay , false , function sc__BossSkillSplash_onCastSpell)
    endfunction
    
    //구현부
    function s__BossSkillSplash_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__BossSkillSplash_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__BossSkillSplash_coolTick[this])
        set s__BossSkillSplash_myServant[this]=null
        call TriggerUnbindAction(s__BossSkillSplash_onRemoveAction[this])
        set s__BossSkillSplash_onRemoveAction[this]=null
        //종결
        call s__BossSkillSplash_destroy(this)
    endfunction
    function s__BossSkillSplash_enumStunServant takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        call s__EVDebuffStunServant_apply(GetEnumUnit() , 10.00)
        call FXRD_FXKnockbackFromTo(GetEnumUnit() , s__BossSkillSplash_myServant[this] , 700 , 250 , 0.625)
    endfunction
    function s__BossSkillSplash_onCharge takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__BossSkillSplash_myServant[this]) then
            call s__tick_pause(s__BossSkillSplash_coolTick[this])
            return
        endif
        call KillUnit(CreateUnit(Player(15), 'h00N', GetUnitX(s__BossSkillSplash_myServant[this]), GetUnitY(s__BossSkillSplash_myServant[this]), 270.00))
        call s__splash_range(s__splash_ANY , null , GetUnitX(s__BossSkillSplash_myServant[this]) , GetUnitY(s__BossSkillSplash_myServant[this]) , 700 , function s__BossSkillSplash_enumStunServant)
        call s__tick_start(s__BossSkillSplash_coolTick[this],s__BossSkillSplash_myCooldown[this] , false , function sc__BossSkillSplash_onCastSpell)
    endfunction
    function s__BossSkillSplash_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local unit u
        if IsUnitDead(s__BossSkillSplash_myServant[this]) then
            call s__tick_pause(s__BossSkillSplash_coolTick[this])
            return
        endif
        set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , GetUnitX(s__BossSkillSplash_myServant[this]) , GetUnitY(s__BossSkillSplash_myServant[this]) , 270 , 255 , 0 , 0 , 255 , 7)
        call FXRD_FXBinderBindUnit(u , s__BossSkillSplash_myServant[this])
        call UnitApplyTimedLife(u, 'BHwe', 10.00)
        call sc__DummyFollowUnit_cast(u , s__BossSkillSplash_myServant[this])
        set u=null
        call s__tick_start(s__BossSkillSplash_coolTick[this],s__BossSkillSplash_myCharge[this] , false , function s__BossSkillSplash_onCharge)
    endfunction
    
