// scope FXTrigAboutStatusBoard begins
    function FXTrigAboutStatusBoard___onResourceChange takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer myFax= FXGetPlayerCurrentFaction(GetTriggerPlayer())
        local string name
        if not USER_IS_PLAYING[id] then
            return
        endif
        set name=FXGetFactionName(myFax)
        if FXIsPlayerCurrentFactionMastered(Player(id)) then
            set name=FXGetFactionMasterName(myFax)
        endif
        call s__statusBoard_setStat(id , name + " (|c00FFFF00" + I2S(GetPlayerGold(Player(id))) + "G|r/|c004040FF" + I2S(GetPlayerLumber(Player(id))) + "S|r)")
    endfunction
    
    function FXTrigAboutStatusBoard___main takes nothing returns nothing
        local integer i= 0
        local trigger T= CreateTrigger()
        call TriggerAddAction(T, function FXTrigAboutStatusBoard___onResourceChange)
        loop
            exitwhen i == 4
            call TriggerRegisterPlayerStateEvent(T, Player(i), PLAYER_STATE_RESOURCE_GOLD, GREATER_THAN_OR_EQUAL, 0)
            call TriggerRegisterPlayerStateEvent(T, Player(i), PLAYER_STATE_RESOURCE_LUMBER, GREATER_THAN_OR_EQUAL, 0)
            set i=i + 1
        endloop
    endfunction
// scope FXTrigAboutStatusBoard ends
// Trigger: FX Trig When Player Leave
//===========================================================================
// scope FXwhenplayerleave begins
    //구현부
    function FXwhenplayerleave___atObserverLeave takes player p returns nothing
        local integer id= GetPlayerId(p)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 30.00, s__pcs__staticgetindex(id) + GetPlayerName(p) + "|r stopped watching and left the game.")
    endfunction
    function FXwhenplayerleave___atUserLeave takes player p returns nothing
        local integer id= GetPlayerId(p)
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 30.00, s__pcs__staticgetindex(id) + GetPlayerName(p) + "|r left the game!")
        //나간 유저를 뒤처리
        call CleanupUser(p)
    endfunction
    //핵심 알고리즘
    function FXwhenplayerleave___onPlayerLeave takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        //게임이 진행되기 전에 나간 상황은 처리하지 않습니다.
        if not GAME_IS_PLAYING then
            return
        endif
        if id > 3 then
            //옵저버가 나감
            call FXwhenplayerleave___atObserverLeave(GetTriggerPlayer())
            return
        endif
        //유저가 나감
        if USER_IS_PLAYING[id] then
            //플레이 중인 유저가 나감 : 뒤처리 필요
            call FXwhenplayerleave___atUserLeave(GetTriggerPlayer())
        else
            //패배한 상태에서 관전중인 유저가 나감
            call FXwhenplayerleave___atObserverLeave(GetTriggerPlayer())
        endif
    endfunction
    //초기화
    function FXwhenplayerleave___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterPlayerEventLeave(t, Player(0))
        call TriggerRegisterPlayerEventLeave(t, Player(1))
        call TriggerRegisterPlayerEventLeave(t, Player(2))
        call TriggerRegisterPlayerEventLeave(t, Player(3))
        
        call TriggerRegisterPlayerEventLeave(t, Player(8))
        call TriggerRegisterPlayerEventLeave(t, Player(9))
        call TriggerRegisterPlayerEventLeave(t, Player(10))
        call TriggerAddAction(t, function FXwhenplayerleave___onPlayerLeave)
    endfunction
// scope FXwhenplayerleave ends
