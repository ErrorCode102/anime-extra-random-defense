        call sc__TLMeltPenguinBLUS_apply(s__ABILMeltPenguinDSummerPal_source[this] , x , y , sc__EVDamageManager_getFinalDamage(s__ABILMeltPenguinDSummerPal_source[this]) * 30.0)
