    endfunction
    
    //API
    function s__EV141FrancisB_append takes unit src,integer amt returns nothing
        local integer this= s__EV141FrancisB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV141FrancisB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV141FrancisB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV141FrancisB_onSourceUnitRemove)
        set s__EV141FrancisB_myServant[this]=src
        set s__EV141FrancisB_myAmount[this]=amt
        call s__EVServantAttack_addFunction(src , function sc__EV141FrancisB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV141FrancisB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if not DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set this=s__EV141FrancisB_getThis(GetUnitUserData(src))
        call AddPlayerGold(GetOwningPlayer(src) , s__EV141FrancisB_myAmount[this])
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetUnitX(dst), GetUnitY(dst)))
        call SetSoundPosition(gg_snd_Gold, GetUnitX(dst), GetUnitY(dst), 200)
        call StartSoundForPlayerBJ(GetOwningPlayer(src), gg_snd_Gold)
        call s__bountyTag_custom(GetOwningPlayer(src) , GetUnitX(dst) , GetUnitY(dst) + 64 , "|c00FFFF00+" + I2S(s__EV141FrancisB_myAmount[this]))
        set src=null
        set dst=null
    endfunction
    
    function s__EV141FrancisB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV141FrancisB_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV141FrancisB_myServant[this]=null
        call TriggerUnbindAction(s__EV141FrancisB_onRemoveAction[this])
        set s__EV141FrancisB_onRemoveAction[this]=null
        //종결
        call s__EV141FrancisB_destroy(this)
    endfunction
    
//===========================================================================
// Trigger: EV 142 NeroA
//===========================================================================

    
    function s__EV142NeroA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV142NeroA_STRUCT_ID)
    endfunction
    
    function s__EV142NeroA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV142NeroA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV142NeroA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV142NeroA__allocate()
        set s__EV142NeroA_ID[this]=GetUnitUserData(src)
        call s__EV142NeroA_setThis(s__EV142NeroA_ID[this] , this)
        return this
    endfunction
    
    function s__EV142NeroA_destroy takes integer this returns nothing
        call s__EV142NeroA_setThis(s__EV142NeroA_ID[this] , 0)
        call s__EV142NeroA_deallocate(this)
    endfunction
    
    //API
    function s__EV142NeroA_append takes unit src,real dmg,real coold,real mtpl returns nothing
        local integer this= s__EV142NeroA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV142NeroA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV142NeroA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV142NeroA_onSourceUnitRemove)
        set s__EV142NeroA_myServant[this]=src
        set s__EV142NeroA_myCooldown[this]=coold
        set s__EV142NeroA_myDamage[this]=dmg
        set s__EV142NeroA_myMtpl[this]=mtpl
        set s__EV142NeroA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV142NeroA_coolTick[this],1.00 , true , function sc__EV142NeroA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV142NeroA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV142NeroA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV142NeroA_coolTick[this])
        set s__EV142NeroA_myServant[this]=null
        call TriggerUnbindAction(s__EV142NeroA_onRemoveAction[this])
        set s__EV142NeroA_onRemoveAction[this]=null
        //종결
        call s__EV142NeroA_destroy(this)
    endfunction
    
    
    function s__EV142NeroA_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV142NeroA_CNT) == 0 then
            set s__EV142NeroA_DEST=GetEnumUnit()
        endif
        set s__EV142NeroA_CNT=s__EV142NeroA_CNT + 1
    endfunction
    
    function s__EV142NeroA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local real mtpl
        if IsUnitType(s__EV142NeroA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV142NeroA_coolTick[this])
            return
        endif
        set s__EV142NeroA_DEST=null
        set s__EV142NeroA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV142NeroA_myServant[this] , GetUnitX(s__EV142NeroA_myServant[this]) , GetUnitY(s__EV142NeroA_myServant[this]) , 400 , function s__EV142NeroA_enumGetTarget)
        //대상이 없으면
        if s__EV142NeroA_DEST == null then
            call s__tick_start(s__EV142NeroA_coolTick[this],1.00 , true , function s__EV142NeroA_onCastSpell)
            return
        endif
        //쿨 걸리면
        set mtpl=s__EV142NeroA_myMtpl[this]
        if GetUnitAbilityLevel(s__EV142NeroA_myServant[this], 'A08O') > 0 then
            set mtpl=mtpl * 2.00
        endif
        call s__CMBladestorm_cast(s__EV142NeroA_myServant[this] , s__EV142NeroA_myDamage[this] + s__EVDamageManager_getFinalDamage(s__EV142NeroA_myServant[this]) * mtpl , 10)
        call s__tick_start(s__EV142NeroA_coolTick[this],s__EV142NeroA_myCooldown[this] , true , function s__EV142NeroA_onCastSpell)
        set s__EV142NeroA_DEST=null
    endfunction
    

//===========================================================================
// Trigger: EV 143 NeroB
//===========================================================================

    
    function s__EV143NeroB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV143NeroB_STRUCT_ID)
    endfunction
    
    function s__EV143NeroB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV143NeroB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV143NeroB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV143NeroB__allocate()
        set s__EV143NeroB_ID[this]=GetUnitUserData(src)
        call s__EV143NeroB_setThis(s__EV143NeroB_ID[this] , this)
        return this
    endfunction
    
    function s__EV143NeroB_destroy takes integer this returns nothing
        call s__EV143NeroB_setThis(s__EV143NeroB_ID[this] , 0)
        call s__EV143NeroB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV143NeroB_append takes unit src,integer cmb returns nothing
        local integer this= s__EV143NeroB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV143NeroB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV143NeroB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV143NeroB_onSourceUnitRemove)
        set s__EV143NeroB_myServant[this]=src
        set s__EV143NeroB_myMaxCombo[this]=cmb
        set s__EV143NeroB_myCombo[this]=s__EV143NeroB_myMaxCombo[this]
        set s__EV143NeroB_myHandEffect[this]=null
        call s__EVServantAttack_addFunction(src , function sc__EV143NeroB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV143NeroB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        local real mtpl
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV143NeroB_getThis(GetUnitUserData(src))
        set s__EV143NeroB_myCombo[this]=s__EV143NeroB_myCombo[this] - 1
        if s__EV143NeroB_myCombo[this] == 1 then
            if s__EV143NeroB_myHandEffect[this] != null then
                call DestroyEffect(s__EV143NeroB_myHandEffect[this])
            endif
            set s__EV143NeroB_myHandEffect[this]=AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__EV143NeroB_myServant[this], "weapon right")
        endif
        if s__EV143NeroB_myCombo[this] == 0 then
            if s__EV143NeroB_myHandEffect[this] != null then
                call DestroyEffect(s__EV143NeroB_myHandEffect[this])
                set s__EV143NeroB_myHandEffect[this]=null
            endif
            set s__EV143NeroB_myCombo[this]=s__EV143NeroB_myMaxCombo[this]
            //cast it
            set mtpl=5.00
            if GetUnitAbilityLevel(s__EV143NeroB_myServant[this], 'A08O') > 0 then
                set mtpl=mtpl * 2.00
            endif
            call s__CMThrust_cast(s__EV143NeroB_myServant[this] , dst , s__EVDamageManager_getFinalDamage(s__EV143NeroB_myServant[this]) * mtpl)
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV143NeroB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV143NeroB_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV143NeroB_myHandEffect[this] != null then
            call DestroyEffect(s__EV143NeroB_myHandEffect[this])
            set s__EV143NeroB_myHandEffect[this]=null
        endif
        set s__EV143NeroB_myServant[this]=null
        call TriggerUnbindAction(s__EV143NeroB_onRemoveAction[this])
        set s__EV143NeroB_onRemoveAction[this]=null
        //종결
        call s__EV143NeroB_destroy(this)
    endfunction
    
    

