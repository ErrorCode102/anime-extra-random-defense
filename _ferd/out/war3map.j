    function s__ABILBBSSPotnia_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSPotnia_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSPotnia_exists[this] then
            set s__ABILBBSSPotnia_exists[this]=true
            set s__ABILBBSSPotnia_source[this]=src
            set s__ABILBBSSPotnia_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSPotnia_rmAct[this]=TriggerAddAction(s__ABILBBSSPotnia_rmTrig[this], function s__ABILBBSSPotnia_OnSourceRemove)
            
            set s__ABILBBSSPotnia_duration[this]=dur
            set s__ABILBBSSPotnia_defaultDuration[this]=dur
            set s__ABILBBSSPotnia_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILBBSSPotnia_durTik[this],dur , false , function s__ABILBBSSPotnia_onExpire)
            call sc__ABILBBSSPotnia_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILBBSSPotnia_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILBBSSPotnia_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBBSSPotnia_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer clev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSPotnia_source[this]) < 20, 1, 2)
        if GetUnitAbilityLevel(s__ABILBBSSPotnia_source[this], 'A0H4') != clev then
            call SetUnitAbilityLevel(s__ABILBBSSPotnia_source[this], 'A0H4', clev)
        endif
        if clev < 2 then
            return
        endif
        if GetUnitAbilityLevel(s__ABILBBSSPotnia_source[this], 'BPSE') == 0 then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", s__ABILBBSSPotnia_source[this], "origin"))
        call SetUnitState(s__ABILBBSSPotnia_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILBBSSPotnia_source[this], UNIT_STATE_MANA) + 25.0)
        call sc__EVDebuffStunServant_clear(s__ABILBBSSPotnia_source[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//textmacro instance: 어빌리티_선언_개시("BBSSAConsume")
//end of: 어빌리티_선언_개시("BBSSAConsume")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0EM")
    
    function s__ABILBBSSAConsume_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBBSSAConsume_onSpellEffect[this], s__ABILBBSSAConsume_onSpellEffectAction[this])
        set s__ABILBBSSAConsume_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILBBSSAConsume_onSpellEffect[this])
        set s__ABILBBSSAConsume_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILBBSSAConsume_rmTrig[this], s__ABILBBSSAConsume_rmAct[this])
        set s__ABILBBSSAConsume_rmAct[this]=null
        set s__ABILBBSSAConsume_rmTrig[this]=null
        call sc__ABILBBSSAConsume_onAbilityLost(this)
        set s__ABILBBSSAConsume_source[this]=null
        set s__ABILBBSSAConsume_exists[this]=false
    endfunction
    
    function s__ABILBBSSAConsume_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSAConsume_free(this)
    endfunction
    
    function s__ABILBBSSAConsume_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSAConsume_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSAConsume_exists[this] then
            set s__ABILBBSSAConsume_exists[this]=true
            set s__ABILBBSSAConsume_source[this]=src
            set s__ABILBBSSAConsume_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSAConsume_rmAct[this]=TriggerAddAction(s__ABILBBSSAConsume_rmTrig[this], function s__ABILBBSSAConsume_OnSourceRemove)
            set s__ABILBBSSAConsume_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILBBSSAConsume_onSpellEffect[this], Condition(function sc__ABILBBSSAConsume_conditionSpellEffect))
            set s__ABILBBSSAConsume_onSpellEffectAction[this]=TriggerAddAction(s__ABILBBSSAConsume_onSpellEffect[this], function sc__ABILBBSSAConsume_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILBBSSAConsume_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILBBSSAConsume_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILBBSSAConsume_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILBBSSAConsume_exists[this] then
            return
        endif
        call sc__ABILBBSSAConsume_onAbilityEffect(this)
    endfunction
    
    function s__ABILBBSSAConsume_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILBBSSAConsume_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0EM")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILBBSSAConsume_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILBBSSAConsume_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILBBSSAConsume_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILBBSSAConsume_source[this])
        local boolean isError= false
        local string errmsg= "|c00FF0000Unknown Error!|r"
        local integer level= GetUnitLevel(GetSpellTargetUnit())
        local integer statamt= 0
        local integer stat
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GP') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『Raw power......it's too much.......』|r"
            else
                set errmsg=errmsg + "BB『How can it happen.......』|r"
            endif
        endif
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GO') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『It's unsightly.』|r"
            else
                set errmsg=errmsg + "BB『It tastes awful.』|r"
            endif
        endif
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A02W') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『I can't believe you're above me.......』|r"
            else
                set errmsg=errmsg + "BB『I can't accept this result......!』|r"
            endif
        endif
        if level > 7 then
            set isError=true
            set errmsg="|c00FF0000This unit cannot be consumed|r"
        endif
        if level < 4 then
            set isError=true
            set errmsg="|c00FF0000Too weak to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『It is unnecessary.』|r"
            else
                set errmsg=errmsg + "BB『You are so incompetent.』|r"
            endif
        endif
        if not IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            set isError=true
            set errmsg="|c00FF0000This unit cannot be consumed|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『......Hmm.』|r"
            else
                set errmsg=errmsg + "BB『Really.......』|r"
            endif
        endif
        if GetOwningPlayer(GetSpellTargetUnit()) != p then
            set isError=true
            set errmsg="|c00FF0000It's not a player-owned unit.|r"
        endif
        if GetUnitAbilityLevel(s__ABILBBSSAConsume_source[this], 'A0EM') <= 1 then
            set isError=true
            set errmsg="|c00FF0000Level is too low|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『Weak.』|r"
            else
                set errmsg=errmsg + "BB『......Small.』|r"
            endif
        endif
        
        if isError then
            call StartSoundForPlayerBJ(p, gg_snd_Error)
            call DisplayTextToPlayer(p, 0.0, 0.0, errmsg)
        else
            call s__servant_kill(GetSpellTargetUnit() , true)
            set errmsg="BB's |c00FFFF00XP|r "
            if level == 4 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 100, true)
                set errmsg=errmsg + "|c00808080" + I2S(100) + "|r"
                set statamt=10
            endif
            if level == 5 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 250, true)
                set errmsg=errmsg + "|c00808080" + I2S(250) + "|r"
                set statamt=25
            endif
            if level == 6 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 1000, true)
                set errmsg=errmsg + "|c00808080" + I2S(1000) + "|r"
                set statamt=80
            endif
            if level == 7 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 1500, true)
                set errmsg=errmsg + "|c00808080" + I2S(1500) + "|r"
                set statamt=115
            endif
            set errmsg=errmsg + " increases!\nBB's "
            set stat=GetRandomInt(0, 2)
            if stat == 0 then
                call SetHeroInt(s__ABILBBSSAConsume_source[this], GetHeroInt(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c004040FFIntelligence|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIim\\AIimTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            if stat == 1 then
                call SetHeroAgi(s__ABILBBSSAConsume_source[this], GetHeroAgi(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c0040FF40Agility|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            if stat == 2 then
                call SetHeroStr(s__ABILBBSSAConsume_source[this], GetHeroStr(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c00FF8000Strength|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            set errmsg=errmsg + "|c00808080" + I2S(statamt) + "|r increases!"
            call DisplayTextToPlayer(p, 0.0, 0.0, errmsg)
        endif
        set p=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("BBSSBAllKill")
//end of: 어빌리티_선언_개시("BBSSBAllKill")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0EQ")
    
    function s__ABILBBSSBAllKill_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBBSSBAllKill_onSpellEffect[this], s__ABILBBSSBAllKill_onSpellEffectAction[this])
        set s__ABILBBSSBAllKill_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILBBSSBAllKill_onSpellEffect[this])
        set s__ABILBBSSBAllKill_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILBBSSBAllKill_rmTrig[this], s__ABILBBSSBAllKill_rmAct[this])
        set s__ABILBBSSBAllKill_rmAct[this]=null
        set s__ABILBBSSBAllKill_rmTrig[this]=null
        call sc__ABILBBSSBAllKill_onAbilityLost(this)
        set s__ABILBBSSBAllKill_source[this]=null
        set s__ABILBBSSBAllKill_exists[this]=false
    endfunction
    
    function s__ABILBBSSBAllKill_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSBAllKill_free(this)
    endfunction
    
    function s__ABILBBSSBAllKill_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSBAllKill_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSBAllKill_exists[this] then
            set s__ABILBBSSBAllKill_exists[this]=true
            set s__ABILBBSSBAllKill_source[this]=src
            set s__ABILBBSSBAllKill_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSBAllKill_rmAct[this]=TriggerAddAction(s__ABILBBSSBAllKill_rmTrig[this], function s__ABILBBSSBAllKill_OnSourceRemove)
            set s__ABILBBSSBAllKill_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILBBSSBAllKill_onSpellEffect[this], Condition(function sc__ABILBBSSBAllKill_conditionSpellEffect))
            set s__ABILBBSSBAllKill_onSpellEffectAction[this]=TriggerAddAction(s__ABILBBSSBAllKill_onSpellEffect[this], function sc__ABILBBSSBAllKill_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILBBSSBAllKill_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILBBSSBAllKill_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILBBSSBAllKill_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILBBSSBAllKill_exists[this] then
            return
        endif
        call sc__ABILBBSSBAllKill_onAbilityEffect(this)
    endfunction
    
    function s__ABILBBSSBAllKill_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILBBSSBAllKill_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0EQ")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
