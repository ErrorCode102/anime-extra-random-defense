            call sc__EV102BBA_append(s__eventServantAdd_e , 3 , true , 400)
            call sc__EV126BBB_append(s__eventServantAdd_e , 8.0 , 3.0 , 4)
            call s__FXBB_cast(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call sc__EV102BBA_append(s__eventServantAdd_e , 3 , true , 600)
            call sc__EV126BBB_append(s__eventServantAdd_e , 8.0 , 5.0 , 5)
            call s__FXBB_cast(s__eventServantAdd_e)
        endif
