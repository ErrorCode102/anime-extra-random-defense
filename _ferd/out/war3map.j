    function s__ABILBBSSBAllKill_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitAbilityLevel(s__ABILBBSSBAllKill_source[this], 'A0EQ') > 1 then
            call sc__TLBBSSAllKill_apply(s__ABILBBSSBAllKill_source[this])
        endif
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
