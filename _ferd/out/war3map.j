    function Test_Closeto takes real x,real y returns boolean
        return RAbsBJ(x - y) <= 0.001
    endfunction

    function Test___prop_Closeto takes nothing returns boolean
        return Test_Closeto(1 , 1) and Test_Closeto(1 , 1.0005) and not Test_Closeto(0 , 1)
    endfunction
    
    function Test_DebugMsg takes string s returns nothing
        call BJDebugMsg(s)
        call Cheat("DebugMsg: " + s)
    endfunction  
   
    function Test_Assert takes string name,integer t returns nothing
        if sc___prototype54_evaluate(t) then
            //call BJDebugMsg("|cff00ff00"+"OK  "+"|r"+name)
            //call Cheat("DebugMsg: OK   "+name)
        else
            call Test_DebugMsg("|cffff0000" + "Failed  " + "|r" + name)
            call Cheat("DebugMsg: Failed  " + name)
        endif
    endfunction
    
    function Test___RunTests takes nothing returns nothing
    endfunction

