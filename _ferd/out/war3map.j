function sa__EVTeleportControl_onEffect takes nothing returns boolean

        local integer id
        local hashtable idTab
        local integer idKey
        local integer this
        local string pth
        if GetObjectName(GetSpellAbilityId()) != "[Teleport]" then
set f__result_boolean= false
return true
