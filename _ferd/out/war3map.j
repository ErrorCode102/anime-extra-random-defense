        function SVGAWAIN__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_일반("OnMeleeAttack")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVGAWAIN__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVGAWAIN__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVGAWAIN__OnEDCBAS takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            // Adding Melee Attack
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVGAWAIN__MeleeAttack)
            // Adding Special Skillz
            if lv == 4 then
                call sc__EV169GawainA_append(s__eventServantAdd_e , 15)
            endif
            if lv == 5 then
                call sc__EV169GawainA_append(s__eventServantAdd_e , 30)
                call sc__EV101GawainB_append(s__eventServantAdd_e , 300 , 5)
            endif
            if lv == 6 then
                call sc__EV169GawainA_append(s__eventServantAdd_e , 100)
                call sc__EV101GawainB_append(s__eventServantAdd_e , 1600 , 5)
            endif
        endfunction
        
        function SVGAWAIN__OnEX takes nothing returns nothing
            // Adding Melee Attack
            //call EVServantAttack.addFunction( eventServantAdd.e, function MeleeAttack )
            call sc__ABILEXGawainAttack_append(s__eventServantAdd_e)
            // Adding Special Skillz
            call sc__ABILEXGawainSunPower_append(s__eventServantAdd_e , 1.0)
            call sc__ABILEXGawainBestilac_append(s__eventServantAdd_e , 0.2)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0HQ')
            call sc__ABILEXGawainNightless_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("EDCBAS", "OnEDCBAS")
    function SVGAWAIN__EDCBAS takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVGAWAIN__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVGAWAIN__OnEDCBAS()
    endfunction
//end of: 서번트_획득_이벤트_선언("EDCBAS", "OnEDCBAS")
//textmacro instance: 서번트_획득_이벤트_선언("EX", "OnEX")
    function SVGAWAIN__EX takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVGAWAIN__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVGAWAIN__OnEX()
    endfunction
//end of: 서번트_획득_이벤트_선언("EX", "OnEX")
        
