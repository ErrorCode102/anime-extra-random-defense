function RRRegisterRequestEvent takes integer req,code c returns triggercondition
    if not HaveSavedHandle(RRSystem___RRTABLE, 0, req) then
        call SaveTriggerHandle(RRSystem___RRTABLE, 0, req, CreateTrigger())
    endif
    return TriggerAddCondition(LoadTriggerHandle(RRSystem___RRTABLE, 0, req), Condition(c))
endfunction
function RRRegisterAnyRequestEvent takes code c returns triggercondition
    return TriggerAddCondition(RRSystem___AREQ, Condition(c))
endfunction

function RRRequestEx takes integer req,player ap1,unit au1,item at1,integer ai1,player ap2,unit au2,item at2,integer ai2 returns nothing
    local integer p_req= RRSystem___REQ
    local player p_p1= RRSystem___req_p1
    local unit p_u1= RRSystem___req_u1
    local item p_t1= RRSystem___req_t1
    local integer p_i1= RRSystem___req_i1
    local player p_p2= RRSystem___req_p2
    local unit p_u2= RRSystem___req_u2
    local item p_t2= RRSystem___req_t2
    local integer p_i2= RRSystem___req_i2
    set RRSystem___REQ=req
    set RRSystem___req_p1=ap1
    set RRSystem___req_u1=au1
    set RRSystem___req_t1=at1
    set RRSystem___req_i1=ai1
    set RRSystem___req_p2=ap2
    set RRSystem___req_u2=au2
    set RRSystem___req_t2=at2
    set RRSystem___req_i2=ai2
    call TriggerEvaluate(RRSystem___AREQ)
    call TriggerEvaluate(LoadTriggerHandle(RRSystem___RRTABLE, 0, req))
    set RRSystem___REQ=p_req
    set RRSystem___req_p1=p_p1
    set RRSystem___req_u1=p_u1
    set RRSystem___req_t1=p_t1
    set RRSystem___req_i1=p_i1
    set RRSystem___req_p2=p_p2
    set RRSystem___req_u2=p_u2
    set RRSystem___req_t2=p_t2
    set RRSystem___req_i2=p_i2
    set p_p1=null
    set p_u1=null
    set p_t1=null
    set p_p2=null
    set p_u2=null
    set p_t2=null
endfunction
function RRRequestPlayer takes integer req,player ap1 returns nothing
    call RRRequestEx(req , ap1 , null , null , 0 , null , null , null , 0)
endfunction
function RRRequestPlayerId takes integer req,player ap1,integer ai1 returns nothing
    call RRRequestEx(req , ap1 , null , null , ai1 , null , null , null , 0)
endfunction
function RRRequest takes integer req returns nothing
    call RRRequestEx(req , null , null , null , 0 , null , null , null , 0)
endfunction

