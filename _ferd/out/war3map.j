//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("FRANKENSTEIN","FR")
// scope SVFRANKENSTEIN begins
//end of: 서번트_선언_개시("FRANKENSTEIN","FR")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVFRANKENSTEIN__EnumShock takes nothing returns nothing
            call FXRD_FXDebuffShock(GetEnumUnit() , 0.1)
            call sc__EVDebuffSlow_apply(GetEnumUnit() , 1.0)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\MeatwagonMissile\\MeatwagonMissile.mdl", GetEnumUnit(), "chest"))
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_WHOKNOWS , 1)
            if not IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
                call FXRD_FXShieldBreak(GetEnumUnit() , 5.0)
                call FXRD_FXPauseShield(GetEnumUnit() , 5.0)
                call FXRD_FXPauseLife(GetEnumUnit() , 5.0)
            endif
        endfunction
        
        function SVFRANKENSTEIN__FrankenWeapon takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
            call DestroyEffect(AddSpecialEffect("FX\\ElizabethAlter\\Wave.mdl", GetUnitX(target), GetUnitY(target)))
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(target), GetUnitY(target)))
            call s__splash_range(s__splash_ENEMY , source , GetUnitX(target) , GetUnitY(target) , 300.0 , function SVFRANKENSTEIN__EnumShock)
            set source=null
            set target=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "FrankenWeapon")
    function SVFRANKENSTEIN__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVFRANKENSTEIN__FrankenWeapon()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "FrankenWeapon")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVFRANKENSTEIN__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVFRANKENSTEIN__MeleeAttack)
            //Adding Special Skillz
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0F2')
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0F3')
            call sc__ABILFrankenCharge_append(s__eventServantAdd_e)
            call sc__ABILFrankenTree_append(s__eventServantAdd_e)
            //
            call sc__EVDamageManager_addBonus(s__eventServantAdd_e , 50)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVFRANKENSTEIN__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVFRANKENSTEIN__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVFRANKENSTEIN__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVFRANKENSTEIN__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("7","2300","Anylevel")
        set SVFRANKENSTEIN__SERVANT_DAMAGE[7]=2300
        call s__eventServantAdd_register(SVFRANKENSTEIN__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVFRANKENSTEIN__Anylevel)
//end of: 서번트_등록("7","2300","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVFRANKENSTEIN ends
//end of: 서번트_선언_끝()
//==================================================================
