//===========================================================================
// Trigger: CHEATER Debug
//===========================================================================
function Trig_CHEATER_Actions takes nothing returns nothing
    local integer id= GetPlayerId(GetTriggerPlayer())
    if GetEventPlayerChatString() == "-xp 50000" then
        call FXAddPlayerXp(GetTriggerPlayer() , 50000)
    endif
    if GetEventPlayerChatString() == "-xp 300000" then
        call FXAddPlayerXp(GetTriggerPlayer() , 300000)
    endif
    if GetEventPlayerChatString() == "-master" then
        call FXAddPlayerXp(GetTriggerPlayer() , 1200000)
    endif
    if GetEventPlayerChatString() == "-level 89" then
        call FXSetPlayerMasterLevel(GetTriggerPlayer() , 89)
        call FXSetPlayerMasterXp(GetTriggerPlayer() , 1000000)
    endif
    if GetEventPlayerChatString() == "-level 90" then
        call FXSetPlayerMasterLevel(GetTriggerPlayer() , 90)
        call FXSetPlayerMasterXp(GetTriggerPlayer() , 0)
    endif
    if GetEventPlayerChatString() == "-level 999" then
        call FXSetPlayerMasterLevel(GetTriggerPlayer() , 999)
        call FXSetPlayerMasterXp(GetTriggerPlayer() , 0)
    endif
    if GetEventPlayerChatString() == "-save" then
        call s__SaveData_encode(GetTriggerPlayer())
    endif
endfunction
//===========================================================================
function InitTrig_CHEATER_Debug takes nothing returns nothing
endfunction//===========================================================================
// Trigger: Trig Sv Auto Align
//===========================================================================
// scope TrigSvAutoAlign begins
    
    function TrigSvAutoAlign__RegisterCommandTrigger takes code c returns nothing
        local integer i= 0
        call TriggerAddAction(TrigSvAutoAlign__COMMAND, c)
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerChatEvent(TrigSvAutoAlign__COMMAND, Player(i), "-sort", true)
            call TriggerRegisterPlayerChatEvent(TrigSvAutoAlign__COMMAND, Player(i), "-ㅈ", true)
            call TriggerRegisterPlayerChatEvent(TrigSvAutoAlign__COMMAND, Player(i), "-wjdfuf", true)
            call TriggerRegisterPlayerChatEvent(TrigSvAutoAlign__COMMAND, Player(i), "-w", true)
            set i=i + 1
        endloop
    endfunction
    
    
    function TrigSvAutoAlign__onFilter takes nothing returns boolean
        local integer pos= 0
        local integer lev
        if IsUnitDead(GetFilterUnit()) then
            return false
        endif
        if not IsUnitType(GetFilterUnit(), UNIT_TYPE_TAUREN) then
            return false
        endif
        if IsUnitType(GetFilterUnit(), UNIT_TYPE_HERO) then
            return false
        endif
        set lev=GetUnitLevel(GetFilterUnit())
        if lev > 3 then
            return false
        endif
        set pos=LoadInteger(TrigSvAutoAlign__H, 0, GetUnitTypeId(GetFilterUnit()))
        if pos == 0 then
            if TrigSvAutoAlign__IND[lev] > 31 then
                return false
            endif
            set TrigSvAutoAlign__IND[lev]=TrigSvAutoAlign__IND[lev] + 1
            set pos=TrigSvAutoAlign__IND[lev]
            call SaveInteger(TrigSvAutoAlign__H, 0, GetUnitTypeId(GetFilterUnit()), pos)
        endif
        set pos=pos - 1
        call SetUnitPosition(GetFilterUnit(), TrigSvAutoAlign__X + 128 * ModuloInteger(pos, 13), TrigSvAutoAlign__Y - 128 * I2R(pos / 13 + ( lev - 1 )))
        call IssueImmediateOrder(GetFilterUnit(), "holdposition")
        return false
    endfunction
    
    function TrigSvAutoAlign__doAlign takes player p returns nothing
        local integer id= GetPlayerId(p)
        call FlushChildHashtable(TrigSvAutoAlign__H, 0)
        set TrigSvAutoAlign__IND[0]=0
        set TrigSvAutoAlign__IND[1]=0
        set TrigSvAutoAlign__IND[2]=0
        set TrigSvAutoAlign__IND[3]=0
        set TrigSvAutoAlign__X=GetPlayerStartLocationX(Player(id + 4)) - 768
        set TrigSvAutoAlign__Y=GetPlayerStartLocationY(Player(id + 4)) - 128
        call GroupEnumUnitsOfPlayer(TrigSvAutoAlign__G, p, Filter(function TrigSvAutoAlign__onFilter))
        call GroupClear(TrigSvAutoAlign__G)
        call DisplayTextToPlayer(p, 0.0, 0.0, "|c000080ffC-grade or below Servants have been sorted out.|r")
    endfunction
    
    function TrigSvAutoAlign__onAlign takes nothing returns nothing
        call TrigSvAutoAlign__doAlign(GetOwningPlayer(GetTriggerUnit()))
    endfunction
    
    function TrigSvAutoAlign__onChatAlign takes nothing returns nothing
        call TrigSvAutoAlign__doAlign(GetTriggerPlayer())
    endfunction
    
    function TrigSvAutoAlign__main takes nothing returns nothing
        call TrigSvAutoAlign__RegisterCommandTrigger(function TrigSvAutoAlign__onChatAlign)
        call s__AbilityEffectEvent_Create('A03O' , function TrigSvAutoAlign__onAlign)
    endfunction
// scope TrigSvAutoAlign ends
