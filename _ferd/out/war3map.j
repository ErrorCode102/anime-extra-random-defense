        call s__EV139AlexanderB_deallocate(this)
    endfunction
    
    //API
    function s__EV139AlexanderB_append takes unit src,real coold,real delay returns nothing
        local integer this= s__EV139AlexanderB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV139AlexanderB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV139AlexanderB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV139AlexanderB_onSourceUnitRemove)
        set s__EV139AlexanderB_myServant[this]=src
        set s__EV139AlexanderB_myBuffDelay[this]=delay
        set s__EV139AlexanderB_myCooldown[this]=coold
        set s__EV139AlexanderB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV139AlexanderB_coolTick[this],1.00 , true , function sc__EV139AlexanderB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV139AlexanderB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV139AlexanderB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV139AlexanderB_coolTick[this])
        set s__EV139AlexanderB_myServant[this]=null
        call TriggerUnbindAction(s__EV139AlexanderB_onRemoveAction[this])
        set s__EV139AlexanderB_onRemoveAction[this]=null
        //종결
        call s__EV139AlexanderB_destroy(this)
    endfunction
    
    
    function s__EV139AlexanderB_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__EV139AlexanderB_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A03X') > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__EV139AlexanderB_LEV then
            set s__EV139AlexanderB_LEV=GetUnitLevel(GetEnumUnit())
            set s__EV139AlexanderB_CNT=0
        endif
        if GetRandomInt(0, s__EV139AlexanderB_CNT) == 0 then
            set s__EV139AlexanderB_DEST=GetEnumUnit()
        endif
        set s__EV139AlexanderB_CNT=s__EV139AlexanderB_CNT + 1
    endfunction
    
    function s__EV139AlexanderB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local integer i= 0
        if IsUnitType(s__EV139AlexanderB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV139AlexanderB_coolTick[this])
            return
        endif
        call KillUnit(CreateUnit(Player(15), 'o00Y', GetUnitX(s__EV139AlexanderB_myServant[this]), GetUnitY(s__EV139AlexanderB_myServant[this]), 270))
        loop
            exitwhen i == 8
            set s__EV139AlexanderB_DEST=null
            set s__EV139AlexanderB_CNT=0
            set s__EV139AlexanderB_LEV=0
            call s__splash_range(s__splash_ALLY , s__EV139AlexanderB_myServant[this] , GetUnitX(s__EV139AlexanderB_myServant[this]) , GetUnitY(s__EV139AlexanderB_myServant[this]) , GetUnitAcquireRange(s__EV139AlexanderB_myServant[this]) * 2 , function s__EV139AlexanderB_enumGetTarget)
            if s__EV139AlexanderB_DEST != null then
                call s__CMHetairoi_cast(s__EV139AlexanderB_myServant[this] , s__EV139AlexanderB_DEST , s__EV139AlexanderB_myBuffDelay[this])
            endif
            set i=i + 1
        endloop
        call s__tick_start(s__EV139AlexanderB_coolTick[this],s__EV139AlexanderB_myCooldown[this] , true , function s__EV139AlexanderB_onCastSpell)
        set s__EV139AlexanderB_DEST=null
    endfunction
    
