//library CameraFixer:

    
    function CameraFixer___onExpire takes nothing returns nothing
        if CameraFixer___CS != null then
            call CameraSetupApplyForceDuration(CameraFixer___CS, true, 0.00)
        endif
    endfunction
    
    function FixCameraForPlayer takes player p,camerasetup cs returns nothing
        if GetLocalPlayer() == p then
            set CameraFixer___CS=cs
        endif
        if not CameraFixer___ACT then
            set CameraFixer___ACT=true
            call TimerStart(CameraFixer___T, 0.10, true, function CameraFixer___onExpire)
        endif
    endfunction
    

