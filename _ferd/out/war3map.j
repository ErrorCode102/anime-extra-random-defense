    function s__CMBreakerGorgonXS_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__CMBreakerGorgonXS_caster[this]) then
            call UnitRemoveAbility(s__CMBreakerGorgonXS_caster[this], 'A0GY')
        endif
        set s__CMBreakerGorgonXS_caster[this]=null
        call s__tick_destroy(s__CMBreakerGorgonXS_main[this])
    endfunction
    function s__CMBreakerGorgonXS_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        set s__CMBreakerGorgonXS_caster[this]=src
        call UnitAddAbility(s__CMBreakerGorgonXS_caster[this], 'A0GY')
        set s__CMBreakerGorgonXS_main[this]=this
        call s__tick_start(s__CMBreakerGorgonXS_main[this],5.0 , false , function s__CMBreakerGorgonXS_onFire)
    endfunction
    function s__CMCybeleXS_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RockBoltMissile\\RockBoltMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXDebuffShock(GetEnumUnit() , 5.0)
        call s__enemy_dealLogic(s__CMCybeleXS_caster[this] , GetEnumUnit() , s__CMCybeleXS_DMG , WEAPON_TYPE_METAL_MEDIUM_BASH , 1)
    endfunction
    function s__CMCybeleXS_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real tx
        local real ty
        local real ang= s__Angle_WBP(s__CMCybeleXS_caster[this] , s__CMCybeleXS_myX[this] , s__CMCybeleXS_myY[this])
        if not IsUnitDead(s__CMCybeleXS_target[this]) then
            set ang=s__Angle_WBW(s__CMCybeleXS_caster[this] , s__CMCybeleXS_target[this])
            set s__CMCybeleXS_myX[this]=GetUnitX(s__CMCybeleXS_caster[this]) + s__Polar_X(200.0 , ang)
            set s__CMCybeleXS_myY[this]=GetUnitY(s__CMCybeleXS_caster[this]) + s__Polar_Y(200.0 , ang)
        endif
        if not IsUnitDead(s__CMCybeleXS_caster[this]) then
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02K', GetUnitX(s__CMCybeleXS_caster[this]), GetUnitY(s__CMCybeleXS_caster[this]), ang))
            set s__CMCybeleXS_DMG=sc__EVDamageManager_getFinalDamage(s__CMCybeleXS_caster[this])
            call s__splash_range(s__splash_ENEMY , s__CMCybeleXS_caster[this] , s__CMCybeleXS_myX[this] , s__CMCybeleXS_myY[this] , 300.0 , function s__CMCybeleXS_enumDealt)
            set s__CMCybeleXS_DMG=0.0
        endif
        set s__CMCybeleXS_loops[this]=s__CMCybeleXS_loops[this] - 1
        if s__CMCybeleXS_loops[this] <= 0 then
            set s__CMCybeleXS_caster[this]=null
            set s__CMCybeleXS_target[this]=null
            call s__tick_destroy(s__CMCybeleXS_main[this])
        endif
    endfunction
    function s__CMCybeleXS_cast takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMCybeleXS_caster[this]=src
        set s__CMCybeleXS_target[this]=dst
        set s__CMCybeleXS_myX[this]=GetUnitX(src) + s__Polar_X(200.0 , ang)
        set s__CMCybeleXS_myY[this]=GetUnitY(src) + s__Polar_Y(200.0 , ang)
        set s__CMCybeleXS_loops[this]=5
        set s__CMCybeleXS_main[this]=this
        call s__tick_start(s__CMCybeleXS_main[this],0.2 , true , function s__CMCybeleXS_onFire)
    endfunction
// Trigger: Common Medusa
//===========================================================================
    function s__CMCybele_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RockBoltMissile\\RockBoltMissile.mdl", GetEnumUnit(), "chest"))
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 5.0)
        call FXRD_FXDebuffShock(GetEnumUnit() , 2.0)
    endfunction
    function s__CMCybele_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__splash_range(s__splash_ENEMY , s__CMCybele_caster[this] , s__CMCybele_myX[this] , s__CMCybele_myY[this] , 300 , function s__CMCybele_enumDealt)
        set s__CMCybele_caster[this]=null
        call s__tick_destroy(s__CMCybele_main[this])
    endfunction
    function s__CMCybele_cast takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        local real tx= GetUnitX(dst)
        local real ty= GetUnitY(dst)
        local real ang= s__Angle_WBP(src , tx , ty)
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o01J', GetUnitX(src), GetUnitY(src), ang))
        set s__CMCybele_caster[this]=src
        set s__CMCybele_myX[this]=GetUnitX(src) + s__Polar_X(200 , ang)
        set s__CMCybele_myY[this]=GetUnitY(src) + s__Polar_Y(200 , ang)
        set s__CMCybele_main[this]=this
        call s__tick_start(s__CMCybele_main[this],0.1 , false , function s__CMCybele_onFire)
    endfunction

    function s__CMCybelebuff_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__CMCybelebuff_target[this]) then
            call AddUnitAnimationProperties(s__CMCybelebuff_target[this], "defend", false)
            call UnitRemoveAbility(s__CMCybelebuff_target[this], 'A0BR')
            call UnitRemoveAbility(s__CMCybelebuff_target[this], 'B013')
        endif
        call DestroyEffect(s__CMCybelebuff_fx[this])
        set s__CMCybelebuff_fx[this]=null
        set s__CMCybelebuff_target[this]=null
        call s__tick_destroy(s__CMCybelebuff_mainFlow[this])
    endfunction
    function s__CMCybelebuff_onCast takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if GetUnitAbilityLevel(s__CMCybelebuff_target[this], 'A0BR') > 0 or IsUnitDead(s__CMCybelebuff_target[this]) then
            set s__CMCybelebuff_target[this]=null
            call s__tick_destroy(s__CMCybelebuff_mainFlow[this])
            return
        endif
        call AddUnitAnimationProperties(s__CMCybelebuff_target[this], "defend", true)
        set s__CMCybelebuff_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Other\\HowlOfTerror\\HowlTarget.mdl", s__CMCybelebuff_target[this], "overhead")
        call UnitAddAbility(s__CMCybelebuff_target[this], 'A0BR')
        call s__tick_start(s__CMCybelebuff_mainFlow[this],s__CMCybelebuff_delays[this] , false , function s__CMCybelebuff_onFinal)
    endfunction
    function s__CMCybelebuff_cast takes unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMCybelebuff_target[this]=dst
        set s__CMCybelebuff_delays[this]=delay
        set s__CMCybelebuff_mainFlow[this]=this
        call s__tick_start(s__CMCybelebuff_mainFlow[this],0.1 , false , function s__CMCybelebuff_onCast)
    endfunction

    function s__CMBelero_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_MANA) <= GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetEnumUnit(), "origin"))
        call SetUnitState(GetEnumUnit(), UNIT_STATE_MANA, GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) + s__CMBelero_mana[this])
    endfunction
    function s__CMBelero_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMBelero_target[this], UNIT_TYPE_DEAD) then
            call s__enemy_dealLogicEx(s__CMBelero_caster[this] , s__CMBelero_target[this] , s__CMBelero_damage[this] , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
            set s__CMBelero_myX[this]=GetUnitX(s__CMBelero_target[this])
            set s__CMBelero_myY[this]=GetUnitY(s__CMBelero_target[this])
        endif
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o01K', s__CMBelero_myX[this], s__CMBelero_myY[this], 270.0))
        call s__splash_range(s__splash_ALLY , s__CMBelero_caster[this] , s__CMBelero_myX[this] , s__CMBelero_myY[this] , 700 , function s__CMBelero_enumDealt)
        set s__CMBelero_caster[this]=null
        set s__CMBelero_target[this]=null
        call s__tick_destroy(s__CMBelero_main[this])
    endfunction
    function s__CMBelero_cast takes unit src,unit dst,real dmg,real mp returns nothing
        local integer this= s__tick_create(0)
        set s__CMBelero_caster[this]=src
        set s__CMBelero_target[this]=dst
        set s__CMBelero_damage[this]=dmg
        set s__CMBelero_mana[this]=mp
        set s__CMBelero_myX[this]=GetUnitX(dst)
        set s__CMBelero_myY[this]=GetUnitY(dst)
        set s__CMBelero_main[this]=this
        call s__tick_start(s__CMBelero_main[this],0.1 , false , function s__CMBelero_onFire)
    endfunction
// Trigger: Servant Jeanne
