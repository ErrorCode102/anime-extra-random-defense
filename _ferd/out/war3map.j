    function FXMapInitScope___MapInitFinalize takes nothing returns nothing
        if s__FXMapInit_Value != s__FXMapInit_MaxValue then
            return
        endif
        call PauseTimer(FXMapInitScope___INITIALIZE_CHECKER)
        call RRResponse(RESPONSE_MAP_INITIALIZED)
    endfunction
    function FXMapInitScope___MapInitSequence takes nothing returns nothing
        set s__FXMapInit_Value=0
        set s__FXMapInit_MaxValue=0
        call RRResponse(RESPONSE_MAP_INITIALIZING)
        call TimerStart(FXMapInitScope___INITIALIZE_CHECKER, FXMapInitScope___PERIOD_INIT_CHECK, true, function FXMapInitScope___MapInitFinalize)
    endfunction
