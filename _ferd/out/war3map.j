        set s__CMHeavenlyDemonRain_DEST=null
        set s__CMHeavenlyDemonRain_CNT=0
        call s__splash_range(s__splash_ENEMY , src , x , y , r , function s__CMHeavenlyDemonRain_enumGetTarget)
        return s__CMHeavenlyDemonRain_DEST
    endfunction
    //
    function s__CMHeavenlyDemonRain_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\GargoyleMissile\\GargoyleMissile.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__CMHeavenlyDemonRain_caster[this] , GetEnumUnit() , s__CMHeavenlyDemonRain_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
    endfunction
    function s__CMHeavenlyDemonRain_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local integer isfar= GetRandomInt(0, 1)
        local real dist
        local real angle
        local real tx
        local real ty
        if s__CMHeavenlyDemonRain_loops[this] < 1 or IsUnitDead(s__CMHeavenlyDemonRain_caster[this]) then
            call KillUnit(s__CMHeavenlyDemonRain_myDummy[this])
            set s__CMHeavenlyDemonRain_caster[this]=null
            set s__CMHeavenlyDemonRain_target[this]=null
            set s__CMHeavenlyDemonRain_myDummy[this]=null
            call s__tick_destroy(s__CMHeavenlyDemonRain_main[this])
            return
        endif
        if IsUnitDead(s__CMHeavenlyDemonRain_target[this]) then
            set s__CMHeavenlyDemonRain_target[this]=s__CMHeavenlyDemonRain_GetRandomEnemy(s__CMHeavenlyDemonRain_caster[this] , GetUnitX(s__CMHeavenlyDemonRain_caster[this]) , GetUnitY(s__CMHeavenlyDemonRain_caster[this]) , s__CMHeavenlyDemonRain_range[this])
            set s__CMHeavenlyDemonRain_DEST=null
        endif
        if s__CMHeavenlyDemonRain_target[this] != null then
            set tx=GetUnitX(s__CMHeavenlyDemonRain_target[this]) + GetRandomReal(- 64.00, 64.00)
            set ty=GetUnitY(s__CMHeavenlyDemonRain_target[this]) + GetRandomReal(- 64.00, 64.00)
            set dist=300 + 150 * isfar
            set angle=GetRandomReal(0.00, 360.00)
            call CreateDummyCorpse('o00A' , GetUnitX(s__CMHeavenlyDemonRain_caster[this]) + s__Polar_X(dist , angle) , GetUnitY(s__CMHeavenlyDemonRain_caster[this]) + s__Polar_Y(dist , angle) , 700 - 100 * isfar , 270 , 1.00 , 255 , 255 , 255 , 255)
            call sc__DummyLightning_cast("HWPB" , 1 , 1 , 1 , GetUnitX(s__CMHeavenlyDemonRain_caster[this]) + s__Polar_X(dist , angle) , GetUnitY(s__CMHeavenlyDemonRain_caster[this]) + s__Polar_Y(dist , angle) , 700 - 100 * isfar , tx , ty , 60 , 0.20)
            call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\WaterElementalMissile\\WaterElementalMissile.mdl", tx, ty))
            call s__splash_range(s__splash_ENEMY , s__CMHeavenlyDemonRain_caster[this] , tx , ty , 200 , function s__CMHeavenlyDemonRain_enumDealt)
        endif
        set s__CMHeavenlyDemonRain_loops[this]=s__CMHeavenlyDemonRain_loops[this] - 1
    endfunction
    function s__CMHeavenlyDemonRain_cast takes unit src,real rng,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMHeavenlyDemonRain_caster[this]=src
        set s__CMHeavenlyDemonRain_target[this]=null
        set s__CMHeavenlyDemonRain_myDummy[this]=CreateUnit(Player(15), 'o009', GetUnitX(src), GetUnitY(src), 270)
        call sc__DummyFollowUnit_cast(s__CMHeavenlyDemonRain_myDummy[this] , src)
        set s__CMHeavenlyDemonRain_damage[this]=dmg
        set s__CMHeavenlyDemonRain_range[this]=rng
        set s__CMHeavenlyDemonRain_loops[this]=20
        set s__CMHeavenlyDemonRain_main[this]=this
        call s__tick_start(s__CMHeavenlyDemonRain_main[this],0.25 , true , function s__CMHeavenlyDemonRain_onFireStart)
    endfunction
