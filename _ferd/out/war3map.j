//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("RhymeB")
//end of: 어빌리티_선언_개시("RhymeB")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILRhymeB_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILRhymeB_rmTrig[this], s__ABILRhymeB_rmAct[this])
        set s__ABILRhymeB_rmAct[this]=null
        set s__ABILRhymeB_rmTrig[this]=null
        call sc__ABILRhymeB_onAbilityLost(this)
        call s__tick_destroy(s__ABILRhymeB_durTik[this])
        set s__ABILRhymeB_source[this]=null
        set s__ABILRhymeB_exists[this]=false
    endfunction
    
    function s__ABILRhymeB_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILRhymeB_free(this)
    endfunction
    
    function s__ABILRhymeB_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILRhymeB_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILRhymeB_source[this]) then
            return
        endif
        call sc__ABILRhymeB_onAbilityEffect(this)
        call s__tick_start(s__ABILRhymeB_durTik[this],s__ABILRhymeB_duration[this] , false , function s__ABILRhymeB_onExpire)
    endfunction
    
    function s__ABILRhymeB_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILRhymeB_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILRhymeB_exists[this] then
            set s__ABILRhymeB_exists[this]=true
            set s__ABILRhymeB_source[this]=src
            set s__ABILRhymeB_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILRhymeB_rmAct[this]=TriggerAddAction(s__ABILRhymeB_rmTrig[this], function s__ABILRhymeB_OnSourceRemove)
            
            set s__ABILRhymeB_duration[this]=dur
            set s__ABILRhymeB_defaultDuration[this]=dur
            set s__ABILRhymeB_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILRhymeB_durTik[this],dur , false , function s__ABILRhymeB_onExpire)
            call sc__ABILRhymeB_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // 사용자 정의 멤버
    function s__ABILRhymeB_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__ABILRhymeB_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'BPSE') == 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__ABILRhymeB_LEV then
            set s__ABILRhymeB_LEV=GetUnitLevel(GetEnumUnit())
            set s__ABILRhymeB_CNT=0
        endif
        if GetRandomInt(0, s__ABILRhymeB_CNT) == 0 then
            set s__ABILRhymeB_DEST=GetEnumUnit()
        endif
        set s__ABILRhymeB_CNT=s__ABILRhymeB_CNT + 1
    endfunction
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILRhymeB_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILRhymeB_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILRhymeB_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local integer i= 0
        if IsUnitDead(s__ABILRhymeB_source[this]) then
            return
        endif
        set s__ABILRhymeB_DEST=null
        set s__ABILRhymeB_CNT=0
        set s__ABILRhymeB_LEV=0
        call s__splash_range(s__splash_PLAYER , s__ABILRhymeB_source[this] , GetUnitX(s__ABILRhymeB_source[this]) , GetUnitY(s__ABILRhymeB_source[this]) , GetUnitAcquireRange(s__ABILRhymeB_source[this]) * 2 , function s__ABILRhymeB_enumGetTarget)
        if s__ABILRhymeB_DEST == null then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", s__ABILRhymeB_DEST, "origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", s__ABILRhymeB_source[this], "origin"))
        call sc__EVDebuffStunServant_clear(s__ABILRhymeB_DEST)
        if GetUnitLevel(s__ABILRhymeB_source[this]) == 5 then
            call sc__BUFFQueensGarden_apply(s__ABILRhymeB_DEST , 5.0)
        else
            call sc__BUFFQueensGarden_apply(s__ABILRhymeB_DEST , 10.0)
        endif
        set s__ABILRhymeB_DEST=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("QueensGarden")
//end of: 버프_선언_개시("QueensGarden")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFQueensGarden_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFQueensGarden_exist[this] then
            set s__BUFFQueensGarden_exist[this]=true
            set s__BUFFQueensGarden_running[this]=false
            set s__BUFFQueensGarden_source[this]=src
            set s__BUFFQueensGarden_duration[this]=dur
            set s__BUFFQueensGarden_durationTimer[this]=s__tick_create(this)
            set s__BUFFQueensGarden_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFQueensGarden_rmAct[this]=TriggerAddAction(s__BUFFQueensGarden_rmTrig[this], function sc__BUFFQueensGarden_onSourceRemove)
        endif
        if s__BUFFQueensGarden_running[this] then
            if dur < s__tick__get_remaining(s__BUFFQueensGarden_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFQueensGarden_running[this]=true
            call sc__BUFFQueensGarden_onBuffStart(this)
        endif
        set s__BUFFQueensGarden_duration[this]=dur
        call sc__BUFFQueensGarden_onBuffRefresh(this)
        call s__tick_start(s__BUFFQueensGarden_durationTimer[this],s__BUFFQueensGarden_duration[this] , false , function sc__BUFFQueensGarden_onExpire)
    endfunction
    function s__BUFFQueensGarden_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFQueensGarden_running[this]=false
        call sc__BUFFQueensGarden_onBuffEnd(this)
    endfunction
    function s__BUFFQueensGarden_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFQueensGarden_rmTrig[this], s__BUFFQueensGarden_rmAct[this])
        set s__BUFFQueensGarden_rmAct[this]=null
        set s__BUFFQueensGarden_rmTrig[this]=null
        if s__BUFFQueensGarden_running[this] then
            set s__BUFFQueensGarden_running[this]=false
            call sc__BUFFQueensGarden_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFQueensGarden_durationTimer[this])
        set s__BUFFQueensGarden_source[this]=null
        set s__BUFFQueensGarden_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFQueensGarden_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFQueensGarden_fx[this]=AddSpecialEffectTarget(s__BUFFQueensGarden_PATH_EFFECT, s__BUFFQueensGarden_source[this], s__BUFFQueensGarden_POINT_EFFECT)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFQueensGarden_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
        // 기간제 기절/넉백 면역 효과 습득
        call FXRD_FXImmuneStunTimed(s__BUFFQueensGarden_source[this] , s__BUFFQueensGarden_duration[this])
        call FXRD_FXImmuneKnockbackTimed(s__BUFFQueensGarden_source[this] , s__BUFFQueensGarden_duration[this])
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFQueensGarden_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        call DestroyEffect(s__BUFFQueensGarden_fx[this])
        set s__BUFFQueensGarden_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
