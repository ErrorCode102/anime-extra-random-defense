        set s__EV138AlexanderA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV138AlexanderA_coolTick[this],0.30 , true , function sc__EV138AlexanderA_onCastSpell)
    endfunction
    
    //구현부
