// scope TrigFactionAnotherDoubleServant begins
    function TrigFactionAnotherDoubleServant__DoubleJohab takes unit src returns nothing
        local player p= GetOwningPlayer(src)
        local real x= GetUnitX(src)
        local real y= GetUnitY(src)
        local unit u= CreateUnit(p, GetUnitTypeId(src), x, y, 270.00)
        call s__bountyTag_custom(p , x , y , "|c00FFFF00『Another - Merging output is doubled』|r")
        call DisplayTextToPlayer(p, 0.00, 0.00, "Faction Talent |c00FFFF00『Another - Combination results are doubled』|r activated")
        call s__servant_add(p , u , s__servant_JOHAB)
        call DestroyEffect(AddSpecialEffect("FX\\johabTarget.mdl", GetUnitX(u), GetUnitY(u)))
        set p=null
        set u=null
    endfunction
    function TrigFactionAnotherDoubleServant__OnBeforeJohab takes nothing returns nothing
        if FXGetPlayerCurrentFaction(GetOwningPlayer(FXGetJohabUnit())) != FX_FACTION_ANOTHER then
            return
        endif
        if GetRandomReal(0.00, 100.00) > 5.00 then
            return
        endif
        call TrigFactionAnotherDoubleServant__DoubleJohab(FXGetJohabUnit())
    endfunction
    function TrigFactionAnotherDoubleServant__main takes nothing returns nothing
        call FXActionRegisterUnitBeforeJohabEvent(function TrigFactionAnotherDoubleServant__OnBeforeJohab)
    endfunction
