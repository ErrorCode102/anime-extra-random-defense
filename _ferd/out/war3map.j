    function SvTamamoDelmo__main takes nothing returns nothing
        set SvTamamoDelmo__ODMG[4]=220
        set SvTamamoDelmo__ODMG[5]=550
        set SvTamamoDelmo__ODMG[6]=1760
        call s__eventServantAdd_register(SV_TAMAMOCASUAL + OFF_B , function SvTamamoDelmo__onServantGet)
        call s__eventServantAdd_register(SV_TAMAMOCASUAL + OFF_A , function SvTamamoDelmo__onServantGet)
        call s__eventServantAdd_register(SV_TAMAMOCASUAL + OFF_S , function SvTamamoDelmo__onServantGet)
    endfunction
