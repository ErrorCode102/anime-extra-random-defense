        return this
    endfunction
    
    function s__EVBossSkillBlackhole_destroy takes integer this returns nothing
        call s__EVBossSkillBlackhole_setThis(s__EVBossSkillBlackhole_ID[this] , 0)
        call s__EVBossSkillBlackhole_deallocate(this)
    endfunction
    
    //API
    function s__EVBossSkillBlackhole_append takes unit src,rect r returns nothing
        local integer this= s__EVBossSkillBlackhole_create(src)
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVBossSkillBlackhole application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVBossSkillBlackhole_ONRM[this]=s__EVUnitRemove_bind(src , function sc__EVBossSkillBlackhole_onSourceUnitRemove)
        set s__EVBossSkillBlackhole_listenerDeath[this]=CreateTrigger()
        set s__EVBossSkillBlackhole_listenerDeathAction[this]=TriggerAddAction(s__EVBossSkillBlackhole_listenerDeath[this], function sc__EVBossSkillBlackhole_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVBossSkillBlackhole_listenerDeath[this], src, EVENT_UNIT_DEATH)
        set s__EVBossSkillBlackhole_mySource[this]=src
        
        set s__EVBossSkillBlackhole_myBlackhole[this]=FXRD_FXBlackholeCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
        set s__EVBossSkillBlackhole_myBlackhole2[this]=FXRD_FXBlackholeCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
    endfunction
    
    //구현부
    function s__EVBossSkillBlackhole_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVBossSkillBlackhole_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EVBossSkillBlackhole_myBlackhole[this] != 0 then
            call FXRD_FXBlackholeDestroy(s__EVBossSkillBlackhole_myBlackhole[this])
        endif
        if s__EVBossSkillBlackhole_myBlackhole2[this] != 0 then
            call FXRD_FXBlackholeDestroy(s__EVBossSkillBlackhole_myBlackhole2[this])
        endif
        set s__EVBossSkillBlackhole_mySource[this]=null
        call TriggerUnbindAction(s__EVBossSkillBlackhole_ONRM[this])
        set s__EVBossSkillBlackhole_ONRM[this]=null
        call TriggerRemoveAction(s__EVBossSkillBlackhole_listenerDeath[this], s__EVBossSkillBlackhole_listenerDeathAction[this])
        set s__EVBossSkillBlackhole_listenerDeathAction[this]=null
        call DestroyTrigger(s__EVBossSkillBlackhole_listenerDeath[this])
        set s__EVBossSkillBlackhole_listenerDeath[this]=null
        //종결
        call s__EVBossSkillBlackhole_destroy(this)
    endfunction
    
    function s__EVBossSkillBlackhole_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVBossSkillBlackhole_getThis(GetUnitUserData(GetTriggerUnit()))
        if s__EVBossSkillBlackhole_myBlackhole[this] != 0 then
            call FXRD_FXBlackholeDestroy(s__EVBossSkillBlackhole_myBlackhole[this])
        endif
        set s__EVBossSkillBlackhole_myBlackhole[this]=0
        if s__EVBossSkillBlackhole_myBlackhole2[this] != 0 then
            call FXRD_FXBlackholeDestroy(s__EVBossSkillBlackhole_myBlackhole2[this])
        endif
        set s__EVBossSkillBlackhole_myBlackhole2[this]=0
    endfunction
    
