function sa__EVUnitRemove_onCallback takes nothing returns boolean

        if s__EVUnitRemove_TC >= s__EVUnitRemove_ARMX then
            set s__EVUnitRemove_TC=0
            if s__EVUnitRemove_ARMX == 0 then
                set s__EVUnitRemove_TB=true
                call PauseTimer(s__EVUnitRemove_T)
return true
            endif
        endif
        if GetUnitTypeId(s__EVUnitRemove_ARU[s__EVUnitRemove_TC]) != 0 then
            set s__EVUnitRemove_TC=s__EVUnitRemove_TC + 1
return true
        endif
        call s__EVUnitRemove_onFire(s__EVUnitRemove_ARID[s__EVUnitRemove_TC])
        set s__EVUnitRemove_ARMX=s__EVUnitRemove_ARMX - 1
        set s__EVUnitRemove_ARU[s__EVUnitRemove_TC]=s__EVUnitRemove_ARU[s__EVUnitRemove_ARMX]
        set s__EVUnitRemove_ARID[s__EVUnitRemove_TC]=s__EVUnitRemove_ARID[s__EVUnitRemove_ARMX]
        set s__EVUnitRemove_ARU[s__EVUnitRemove_ARMX]=null
        set s__EVUnitRemove_ARID[s__EVUnitRemove_ARMX]=0
   return true
endfunction
