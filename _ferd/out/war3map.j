        call s__BossSkillKnockback_setThis(s__BossSkillKnockback_ID[this] , 0)
        call s__BossSkillKnockback_deallocate(this)
    endfunction
    
    //API
    
    function s__BossSkillKnockback_append takes unit src,real delay,real chrg returns nothing
        local integer this= s__BossSkillKnockback_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "BossSkillKnockback application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__BossSkillKnockback_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__BossSkillKnockback_onSourceUnitRemove)
        set s__BossSkillKnockback_myServant[this]=src
        set s__BossSkillKnockback_myCooldown[this]=delay
        set s__BossSkillKnockback_myCharge[this]=chrg
        set s__BossSkillKnockback_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__BossSkillKnockback_coolTick[this],delay , false , function sc__BossSkillKnockback_onCastSpell)
    endfunction
    
    //구현부
    function s__BossSkillKnockback_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__BossSkillKnockback_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__BossSkillKnockback_coolTick[this])
        set s__BossSkillKnockback_myServant[this]=null
        call TriggerUnbindAction(s__BossSkillKnockback_onRemoveAction[this])
        set s__BossSkillKnockback_onRemoveAction[this]=null
        //종결
        call s__BossSkillKnockback_destroy(this)
    endfunction
    function s__BossSkillKnockback_onCharge takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__BossSkillKnockback_myServant[this]) then
            call s__tick_pause(s__BossSkillKnockback_coolTick[this])
            return
        endif
        call s__tick_start(s__BossSkillKnockback_coolTick[this],s__BossSkillKnockback_myCooldown[this] , false , function sc__BossSkillKnockback_onCastSpell)
    endfunction
    function s__BossSkillKnockback_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local unit u
        if IsUnitDead(s__BossSkillKnockback_myServant[this]) then
            call s__tick_pause(s__BossSkillKnockback_coolTick[this])
            return
        endif
        call FXRD_FXChargeSource(s__BossSkillKnockback_myServant[this] , 0.04 , 1.00)
        call FXRD_FXChargeSource(s__BossSkillKnockback_myServant[this] , 1.00 , 1.00)
        call FXRD_FXChargeSource(s__BossSkillKnockback_myServant[this] , 2.00 , 1.00)
        call FXRD_FXChargeSource(s__BossSkillKnockback_myServant[this] , 3.00 , 1.00)
        call FXRD_FXChargeSource(s__BossSkillKnockback_myServant[this] , 4.00 , 1.00)
        call s__tick_start(s__BossSkillKnockback_coolTick[this],s__BossSkillKnockback_myCharge[this] , false , function s__BossSkillKnockback_onCharge)
    endfunction
    

