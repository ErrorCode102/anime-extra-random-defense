    //API
    function s__EV122JeanneAlterB_append takes unit src,real dmg,real coold returns nothing
        local integer this= s__EV122JeanneAlterB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV122JeanneAlterB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV122JeanneAlterB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV122JeanneAlterB_onSourceUnitRemove)
        set s__EV122JeanneAlterB_myServant[this]=src
        set s__EV122JeanneAlterB_myCooldown[this]=coold
        set s__EV122JeanneAlterB_myDamage[this]=dmg
        set s__EV122JeanneAlterB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV122JeanneAlterB_coolTick[this],0.30 , true , function sc__EV122JeanneAlterB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV122JeanneAlterB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV122JeanneAlterB_getThis(s__EVUnitRemove_e)
