//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("MeltASadist")
//end of: 어빌리티_선언_개시("MeltASadist")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILMeltASadist_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMeltASadist_rmTrig[this], s__ABILMeltASadist_rmAct[this])
        set s__ABILMeltASadist_rmAct[this]=null
        set s__ABILMeltASadist_rmTrig[this]=null
        call sc__ABILMeltASadist_onAbilityLost(this)
        call s__tick_destroy(s__ABILMeltASadist_durTik[this])
        set s__ABILMeltASadist_source[this]=null
        set s__ABILMeltASadist_exists[this]=false
    endfunction
    
    function s__ABILMeltASadist_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMeltASadist_free(this)
    endfunction
    
    function s__ABILMeltASadist_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILMeltASadist_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILMeltASadist_source[this]) then
            return
        endif
        call sc__ABILMeltASadist_onAbilityEffect(this)
        call s__tick_start(s__ABILMeltASadist_durTik[this],s__ABILMeltASadist_duration[this] , false , function s__ABILMeltASadist_onExpire)
    endfunction
    
    function s__ABILMeltASadist_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMeltASadist_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMeltASadist_exists[this] then
            set s__ABILMeltASadist_exists[this]=true
            set s__ABILMeltASadist_source[this]=src
            set s__ABILMeltASadist_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMeltASadist_rmAct[this]=TriggerAddAction(s__ABILMeltASadist_rmTrig[this], function s__ABILMeltASadist_OnSourceRemove)
            
            set s__ABILMeltASadist_duration[this]=dur
            set s__ABILMeltASadist_defaultDuration[this]=dur
            set s__ABILMeltASadist_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILMeltASadist_durTik[this],dur , false , function s__ABILMeltASadist_onExpire)
            call sc__ABILMeltASadist_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILMeltASadist_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMeltASadist_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMeltASadist_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitState(s__ABILMeltASadist_source[this], UNIT_STATE_MANA) < 150 then
            return
        endif
        if GetUnitAbilityLevel(s__ABILMeltASadist_source[this], s__BUFFSadist_ABILITY) > 0 then
            return
        endif
        call sc__BUFFSadist_apply(s__ABILMeltASadist_source[this] , 10.00)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("Sadist")
//end of: 버프_선언_개시("Sadist")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFSadist_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFSadist_exist[this] then
            set s__BUFFSadist_exist[this]=true
            set s__BUFFSadist_running[this]=false
            set s__BUFFSadist_source[this]=src
            set s__BUFFSadist_duration[this]=dur
            set s__BUFFSadist_durationTimer[this]=s__tick_create(this)
            set s__BUFFSadist_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFSadist_rmAct[this]=TriggerAddAction(s__BUFFSadist_rmTrig[this], function sc__BUFFSadist_onSourceRemove)
        endif
        if s__BUFFSadist_running[this] then
            if dur < s__tick__get_remaining(s__BUFFSadist_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFSadist_running[this]=true
            call sc__BUFFSadist_onBuffStart(this)
        endif
        set s__BUFFSadist_duration[this]=dur
        call sc__BUFFSadist_onBuffRefresh(this)
        call s__tick_start(s__BUFFSadist_durationTimer[this],s__BUFFSadist_duration[this] , false , function sc__BUFFSadist_onExpire)
    endfunction
    function s__BUFFSadist_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFSadist_running[this]=false
        call sc__BUFFSadist_onBuffEnd(this)
    endfunction
    function s__BUFFSadist_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFSadist_rmTrig[this], s__BUFFSadist_rmAct[this])
        set s__BUFFSadist_rmAct[this]=null
        set s__BUFFSadist_rmTrig[this]=null
        if s__BUFFSadist_running[this] then
            set s__BUFFSadist_running[this]=false
            call sc__BUFFSadist_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFSadist_durationTimer[this])
        set s__BUFFSadist_source[this]=null
        set s__BUFFSadist_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFSadist_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFSadist_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl", s__BUFFSadist_source[this], "overhead")
        call UnitAddAbility(s__BUFFSadist_source[this], s__BUFFSadist_ABILITY)
        call sc__EVDamageManager_addBonus(s__BUFFSadist_source[this] , s__BUFFSadist_ATBO)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFSadist_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFSadist_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFSadist_source[this]) then
            call sc__EVDamageManager_addBonus(s__BUFFSadist_source[this] , - s__BUFFSadist_ATBO)
            call SetUnitState(s__BUFFSadist_source[this], UNIT_STATE_MANA, 0.00)
            call UnitRemoveAbility(s__BUFFSadist_source[this], s__BUFFSadist_ABILITY)
            call UnitRemoveAbility(s__BUFFSadist_source[this], s__BUFFSadist_BUFF)
        endif
        call DestroyEffect(s__BUFFSadist_fx[this])
        set s__BUFFSadist_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 어빌리티_선언_개시("MeltCMeltout")
//end of: 어빌리티_선언_개시("MeltCMeltout")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DY")
    
    function s__ABILMeltCMeltout_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMeltCMeltout_onSpellEffect[this], s__ABILMeltCMeltout_onSpellEffectAction[this])
        set s__ABILMeltCMeltout_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILMeltCMeltout_onSpellEffect[this])
        set s__ABILMeltCMeltout_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILMeltCMeltout_rmTrig[this], s__ABILMeltCMeltout_rmAct[this])
        set s__ABILMeltCMeltout_rmAct[this]=null
        set s__ABILMeltCMeltout_rmTrig[this]=null
        call sc__ABILMeltCMeltout_onAbilityLost(this)
        set s__ABILMeltCMeltout_source[this]=null
        set s__ABILMeltCMeltout_exists[this]=false
    endfunction
    
    function s__ABILMeltCMeltout_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMeltCMeltout_free(this)
    endfunction
    
    function s__ABILMeltCMeltout_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMeltCMeltout_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMeltCMeltout_exists[this] then
            set s__ABILMeltCMeltout_exists[this]=true
            set s__ABILMeltCMeltout_source[this]=src
            set s__ABILMeltCMeltout_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMeltCMeltout_rmAct[this]=TriggerAddAction(s__ABILMeltCMeltout_rmTrig[this], function s__ABILMeltCMeltout_OnSourceRemove)
            set s__ABILMeltCMeltout_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILMeltCMeltout_onSpellEffect[this], Condition(function sc__ABILMeltCMeltout_conditionSpellEffect))
            set s__ABILMeltCMeltout_onSpellEffectAction[this]=TriggerAddAction(s__ABILMeltCMeltout_onSpellEffect[this], function sc__ABILMeltCMeltout_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILMeltCMeltout_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILMeltCMeltout_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILMeltCMeltout_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILMeltCMeltout_exists[this] then
            return
        endif
        call sc__ABILMeltCMeltout_onAbilityEffect(this)
    endfunction
    
    function s__ABILMeltCMeltout_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILMeltCMeltout_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DY")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
