        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV114AtalantaAlterA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV114AtalantaAlterA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV114AtalantaAlterA__allocate()
        set s__EV114AtalantaAlterA_ID[this]=GetUnitUserData(src)
        call s__EV114AtalantaAlterA_setThis(s__EV114AtalantaAlterA_ID[this] , this)
        return this
    endfunction
    
    function s__EV114AtalantaAlterA_destroy takes integer this returns nothing
        call s__EV114AtalantaAlterA_setThis(s__EV114AtalantaAlterA_ID[this] , 0)
        call s__EV114AtalantaAlterA_deallocate(this)
    endfunction
    
    //API
    
    function s__EV114AtalantaAlterA_append takes unit src,boolean dopen,boolean dokick returns nothing
        local integer this= s__EV114AtalantaAlterA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV114AtalantaAlterA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV114AtalantaAlterA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV114AtalantaAlterA_onSourceUnitRemove)
        set s__EV114AtalantaAlterA_myServant[this]=src
        set s__EV114AtalantaAlterA_myLastTarget[this]=null
        set s__EV114AtalantaAlterA_myPen[this]=dopen
        set s__EV114AtalantaAlterA_myKick[this]=dokick
        set s__EV114AtalantaAlterA_myCombo[this]=0
        
        set s__EV114AtalantaAlterA_myCoolTick[this]=s__tick_create(this)
        call s__EVServantAttack_addFunction(src , function sc__EV114AtalantaAlterA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV114AtalantaAlterA_onCooldOver takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV114AtalantaAlterA_myServant[this], UNIT_TYPE_DEAD) then
            set s__EV114AtalantaAlterA_myLastTarget[this]=null
            call s__tick_pause(s__EV114AtalantaAlterA_myCoolTick[this])
            return
        endif
        if IsUnitType(s__EV114AtalantaAlterA_myLastTarget[this], UNIT_TYPE_DEAD) then
            set s__EV114AtalantaAlterA_myLastTarget[this]=null
            call s__tick_pause(s__EV114AtalantaAlterA_myCoolTick[this])
            return
        endif
        set s__EV114AtalantaAlterA_myCombo[this]=s__EV114AtalantaAlterA_myCombo[this] + 1
        call s__CMAgriosSingle_cast(s__EV114AtalantaAlterA_myServant[this] , s__EV114AtalantaAlterA_myLastTarget[this] , s__EVDamageManager_getFinalDamage(s__EV114AtalantaAlterA_myServant[this]) , s__EV114AtalantaAlterA_ox[this] , s__EV114AtalantaAlterA_oy[this] , s__EV114AtalantaAlterA_myPen[this] , s__EV114AtalantaAlterA_myKick[this] , s__EV114AtalantaAlterA_myCombo[this])
        if s__EV114AtalantaAlterA_myCombo[this] == 100 then
            set s__EV114AtalantaAlterA_myCombo[this]=0
        endif
        set s__EV114AtalantaAlterA_ox[this]=GetUnitX(s__EV114AtalantaAlterA_myLastTarget[this])
        set s__EV114AtalantaAlterA_oy[this]=GetUnitY(s__EV114AtalantaAlterA_myLastTarget[this])
    endfunction
    function s__EV114AtalantaAlterA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV114AtalantaAlterA_getThis(GetUnitUserData(src))
        if s__EV114AtalantaAlterA_myLastTarget[this] == null then
            call s__tick_start(s__EV114AtalantaAlterA_myCoolTick[this],0.20 , true , function s__EV114AtalantaAlterA_onCooldOver)
        endif
        set s__EV114AtalantaAlterA_myLastTarget[this]=dst
        set s__EV114AtalantaAlterA_ox[this]=GetUnitX(dst)
        set s__EV114AtalantaAlterA_oy[this]=GetUnitY(dst)
        set src=null
        set dst=null
    endfunction
    
    function s__EV114AtalantaAlterA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV114AtalantaAlterA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV114AtalantaAlterA_myCoolTick[this])
        set s__EV114AtalantaAlterA_myLastTarget[this]=null
        set s__EV114AtalantaAlterA_myServant[this]=null
        call TriggerUnbindAction(s__EV114AtalantaAlterA_onRemoveAction[this])
        set s__EV114AtalantaAlterA_onRemoveAction[this]=null
        //종결
        call s__EV114AtalantaAlterA_destroy(this)
    endfunction
    
    

