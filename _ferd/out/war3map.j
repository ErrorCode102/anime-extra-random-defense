        call SuspendHeroXP(u, true)
        set u=null
    endfunction
    //=================================================
    function TrigFactionAnotherBatchBuilding__OnSkillBuilding takes nothing returns nothing
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) == FX_FACTION_ANOTHER then
            call TrigFactionAnotherBatchBuilding__CreateSkillBuilding(s__eventCustom_getTriggerPlayer())
            //어나더 타워 추가건설
            call TrigFactionAnotherBatchBuilding__CreateAnotherTower(s__eventCustom_getTriggerPlayer())
        endif
