        //call StartSound(gg_snd_servant_spawn_rare)
        call s__tick_start(s__CMSwipe_main[this],0.10 , false , function s__CMSwipe_onPreFire)
    endfunction
// Trigger: Sv B Altera
//===========================================================================
// scope SvAltera begins
    //기본 서번트 스탯 설정
    //구현부
    function SvAltera__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvAltera__enumDealt takes nothing returns nothing
        call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
    endfunction
    function SvAltera__onAttackSplash takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
            //Melee Attack
        call s__splash_range(s__splash_ENEMY , src , GetUnitX(dst) , GetUnitY(dst) , 400 , function SvAltera__enumDealt)
        set src=null
        set dst=null
    endfunction
    function SvAltera__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvAltera__ODMG[lv])
        //Adding Special Skillz
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAltera__onAttack)
            call sc__EV116AlteraA_append(s__eventServantAdd_e , 5 , 1.4)
            call s__FXAltera_cast(s__eventServantAdd_e)
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAltera__onAttack)
            call sc__EV116AlteraA_append(s__eventServantAdd_e , 5 , 1.5)
            call sc__EV117AlteraB_append(s__eventServantAdd_e , 3 , 1.5)
            call s__FXAltera_cast(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAltera__onAttack)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A02T')
            call sc__EV116AlteraA_append(s__eventServantAdd_e , 5 , 1.6)
            call sc__EV117AlteraB_append(s__eventServantAdd_e , 3 , 1.6)
            call sc__EV118AlteraC_append(s__eventServantAdd_e , 1.6)
            call s__FXAltera_cast(s__eventServantAdd_e)
        endif
        if lv == 7 then
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAltera__onAttackSplash)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A02T')
            call UnitRemoveAbility(s__eventServantAdd_e, 'A051')
            call sc__EV116AlteraA_append(s__eventServantAdd_e , 5 , 3)
            call sc__EV117AlteraB_append(s__eventServantAdd_e , 3 , 3)
            call sc__EV118AlteraC_append(s__eventServantAdd_e , 3)
            call sc__EV119AlteraD_append(s__eventServantAdd_e , 3)
            call s__FXAltera_cast(s__eventServantAdd_e)
            
            call SetUnitScale(s__eventServantAdd_e, 3.0, 3.0, 3.0)
        endif
    endfunction
    //초기화
    function SvAltera__main takes nothing returns nothing
        set SvAltera__ODMG[4]=100
        set SvAltera__ODMG[5]=250
        set SvAltera__ODMG[6]=800
        set SvAltera__ODMG[7]=2300
        call s__eventServantAdd_register(SV_ALTERA + OFF_B , function SvAltera__onServantGet)
        call s__eventServantAdd_register(SV_ALTERA + OFF_A , function SvAltera__onServantGet)
        call s__eventServantAdd_register(SV_ALTERA + OFF_S , function SvAltera__onServantGet)
        call s__eventServantAdd_register(SV_ALTERA + OFF_EX , function SvAltera__onServantGet)
    endfunction
// scope SvAltera ends
