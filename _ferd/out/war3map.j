        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_1 , function TrigFactionAlteraBatchBuilding__OnUpgradeBuilding)
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_2 , function TrigFactionAlteraBatchBuilding__OnGachaBuilding)
