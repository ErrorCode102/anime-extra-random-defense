    function TogglePanalty takes integer p returns nothing
        set PANALTY[p]=not PANALTY[p]
        if PANALTY[p] then
            set PANALTY_COUNT=PANALTY_COUNT + 1
        else
            set PANALTY_COUNT=PANALTY_COUNT - 1
        endif
    endfunction
    function GetPanalty takes integer p returns boolean
        return PANALTY[p]
    endfunction
    function CountPanalty takes nothing returns integer
        local integer i= 1
        local integer sum= 0
        loop
            if PANALTY[i] then
                set sum=sum + 1
            endif
            exitwhen i == PANALTY_MAX
            set i=i + 1
        endloop
        return sum
    endfunction
    function ClearPanalty takes nothing returns nothing
        local integer i= 1
        set PANALTY_COUNT=0
        loop
            set PANALTY[i]=false
            exitwhen i == PANALTY_MAX
            set i=i + 1
        endloop
    endfunction
    
    function ClearData takes player p returns nothing
        local integer id= GetPlayerId(p)
        local integer i= 1
        //미명 영역 세션 초기화
        set DATA_SESSION[id]=MAP_SESSION
        //플레이타임 초기화
        set DATA_PLAYTIME[id]=0
        //마스터 레벨 0 -> 잠금 상태
        call FXSetPlayerMasterLevel(p , 0)
        call FXSetPlayerMasterXp(p , 0)
        //각 세력 레벨 -> 1로 초기화
        loop
            exitwhen i > FX_FACTION_MAX
            call FXSetPlayerFactionLevel(p , i , 1)
            call FXSetPlayerFactionXp(p , i , 0)
            set i=i + 1
        endloop
    endfunction
    
    function FXSetPlayerPT takes player p,integer i returns nothing
        set DATA_PLAYTIME[GetPlayerId(p)]=i
    endfunction
    
    function ClearUser takes player p returns nothing
        local integer id= GetPlayerId(p)
        set USER_NAME[id]=GetPlayerName(p)
        set USER_IS_PLAYING[id]=IsPlayingUser(p)
        set USER_IS_MASTER[id]=false
        set USER_IS_FIRSTPLAY[id]=true
        set USER_XP_BONUS[id]=0
        // First Play Faction = Random Between Nero(1) ~ Altera(3). Excepted Another~(4~)
        call FXSetPlayerCurrentFaction(p , GetRandomInt(1, 3))
        // 개인 설정
        set USER_USE_WARNPING[id]=true
    endfunction

