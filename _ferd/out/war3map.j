        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVSAKURA__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVSAKURA__OnKingProtea()
    endfunction
//end of: 서번트_획득_이벤트_선언("KingProtea", "OnKingProtea")
        
