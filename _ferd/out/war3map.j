//library Ascii ends
//library AutoLoaderAPI:
    // 오토로더를 작동시킬 준비합니다
    function AutoLoaderReady takes player p returns nothing
        if GetLocalPlayer() == p then
            call PreloadGenClear()
            call PreloadGenStart()
        endif
    endfunction
    // 오토로더가 어떤 세이브파일을 읽어들일지 설정합니다
    // 두 개 이상의 세이브파일을 설정할 수 있으며, 이 경우 나중에 설정된 파일이 최우선으로 불러와집니다
    function AutoLoaderSet takes player p,string s returns nothing
        if GetLocalPlayer() == p then
            call Preload(s)
        endif
    endfunction
    // 준비와 설정이 끝난 오토로더를 실행시킵니다. 두근두근
    function AutoLoaderRun takes player p returns nothing
        if GetLocalPlayer() == p then
            call PreloadGenEnd("AutoLoaderRun.txt")
        endif
    endfunction
    // 준비 -> 설정 -> 실행 단계를 한번에 실행시켜주는 간편 기능입니다
    // 단점 : 하나의 세이브파일만 설정할 수 있습니다
    function AutoLoaderRunSimple takes player p,string s returns nothing
        if GetLocalPlayer() == p then
            call PreloadGenClear()
            call PreloadGenStart()
            call Preload(s)
            call PreloadGenEnd("AutoLoaderRun.txt")
        endif
    endfunction
    // 오토로더가 인식할 수 있는 세이브코드를 Preload에 입력합니다
    function PreloadSaveCode takes string context returns nothing
        call Preload("SAVECODE")
        call Preload(context)
    endfunction
    // 오토로더가 인식할 수 있는 세이브파일을 만듭니다. 간편 기능이기 때문에 단점이 존재합니다
    // 단점 :
    //    1. 세이브파일에 대한 설명글을 입력할 수 없습니다
    //    2. 다중 세이브코드를 사용할 수 없습니다
    function AutoLoaderCreateSaveFile takes player p,string s,string context returns nothing
        if GetLocalPlayer() == p then
            call PreloadGenClear()
            call PreloadGenStart()
            call Preload("SAVECODE")
            call Preload(context)
            call PreloadGenEnd(s)
        endif
    endfunction

//library AutoLoaderAPI ends
//library BalanceJ:
    function R2Rhp takes integer r returns integer
        local integer res
        set res=R2I(BalanceJ__RHP[r])
        
        if ModuloInteger(r, 10) == 0 then
            return res / 10
        endif
        return res
    endfunction
    function R2Rmp takes integer r returns integer
        local integer res
        set res=R2I(BalanceJ__RSH[r])
        
        if ModuloInteger(r, 10) == 0 then
            return 0
        endif
        return res
    endfunction
