    function FXTrigTryGoldGacha___HPGacha takes nothing returns nothing
        local player p= s__Owner__staticgetindex(GetSellingUnit())
        local integer id= s__PlayerId__staticgetindex(p)
        local real perc= GetRandomReal(0.0, 100.0)
        local integer result= IntegerTertiaryOp(perc < 25.0, 0, GetRandomInt(1, 3))
        call DisplayTimedTextToPlayer(p, 0.0, 0.0, 10.0, "|c000080FF" + I2S(result) + " H-Spirit Pts obtained|r")
