//==================================================================
//　서번트 타임라인
//==================================================================
    function s__TLBBSSAllKill_EnumSplash takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_UNDEAD) then
            return
        endif
        call DestroyEffect(AddSpecialEffect("FX\\Atalanta\\Ray.mdl", GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit())))
        call s__enemy_dealLogic(s__TLBBSSAllKill_caster[this] , GetEnumUnit() , s__TLBBSSAllKill_myDmg[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__TLBBSSAllKill_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__TLBBSSAllKill_caster[this]) then
            set s__TLBBSSAllKill_myDmg[this]=GetHeroInt(s__TLBBSSAllKill_caster[this], true) * 1000.0
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01Z', GetUnitX(s__TLBBSSAllKill_myDummy[this]), GetUnitY(s__TLBBSSAllKill_myDummy[this]), 270.00))
            call sc__TLBBSSAllKillRayFx_apply(GetUnitX(s__TLBBSSAllKill_myDummy[this]) , GetUnitY(s__TLBBSSAllKill_myDummy[this]))
            call SetSoundPosition(gg_snd_HowlOfTerror, GetUnitX(s__TLBBSSAllKill_myDummy[this]), GetUnitY(s__TLBBSSAllKill_myDummy[this]), 300.0)
            call StartSound(gg_snd_HowlOfTerror)
            call s__splash_rect(s__splash_ENEMY , s__TLBBSSAllKill_caster[this] , GetWorldBounds() , function s__TLBBSSAllKill_EnumSplash)
        endif
        set s__TLBBSSAllKill_myDummy[this]=null
        set s__TLBBSSAllKill_caster[this]=null
        call s__tick_destroy(s__TLBBSSAllKill_main[this])
    endfunction
    function s__TLBBSSAllKill_apply takes unit src returns nothing
        local integer this= s__tick_create(0)
        set s__TLBBSSAllKill_caster[this]=src
        set s__TLBBSSAllKill_main[this]=this
        set s__TLBBSSAllKill_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o025', GetUnitX(src), GetUnitY(src), GetUnitFacing(src))
        call SetUnitAnimation(s__TLBBSSAllKill_myDummy[this], "Spell Attack")
        call s__TLDummyLife_apply(s__TLBBSSAllKill_myDummy[this] , 1.90)
        call s__TLDummyFade_apply(s__TLBBSSAllKill_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.50)
        call s__TLDummyFadespan_apply(s__TLBBSSAllKill_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 1.40 , 1.90)
        call s__tick_start(s__TLBBSSAllKill_main[this],1.40 , true , function s__TLBBSSAllKill_onFire)
    endfunction
    function s__TLBBSSAllKillRayFx_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real angle
        local integer i= 0
        local integer imax= R2I(s__TLBBSSAllKillRayFx_D1[this]) / 384
        loop
            exitwhen i > imax
            set angle=GetRandomReal(0.0, 360.0)
            call DestroyEffect(AddSpecialEffect("FX\\Atalanta\\Ray.mdl", s__TLBBSSAllKillRayFx_X[this] + s__Polar_X(s__TLBBSSAllKillRayFx_D1[this] , angle), s__TLBBSSAllKillRayFx_Y[this] + s__Polar_Y(s__TLBBSSAllKillRayFx_D1[this] , angle)))
            set i=i + 1
        endloop
        set s__TLBBSSAllKillRayFx_D1[this]=s__TLBBSSAllKillRayFx_D1[this] + 128
        if s__TLBBSSAllKillRayFx_D1[this] < s__TLBBSSAllKillRayFx_D2[this] then
            return
        endif
        call s__tick_destroy(s__TLBBSSAllKillRayFx_main[this])
    endfunction
    function s__TLBBSSAllKillRayFx_apply takes real x,real y returns nothing
        local integer this= s__tick_create(0)
        set s__TLBBSSAllKillRayFx_main[this]=this
        set s__TLBBSSAllKillRayFx_X[this]=x
        set s__TLBBSSAllKillRayFx_Y[this]=y
        set s__TLBBSSAllKillRayFx_D1[this]=256.0
        set s__TLBBSSAllKillRayFx_D2[this]=22624.0
        call s__tick_start(s__TLBBSSAllKillRayFx_main[this],0.03125 , true , function s__TLBBSSAllKillRayFx_onFire)
    endfunction
