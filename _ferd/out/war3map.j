        set this=s__EV141FrancisB_getThis(GetUnitUserData(src))
        call AddPlayerGold(GetOwningPlayer(src) , s__EV141FrancisB_myAmount[this])
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetUnitX(dst), GetUnitY(dst)))
        call SetSoundPosition(gg_snd_Gold, GetUnitX(dst), GetUnitY(dst), 200)
        call StartSoundForPlayerBJ(GetOwningPlayer(src), gg_snd_Gold)
        call s__bountyTag_custom(GetOwningPlayer(src) , GetUnitX(dst) , GetUnitY(dst) + 64 , "|c00FFFF00+" + I2S(s__EV141FrancisB_myAmount[this]))
        set src=null
        set dst=null
   return true
endfunction
