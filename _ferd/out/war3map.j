    function s__ABILMashuCRest_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if IsUnitDead(s__ABILMashuCRest_source[this]) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\ReplenishMana\\ReplenishManaCasterOverhead.mdl", s__ABILMashuCRest_source[this], "overhead"))
        call SetUnitState(s__ABILMashuCRest_source[this], UNIT_STATE_MANA, 200)
