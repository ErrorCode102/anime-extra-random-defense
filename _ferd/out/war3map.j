    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVSEMI___OnAnylevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVSEMI___MeleeAttack)
            call sc__ABILSemiABuff_append(s__eventServantAdd_e , 15.00)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0DS')
            call sc__ABILSemiBTC_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0DK')
            call sc__ABILSemiCPoison_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0DH')
            call sc__ABILSemiDGarden_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVSEMI___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVSEMI___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVSEMI___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
