    function FXTrig2UnlockLv8___onCreateWisp takes nothing returns nothing
        local integer i= 0
        local integer cur
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                set cur=FXCountPlayerFactionMastered(Player(i))
                call SetPlayerTechResearched(Player(i), 'R009', cur)
            endif
            set i=i + 1
        endloop
    endfunction
    function FXTrig2UnlockLv8___onGameInit takes nothing returns nothing
        call TimerStart(FXTrig2UnlockLv8___t, 2.00, false, function FXTrig2UnlockLv8___onCreateWisp)
    endfunction
