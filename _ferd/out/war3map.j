        function s__Texttag_Create takes string t,real s,real x,real y,real z returns integer
            local integer this= 0
            if s__Texttag_CNT < s__Texttag_MAX then
                set s__Texttag_CNT=s__Texttag_CNT + 1
                set this=s__Texttag__allocate()
                set s__Texttag_T[this]=CreateTextTag()
                call SetTextTagText(s__Texttag_T[this], t, s)
                set s__Texttag_S[this]=s
                call SetTextTagPos(s__Texttag_T[this], x, y, z)
                call SetTextTagVisibility(s__Texttag_T[this], true)
            endif
            return this
        endfunction
