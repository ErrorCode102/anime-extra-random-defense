//library PLAYServant:

        function s__eventServantAdd_evaluate takes unit u returns nothing
            local player prep= s__eventServantAdd_ep
            local unit pree= s__eventServantAdd_e
            set s__eventServantAdd_ep=GetOwningPlayer(u)
            set s__eventServantAdd_e=u
            call TriggerEvaluate(LoadTriggerHandle(s__eventServantAdd_H, 0, GetUnitTypeId(u)))
            call TriggerEvaluate(s__eventServantAdd_ALL)
            set s__eventServantAdd_ep=prep
            set s__eventServantAdd_e=pree
            set prep=null
            set pree=null
        endfunction
        function s__eventServantAdd_register takes integer id,code c returns triggercondition
            if id == 0 then
                return TriggerAddCondition(s__eventServantAdd_ALL, Filter(c))
            endif
            if not HaveSavedHandle(s__eventServantAdd_H, 0, id) then
                call SaveTriggerHandle(s__eventServantAdd_H, 0, id, CreateTrigger())
            endif
            return TriggerAddCondition(LoadTriggerHandle(s__eventServantAdd_H, 0, id), Filter(c))
        endfunction
    
        function s__trimmer_Trim takes string name,integer id returns string
            local integer i= 0
            local integer mx= StringLength(name)
            loop
                exitwhen i == mx
                set i=i + 1
                if SubString(name, i, i + 2) == "|n" then
                    set name=SubString(name, 0, i)
                    exitwhen true
                endif
            endloop
            call SaveStr(s__trimmer_H, 0, id, name)
            return name
        endfunction
        function s__trimmer_get takes integer id returns string
            if not HaveSavedString(s__trimmer_H, 0, id) then
                call s__trimmer_Trim(GetObjectName(id) , id)
            endif
            return LoadStr(s__trimmer_H, 0, id)
        endfunction
    
        //private static hashtable array H
        function s__servant_onInit takes nothing returns nothing
            set s__servant_PATH[1]="|c00b0b0b0Draw:|r"
            set s__servant_PATH[2]="|c0000ff80Merge:|r"
            set s__servant_PATH[3]="|c00ff8000Disintegration:|r"
            set s__servant_PATH[4]="|c000080ffReward:|r"
            set s__servant_PATH[5]="|c00ff40ffTransformation:|r"
            set s__servant_UC[0]=CreateUnitCounter()
            set s__servant_UC[1]=CreateUnitCounter()
            set s__servant_UC[2]=CreateUnitCounter()
            set s__servant_UC[3]=CreateUnitCounter()
        endfunction
        function s__servant_getOriginalType takes player p,unit u returns integer
            return GetUnitCountedTypeId(u , s__servant_UC[GetPlayerId(p)])
        endfunction
        function s__servant_count takes player p,integer id returns integer
            return UnitCounterGetCounted(s__servant_UC[GetPlayerId(p)] , id)
        endfunction
        function s__servant_enum takes player p,integer id,integer count,code c returns nothing
            call ForUnitCounter(s__servant_UC[GetPlayerId(p)] , id , count , c)
        endfunction
        function s__servant_add takes player p,unit u,integer kind returns nothing
            local integer id= GetPlayerId(p)
            local integer lv= GetUnitLevel(u)
            call UnitRemoveAbility(u, 'Avul')
            call sc__UnitIndexer_append(u)
            call sc__EVUnitRemove_append(u)
            call sc__EVTeleportControl_append(u)
            call sc__EVDamageManager_append(u)
            call sc__EVServantAttack_append(u)
            call sc__EVDebuffStunServant_append(u)
            if kind > 0 then
                if lv < 4 then
                    call DisplayTextToPlayer(p, 0.00, 0.00, s__servant_PATH[kind] + " " + s__trimmer_get(GetUnitTypeId(u)) + " acquired!")
                else
                    call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, s__pcs_get(p) + "|r " + s__servant_PATH[kind] + " " + s__trimmer_get(GetUnitTypeId(u)) + " obtained!")
                    if lv > 6 then
                        call SetUnitAnimation(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o029', GetUnitX(u), GetUnitY(u), 270.0), "Birth")
                    endif
                endif
            endif
            if lv > FXRD_SERVANT_BEST[id] then
                set FXRD_SERVANT_BEST[id]=lv
            endif
            call UnitAddAbility(u, 'Aeth')
            call UnitAddAbility(u, 'gath')
            call UnitAddAbility(u, 'Amrf')
            call UnitRemoveAbility(u, 'Amrf')
            call UnitCounterAddUnit(s__servant_UC[GetPlayerId(p)] , u)
            //call SaveInteger( H[GetPlayerId(p)], 0, GetUnitTypeId(u), LoadInteger(H[id], 0, GetUnitTypeId(u)) + 1 )
            call s__eventServantAdd_evaluate(u)
            //call eventCustom.evaluate( EVENT_SERVANT_ADD, p, u, null, 0 )
        endfunction
        function s__servant_clear takes player p returns nothing
            //call FlushChildHashtable( H[GetPlayerId(p)], 0 )
            set s__servant_UC[GetPlayerId(p)]=CreateUnitCounter()
        endfunction
        function s__servant_remove takes player p,unit u returns nothing
            //local integer id = GetPlayerId(p)
            //call SaveInteger( H[id], 0, GetUnitTypeId(u), LoadInteger(H[id], 0, GetUnitTypeId(u)) - 1 )
            call UnitRemoveAbility(u, 'gath')
            //call PersonalRemove( u )
        endfunction
        function s__servant_kill takes unit u,boolean flag returns nothing
            call s__servant_remove(GetOwningPlayer(u) , u)
            if not flag then
                call ShowUnit(u, flag)
            endif
            call KillUnit(u)
        endfunction

