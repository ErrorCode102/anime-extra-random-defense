    function s__ABILEnkiduBUnstun_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if IsUnitDead(s__ABILEnkiduBUnstun_source[this]) then
            return
        endif
        if GetUnitAbilityLevel(s__ABILEnkiduBUnstun_source[this], 'BPSE') == 0 then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", s__ABILEnkiduBUnstun_source[this], "origin"))
        call sc__EVDebuffStunServant_clear(s__ABILEnkiduBUnstun_source[this])
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
