// Trigger: FX Declaration
//
// 설정부에서 사용되는 UI레이아웃 상수들
//===========================================================================
// Trigger: FX Zone
//===========================================================================
// scope FXZone begins
    function FXZone___action takes nothing returns nothing
        set PLAYER_ZONE_LINE[0]=gg_rct_SP1_LINE
        set PLAYER_ZONE_LINE[1]=gg_rct_SP2_LINE
        set PLAYER_ZONE_LINE[2]=gg_rct_SP3_LINE
        set PLAYER_ZONE_LINE[3]=gg_rct_SP4_LINE
        //
        set ZONE_TELEPORTABLE[0]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP1_STASH)
        if MODE_CURRENT == MODE_TEAM then
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP1_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP2_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP3_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP4_LINE)
        else
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_SP1_LINE)
        endif
        //
        set ZONE_TELEPORTABLE[1]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP2_STASH)
        if MODE_CURRENT == MODE_TEAM then
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP1_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP2_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP3_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP4_LINE)
        else
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_SP2_LINE)
        endif
        //
        set ZONE_TELEPORTABLE[2]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP3_STASH)
        if MODE_CURRENT == MODE_TEAM then
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP1_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP2_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP3_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP4_LINE)
        else
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_SP3_LINE)
        endif
        //
        set ZONE_TELEPORTABLE[3]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP4_STASH)
        if MODE_CURRENT == MODE_TEAM then
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP1_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP2_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP3_LINE)
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP4_LINE)
        else
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_SP4_LINE)
        endif
        //
        set ZONE_TELEPORTABLE1[0]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE1[0], gg_rct_SP1_LINE)
        set ZONE_TELEPORTABLE2[0]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE2[0], gg_rct_SP1_STASH)
        set ZONE_TELEPORTABLE1[1]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE1[1], gg_rct_SP2_LINE)
        set ZONE_TELEPORTABLE2[1]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE2[1], gg_rct_SP2_STASH)
        set ZONE_TELEPORTABLE1[2]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE1[2], gg_rct_SP3_LINE)
        set ZONE_TELEPORTABLE2[2]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE2[2], gg_rct_SP3_STASH)
        set ZONE_TELEPORTABLE1[3]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE1[3], gg_rct_SP4_LINE)
        set ZONE_TELEPORTABLE2[3]=CreateRegion()
        call RegionAddRect(ZONE_TELEPORTABLE2[3], gg_rct_SP4_STASH)
        
        if MODE_CURRENT != MODE_SPEEDRUN then
            set ZONE_TELEPORTABLE3[0]=CreateRegion()
            call RegionAddRect(ZONE_TELEPORTABLE3[0], gg_rct_Z_BOSS)
            set ZONE_TELEPORTABLE3[1]=CreateRegion()
            call RegionAddRect(ZONE_TELEPORTABLE3[1], gg_rct_Z_BOSS)
            set ZONE_TELEPORTABLE3[2]=CreateRegion()
            call RegionAddRect(ZONE_TELEPORTABLE3[2], gg_rct_Z_BOSS)
            set ZONE_TELEPORTABLE3[3]=CreateRegion()
            call RegionAddRect(ZONE_TELEPORTABLE3[3], gg_rct_Z_BOSS)
            call RegionAddRect(ZONE_TELEPORTABLE[0], gg_rct_Z_BOSS)
            call RegionAddRect(ZONE_TELEPORTABLE[1], gg_rct_Z_BOSS)
            call RegionAddRect(ZONE_TELEPORTABLE[2], gg_rct_Z_BOSS)
            call RegionAddRect(ZONE_TELEPORTABLE[3], gg_rct_Z_BOSS)
        endif
    endfunction
    function FXZone___main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXZone___action)
    endfunction
// scope FXZone ends
// Trigger: FX Route
//===========================================================================
// scope FXRoute begins
    function FXRoute___main takes nothing returns nothing
        local integer i= 0
        local real x
        local real y
        loop
            exitwhen i == 4
            set x=GetPlayerStartLocationX(Player(i))
            set y=GetPlayerStartLocationY(Player(i))
            set ROUTE_LANE[i]=s__Route_create()
            call s__Route_add(ROUTE_LANE[i],x - 960 , y + 960)
            call s__Route_add(ROUTE_LANE[i],x - 960 , y - 960)
            call s__Route_add(ROUTE_LANE[i],x + 960 , y - 960)
            call s__Route_add(ROUTE_LANE[i],x + 960 , y + 960)
            call s__Route_add(ROUTE_LANE[i],x - 960 , y + 960)
            set i=i + 1
        endloop
        set ROUTE_LANE_TEAM[0]=s__Route_create()
        call s__Route_add(ROUTE_LANE_TEAM[0],- 3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[0],- 3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[0],3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[0],3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[0],- 3520 , 3520)
        
        set ROUTE_LANE_TEAM[1]=s__Route_create()
        call s__Route_add(ROUTE_LANE_TEAM[1],3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[1],- 3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[1],- 3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[1],3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[1],3520 , 3520)
        
        set ROUTE_LANE_TEAM[2]=s__Route_create()
        call s__Route_add(ROUTE_LANE_TEAM[2],- 3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[2],3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[2],3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[2],- 3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[2],- 3520 , - 3520)
        
        set ROUTE_LANE_TEAM[3]=s__Route_create()
        call s__Route_add(ROUTE_LANE_TEAM[3],3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[3],3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[3],- 3520 , 3520)
        call s__Route_add(ROUTE_LANE_TEAM[3],- 3520 , - 3520)
        call s__Route_add(ROUTE_LANE_TEAM[3],3520 , - 3520)
    
    endfunction
// scope FXRoute ends
