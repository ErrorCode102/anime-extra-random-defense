function sa__EVDamageManager_reCalc takes nothing returns boolean
local integer this=f__arg_this
        local integer nfodmg= s__EVDamageManager_ODMG[this] * s__EVDamageManager_PDMG[this] / 100
        local integer nfdmg= nfodmg * s__EVDamageManager_BPDMG[this] / 100 + s__EVDamageManager_ADMG[this]
        call s__EVDamageManager_refresh(s__EVDamageManager_SRC[this] , nfdmg - s__EVDamageManager_ODMG[this])
        set s__EVDamageManager_FODMG[this]=nfodmg
        set s__EVDamageManager_FDMG[this]=nfdmg
   return true
