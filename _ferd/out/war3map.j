    function s__EVBossSkillR90_destroy takes integer this returns nothing
        set s__EVBossSkillR90_SRC[this]=null
        set s__EVBossSkillR90_RCT[this]=null
        //
        call s__tick_destroy(s__EVBossSkillR90_main[this])
    endfunction
    
    function s__EVBossSkillR90_append takes unit src,rect r,real dur returns nothing
        local integer this= s__tick_create(0)
        set s__EVBossSkillR90_main[this]=this
        //
        set s__EVBossSkillR90_SRC[this]=src
        set s__EVBossSkillR90_RCT[this]=r
        set s__EVBossSkillR90_DUR[this]=dur
        //
        call s__tick_start(s__EVBossSkillR90_main[this],dur , false , function sc__EVBossSkillR90_onExpire)
    endfunction
    
    function s__EVBossSkillR90_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__EVBossSkillR90_SRC[this]) then
            call s__EVBossSkillR90_destroy(this)
            return
        endif
        call s__tick_start(s__EVBossSkillR90_main[this],s__EVBossSkillR90_DUR[this] , false , function s__EVBossSkillR90_onExpire)
        set s__EVBossSkillR90_DEST=null
        set s__EVBossSkillR90_DCNT=0
        call s__splash_rect(s__splash_ANY , null , s__EVBossSkillR90_RCT[this] , function sc__EVBossSkillR90_enumGetTarget)
        if s__EVBossSkillR90_DEST == null then
            return
        endif
        call sc__EVBossAlmostKillMissle_cast(s__EVBossSkillR90_SRC[this] , s__EVBossSkillR90_DEST)
    endfunction
    
    
    function s__EVBossSkillR90_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetRandomInt(0, s__EVBossSkillR90_DCNT) == 0 then
            set s__EVBossSkillR90_DEST=GetEnumUnit()
        endif
        set s__EVBossSkillR90_DCNT=s__EVBossSkillR90_DCNT + 1
    endfunction

    function s__EVBossAlmostKillMissle_onInit takes nothing returns nothing
        set s__EVBossAlmostKillMissle_EFFECT_PATH[0]="FX\\CrossGlowYellow\\glow1.mdl"
        set s__EVBossAlmostKillMissle_EFFECT_PATH[1]="FX\\CrossGlowYellow\\glow2.mdl"
        set s__EVBossAlmostKillMissle_EFFECT_PATH[2]="FX\\CrossGlowYellow\\glow3.mdl"
        set s__EVBossAlmostKillMissle_EFFECT_PATH[3]="FX\\CrossGlowYellow\\glow4.mdl"
    endfunction
    function s__EVBossAlmostKillMissle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > 4 then
            call DestroyEffect(AddSpecialEffectTarget(s__EVBossAlmostKillMissle_EFFECT_PATH[GetRandomInt(0, 3)], GetEnumUnit(), "origin"))
        endif
        if GetEnumUnit() == s__EVBossAlmostKillMissle_target[this] then
            return
        endif
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 1.00)
    endfunction
    function s__EVBossAlmostKillMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real tx
        local real ty
        if IsUnitDead(s__EVBossAlmostKillMissle_caster[this]) or IsUnitDead(s__EVBossAlmostKillMissle_target[this]) or s__EVBossAlmostKillMissle_iterator[this] == 0 then
            set s__EVBossAlmostKillMissle_caster[this]=null
            set s__EVBossAlmostKillMissle_target[this]=null
            call s__tick_destroy(s__EVBossAlmostKillMissle_main[this])
            return
        endif
        set s__EVBossAlmostKillMissle_iterator[this]=s__EVBossAlmostKillMissle_iterator[this] - 1
        set tx=GetUnitX(s__EVBossAlmostKillMissle_target[this])
        set ty=GetUnitY(s__EVBossAlmostKillMissle_target[this])
        call DestroyEffect(AddSpecialEffect(s__EVBossAlmostKillMissle_EFFECT_PATH[GetRandomInt(0, 3)], tx + GetRandomReal(- 400, 400), ty + GetRandomReal(- 400, 400)))
        call DestroyEffect(AddSpecialEffect(s__EVBossAlmostKillMissle_EFFECT_PATH[GetRandomInt(0, 3)], tx + GetRandomReal(- 400, 400), ty + GetRandomReal(- 400, 400)))
        call DestroyEffect(AddSpecialEffect(s__EVBossAlmostKillMissle_EFFECT_PATH[GetRandomInt(0, 3)], tx + GetRandomReal(- 400, 400), ty + GetRandomReal(- 400, 400)))
        call StopSound(gg_snd_hit_stab, false, false)
        call SetSoundPosition(gg_snd_hit_stab, tx, ty, 300)
        call StartSound(gg_snd_hit_stab)
        call s__splash_range(s__splash_ANY , s__EVBossAlmostKillMissle_caster[this] , tx , ty , 500 , function s__EVBossAlmostKillMissle_enumDealt)
    endfunction
    function s__EVBossAlmostKillMissle_onCast takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local unit u
        if IsUnitDead(s__EVBossAlmostKillMissle_caster[this]) or IsUnitDead(s__EVBossAlmostKillMissle_target[this]) then
            set s__EVBossAlmostKillMissle_caster[this]=null
            set s__EVBossAlmostKillMissle_target[this]=null
            call s__tick_destroy(s__EVBossAlmostKillMissle_main[this])
            return
        endif
        call s__tick_start(s__EVBossAlmostKillMissle_main[this],0.20 , true , function s__EVBossAlmostKillMissle_onFire)
        set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , GetUnitX(s__EVBossAlmostKillMissle_target[this]) , GetUnitY(s__EVBossAlmostKillMissle_target[this]) , 270 , 255 , 128 , 0 , 255 , 5)
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_caster[this])
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_target[this])
        call FXRD_FXLifeSpanCommon(u , 10.00)
        call sc__DummyFollowUnit_cast(u , s__EVBossAlmostKillMissle_target[this])
        set u=null
    endfunction
    function s__EVBossAlmostKillMissle_cast takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        local unit u
        set s__EVBossAlmostKillMissle_caster[this]=src
        set s__EVBossAlmostKillMissle_target[this]=dst
        set s__EVBossAlmostKillMissle_iterator[this]=50
        set s__EVBossAlmostKillMissle_main[this]=this
        call s__tick_start(s__EVBossAlmostKillMissle_main[this],10.00 , false , function s__EVBossAlmostKillMissle_onCast)
        set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , GetUnitX(s__EVBossAlmostKillMissle_target[this]) , GetUnitY(s__EVBossAlmostKillMissle_target[this]) , 270 , 255 , 0 , 0 , 255 , 5)
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_caster[this])
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_target[this])
        call FXRD_FXLifeSpanCommon(u , 10.00)
        call sc__DummyFollowUnit_cast(u , s__EVBossAlmostKillMissle_target[this])
        set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , GetUnitX(s__EVBossAlmostKillMissle_target[this]) , GetUnitY(s__EVBossAlmostKillMissle_target[this]) , 270 , 128 , 255 , 128 , 255 , 1)
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_caster[this])
        call FXRD_FXBinderBindUnit(u , s__EVBossAlmostKillMissle_target[this])
        call FXRD_FXLifeSpanCommon(u , 20.00)
        call sc__DummyFollowUnit_cast(u , s__EVBossAlmostKillMissle_target[this])
        set u=null
    endfunction
