        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV168AlqueidB_STRUCT_ID)
    endfunction
    
    function s__EV168AlqueidB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV168AlqueidB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV168AlqueidB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV168AlqueidB__allocate()
        set s__EV168AlqueidB_ID[this]=GetUnitUserData(src)
        call s__EV168AlqueidB_setThis(s__EV168AlqueidB_ID[this] , this)
        return this
    endfunction
    
    function s__EV168AlqueidB_destroy takes integer this returns nothing
        call s__EV168AlqueidB_setThis(s__EV168AlqueidB_ID[this] , 0)
        call s__EV168AlqueidB_deallocate(this)
    endfunction
    
    //API
    function s__EV168AlqueidB_append takes unit src,real dmg,real coold returns nothing
        local integer this= s__EV168AlqueidB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV168AlqueidB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV168AlqueidB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV168AlqueidB_onSourceUnitRemove)
        set s__EV168AlqueidB_myServant[this]=src
        set s__EV168AlqueidB_myCooldown[this]=coold
        set s__EV168AlqueidB_myDamage[this]=dmg
        set s__EV168AlqueidB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV168AlqueidB_coolTick[this],1.00 , true , function sc__EV168AlqueidB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV168AlqueidB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV168AlqueidB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV168AlqueidB_coolTick[this])
        set s__EV168AlqueidB_myServant[this]=null
        call TriggerUnbindAction(s__EV168AlqueidB_onRemoveAction[this])
        set s__EV168AlqueidB_onRemoveAction[this]=null
        //종결
        call s__EV168AlqueidB_destroy(this)
    endfunction
    
    
    function s__EV168AlqueidB_enumGetTarget takes nothing returns nothing
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
            if not s__EV168AlqueidB_ISGIANT then
                set s__EV168AlqueidB_CNT=0
            endif
            set s__EV168AlqueidB_ISGIANT=true
        else
            if s__EV168AlqueidB_ISGIANT then
                return
            endif
        endif
        if GetRandomInt(0, s__EV168AlqueidB_CNT) == 0 then
            set s__EV168AlqueidB_DEST=GetEnumUnit()
        endif
        set s__EV168AlqueidB_CNT=s__EV168AlqueidB_CNT + 1
    endfunction
    
    function s__EV168AlqueidB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV168AlqueidB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV168AlqueidB_coolTick[this])
            return
        endif
        set s__EV168AlqueidB_DEST=null
        set s__EV168AlqueidB_CNT=0
        set s__EV168AlqueidB_ISGIANT=false
        call s__splash_range(s__splash_ENEMY , s__EV168AlqueidB_myServant[this] , GetUnitX(s__EV168AlqueidB_myServant[this]) , GetUnitY(s__EV168AlqueidB_myServant[this]) , GetUnitAcquireRange(s__EV168AlqueidB_myServant[this]) + 100 , function s__EV168AlqueidB_enumGetTarget)
        //대상이 없으면
        if s__EV168AlqueidB_DEST == null then
            call s__tick_start(s__EV168AlqueidB_coolTick[this],1.00 , true , function s__EV168AlqueidB_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMSchwester_cast(s__EV168AlqueidB_myServant[this] , s__EV168AlqueidB_myDamage[this])
        call s__tick_start(s__EV168AlqueidB_coolTick[this],s__EV168AlqueidB_myCooldown[this] , true , function s__EV168AlqueidB_onCastSpell)
        set s__EV168AlqueidB_DEST=null
    endfunction
    
// Trigger: EV 171 AndersenB
//===========================================================================

    
    function s__EV171AndersenB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV171AndersenB_STRUCT_ID)
    endfunction
    
    function s__EV171AndersenB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV171AndersenB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV171AndersenB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV171AndersenB__allocate()
        set s__EV171AndersenB_ID[this]=GetUnitUserData(src)
        call s__EV171AndersenB_setThis(s__EV171AndersenB_ID[this] , this)
        return this
    endfunction
    
    function s__EV171AndersenB_destroy takes integer this returns nothing
        call s__EV171AndersenB_setThis(s__EV171AndersenB_ID[this] , 0)
        call s__EV171AndersenB_deallocate(this)
    endfunction
    
    //API
    
    
    
    function s__EV171AndersenB_append takes unit src,integer aftermath,integer dtarg,integer atarg,integer alev,real del returns nothing
        local integer this= s__EV171AndersenB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV171AndersenB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV171AndersenB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV171AndersenB_onSourceUnitRemove)
        set s__EV171AndersenB_myServant[this]=src
        set s__EV171AndersenB_myAfter[this]=aftermath
        set s__EV171AndersenB_myTick[this]=s__tick_create(this)
        set s__EV171AndersenB_myCoolChkTick[this]=s__tick_create(this)
        
        set s__EV171AndersenB_desId[this]=dtarg
        set s__EV171AndersenB_addId[this]=atarg
        set s__EV171AndersenB_addLv[this]=alev
        // 디버그 테스트 시, 쿨타임 10초로 조정
        call s__tick_start(s__EV171AndersenB_myTick[this],del , false , function sc__EV171AndersenB_onExpire)
        call s__tick_start(s__EV171AndersenB_myCoolChkTick[this],5.00 , false , function sc__EV171AndersenB_onCoolChk)
        
        set s__EV171AndersenB_onSpellEffect[this]=CreateTrigger()
        call TriggerAddCondition(s__EV171AndersenB_onSpellEffect[this], Condition(function sc__EV171AndersenB_conditionSpellEffect))
        set s__EV171AndersenB_onSpellEffectAction[this]=TriggerAddAction(s__EV171AndersenB_onSpellEffect[this], function sc__EV171AndersenB_actionSpellEffect)
        call TriggerRegisterUnitEvent(s__EV171AndersenB_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
        
        set s__EV171AndersenB_onSpellCast[this]=CreateTrigger()
        call TriggerAddCondition(s__EV171AndersenB_onSpellCast[this], Condition(function sc__EV171AndersenB_conditionSpellEffect))
        set s__EV171AndersenB_onSpellCastAction[this]=TriggerAddAction(s__EV171AndersenB_onSpellCast[this], function sc__EV171AndersenB_actionSpellCast)
        call TriggerRegisterUnitEvent(s__EV171AndersenB_onSpellCast[this], src, EVENT_UNIT_SPELL_CAST)
    endfunction
    
    //구현부
    function s__EV171AndersenB_onCoolChk takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EV171AndersenB_myServant[this]) then
            return
        endif
        if GetUnitAbilityLevel(s__EV171AndersenB_myServant[this], s__EV171AndersenB_desId[this]) == 0 then
            return
        endif
        call SetUnitAbilityLevel(s__EV171AndersenB_myServant[this], s__EV171AndersenB_desId[this], R2I(s__tick__get_elapsed(s__EV171AndersenB_myTick[this])) / 60 + 1)
        call s__tick_start(s__EV171AndersenB_myCoolChkTick[this],5.00 , false , function s__EV171AndersenB_onCoolChk)
    endfunction
    function s__EV171AndersenB_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EV171AndersenB_myServant[this]) then
            return
        endif
        call UnitRemoveAbility(s__EV171AndersenB_myServant[this], s__EV171AndersenB_desId[this])
        call UnitAddAbility(s__EV171AndersenB_myServant[this], s__EV171AndersenB_addId[this])
        call SetUnitAbilityLevel(s__EV171AndersenB_myServant[this], s__EV171AndersenB_addId[this], s__EV171AndersenB_addLv[this])
    endfunction
    
    function s__EV171AndersenB_actionSpellCast takes nothing returns nothing
        local integer this= s__EV171AndersenB_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer level= GetUnitAbilityLevel(GetTriggerUnit(), 'A07S')
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A08P') == 0 then
                if level == 1 then
                    if GetUnitLevel(GetSpellTargetUnit()) == 5 then
                        return
                    endif
                else
                    if GetUnitLevel(GetSpellTargetUnit()) == 6 then
                        return
                    endif
                endif
            endif
        endif
        call UnitRemoveAbility(GetTriggerUnit(), 'A07S')
        call UnitAddAbility(GetTriggerUnit(), 'A07S')
        call SetUnitAbilityLevel(GetTriggerUnit(), 'A07S', level)
        call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
    endfunction
    function s__EV171AndersenB_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV171AndersenB_getThis(GetUnitUserData(GetTriggerUnit()))
        //
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetTriggerUnit(), "origin"))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetSpellTargetUnit(), "origin"))
        call s__EVServantChanger_append(GetSpellTargetUnit() , 0.10 , 60.00 , GetUnitLevel(GetSpellTargetUnit()) + 1 , false)
        //
        call UnitRemoveAbility(GetTriggerUnit(), 'A07S')
        call UnitAddAbility(GetTriggerUnit(), s__EV171AndersenB_myAfter[this])
    endfunction
    function s__EV171AndersenB_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == 'A07S'
    endfunction
    function s__EV171AndersenB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV171AndersenB_getThis(s__EVUnitRemove_e)
        call s__tick_destroy(s__EV171AndersenB_myTick[this])
        call s__tick_destroy(s__EV171AndersenB_myCoolChkTick[this])
        //누수처리
        call TriggerRemoveAction(s__EV171AndersenB_onSpellEffect[this], s__EV171AndersenB_onSpellEffectAction[this])
        set s__EV171AndersenB_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV171AndersenB_onSpellEffect[this])
        set s__EV171AndersenB_onSpellEffect[this]=null
        call TriggerRemoveAction(s__EV171AndersenB_onSpellCast[this], s__EV171AndersenB_onSpellCastAction[this])
        set s__EV171AndersenB_onSpellCastAction[this]=null
        call DestroyTrigger(s__EV171AndersenB_onSpellCast[this])
        set s__EV171AndersenB_onSpellCast[this]=null
        set s__EV171AndersenB_myServant[this]=null
        call TriggerUnbindAction(s__EV171AndersenB_onRemoveAction[this])
        set s__EV171AndersenB_onRemoveAction[this]=null
        //종결
        call s__EV171AndersenB_destroy(this)
    endfunction
    
    
// Trigger: EV 172 AndersenA
//===========================================================================

    
    function s__EV172AndersenA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV172AndersenA_STRUCT_ID)
    endfunction
    
    function s__EV172AndersenA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV172AndersenA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV172AndersenA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV172AndersenA__allocate()
        set s__EV172AndersenA_ID[this]=GetUnitUserData(src)
        call s__EV172AndersenA_setThis(s__EV172AndersenA_ID[this] , this)
        return this
    endfunction
    
    function s__EV172AndersenA_destroy takes integer this returns nothing
        call s__EV172AndersenA_setThis(s__EV172AndersenA_ID[this] , 0)
        call s__EV172AndersenA_deallocate(this)
    endfunction
    
    //API
        //Caster Unit
        //Ability Cooldown
        //Ability Duration
        //Maximum targets
    function s__EV172AndersenA_append takes unit src,real coold,real duration,integer maxTarget returns nothing
        local integer this= s__EV172AndersenA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV172AndersenA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV172AndersenA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV172AndersenA_onSourceUnitRemove)
        set s__EV172AndersenA_UCAS[this]=src
        set s__EV172AndersenA_ACLD[this]=coold
        set s__EV172AndersenA_ADUR[this]=duration
        set s__EV172AndersenA_AMXT[this]=maxTarget
        set s__EV172AndersenA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV172AndersenA_coolTick[this],1.00 , true , function sc__EV172AndersenA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV172AndersenA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV172AndersenA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV172AndersenA_coolTick[this])
        set s__EV172AndersenA_UCAS[this]=null
        call TriggerUnbindAction(s__EV172AndersenA_onRemoveAction[this])
        set s__EV172AndersenA_onRemoveAction[this]=null
        //종결
        call s__EV172AndersenA_destroy(this)
    endfunction
    
    
    function s__EV172AndersenA_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__EV172AndersenA_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A086') > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__EV172AndersenA_LEV then
            set s__EV172AndersenA_LEV=GetUnitLevel(GetEnumUnit())
            set s__EV172AndersenA_CNT=0
        endif
        if GetRandomInt(0, s__EV172AndersenA_CNT) == 0 then
            set s__EV172AndersenA_DEST=GetEnumUnit()
        endif
        set s__EV172AndersenA_CNT=s__EV172AndersenA_CNT + 1
    endfunction
    
    function s__EV172AndersenA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local integer i= 0
        if IsUnitDead(s__EV172AndersenA_UCAS[this]) then
            call s__tick_pause(s__EV172AndersenA_coolTick[this])
            return
        endif
        //call KillUnit(CreateUnit( Player(15), 'o00Y', GetUnitX(.myServant), GetUnitY(.myServant), 270 ))
        loop
            exitwhen i == s__EV172AndersenA_AMXT[this]
            set s__EV172AndersenA_DEST=null
            set s__EV172AndersenA_CNT=0
            set s__EV172AndersenA_LEV=0
            call s__splash_range(s__splash_ALLY , s__EV172AndersenA_UCAS[this] , GetUnitX(s__EV172AndersenA_UCAS[this]) , GetUnitY(s__EV172AndersenA_UCAS[this]) , GetUnitAcquireRange(s__EV172AndersenA_UCAS[this]) + 100 , function s__EV172AndersenA_enumGetTarget)
            if s__EV172AndersenA_DEST != null then
                call s__CMHumanObserve_cast(s__EV172AndersenA_UCAS[this] , s__EV172AndersenA_DEST , s__EV172AndersenA_ADUR[this])
            endif
            set i=i + 1
        endloop
        call s__tick_start(s__EV172AndersenA_coolTick[this],s__EV172AndersenA_ACLD[this] , true , function s__EV172AndersenA_onCastSpell)
        set s__EV172AndersenA_DEST=null
    endfunction
    
