    function s__FXBB_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(s__FXBB_myFx[this])
        set s__FXBB_myFx[this]=null
        set s__FXBB_caster[this]=null
        call s__tick_destroy(s__FXBB_main[this])
    endfunction
    function s__FXBB_cast takes unit src returns nothing
        local integer this= s__tick_create(0)
        call s__EVDebuffStunServant_apply(src , 1.30)
        call SetSoundPosition(gg_snd_servant_spawn_rare, GetUnitX(src), GetUnitY(src), 300)
        call StartSound(gg_snd_servant_spawn_rare)
        call SetUnitAnimation(src, "attack gold")
        set s__FXBB_myFx[this]=AddSpecialEffectTarget("FX\\Okita\\Aura1.mdl", s__FXBB_caster[this], "origin")
        set s__FXBB_caster[this]=src
        set s__FXBB_main[this]=this
        call s__tick_start(s__FXBB_main[this],1.00 , true , function s__FXBB_onFinal)
    endfunction

    function s__CMAurea_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMAurea_target[this], UNIT_TYPE_DEAD) then
            call UnitRemoveAbility(s__CMAurea_target[this], 'A07V')
            call UnitRemoveAbility(s__CMAurea_target[this], 'B007')
        endif
        set s__CMAurea_caster[this]=null
        set s__CMAurea_target[this]=null
        call s__tick_destroy(s__CMAurea_mainFlow[this])
    endfunction
    function s__CMAurea_cast takes unit src,unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMAurea_caster[this]=src
        set s__CMAurea_target[this]=dst
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", dst, "origin"))
        call UnitAddAbility(s__CMAurea_target[this], 'A07V')
        set s__CMAurea_mainFlow[this]=this
        call s__tick_start(s__CMAurea_mainFlow[this],delay , false , function s__CMAurea_onFinal)
    endfunction
