        set SvSakura___ODMG[2]=100
        set SvSakura___ODMG[3]=250
        set SvSakura___ODMG[4]=500
        set SvSakura___ODMG[5]=1250
        set SvSakura___ODMG[6]=4000
        call s__eventServantAdd_register(FX_SERVANT_SAKURA + OFF_E , function SvSakura___onServantGet)
        call s__eventServantAdd_register(FX_SERVANT_SAKURA + OFF_D , function SvSakura___onServantGet)
        call s__eventServantAdd_register(FX_SERVANT_SAKURA + OFF_C , function SvSakura___onServantGet)
        call s__eventServantAdd_register(FX_SERVANT_SAKURA + OFF_B , function SvSakura___onServantGet)
        call s__eventServantAdd_register(FX_SERVANT_SAKURA + OFF_A , function SvSakura___onServantGet)
