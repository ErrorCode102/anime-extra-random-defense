        set id=GetUnitUserData(GetTriggerUnit())
        set idTab=GetCustomDataTable(id)
        set idKey=GetCustomDataKey(id)
        set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        set pth=GetAbilityEffectById(GetSpellAbilityId(), EFFECT_TYPE_LIGHTNING, 0)
        call s__bountyTag_custom(GetOwningPlayer(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY() , GetAbilityEffectById(GetSpellAbilityId(), EFFECT_TYPE_TARGET, 0))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())))
        call SetUnitX(GetSpellAbilityUnit(), GetSpellTargetX())
        call SetUnitY(GetSpellAbilityUnit(), GetSpellTargetY())
        call DestroyEffect(AddSpecialEffect(pth, GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())))
        set idTab=null
set f__result_boolean= false
   return true
endfunction
