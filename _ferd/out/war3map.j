function sa__ABILHeroineXCosmos_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local player p= GetOwningPlayer(s__ABILHeroineXCosmos_source[this])
        if GetUnitAbilityLevel(s__ABILHeroineXCosmos_source[this], s__ABILHeroineXCosmos_ABILITY) == 1 then
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0FK') == 0 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXCosmos_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXCosmos_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant not classified as Artoria.|r")
                set p=null
return true
            endif
            if GetUnitLevel(GetSpellTargetUnit()) != 7 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXCosmos_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXCosmos_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant's grade is too low to be sacrificed.|r")
                set p=null
return true
            endif
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A02W') > 0 then
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", s__ABILHeroineXCosmos_source[this], "origin"))
                call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A02W')
                call sc__EVDamageManager_addBonus(s__ABILHeroineXCosmos_source[this] , 100)
            endif
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GO') > 0 then
                call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A0GO')
                call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A0GN')
                call sc__EVDamageManager_addBonus(s__ABILHeroineXCosmos_source[this] , 50)
            endif
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GP') > 0 then
                call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A0GQ')
                call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A0GR')
                call sc__EVDamageManager_addBonus(s__ABILHeroineXCosmos_source[this] , 1000)
            endif
            call s__servant_kill(GetSpellTargetUnit() , true)
            call UnitAddAbility(s__ABILHeroineXCosmos_source[this], 'A0GE')
            call sc__EVDamageManager_addBonus(s__ABILHeroineXCosmos_source[this] , 400)
            call SetUnitAbilityLevel(s__ABILHeroineXCosmos_source[this], s__ABILHeroineXCosmos_ABILITY, 2)
            call SetUnitAbilityLevel(s__ABILHeroineXCosmos_source[this], 'A0FH', 4)
        else
            call sc__CMHeroineXCosmos_cast(s__ABILHeroineXCosmos_source[this] , sc__EVDamageManager_getFinalDamage(s__ABILHeroineXCosmos_source[this]) * 100.0 , GetSpellTargetUnit())
        endif
        set p=null
   return true
endfunction
