//library FXEnemy:


    function FXEnemy___damageTag takes integer p,string dmg,real x,real y returns nothing
        local texttag ttag= CreateTextTag()
        set x=x + GetRandomReal(- 128, 128)
        set y=y + GetRandomReal(- 128, 128)
        call SetTextTagPermanent(ttag, false)
        call SetTextTagFadepoint(ttag, 0.00)
        call SetTextTagLifespan(ttag, 0.50)
        call SetTextTagPos(ttag, x, y, GetRandomReal(0.00, 300.00))
        call SetTextTagText(ttag, s__pcs__staticgetindex(p) + dmg, 0.025)
        call SetTextTagVisibility(ttag, true)
        set ttag=null
    endfunction
    
    function FXEnemy___onEnemyDamaged takes nothing returns nothing
        local unit src
        local unit dst
        local boolean p_attacking
        local string tags
        if GetEventDamage() == 0 then
            return
        endif
        set src=GetEventDamageSource()
        set dst=GetTriggerUnit()
        if IsPlayerAlly(GetOwningPlayer(src), GetOwningPlayer(dst)) then
            set src=null
            set dst=null
            return
        endif
        if not DEAL_FLAG_ATTACKING then
            set p_attacking=DEAL_FLAG_ATTACKING
            set DEAL_FLAG_ATTACKING=true
            call UnitDamageTarget(dst, src, 0.00, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
            set DEAL_FLAG_ATTACKING=p_attacking
        endif
        if DEAL_FLAG_LOGIC then
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                set tags=I2S(R2I(GetEventDamage() * 10))
            else
                set tags=I2S(R2I(GetEventDamage()))
            endif
            if GetEventDamage() < 1 then
                set tags="|c00808080GUARD!|r"
            endif
            call FXEnemy___damageTag(GetPlayerId(GetOwningPlayer(src)) , tags , GetUnitX(dst) , GetUnitY(dst))
        endif
        set src=null
        set dst=null
    endfunction

        function s__enemy_add takes player p,unit u returns nothing
            call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u) * LEVEL_SPEED[LEVEL_CURRENT])
            call sc__UnitIndexer_append(u)
            call sc__EVUnitRemove_append(u)
            call sc__EVUnitDamageEvent_append(u , function FXEnemy___onEnemyDamaged)
            call sc__EVDebuffSlow_append(u)
            //전처리
            if GetPanalty(PANALTY_ENEMY_BOOST) then
                call UnitAddAbility(u, 'A03W')
            endif
            //종결
            call UnitRemoveAbility(u, 'Avul')
        endfunction
        function s__enemy_dealLogic takes unit src,unit dst,real dmg,weapontype wpt,integer id returns nothing
            local integer p_id= DEAL_FLAG_LOGIC_ID
            local boolean p_attacking= DEAL_FLAG_ATTACKING
            local boolean p_logic= DEAL_FLAG_LOGIC
            local real reqmp= 0
            set DEAL_FLAG_LOGIC_ID=id
            set DEAL_FLAG_ATTACKING=false
            set DEAL_FLAG_LOGIC=true
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                set dmg=dmg * 0.1
            endif
            if GetUnitAbilityLevel(dst, 'A0EX') == 0 then
                set reqmp=RMinBJ(dmg, GetUnitState(dst, UNIT_STATE_MANA))
            endif
            set dmg=RMaxBJ(0.01, dmg - reqmp)
            if dmg < 1.0 then
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl", dst, "origin"))
            endif
            call SetUnitState(dst, UNIT_STATE_MANA, GetUnitState(dst, UNIT_STATE_MANA) - reqmp)
            call UnitDamageTarget(src, dst, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, wpt)
            set DEAL_FLAG_LOGIC=p_logic
            set DEAL_FLAG_ATTACKING=p_attacking
            set DEAL_FLAG_LOGIC_ID=p_id
        endfunction
        function s__enemy_dealLogicEx takes unit src,unit dst,real dmg,boolean penetr,boolean addit,weapontype wpt,integer id returns nothing
            local integer p_id= DEAL_FLAG_LOGIC_ID
            local boolean p_attacking= DEAL_FLAG_ATTACKING
            local boolean p_logic= DEAL_FLAG_LOGIC
            local real reqmp= 0
            set DEAL_FLAG_LOGIC_ID=id
            set DEAL_FLAG_ATTACKING=false
            set DEAL_FLAG_LOGIC=true
            if IsUnitType(dst, UNIT_TYPE_GIANT) then
                set dmg=dmg * 0.1
            endif
            if GetUnitAbilityLevel(dst, 'A0EX') == 0 then
                set reqmp=RMinBJ(dmg, GetUnitState(dst, UNIT_STATE_MANA))
            endif
            if not penetr then
                set dmg=RMaxBJ(0.01, dmg - reqmp)
            endif
            if dmg < 1.0 then
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\SpellShieldAmulet\\SpellShieldCaster.mdl", dst, "origin"))
            endif
            if addit then
                call SetUnitState(dst, UNIT_STATE_MANA, GetUnitState(dst, UNIT_STATE_MANA) - reqmp)
            endif
            call UnitDamageTarget(src, dst, dmg, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, wpt)
            set DEAL_FLAG_LOGIC=p_logic
            set DEAL_FLAG_ATTACKING=p_attacking
            set DEAL_FLAG_LOGIC_ID=p_id
        endfunction
    

//library FXEnemy ends
//library FXRDmetadata:

    
    function AddPlayerMp takes player p,real amt returns nothing
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", GetUnitX(FXRD_TOWER[GetPlayerId(p)]), GetUnitY(FXRD_TOWER[GetPlayerId(p)])))
        call SetUnitState(FXRD_TOWER[GetPlayerId(p)], UNIT_STATE_MANA, GetUnitState(FXRD_TOWER[GetPlayerId(p)], UNIT_STATE_MANA) + amt)
    endfunction
    function CheckPlayerMp takes player p returns nothing
        if GetUnitState(FXRD_TOWER[GetPlayerId(p)], UNIT_STATE_MANA) >= GetUnitState(FXRD_TOWER[GetPlayerId(p)], UNIT_STATE_MAX_MANA) then
            call DisplayTextToPlayer(p, 0.00, 0.00, "|c00ff4040Mana is full|r")
        endif
    endfunction
    
    function CountInGameUser takes nothing returns integer
        local integer id= 0
        local integer c= 0
        loop
            exitwhen id == 4
            if USER_IS_PLAYING[id] then
                set c=c + 1
            endif
            set id=id + 1
        endloop
        return c
    endfunction
    
    function AddUserScore takes player p,integer i returns nothing
        local integer id= GetPlayerId(p)
        set FXRD_SCORE[id]=FXRD_SCORE[id] + i
        if FXRD_SCORE[id] > FXRD_SCORE_BEST then
            set FXRD_SCORE_BEST=FXRD_SCORE[id]
        endif
    endfunction
    
    function GetUserWave takes player p returns integer
        if FXRD_UNION_WAVE then
            return FXRD_WAVE[11]
        else
            return FXRD_WAVE[GetPlayerId(p)]
        endif
    endfunction
    
    function SetUserWave takes player p,integer s returns nothing
        local integer id= GetPlayerId(p)
        if FXRD_UNION_WAVE then
            set id=11
        endif
        set FXRD_WAVE[id]=s
        if FXRD_WAVE[id] > FXRD_WAVE_BEST then
            set FXRD_WAVE_BEST=FXRD_WAVE[id]
        endif
    endfunction
    
    function GetUserLife takes player p returns integer
        local integer id= GetPlayerId(p)
        local integer myMaxLife= FXRD_LIFE[id]
        local integer myLife= ENEMY_REMAIN[id + 4]
        if FXRD_UNION_LIFE then
            set myMaxLife=FXRD_LIFE[11]
            set myLife=ENEMY_REMAIN[11]
        endif
        return myMaxLife - myLife
    endfunction
    
    function GetUserLifeString takes player p returns string
        local integer id= GetPlayerId(p)
        local integer myMaxLife= FXRD_LIFE[id]
        local integer myLife= ENEMY_REMAIN[id + 4]
        local integer danger= 40
        if FXRD_UNION_LIFE then
            set myMaxLife=FXRD_LIFE[11]
            set myLife=ENEMY_REMAIN[11]
            set danger=danger * CountInGameUser()
        endif
        if GetPanalty(PANALTY_ENEMY_BONUS) then
            set danger=danger * 2
        endif
        set myLife=myMaxLife - myLife
        if myLife <= 0 then
            return "|c00FF0000" + I2S(myLife) + "|r"
        endif
        if myLife <= danger then
            return "|c00FFFF00" + I2S(myLife) + "|r"
        endif
        if myLife < myMaxLife then
            return I2S(myLife)
        endif
        return "|c0000FF00" + I2S(myLife) + "|r"
    endfunction
    

//library FXRDmetadata ends
//library FXTyphoon:

    
    
    
    function FXTyphoon___EnumSplash takes nothing returns nothing
        local integer self
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        set self=s__tick_getExpired()
        call sc__EVDebuffStunServant_apply(GetEnumUnit() , 1.50)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\LichMissile\\LichMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXKnockbackFromTo(GetEnumUnit() , FXTyphoon___UDUM[self] , 500 , 250 , 0.625)
    endfunction
    
    function FXTyphoon___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        local real ang
        local real x
        local real y
        if s__Distance_WBP(FXTyphoon___UDUM[self] , FXTyphoon___DSTX[self] , FXTyphoon___DSTY[self]) < FXTyphoon___ASPD[self] then
            set x=FXTyphoon___DSTX[self]
            set y=FXTyphoon___DSTY[self]
            set FXTyphoon___DSTX[self]=GetRandomReal(FXTyphoon___MINX[self], FXTyphoon___MAXX[self])
            set FXTyphoon___DSTY[self]=GetRandomReal(FXTyphoon___MINY[self], FXTyphoon___MAXY[self])
        else
            set ang=s__Angle_WBP(FXTyphoon___UDUM[self] , FXTyphoon___DSTX[self] , FXTyphoon___DSTY[self])
            set x=GetUnitX(FXTyphoon___UDUM[self]) + s__Polar_X(FXTyphoon___ASPD[self] , ang)
            set y=GetUnitY(FXTyphoon___UDUM[self]) + s__Polar_Y(FXTyphoon___ASPD[self] , ang)
        endif
        call SetUnitX(FXTyphoon___UDUM[self], x)
        call SetUnitY(FXTyphoon___UDUM[self], y)
        call SetUnitX(FXTyphoon___UWAR[self], x)
        call SetUnitY(FXTyphoon___UWAR[self], y)
        set FXTyphoon___ITER[self]=FXTyphoon___ITER[self] - 1
        if FXTyphoon___ITER[self] == 0 then
            set FXTyphoon___ITER[self]=10
            call s__splash_range(s__splash_ANY , null , x , y , 300 , function FXTyphoon___EnumSplash)
        endif
    endfunction
    
    function FXRD_FXTyphoonCreate takes real minX,real maxX,real minY,real maxY,real spd returns integer
        local integer self= s__tick_create(0)
        set FXTyphoon___OEXI[self]=true
        set FXTyphoon___ITER[self]=10
        set FXTyphoon___MINX[self]=minX
        set FXTyphoon___MAXX[self]=maxX
        set FXTyphoon___MINY[self]=minY
        set FXTyphoon___MAXY[self]=maxY
        set FXTyphoon___ASPD[self]=spd * 0.03125
        set FXTyphoon___DSTX[self]=GetRandomReal(minX, maxX)
        set FXTyphoon___DSTY[self]=GetRandomReal(minY, maxY)
        set FXTyphoon___UDUM[self]=CreateUnit(FX_PLAYER_DUMMY, FXTyphoon___ABMD, FXTyphoon___DSTX[self], FXTyphoon___DSTY[self], 270)
        set FXTyphoon___UWAR[self]=CreateUnit(FX_PLAYER_DUMMY, FXTyphoon___INMD, FXTyphoon___DSTX[self], FXTyphoon___DSTY[self], 270)
        call SetUnitVertexColor(FXTyphoon___UWAR[self], 255, 255, 255, 128)
        call s__tick_start(self,0.03125 , true , function FXTyphoon___OnExpire)
        return self
    endfunction
    
    function FXRD_FXTyphoonDestroy takes integer src returns nothing
        local integer self= src
        if not FXTyphoon___OEXI[self] then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Fatal Error: An attempt was made to destroy a non-existent Brain_Wind FXRD object.")
            return
        endif
        call KillUnit(FXTyphoon___UDUM[self])
        set FXTyphoon___UDUM[self]=null
        call KillUnit(FXTyphoon___UWAR[self])
        set FXTyphoon___UWAR[self]=null
        set FXTyphoon___OEXI[self]=false
        call s__tick_destroy(self)
    endfunction
    

//library FXTyphoon ends
//library FXFieldTooltips:
    function RefreshFieldTooltip takes nothing returns nothing
        local integer i= 0
        local string array goldMsg
        local string array lumberMsg
        local string array wispMsg
        local integer wav
        loop
            exitwhen i == 4
            set wav=GetUserWave(Player(i))
            set goldMsg[i]="Gold Draw|n" + I2S(50 + 2 * wav) + " ~ " + I2S(100 + 10 * wav) + "G can be obtained"
            set lumberMsg[i]="H-Spirit Draw|n1 ~ 5Pts can be obtained"
            if wav < 15 then
                set wispMsg[i]="Random [E] Servant Draw|n([E~D] Servants after 15W)"
            else
                set wispMsg[i]="Random [E~|c0040FF40D|r] Servant Draw"
            endif
            if GetPanalty(PANALTY_GACHA_ONLY_E) then
                set wispMsg[i]="Random [E] Servant Draw|n|c00ff4040Penalty: E-grade Only|r"
            endif
            set i=i + 1
        endloop
        call s__Texttag__set_text(FXFieldTooltips___STAG[0],goldMsg[GetPlayerId(GetLocalPlayer())])
        call s__Texttag__set_text(FXFieldTooltips___STAG[1],lumberMsg[GetPlayerId(GetLocalPlayer())])
        call s__Texttag__set_text(FXFieldTooltips___STAG[2],wispMsg[GetPlayerId(GetLocalPlayer())])
    endfunction
    function FXFieldTooltips___HeyWait takes nothing returns nothing
        local string goldMsg= "Gold Draw|n50 ~ 100G can be obtained"
        local string wispMsg= "Random [E] Servant Draw|n([E~D] Servants after 15W)"
        call s__tick_destroy(s__tick_getExpired())
        if GetPanalty(PANALTY_GACHA_ONLY_E) then
            set wispMsg="Random [E] Servant Draw|n|c00ff4040Penalty: E-grade Only|r"
        endif
        set FXFieldTooltips___STAG[0]=s__Texttag_Create(goldMsg , 0.02 , - 6784.00 , 0.00 , 120.00)
        call s__Texttag_setColor(FXFieldTooltips___STAG[0],255 , 255 , 0)
        set FXFieldTooltips___STAG[1]=s__Texttag_Create("H-Spirit Draw|n1 ~ 5Pts can be obtained" , 0.02 , - 5760.00 , 0.00 , 120.00)
        call s__Texttag_setColor(FXFieldTooltips___STAG[1],64 , 64 , 255)
        set FXFieldTooltips___STAG[2]=s__Texttag_Create(wispMsg , 0.02 , - 6272.00 , 512.00 , 120.00)
        set FXFieldTooltips___STAG[3]=s__Texttag_Create("Random Servant Draw|n   E-grade Only" , 0.02 , - 6272.00 , - 512.00 , 120.00)
    endfunction
    function FXFieldTooltips___onGameInit takes nothing returns nothing
        call s__tick_start(s__tick_create(0),0.50 , false , function FXFieldTooltips___HeyWait)
    endfunction
    function FXFieldTooltips___main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXFieldTooltips___onGameInit)
    endfunction

//library FXFieldTooltips ends
//library FXLife:
    function FXLife___main takes nothing returns nothing
        set FXLife___warnTick=s__tick_create(0)
    endfunction
    function FXLife___onLifeWarn takes nothing returns nothing
        local integer i= 0
        local real x
        local real y
        local integer lif
        local integer need= 0
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] and USER_USE_WARNPING[i] then
                set lif=GetUserLife(Player(i))
                if lif <= 0 then
                    set need=need + 1
                    set x=GetPlayerStartLocationX(Player(i))
                    set y=GetPlayerStartLocationY(Player(i))
                    if GetLocalPlayer() == Player(i) then
                        call StopSound(gg_snd_WarnPing, false, false)
                        call StartSound(gg_snd_WarnPing)
                        call PingMinimapEx(x, y, 2.00, 255, 0, 0, false)
                        call PingMinimapEx(x, y, 2.00, 255, 0, 0, true)
                    endif
                endif
            endif
            set i=i + 1
        endloop
        if need > 0 then
            call s__tick_start(FXLife___warnTick,0.20 , false , function FXLife___onLifeWarn)
            return
        endif
        set FXLife___warnerRunning=false
    endfunction
    function FXLife___RefreshLifeWarn takes nothing returns nothing
        local integer i= 0
        local integer lif
        local integer warn= 40
        if FXRD_UNION_LIFE then
            set warn=warn * CountInGameUser()
        endif
        if GetPanalty(PANALTY_ENEMY_BONUS) then
            set warn=warn * 2
        endif
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                set lif=GetUserLife(Player(i))
                if lif > warn then
                    call SetPlayerState(Player(i), PLAYER_STATE_RESOURCE_FOOD_USED, 100)
                elseif lif > 0 then
                    call SetPlayerState(Player(i), PLAYER_STATE_RESOURCE_FOOD_USED, 20)
                else
                    call SetPlayerState(Player(i), PLAYER_STATE_RESOURCE_FOOD_USED, 0)
                    if not FXLife___warnerRunning then
                        set FXLife___warnerRunning=true
                        call s__tick_start(FXLife___warnTick,0.20 , false , function FXLife___onLifeWarn)
                    endif
                endif
            endif
            set i=i + 1
        endloop
    endfunction
    function AddUserLife takes player p,integer i returns nothing
        local integer id= GetPlayerId(p)
        set FXRD_LIFE[id]=FXRD_LIFE[id] + i
        if FXRD_UNION_LIFE then
            set FXRD_LIFE[11]=FXRD_LIFE[11] + i
        endif
        call sc__statusBoard_refreshLife()
        call FXLife___RefreshLifeWarn()
    endfunction
    function AddEnemyRemain takes player p,integer i returns nothing
        local integer id= GetPlayerId(p)
        set ENEMY_REMAIN[id]=ENEMY_REMAIN[id] + i
        call sc__statusBoard_refreshLife()
        call FXLife___RefreshLifeWarn()
    endfunction

//library FXLife ends
//library FXStatusBoard:
        function s__statusBoard_init takes nothing returns nothing
            set s__statusBoard_BOARD=s__board_create()
            call s__board__set_title(s__statusBoard_BOARD,"Game Dashboard")
            call s__board__set_width(s__statusBoard_BOARD,4)
            call s__board__set_height(s__statusBoard_BOARD,6)
            call s__board_setStyle(s__statusBoard_BOARD,true , false)
            call sc__statusBoard_layout()
            call sc__statusBoard_cell()
        endfunction
        function s__statusBoard_cell takes nothing returns nothing
            local integer i= 0
            loop
                exitwhen i == 4
                call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),0.12)
                call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),i + 1),0.03)
                call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),i + 1),s__statusBoard_SIZE_KILL)
                call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,3),i + 1),0.10)
                set i=i + 1
            endloop
        endfunction
        function s__statusBoard_layout takes nothing returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),0),"|c00ffcc00Player Name|r")
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),0),0.12)
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),0),"|c00ffcc00Lives|r")
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),0),0.03)
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),0),"|c00ffcc00Kills|r")
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),0),s__statusBoard_SIZE_KILL)
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,3),0),"|c00ffcc00Faction/Resources|r")
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,3),0),0.10)
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),5),0.08)
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),5),0.15)
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),5),0.01)
            call s__boardItem__set_scale(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,3),5),0.01)
        endfunction
        //===================================================
        function s__statusBoard__set_time takes string s returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),5),s)
        endfunction
        function s__statusBoard__set_difficulty takes string s returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),5),s)
        endfunction
        function s__statusBoard__get_super takes nothing returns integer
            return s__statusBoard_BOARD
        endfunction
        function s__statusBoard_setName takes integer i,string s returns nothing
            set s__statusBoard_NAME[i]=s
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),s)
        endfunction
        function s__statusBoard_getName takes integer i returns string
            return s__statusBoard_NAME[i]
        endfunction
        function s__statusBoard_setPrefix takes integer i,string s returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),s + s__statusBoard_NAME[i])
        endfunction
        function s__statusBoard_setIcon takes integer i,string s returns nothing
            call s__boardItem_setStyle(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),true , true)
            call s__boardItem__set_icon(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),s)
        endfunction
        function s__statusBoard_setLife takes integer i,string s returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,1),i + 1),s)
        endfunction
        function s__statusBoard_setStat takes integer i,string s returns nothing
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,3),i + 1),s)
        endfunction
        function s__statusBoard_show takes boolean flag returns nothing
            call s__board__set_visible(s__statusBoard_BOARD,flag)
        endfunction
        function s__statusBoard_removePlayer takes player p returns nothing
            local integer id= GetPlayerId(p)
            call s__statusBoard_setName(id , "|c00808080 - Defeat -|r")
            call s__statusBoard_setIcon(id , "ReplaceableTextures\\CommandButtons\\BTNCancel.blp")
            call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),id + 1),"")
            call s__statusBoard_setLife(id , "")
            call s__statusBoard_setStat(id , "")
        endfunction
            
        function s__statusBoard_finishWave takes player p returns nothing
            local integer id= GetPlayerId(p)
            local string array prefix
            set prefix[1]="|c0040FF40[Ace]|r"
            set prefix[2]="[2nd]"
            set prefix[3]="[3rd]"
            set prefix[4]="[4th]"
            if USER_IS_PLAYING[id] then
                set FXRD_CLEARED[id]=true
                call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),id + 1),prefix[FXRD_CLEAR_RANK] + s__statusBoard_NAME[id])
                set FXRD_CLEAR_RANK=FXRD_CLEAR_RANK + 1
            endif
        endfunction
        function s__statusBoard_refreshWave takes nothing returns nothing
            local integer i= 0
            local integer wav
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] and not s__FXGameResult_Resulted[(i)] then
                    set wav=GetUserWave(Player(i))
                    if wav == FXRD_WAVE_BEST then
                        call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),"|c0040FF40[" + I2S(wav) + "R]|r" + s__statusBoard_NAME[i])
                    else
                        call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,0),i + 1),"[" + I2S(wav) + "R]" + s__statusBoard_NAME[i])
                    endif
                endif
                set i=i + 1
            endloop
        endfunction
        function s__statusBoard_refreshKill takes nothing returns nothing
            local integer i= 0
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    if FXRD_SCORE[i] == FXRD_SCORE_BEST then
                        call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),i + 1),"|c0040FF40" + I2S(FXRD_SCORE[i]) + "|r")
                    else
                        call s__boardItem__set_value(s__boardY__getindex(s__board__getindex(s__statusBoard_BOARD,2),i + 1),I2S(FXRD_SCORE[i]))
                    endif
                endif
                set i=i + 1
            endloop
        endfunction
        function s__statusBoard_refreshLife takes nothing returns nothing
            local integer i= 0
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    call s__statusBoard_setLife(i , GetUserLifeString(Player(i)))
                endif
                set i=i + 1
            endloop
        endfunction
        function s__statusBoard_refreshStat takes nothing returns nothing
            local integer i= 0
            local integer myFax
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    set myFax=FXGetPlayerCurrentFaction(Player(i))
                    if FXIsPlayerCurrentFactionMastered(Player(i)) then
                        call s__statusBoard_setStat(i , FXGetFactionMasterName(myFax) + " (|c00FFFF00" + I2S(GetPlayerGold(Player(i))) + "G|r/|c004040FF" + I2S(GetPlayerLumber(Player(i))) + "S|r)")
                    else
                        call s__statusBoard_setStat(i , FXGetFactionName(myFax) + " (|c00FFFF00" + I2S(GetPlayerGold(Player(i))) + "G|r/|c004040FF" + I2S(GetPlayerLumber(Player(i))) + "S|r)")
                    endif
                endif
                set i=i + 1
            endloop
        endfunction
        function s__statusBoard_refreshNameIcon takes nothing returns nothing
            local integer i= 0
            local integer myFax
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    set myFax=FXGetPlayerCurrentFaction(Player(i))
                    call s__statusBoard_setName(i , s__pcs_get(Player(i)))
                    if FXIsPlayerCurrentFactionMastered(Player(i)) then
                        call s__statusBoard_setIcon(i , FXGetFactionMasterIcon(myFax))
                    else
                        call s__statusBoard_setIcon(i , FXGetFactionIcon(myFax))
                    endif
                endif
                set i=i + 1
            endloop
        endfunction
        
        function s__statusBoard_refreshAll takes nothing returns nothing
            call s__statusBoard_refreshNameIcon()
            call s__statusBoard_refreshStat()
            call s__statusBoard_refreshLife()
            call s__statusBoard_refreshKill()
        endfunction
    

//library FXStatusBoard ends
//library FXClanupUser:
    
    
    function FXClanupUser___onEnum takes nothing returns nothing
            call KillUnit(GetEnumUnit())
            call ShowUnit(GetEnumUnit(), false)
    endfunction
        
    function FXClanupUser___sweep takes player p returns nothing
            call GroupEnumUnitsOfPlayer(FXClanupUser___G, p, null)
            call ForGroup(FXClanupUser___G, function FXClanupUser___onEnum)
            call GroupClear(FXClanupUser___G)
    endfunction

    function FXClanupUser___TestAllCleanup takes nothing returns nothing
        local integer i= 0
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                return
            endif
            set i=i + 1
        endloop
        // 게임이 종료되었음을 명시
        set GAME_IS_PLAYING=false
        //공용 소유의 유닛 제거
        call FXClanupUser___sweep(Player(11))
        //작업 마침 - 소실 메시지 출력
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 3600.00, "|c00FF0000Annihilation. No one is left in FERD!|r")
    endfunction

    function CleanupUser takes player p returns nothing
        local integer id= GetPlayerId(p)
        if not USER_IS_PLAYING[id] then
            return
        endif
        //더 이상 게임에 영향을 끼치지 못하게 됨을 명시
        set USER_IS_PLAYING[id]=false
        //자기 소유의 모든 유닛 제거
        call FXClanupUser___sweep(p)
        //자기 소유(+4)의 모든 유닛 제거
        call FXClanupUser___sweep(Player(id + 4))
        //자원 제거
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, 0)
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER, 0)
        //자기 라이프 소멸
        call AddUserLife(p , - FXRD_LIFE[id])
        //현황판 - 플레이어 내림
        call s__statusBoard_removePlayer(p)
        //작업 마침 - 소실 메시지 출력
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 30.00, s__pcs__staticgetindex(id) + GetPlayerName(p) + "|r has been lost in |c00D040D0imaginary space|r!")
        //패배 처리
        call RRRequestPlayer(REQUEST_GAME_PLAYER_DEFEAT , p)
        
        //남은 플레이어가 없으면 공용 모두 제거
        call FXClanupUser___TestAllCleanup()
    endfunction

//library FXClanupUser ends
//library FXRound:
    //이 객체가 Wave를 굴리면서 모든 문제가 시작됩니다.
    
    function FXRound___giveWispBounty takes player p returns nothing
        local integer wispBounty= 3
        local integer i= 0
        if FXRD_UNION_WAVE then
            if GetPanalty(PANALTY_LESS_WISP) then
                if p == Player(11) then
                    call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c00FF4040『We're one short』 activated!|r")
                else
                    call DisplayTextToPlayer(p, 0, 0, "|c00FF4040『We're one short』 activated!|r")
                endif
                set wispBounty=wispBounty - 1
            endif
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    call CreateWisp(Player(i) , wispBounty)
                endif
                set i=i + 1
            endloop
        else
            call CreateWisp(p , wispBounty)
        endif
    endfunction
    
    function FXRound___runWave takes player p,player ep returns nothing
        local integer i= 0
        local integer wav= GetUserWave(p)
        local string wavePrefix= "Wave " + I2S(wav)
        if wav == LEVEL_WAVE[LEVEL_CURRENT] - 1 then
            set wavePrefix="|c00B040B0Final Wave|r"
        endif
        if FXRD_UNION_WAVE then
            loop
                exitwhen i == 4
                if USER_IS_PLAYING[i] then
                    if not FXRD_UNION_LINE then
                        set ep=Player(i + 4)
                    endif
                    call sc__roundWave_create(Player(i) , ep , Player(11) , wav , wavePrefix)
                endif
                set i=i + 1
            endloop
        else
            call sc__roundWave_create(p , ep , ep , wav , wavePrefix + " : " + s__pcs__staticgetindex(GetPlayerId(p)) + "PLAYER " + I2S(GetPlayerId(p)))
        endif
    endfunction
    
    function FXRound___onRoundStartSpeedrun takes nothing returns nothing
        local integer t= s__tick_getExpired()
        local integer myId= s__tick_data[t]
        local integer enemyId= myId + 4
        local integer enemyHp
        local integer rnd
        if not USER_IS_PLAYING[myId] or FXRD_WAVE[myId] == LEVEL_WAVE[LEVEL_CURRENT] then
            //타이머 완전파괴!
            call s__tick_destroy(t)
            return
        endif
        if ENEMY_WAVE_STACK[enemyId] > 0 then
            return
        endif
        set rnd=GetUserWave(Player(myId)) + 1
        call SetUserWave(Player(myId) , rnd)
        if FXRD_WAVE[myId] < LEVEL_WAVE[LEVEL_CURRENT] then
            call FXRound___runWave(Player(myId) , Player(enemyId))
            set enemyHp=R2I(R2Rhp(rnd) * LEVEL_HP[LEVEL_CURRENT])
            call DisplayTimedTextToPlayer(Player(myId), 0, 0, 20, "|c00FF4040Wave " + I2S(rnd) + " : " + GetObjectName(FXRD_ROUND_ID[rnd]) + " (HP " + I2S(enemyHp) + ")|r")
        endif
        call s__eventCustom_evaluate(EVENT_GAME_ROUND , Player(myId) , null , null , 0)
        call FXRound___giveWispBounty(Player(myId))
        //툴팁 새로고침
        call RefreshFieldTooltip()
        call s__statusBoard_refreshWave()
    endfunction
    function FXRound___onRoundStart takes nothing returns nothing
        local integer t= s__tick_getExpired()
        local integer myId= s__tick_data[t]
        local integer enemyId= 11
        local integer rnd
        if not GAME_IS_PLAYING or FXRD_WAVE[myId] == LEVEL_WAVE[LEVEL_CURRENT] then
            //타이머 완전파괴!
            call s__tick_destroy(t)
            return
        endif
        if ENEMY_WAVE_STACK[enemyId] > 0 then
            return
        endif
        set rnd=GetUserWave(Player(myId)) + 1
        call SetUserWave(Player(myId) , rnd)
        if FXRD_WAVE[myId] < LEVEL_WAVE[LEVEL_CURRENT] then
            call FXRound___runWave(Player(myId) , Player(enemyId))
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 20, "|c00FF4040Wave " + I2S(rnd) + " : " + GetObjectName(FXRD_ROUND_ID[rnd]) + " (HP " + I2S(R2I(R2Rhp(rnd) * LEVEL_HP[LEVEL_CURRENT])) + ")|r")
        endif
        call s__eventCustom_evaluate(EVENT_GAME_ROUND , Player(myId) , null , null , 0)
        call FXRound___giveWispBounty(Player(myId))
        //툴팁 새로고침
        call RefreshFieldTooltip()
    endfunction
    
    function FXRound___initRoundStart takes nothing returns nothing
        call s__tickUI_destroy(FXRound___ROUND_DELAYER_UI)
        call s__tick_destroy(FXRound___ROUND_DELAYER)
        if FXRD_UNION_WAVE then
            set FXRound___ROUND[11]=s__tick_create(11)
            call s__tick_start(FXRound___ROUND[11],1.00 , true , function FXRound___onRoundStart)
        else
            set FXRound___ROUND[0]=s__tick_create(0)
            set FXRound___ROUND[1]=s__tick_create(1)
            set FXRound___ROUND[2]=s__tick_create(2)
            set FXRound___ROUND[3]=s__tick_create(3)
            call s__tick_start(FXRound___ROUND[0],1.00 , true , function FXRound___onRoundStartSpeedrun)
            call s__tick_start(FXRound___ROUND[1],1.00 , true , function FXRound___onRoundStartSpeedrun)
            call s__tick_start(FXRound___ROUND[2],1.00 , true , function FXRound___onRoundStartSpeedrun)
            call s__tick_start(FXRound___ROUND[3],1.00 , true , function FXRound___onRoundStartSpeedrun)
        endif
    endfunction
    
    function StartGameRound takes nothing returns nothing
        set FXRound___ROUND_DELAYER=s__tick_create(0)
        call s__tick_start(FXRound___ROUND_DELAYER,20 , false , function FXRound___initRoundStart)
        set FXRound___ROUND_DELAYER_UI=s__tickUI_create(FXRound___ROUND_DELAYER)
        call s__tickUI__set_title(FXRound___ROUND_DELAYER_UI,"Until the start of the game...")
        call s__tickUI__set_visible(FXRound___ROUND_DELAYER_UI,true)
    endfunction

//library FXRound ends
//library FXWave:
    
    
    function FXWave___main takes nothing returns nothing
        set FXWave___spawnX[0]=- 960
        set FXWave___spawnY[0]=960
        set FXWave___spawnX[1]=- 960
        set FXWave___spawnY[1]=- 960
        set FXWave___spawnX[2]=960
        set FXWave___spawnY[2]=- 960
        set FXWave___spawnX[3]=960
        set FXWave___spawnY[3]=960
        
        set FXWave___RNUID[0]='n000'
        set FXWave___MOVID[0]=0
        
        set FXWave___RNUID[1]='n00E'
        set FXWave___RNUID[2]='n00F'
        set FXWave___RNUID[3]='n00G'
        set FXWave___RNUID[4]='n00H'
        set FXWave___RNUID[5]='n00I'
        set FXWave___RNUID[6]='n00J'
        set FXWave___RNUID[7]='n00K'
        set FXWave___RNUID[8]='n00L'
        set FXWave___RNUID[9]='n00M'
        set FXWave___RNUID[10]='n00N'
        set FXWave___RNUID[11]='n00O'
        set FXWave___RNUID[12]='n00P'
        set FXWave___MOVID[1]=8
        set FXWave___MOVID[2]=0
        set FXWave___MOVID[3]=6
        set FXWave___MOVID[4]=4
        set FXWave___MOVID[5]=2
        set FXWave___MOVID[6]=1
        set FXWave___MOVID[7]=2
        set FXWave___MOVID[8]=6
        set FXWave___MOVID[9]=2
        set FXWave___MOVID[10]=2
        set FXWave___MOVID[11]=0
        set FXWave___MOVID[12]=7
    endfunction

        //
        //
        //====================================================================
        function s__roundWave_create takes player p,player e,player w,integer r,string s returns integer
            local integer this= s__roundWave__allocate()
            local real spawnFullTime= 2.00 / 3.00
            local integer uid
            set ENEMY_WAVE_STACK[GetPlayerId(w)]=ENEMY_WAVE_STACK[GetPlayerId(w)] + 1
            set ENEMY_WAVE_WORKING[GetPlayerId(w)]=ENEMY_WAVE_WORKING[GetPlayerId(w)] + 1
            set s__roundWave_imWorking[this]=true
            //
            if FXRD_ROUND_ID[r] == 0 then
                if ModuloInteger(r, 10) == 0 then
                    set FXRD_ROUND_ID[r]=FXWave___RNUID[0]
                    set FXRD_ROUND_MOV[r]=FXWave___MOVID[0]
                else
                    set uid=GetRandomInt(1, FXWave___MAX_UNIT_TYPE)
                    set FXRD_ROUND_ID[r]=FXWave___RNUID[uid]
                    set FXRD_ROUND_MOV[r]=FXWave___MOVID[uid]
                endif
            endif
            if MODE_CURRENT == MODE_SPEEDRUN then
                set spawnFullTime=0.25
            endif
            //
            set s__roundWave_myOwner[this]=p
            set s__roundWave_myEnemy[this]=e
            set s__roundWave_myWaveStack[this]=w
            set s__roundWave_myRound[this]=r
            set s__roundWave_myWaveTick[this]=s__tick_create(this)
            call s__tick_start(s__roundWave_myWaveTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] , false , function sc__roundWave_onRoundExpireA)
            set s__roundWave_myWaveTickUI[this]=s__tickUI_create(s__roundWave_myWaveTick[this])
            call s__tickUI__set_title(s__roundWave_myWaveTickUI[this],s)
            call s__tickUI__set_visible(s__roundWave_myWaveTickUI[this],GetLocalPlayer() == p)
            set s__roundWave_mySpawnTick[this]=s__tick_create(this)
            set s__roundWave_mySpawnCount[this]=0
            if GetPanalty(PANALTY_ENEMY_BONUS) then
                set s__roundWave_mySpawnCountMax[this]=80
                call s__tick_start(s__roundWave_mySpawnTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] * spawnFullTime / s__roundWave_mySpawnCountMax[this] , true , function sc__roundWave_onSpawnExpire)
            else
                set s__roundWave_mySpawnCountMax[this]=40
                call s__tick_start(s__roundWave_mySpawnTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] * spawnFullTime / s__roundWave_mySpawnCountMax[this] , true , function sc__roundWave_onSpawnExpire)
            endif
            return this
        endfunction
        //====================================================================
        function s__roundWave_destroy takes integer this returns nothing
            set ENEMY_WAVE_STACK[GetPlayerId(s__roundWave_myWaveStack[this])]=ENEMY_WAVE_STACK[GetPlayerId(s__roundWave_myWaveStack[this])] - 1
            call s__tickUI_destroy(s__roundWave_myWaveTickUI[this])
            call s__tick_destroy(s__roundWave_myWaveTick[this])
            call s__tick_destroy(s__roundWave_mySpawnTick[this])
            set s__roundWave_myOwner[this]=null
            set s__roundWave_myEnemy[this]=null
            set s__roundWave_myWaveStack[this]=null
            //
            call s__roundWave_deallocate(this)
        endfunction
        //====================================================================
        
        function s__roundWave_onRoundExpireA takes nothing returns nothing
            local integer this= s__tick_data[s__tick_getExpired()]
            //라이프 체크
            if GetUserLife(s__roundWave_myOwner[this]) <= 0 then
                call CleanupUser(s__roundWave_myOwner[this])
            endif
            if s__roundWave_imWorking[this] then
                set s__roundWave_imWorking[this]=false
                set ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])]=ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])] - 1
            endif
            //해제
            call s__roundWave_destroy(this)
        endfunction
        function s__roundWave_onSkipCheck takes nothing returns nothing
            local integer this= s__tick_data[s__tick_getExpired()]
            local integer id= GetPlayerId(s__roundWave_myOwner[this])
            if ENEMY_REMAIN[GetPlayerId(s__roundWave_myEnemy[this])] > 0 then
                return
            endif
            if s__roundWave_imWorking[this] then
                set s__roundWave_imWorking[this]=false
                set ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])]=ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])] - 1
                call s__tickUI__set_title(s__roundWave_myWaveTickUI[this],"Pending alliance...")
            endif
            if ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])] == 0 then
                call DisplayTimedTextToPlayer(s__roundWave_myOwner[this], 0.00, 0.00, 10, "|c0000ff00Skip Time Remaining|r")
                call s__tick_pause(s__roundWave_mySpawnTick[this])
                call s__tick_start(s__roundWave_myWaveTick[this],0.1 , false , function s__roundWave_onRoundExpireA)
            endif
        endfunction
        function s__roundWave_onSpawnExpire takes nothing returns nothing
            local integer this= s__tick_data[s__tick_getExpired()]
            local integer id= GetPlayerId(s__roundWave_myOwner[this])
            local real x= GetPlayerStartLocationX(s__roundWave_myOwner[this])
            local real y= GetPlayerStartLocationY(s__roundWave_myOwner[this])
            local integer hp= R2Rhp(s__roundWave_myRound[this])
            local integer mp= R2Rmp(s__roundWave_myRound[this])
            local integer bounty= 0
            local unit u
            if not USER_IS_PLAYING[id] then
                return
            endif
            //공통 -사살 보상금 반영
            if ModuloInteger(s__roundWave_myRound[this], 10) == 0 then
                set bounty=IMaxBJ(1, s__roundWave_myRound[this] * 2)
            else
                set bounty=IMaxBJ(1, s__roundWave_myRound[this] / 2)
            endif
            //보상금 반영 끝
            if FXRD_UNION_LINE then
                set u=CreateUnit(s__roundWave_myEnemy[this], FXRD_ROUND_ID[s__roundWave_myRound[this]], x + FXWave___spawnX[id], y + FXWave___spawnY[id], 270)
            else
                set u=CreateUnit(s__roundWave_myEnemy[this], FXRD_ROUND_ID[s__roundWave_myRound[this]], x - 960, y + 960, 270)
            endif
            //패널티 - 공세의 첫 번째 유닛 강화(40배)
            if s__roundWave_mySpawnCount[this] == 0 and GetPanalty(PANALTY_POWERFUL_LEADER) then
                call UnitAddAbility(u, 'A0EW')
                set hp=hp * 20
                set mp=mp * 20
                set bounty=bounty * 10
            else
                //패널티 - 적이 두배면 체력이 절반, 보상금도 절반
                if GetPanalty(PANALTY_ENEMY_BONUS) then
                    set hp=hp / 2
                    set mp=mp / 2
                    set bounty=IMaxBJ(1, bounty / 2)
                endif
            endif
            //패널티 적용 끝
            call s__lifeMod_apply(u , R2I(hp * LEVEL_HP[LEVEL_CURRENT]))
            call s__manaMod_apply(u , R2I(mp * LEVEL_HP[LEVEL_CURRENT]))
            call AddEnemyRemain(s__roundWave_myEnemy[this] , 1)
            call s__enemy_add(s__roundWave_myEnemy[this] , u)
            if GetPanalty(PANALTY_ENEMY_HEAL) then
                call UnitAddAbility(u, 'A04J')
                call sc__EVStateRegenerate_append(u , GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.005 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
            else
                call sc__EVStateRegenerate_append(u , 0.00 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
            endif
            call sc__EVDeathBounty_append(u , bounty , s__roundWave_myOwner[this])
            if FXRD_UNION_LINE then
                call sc__EVSquareMovement_append(u , ROUTE_LANE_TEAM[id] , FXRD_ROUND_MOV[s__roundWave_myRound[this]])
            else
                call sc__EVSquareMovement_append(u , ROUTE_LANE[id] , FXRD_ROUND_MOV[s__roundWave_myRound[this]])
            endif
            set u=null
            set s__roundWave_mySpawnCount[this]=s__roundWave_mySpawnCount[this] + 1
            if s__roundWave_mySpawnCount[this] == s__roundWave_mySpawnCountMax[this] then
                call s__tick_start(s__roundWave_mySpawnTick[this],1.0 , true , function s__roundWave_onSkipCheck)
            endif
        endfunction

