function sa__EVTeleportControl_onSmart takes nothing returns boolean

        local integer id
        local integer lv
        local real x
        local real y
        local real px
        local real py
        if GetIssuedOrderId() != OrderId("smart") then
set f__result_boolean= false
return true
        endif
        if GetOrderTarget() != null then
            set x=GetWidgetX(GetOrderTarget())
            set y=GetWidgetY(GetOrderTarget())
        else
            set x=GetOrderPointX()
            set y=GetOrderPointY()
        endif
        set id=GetPlayerId(GetOwningPlayer(GetOrderedUnit()))
        if IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            set lv=GetUnitLevel(GetOrderedUnit())
            if IsUnitType(GetOrderedUnit(), UNIT_TYPE_HERO) then
                set lv=8
            endif
            if IsPointInRegion(ZONE_TELEPORTABLE[id], x, y) then
set f__result_boolean= false
return true
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 0 then
set f__result_boolean= false
return true
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 1 then
                if lv > 3 then
set f__result_boolean= false
return true
                endif
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 2 then
                if lv > 5 then
set f__result_boolean= false
return true
                endif
            endif
            call IssueImmediateOrder(GetOrderedUnit(), "neutralinteract")
set f__result_boolean= false
return true
        endif
        if not IsPointInRegion(ZONE_TELEPORTABLE[id], x, y) then
set f__result_boolean= false
return true
        endif
        set px=GetUnitX(GetOrderedUnit())
        set py=GetUnitY(GetOrderedUnit())
        if IsPointInRegion(ZONE_TELEPORTABLE1[0], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[0], px, py) then
set f__result_boolean= false
return true
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[1], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[1], px, py) then
set f__result_boolean= false
return true
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[2], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[2], px, py) then
set f__result_boolean= false
return true
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[3], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[3], px, py) then
set f__result_boolean= false
return true
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE2[id], x, y) and IsPointInRegion(ZONE_TELEPORTABLE2[id], px, py) then
set f__result_boolean= false
return true
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE3[id], x, y) and IsPointInRegion(ZONE_TELEPORTABLE3[id], px, py) then
set f__result_boolean= false
return true
        endif
        call IssuePointOrder(GetOrderedUnit(), "mount", x, y)
set f__result_boolean= false
   return true
endfunction
function sa__EVTeleportControl_onCast takes nothing returns boolean

        local integer id
        local hashtable idTab
        local integer idKey
        local integer this
        if GetObjectName(GetSpellAbilityId()) != "[Teleport]" then
            if GetObjectName(GetSpellAbilityId()) != "[Sale]" then
set f__result_boolean= false
return true
            endif
            set id=GetUnitUserData(GetTriggerUnit())
            set idTab=GetCustomDataTable(id)
            set idKey=GetCustomDataKey(id)
            set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
            set s__EVTeleportControl_FX[this]=AddSpecialEffectTarget("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetTriggerUnit(), "overhead")
            set s__EVTeleportControl_DST[this]=AddSpecialEffectTarget("FX\\ProgressSellBar\\Bar.mdl", GetTriggerUnit(), "overhead")
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())))
            set idTab=null
set f__result_boolean= false
return true
        endif
        set id=GetUnitUserData(GetTriggerUnit())
        set idTab=GetCustomDataTable(id)
        set idKey=GetCustomDataKey(id)
        set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        set s__EVTeleportControl_FX[this]=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
        set s__EVTeleportControl_DST[this]=AddSpecialEffect("Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl", GetSpellTargetX(), GetSpellTargetY())
        set idTab=null
set f__result_boolean= false
   return true
endfunction
