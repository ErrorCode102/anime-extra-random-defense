        call FXSetFactionIcon(FXFACTIONBB__FACTION_SELF , FXFACTIONBB__ICON)
        call FXSetFactionMasterName(FXFACTIONBB__FACTION_SELF , FXFACTIONBB__MASTER_NAME)
        call FXSetFactionMasterIcon(FXFACTIONBB__FACTION_SELF , FXFACTIONBB__MASTER_ICON)
    endfunction
