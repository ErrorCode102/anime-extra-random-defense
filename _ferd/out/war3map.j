        set s__EVUnitDamageEvent_TA[this]=null
        call DestroyTrigger(s__EVUnitDamageEvent_T[this])
        set s__EVUnitDamageEvent_T[this]=null
        call TriggerUnbindAction(s__EVUnitDamageEvent_ONRM[this])
        set s__EVUnitDamageEvent_ONRM[this]=null
        //종결
        call s__EVUnitDamageEvent_destroy(this)
    endfunction
    
