// scope TrigSvCountUnderD begins
    
    function TrigSvCountUnderD__RegisterCommandTrigger takes code c returns nothing
        local integer i= 0
        call TriggerAddAction(TrigSvCountUnderD__COMMAND, c)
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerChatEvent(TrigSvCountUnderD__COMMAND, Player(i), "-count", true)
            call TriggerRegisterPlayerChatEvent(TrigSvCountUnderD__COMMAND, Player(i), "-vo", true)
            call TriggerRegisterPlayerChatEvent(TrigSvCountUnderD__COMMAND, Player(i), "-ㅍ", true)
            call TriggerRegisterPlayerChatEvent(TrigSvCountUnderD__COMMAND, Player(i), "-v", true)
            set i=i + 1
        endloop
    endfunction
    
    function TrigSvCountUnderD__PrintUnit takes player p,integer id returns nothing
        local integer count= GetPlayerUnitTypeCount(p, id)
        if count < 1 then
            return
        endif
        call DisplayTextToPlayer(p, 0.0, 0.0, "  - " + I2S(count) + " " + s__trimmer_get(id) + "|r")
    endfunction
    
    function TrigSvCountUnderD__doCount takes player p returns nothing
        local integer id= GetPlayerId(p)
        
        call DisplayTextToPlayer(p, 0.0, 0.0, "|c00B0B0B0[E] Servants|r")
        
        call TrigSvCountUnderD__PrintUnit(p , SV_ATALANTA + OFF_E)
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_GAWAIN + OFF_E)
        call TrigSvCountUnderD__PrintUnit(p , SV_VLAD + OFF_E)
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_SAKURA + OFF_E)
        call TrigSvCountUnderD__PrintUnit(p , SV_KIREI + OFF_E)
        
        call DisplayTextToPlayer(p, 0.0, 0.0, "|c0040FF40[D] Servants|r")
        
        call TrigSvCountUnderD__PrintUnit(p , SV_ATALANTA + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_GAWAIN + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , SV_VLAD + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_SAKURA + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , SV_KIREI + OFF_D)
        
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_RHYME + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , FX_SERVANT_MEDUSA + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , SV_LEESM + OFF_D)
        call TrigSvCountUnderD__PrintUnit(p , SV_LUBU + OFF_D)
        
        call DisplayTextToPlayer(p, 0.0, 0.0, " ")
    endfunction
    
    function TrigSvCountUnderD__OnChatCommand takes nothing returns nothing
        call TrigSvCountUnderD__doCount(GetTriggerPlayer())
    endfunction
    
    function TrigSvCountUnderD__OnMapLoad takes nothing returns nothing
        call TrigSvCountUnderD__RegisterCommandTrigger(function TrigSvCountUnderD__OnChatCommand)
    endfunction
