//library AddonReverse:
        function s__JohabReverse_disAssemble takes player p,integer id,real x,real y returns nothing
            local integer i= 0
            local integer uid
            local string s= "ends"
            local string ts
            local unit u
            loop
                set ts=GetAbilityEffectById(id, EFFECT_TYPE_CASTER, i)
                exitwhen ts == null
                exitwhen ts == s
                set s=ts
                set s__JohabReverse_INGRE[i]=S2A(ts)
                set i=i + 1
            endloop
            if i == 0 then
                return
            endif
            set u=CreateUnit(p, s__JohabReverse_INGRE[GetRandomInt(0, i - 1)], x, y, 270.00)
            call sc__servant_add(p , u , s__servant_BREAK)
            call DestroyEffect(AddSpecialEffect("FX\\GodKnows.mdl", GetUnitX(u), GetUnitY(u)))
            set u=null
        endfunction

