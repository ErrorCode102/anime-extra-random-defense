//===========================================================================
    function s__CMSchwester_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMSchwester_myDummy[this])
        call ShowUnit(s__CMSchwester_myDummy[this], false)
        set s__CMSchwester_myDummy[this]=null
        set s__CMSchwester_caster[this]=null
        call s__tick_destroy(s__CMSchwester_main[this])
    endfunction
    function s__CMSchwester_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , 5.00)
        if GetUnitLevel(s__CMSchwester_caster[this]) == 6 then
            call FXRD_FXShieldBreak(GetEnumUnit() , 5.00)
            call FXRD_FXPauseShield(GetEnumUnit() , 5.00)
        endif
        call s__enemy_dealLogicEx(s__CMSchwester_caster[this] , GetEnumUnit() , s__CMSchwester_damage[this] , true , false , WEAPON_TYPE_ROCK_HEAVY_BASH , 1)
    endfunction
    function s__CMSchwester_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00S', GetUnitX(s__CMSchwester_myDummy[this]), GetUnitY(s__CMSchwester_myDummy[this]), 270)
        call s__splash_range(s__splash_ENEMY , s__CMSchwester_caster[this] , GetUnitX(s__CMSchwester_myDummy[this]) , GetUnitY(s__CMSchwester_myDummy[this]) , 1400.0 , function s__CMSchwester_enumDealt)
        call sc__DummyColorChanger_cast(s__CMSchwester_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMSchwester_myDummy[this], 0.00)
        call s__tick_start(s__CMSchwester_main[this],0.20 , false , function s__CMSchwester_onFinal)
    endfunction
    function s__CMSchwester_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMSchwester_caster[this]=src
        set s__CMSchwester_damage[this]=dmg
        set s__CMSchwester_main[this]=this
        set s__CMSchwester_myDummy[this]=CreateUnit(Player(15), 'o013', GetUnitX(src), GetUnitY(src), GetUnitFacing(src))
        call sc__DummyColorChanger_cast(s__CMSchwester_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call DestroyEffect(AddSpecialEffectTarget("FX\\BloodSlam\\BloodSlam.mdl", s__CMSchwester_myDummy[this], "origin"))
        call SetUnitAnimation(s__CMSchwester_myDummy[this], "attack defend")
        call SetUnitTimeScale(s__CMSchwester_myDummy[this], 0.50)
        call s__tick_start(s__CMSchwester_main[this],1.60 , false , function s__CMSchwester_onFire)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00O', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
        call s__TLDummyEmitter_apply(src , 'h005' , GetUnitX(src) , GetUnitY(src) , 0.00 , 0.15 , 0.20 , 1.40)
        call SetSoundPosition(gg_snd_alqueid_schwester_cast, GetUnitX(src), GetUnitY(src), 300.00)
        call StartSound(gg_snd_alqueid_schwester_cast)
    endfunction
// Trigger: Sv C Alqueid
//===========================================================================
// scope SvAlqueid begins
    //기본 서번트 스탯 설정
    //구현부
    function SvAlqueid__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvAlqueid__onAttackEffect takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call FXRD_FXDebuffShock(dst , 0.10)
        call s__EVDebuffSlow_apply(dst , 1.00)
        call s__enemy_dealLogicEx(src , dst , s__EVDamageManager_getFinalDamage(src) , true , false , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvAlqueid__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvAlqueid__ODMG[lv])
        //Adding Special Skillz
        if lv == 3 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAlqueid__onAttack)
        endif
        if lv == 4 then
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAlqueid__onAttackEffect)
        endif
        if lv == 5 then
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAlqueid__onAttackEffect)
            call sc__EV168AlqueidB_append(s__eventServantAdd_e , 15000 , 60.00)
        endif
        if lv == 6 then
            call FXRD_FXImmuneStun(s__eventServantAdd_e , true)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAlqueid__onAttackEffect)
            call sc__EV168AlqueidB_append(s__eventServantAdd_e , 96000 , 60.00)
        endif
    endfunction
    //초기화
    function SvAlqueid__main takes nothing returns nothing
        set SvAlqueid__ODMG[3]=40
        set SvAlqueid__ODMG[4]=160
        set SvAlqueid__ODMG[5]=400
        set SvAlqueid__ODMG[6]=1280
        call s__eventServantAdd_register(SV_ALQUEID + OFF_C , function SvAlqueid__onServantGet)
        call s__eventServantAdd_register(SV_ALQUEID + OFF_B , function SvAlqueid__onServantGet)
        call s__eventServantAdd_register(SV_ALQUEID + OFF_A , function SvAlqueid__onServantGet)
        call s__eventServantAdd_register(SV_ALQUEID + OFF_S , function SvAlqueid__onServantGet)
    endfunction
