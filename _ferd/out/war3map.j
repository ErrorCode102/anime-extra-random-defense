        set s__CMStrikeAir_myDummy[this]=null
        set s__CMStrikeAir_caster[this]=null
        set s__CMStrikeAir_target[this]=null
        call s__tick_destroy(s__CMStrikeAir_main[this])
    endfunction
    function s__CMStrikeAir_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMStrikeAir_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMStrikeAir_myDummy[this], "overhead"))
        else
            call s__CMSpathaMissle_cast(s__CMStrikeAir_caster[this] , s__CMStrikeAir_target[this] , s__CMStrikeAir_damage[this] , s__CMStrikeAir_myDummy[this])
        endif
        call sc__DummyColorChanger_cast(s__CMStrikeAir_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.40)
        call s__tick_start(s__CMStrikeAir_main[this],0.40 , false , function s__CMStrikeAir_onFinal)
    endfunction
    function s__CMStrikeAir_cast takes unit src,unit dst,real dmg,integer obid,string anid,real rx returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(dst , src) + rx
        set s__CMStrikeAir_caster[this]=src
        set s__CMStrikeAir_target[this]=dst
        set s__CMStrikeAir_damage[this]=dmg
        set s__CMStrikeAir_main[this]=this
        call SetSafeXY(GetUnitX(dst) + s__Polar_X(200 , ang) , GetUnitY(dst) + s__Polar_Y(200 , ang))
        set ang=s__Angle_PBW(GetSafeX() , GetSafeY() , dst)
        set s__CMStrikeAir_myDummy[this]=CreateUnit(Player(15), obid, GetSafeX(), GetSafeY(), ang)
        call sc__DummyColorChanger_cast(s__CMStrikeAir_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMStrikeAir_myDummy[this], anid)
        call SetUnitTimeScale(s__CMStrikeAir_myDummy[this], 1.00)
        call s__tick_start(s__CMStrikeAir_main[this],0.60 , false , function s__CMStrikeAir_onFire)
    endfunction

    function s__CMExcalMissle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitInGroup(GetEnumUnit(), s__CMExcalMissle_myG[this]) then
            return
        endif
        call GroupAddUnit(s__CMExcalMissle_myG[this], GetEnumUnit())
        call FXRD_FXDebuffShock(GetEnumUnit() , 2.00)
        call s__enemy_dealLogic(s__CMExcalMissle_caster[this] , GetEnumUnit() , s__CMExcalMissle_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMExcalMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMExcalMissle_caster[this], UNIT_TYPE_DEAD) or s__CMExcalMissle_count[this] > 16 then
            call KillUnit(s__CMExcalMissle_myDummy[this])
            set s__CMExcalMissle_myDummy[this]=null
            call GroupClear(s__CMExcalMissle_myG[this])
            call DestroyGroup(s__CMExcalMissle_myG[this])
            set s__CMExcalMissle_myG[this]=null
            set s__CMExcalMissle_caster[this]=null
            call s__tick_destroy(s__CMExcalMissle_main[this])
            return
        endif
        set s__CMExcalMissle_count[this]=s__CMExcalMissle_count[this] + 1
        call s__splash_range(s__splash_ENEMY , s__CMExcalMissle_caster[this] , GetUnitX(s__CMExcalMissle_myDummy[this]) , GetUnitY(s__CMExcalMissle_myDummy[this]) , 400 , function s__CMExcalMissle_enumDealt)
    endfunction
    function s__CMExcalMissle_cast takes unit src,real tx,real ty,real dmg,unit dum returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBP(dum , tx , ty)
        set s__CMExcalMissle_caster[this]=src
        set s__CMExcalMissle_damage[this]=dmg
        set s__CMExcalMissle_count[this]=0
        set s__CMExcalMissle_myG[this]=CreateGroup()
        set s__CMExcalMissle_main[this]=this
        set s__CMExcalMissle_myDummy[this]=CreateUnit(Player(15), 'o019', GetUnitX(dum) + s__Polar_X(100 , ang), GetUnitY(dum) + s__Polar_Y(100 , ang), ang)
        call sc__DummyKnockback_cast(s__CMExcalMissle_myDummy[this] , 800 , ang , 0 , 0.50)
        call s__tick_start(s__CMExcalMissle_main[this],0.03125 , true , function s__CMExcalMissle_onFire)
    endfunction

    function s__CMExcal_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMExcal_myDummy[this])
        call ShowUnit(s__CMExcal_myDummy[this], false)
        set s__CMExcal_myDummy[this]=null
        set s__CMExcal_caster[this]=null
        call s__tick_destroy(s__CMExcal_main[this])
    endfunction
    function s__CMExcal_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__CMExcalMissle_cast(s__CMExcal_caster[this] , s__CMExcal_myX[this] , s__CMExcal_myY[this] , s__CMExcal_damage[this] , s__CMExcal_myDummy[this])
        call sc__DummyColorChanger_cast(s__CMExcal_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMExcal_myDummy[this], 0.00)
        call s__tick_start(s__CMExcal_main[this],0.20 , false , function s__CMExcal_onFinal)
    endfunction
    function s__CMExcal_cast takes unit src,real tx,real ty,real dmg,integer obid,string animid returns nothing
        local integer this= s__tick_create(0)
        local real dis= GetRandomReal(100.00, 400.00)
        local real ang= s__Angle_WBP(src , tx , ty) - 180 + GetRandomReal(- 90, 90)
        set s__CMExcal_caster[this]=src
        set s__CMExcal_myX[this]=tx
        set s__CMExcal_myY[this]=ty
        set s__CMExcal_damage[this]=dmg
        set s__CMExcal_main[this]=this
        call SetSafeXY(GetUnitX(src) + s__Polar_X(dis , ang) , GetUnitY(src) + s__Polar_Y(dis , ang))
        set ang=s__Angle_PBP(GetSafeX() , GetSafeY() , tx , ty)
        set s__CMExcal_myDummy[this]=CreateUnit(Player(15), obid, GetSafeX(), GetSafeY(), ang)
        call sc__DummyColorChanger_cast(s__CMExcal_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMExcal_myDummy[this], animid)
        call SetUnitTimeScale(s__CMExcal_myDummy[this], 1.50)
        call s__tick_start(s__CMExcal_main[this],0.40 , false , function s__CMExcal_onFire)
    endfunction
// Trigger: Sv C Pendragon
//===========================================================================
// scope SvPendragon begins
    //기본 서번트 스탯 설정
    //구현부
    function SvPendragon__enumDealt takes nothing returns nothing
        call DestroyEffect(AddSpecialEffectTarget("FX\\Slash\\Blue.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
        call SetUnitState(GetTriggerUnit(), UNIT_STATE_MANA, GetUnitState(GetTriggerUnit(), UNIT_STATE_MANA) + 1)
        call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function SvPendragon__onAttackSplash takes nothing returns nothing
        local unit src
        local unit dst
        local real dmg
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            call KillUnit(CreateUnit(Player(15), 'o015', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call KillUnit(CreateUnit(Player(15), 'o015', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(src) , GetUnitY(src) , GetUnitAcquireRange(src) - 150 , function SvPendragon__enumDealt)
        else
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            set dmg=s__EVDamageManager_getFinalDamage(src)
            call s__CMStrikeAir_cast(src , dst , dmg , 'o017' , "spell throw two" , 45)
            call s__CMStrikeAir_cast(src , dst , dmg , 'o017' , "spell throw two" , - 45)
            call s__enemy_dealLogic(src , dst , dmg , WEAPON_TYPE_METAL_MEDIUM_CHOP , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvPendragon__onAttackSplashEx takes nothing returns nothing
        local unit src
        local unit dst
        local real dmg
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            call KillUnit(CreateUnit(Player(15), 'o015', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call KillUnit(CreateUnit(Player(15), 'o015', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(src) , GetUnitY(src) , GetUnitAcquireRange(src) - 150 , function SvPendragon__enumDealt)
        else
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
            set dmg=s__EVDamageManager_getFinalDamage(src)
            call s__CMStrikeAir_cast(src , dst , dmg , 'o018' , "attack morph" , 45)
            call s__CMStrikeAir_cast(src , dst , dmg , 'o018' , "attack morph" , - 45)
            call s__enemy_dealLogic(src , dst , dmg , WEAPON_TYPE_METAL_MEDIUM_CHOP , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvPendragon__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvPendragon__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvPendragon__ODMG[lv])
        //Adding Special Skillz
        if lv == 3 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragon__onAttack)
        endif
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragon__onAttackSplash)
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragon__onAttackSplash)
            call sc__EV147PendragonB_append(s__eventServantAdd_e , 50 , 'o017' , "spell slam two")
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragon__onAttackSplash)
            call sc__EV147PendragonB_append(s__eventServantAdd_e , 50 , 'o017' , "spell slam two")
        endif
        if lv == 7 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A06T')
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvPendragon__onAttackSplashEx)
            call sc__EV147PendragonB_append(s__eventServantAdd_e , 50 , 'o018' , "attack alternate")
            call sc__EV146PendragonEXC_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvPendragon__main takes nothing returns nothing
        set SvPendragon__ODMG[3]=65
        set SvPendragon__ODMG[4]=130
        set SvPendragon__ODMG[5]=325
        set SvPendragon__ODMG[6]=1040
        set SvPendragon__ODMG[7]=1955
        call s__eventServantAdd_register(SV_PENDRAGON + OFF_C , function SvPendragon__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGON + OFF_B , function SvPendragon__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGON + OFF_A , function SvPendragon__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGON + OFF_S , function SvPendragon__onServantGet)
        call s__eventServantAdd_register(SV_PENDRAGON + OFF_EX , function SvPendragon__onServantGet)
    endfunction
