// scope TrigFactionAlteraKillBonus begins
    function TrigFactionAlteraKillBonus__WispBonus takes player p,real x,real y returns nothing
        call CreateWisp(p , 1)
        call DestroyEffect(AddSpecialEffect("units\\nightelf\\Wisp\\Wisp.mdl", x, y))
        call s__bountyTag_custom(p , x , y + 64 , "|c00D0D0FFobtained Spirit|r")
    endfunction
    function TrigFactionAlteraKillBonus__OnAction takes nothing returns nothing
        //FXRD 세력 - 현재 세력이 (ALTERA)가 아니라면, 즉시 종료합니다.
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) != FX_FACTION_ALTERA then
            return
        endif
        if GetRandomInt(1, 100) != 1 then
            return
        endif
        call TrigFactionAlteraKillBonus__WispBonus(s__eventCustom_getTriggerPlayer() , GetUnitX(s__eventCustom_getTriggerUnit()) , GetUnitY(s__eventCustom_getTriggerUnit()))
    endfunction
    function TrigFactionAlteraKillBonus__main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_USER_KILL , function TrigFactionAlteraKillBonus__OnAction)
    endfunction
// scope TrigFactionAlteraKillBonus ends
//===================================================
//      알테라 - 유성의 문장
//===================================================
// scope TrigFactionAlteraSeal begins
    function TrigFactionAlteraSeal__IsUnitAltera takes integer id returns boolean
        if id == '-ALB' then
            return true
        endif
        if id == '-ALA' then
            return true
        endif
        if id == '-ALS' then
            return true
        endif
        if id == '-ALX' then
            return true
        endif
        return false
    endfunction
    function TrigFactionAlteraSeal__OnCast takes nothing returns nothing
        local integer id= GetPlayerId(GetOwningPlayer(GetTriggerUnit()))
        //서번트가 아니라면 빠꾸
        if not IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000This effect cannot be granted to a non-Servant targets.|r")
            return
        endif
        //문장이 부여되어 있다면 빠꾸
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A07H') > 0 then
            call StartSoundForPlayerBJ(Player(id), gg_snd_Error)
            call DisplayTextToPlayer(Player(id), 0.00, 0.00, "|c00FF0000The same effect is already given.|r")
            return
        endif
        //이전 소유자가 살아 있다면 효과 제거
        if not IsUnitType(TrigFactionAlteraSeal__SEAL_TARGET[id], UNIT_TYPE_DEAD) and GetUnitTypeId(TrigFactionAlteraSeal__SEAL_TARGET[id]) != 0 then
            if TrigFactionAlteraSeal__IsUnitAltera(GetUnitTypeId(TrigFactionAlteraSeal__SEAL_TARGET[id])) then
                call sc__EVDamageManager_addBonus(TrigFactionAlteraSeal__SEAL_TARGET[id] , - 100)
                call UnitRemoveAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'A0EV')
                call UnitRemoveAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'B00W')
            else
                call sc__EVDamageManager_addBonus(TrigFactionAlteraSeal__SEAL_TARGET[id] , - 50)
                call UnitRemoveAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'A07H')
                call UnitRemoveAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'B003')
            endif
            set TrigFactionAlteraSeal__SEAL_TARGET[id]=null
        endif
        if TrigFactionAlteraSeal__SEAL_EFFECT[id] != null then
            call DestroyEffect(TrigFactionAlteraSeal__SEAL_EFFECT[id])
            set TrigFactionAlteraSeal__SEAL_EFFECT[id]=null
        endif
        //재설정
        set TrigFactionAlteraSeal__SEAL_TARGET[id]=GetSpellTargetUnit()
        if TrigFactionAlteraSeal__IsUnitAltera(GetUnitTypeId(TrigFactionAlteraSeal__SEAL_TARGET[id])) then
            call s__bountyTag_custom(Player(id) , GetUnitX(TrigFactionAlteraSeal__SEAL_TARGET[id]) , GetUnitY(TrigFactionAlteraSeal__SEAL_TARGET[id]) , "|c00FF0000『Crest of the Wandering Star+』|r")
            call UnitAddAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'A0EV')
            call sc__EVDamageManager_addBonus(TrigFactionAlteraSeal__SEAL_TARGET[id] , 100)
        else
            call s__bountyTag_custom(Player(id) , GetUnitX(TrigFactionAlteraSeal__SEAL_TARGET[id]) , GetUnitY(TrigFactionAlteraSeal__SEAL_TARGET[id]) , "|c00FF0000『Crest of the Wandering Star』|r")
            call UnitAddAbility(TrigFactionAlteraSeal__SEAL_TARGET[id], 'A07H')
            call sc__EVDamageManager_addBonus(TrigFactionAlteraSeal__SEAL_TARGET[id] , 50)
        endif
        set TrigFactionAlteraSeal__SEAL_EFFECT[id]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Starfall\\StarfallCaster.mdl", TrigFactionAlteraSeal__SEAL_TARGET[id], "origin")
    endfunction
    function TrigFactionAlteraSeal__main takes nothing returns nothing
        call s__AbilityEffectEvent_Create('A069' , function TrigFactionAlteraSeal__OnCast)
    endfunction
// scope TrigFactionAlteraSeal ends
