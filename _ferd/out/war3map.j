    function s__CMSpathaMissle_onFinal takes integer this returns nothing
        call KillUnit(s__CMSpathaMissle_myDummy[this])
        set s__CMSpathaMissle_myDummy[this]=null
        set s__CMSpathaMissle_caster[this]=null
        set s__CMSpathaMissle_target[this]=null
        call s__tick_destroy(s__CMSpathaMissle_main[this])
    endfunction
    function s__CMSpathaMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang
        if IsUnitType(s__CMSpathaMissle_target[this], UNIT_TYPE_DEAD) then
            call s__CMSpathaMissle_onFinal(this)
            return
        endif
        set ang=s__Angle_WBW(s__CMSpathaMissle_myDummy[this] , s__CMSpathaMissle_target[this])
        call SetUnitFacing(s__CMSpathaMissle_myDummy[this], ang)
        if s__Distance_WBW(s__CMSpathaMissle_target[this] , s__CMSpathaMissle_myDummy[this]) > s__CMSpathaMissle_mySpeed[this] then
            call SetUnitX(s__CMSpathaMissle_myDummy[this], GetUnitX(s__CMSpathaMissle_myDummy[this]) + s__Polar_X(s__CMSpathaMissle_mySpeed[this] , ang))
            call SetUnitY(s__CMSpathaMissle_myDummy[this], GetUnitY(s__CMSpathaMissle_myDummy[this]) + s__Polar_Y(s__CMSpathaMissle_mySpeed[this] , ang))
            set s__CMSpathaMissle_mySpeed[this]=s__CMSpathaMissle_mySpeed[this] + 1.00
            return
        endif
        call SetUnitX(s__CMSpathaMissle_myDummy[this], GetUnitX(s__CMSpathaMissle_target[this]))
        call SetUnitY(s__CMSpathaMissle_myDummy[this], GetUnitY(s__CMSpathaMissle_target[this]))
        call FXRD_FXDebuffShock(s__CMSpathaMissle_target[this] , 0.10)
        call s__EVDebuffSlow_apply(s__CMSpathaMissle_target[this] , 1.00)
        call DestroyEffect(AddSpecialEffectTarget("FX\\Slash\\Blue.mdl", s__CMSpathaMissle_target[this], "chest"))
        call s__enemy_dealLogic(s__CMSpathaMissle_caster[this] , s__CMSpathaMissle_target[this] , s__CMSpathaMissle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        call s__CMSpathaMissle_onFinal(this)
    endfunction
    function s__CMSpathaMissle_cast takes unit src,unit dst,real dmg,unit dum returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(dum , dst)
        set s__CMSpathaMissle_caster[this]=src
        set s__CMSpathaMissle_target[this]=dst
        set s__CMSpathaMissle_damage[this]=dmg
        set s__CMSpathaMissle_mySpeed[this]=50
        set s__CMSpathaMissle_main[this]=this
        set s__CMSpathaMissle_myDummy[this]=CreateUnit(Player(15), 'o00X', GetUnitX(dum), GetUnitY(dum), ang)
        call s__tick_start(s__CMSpathaMissle_main[this],0.03125 , true , function s__CMSpathaMissle_onFire)
    endfunction

    function s__CMSpatha_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMSpatha_myDummy[this])
        call ShowUnit(s__CMSpatha_myDummy[this], false)
        set s__CMSpatha_myDummy[this]=null
        set s__CMSpatha_caster[this]=null
        set s__CMSpatha_target[this]=null
        call s__tick_destroy(s__CMSpatha_main[this])
    endfunction
    function s__CMSpatha_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMSpatha_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMSpatha_myDummy[this], "overhead"))
        else
            call s__CMSpathaMissle_cast(s__CMSpatha_caster[this] , s__CMSpatha_target[this] , s__CMSpatha_damage[this] , s__CMSpatha_myDummy[this])
        endif
        call sc__DummyColorChanger_cast(s__CMSpatha_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call s__tick_start(s__CMSpatha_main[this],0.20 , false , function s__CMSpatha_onFinal)
    endfunction
    function s__CMSpatha_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real dis= GetRandomReal(100.00, 400.00)
        local real ang= s__Angle_WBW(src , dst) - 180 + GetRandomReal(- 90, 90)
        set s__CMSpatha_caster[this]=src
        set s__CMSpatha_target[this]=dst
        set s__CMSpatha_damage[this]=dmg
        set s__CMSpatha_main[this]=this
        call SetSafeXY(GetUnitX(src) + s__Polar_X(dis , ang) , GetUnitY(src) + s__Polar_Y(dis , ang))
        set ang=s__Angle_PBW(GetSafeX() , GetSafeY() , dst)
        set s__CMSpatha_myDummy[this]=CreateUnit(Player(15), 'o00W', GetSafeX(), GetSafeY(), ang)
        call sc__DummyColorChanger_cast(s__CMSpatha_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMSpatha_myDummy[this], "spell throw")
        call SetUnitTimeScale(s__CMSpatha_myDummy[this], 1.20)
        call s__tick_start(s__CMSpatha_main[this],0.40 , false , function s__CMSpatha_onFire)
    endfunction

    function s__CMHetairoi_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMHetairoi_target[this], UNIT_TYPE_DEAD) then
            call UnitRemoveAbility(s__CMHetairoi_target[this], 'A03X')
            call UnitRemoveAbility(s__CMHetairoi_target[this], 'B00I')
            call s__EVDamageManager_addBonus(s__CMHetairoi_target[this] , - 50)
        endif
        call DestroyEffect(s__CMHetairoi_fx[this])
        set s__CMHetairoi_fx[this]=null
        set s__CMHetairoi_caster[this]=null
        set s__CMHetairoi_target[this]=null
        call s__tick_destroy(s__CMHetairoi_mainFlow[this])
    endfunction
    function s__CMHetairoi_cast takes unit src,unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMHetairoi_caster[this]=src
        set s__CMHetairoi_target[this]=dst
        set s__CMHetairoi_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\DivineShield\\DivineShieldTarget.mdl", dst, "origin")
        call UnitAddAbility(s__CMHetairoi_target[this], 'A03X')
        call s__EVDamageManager_addBonus(dst , 50)
        set s__CMHetairoi_mainFlow[this]=this
        call s__tick_start(s__CMHetairoi_mainFlow[this],delay , false , function s__CMHetairoi_onFinal)
    endfunction
