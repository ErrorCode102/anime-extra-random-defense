    function SvTamamoDelmo__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        local integer mana
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set mana=0
        if GetUnitLevel(src) == 5 then
            set mana=1
        endif
        if GetUnitLevel(src) == 6 then
            set mana=5
        endif
        //Melee Attack
        call s__CMMilten_cast(src , GetUnitX(dst) , GetUnitY(dst) , s__EVDamageManager_getFinalDamage(src) , mana)
        set src=null
        set dst=null
    endfunction
    function SvTamamoDelmo__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvTamamoDelmo__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvTamamoDelmo__onAttack)
        //Adding Special Skillz
    endfunction
