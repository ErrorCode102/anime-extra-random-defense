    function s__CMDeathfistbuff_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitDead(s__CMDeathfistbuff_target[this]) then
            call UnitRemoveAbility(s__CMDeathfistbuff_target[this], 'A07I')
            call UnitRemoveAbility(s__CMDeathfistbuff_target[this], 'B004')
        endif
        set s__CMDeathfistbuff_target[this]=null
        call s__tick_destroy(s__CMDeathfistbuff_mainFlow[this])
    endfunction
    function s__CMDeathfistbuff_onCast takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if GetUnitAbilityLevel(s__CMDeathfistbuff_target[this], 'A07I') > 0 or IsUnitDead(s__CMDeathfistbuff_target[this]) then
            set s__CMDeathfistbuff_target[this]=null
            call s__tick_destroy(s__CMDeathfistbuff_mainFlow[this])
            return
        endif
        call UnitAddAbility(s__CMDeathfistbuff_target[this], 'A07I')
        call s__tick_start(s__CMDeathfistbuff_mainFlow[this],s__CMDeathfistbuff_delays[this] , false , function s__CMDeathfistbuff_onFinal)
    endfunction
    function s__CMDeathfistbuff_cast takes unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMDeathfistbuff_target[this]=dst
        set s__CMDeathfistbuff_delays[this]=delay
        set s__CMDeathfistbuff_mainFlow[this]=this
        call s__tick_start(s__CMDeathfistbuff_mainFlow[this],0.10 , false , function s__CMDeathfistbuff_onCast)
    endfunction

    function s__CMKyrie_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMKyrie_casterDummy[this])
        call ShowUnit(s__CMKyrie_casterDummy[this], false)
        set s__CMKyrie_casterDummy[this]=null
        set s__CMKyrie_caster[this]=null
        set s__CMKyrie_target[this]=null
        call s__tick_destroy(s__CMKyrie_mainFlow[this])
    endfunction
    function s__CMKyrie_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMKyrie_combo[this] == 0 or IsUnitType(s__CMKyrie_target[this], UNIT_TYPE_DEAD) then
            call SetUnitTimeScale(s__CMKyrie_casterDummy[this], 0.00)
            call sc__DummyColorChanger_cast(s__CMKyrie_casterDummy[this] , 128 , 128 , 128 , 255 , 128 , 128 , 128 , 0 , 0.30)
            call s__tick_start(s__CMKyrie_mainFlow[this],0.40 , false , function s__CMKyrie_onFinal)
            return
        endif
        set s__CMKyrie_combo[this]=s__CMKyrie_combo[this] - 1
        call FXRD_FXDebuffShock(s__CMKyrie_target[this] , 0.20)
        if GetUnitLevel(s__CMKyrie_caster[this]) == 6 then
            call FXRD_FXShieldBreak(s__CMKyrie_target[this] , 0.20)
            call FXRD_FXPauseShield(s__CMKyrie_target[this] , 0.20)
            call FXRD_FXPauseLife(s__CMKyrie_target[this] , 0.20)
        endif
        call s__enemy_dealLogicEx(s__CMKyrie_caster[this] , s__CMKyrie_target[this] , s__CMKyrie_damage[this] , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", GetUnitX(s__CMKyrie_target[this]), GetUnitY(s__CMKyrie_target[this])))
        call sc__DummyLightning_cast("HWPB" , 1 , 1 , 1 , GetUnitX(s__CMKyrie_casterDummy[this]) , GetUnitY(s__CMKyrie_casterDummy[this]) , 70 , GetUnitX(s__CMKyrie_target[this]) , GetUnitY(s__CMKyrie_target[this]) , 60 , 0.30)
        call s__tick_start(s__CMKyrie_mainFlow[this],0.18 , false , function s__CMKyrie_onFireStart)
    endfunction
    function s__CMKyrie_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real dir= GetRandomReal(- 90, 90)
        local real dis= GetRandomReal(100.00, 400.00)
        set s__CMKyrie_caster[this]=src
        set s__CMKyrie_target[this]=dst
        set s__CMKyrie_damage[this]=dmg * 0.10
        set s__CMKyrie_combo[this]=10
        call SetSafeXY(GetUnitX(src) + s__Polar_X(dis , dir) , GetUnitY(src) + s__Polar_Y(dis , dir))
        set dir=s__Angle_PBW(GetSafeX() , GetSafeY() , dst)
        set s__CMKyrie_casterDummy[this]=CreateUnit(Player(15), 'o00E', GetSafeX(), GetSafeY(), dir)
        call UnitAddAbility(s__CMKyrie_casterDummy[this], 'A08C')
        call SetUnitLookAt(s__CMKyrie_casterDummy[this], "chest", dst, 0, 0, 80.00)
        call SetUnitLookAt(s__CMKyrie_casterDummy[this], "head", dst, 0, 0, 80.00)
        call sc__DummyColorChanger_cast(s__CMKyrie_casterDummy[this] , 0 , 0 , 0 , 0 , 128 , 128 , 128 , 255 , 0.40)
        call SetUnitAnimation(s__CMKyrie_casterDummy[this], "spell two")
        set s__CMKyrie_mainFlow[this]=this
        call s__tick_start(s__CMKyrie_mainFlow[this],0.80 , false , function s__CMKyrie_onFireStart)
    endfunction
