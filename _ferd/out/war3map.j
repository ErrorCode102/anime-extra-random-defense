    function s__TLMeltPenguinLVIA_enumDealt takes nothing returns nothing
        local integer t= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl", GetEnumUnit(), "chest"))
        call sc__EVDebuffSlow_apply(GetEnumUnit() , 3.0)
        call s__enemy_dealLogic(s__TLMeltPenguinLVIA_MIR_S[t] , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(s__TLMeltPenguinLVIA_MIR_S[t]) , WEAPON_TYPE_METAL_MEDIUM_BASH , 1)
    endfunction
    function s__TLMeltPenguinLVIA_SummonEnd takes nothing returns nothing
        local integer t= s__tick_getExpired()
        if not IsUnitDead(s__TLMeltPenguinLVIA_MIR_U[t]) then
            if not IsUnitDead(s__TLMeltPenguinLVIA_MIR_S[t]) then
                call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02I', GetUnitX(s__TLMeltPenguinLVIA_MIR_U[t]), GetUnitY(s__TLMeltPenguinLVIA_MIR_U[t]), GetRandomReal(0.0, 360.0)))
                call s__splash_range(s__splash_ENEMY , s__TLMeltPenguinLVIA_MIR_S[t] , GetUnitX(s__TLMeltPenguinLVIA_MIR_U[t]) , GetUnitY(s__TLMeltPenguinLVIA_MIR_U[t]) , 700.0 , function s__TLMeltPenguinLVIA_enumDealt)
            endif
            call s__servant_kill(s__TLMeltPenguinLVIA_MIR_U[t] , false)
        endif
        set s__TLMeltPenguinLVIA_MIR_S[t]=null
        set s__TLMeltPenguinLVIA_MIR_U[t]=null
        set s__TLMeltPenguinLVIA_MIR_P[t]=null
        call s__tick_destroy(t)
    endfunction
    function s__TLMeltPenguinLVIA_SummonMirror takes nothing returns nothing
        local integer t= s__tick_getExpired()
        set s__TLMeltPenguinLVIA_MIR_U[t]=CreateUnit(s__TLMeltPenguinLVIA_MIR_P[t], 'h010', s__TLMeltPenguinLVIA_MIR_X[t], s__TLMeltPenguinLVIA_MIR_Y[t], s__TLMeltPenguinLVIA_MIR_F[t])
        //call SetUnitPropWindow(MIR_U[t],0.0)
        call SetUnitVertexColor(s__TLMeltPenguinLVIA_MIR_U[t], 255, 255, 255, 224)
        call s__servant_add(s__TLMeltPenguinLVIA_MIR_P[t] , s__TLMeltPenguinLVIA_MIR_U[t] , s__servant_QUIET)
        
        if GetUnitAbilityLevel(s__TLMeltPenguinLVIA_MIR_S[t], 'A02W') > 0 then
            call UnitAddAbility(s__TLMeltPenguinLVIA_MIR_U[t], 'A02W')
            call sc__EVDamageManager_addBonus(s__TLMeltPenguinLVIA_MIR_U[t] , 100)
        endif
        if GetUnitAbilityLevel(s__TLMeltPenguinLVIA_MIR_S[t], 'A0GO') > 0 then
            call SetUnitVertexColor(s__TLMeltPenguinLVIA_MIR_U[t], 32, 32, 32, 224)
            call UnitAddAbility(s__TLMeltPenguinLVIA_MIR_U[t], 'A0GO')
            call UnitAddAbility(s__TLMeltPenguinLVIA_MIR_U[t], 'A0GN')
            call sc__EVDamageManager_addBonus(s__TLMeltPenguinLVIA_MIR_U[t] , 50)
        endif
        if GetUnitAbilityLevel(s__TLMeltPenguinLVIA_MIR_S[t], 'A0GP') > 0 then
            call SetUnitVertexColor(s__TLMeltPenguinLVIA_MIR_U[t], 32, 32, 32, 224)
            call UnitAddAbility(s__TLMeltPenguinLVIA_MIR_U[t], 'A0GP')
            call UnitAddAbility(s__TLMeltPenguinLVIA_MIR_U[t], 'A0GR')
            call sc__EVDamageManager_addBonus(s__TLMeltPenguinLVIA_MIR_U[t] , 400)
        endif
        
        call s__tick_start(t,5.0 , false , function s__TLMeltPenguinLVIA_SummonEnd)
    endfunction
        
    function s__TLMeltPenguinLVIA_SummonLoops takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local integer t
        if s__TLMeltPenguinLVIA_count[this] > 0 and not IsUnitDead(s__TLMeltPenguinLVIA_caster[this]) then
            set t=s__tick_create(0)
            set s__TLMeltPenguinLVIA_MIR_S[t]=s__TLMeltPenguinLVIA_caster[this]
            set s__TLMeltPenguinLVIA_MIR_X[t]=GetUnitX(s__TLMeltPenguinLVIA_caster[this]) + GetRandomReal(- 256.0, 256.0)
            set s__TLMeltPenguinLVIA_MIR_Y[t]=GetUnitY(s__TLMeltPenguinLVIA_caster[this]) + GetRandomReal(- 256.0, 256.0)
            set s__TLMeltPenguinLVIA_MIR_F[t]=GetUnitFacing(s__TLMeltPenguinLVIA_caster[this])
            set s__TLMeltPenguinLVIA_MIR_P[t]=GetOwningPlayer(s__TLMeltPenguinLVIA_caster[this])
            call s__tick_start(t,0.1 , false , function s__TLMeltPenguinLVIA_SummonMirror)
        endif
        set s__TLMeltPenguinLVIA_count[this]=s__TLMeltPenguinLVIA_count[this] - 1
        if s__TLMeltPenguinLVIA_count[this] > 0 then
            return
        endif
        set s__TLMeltPenguinLVIA_caster[this]=null
        call s__tick_destroy(s__TLMeltPenguinLVIA_main[this])
    endfunction
    function s__TLMeltPenguinLVIA_apply takes unit src,integer amt returns nothing
        local integer this= s__tick_create(0)
        set s__TLMeltPenguinLVIA_caster[this]=src
        set s__TLMeltPenguinLVIA_count[this]=amt
        set s__TLMeltPenguinLVIA_main[this]=this
        call s__tick_start(s__TLMeltPenguinLVIA_main[this],0.1 , true , function s__TLMeltPenguinLVIA_SummonLoops)
    endfunction
    
    
    function s__TLMeltPenguinBLUS_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl", GetEnumUnit(), "chest"))
        call FXRD_FXDebuffShock(GetEnumUnit() , 10.0)
        call s__enemy_dealLogicEx(s__TLMeltPenguinBLUS_caster[this] , GetEnumUnit() , s__TLMeltPenguinBLUS_damage[this] , true , true , WEAPON_TYPE_METAL_MEDIUM_BASH , 1)
    endfunction
        
    function s__TLMeltPenguinBLUS_CleanUp takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__TLMeltPenguinBLUS_DUM_CORE[this]=null
        set s__TLMeltPenguinBLUS_caster[this]=null
        call s__tick_destroy(s__TLMeltPenguinBLUS_main[this])
    endfunction
    function s__TLMeltPenguinBLUS_Explosion takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__TLMeltPenguinBLUS_DUM_CORE[this])
        call SetUnitTimeScale(s__TLMeltPenguinBLUS_DUM_CORE[this], 2.0)
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01C', s__TLMeltPenguinBLUS_TX[this], s__TLMeltPenguinBLUS_TY[this], 270.0))
        call s__splash_range(s__splash_ENEMY , s__TLMeltPenguinBLUS_caster[this] , s__TLMeltPenguinBLUS_TX[this] , s__TLMeltPenguinBLUS_TY[this] , 800.0 , function s__TLMeltPenguinBLUS_enumDealt)
        call s__tick_start(s__TLMeltPenguinBLUS_main[this],0.1 , false , function s__TLMeltPenguinBLUS_CleanUp)
    endfunction
    function s__TLMeltPenguinBLUS_SummonCore takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__TLMeltPenguinBLUS_DUM_CORE[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02J', s__TLMeltPenguinBLUS_TX[this], s__TLMeltPenguinBLUS_TY[this], 270.0)
        call SetUnitTimeScale(s__TLMeltPenguinBLUS_DUM_CORE[this], 0.05)
        call s__tick_start(s__TLMeltPenguinBLUS_main[this],1.8 , false , function s__TLMeltPenguinBLUS_Explosion)
    endfunction
    function s__TLMeltPenguinBLUS_apply takes unit src,real tx,real ty,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__TLMeltPenguinBLUS_caster[this]=src
        set s__TLMeltPenguinBLUS_damage[this]=dmg
        set s__TLMeltPenguinBLUS_TX[this]=tx
        set s__TLMeltPenguinBLUS_TY[this]=ty
        set s__TLMeltPenguinBLUS_main[this]=this
        call s__tick_start(s__TLMeltPenguinBLUS_main[this],0.1 , false , function s__TLMeltPenguinBLUS_SummonCore)
    endfunction
    // 사용자 정의 멤버
    function s__TLMeltPenguinMelee_enumGetTarget takes nothing returns nothing
        if GetEnumUnit() == s__TLMeltPenguinMelee_EXCLUDE then
            return
        endif
        if GetRandomInt(0, s__TLMeltPenguinMelee_CNT) == 0 then
            set s__TLMeltPenguinMelee_DEST=GetEnumUnit()
        endif
        set s__TLMeltPenguinMelee_CNT=s__TLMeltPenguinMelee_CNT + 1
    endfunction
    function s__TLMeltPenguinMelee_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__TLMeltPenguinMelee_count[this]=s__TLMeltPenguinMelee_count[this] - 1
        set s__TLMeltPenguinMelee_DEST=null
        set s__TLMeltPenguinMelee_EXCLUDE=s__TLMeltPenguinMelee_LastUnit[this]
        set s__TLMeltPenguinMelee_CNT=0
        call s__splash_range(s__splash_ENEMY , s__TLMeltPenguinMelee_caster[this] , s__TLMeltPenguinMelee_LastX[this] , s__TLMeltPenguinMelee_LastY[this] , 400.0 , function s__TLMeltPenguinMelee_enumGetTarget)
        set s__TLMeltPenguinMelee_LastUnit[this]=s__TLMeltPenguinMelee_DEST
        set s__TLMeltPenguinMelee_EXCLUDE=null
        set s__TLMeltPenguinMelee_DEST=null
        if s__TLMeltPenguinMelee_LastUnit[this] != null then
            set s__TLMeltPenguinMelee_LastX[this]=GetUnitX(s__TLMeltPenguinMelee_LastUnit[this])
            set s__TLMeltPenguinMelee_LastY[this]=GetUnitY(s__TLMeltPenguinMelee_LastUnit[this])
            call SetUnitState(s__TLMeltPenguinMelee_caster[this], UNIT_STATE_MANA, GetUnitState(s__TLMeltPenguinMelee_caster[this], UNIT_STATE_MANA) + 2.0)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl", s__TLMeltPenguinMelee_LastUnit[this], "chest"))
            call s__enemy_dealLogic(s__TLMeltPenguinMelee_caster[this] , s__TLMeltPenguinMelee_LastUnit[this] , sc__EVDamageManager_getFinalDamage(s__TLMeltPenguinMelee_caster[this]) , WEAPON_TYPE_METAL_MEDIUM_BASH , 0)
        endif
        if s__TLMeltPenguinMelee_count[this] == 0 or s__TLMeltPenguinMelee_LastUnit[this] == null then
            set s__TLMeltPenguinMelee_caster[this]=null
            set s__TLMeltPenguinMelee_LastUnit[this]=null
            call s__tick_destroy(s__TLMeltPenguinMelee_main[this])
            return
        endif
    endfunction
    function s__TLMeltPenguinMelee_apply takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        set s__TLMeltPenguinMelee_count[this]=3
        set s__TLMeltPenguinMelee_caster[this]=src
        set s__TLMeltPenguinMelee_LastX[this]=GetUnitX(dst)
        set s__TLMeltPenguinMelee_LastY[this]=GetUnitY(dst)
        set s__TLMeltPenguinMelee_LastUnit[this]=dst
        set s__TLMeltPenguinMelee_main[this]=this
        call s__tick_start(s__TLMeltPenguinMelee_main[this],0.1 , true , function s__TLMeltPenguinMelee_onFire)
    endfunction
// Trigger: Servant Melt Penguin Leviathan
