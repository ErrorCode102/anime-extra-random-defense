        set s__EV151ZeromodelA_myCooldown[this]=coold
        set s__EV151ZeromodelA_myDamage[this]=dmg
        set s__EV151ZeromodelA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV151ZeromodelA_coolTick[this],1.00 , true , function sc__EV151ZeromodelA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV151ZeromodelA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV151ZeromodelA_getThis(s__EVUnitRemove_e)
