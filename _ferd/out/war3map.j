        function SVMELTPENGUINSPAWN___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMELTPENGUINSPAWN___MeleeAttack)
            call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", GetUnitX(s__eventServantAdd_e), GetUnitY(s__eventServantAdd_e)))
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
