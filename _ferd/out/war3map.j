        set s__EV116AlteraA_mySize[this]=size
        set s__EV116AlteraA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV116AlteraA_coolTick[this],1.00 , true , function sc__EV116AlteraA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV116AlteraA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV116AlteraA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV116AlteraA_coolTick[this])
        set s__EV116AlteraA_myServant[this]=null
