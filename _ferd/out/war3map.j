        set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + 10]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n00Z', CONF_UI_CENTERX + 96.0 + 384.0, CONF_UI_CENTERY + 384.0 - 96.0, 270.0)
        
