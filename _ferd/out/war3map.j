        set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + 12]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n011', CONF_UI_CENTERX + 96.0 + 96.0, CONF_UI_CENTERY + 384.0 - 192.0, 270.0)
        set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + 13]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n012', CONF_UI_CENTERX + 96.0 + 192.0, CONF_UI_CENTERY + 384.0 - 192.0, 270.0)
        set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + 14]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n013', CONF_UI_CENTERX + 96.0 + 288.0, CONF_UI_CENTERY + 384.0 - 192.0, 270.0)
        set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + 15]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n014', CONF_UI_CENTERX + 96.0 + 384.0, CONF_UI_CENTERY + 384.0 - 192.0, 270.0)
    
        loop
            call SetUnitScale(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i], 0.0, 0.0, 0.0)
            call SetUnitUserData(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i], i)
            call ShowDestructable(UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i], false)
            exitwhen i == PANALTY_MAX
            set i=i + 1
        endloop
    
        set p=null
    endfunction
    
    function UIResultPanelChallenge___onUpdating takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        local boolean isVisible= s__FXResultInterface_Visible[parent] and s__FXResultInterface_State[parent] == s__FXResultInterface_Challenge
        
        local integer i= 1
        local string array PAN_TAG
        local integer panCount= IMinBJ(5, CountPanalty())
        set PAN_TAG[0]="Stand"
        set PAN_TAG[1]="Stand Upgrade First"
        set PAN_TAG[2]="Stand Upgrade Second"
        set PAN_TAG[3]="Stand Upgrade Third"
        set PAN_TAG[4]="Stand Upgrade Fourth"
        set PAN_TAG[5]="Stand Upgrade Fifth"
        
        if GetLocalPlayer() == p then
            call ShowDestructable(UIResultPanelChallenge___BACKDROP[ui], isVisible)
            call ShowDestructable(UIResultPanelChallenge___MILESTONE[ui], isVisible)
            call SetDestructableAnimation(UIResultPanelChallenge___MILESTONE[ui], PAN_TAG[panCount])
            loop
                if isVisible then
                    call SetUnitScale(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i], 1.0, 1.0, 1.0)
                else
                    call SetUnitScale(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i], 0.0, 0.0, 0.0)
                endif
                if PANALTY[i] then
                    call SetDestructableAnimation(UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i], ANI_DEATH)
                else
                    call SetDestructableAnimation(UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i], ANI_DECAY)
                endif
                call ShowDestructable(UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i], isVisible)
                exitwhen i == PANALTY_MAX
                set i=i + 1
            endloop
        endif
        
        set p=null
    endfunction
    
    function UIResultPanelChallenge___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultPanelChallenge___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_UPDATING , function UIResultPanelChallenge___onUpdating)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultPanelChallenge___onClosing)
    endfunction
    
