    function s__ABILMedusaCSelf_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMedusaCSelf_onSpellEffect[this], s__ABILMedusaCSelf_onSpellEffectAction[this])
        set s__ABILMedusaCSelf_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILMedusaCSelf_onSpellEffect[this])
        set s__ABILMedusaCSelf_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILMedusaCSelf_rmTrig[this], s__ABILMedusaCSelf_rmAct[this])
        set s__ABILMedusaCSelf_rmAct[this]=null
        set s__ABILMedusaCSelf_rmTrig[this]=null
        call sc__ABILMedusaCSelf_onAbilityLost(this)
        set s__ABILMedusaCSelf_source[this]=null
        set s__ABILMedusaCSelf_exists[this]=false
    endfunction
    
    function s__ABILMedusaCSelf_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMedusaCSelf_free(this)
    endfunction
    
    function s__ABILMedusaCSelf_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMedusaCSelf_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMedusaCSelf_exists[this] then
            set s__ABILMedusaCSelf_exists[this]=true
            set s__ABILMedusaCSelf_source[this]=src
            set s__ABILMedusaCSelf_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMedusaCSelf_rmAct[this]=TriggerAddAction(s__ABILMedusaCSelf_rmTrig[this], function s__ABILMedusaCSelf_OnSourceRemove)
            set s__ABILMedusaCSelf_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILMedusaCSelf_onSpellEffect[this], Condition(function sc__ABILMedusaCSelf_conditionSpellEffect))
            set s__ABILMedusaCSelf_onSpellEffectAction[this]=TriggerAddAction(s__ABILMedusaCSelf_onSpellEffect[this], function sc__ABILMedusaCSelf_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILMedusaCSelf_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILMedusaCSelf_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILMedusaCSelf_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILMedusaCSelf_exists[this] then
            return
        endif
        call sc__ABILMedusaCSelf_onAbilityEffect(this)
    endfunction
    
    function s__ABILMedusaCSelf_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILMedusaCSelf_ABILITY
    endfunction
