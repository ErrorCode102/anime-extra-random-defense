            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvZeromodel__onAttack)
        endif
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvZeromodel__onAttack)
            call sc__EV151ZeromodelA_append(s__eventServantAdd_e , 200 , 1.00)
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvZeromodel__onAttack)
            call sc__EV151ZeromodelA_append(s__eventServantAdd_e , 500 , 1.00)
            //call EV152ZeromodelB.append( eventServantAdd.e, 20 )
            call sc__ABILZeromodelB_append(s__eventServantAdd_e , 1.00)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvZeromodel__onAttackAbility)
            //call EV152ZeromodelB.append( eventServantAdd.e, 20 )
            call sc__ABILZeromodelB_append(s__eventServantAdd_e , 1.00)
        endif
    endfunction
