//Generated method caller for EV125MooncellD.actionSpellCast
function sc__EV125MooncellD_actionSpellCast takes nothing returns nothing
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            if GetUnitLevel(GetSpellTargetUnit()) == 7 then
                if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GP') == 0 then
                    if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A02W') == 0 then
                        return
                    endif
                else
                    call StartSoundForPlayerBJ(GetOwningPlayer(GetTriggerUnit()), gg_snd_Error)
                endif
            endif
        endif
        call UnitRemoveAbility(GetTriggerUnit(), 'A05B')
        call UnitAddAbility(GetTriggerUnit(), 'A05B')
        call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
endfunction

