//textmacro instance: 어빌리티_선언_개시("EXGawainNightless")
//end of: 어빌리티_선언_개시("EXGawainNightless")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0HR")
    
    function s__ABILEXGawainNightless_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXGawainNightless_onSpellEffect[this], s__ABILEXGawainNightless_onSpellEffectAction[this])
        set s__ABILEXGawainNightless_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILEXGawainNightless_onSpellEffect[this])
        set s__ABILEXGawainNightless_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILEXGawainNightless_rmTrig[this], s__ABILEXGawainNightless_rmAct[this])
        set s__ABILEXGawainNightless_rmAct[this]=null
        set s__ABILEXGawainNightless_rmTrig[this]=null
        call sc__ABILEXGawainNightless_onAbilityLost(this)
        set s__ABILEXGawainNightless_source[this]=null
        set s__ABILEXGawainNightless_exists[this]=false
    endfunction
    
    function s__ABILEXGawainNightless_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXGawainNightless_free(this)
    endfunction
    
    function s__ABILEXGawainNightless_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXGawainNightless_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXGawainNightless_exists[this] then
            set s__ABILEXGawainNightless_exists[this]=true
            set s__ABILEXGawainNightless_source[this]=src
            set s__ABILEXGawainNightless_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXGawainNightless_rmAct[this]=TriggerAddAction(s__ABILEXGawainNightless_rmTrig[this], function s__ABILEXGawainNightless_OnSourceRemove)
            set s__ABILEXGawainNightless_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILEXGawainNightless_onSpellEffect[this], Condition(function sc__ABILEXGawainNightless_conditionSpellEffect))
            set s__ABILEXGawainNightless_onSpellEffectAction[this]=TriggerAddAction(s__ABILEXGawainNightless_onSpellEffect[this], function sc__ABILEXGawainNightless_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILEXGawainNightless_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILEXGawainNightless_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILEXGawainNightless_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILEXGawainNightless_exists[this] then
            return
        endif
        call sc__ABILEXGawainNightless_onAbilityEffect(this)
    endfunction
    
    function s__ABILEXGawainNightless_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILEXGawainNightless_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0HR")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILEXGawainNightless_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILEXGawainNightless_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXGawainNightless_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call DisplayTextToPlayer(GetLocalPlayer(), 0.0, 0.0, s__pcs_get(GetOwningPlayer(GetSpellAbilityUnit())) + "|r reverses the time of SE.RA.PH back to |c00b0b0b009:00 AM|r!")
        call SetFloatGameState(GAME_STATE_TIME_OF_DAY, 8.99)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//textmacro instance: 어빌리티_선언_개시("EXGawainAttack")
//end of: 어빌리티_선언_개시("EXGawainAttack")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_추가타()
    function s__ABILEXGawainAttack_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXGawainAttack_rmTrig[this], s__ABILEXGawainAttack_rmAct[this])
        set s__ABILEXGawainAttack_rmAct[this]=null
        set s__ABILEXGawainAttack_rmTrig[this]=null
        call sc__ABILEXGawainAttack_onAbilityLost(this)
        set s__ABILEXGawainAttack_source[this]=null
        set s__ABILEXGawainAttack_exists[this]=false
    endfunction
    
    function s__ABILEXGawainAttack_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXGawainAttack_free(this)
    endfunction
    
    function s__ABILEXGawainAttack_onSourceUnitAttack takes nothing returns nothing
        local integer this
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set this=GetUnitIndex(GetTriggerUnit())
        call sc__ABILEXGawainAttack_onAbilityEffect(this)
    endfunction
    
    function s__ABILEXGawainAttack_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXGawainAttack_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXGawainAttack_exists[this] then
            set s__ABILEXGawainAttack_exists[this]=true
            set s__ABILEXGawainAttack_source[this]=src
            set s__ABILEXGawainAttack_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXGawainAttack_rmAct[this]=TriggerAddAction(s__ABILEXGawainAttack_rmTrig[this], function s__ABILEXGawainAttack_OnSourceRemove)
            
            call sc__EVServantAttack_addFunction(src , function s__ABILEXGawainAttack_onSourceUnitAttack)
            call sc__ABILEXGawainAttack_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_추가타()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXGawainAttack_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXGawainAttack_MESSAGE[0]="|c00FF4040Sei!|r"
        set s__ABILEXGawainAttack_MESSAGE[1]="|c00FF4040Ha!|r"
        set s__ABILEXGawainAttack_MESSAGE[2]="|c00FF4040Hu!|r"
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXGawainAttack_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXGawainAttack_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit source= GetTriggerUnit()
        local unit target= GetEventDamageSource()
        local boolean isDayTime= GetUnitAbilityLevel(source, 'A0HN') > 0
        local real mana= 5.0
        local real curMana
        if isDayTime then
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", source, "hand right"))
            call DestroyEffect(AddSpecialEffectTarget("FX\\Gawain\\Sun.mdl", target, "origin"))
            set mana=15.0
        else
            call s__bountyTag_custom(GetOwningPlayer(source) , GetUnitX(source) + GetRandomReal(- 64.0, 64.0) , GetUnitY(source) + 64 , s__ABILEXGawainAttack_MESSAGE[GetRandomInt(0, 2)])
        endif
        set curMana=GetUnitState(source, UNIT_STATE_MANA) + mana
        if curMana >= 300.0 then
            if isDayTime then
                call sc__TMGawainGalatin_cast(source , target , sc__EVDamageManager_getFinalDamage(source) * 30.0)
            else
                call sc__TMGawainGalatin_cast(source , target , sc__EVDamageManager_getFinalDamage(source) * 10.0)
            endif
            set curMana=0
        endif
        call SetUnitState(source, UNIT_STATE_MANA, curMana)
        
        call s__enemy_dealLogic(source , target , sc__EVDamageManager_getFinalDamage(source) , WEAPON_TYPE_WHOKNOWS , 1)
        set source=null
        set target=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("EXGawainSunPower")
//end of: 어빌리티_선언_개시("EXGawainSunPower")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILEXGawainSunPower_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXGawainSunPower_rmTrig[this], s__ABILEXGawainSunPower_rmAct[this])
        set s__ABILEXGawainSunPower_rmAct[this]=null
        set s__ABILEXGawainSunPower_rmTrig[this]=null
        call sc__ABILEXGawainSunPower_onAbilityLost(this)
        call s__tick_destroy(s__ABILEXGawainSunPower_durTik[this])
        set s__ABILEXGawainSunPower_source[this]=null
        set s__ABILEXGawainSunPower_exists[this]=false
    endfunction
    
    function s__ABILEXGawainSunPower_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXGawainSunPower_free(this)
    endfunction
    
    function s__ABILEXGawainSunPower_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILEXGawainSunPower_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILEXGawainSunPower_source[this]) then
            return
        endif
        call sc__ABILEXGawainSunPower_onAbilityEffect(this)
        call s__tick_start(s__ABILEXGawainSunPower_durTik[this],s__ABILEXGawainSunPower_duration[this] , false , function s__ABILEXGawainSunPower_onExpire)
    endfunction
    
    function s__ABILEXGawainSunPower_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXGawainSunPower_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXGawainSunPower_exists[this] then
            set s__ABILEXGawainSunPower_exists[this]=true
            set s__ABILEXGawainSunPower_source[this]=src
            set s__ABILEXGawainSunPower_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXGawainSunPower_rmAct[this]=TriggerAddAction(s__ABILEXGawainSunPower_rmTrig[this], function s__ABILEXGawainSunPower_OnSourceRemove)
            
            set s__ABILEXGawainSunPower_duration[this]=dur
            set s__ABILEXGawainSunPower_defaultDuration[this]=dur
            set s__ABILEXGawainSunPower_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILEXGawainSunPower_durTik[this],dur , false , function s__ABILEXGawainSunPower_onExpire)
            call sc__ABILEXGawainSunPower_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXGawainSunPower_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILEXGawainSunPower_PrevBonus[this]=0
        set s__ABILEXGawainSunPower_WasAlternate[this]=false
        set s__ABILEXGawainSunPower_SunAura[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXGawainSunPower_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        if s__ABILEXGawainSunPower_SunAura[this] != null then
            call DestroyEffect(s__ABILEXGawainSunPower_SunAura[this])
            set s__ABILEXGawainSunPower_SunAura[this]=null
        endif
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXGawainSunPower_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real time= GetFloatGameState(GAME_STATE_TIME_OF_DAY)
        local boolean isBonus= ( 9.0 < time and time < 12.0 ) or ( 15.0 < time and time < 18.0 )
        call sc__EVDamageManager_addBonus(s__ABILEXGawainSunPower_source[this] , - s__ABILEXGawainSunPower_PrevBonus[this])
        set s__ABILEXGawainSunPower_PrevBonus[this]=0
        if not isBonus then
            if not s__ABILEXGawainSunPower_WasAlternate[this] then
                set s__ABILEXGawainSunPower_WasAlternate[this]=true
                call AddUnitAnimationProperties(s__ABILEXGawainSunPower_source[this], "alternate", true)
            endif
            if s__ABILEXGawainSunPower_SunAura[this] != null then
                call DestroyEffect(s__ABILEXGawainSunPower_SunAura[this])
                set s__ABILEXGawainSunPower_SunAura[this]=null
            endif
            if not IsUnitDead(s__ABILEXGawainSunPower_source[this]) then
                call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HM', 1)
                call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HO', 1)
                call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HP', 1)
            endif
            return
        endif
        if s__ABILEXGawainSunPower_WasAlternate[this] then
            set s__ABILEXGawainSunPower_WasAlternate[this]=false
            call AddUnitAnimationProperties(s__ABILEXGawainSunPower_source[this], "alternate", false)
        endif
        if s__ABILEXGawainSunPower_SunAura[this] == null then
            set s__ABILEXGawainSunPower_SunAura[this]=AddSpecialEffectTarget("FXRD\\FX\\GoldTimer\\GoldTimer.mdl", s__ABILEXGawainSunPower_source[this], "origin")
        endif
        if not IsUnitDead(s__ABILEXGawainSunPower_source[this]) then
            call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HM', 2)
            call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HO', 2)
            call SetUnitAbilityLevel(s__ABILEXGawainSunPower_source[this], 'A0HP', 2)
        endif
        set s__ABILEXGawainSunPower_PrevBonus[this]=200
        call sc__EVDamageManager_addBonus(s__ABILEXGawainSunPower_source[this] , s__ABILEXGawainSunPower_PrevBonus[this])
        call sc__BUFFEXGawainDayTime_apply(s__ABILEXGawainSunPower_source[this] , 2.0)
        call FXRD_FXImmuneStunTimed(s__ABILEXGawainSunPower_source[this] , 2.0)
        call FXRD_FXImmuneKnockbackTimed(s__ABILEXGawainSunPower_source[this] , 2.0)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 어빌리티_선언_개시("EXGawainBestilac")
//end of: 어빌리티_선언_개시("EXGawainBestilac")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILEXGawainBestilac_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEXGawainBestilac_rmTrig[this], s__ABILEXGawainBestilac_rmAct[this])
        set s__ABILEXGawainBestilac_rmAct[this]=null
        set s__ABILEXGawainBestilac_rmTrig[this]=null
        call sc__ABILEXGawainBestilac_onAbilityLost(this)
        call s__tick_destroy(s__ABILEXGawainBestilac_durTik[this])
        set s__ABILEXGawainBestilac_source[this]=null
        set s__ABILEXGawainBestilac_exists[this]=false
    endfunction
    
    function s__ABILEXGawainBestilac_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEXGawainBestilac_free(this)
    endfunction
    
    function s__ABILEXGawainBestilac_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILEXGawainBestilac_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILEXGawainBestilac_source[this]) then
            return
        endif
        call sc__ABILEXGawainBestilac_onAbilityEffect(this)
        call s__tick_start(s__ABILEXGawainBestilac_durTik[this],s__ABILEXGawainBestilac_duration[this] , false , function s__ABILEXGawainBestilac_onExpire)
    endfunction
    
    function s__ABILEXGawainBestilac_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEXGawainBestilac_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEXGawainBestilac_exists[this] then
            set s__ABILEXGawainBestilac_exists[this]=true
            set s__ABILEXGawainBestilac_source[this]=src
            set s__ABILEXGawainBestilac_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEXGawainBestilac_rmAct[this]=TriggerAddAction(s__ABILEXGawainBestilac_rmTrig[this], function s__ABILEXGawainBestilac_OnSourceRemove)
            
            set s__ABILEXGawainBestilac_duration[this]=dur
            set s__ABILEXGawainBestilac_defaultDuration[this]=dur
            set s__ABILEXGawainBestilac_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILEXGawainBestilac_durTik[this],dur , false , function s__ABILEXGawainBestilac_onExpire)
            call sc__ABILEXGawainBestilac_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILEXGawainBestilac_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILEXGawainBestilac_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILEXGawainBestilac_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local boolean isDayTime= GetUnitAbilityLevel(s__ABILEXGawainBestilac_source[this], 'A0HN') > 0
        local real mana= 2.0
        if isDayTime then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", s__ABILEXGawainBestilac_source[this], "origin"))
            set mana=6.0
        endif
        call SetUnitState(s__ABILEXGawainBestilac_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILEXGawainBestilac_source[this], UNIT_STATE_MANA) + mana)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
//==================================================================
//　서번트 버프
