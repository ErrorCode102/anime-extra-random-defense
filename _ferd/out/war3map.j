function sa__EVDamageBounty_onSourceUnitDamage takes nothing returns boolean

        local integer this= s__EVDamageBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(GetEventDamageSource()))
        set s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id]=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] + GetEventDamage()
        if s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] > s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+s__EVDamageBounty_bestDamage[this]] then
            set s__EVDamageBounty_bestDamage[this]=id
        endif
   return true
endfunction
function sa__EVDamageBounty_onSourceUnitDeath takes nothing returns boolean

        local integer this= s__EVDamageBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(s__EVDamageBounty_mySource[this]))
        local real perc
        if not GAME_IS_PLAYING then
return true
        endif
        if id == 11 then
            set id=s__EVDamageBounty_bestDamage[this]
            if not USER_IS_PLAYING[id] then
return true
            endif
            set perc=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] / GetUnitState(s__EVDamageBounty_mySource[this], UNIT_STATE_MAX_LIFE) * 100
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Ace Reward - " + s__pcs_get(Player(id)) + "|r")
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Damage Done: |c008080FF" + I2S(R2I(s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id])) + "|r (" + R2S(perc) + "%)")
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80 - 2 Wisps|r")
            call CreateWisp(Player(id) , 2)
            set id=GetPlayerId(GetLocalPlayer())
            if USER_IS_PLAYING[id] then
                set perc=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] / GetUnitState(s__EVDamageBounty_mySource[this], UNIT_STATE_MAX_LIFE) * 100
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Damage done by you: |c008080FF" + I2S(R2I(s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id])) + "|r (" + R2S(perc) + "%)")
            endif
return true
        endif
   return true
endfunction
function sa__EVGameFinalizer_onSourceUnitRemove takes nothing returns boolean

        local integer this= s__EVGameFinalizer_getThis(s__EVUnitRemove_e)
        call TriggerRemoveAction(s__EVGameFinalizer_atDeath[this], s__EVGameFinalizer_onDeathAction[this])
        set s__EVGameFinalizer_onDeathAction[this]=null
        call DestroyTrigger(s__EVGameFinalizer_atDeath[this])
        set s__EVGameFinalizer_atDeath[this]=null
        set s__EVGameFinalizer_mySource[this]=null
        call TriggerUnbindAction(s__EVGameFinalizer_onRemoveAction[this])
        set s__EVGameFinalizer_onRemoveAction[this]=null
        call s__EVGameFinalizer_destroy(this)
   return true
endfunction
function sa__EVGameFinalizer_onSourceUnitDeath takes nothing returns boolean

        local integer this= s__EVGameFinalizer_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(s__EVGameFinalizer_mySource[this]))
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        if id == 11 then
            if not GAME_IS_PLAYING then
return true
            endif
            if PANALTY_COUNT > 0 then
                call CONTSetTerrainNormalMode()
            endif
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cff0080ffCongratulations!|r  You've cleared the game on " + LEVEL_NAME[LEVEL_CURRENT] + " |cff0080ffdifficulty!|r")
            if GAME_IS_ONLINE then
                call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cff0080ffThe game was played on LAN or Battle.net|r")
            endif
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|c004080ffPlaytime: " + s__playtime__get_hmsms() + "|r")
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cffff8000Player Name: " + USER_NAME[GetPlayerId(GetLocalPlayer())] + "|r")
            call TimerStart(CreateTimer(), 0.50, false, function s__EVGameFinalizer_onFinal)
return true
        endif
        set id=id - 4
        if not USER_IS_PLAYING[id] then
return true
        endif
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cff0080ffCongratulations!|r |cff0080ff You've completed speedrun on " + LEVEL_NAME[LEVEL_CURRENT])
        if GAME_IS_ONLINE then
            call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cff0080ffThe game was played on LAN or Battle.net|r")
        endif
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|c004080ffPlaytime: " + s__playtime__get_hmsms() + "|r")
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cffff8000Player Name: " + USER_NAME[id] + "|r")
        call RRRequestPlayer(REQUEST_GAME_PLAYER_VICTORY , Player(id))
   return true
endfunction
