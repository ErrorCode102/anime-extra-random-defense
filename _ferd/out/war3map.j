function sa__EVMissionTimeout_onSourceUnitDeath takes nothing returns boolean

        local integer this= s__EVMissionTimeout_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(s__EVMissionTimeout_mySource[this])) - 4
        call s__tickUI__set_visible(s__EVMissionTimeout_myTickUI[this],false)
        call s__tick_pause(s__EVMissionTimeout_myTick[this])
        call s__tick_pause(s__EVMissionTimeout_warnTick[this])
        call s__tick_pause(s__EVMissionTimeout_pauseTick[this])
        if s__EVMissionTimeout_fxBurst[this] != null then
            call DestroyEffect(s__EVMissionTimeout_fxBurst[this])
            set s__EVMissionTimeout_fxBurst[this]=null
        endif
        call CreateDummyCorpse('o00B' , GetUnitX(s__EVMissionTimeout_mySource[this]) , GetUnitY(s__EVMissionTimeout_mySource[this]) , 0.00 , 270 , 5.00 , 255 , 255 , 255 , 255)
   return true
endfunction
function sa__EVMissionTimeout_onWarn takes nothing returns boolean

        local integer this= s__tick_data[s__tick_getExpired()]
        set s__EVMissionTimeout_fxBurst[this]=AddSpecialEffectTarget("FXRD\\FX\\AlmostFail\\BlackSpoil.mdl", s__EVMissionTimeout_mySource[this], "origin")
        call s__tickUI_setTitleColor(s__EVMissionTimeout_myTickUI[this],255 , 0 , 0)
   return true
endfunction
function sa__EVMissionTimeout_onPause takes nothing returns boolean

        local integer this= s__tick_data[s__tick_getExpired()]
        if GetUnitAbilityLevel(s__EVMissionTimeout_mySource[this], 'A0ER') > 0 then
            call s__tickUI__set_title(s__EVMissionTimeout_myTickUI[this],"|c00808080Erosion stopped...|r")
            call PauseTimer(s__tick__get_super(s__EVMissionTimeout_myTick[this]))
            call PauseTimer(s__tick__get_super(s__EVMissionTimeout_pauseTick[this]))
            call PauseTimer(s__tick__get_super(s__EVMissionTimeout_warnTick[this]))
return true
        endif
   return true
endfunction
function sa__EVMissionTimeout_onExpire takes nothing returns boolean

        local integer this= s__tick_data[s__tick_getExpired()]
        local integer id= GetPlayerId(GetOwningPlayer(s__EVMissionTimeout_mySource[this])) - 4
        if IsUnitType(s__EVMissionTimeout_mySource[this], UNIT_TYPE_DEAD) then
return true
        endif
        if not s__EVMissionTimeout_longing[this] then
            if GetUnitAbilityLevel(s__EVMissionTimeout_mySource[this], 'A07G') > 0 then
                set s__EVMissionTimeout_longing[this]=true
                if s__EVMissionTimeout_killAll[this] then
                    call s__tickUI__set_title(s__EVMissionTimeout_myTickUI[this],"|c00D040D0Until the end of Seraphix...|r")
                else
                    call s__tickUI__set_title(s__EVMissionTimeout_myTickUI[this],"|c00D040D0Extra Time|r: " + s__pcs__staticgetindex(id) + USER_NAME_CURRENT[id])
                endif
                call s__tick_start(s__EVMissionTimeout_myTick[this],60.00 , false , function s__EVMissionTimeout_onExpire)
                call SetUnitVertexColor(s__EVMissionTimeout_mySource[this], 255, 255, 255, 128)
                if s__EVMissionTimeout_fxBurst[this] != null then
                    call DestroyEffect(s__EVMissionTimeout_fxBurst[this])
                endif
                set s__EVMissionTimeout_fxBurst[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\Banish\\BanishTarget.mdl", s__EVMissionTimeout_mySource[this], "origin")
return true
            endif
        endif
        if s__EVMissionTimeout_fxBurst[this] != null then
            call DestroyEffect(s__EVMissionTimeout_fxBurst[this])
            set s__EVMissionTimeout_fxBurst[this]=null
        endif
        call CreateDummy('o001' , GetUnitX(s__EVMissionTimeout_mySource[this]) , GetUnitY(s__EVMissionTimeout_mySource[this]) , 0.00 , 270 , 3.00 , 255 , 255 , 255 , 128)
        if s__EVMissionTimeout_killAll[this] then
            call CleanupUser(Player(0))
            call CleanupUser(Player(1))
            call CleanupUser(Player(2))
            call CleanupUser(Player(3))
        else
            call CleanupUser(Player(id))
        endif
        call ShowUnit(s__EVMissionTimeout_mySource[this], false)
   return true
endfunction
