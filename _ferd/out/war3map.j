// scope CONTKillBonus begins
    function CONTKillBonus___GiveKillBountyToPlayer takes player p,integer bountylevel returns nothing
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        if bountylevel == 1 and LEVEL_CURRENT <= LEVEL_NORMAL then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills")
            call DisplayTextToPlayer(p, 0.00, 0.00, "    - SE.RA.PH difficulty or lower\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 4 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
        if bountylevel == 2 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 5 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
        if bountylevel == 3 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 5 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
        if bountylevel == 4 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 6 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
        if bountylevel == 5 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 6 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
        if bountylevel == 6 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "|c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills achieved - " + s__pcs_get(p) + "|r")
            call DisplayTextToPlayer(p, 0.00, 0.00, "\n  |c00FFFF00Mission accomplished|r\n\n    - Enemy |c004080FF" + I2S(CONTKillBonus___bonusreq[bountylevel - 1]) + "|r kills\n\n")
            call StartSoundForPlayerBJ(p, gg_snd_MissionDone)
            call s__servant_add(p , s__gacha_do(p , 7 , x , y , 270) , s__servant_BOUNTY)
            return
        endif
    endfunction
    function CONTKillBonus___OnAction takes nothing returns nothing
        local integer pid= GetPlayerId(s__eventCustom_getTriggerPlayer())
        if CONTKillBonus___bonuslevel[pid] >= CONTKillBonus___MAXBONUSLEVEL then
            return
        endif
        set CONTKillBonus___killcount[pid]=CONTKillBonus___killcount[pid] + 1
        if CONTKillBonus___killcount[pid] < CONTKillBonus___bonusreq[CONTKillBonus___bonuslevel[pid]] then
            return
        endif
        set CONTKillBonus___bonuslevel[pid]=CONTKillBonus___bonuslevel[pid] + 1
        call CONTKillBonus___GiveKillBountyToPlayer(s__eventCustom_getTriggerPlayer() , CONTKillBonus___bonuslevel[pid])
    endfunction
    function CONTKillBonus___config takes nothing returns nothing
        set CONTKillBonus___bonusreq[0]=500
        set CONTKillBonus___bonusreq[1]=1000
        set CONTKillBonus___bonusreq[2]=2500
        set CONTKillBonus___bonusreq[3]=5000
        set CONTKillBonus___bonusreq[4]=8000
        set CONTKillBonus___bonusreq[5]=10000
    endfunction
    function CONTKillBonus___main takes nothing returns nothing
        call CONTKillBonus___config()
        call s__eventCustom_addAction(EVENT_USER_KILL , function CONTKillBonus___OnAction)
    endfunction
