    function s__EV119AlteraD_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV119AlteraD_getThis(GetUnitUserData(GetTriggerUnit()))
        local real tx= GetSpellTargetX()
        local real ty= GetSpellTargetY()
        call s__CMSwipe_cast(GetTriggerUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) * 20.00 , tx , ty , s__EV119AlteraD_mySize[this])
    endfunction
    function s__EV119AlteraD_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == 'A04I'
    endfunction
    function s__EV119AlteraD_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV119AlteraD_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EV119AlteraD_onSpellEffect[this], s__EV119AlteraD_onSpellEffectAction[this])
        set s__EV119AlteraD_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV119AlteraD_onSpellEffect[this])
        set s__EV119AlteraD_onSpellEffect[this]=null
        set s__EV119AlteraD_myServant[this]=null
        call TriggerUnbindAction(s__EV119AlteraD_onRemoveAction[this])
        set s__EV119AlteraD_onRemoveAction[this]=null
        //종결
        call s__EV119AlteraD_destroy(this)
    endfunction


//===========================================================================
// Trigger: EV 120 JeanneAlterA
//===========================================================================

    
    function s__EV120JeanneAlterA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV120JeanneAlterA_STRUCT_ID)
    endfunction
    
    function s__EV120JeanneAlterA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV120JeanneAlterA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV120JeanneAlterA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV120JeanneAlterA__allocate()
        set s__EV120JeanneAlterA_ID[this]=GetUnitUserData(src)
        call s__EV120JeanneAlterA_setThis(s__EV120JeanneAlterA_ID[this] , this)
        return this
    endfunction
    
    function s__EV120JeanneAlterA_destroy takes integer this returns nothing
        call s__EV120JeanneAlterA_setThis(s__EV120JeanneAlterA_ID[this] , 0)
        call s__EV120JeanneAlterA_deallocate(this)
    endfunction
    
    //API
    
    function s__EV120JeanneAlterA_append takes unit src,real dmg,boolean dopen,boolean dokick returns nothing
        local integer this= s__EV120JeanneAlterA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV120JeanneAlterA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV120JeanneAlterA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV120JeanneAlterA_onSourceUnitRemove)
        set s__EV120JeanneAlterA_myServant[this]=src
        set s__EV120JeanneAlterA_myLastTarget[this]=null
        set s__EV120JeanneAlterA_myDamage[this]=dmg
        set s__EV120JeanneAlterA_myPen[this]=dopen
        set s__EV120JeanneAlterA_myKick[this]=dokick
        set s__EV120JeanneAlterA_myFx[this]=null
        
        set s__EV120JeanneAlterA_myCoolTick[this]=s__tick_create(this)
        call s__EVServantAttack_addFunction(src , function sc__EV120JeanneAlterA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV120JeanneAlterA_onCooldOver takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV120JeanneAlterA_myServant[this], UNIT_TYPE_DEAD) then
            if s__EV120JeanneAlterA_myFx[this] != null then
                call DestroyEffect(s__EV120JeanneAlterA_myFx[this])
                set s__EV120JeanneAlterA_myFx[this]=null
            endif
            set s__EV120JeanneAlterA_myLastTarget[this]=null
            call s__tick_pause(s__EV120JeanneAlterA_myCoolTick[this])
            return
        endif
        if IsUnitType(s__EV120JeanneAlterA_myLastTarget[this], UNIT_TYPE_DEAD) then
            if s__EV120JeanneAlterA_myFx[this] != null then
                call DestroyEffect(s__EV120JeanneAlterA_myFx[this])
                set s__EV120JeanneAlterA_myFx[this]=null
            endif
            set s__EV120JeanneAlterA_myLastTarget[this]=null
            call s__tick_pause(s__EV120JeanneAlterA_myCoolTick[this])
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__EV120JeanneAlterA_myLastTarget[this], "chest"))
        call s__EVDebuffSlow_apply(s__EV120JeanneAlterA_myLastTarget[this] , 0.60)
        call s__enemy_dealLogicEx(s__EV120JeanneAlterA_myServant[this] , s__EV120JeanneAlterA_myLastTarget[this] , s__EV120JeanneAlterA_myDamage[this] , s__EV120JeanneAlterA_myPen[this] , s__EV120JeanneAlterA_myKick[this] , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function s__EV120JeanneAlterA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV120JeanneAlterA_getThis(GetUnitUserData(src))
        if s__EV120JeanneAlterA_myLastTarget[this] != dst then
            if s__EV120JeanneAlterA_myFx[this] != null then
                call DestroyEffect(s__EV120JeanneAlterA_myFx[this])
            endif
            set s__EV120JeanneAlterA_myFx[this]=AddSpecialEffectTarget("FX\\Kiara\\Soul.mdl", dst, "overhead")
            call s__tick_start(s__EV120JeanneAlterA_myCoolTick[this],0.50 , true , function s__EV120JeanneAlterA_onCooldOver)
            set s__EV120JeanneAlterA_myLastTarget[this]=dst
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV120JeanneAlterA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV120JeanneAlterA_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV120JeanneAlterA_myFx[this] != null then
            call DestroyEffect(s__EV120JeanneAlterA_myFx[this])
            set s__EV120JeanneAlterA_myFx[this]=null
        endif
        call s__tick_destroy(s__EV120JeanneAlterA_myCoolTick[this])
        set s__EV120JeanneAlterA_myLastTarget[this]=null
        set s__EV120JeanneAlterA_myServant[this]=null
        call TriggerUnbindAction(s__EV120JeanneAlterA_onRemoveAction[this])
        set s__EV120JeanneAlterA_onRemoveAction[this]=null
        //종결
        call s__EV120JeanneAlterA_destroy(this)
    endfunction
    
    

