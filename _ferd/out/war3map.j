    function FXAutoSave___CallBack takes nothing returns nothing
        local integer id= s__tick_data[s__tick_getExpired()]
        call s__SaveData_encode(Player(id))
    endfunction
    
    function FXAutoSave___onGamePlayerResulted takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        //세이브코드 작성
        if GAME_IS_ONLINE then
            call DisplayTextToPlayer(p, 0, 0, "|c00FF8000※Notice: Save code will be saved after 10 seconds|r")
            call DisplayTextToPlayer(p, 0, 0, "|c00FFFF00※Notice: If you leave now, you will not be able to obtain the XP|r")
            if FXAutoSave___MODULE_TIMER[id] == 0 then
                set FXAutoSave___MODULE_TIMER[id]=s__tick_create(id)
            endif
            call s__tick_start(FXAutoSave___MODULE_TIMER[id],10.00 , false , function FXAutoSave___CallBack)
        else
            call DisplayTimedTextToPlayer(p, 0, 0, 60, "|c00ff8000Notice: You cannot save your achievements in offline custom game.|r")
            call DisplayTimedTextToPlayer(p, 0, 0, 60, "|c00ff8000Notice: Feel free to enjoy it on LAN or Battle.net|r")
            call DisplayTimedTextToPlayer(p, 0, 0, 60, "|c000080ffNotice: Singleplayer via LAN allows you to save your achievements.|r")
        endif
        set p=null
    endfunction

    function FXAutoSave___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_GAME_PLAYER_RESULT , function FXAutoSave___onGamePlayerResulted)
    endfunction
    
// scope FXAutoSave ends
// Trigger: Mod FXResultXPCalc
//===========================================================================
// scope FXResultXPCalc begins

    function FXResultXPCalc___onGamePlayerResulted takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        local integer resultUI= (id)
        local boolean isVictory= s__GameResponse__get_Id(res) == s__FXGameResult_Victory
        local integer axp= 0
        
        // 스피드런 모드 (시간 기록)
        if MODE_CURRENT == MODE_SPEEDRUN and isVictory then
            set FXRD_CLEAR_TIME[id]=s__playtime__get_current()
            call s__statusBoard_finishWave(p)
        endif
        //협동 모드 (추가 경험치 계산)
        if MODE_CURRENT == MODE_TEAM and isVictory then
            set USER_XP_BONUS[id]=USER_XP_BONUS[id] + R2I(50 * CountInGameUser() / 4)
        endif
        
        set s__FXResultInterface_Result[resultUI]=s__GameResponse__get_Id(res)
        set s__FXResultInterface_PlayerFaction[resultUI]=FXGetPlayerCurrentFaction(p)
        // '경험치 부여 전' 상태 반영
        set s__FXResultInterface_CurPlayerMastered[resultUI]=FXIsPlayerCurrentFactionMastered(p)
        set s__FXResultInterface_CurPlayerLevel[resultUI]=FXGetPlayerLevel(p)
        set s__FXResultInterface_CurPlayerXP[resultUI]=FXGetPlayerXp(p)
        
        set s__FXResultInterface_CurXPBase[resultUI]=0
        set s__FXResultInterface_CurXPBonus[resultUI]=0
        set s__FXResultInterface_CurXP[resultUI]=0
        
        if isVictory then
            set s__FXResultInterface_XPBase[resultUI]=LEVEL_XP[LEVEL_CURRENT]
            set s__FXResultInterface_XPBonus[resultUI]=s__FXResultInterface_XPBase[resultUI] * USER_XP_BONUS[id] / 100
            set s__FXResultInterface_XP[resultUI]=s__FXResultInterface_XPBase[resultUI] + s__FXResultInterface_XPBonus[resultUI]
            set axp=s__FXResultInterface_XP[resultUI]
        else
            //경험치 보너스 손실
            set USER_XP_BONUS[id]=0
            //진행한 라운드 비례 50% 보상
            set axp=LEVEL_WAVE[LEVEL_CURRENT] / 2
            set axp=IMaxBJ(0, GetUserWave(p) - axp) * 50 / axp
            set axp=LEVEL_XP[LEVEL_CURRENT] * axp / 100
            
            set s__FXResultInterface_XPBase[resultUI]=axp
            set s__FXResultInterface_XPBonus[resultUI]=0
            set s__FXResultInterface_XP[resultUI]=axp
        endif
        //경험치 부여
        call FXAddPlayerXp(p , axp)
        set USER_IS_MASTER[id]=FXIsPlayerCurrentFactionMastered(p)
        // 부여 결과 반영
        set s__FXResultInterface_PlayerMastered[resultUI]=FXIsPlayerCurrentFactionMastered(p)
        if s__FXResultInterface_PlayerMastered[resultUI] != s__FXResultInterface_CurPlayerMastered[resultUI] then
            set s__FXResultInterface_PlayerLevel[resultUI]=FX_FACTION_MAX_LEVEL
            set s__FXResultInterface_PlayerXP[resultUI]=0
        else
            set s__FXResultInterface_PlayerLevel[resultUI]=FXGetPlayerLevel(p)
            set s__FXResultInterface_PlayerXP[resultUI]=FXGetPlayerXp(p)
        endif
        //플레이타임 누적
        set FXRD_CLEAR_TIME[id]=s__playtime__get_current()
        set DATA_PLAYTIME[id]=DATA_PLAYTIME[id] + R2I(FXRD_CLEAR_TIME[id] / 60)
        
        set p=null
    endfunction

    function FXResultXPCalc___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_GAME_PLAYER_RESULT , function FXResultXPCalc___onGamePlayerResulted)
    endfunction
    
