    //기본 서번트 스탯 설정
    //구현부
    function SvLeesm___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvLeesm___onAttackStun takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call FXRD_FXDebuffShock(dst , 0.10)
        call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 5)
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvLeesm___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvLeesm___ODMG[lv])
        //Adding Special Skillz
        if lv == 2 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvLeesm___onAttack)
        endif
        if lv == 3 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvLeesm___onAttack)
        endif
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvLeesm___onAttackStun)
