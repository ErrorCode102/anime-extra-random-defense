            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVRHYME__LesserAttack)
        endfunction
        function SVRHYME__OnUpperLevel takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            if lv == 4 then
                call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVRHYME__EnhancedAttackB)
            endif
            if lv == 5 then
                call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVRHYME__EnhancedAttackA)
                call sc__ABILRhymeB_append(s__eventServantAdd_e , 1.00)
            endif
            if lv == 6 then
                call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVRHYME__EnhancedAttackS)
                call sc__ABILRhymeB_append(s__eventServantAdd_e , 1.00)
            endif
        endfunction
        
