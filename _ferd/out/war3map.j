// Trigger: FX Trig Killed Enemy
//===========================================================================
// scope PLAYfactionkillbounty begins
    function PLAYfactionkillbounty___onDeath takes nothing returns nothing
        local integer id
        local boolean isNormalEnemy= IsUnitType(GetTriggerUnit(), UNIT_TYPE_UNDEAD)
        if isNormalEnemy then
            call AddEnemyRemain(GetOwningPlayer(GetTriggerUnit()) , - 1)
        endif
        if GetKillingUnit() == null then
            return
        endif
        set id=GetPlayerId(GetOwningPlayer(GetKillingUnit()))
        if not USER_IS_PLAYING[id] then
            return
        endif
        // 킬 수 기록
        call AddUserScore(Player(id) , 1)
        call s__statusBoard_refreshKill()
        // 킬 이벤트 발동
        call s__eventCustom_evaluate(EVENT_USER_KILL , Player(id) , GetTriggerUnit() , null , 0)
    endfunction
    function PLAYfactionkillbounty___main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function PLAYfactionkillbounty___onDeath)
        call TriggerRegisterPlayerUnitEvent(t, Player(4), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(5), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(6), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(7), EVENT_PLAYER_UNIT_DEATH, null)
        call TriggerRegisterPlayerUnitEvent(t, Player(11), EVENT_PLAYER_UNIT_DEATH, null)
        set t=null
    endfunction
// scope PLAYfactionkillbounty ends
