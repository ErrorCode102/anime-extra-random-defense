//유닛이 제거되면, 제거됨 개인 이벤트를 돌립니다.
    //API
    function s__EVUnitRemove_bind takes unit src,code c returns triggeraction
        local integer id= GetUnitUserData(src)
        local hashtable idTab= GetCustomDataTable(id)
        local integer idKey= GetCustomDataKey(id)
        local integer this= LoadInteger(idTab, 0, idKey + s__EVUnitRemove_STRUCT_ID)
        return TriggerBindAction(s__EVUnitRemove_TR[this] , c , null)
    endfunction
    function s__EVUnitRemove_append takes unit src returns nothing
        local integer id= GetUnitUserData(src)
        local hashtable idTab= GetCustomDataTable(id)
        local integer idKey= GetCustomDataKey(id)
        call sc__EVUnitRemove_new(idTab , idKey , src)
        set idTab=null
    endfunction
    //생성자, 소멸자
    function s__EVUnitRemove_new takes hashtable idTab,integer idKey,unit src returns nothing
        local integer this= s__EVUnitRemove__allocate()
        set s__EVUnitRemove_TR[this]=CreateTrigger()
        call SaveInteger(idTab, 0, idKey + s__EVUnitRemove_STRUCT_ID, this)
        set s__EVUnitRemove_ARU[s__EVUnitRemove_ARMX]=src
        set s__EVUnitRemove_ARID[s__EVUnitRemove_ARMX]=GetUnitUserData(src)
        set s__EVUnitRemove_ARMX=s__EVUnitRemove_ARMX + 1
        if s__EVUnitRemove_TB then
            set s__EVUnitRemove_TB=false
            set s__EVUnitRemove_TC=0
            call TimerStart(s__EVUnitRemove_T, 0.04, true, function sc__EVUnitRemove_onCallback)
        endif
    endfunction
    //구현부
    function s__EVUnitRemove_onFire takes integer id returns nothing
        local integer prevE= s__EVUnitRemove_e
        local hashtable idTab= GetCustomDataTable(id)
        local integer idKey= GetCustomDataKey(id)
        local integer this= LoadInteger(idTab, 0, idKey + s__EVUnitRemove_STRUCT_ID)
        set s__EVUnitRemove_e=id
        call TriggerExecute(s__EVUnitRemove_TR[this])
        set s__EVUnitRemove_e=prevE
        call DestroyTrigger(s__EVUnitRemove_TR[this])
        call SaveInteger(idTab, 0, idKey + s__EVUnitRemove_STRUCT_ID, 0)
        call s__EVUnitRemove_deallocate(this)
        set s__EVUnitRemove_TR[this]=null
    endfunction
    
    
    
    
    function s__EVUnitRemove_onCallback takes nothing returns nothing
        if s__EVUnitRemove_TC >= s__EVUnitRemove_ARMX then
            set s__EVUnitRemove_TC=0
            if s__EVUnitRemove_ARMX == 0 then
                set s__EVUnitRemove_TB=true
                call PauseTimer(s__EVUnitRemove_T)
                return
            endif
        endif
        if GetUnitTypeId(s__EVUnitRemove_ARU[s__EVUnitRemove_TC]) != 0 then
            set s__EVUnitRemove_TC=s__EVUnitRemove_TC + 1
            return
        endif
        call s__EVUnitRemove_onFire(s__EVUnitRemove_ARID[s__EVUnitRemove_TC])
        set s__EVUnitRemove_ARMX=s__EVUnitRemove_ARMX - 1
        set s__EVUnitRemove_ARU[s__EVUnitRemove_TC]=s__EVUnitRemove_ARU[s__EVUnitRemove_ARMX]
        set s__EVUnitRemove_ARID[s__EVUnitRemove_TC]=s__EVUnitRemove_ARID[s__EVUnitRemove_ARMX]
        set s__EVUnitRemove_ARU[s__EVUnitRemove_ARMX]=null
        set s__EVUnitRemove_ARID[s__EVUnitRemove_ARMX]=0
    endfunction
//===========================================================================
// Trigger: EV 2 TeleportControl
//===========================================================================
    //Api
    function s__EVTeleportControl_append takes unit src returns nothing
        local integer id= GetUnitUserData(src)
        local hashtable idTab= GetCustomDataTable(id)
        local integer idKey= GetCustomDataKey(id)
        call sc__EVTeleportControl_new(idTab , idKey , src)
        set idTab=null
    endfunction
    //생성자, 소멸자
    function s__EVTeleportControl_new takes hashtable idTab,integer idKey,unit src returns nothing
        local integer this= s__EVTeleportControl__allocate()
        set s__EVTeleportControl_ONRM[this]=s__EVUnitRemove_bind(src , function sc__EVTeleportControl_onSourceUnitRemove)
        set s__EVTeleportControl_SRC[this]=src
        call UnitAddAbility(src, 'A000')
        //=====================================FACTION BONUS====================================
        if FXGetPlayerCurrentFaction(GetOwningPlayer(src)) == FX_FACTION_TAMAMO then
            call UnitAddAbility(src, 'A0BQ')
        else
            call UnitAddAbility(src, 'A0BP')
        endif
        //====================================================================================
        set s__EVTeleportControl_ONSMART[this]=CreateTrigger()
        call TriggerAddCondition(s__EVTeleportControl_ONSMART[this], Filter(function sc__EVTeleportControl_onSmart))
        call TriggerRegisterUnitEvent(s__EVTeleportControl_ONSMART[this], src, EVENT_UNIT_ISSUED_POINT_ORDER)
        call TriggerRegisterUnitEvent(s__EVTeleportControl_ONSMART[this], src, EVENT_UNIT_ISSUED_TARGET_ORDER)
        set s__EVTeleportControl_ONCAST[this]=CreateTrigger()
        call TriggerAddCondition(s__EVTeleportControl_ONCAST[this], Filter(function sc__EVTeleportControl_onCast))
        call TriggerRegisterUnitEvent(s__EVTeleportControl_ONCAST[this], src, EVENT_UNIT_SPELL_CHANNEL)
        set s__EVTeleportControl_ONFINISH[this]=CreateTrigger()
        call TriggerAddCondition(s__EVTeleportControl_ONFINISH[this], Filter(function sc__EVTeleportControl_onFinish))
        call TriggerRegisterUnitEvent(s__EVTeleportControl_ONFINISH[this], src, EVENT_UNIT_SPELL_ENDCAST)
        set s__EVTeleportControl_ONEFFECT[this]=CreateTrigger()
        call TriggerAddCondition(s__EVTeleportControl_ONEFFECT[this], Filter(function sc__EVTeleportControl_onEffect))
        call TriggerRegisterUnitEvent(s__EVTeleportControl_ONEFFECT[this], src, EVENT_UNIT_SPELL_EFFECT)
        //
        call SaveInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID, this)
    endfunction
    function s__EVTeleportControl_remove takes integer id returns nothing
        local hashtable idTab= GetCustomDataTable(id)
        local integer idKey= GetCustomDataKey(id)
        local integer this= LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        //
        if s__EVTeleportControl_FX[this] != null then
            call DestroyEffect(s__EVTeleportControl_FX[this])
            set s__EVTeleportControl_FX[this]=null
        endif
        if s__EVTeleportControl_DST[this] != null then
            call DestroyEffect(s__EVTeleportControl_DST[this])
            set s__EVTeleportControl_DST[this]=null
        endif
        call DestroyTrigger(s__EVTeleportControl_ONSMART[this])
        set s__EVTeleportControl_ONSMART[this]=null
        call DestroyTrigger(s__EVTeleportControl_ONCAST[this])
        set s__EVTeleportControl_ONCAST[this]=null
        call DestroyTrigger(s__EVTeleportControl_ONFINISH[this])
        set s__EVTeleportControl_ONFINISH[this]=null
        call DestroyTrigger(s__EVTeleportControl_ONEFFECT[this])
        set s__EVTeleportControl_ONEFFECT[this]=null
        //
        call TriggerUnbindAction(s__EVTeleportControl_ONRM[this])
        set s__EVTeleportControl_ONRM[this]=null
        call SaveInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID, 0)
        set s__EVTeleportControl_SRC[this]=null
        set idTab=null
        call s__EVTeleportControl_deallocate(this)
    endfunction
    //구현부
    function s__EVTeleportControl_onSmart takes nothing returns boolean
        local integer id
        local integer lv
        local real x
        local real y
        local real px
        local real py
        if GetIssuedOrderId() != OrderId("smart") then
            return false
        endif
        if GetOrderTarget() != null then
            set x=GetWidgetX(GetOrderTarget())
            set y=GetWidgetY(GetOrderTarget())
        else
            set x=GetOrderPointX()
            set y=GetOrderPointY()
        endif
        set id=GetPlayerId(GetOwningPlayer(GetOrderedUnit()))
        if IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            set lv=GetUnitLevel(GetOrderedUnit())
            if IsUnitType(GetOrderedUnit(), UNIT_TYPE_HERO) then
                set lv=8
            endif
            if IsPointInRegion(ZONE_TELEPORTABLE[id], x, y) then
                return false
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 0 then
                return false
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 1 then
                if lv > 3 then
                    return false
                endif
            endif
            if FXGetPlayerServantSellSetting(Player(id)) == 2 then
                if lv > 5 then
                    return false
                endif
            endif
            call IssueImmediateOrder(GetOrderedUnit(), "neutralinteract")
            return false
        endif
        if not IsPointInRegion(ZONE_TELEPORTABLE[id], x, y) then
            return false
        endif
        set px=GetUnitX(GetOrderedUnit())
        set py=GetUnitY(GetOrderedUnit())
        if IsPointInRegion(ZONE_TELEPORTABLE1[0], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[0], px, py) then
            return false
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[1], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[1], px, py) then
            return false
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[2], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[2], px, py) then
            return false
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE1[3], x, y) and IsPointInRegion(ZONE_TELEPORTABLE1[3], px, py) then
            return false
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE2[id], x, y) and IsPointInRegion(ZONE_TELEPORTABLE2[id], px, py) then
            return false
        endif
        if IsPointInRegion(ZONE_TELEPORTABLE3[id], x, y) and IsPointInRegion(ZONE_TELEPORTABLE3[id], px, py) then
            return false
        endif
        call IssuePointOrder(GetOrderedUnit(), "mount", x, y)
        return false
    endfunction
    function s__EVTeleportControl_onCast takes nothing returns boolean
        local integer id
        local hashtable idTab
        local integer idKey
        local integer this
        if GetObjectName(GetSpellAbilityId()) != "[Teleport]" then
            if GetObjectName(GetSpellAbilityId()) != "[Sale]" then
                return false
            endif
            set id=GetUnitUserData(GetTriggerUnit())
            set idTab=GetCustomDataTable(id)
            set idKey=GetCustomDataKey(id)
            set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
            set s__EVTeleportControl_FX[this]=AddSpecialEffectTarget("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", GetTriggerUnit(), "overhead")
            set s__EVTeleportControl_DST[this]=AddSpecialEffectTarget("FX\\ProgressSellBar\\Bar.mdl", GetTriggerUnit(), "overhead")
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Items\\ResourceItems\\ResourceEffectTarget.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit())))
            set idTab=null
            return false
        endif
        set id=GetUnitUserData(GetTriggerUnit())
        set idTab=GetCustomDataTable(id)
        set idKey=GetCustomDataKey(id)
        set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        set s__EVTeleportControl_FX[this]=AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTo.mdl", GetUnitX(GetTriggerUnit()), GetUnitY(GetTriggerUnit()))
        set s__EVTeleportControl_DST[this]=AddSpecialEffect("Abilities\\Spells\\Other\\Aneu\\AneuTarget.mdl", GetSpellTargetX(), GetSpellTargetY())
        set idTab=null
        return false
    endfunction
    function s__EVTeleportControl_onFinish takes nothing returns boolean
        local integer id
        local hashtable idTab
        local integer idKey
        local integer this
        if GetObjectName(GetSpellAbilityId()) != "[Teleport]" then
            if GetObjectName(GetSpellAbilityId()) != "[Sale]" then
                return false
            endif
            set id=GetUnitUserData(GetTriggerUnit())
            set idTab=GetCustomDataTable(id)
            set idKey=GetCustomDataKey(id)
            set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
            if s__EVTeleportControl_FX[this] != null then
                call DestroyEffect(s__EVTeleportControl_FX[this])
                set s__EVTeleportControl_FX[this]=null
            endif
            if s__EVTeleportControl_DST[this] != null then
                call DestroyEffect(s__EVTeleportControl_DST[this])
                set s__EVTeleportControl_DST[this]=null
            endif
            set idTab=null
            return false
        endif
        set id=GetUnitUserData(GetTriggerUnit())
        set idTab=GetCustomDataTable(id)
        set idKey=GetCustomDataKey(id)
        set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        if s__EVTeleportControl_FX[this] != null then
            call DestroyEffect(s__EVTeleportControl_FX[this])
            set s__EVTeleportControl_FX[this]=null
        endif
        if s__EVTeleportControl_DST[this] != null then
            call DestroyEffect(s__EVTeleportControl_DST[this])
            set s__EVTeleportControl_DST[this]=null
        endif
        set idTab=null
        return false
    endfunction
    function s__EVTeleportControl_onEffect takes nothing returns boolean
        local integer id
        local hashtable idTab
        local integer idKey
        local integer this
        local string pth
        if GetObjectName(GetSpellAbilityId()) != "[Teleport]" then
            return false
        endif
        set id=GetUnitUserData(GetTriggerUnit())
        set idTab=GetCustomDataTable(id)
        set idKey=GetCustomDataKey(id)
        set this=LoadInteger(idTab, 0, idKey + s__EVTeleportControl_STRUCT_ID)
        set pth=GetAbilityEffectById(GetSpellAbilityId(), EFFECT_TYPE_LIGHTNING, 0)
        call s__bountyTag_custom(GetOwningPlayer(GetTriggerUnit()) , GetSpellTargetX() , GetSpellTargetY() , GetAbilityEffectById(GetSpellAbilityId(), EFFECT_TYPE_TARGET, 0))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())))
        call SetUnitX(GetSpellAbilityUnit(), GetSpellTargetX())
        call SetUnitY(GetSpellAbilityUnit(), GetSpellTargetY())
        call DestroyEffect(AddSpecialEffect(pth, GetUnitX(GetSpellAbilityUnit()), GetUnitY(GetSpellAbilityUnit())))
        set idTab=null
        return false
    endfunction
    function s__EVTeleportControl_onSourceUnitRemove takes nothing returns nothing
        local integer id= s__EVUnitRemove_e
        call s__EVTeleportControl_remove(id)
    endfunction
// Trigger: EV 3 DamageManager
//===========================================================================

    function s__EVDamageManager_onInit takes nothing returns nothing
        set s__EVDamageManager_ABID[0]='A033'
        set s__EVDamageManager_ABID[1]='A03D'
        set s__EVDamageManager_ABID[2]='A03S'
        set s__EVDamageManager_ABID[3]='A03T'
        set s__EVDamageManager_ABID[4]='A03U'
        set s__EVDamageManager_ABID[5]='A027'
    endfunction

    function s__EVDamageManager_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVDamageManager_STRUCT_ID)
    endfunction
    function s__EVDamageManager_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVDamageManager_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    function s__EVDamageManager_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVDamageManager__allocate()
        set s__EVDamageManager_ID[this]=GetUnitUserData(src)
        call s__EVDamageManager_setThis(s__EVDamageManager_ID[this] , this)
        return this
    endfunction
    function s__EVDamageManager_destroy takes integer this returns nothing
        call s__EVDamageManager_setThis(s__EVDamageManager_ID[this] , 0)
        call s__EVDamageManager_deallocate(this)
    endfunction
    
    //Members
    //-Original
    //-Bonus
    //-Finals
    
    //API
    function s__EVDamageManager_append takes unit src returns nothing
        local integer this= s__EVDamageManager_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVDamageManager application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVDamageManager_ONRM[this]=s__EVUnitRemove_bind(src , function sc__EVDamageManager_onSourceUnitRemove)
        set s__EVDamageManager_SRC[this]=src
        set s__EVDamageManager_ODMG[this]=0
        set s__EVDamageManager_ADMG[this]=0
        set s__EVDamageManager_PDMG[this]=100
        set s__EVDamageManager_BPDMG[this]=100
        set s__EVDamageManager_FODMG[this]=0
        set s__EVDamageManager_FDMG[this]=0
        call sc__EVDamageManager_preload(src)
    endfunction
    function s__EVDamageManager_preload takes unit src returns nothing
        local integer i= 0
        loop
            exitwhen i >= s__EVDamageManager_ABMX
            call UnitAddAbility(src, s__EVDamageManager_ABID[i])
            set i=i + 1
        endloop
    endfunction
    function s__EVDamageManager_addOrigin takes unit src,integer amt returns nothing
        local integer this= s__EVDamageManager_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        set s__EVDamageManager_ODMG[this]=s__EVDamageManager_ODMG[this] + amt
        call sc__EVDamageManager_reCalc(this)
    endfunction
    function s__EVDamageManager_addAdditive takes unit src,integer amt returns nothing
        local integer this= s__EVDamageManager_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        set s__EVDamageManager_ADMG[this]=s__EVDamageManager_ADMG[this] + amt
        call sc__EVDamageManager_reCalc(this)
    endfunction
    function s__EVDamageManager_addPercent takes unit src,integer amt returns nothing
        local integer this= s__EVDamageManager_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        set s__EVDamageManager_PDMG[this]=s__EVDamageManager_PDMG[this] + amt
        call sc__EVDamageManager_reCalc(this)
    endfunction
    function s__EVDamageManager_addBonus takes unit src,integer amt returns nothing
        local integer this= s__EVDamageManager_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        set s__EVDamageManager_BPDMG[this]=s__EVDamageManager_BPDMG[this] + amt
        call sc__EVDamageManager_reCalc(this)
    endfunction
    function s__EVDamageManager_getFinalDamage takes unit src returns integer
        local integer this= s__EVDamageManager_getThis(GetUnitUserData(src))
        if this == 0 then
            return 0
        endif
        return s__EVDamageManager_FDMG[this]
    endfunction
    
    //구현부
    function s__EVDamageManager_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVDamageManager_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EVDamageManager_SRC[this]=null
        call TriggerUnbindAction(s__EVDamageManager_ONRM[this])
        set s__EVDamageManager_ONRM[this]=null
        //종결
        call s__EVDamageManager_destroy(this)
    endfunction
    function s__EVDamageManager_refresh takes unit src,integer amt returns nothing
        local integer i= 0
        if IsUnitType(src, UNIT_TYPE_DEAD) then
            return
        endif
        loop
            exitwhen i >= s__EVDamageManager_ABMX
            call SetUnitAbilityLevel(src, s__EVDamageManager_ABID[i], ModuloInteger(amt, 10) + 1)
            set amt=amt / 10
            set i=i + 1
        endloop
    endfunction
    function s__EVDamageManager_reCalc takes integer this returns nothing
        local integer nfodmg= s__EVDamageManager_ODMG[this] * s__EVDamageManager_PDMG[this] / 100
        local integer nfdmg= nfodmg * s__EVDamageManager_BPDMG[this] / 100 + s__EVDamageManager_ADMG[this]
        call s__EVDamageManager_refresh(s__EVDamageManager_SRC[this] , nfdmg - s__EVDamageManager_ODMG[this])
        set s__EVDamageManager_FODMG[this]=nfodmg
        set s__EVDamageManager_FDMG[this]=nfdmg
    endfunction
    
