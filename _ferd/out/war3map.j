//textmacro instance: 버프_선언_개시("EnkiduEnuma")
//end of: 버프_선언_개시("EnkiduEnuma")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_반복적_중첩됨()
    function s__BUFFEnkiduEnuma_apply takes unit src,unit cas,real dur,integer cnt returns nothing
        local integer this= s__tick_create(0)
        set s__BUFFEnkiduEnuma_source[this]=src
        set s__BUFFEnkiduEnuma_caster[this]=cas
        set s__BUFFEnkiduEnuma_duration[this]=dur
        set s__BUFFEnkiduEnuma_count[this]=cnt
        set s__BUFFEnkiduEnuma_durationTimer[this]=this
        call sc__BUFFEnkiduEnuma_onBuffStart(this)
        call s__tick_start(s__BUFFEnkiduEnuma_durationTimer[this],s__BUFFEnkiduEnuma_duration[this] , false , function sc__BUFFEnkiduEnuma_onExpire)
    endfunction
    function s__BUFFEnkiduEnuma_onExpire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitDead(s__BUFFEnkiduEnuma_source[this]) then
            call sc__BUFFEnkiduEnuma_onBuffEnd(this)
            set s__BUFFEnkiduEnuma_source[this]=null
            set s__BUFFEnkiduEnuma_caster[this]=null
            call s__tick_destroy(s__BUFFEnkiduEnuma_durationTimer[this])
            return
        endif
        if s__BUFFEnkiduEnuma_count[this] > 0 then
            set s__BUFFEnkiduEnuma_count[this]=s__BUFFEnkiduEnuma_count[this] - 1
        endif
        call sc__BUFFEnkiduEnuma_onBuffEffect(this)
        if s__BUFFEnkiduEnuma_count[this] == 0 then
            call sc__BUFFEnkiduEnuma_onBuffEnd(this)
            set s__BUFFEnkiduEnuma_source[this]=null
            set s__BUFFEnkiduEnuma_caster[this]=null
            call s__tick_destroy(s__BUFFEnkiduEnuma_durationTimer[this])
            return
        endif
        call s__tick_start(s__BUFFEnkiduEnuma_durationTimer[this],s__BUFFEnkiduEnuma_duration[this] , false , function s__BUFFEnkiduEnuma_onExpire)
    endfunction
//end of: 버프_종류_반복적_중첩됨()
