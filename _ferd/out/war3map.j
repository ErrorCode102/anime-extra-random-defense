//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILHeroineXLongo_source[this])
        if GetUnitAbilityLevel(s__ABILHeroineXLongo_source[this], s__ABILHeroineXLongo_ABILITY) == 1 then
            if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0FK') == 0 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXLongo_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXLongo_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant not classified as Artoria.|r")
                set p=null
                return
            endif
            if GetUnitLevel(GetSpellTargetUnit()) != 6 then
                call UnitRemoveAbility(GetTriggerUnit(), s__ABILHeroineXLongo_ABILITY)
                call UnitAddAbility(GetTriggerUnit(), s__ABILHeroineXLongo_ABILITY)
                call StartSoundForPlayerBJ(p, gg_snd_Error)
                call DisplayTextToPlayer(p, 0.0, 0.0, "|c00FF0000Servant's grade is too low to be sacrificed.|r")
                set p=null
                return
            endif
            call s__servant_kill(GetSpellTargetUnit() , true)
            call sc__EVDamageManager_addBonus(s__ABILHeroineXLongo_source[this] , 300)
            call SetUnitAbilityLevel(s__ABILHeroineXLongo_source[this], s__ABILHeroineXLongo_ABILITY, 2)
            call SetUnitAbilityLevel(s__ABILHeroineXLongo_source[this], 'A0FH', 3)
            call UnitRemoveAbility(s__ABILHeroineXLongo_source[this], 'A0GD')
            call UnitAddAbility(s__ABILHeroineXLongo_source[this], 'A0G7')
        else
            call sc__CMHeroineXSecret_cast(s__ABILHeroineXLongo_source[this] , GetSpellTargetUnit() , sc__EVDamageManager_getFinalDamage(s__ABILHeroineXLongo_source[this]) * 2.0 , 50 , 1)
