// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("ENKIDU","EN")
// scope SVENKIDU begins
//end of: 서번트_선언_개시("ENKIDU","EN")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVENKIDU___OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call FXRD_FXDebuffShockEx(dst , 1.00 , "FX\\Enkidu\\Shackle.mdl" , "origin")
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVENKIDU___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVENKIDU___OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVENKIDU___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVENKIDU___MeleeAttack)
            //Adding Special Skillz
            call sc__ABILEnkiduBUnstun_append(s__eventServantAdd_e , 1.00)
            call sc__ABILEnkiduCEnuma_append(s__eventServantAdd_e)
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0E7')
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVENKIDU___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVENKIDU___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVENKIDU___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVENKIDU___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("8","12000","Anylevel")
        set SVENKIDU___SERVANT_DAMAGE[8]=12000
        call s__eventServantAdd_register(SVENKIDU___SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVENKIDU___Anylevel)
//end of: 서번트_등록("8","12000","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVENKIDU ends
//end of: 서번트_선언_끝()
