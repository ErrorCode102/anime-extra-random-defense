//library CONTTerrain:
    // 페엑랜디 지형 - 바다와 바닥을 숨깁니다.
    function CONTHideTerrainSea takes nothing returns nothing
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_FLOOR, "decay", false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_SEA, "decay", false)
    endfunction
    // 페엑랜디 지형 - 바다와 바닥을 보입니다.
    function CONTShowTerrainSea takes nothing returns nothing
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_FLOOR, CONTTerrain___TERRAIN_STATE, false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_SEA, CONTTerrain___TERRAIN_STATE, false)
    endfunction
    // 페엑랜디 지형 - 지형 모드를 패널티로 변경합니다.
    function CONTSetTerrainPanaltyMode takes nothing returns nothing
        set CONTTerrain___TERRAIN_STATE="death"
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_FLOOR, "death", false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___PEDESTAL_LINE, "death", false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___PEDESTAL_STASH, "death", false)
    endfunction
    // 페엑랜디 지형 - 지형 모드를 일반으로 변경합니다.
    function CONTSetTerrainNormalMode takes nothing returns nothing
        set CONTTerrain___TERRAIN_STATE="stand"
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BACKGROUND_FLOOR, "birth", false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___PEDESTAL_LINE, "birth", false)
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___PEDESTAL_STASH, "birth", false)
    endfunction

    function CONTRefreshTerrainFence takes nothing returns nothing
        local integer i= 0
        local string s= "stand"
        local string s2= "stand alternate"
        local string f= ""
        loop
            exitwhen i == 4
            if GetLocalPlayer() == Player(i) then
                set f=s
            else
                set f=s2
            endif
            if not USER_IS_PLAYING[i] then
                set f="death"
            endif
            call SetDoodadAnimation(GetPlayerStartLocationX(Player(i)), GetPlayerStartLocationY(Player(i)), 32.00, 'D006', false, f, false)
            set i=i + 1
        endloop
    endfunction
    function CONTHideTerrainGacha takes nothing returns nothing
        call SetTerrainType(- 6144.00, 0.00, 'Oaby', 0, 7, 1)
        call SetDoodadAnimation(- 6144.00, 0.00, 32.00, 'D005', false, "stand", false)
        call SetDoodadAnimation(- 6144.00, 0.00, 32.00, 'D001', false, "death", false)
    endfunction
    function CONTShowTerrainGacha takes nothing returns nothing
        call SetDoodadAnimation(- 6144.00, 0.00, 32.00, 'D005', false, "birth", false)
        call SetDoodadAnimation(- 6144.00, 0.00, 32.00, 'D001', false, "birth", false)
    endfunction
    function CONTHideTerrainCenter takes nothing returns nothing
        call SetTerrainType(0.00, 0.00, 'Oaby', 0, 10, 1)
        call SetDoodadAnimation(0.00, 0.00, 32.00, CONTTerrain___PEDESTAL_STASH, false, "decay", false)
    endfunction
    function CONTHideTerrainBridge takes nothing returns nothing
        call SetDoodadAnimationRect(bj_mapInitialPlayableArea, CONTTerrain___BRIDGE, "death", false)
    endfunction

