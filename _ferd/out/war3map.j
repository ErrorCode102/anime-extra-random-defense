        set SVSAKURA__SERVANT_DAMAGE[7]=5750
        call s__eventServantAdd_register(SVSAKURA__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVSAKURA__KingProtea)
//end of: 서번트_등록("7","5750","KingProtea")
        
