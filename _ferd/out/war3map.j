local real b=f__arg_real3
local real x=f__arg_real4
local real y=f__arg_real5
local real z=f__arg_real6
local real x2=f__arg_real7
local real y2=f__arg_real8
local real z2=f__arg_real9
local real d=f__arg_real10
        local integer this= s__tick_create(0)
        set s__DummyLightning_main[this]=this
        set s__DummyLightning_beam[this]=AddLightningEx(id, true, x, y, z, x2, y2, z2)
        call SetLightningColor(s__DummyLightning_beam[this], r, g, b, 1)
        set s__DummyLightning_cr[this]=r
        set s__DummyLightning_cg[this]=g
        set s__DummyLightning_cb[this]=b
        set s__DummyLightning_loops[this]=R2I(d * 32)
        set s__DummyLightning_oa[this]=1
        set s__DummyLightning_da[this]=1.00 / s__DummyLightning_loops[this]
        call s__tick_start(s__DummyLightning_main[this],0.03125 , true , function s__DummyLightning_onLightningExpire)
   return true
endfunction
