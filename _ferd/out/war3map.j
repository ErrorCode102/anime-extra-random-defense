// Trigger: Servant Melt Penguin
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("MELTPENGUIN","ML")
// scope SVMELTPENGUIN begins
//end of: 서번트_선언_개시("MELTPENGUIN","ML")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVMELTPENGUIN___OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 2.0)
            call sc__TLMeltPenguinMelee_apply(src , dst)
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_METAL_MEDIUM_BASH , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVMELTPENGUIN___MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVMELTPENGUIN___OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVMELTPENGUIN___OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVMELTPENGUIN___MeleeAttack)
            //Adding Special Skillz
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0GU')
            call sc__ABILMeltPenguinAEnvy_append(s__eventServantAdd_e , 0.2)
            call sc__ABILMeltPenguinCPurge_append(s__eventServantAdd_e , 1.0)
            call FXRD_FXImmuneKnockback(s__eventServantAdd_e , true)
            call sc__ABILMeltPenguinDSummerPal_append(s__eventServantAdd_e)
            
            call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Naga\\NagaDeath\\NagaDeath.mdl", s__eventServantAdd_e, "origin"))
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVMELTPENGUIN___Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVMELTPENGUIN___SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVMELTPENGUIN___OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVMELTPENGUIN___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("7","862","Anylevel")
        set SVMELTPENGUIN___SERVANT_DAMAGE[7]=862
        call s__eventServantAdd_register(SVMELTPENGUIN___SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVMELTPENGUIN___Anylevel)
//end of: 서번트_등록("7","862","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVMELTPENGUIN ends
//end of: 서번트_선언_끝()
