    endfunction
    
    //생성자, 소멸자
    
    function s__EVBossSkillBlackhole_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVBossSkillBlackhole__allocate()
        set s__EVBossSkillBlackhole_ID[this]=GetUnitUserData(src)
