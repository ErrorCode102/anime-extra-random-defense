function sa__ABILScathachAGodKiller_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        local integer perc= 1
        local real mtpl= 0.01
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            set perc=13
        endif
        if GetRandomInt(1, perc) == 1 then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
            call s__enemy_dealLogicEx(src , dst , GetUnitState(dst, UNIT_STATE_LIFE) * mtpl , true , false , WEAPON_TYPE_METAL_MEDIUM_SLICE , 1)
        endif
        set src=null
        set dst=null
   return true
endfunction
