function sa__EVFreeRectMovement_onExpire takes nothing returns boolean

        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EVFreeRectMovement_mySource[this]) then
            call s__tick_pause(s__EVFreeRectMovement_myTick[this])
return true
        endif
        set s__EVFreeRectMovement_myMoveDist[this]=s__EVFreeRectMovement_myMoveDist[this] + GetUnitMoveSpeed(s__EVFreeRectMovement_mySource[this]) / 10.00
        call SetUnitTimeScale(s__EVFreeRectMovement_mySource[this], GetUnitMoveSpeed(s__EVFreeRectMovement_mySource[this]) * 0.01 * 0.80)
        if s__EVFreeRectMovement_myMoveDist[this] > s__Route__get_distance(s__EVFreeRectMovement_myRoute[this]) then
            set s__EVFreeRectMovement_myMoveDist[this]=s__EVFreeRectMovement_myMoveDist[this] - s__Route__get_distance(s__EVFreeRectMovement_myRoute[this])
            call sc__EVFreeRectMovement_rePath(this)
        endif
        call s__Route_calc(s__EVFreeRectMovement_myRoute[this],s__EVFreeRectMovement_myMoveDist[this])
        call SetUnitX(s__EVFreeRectMovement_mySource[this], s__Route_X[s__EVFreeRectMovement_myRoute[this]])
        call SetUnitY(s__EVFreeRectMovement_mySource[this], s__Route_Y[s__EVFreeRectMovement_myRoute[this]])
        if s__Route_R[s__EVFreeRectMovement_myRoute[this]] != s__EVFreeRectMovement_myFacing[this] then
            set s__EVFreeRectMovement_myFacing[this]=s__Route_R[s__EVFreeRectMovement_myRoute[this]]
            call SetUnitFacing(s__EVFreeRectMovement_mySource[this], s__EVFreeRectMovement_myFacing[this])
            call SetUnitAnimationByIndex(s__EVFreeRectMovement_mySource[this], s__EVFreeRectMovement_myMotionIndex[this])
        endif
   return true
endfunction
function sa__EVFreeRectMovement_rePath takes nothing returns boolean
local integer this=f__arg_this
        local real minX= GetRectMinX(s__EVFreeRectMovement_myRect[this]) + 196
        local real maxX= GetRectMaxX(s__EVFreeRectMovement_myRect[this]) - 196
        local real minY= GetRectMinY(s__EVFreeRectMovement_myRect[this]) + 196
        local real maxY= GetRectMaxY(s__EVFreeRectMovement_myRect[this]) - 196
        call s__Route_clear(s__EVFreeRectMovement_myRoute[this])
        call s__Route_add(s__EVFreeRectMovement_myRoute[this],s__EVFreeRectMovement_myPosX[this] , s__EVFreeRectMovement_myPosY[this])
        call s__Route_add(s__EVFreeRectMovement_myRoute[this],GetRandomReal(minX, maxX) , GetRandomReal(minY, maxY))
        call s__Route_add(s__EVFreeRectMovement_myRoute[this],GetRandomReal(minX, maxX) , GetRandomReal(minY, maxY))
        call s__Route_add(s__EVFreeRectMovement_myRoute[this],GetRandomReal(minX, maxX) , GetRandomReal(minY, maxY))
        set s__EVFreeRectMovement_myPosX[this]=GetRandomReal(minX, maxX)
        set s__EVFreeRectMovement_myPosY[this]=GetRandomReal(minY, maxY)
        call s__Route_add(s__EVFreeRectMovement_myRoute[this],s__EVFreeRectMovement_myPosX[this] , s__EVFreeRectMovement_myPosY[this])
   return true
endfunction
