  local integer ikey= Savecode___scommhash(ps) + loadtype * 73
  local integer inputhash
		call s__Savecode_FromString(this,s)
		call s__Savecode_Obfuscate(this,ikey , - 1)
		set inputhash=s__Savecode_Decode(this,Savecode___HASHN())
		call s__Savecode_Clean(this)
set f__result_boolean= inputhash == s__Savecode_Hash(this)
   return true
endfunction
function sa__SaveData_showCodeQuest takes nothing returns boolean
local player p=f__arg_player1
local string codeStr=f__arg_string1
local boolean saveEnable=f__arg_boolean1
            local integer myFaction= FXGetPlayerCurrentFaction(p)
            local quest q= CreateQuest()
            call QuestSetTitle(q, "View - Save Code")
            call QuestSetDescription(q, codeStr)
            if FXIsPlayerFactionMastered(p , myFaction) then
                call QuestSetIconPath(q, FXGetFactionMasterIcon(myFaction))
            else
                call QuestSetIconPath(q, FXGetFactionIcon(myFaction))
            endif
            call QuestSetRequired(q, true)
            call QuestSetDiscovered(q, saveEnable)
            call QuestSetEnabled(q, saveEnable)
            set q=null
   return true
endfunction
function sa__Decoder_DECS00001 takes nothing returns boolean

            local integer FACTION_MAX_THISVER= 5
            local integer FACTION_MAX_LEVEL_THISVER= 15
            local integer FACTION_XP_LIMIT_THISVER= 130000
            local integer MASTER_MAX_LEVEL_THISVER= 1000
            local integer MASTER_XP_LIMIT_THISVER= 1035000
            local integer fIndex= 1
            local integer id= GetPlayerId(s__DecodeEvent_ep)
            local integer theCode= s__DecodeEvent_e
            local integer upperkey= sc__Savecode_Decode(theCode,10)
            local integer lowerkey= sc__Savecode_Decode(theCode,9)
            local integer array factionXp
            local integer array factionLv
            local integer masterXp
            local integer masterLv
            local integer playTime
            local integer session
            set factionXp[5]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[4]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[3]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[2]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionXp[1]=sc__Savecode_Decode(theCode,FACTION_XP_LIMIT_THISVER)
            set factionLv[5]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[4]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[3]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[2]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set factionLv[1]=sc__Savecode_Decode(theCode,FACTION_MAX_LEVEL_THISVER)
            set masterXp=sc__Savecode_Decode(theCode,MASTER_XP_LIMIT_THISVER)
            set masterLv=sc__Savecode_Decode(theCode,MASTER_MAX_LEVEL_THISVER)
            set playTime=sc__Savecode_Decode(theCode,599940)
            set session=sc__Savecode_Decode(theCode,1)
            if sc__Savecode_Decode(theCode,upperkey) != lowerkey then
return true
            endif
            set UI_ERROR[id]=false
            set DATA_SESSION[id]=session
            set DATA_PLAYTIME[id]=playTime
            call FXSetPlayerMasterLevel(Player(id) , masterLv)
            call FXSetPlayerMasterXp(Player(id) , masterXp)
            loop
                exitwhen fIndex > FX_FACTION_MAX
                if fIndex > FACTION_MAX_THISVER then
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , 1)
                    call FXSetPlayerFactionXp(Player(id) , fIndex , 0)
                else
                    call FXSetPlayerFactionLevel(Player(id) , fIndex , factionLv[fIndex])
                    call FXSetPlayerFactionXp(Player(id) , fIndex , factionXp[fIndex])
                endif
                set fIndex=fIndex + 1
            endloop
   return true
endfunction
