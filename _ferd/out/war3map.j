    function SvSakura___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        local real mtpl
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvSakura___onAttackX3 takes nothing returns nothing
        local unit src
        local unit dst
        local real mtpl
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set mtpl=1.00
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\StormBolt\\StormBoltMissile.mdl", dst, "chest"))
            call FXRD_FXDebuffShock(dst , 3.00)
            set mtpl=3.00
        endif
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) * mtpl , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvSakura___onAttack99999999 takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            call s__enemy_dealLogicEx(src , dst , 99999999 , true , false , WEAPON_TYPE_WHOKNOWS , 0)
        else
            call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvSakura___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvSakura___ODMG[lv])
        //Adding Special Skillz
        if lv < 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvSakura___onAttack)
        endif
        if lv == 4 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvSakura___onAttackX3)
        endif
        if lv == 5 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvSakura___onAttackX3)
            call sc__EV103SakuraB_append(s__eventServantAdd_e , 4 , 1)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvSakura___onAttack99999999)
            call sc__EV103SakuraB_append(s__eventServantAdd_e , 8 , 1)
        endif
    endfunction
