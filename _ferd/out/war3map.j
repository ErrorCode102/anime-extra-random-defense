    function s__ABILMeltPenguinDSummerPal_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMeltPenguinDSummerPal_onSpellEffect[this], s__ABILMeltPenguinDSummerPal_onSpellEffectAction[this])
        set s__ABILMeltPenguinDSummerPal_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILMeltPenguinDSummerPal_onSpellEffect[this])
        set s__ABILMeltPenguinDSummerPal_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILMeltPenguinDSummerPal_rmTrig[this], s__ABILMeltPenguinDSummerPal_rmAct[this])
        set s__ABILMeltPenguinDSummerPal_rmAct[this]=null
        set s__ABILMeltPenguinDSummerPal_rmTrig[this]=null
        call sc__ABILMeltPenguinDSummerPal_onAbilityLost(this)
        set s__ABILMeltPenguinDSummerPal_source[this]=null
        set s__ABILMeltPenguinDSummerPal_exists[this]=false
    endfunction
    
    function s__ABILMeltPenguinDSummerPal_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMeltPenguinDSummerPal_free(this)
    endfunction
    
    function s__ABILMeltPenguinDSummerPal_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMeltPenguinDSummerPal_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMeltPenguinDSummerPal_exists[this] then
            set s__ABILMeltPenguinDSummerPal_exists[this]=true
            set s__ABILMeltPenguinDSummerPal_source[this]=src
            set s__ABILMeltPenguinDSummerPal_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMeltPenguinDSummerPal_rmAct[this]=TriggerAddAction(s__ABILMeltPenguinDSummerPal_rmTrig[this], function s__ABILMeltPenguinDSummerPal_OnSourceRemove)
            set s__ABILMeltPenguinDSummerPal_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILMeltPenguinDSummerPal_onSpellEffect[this], Condition(function sc__ABILMeltPenguinDSummerPal_conditionSpellEffect))
            set s__ABILMeltPenguinDSummerPal_onSpellEffectAction[this]=TriggerAddAction(s__ABILMeltPenguinDSummerPal_onSpellEffect[this], function sc__ABILMeltPenguinDSummerPal_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILMeltPenguinDSummerPal_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILMeltPenguinDSummerPal_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILMeltPenguinDSummerPal_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILMeltPenguinDSummerPal_exists[this] then
            return
        endif
        call sc__ABILMeltPenguinDSummerPal_onAbilityEffect(this)
    endfunction
    
    function s__ABILMeltPenguinDSummerPal_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILMeltPenguinDSummerPal_ABILITY
    endfunction
