        set s__EV118AlteraC_myServant[this]=src
        set s__EV118AlteraC_mySize[this]=msiz
        
        set s__EV118AlteraC_onSpellEffect[this]=CreateTrigger()
        call TriggerAddCondition(s__EV118AlteraC_onSpellEffect[this], Condition(function sc__EV118AlteraC_conditionSpellEffect))
        set s__EV118AlteraC_onSpellEffectAction[this]=TriggerAddAction(s__EV118AlteraC_onSpellEffect[this], function sc__EV118AlteraC_actionSpellEffect)
        call TriggerRegisterUnitEvent(s__EV118AlteraC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
    endfunction
    
    //구현부
    function s__EV118AlteraC_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV118AlteraC_getThis(GetUnitUserData(GetTriggerUnit()))
        local real tx= GetSpellTargetX()
        local real ty= GetSpellTargetY()
        call s__CMPhotonray_cast(GetTriggerUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) * 7.50 , tx , ty , s__EV118AlteraC_mySize[this])
    endfunction
    function s__EV118AlteraC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == 'A020'
    endfunction
    function s__EV118AlteraC_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV118AlteraC_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EV118AlteraC_onSpellEffect[this], s__EV118AlteraC_onSpellEffectAction[this])
        set s__EV118AlteraC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV118AlteraC_onSpellEffect[this])
        set s__EV118AlteraC_onSpellEffect[this]=null
        set s__EV118AlteraC_myServant[this]=null
        call TriggerUnbindAction(s__EV118AlteraC_onRemoveAction[this])
        set s__EV118AlteraC_onRemoveAction[this]=null
        //종결
        call s__EV118AlteraC_destroy(this)
    endfunction
    
    

