            call UnitRemoveAbility(s__CMHell_target[this], 'A02P')
            call UnitRemoveAbility(s__CMHell_target[this], 'B00G')
        endif
        call DestroyEffect(s__CMHell_fx[this])
        set s__CMHell_fx[this]=null
        set s__CMHell_caster[this]=null
