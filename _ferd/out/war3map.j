    endfunction
    function s__EV121JeanneAlterA2_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        local integer cmb
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV121JeanneAlterA2_getThis(GetUnitUserData(src))
        if not s__EV121JeanneAlterA2_isCool[this] and GetUnitAbilityLevel(dst, 'A05D') > 0 then
            set s__EV121JeanneAlterA2_isCool[this]=true
            call s__tick_start(s__EV121JeanneAlterA2_myCoolTick[this],5.00 , false , function s__EV121JeanneAlterA2_onCooldOver)
            call s__CMCurseStrike_cast(src , dst , s__EVDamageManager_getFinalDamage(src) , s__EV121JeanneAlterA2_myStun[this])
        endif
        set src=null
        set dst=null
    endfunction
    
