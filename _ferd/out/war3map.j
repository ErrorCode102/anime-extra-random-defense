    function s__CMMiltenThunder_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__CMMiltenThunder_CNT) == 0 then
            set s__CMMiltenThunder_DEST=GetEnumUnit()
        endif
        set s__CMMiltenThunder_CNT=s__CMMiltenThunder_CNT + 1
    endfunction
    function s__CMMiltenThunder_GetRandomEnemy takes unit src,real x,real y,real r returns unit
        set s__CMMiltenThunder_DEST=null
        set s__CMMiltenThunder_CNT=0
        call s__splash_range(s__splash_ENEMY , src , x , y , r , function s__CMMiltenThunder_enumGetTarget)
        return s__CMMiltenThunder_DEST
    endfunction
    //
    function s__CMMiltenThunder_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMMiltenThunder_myDummy[this]=null
        set s__CMMiltenThunder_caster[this]=null
        call s__tick_destroy(s__CMMiltenThunder_main[this])
    endfunction
    function s__CMMiltenThunder_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__tick_start(s__CMMiltenThunder_main[this],0.10 , false , function s__CMMiltenThunder_onFinal)
        if IsUnitType(s__CMMiltenThunder_caster[this], UNIT_TYPE_DEAD) then
            return
        endif
        call s__CMMiltenThunder_GetRandomEnemy(s__CMMiltenThunder_caster[this] , GetUnitX(s__CMMiltenThunder_myDummy[this]) , GetUnitY(s__CMMiltenThunder_myDummy[this]) , 1000)
        if s__CMMiltenThunder_DEST != null then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", s__CMMiltenThunder_DEST, "origin"))
            call sc__DummyLightningChaser_cast("CLPB" , 1 , 1 , 1 , s__CMMiltenThunder_myDummy[this] , 0 , 0 , GetRandomReal(50, 150) , s__CMMiltenThunder_DEST , 0 , 0 , 60 , 0.30)
            call s__enemy_dealLogic(s__CMMiltenThunder_caster[this] , s__CMMiltenThunder_DEST , s__CMMiltenThunder_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        endif
        set s__CMMiltenThunder_DEST=null
    endfunction
    function s__CMMiltenThunder_cast takes unit src,unit dum,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMMiltenThunder_caster[this]=src
        set s__CMMiltenThunder_damage[this]=dmg
        set s__CMMiltenThunder_main[this]=this
        set s__CMMiltenThunder_myDummy[this]=dum
        call s__tick_start(s__CMMiltenThunder_main[this],0.10 , false , function s__CMMiltenThunder_onFire)
    endfunction

    function s__CMMilten_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitInGroup(GetEnumUnit(), s__CMMilten_myG[this]) then
            return
        endif
        call GroupAddUnit(s__CMMilten_myG[this], GetEnumUnit())
        call s__EVDebuffSlow_apply(GetEnumUnit() , 1.00)
        call s__enemy_dealLogic(s__CMMilten_caster[this] , GetEnumUnit() , s__CMMilten_damage[this] , WEAPON_TYPE_WHOKNOWS , 0)
        call s__CMMiltenThunder_cast(s__CMMilten_caster[this] , s__CMMilten_myDummy[this] , s__CMMilten_damage[this])
        if s__CMMilten_vapor[this] > 0 then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl", s__CMMilten_caster[this], "origin"))
            call AddPlayerMp(GetOwningPlayer(s__CMMilten_caster[this]) , s__CMMilten_vapor[this])
        endif
    endfunction
    function s__CMMilten_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMMilten_caster[this], UNIT_TYPE_DEAD) or s__CMMilten_count[this] > 16 then
            call KillUnit(s__CMMilten_myDummy[this])
            call SetUnitTimeScale(s__CMMilten_myDummy[this], 5.00)
            set s__CMMilten_myDummy[this]=null
            call GroupClear(s__CMMilten_myG[this])
            call DestroyGroup(s__CMMilten_myG[this])
            set s__CMMilten_myG[this]=null
            set s__CMMilten_caster[this]=null
            call s__tick_destroy(s__CMMilten_main[this])
            return
        endif
        set s__CMMilten_count[this]=s__CMMilten_count[this] + 1
        call s__splash_range(s__splash_ENEMY , s__CMMilten_caster[this] , GetUnitX(s__CMMilten_myDummy[this]) , GetUnitY(s__CMMilten_myDummy[this]) , 200 , function s__CMMilten_enumDealt)
    endfunction
    function s__CMMilten_cast takes unit src,real tx,real ty,real dmg,integer vap returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBP(src , tx , ty)
        set s__CMMilten_vapor[this]=vap
        set s__CMMilten_caster[this]=src
        set s__CMMilten_damage[this]=dmg
        set s__CMMilten_count[this]=0
        set s__CMMilten_myG[this]=CreateGroup()
        set s__CMMilten_main[this]=this
        set s__CMMilten_myDummy[this]=CreateUnit(Player(15), 'o00T', GetUnitX(src) + s__Polar_X(100 , ang), GetUnitY(src) + s__Polar_Y(100 , ang), ang)
        call SetUnitAnimation(s__CMMilten_myDummy[this], "birth")
        call sc__DummyKnockback_cast(s__CMMilten_myDummy[this] , 800 , ang , 0 , 0.50)
        call s__tick_start(s__CMMilten_main[this],0.03125 , true , function s__CMMilten_onFire)
    endfunction
