//library Playtime:
        function s__playtime_start takes nothing returns nothing
            call TimerStart(s__playtime_PT, 604800, false, null)
        endfunction
        function s__playtime__get_current takes nothing returns real
            return TimerGetElapsed(s__playtime_PT)
        endfunction
        function s__playtime__get_hms takes nothing returns string
            local real record= TimerGetElapsed(s__playtime_PT)
            local integer rec= R2I(record)
            local integer h= rec / 3600
            local integer m= ModuloInteger(rec / 60, 60)
            local integer s= ModuloInteger(rec, 60)
            return SubString(I2S(100 + h), 1, 3) + ":" + SubString(I2S(100 + m), 1, 3) + ":" + SubString(I2S(100 + s), 1, 3)
        endfunction
        function s__playtime__get_hmsms takes nothing returns string
            local real record= TimerGetElapsed(s__playtime_PT)
            local integer rec= R2I(record)
            local integer h= rec / 3600
            local integer m= ModuloInteger(rec / 60, 60)
            local integer s= ModuloInteger(rec, 60)
            local string ms= R2S(record - rec)
            return SubString(I2S(100 + h), 1, 3) + ":" + SubString(I2S(100 + m), 1, 3) + ":" + SubString(I2S(100 + s), 1, 3) + SubString(ms, 1, StringLength(ms))
        endfunction

//library Playtime ends
//library Polar:

        function s__Polar_RadX takes real dist,real angle returns real
            return dist * Cos(angle)
        endfunction
        function s__Polar_RadY takes real dist,real angle returns real
            return dist * Sin(angle)
        endfunction
        function s__Polar_X takes real dist,real angle returns real
            return dist * Cos(angle * bj_DEGTORAD)
        endfunction
        function s__Polar_Y takes real dist,real angle returns real
            return dist * Sin(angle * bj_DEGTORAD)
        endfunction


