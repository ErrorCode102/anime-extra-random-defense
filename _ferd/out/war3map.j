        set s__EV165LeeSMA_myServant[this]=src
        set s__EV165LeeSMA_myAbil[this]=abid
        set s__EV165LeeSMA_myCombo[this]=1
        call UnitAddAbility(src, abid)
        
        set s__EV165LeeSMA_myBoostFx[this]=null
        set s__EV165LeeSMA_myBoostTick[this]=s__tick_create(this)
        call s__EVServantAttack_addFunction(src , function sc__EV165LeeSMA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV165LeeSMA_onBoostOver takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__EV165LeeSMA_myCombo[this]=1
        if s__EV165LeeSMA_myBoostFx[this] != null then
            call DestroyEffect(s__EV165LeeSMA_myBoostFx[this])
        endif
        set s__EV165LeeSMA_myBoostFx[this]=null
        if IsUnitType(s__EV165LeeSMA_myServant[this], UNIT_TYPE_DEAD) then
            return
        endif
        call SetUnitAbilityLevel(s__EV165LeeSMA_myServant[this], s__EV165LeeSMA_myAbil[this], s__EV165LeeSMA_myCombo[this])
    endfunction
    function s__EV165LeeSMA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV165LeeSMA_getThis(GetUnitUserData(src))
        if s__EV165LeeSMA_myCombo[this] == 5 then
            if s__EV165LeeSMA_myBoostFx[this] != null then
                call DestroyEffect(s__EV165LeeSMA_myBoostFx[this])
            endif
            set s__EV165LeeSMA_myBoostFx[this]=AddSpecialEffectTarget("FX\\Okita\\Aura1.mdl", s__EV165LeeSMA_myServant[this], "origin")
        endif
        set s__EV165LeeSMA_myCombo[this]=IMinBJ(6, s__EV165LeeSMA_myCombo[this] + 1)
        call SetUnitAbilityLevel(s__EV165LeeSMA_myServant[this], s__EV165LeeSMA_myAbil[this], s__EV165LeeSMA_myCombo[this])
        call s__tick_start(s__EV165LeeSMA_myBoostTick[this],5.00 , false , function s__EV165LeeSMA_onBoostOver)
        set src=null
        set dst=null
    endfunction
    
    function s__EV165LeeSMA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV165LeeSMA_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV165LeeSMA_myBoostFx[this] != null then
            call DestroyEffect(s__EV165LeeSMA_myBoostFx[this])
        endif
        set s__EV165LeeSMA_myBoostFx[this]=null
        call s__tick_destroy(s__EV165LeeSMA_myBoostTick[this])
        set s__EV165LeeSMA_myServant[this]=null
        call TriggerUnbindAction(s__EV165LeeSMA_onRemoveAction[this])
        set s__EV165LeeSMA_onRemoveAction[this]=null
        //종결
        call s__EV165LeeSMA_destroy(this)
    endfunction
    

