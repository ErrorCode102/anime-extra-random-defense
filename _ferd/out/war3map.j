        local integer selfModLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 5, 1, 2)
        local integer cccLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 30, 1, 2)
        local integer ultiLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 30, 1, 2)
        local integer dominaLev= IntegerTertiaryOp(GetHeroLevel(s__ABILBBSSDamageStat_source[this]) < 15, 1, 2)
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EM') != selfModLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EM', selfModLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EQ') != cccLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EQ', cccLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0ET') != ultiLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0ET', ultiLev)
        endif
        if GetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EO') != dominaLev then
            call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EO', dominaLev)
        endif
        call sc__EVDamageManager_addOrigin(s__ABILBBSSDamageStat_source[this] , - s__ABILBBSSDamageStat_PrevStrength[this])
        call sc__EVDamageManager_addBonus(s__ABILBBSSDamageStat_source[this] , - s__ABILBBSSDamageStat_PrevBonus[this])
        set s__ABILBBSSDamageStat_PrevStrength[this]=GetHeroStr(s__ABILBBSSDamageStat_source[this], true) * 20
        set s__ABILBBSSDamageStat_PrevBonus[this]=20 * ( GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10 )
        call SetUnitAbilityLevel(s__ABILBBSSDamageStat_source[this], 'A0EN', 1 + GetHeroLevel(s__ABILBBSSDamageStat_source[this]) / 10)
        call sc__EVDamageManager_addOrigin(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevStrength[this])
        call sc__EVDamageManager_addBonus(s__ABILBBSSDamageStat_source[this] , s__ABILBBSSDamageStat_PrevBonus[this])
   return true
