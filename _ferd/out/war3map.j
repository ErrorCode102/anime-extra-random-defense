//textmacro instance: 어빌리티_선언_개시("AstefDHippo")
//end of: 어빌리티_선언_개시("AstefDHippo")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0DE")
    
    function s__ABILAstefDHippo_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILAstefDHippo_onSpellEffect[this], s__ABILAstefDHippo_onSpellEffectAction[this])
        set s__ABILAstefDHippo_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILAstefDHippo_onSpellEffect[this])
        set s__ABILAstefDHippo_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILAstefDHippo_rmTrig[this], s__ABILAstefDHippo_rmAct[this])
        set s__ABILAstefDHippo_rmAct[this]=null
        set s__ABILAstefDHippo_rmTrig[this]=null
        call sc__ABILAstefDHippo_onAbilityLost(this)
        set s__ABILAstefDHippo_source[this]=null
        set s__ABILAstefDHippo_exists[this]=false
    endfunction
    
    function s__ABILAstefDHippo_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILAstefDHippo_free(this)
    endfunction
    
    function s__ABILAstefDHippo_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILAstefDHippo_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILAstefDHippo_exists[this] then
            set s__ABILAstefDHippo_exists[this]=true
            set s__ABILAstefDHippo_source[this]=src
            set s__ABILAstefDHippo_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILAstefDHippo_rmAct[this]=TriggerAddAction(s__ABILAstefDHippo_rmTrig[this], function s__ABILAstefDHippo_OnSourceRemove)
            set s__ABILAstefDHippo_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILAstefDHippo_onSpellEffect[this], Condition(function sc__ABILAstefDHippo_conditionSpellEffect))
            set s__ABILAstefDHippo_onSpellEffectAction[this]=TriggerAddAction(s__ABILAstefDHippo_onSpellEffect[this], function sc__ABILAstefDHippo_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILAstefDHippo_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILAstefDHippo_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILAstefDHippo_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILAstefDHippo_exists[this] then
            return
        endif
        call sc__ABILAstefDHippo_onAbilityEffect(this)
    endfunction
    
    function s__ABILAstefDHippo_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILAstefDHippo_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0DE")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득()
    function s__ABILAstefDHippo_onAbilityLearn takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_습득()
        set s__ABILAstefDHippo_HIPPO[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_잃음()
    function s__ABILAstefDHippo_onAbilityLost takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_잃음()
        if not IsUnitDead(s__ABILAstefDHippo_HIPPO[this]) then
            call s__servant_kill(s__ABILAstefDHippo_HIPPO[this] , false)
        endif
        set s__ABILAstefDHippo_HIPPO[this]=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILAstefDHippo_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local player p= GetOwningPlayer(s__ABILAstefDHippo_source[this])
        local real x= GetSpellTargetX()
        local real y= GetSpellTargetY()
        if not IsUnitDead(s__ABILAstefDHippo_HIPPO[this]) then
            call s__servant_kill(s__ABILAstefDHippo_HIPPO[this] , false)
        endif
        if RectContainsCoords(gg_rct_SP1_LINE, x, y) and USER_IS_PLAYING[0] then
            set p=Player(0)
        endif
        if RectContainsCoords(gg_rct_SP2_LINE, x, y) and USER_IS_PLAYING[1] then
            set p=Player(1)
        endif
        if RectContainsCoords(gg_rct_SP3_LINE, x, y) and USER_IS_PLAYING[2] then
            set p=Player(2)
        endif
        if RectContainsCoords(gg_rct_SP4_LINE, x, y) and USER_IS_PLAYING[3] then
            set p=Player(3)
        endif
        set s__ABILAstefDHippo_HIPPO[this]=CreateUnit(p, 'h00I', x, y, GetUnitFacing(s__ABILAstefDHippo_source[this]))
        call s__servant_add(GetOwningPlayer(s__ABILAstefDHippo_HIPPO[this]) , s__ABILAstefDHippo_HIPPO[this] , s__servant_QUIET)
        set p=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()//===========================================================================
//end of: 어빌리티_선언_끝()//===========================================================================
// Trigger: Servant Hippo
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 준_서번트_선언_개시( 코드명 )
//textmacro instance: 준_서번트_선언_개시("HIPPO")
// scope SVHIPPO begins
//end of: 준_서번트_선언_개시("HIPPO")

    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        function SVHIPPO__EnumClaw takes nothing returns nothing
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Stampede\\MissileDeath.mdl ", GetEnumUnit(), "chest"))
            if not IsUnitType(GetEnumUnit(), UNIT_TYPE_GIANT) then
                call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
            endif
            call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , sc__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
        endfunction
//textmacro instance: 서번트_무기_범위형("ClawSwing","300","EnumClaw")
        function SVHIPPO__ClawSwing takes nothing returns nothing
            local unit source= GetTriggerUnit()
            local unit target= GetEventDamageSource()
            call s__splash_range(s__splash_ENEMY , source , GetUnitX(target) , GetUnitY(target) , 300 , function SVHIPPO__EnumClaw)
            set source=null
            set target=null
        endfunction
//end of: 서번트_무기_범위형("ClawSwing","300","EnumClaw")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "ClawSwing")
    function SVHIPPO__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVHIPPO__ClawSwing()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "ClawSwing")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVHIPPO__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVHIPPO__MeleeAttack)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVHIPPO__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVHIPPO__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVHIPPO__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVHIPPO__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록_확장("h00I","8","5760","Anylevel")
        set SVHIPPO__SERVANT_DAMAGE[8]=5760
        call s__eventServantAdd_register('h00I' , function SVHIPPO__Anylevel)
//end of: 서번트_등록_확장("h00I","8","5760","Anylevel")
        
//textmacro instance: 서번트_선언_끝()//===========================================================================
    endfunction
// scope SVHIPPO ends
//end of: 서번트_선언_끝()//===========================================================================
// Trigger: CM TrapOfArgalia
//===========================================================================
    function s__CMTrapOfArgalia_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMTrapOfArgalia_myDummy[this])
        call ShowUnit(s__CMTrapOfArgalia_myDummy[this], false)
        set s__CMTrapOfArgalia_myDummy[this]=null
        set s__CMTrapOfArgalia_caster[this]=null
        call s__tick_destroy(s__CMTrapOfArgalia_main[this])
    endfunction
    function s__CMTrapOfArgalia_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\NecromancerMissile\\NecromancerMissile.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__CMTrapOfArgalia_caster[this] , GetEnumUnit() , s__CMTrapOfArgalia_damage[this] , WEAPON_TYPE_METAL_MEDIUM_BASH , 1)
    endfunction
    function s__CMTrapOfArgalia_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__splash_range(s__splash_ENEMY , s__CMTrapOfArgalia_caster[this] , GetUnitX(s__CMTrapOfArgalia_myDummy[this]) , GetUnitY(s__CMTrapOfArgalia_myDummy[this]) , 300 , function s__CMTrapOfArgalia_enumDealt)
        call sc__DummyColorChanger_cast(s__CMTrapOfArgalia_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call sc__DummyKnockback_cast(s__CMTrapOfArgalia_myDummy[this] , 50 , GetUnitFacing(s__CMTrapOfArgalia_myDummy[this]) , 0 , 0.20)
        call s__tick_start(s__CMTrapOfArgalia_main[this],0.20 , false , function s__CMTrapOfArgalia_onFinal)
    endfunction
    function s__CMTrapOfArgalia_cast takes unit src,real dmg,real tx,real ty returns nothing
        local integer this= s__tick_create(0)
        local real dist= RMinBJ(700, s__Distance_WBP(src , tx , ty))
        local real ang= s__Angle_WBP(src , tx , ty)
        set s__CMTrapOfArgalia_caster[this]=src
        set s__CMTrapOfArgalia_damage[this]=dmg
        set s__CMTrapOfArgalia_main[this]=this
        set s__CMTrapOfArgalia_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01T', GetUnitX(src), GetUnitY(src), ang)
        call sc__DummyColorChanger_cast(s__CMTrapOfArgalia_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call sc__DummyKnockback_cast(s__CMTrapOfArgalia_myDummy[this] , dist , ang , 0 , 0.40)
        call SetUnitAnimation(s__CMTrapOfArgalia_myDummy[this], "spell channel")
        call SetUnitTimeScale(s__CMTrapOfArgalia_myDummy[this], 2.00)
        call SetSoundPosition(gg_snd_weapon_swing_slow_1, GetUnitX(s__CMTrapOfArgalia_myDummy[this]), GetUnitY(s__CMTrapOfArgalia_myDummy[this]), 300)
        call StartSound(gg_snd_weapon_swing_slow_1)
        call s__tick_start(s__CMTrapOfArgalia_main[this],0.40 , true , function s__CMTrapOfArgalia_onFire)
    endfunction
// Trigger: CM LaBraqueLuna
//===========================================================================
    function s__CMLaBraqueLuna_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMLaBraqueLuna_myDummy[this])
        call ShowUnit(s__CMLaBraqueLuna_myDummy[this], false)
        set s__CMLaBraqueLuna_myDummy[this]=null
        set s__CMLaBraqueLuna_caster[this]=null
        call s__tick_destroy(s__CMLaBraqueLuna_main[this])
    endfunction
    function s__CMLaBraqueLuna_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShockEx(GetEnumUnit() , 10.00 , "Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl" , "overhead")
        call s__enemy_dealLogic(s__CMLaBraqueLuna_caster[this] , GetEnumUnit() , s__CMLaBraqueLuna_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMLaBraqueLuna_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang= GetUnitFacing(s__CMLaBraqueLuna_myDummy[this])
        call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00K', s__CMLaBraqueLuna_ox[this], s__CMLaBraqueLuna_oy[this], 270.00))
        call StartSound(gg_snd_spell_astef_horn)
        call s__splash_range(s__splash_ENEMY , s__CMLaBraqueLuna_caster[this] , s__CMLaBraqueLuna_ox[this] , s__CMLaBraqueLuna_oy[this] , 1000 , function s__CMLaBraqueLuna_enumDealt)
        call sc__DummyColorChanger_cast(s__CMLaBraqueLuna_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.60)
        call s__tick_start(s__CMLaBraqueLuna_main[this],0.60 , false , function s__CMLaBraqueLuna_onFinal)
    endfunction
    function s__CMLaBraqueLuna_onReload takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call SetUnitAnimation(s__CMLaBraqueLuna_myDummy[this], "spell channel two")
        call s__tick_start(s__CMLaBraqueLuna_main[this],0.40 , false , function s__CMLaBraqueLuna_onFire)
    endfunction
    function s__CMLaBraqueLuna_cast takes unit src,real dmg,real tx,real ty returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBP(src , tx , ty)
        set s__CMLaBraqueLuna_caster[this]=src
        set s__CMLaBraqueLuna_damage[this]=dmg
        set s__CMLaBraqueLuna_ox[this]=tx
        set s__CMLaBraqueLuna_oy[this]=ty
        set s__CMLaBraqueLuna_main[this]=this
        set s__CMLaBraqueLuna_myDummy[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o01T', tx, ty, ang)
        call sc__DummyColorChanger_cast(s__CMLaBraqueLuna_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMLaBraqueLuna_myDummy[this], "spell channel one")
        call SetSoundPosition(gg_snd_weapon_swing_slow_1, GetUnitX(s__CMLaBraqueLuna_myDummy[this]), GetUnitY(s__CMLaBraqueLuna_myDummy[this]), 300)
        call StartSound(gg_snd_weapon_swing_slow_1)
        call s__tick_start(s__CMLaBraqueLuna_main[this],1.40 , false , function s__CMLaBraqueLuna_onReload)
    endfunction
// Trigger: Servant Heroine X
//===========================================================================
//==================================================================
//　서번트 선언부
//==================================================================
// TODO : 서번트_선언_개시( 코드명, 이니셜 )
//textmacro instance: 서번트_선언_개시("HEROINEX","HX")
// scope SVHEROINEX begins
//end of: 서번트_선언_개시("HEROINEX","HX")
    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
        
        function SVHEROINEX__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            local integer level= GetUnitAbilityLevel(src, 'A0FH')
            local real mtpl= 1.0
            if level < 3 then
                if level == 2 then
                    if GetRandomInt(0, 9) == 0 then
                        set mtpl=10.0
                        call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Red\\lianzhan.mdl", dst, "origin"))
                    else
                        call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Blue\\lianzhan.mdl", dst, "origin"))
                    endif
                else
                    call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Blue\\lianzhan.mdl", dst, "origin"))
                endif
            else
                if GetRandomInt(0, 9) == 0 then
                    set mtpl=10.0
                    call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02C', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
                    call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02C', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
                    call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Red\\lianzhan.mdl", dst, "origin"))
                    if level == 4 then
                        call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", src, "hand left"))
                        call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", src, "hand right"))
                        call FXRD_FXDebuffShock(dst , 0.5)
                    endif
                else
                    call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02D', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
                    call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o02D', GetUnitX(src), GetUnitY(src), GetRandomReal(0.00, 360.00)))
                    call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Blue\\lianzhan.mdl", dst, "origin"))
                endif
            endif
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) * mtpl , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVHEROINEX__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVHEROINEX__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVHEROINEX__OnAnylevel takes nothing returns nothing
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVHEROINEX__MeleeAttack)
            //Adding Special Skillz
            call UnitRemoveAbility(s__eventServantAdd_e, 'A0GB')
            call sc__ABILHeroineXTrack_append(s__eventServantAdd_e)
            call sc__ABILHeroineXCalibur_append(s__eventServantAdd_e)
            call sc__ABILHeroineXLongo_append(s__eventServantAdd_e)
            call sc__ABILHeroineXCosmos_append(s__eventServantAdd_e)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
    function SVHEROINEX__Anylevel takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVHEROINEX__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVHEROINEX__OnAnylevel()
    endfunction
//end of: 서번트_획득_이벤트_선언("Anylevel", "OnAnylevel")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVHEROINEX__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("8","1140","Anylevel")
        set SVHEROINEX__SERVANT_DAMAGE[8]=1140
        call s__eventServantAdd_register(SVHEROINEX__SERVANT_ID + FX_SERVANT_LEVEL_8 , function SVHEROINEX__Anylevel)
//end of: 서번트_등록("8","1140","Anylevel")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
// scope SVHEROINEX ends
//end of: 서번트_선언_끝()
