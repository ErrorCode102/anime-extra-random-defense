// scope TrigFactionNeroKillBonus begins
    function TrigFactionNeroKillBonus__GoldBonus takes player p,real x,real y returns nothing
        local integer amt= GetRandomInt(1, 15)
        call AddPlayerGold(p , amt)
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", x, y))
        call SetSoundPosition(gg_snd_Gold, x, y, 200)
        call StartSoundForPlayerBJ(p, gg_snd_Gold)
        call s__bountyTag_custom(p , x , y + 64 , "|c00D0D0FF+" + I2S(amt))
    endfunction
    function TrigFactionNeroKillBonus__OnAction takes nothing returns nothing
        //FXRD 세력 - 현재 세력이 (NERO)가 아니라면, 즉시 종료합니다.
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) != FX_FACTION_NERO then
            return
        endif
        if GetRandomInt(0, 1) != 0 then
            return
        endif
        call TrigFactionNeroKillBonus__GoldBonus(s__eventCustom_getTriggerPlayer() , GetUnitX(s__eventCustom_getTriggerUnit()) , GetUnitY(s__eventCustom_getTriggerUnit()))
    endfunction
    function TrigFactionNeroKillBonus__main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_USER_KILL , function TrigFactionNeroKillBonus__OnAction)
    endfunction
// scope TrigFactionNeroKillBonus ends
