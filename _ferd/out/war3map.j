        //종결
        call s__EV122JeanneAlterB_destroy(this)
    endfunction
    
    
    function s__EV122JeanneAlterB_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV122JeanneAlterB_CNT) == 0 then
            set s__EV122JeanneAlterB_DEST=GetEnumUnit()
        endif
        set s__EV122JeanneAlterB_CNT=s__EV122JeanneAlterB_CNT + 1
    endfunction
    
    function s__EV122JeanneAlterB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV122JeanneAlterB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV122JeanneAlterB_coolTick[this])
            return
        endif
        set s__EV122JeanneAlterB_DEST=null
        set s__EV122JeanneAlterB_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV122JeanneAlterB_myServant[this] , GetUnitX(s__EV122JeanneAlterB_myServant[this]) , GetUnitY(s__EV122JeanneAlterB_myServant[this]) , GetUnitAcquireRange(s__EV122JeanneAlterB_myServant[this]) , function s__EV122JeanneAlterB_enumGetTarget)
        //대상이 없으면
        if s__EV122JeanneAlterB_DEST == null then
            call s__tick_start(s__EV122JeanneAlterB_coolTick[this],1.00 , true , function s__EV122JeanneAlterB_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMHeine_cast(s__EV122JeanneAlterB_myServant[this] , s__EV122JeanneAlterB_DEST , s__EV122JeanneAlterB_myDamage[this])
        call s__tick_start(s__EV122JeanneAlterB_coolTick[this],s__EV122JeanneAlterB_myCooldown[this] , true , function s__EV122JeanneAlterB_onCastSpell)
        set s__EV122JeanneAlterB_DEST=null
    endfunction
    

