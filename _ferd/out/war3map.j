// Trigger: Backdrop BTNLevel
//===========================================================================
    function s__UIBTNLevel_create takes real x,real y,real f,real s returns integer
        local integer this= s__UIBTNLevel__allocate()
        set s__UIBTNLevel_destructable[this]=null
        set s__UIBTNLevel_X[this]=x
        set s__UIBTNLevel_Y[this]=y
        set s__UIBTNLevel_Facing[this]=f
        set s__UIBTNLevel_Scale[this]=s
        set s__UIBTNLevel_Lv[this]=0
        return this
    endfunction
    function s__UIBTNLevel__set_Level takes integer this,integer level returns nothing
        if s__UIBTNLevel_Lv[this] == level then
            return
        endif
        set s__UIBTNLevel_Lv[this]=level
        call RemoveDestructable(s__UIBTNLevel_destructable[this])
        set s__UIBTNLevel_destructable[this]=CreateDestructableZ(BTN_LEVEL_BACKDROPS[level], s__UIBTNLevel_X[this], s__UIBTNLevel_Y[this], 0.0, s__UIBTNLevel_Facing[this], s__UIBTNLevel_Scale[this], 0)
        call ShowDestructable(s__UIBTNLevel_destructable[this], false)
    endfunction
    function s__UIBTNLevel_destroy takes integer this returns nothing
        call RemoveDestructable(s__UIBTNLevel_destructable[this])
        set s__UIBTNLevel_destructable[this]=null
        call s__UIBTNLevel_deallocate(this)
    endfunction
    function s__UIBTNLevel_onInit takes nothing returns nothing
        set BTN_LEVEL_BACKDROPS[LEVEL_UNKNOWN]=0
        set BTN_LEVEL_BACKDROPS[LEVEL_EASY]='B02E'
        set BTN_LEVEL_BACKDROPS[LEVEL_NORMAL]='B02F'
        set BTN_LEVEL_BACKDROPS[LEVEL_HARD]='B02G'
        set BTN_LEVEL_BACKDROPS[LEVEL_BRUTAL]='B02H'
        set BTN_LEVEL_BACKDROPS[LEVEL_ELITE_1]='B02I'
        set BTN_LEVEL_BACKDROPS[LEVEL_ELITE_2]='B02J'
        set BTN_LEVEL_BACKDROPS[LEVEL_ELITE_3]='B02K'
        set BTN_LEVEL_BACKDROPS[LEVEL_ELITE_4]='B02L'
        set BTN_LEVEL_BACKDROPS[LEVEL_HELL_1]='B02M'
        set BTN_LEVEL_BACKDROPS[LEVEL_HELL_2]='B02N'
        set BTN_LEVEL_BACKDROPS[LEVEL_HELL_3]='B02O'
        set BTN_LEVEL_BACKDROPS[LEVEL_HELL_4]='B02P'
    endfunction
// Trigger: Backdrop MSGLevel
//===========================================================================
    function s__UIMSGLevel_create takes real x,real y,real f,real s returns integer
        local integer this= s__UIMSGLevel__allocate()
        set s__UIMSGLevel_destructable[this]=null
        set s__UIMSGLevel_X[this]=x
        set s__UIMSGLevel_Y[this]=y
        set s__UIMSGLevel_Facing[this]=f
        set s__UIMSGLevel_Scale[this]=s
        set s__UIMSGLevel_Lv[this]=0
        return this
    endfunction
    function s__UIMSGLevel__set_Level takes integer this,integer level returns nothing
        if s__UIMSGLevel_Lv[this] == level then
            return
        endif
        set s__UIMSGLevel_Lv[this]=level
        call RemoveDestructable(s__UIMSGLevel_destructable[this])
        set s__UIMSGLevel_destructable[this]=CreateDestructableZ(MSG_LEVEL_BACKDROPS[level], s__UIMSGLevel_X[this], s__UIMSGLevel_Y[this], 0.0, s__UIMSGLevel_Facing[this], s__UIMSGLevel_Scale[this], 0)
        call ShowDestructable(s__UIMSGLevel_destructable[this], false)
    endfunction
    function s__UIMSGLevel_destroy takes integer this returns nothing
        call RemoveDestructable(s__UIMSGLevel_destructable[this])
        set s__UIMSGLevel_destructable[this]=null
        call s__UIMSGLevel_deallocate(this)
    endfunction
    function s__UIMSGLevel_onInit takes nothing returns nothing
        set MSG_LEVEL_BACKDROPS[LEVEL_UNKNOWN]=0
        set MSG_LEVEL_BACKDROPS[LEVEL_EASY]='B02Q'
        set MSG_LEVEL_BACKDROPS[LEVEL_NORMAL]='B02R'
        set MSG_LEVEL_BACKDROPS[LEVEL_HARD]='B02S'
        set MSG_LEVEL_BACKDROPS[LEVEL_BRUTAL]='B02T'
        set MSG_LEVEL_BACKDROPS[LEVEL_ELITE_1]='B02U'
        set MSG_LEVEL_BACKDROPS[LEVEL_ELITE_2]='B02V'
        set MSG_LEVEL_BACKDROPS[LEVEL_ELITE_3]='B02W'
        set MSG_LEVEL_BACKDROPS[LEVEL_ELITE_4]='B02X'
        set MSG_LEVEL_BACKDROPS[LEVEL_HELL_1]='B02Y'
        set MSG_LEVEL_BACKDROPS[LEVEL_HELL_2]='B02Z'
        set MSG_LEVEL_BACKDROPS[LEVEL_HELL_3]='B030'
        set MSG_LEVEL_BACKDROPS[LEVEL_HELL_4]='B031'
    endfunction
// Trigger: Interface Background
//===========================================================================
    function s__InterfaceBackground_create takes player p returns integer
        local integer this= s__InterfaceBackground__allocate()
        set s__InterfaceBackground_owner[this]=p
        set s__InterfaceBackground_bg[this]=CreateDestructableZ('B006', CONF_UI_CENTERX, CONF_UI_CENTERY, 0, 270, 2.50, 0)
        call ShowDestructable(s__InterfaceBackground_bg[this], false)
        set s__InterfaceBackground_blocker[this]=CreateDestructableZ('B00W', CONF_UI_CENTERX, CONF_UI_CENTERY, 0.00, 0, 9.95, 0)
        call ShowDestructable(s__InterfaceBackground_blocker[this], false)
        set s__InterfaceBackground_visible[this]=false
        return this
    endfunction
    function s__InterfaceBackground_show takes integer this,boolean flag returns nothing
        set s__InterfaceBackground_visible[this]=flag
        if GetLocalPlayer() == s__InterfaceBackground_owner[this] or s__InterfaceBackground_owner[this] == null then
            if flag then
                call CONTHideTerrainSea()
            else
                call CONTShowTerrainSea()
            endif
            call ShowDestructable(s__InterfaceBackground_bg[this], flag)
            call ShowDestructable(s__InterfaceBackground_blocker[this], flag)
        endif
    endfunction
    function s__InterfaceBackground_destroy takes integer this returns nothing
        if s__InterfaceBackground_visible[this] then
            if GetLocalPlayer() == s__InterfaceBackground_owner[this] or s__InterfaceBackground_owner[this] == null then
                call CONTShowTerrainSea()
            endif
        endif
        call RemoveDestructable(s__InterfaceBackground_bg[this])
        set s__InterfaceBackground_bg[this]=null
        call RemoveDestructable(s__InterfaceBackground_blocker[this])
        set s__InterfaceBackground_blocker[this]=null
        set s__InterfaceBackground_owner[this]=null
        call s__InterfaceBackground_deallocate(this)
    endfunction
// Trigger: Interface Numpad
//===========================================================================
    function s__InterfaceNumpad_create takes player p,real x,real y,string path,real off returns integer
        local integer this= s__InterfaceNumpad__allocate()
        set s__InterfaceNumpad_myPlayer[this]=p
        set s__InterfaceNumpad_myX[this]=x
        set s__InterfaceNumpad_myY[this]=y
        set s__InterfaceNumpad_mdlPath[this]=path
        set s__InterfaceNumpad_myOffset[this]=off
        set s__InterfaceNumpad_myText[this]=""
        set s__InterfaceNumpad_myLength[this]=0
        return this
    endfunction
    function s__InterfaceNumpad_clear takes integer this returns nothing
        local integer i= 0
        loop
            exitwhen i == s__InterfaceNumpad_myLength[this]
            call DestroyEffect(s___InterfaceNumpad_myFx[s__InterfaceNumpad_myFx[this]+i])
            set s___InterfaceNumpad_myFx[s__InterfaceNumpad_myFx[this]+i]=null
            set i=i + 1
        endloop
    endfunction
    function s__InterfaceNumpad_draw takes integer this returns nothing
        local integer i= 0
        local real x= s__InterfaceNumpad_myX[this] - ( 32 * s__InterfaceNumpad_myOffset[this] * s__InterfaceNumpad_myLength[this] )
        call s__InterfaceNumpad_clear(this)
        loop
            exitwhen i == s__InterfaceNumpad_myLength[this]
            set s___InterfaceNumpad_myFx[s__InterfaceNumpad_myFx[this]+i]=AddEffectForPlayer(s__InterfaceNumpad_myPlayer[this] , s__InterfaceNumpad_mdlPath[this] + SubString(s__InterfaceNumpad_myText[this], i, i + 1) + ".mdl" , x + 32 * i , s__InterfaceNumpad_myY[this])
            set i=i + 1
        endloop
    endfunction
    function s__InterfaceNumpad__set_path takes integer this,string s returns nothing
        call s__InterfaceNumpad_clear(this)
        set s__InterfaceNumpad_mdlPath[this]=s
        call s__InterfaceNumpad_draw(this)
    endfunction
    function s__InterfaceNumpad__set_text takes integer this,string s returns nothing
        call s__InterfaceNumpad_clear(this)
        set s__InterfaceNumpad_myText[this]=s
        set s__InterfaceNumpad_myLength[this]=StringLength(s)
        call s__InterfaceNumpad_draw(this)
    endfunction
    function s__InterfaceNumpad_destroy takes integer this returns nothing
        call s__InterfaceNumpad_clear(this)
        set s__InterfaceNumpad_myPlayer[this]=null
        call s__InterfaceNumpad_deallocate(this)
    endfunction
// Trigger: Sv E Atalanta
//===========================================================================
// scope SvAtalanta begins
    //기본 서번트 스탯 설정
    //구현부
    function SvAtalanta___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        local boolean pen
        local boolean addit
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if not DEAL_FLAG_LOGIC then
            set pen=false
            set addit=true
            if GetUnitLevel(src) > 4 then
                set pen=true
            endif
            if GetUnitLevel(src) == 5 then
                set addit=false
            endif
            //Melee Attack
            call s__enemy_dealLogicEx(src , dst , s__EVDamageManager_getFinalDamage(src) , pen , addit , WEAPON_TYPE_WHOKNOWS , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvAtalanta___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvAtalanta___ODMG[lv])
        //Adding Base Attack
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvAtalanta___onAttack)
        //Adding Special Skillz
        if lv == 4 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A06W')
            call UnitAddAbility(s__eventServantAdd_e, 'A06Y')
        endif
        if lv == 5 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A071')
            call UnitAddAbility(s__eventServantAdd_e, 'A07B')
        endif
        if lv == 6 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A075')
            call UnitAddAbility(s__eventServantAdd_e, 'A07C')
        endif
    endfunction
    //초기화
    function SvAtalanta___main takes nothing returns nothing
        set SvAtalanta___ODMG[1]=40
        set SvAtalanta___ODMG[2]=80
        set SvAtalanta___ODMG[3]=200
        set SvAtalanta___ODMG[4]=400
        set SvAtalanta___ODMG[5]=1000
        set SvAtalanta___ODMG[6]=3200
        call s__eventServantAdd_register(SV_ATALANTA + OFF_E , function SvAtalanta___onServantGet)
        call s__eventServantAdd_register(SV_ATALANTA + OFF_D , function SvAtalanta___onServantGet)
        call s__eventServantAdd_register(SV_ATALANTA + OFF_C , function SvAtalanta___onServantGet)
        call s__eventServantAdd_register(SV_ATALANTA + OFF_B , function SvAtalanta___onServantGet)
        call s__eventServantAdd_register(SV_ATALANTA + OFF_A , function SvAtalanta___onServantGet)
        call s__eventServantAdd_register(SV_ATALANTA + OFF_S , function SvAtalanta___onServantGet)
    endfunction
// scope SvAtalanta ends

//===========================================================================
// Trigger: Common Vlad
//===========================================================================
    function s__CMKazicleSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMKazicleSingle_myDummy[this])
        call ShowUnit(s__CMKazicleSingle_myDummy[this], false)
        set s__CMKazicleSingle_myDummy[this]=null
        set s__CMKazicleSingle_caster[this]=null
        set s__CMKazicleSingle_target[this]=null
        call s__tick_destroy(s__CMKazicleSingle_main[this])
    endfunction
    function s__CMKazicleSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMKazicleSingle_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMKazicleSingle_myDummy[this], "overhead"))
        else
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\MeatwagonMissile\\MeatwagonMissile.mdl", s__CMKazicleSingle_target[this], "chest"))
            call s__EVDebuffSlow_apply(s__CMKazicleSingle_target[this] , 0.50)
            call s__enemy_dealLogic(s__CMKazicleSingle_caster[this] , s__CMKazicleSingle_target[this] , s__CMKazicleSingle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMKazicleSingle_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMKazicleSingle_myDummy[this], 0.00)
        call s__tick_start(s__CMKazicleSingle_main[this],0.20 , false , function s__CMKazicleSingle_onFinal)
    endfunction
    function s__CMKazicleSingle_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMKazicleSingle_caster[this]=src
        set s__CMKazicleSingle_target[this]=dst
        set s__CMKazicleSingle_damage[this]=dmg
        set s__CMKazicleSingle_main[this]=this
        set s__CMKazicleSingle_myDummy[this]=CreateUnit(Player(15), 'o00C', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst))
        call sc__DummyColorChanger_cast(s__CMKazicleSingle_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMKazicleSingle_myDummy[this], "spell three")
        call SetUnitTimeScale(s__CMKazicleSingle_myDummy[this], 1.50)
        call s__tick_start(s__CMKazicleSingle_main[this],0.60 , true , function s__CMKazicleSingle_onFire)
    endfunction

    
    function s__CMKazicleVoyvoda_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMKazicleVoyvoda_caster[this]=null
        set s__CMKazicleVoyvoda_target[this]=null
        call s__tick_destroy(s__CMKazicleVoyvoda_main[this])
    endfunction
    function s__CMKazicleVoyvoda_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\MeatwagonMissile\\MeatwagonMissile.mdl", GetEnumUnit(), "chest"))
        call s__EVDebuffSlow_apply(GetEnumUnit() , 1.00)
        if IsUnitType(GetEnumUnit(), UNIT_TYPE_UNDEAD) then
            call FXRD_FXDebuffShock(GetEnumUnit() , 1.00)
        endif
        call s__enemy_dealLogic(s__CMKazicleVoyvoda_caster[this] , GetEnumUnit() , s__CMKazicleVoyvoda_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
    endfunction
    function s__CMKazicleVoyvoda_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMKazicleVoyvoda_combo[this] == 0 then
            call s__tick_start(s__CMKazicleVoyvoda_main[this],0.20 , false , function s__CMKazicleVoyvoda_onFinal)
        endif
        if not IsUnitDead(s__CMKazicleVoyvoda_target[this]) then
            set s__CMKazicleVoyvoda_tx[this]=GetUnitX(s__CMKazicleVoyvoda_target[this])
            set s__CMKazicleVoyvoda_ty[this]=GetUnitY(s__CMKazicleVoyvoda_target[this])
        endif
        //창 솟구치는 이펙트 표시
        call KillUnit(CreateUnit(Player(15), 'o00D', s__CMKazicleVoyvoda_tx[this], s__CMKazicleVoyvoda_ty[this], 270.00))
        call s__splash_range(s__splash_ENEMY , s__CMKazicleVoyvoda_caster[this] , s__CMKazicleVoyvoda_tx[this] , s__CMKazicleVoyvoda_ty[this] , 250 , function s__CMKazicleVoyvoda_enumDealt)
        set s__CMKazicleVoyvoda_combo[this]=s__CMKazicleVoyvoda_combo[this] - 1
    endfunction
    function s__CMKazicleVoyvoda_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMKazicleVoyvoda_caster[this]=src
        set s__CMKazicleVoyvoda_target[this]=dst
        set s__CMKazicleVoyvoda_damage[this]=dmg
        set s__CMKazicleVoyvoda_combo[this]=10
        set s__CMKazicleVoyvoda_main[this]=this
        set s__CMKazicleVoyvoda_tx[this]=GetUnitX(s__CMKazicleVoyvoda_target[this])
        set s__CMKazicleVoyvoda_ty[this]=GetUnitY(s__CMKazicleVoyvoda_target[this])
        call s__tick_start(s__CMKazicleVoyvoda_main[this],0.50 , true , function s__CMKazicleVoyvoda_onFire)
    endfunction
// Trigger: Sv E Vlad
//===========================================================================
// scope SvVlad begins
    //기본 서번트 스탯 설정
    //구현부
    function SvVlad___enumDealt takes nothing returns nothing
        call DestroyEffect(AddSpecialEffectTarget("FX\\Vlad\\Bladespear.mdl", GetEnumUnit(), "origin"))
        call s__enemy_dealLogic(GetTriggerUnit() , GetEnumUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
    endfunction
    function SvVlad___onAttackEnum takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) and GetUnitLevel(src) > 3 then
            call s__splash_range(s__splash_ENEMY , src , GetUnitX(dst) , GetUnitY(dst) , 300 , function SvVlad___enumDealt)
        else
            call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvVlad___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvVlad___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvVlad___ODMG[lv])
        //Adding Base Attack
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvVlad___onAttack)
        //Adding Special Skillz
        if lv > 3 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvVlad___onAttackEnum)
        endif
        if lv == 4 then
            call sc__EV108VladA_append(s__eventServantAdd_e , 0 , 300)
        endif
        if lv == 5 then
            call sc__EV108VladA_append(s__eventServantAdd_e , 0 , 750)
            call sc__EV109VladB_append(s__eventServantAdd_e , 1000 , 20)
        endif
        if lv == 6 then
            call sc__EV108VladA_append(s__eventServantAdd_e , 0 , 4800)
            call sc__EV109VladB_append(s__eventServantAdd_e , 3200 , 10)
        endif
    endfunction
    //초기화
    function SvVlad___main takes nothing returns nothing
        set SvVlad___ODMG[1]=17
        set SvVlad___ODMG[2]=34
        set SvVlad___ODMG[3]=85
        set SvVlad___ODMG[4]=170
        set SvVlad___ODMG[5]=425
        set SvVlad___ODMG[6]=1360
        call s__eventServantAdd_register(SV_VLAD + OFF_E , function SvVlad___onServantGet)
        call s__eventServantAdd_register(SV_VLAD + OFF_D , function SvVlad___onServantGet)
        call s__eventServantAdd_register(SV_VLAD + OFF_C , function SvVlad___onServantGet)
        call s__eventServantAdd_register(SV_VLAD + OFF_B , function SvVlad___onServantGet)
        call s__eventServantAdd_register(SV_VLAD + OFF_A , function SvVlad___onServantGet)
        call s__eventServantAdd_register(SV_VLAD + OFF_S , function SvVlad___onServantGet)
    endfunction
// scope SvVlad ends
