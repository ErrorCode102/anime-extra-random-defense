        call s__EV131TamamoEXC_deallocate(this)
    endfunction
    
    //API
    
    function s__EV131TamamoEXC_append takes unit src returns nothing
        local integer this= s__EV131TamamoEXC_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV131TamamoEXC failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV131TamamoEXC_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV131TamamoEXC_onSourceUnitRemove)
        set s__EV131TamamoEXC_myServant[this]=src
        
        set s__EV131TamamoEXC_onSpellEffect[this]=CreateTrigger()
        call TriggerAddCondition(s__EV131TamamoEXC_onSpellEffect[this], Condition(function sc__EV131TamamoEXC_conditionSpellEffect))
        set s__EV131TamamoEXC_onSpellEffectAction[this]=TriggerAddAction(s__EV131TamamoEXC_onSpellEffect[this], function sc__EV131TamamoEXC_actionSpellEffect)
        call TriggerRegisterUnitEvent(s__EV131TamamoEXC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
    endfunction
    
    //구현부
    function s__EV131TamamoEXC_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV131TamamoEXC_getThis(GetUnitUserData(GetTriggerUnit()))
        call s__CMBallBreak_cast(GetTriggerUnit() , GetSpellTargetUnit() , s__EVDamageManager_getFinalDamage(GetTriggerUnit()) * 40)
    endfunction
    function s__EV131TamamoEXC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == 'A031'
    endfunction
    function s__EV131TamamoEXC_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV131TamamoEXC_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EV131TamamoEXC_onSpellEffect[this], s__EV131TamamoEXC_onSpellEffectAction[this])
        set s__EV131TamamoEXC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV131TamamoEXC_onSpellEffect[this])
        set s__EV131TamamoEXC_onSpellEffect[this]=null
        set s__EV131TamamoEXC_myServant[this]=null
        call TriggerUnbindAction(s__EV131TamamoEXC_onRemoveAction[this])
        set s__EV131TamamoEXC_onRemoveAction[this]=null
        //종결
        call s__EV131TamamoEXC_destroy(this)
    endfunction
    
    

