    function UIResultButtonChallenge___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        set UIResultButtonChallenge___BACKDROP[ui]=CreateDestructableZ('B014', 5952.0 + 64.0, - 320.0, 1.0, 270, 0.95, 0)
        call ShowDestructable(UIResultButtonChallenge___BACKDROP[ui], false)
        set UIResultButtonChallenge___CLICKBOUND[ui]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'n018', 5952.0 + 64.0, - 320.0, 270.0)
        call SetUnitUserData(UIResultButtonChallenge___CLICKBOUND[ui], ui)
        call SetUnitVertexColor(UIResultButtonChallenge___CLICKBOUND[ui], 0, 0, 0, 0)
        call SetUnitScale(UIResultButtonChallenge___CLICKBOUND[ui], 0.0, 0.0, 0.0)
    
        set p=null
    endfunction
    
    function UIResultButtonChallenge___onUpdating takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        local integer parent= (ui)
        local boolean isVisible= s__FXResultInterface_Visible[parent] and PANALTY_COUNT > 0
        
        if GetLocalPlayer() == p then
            call ShowDestructable(UIResultButtonChallenge___BACKDROP[ui], isVisible)
            if isVisible then
                call SetUnitScale(UIResultButtonChallenge___CLICKBOUND[ui], 0.95, 0.95, 1.0)
            else
                call SetUnitScale(UIResultButtonChallenge___CLICKBOUND[ui], 0.0, 0.0, 0.0)
            endif
        endif
        
        set p=null
    endfunction

    function UIResultButtonChallenge___onClick takes nothing returns nothing
        local integer id= GetPlayerId(GetTriggerPlayer())
        local integer parent= (id)
        if id != GetUnitUserData(GetTriggerUnit()) then
            return
        endif
        if PANALTY_COUNT <= 0 then
            return
        endif
        if s__FXResultInterface_State[parent] != s__FXResultInterface_Challenge then
            set s__FXResultInterface_State[parent]=s__FXResultInterface_Challenge
        else
            set s__FXResultInterface_State[parent]=s__FXResultInterface_Idle
        endif
        call RRRequestPlayer(REQUEST_UI_RESULT_UPDATE , GetTriggerPlayer())
    endfunction
    
    function UIResultButtonChallenge___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultButtonChallenge___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_UPDATING , function UIResultButtonChallenge___onUpdating)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultButtonChallenge___onClosing)
        
        call s__UnitSelectEvent_Create('n018' , function UIResultButtonChallenge___onClick)
    endfunction
    
