            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        if IsUnitType(dst, UNIT_TYPE_GIANT) then
            set perc=2
        endif
        //Melee Attack
        if GetRandomInt(0, 100) < perc then
            call KillUnit(CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'h00B', GetUnitX(dst), GetUnitY(dst), 270.0))
            call DestroyEffect(AddSpecialEffectTarget("FX Slash Cross Red\\lianzhan.mdl", dst, "origin"))
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", src, "hand left"))
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", src, "hand right"))
            call FXRD_FXDebuffShock(dst , 5.0)
            call s__enemy_dealLogicEx(src , dst , s__EVDamageManager_getFinalDamage(src) * 50.0 , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 0)
        else
            call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        endif
        set src=null
        set dst=null
    endfunction
    function SvChulainn__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvChulainn__ODMG[lv])
        //Adding Base Attack
        if lv < 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvChulainn__onAttack)
        endif
        //Adding Special Skillz
        if lv == 4 then
            call sc__EV163ChulainnA_append(s__eventServantAdd_e , 200)
        endif
        if lv == 5 then
            call sc__EV163ChulainnA_append(s__eventServantAdd_e , 300)
            call sc__EV164ChulainnB_append(s__eventServantAdd_e)
        endif
        if lv == 6 then
            call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvChulainn__onAttackCrit)
            call sc__EV163ChulainnA_append(s__eventServantAdd_e , 400)
            call sc__EV164ChulainnB_append(s__eventServantAdd_e)
        endif
    endfunction
    //초기화
    function SvChulainn__main takes nothing returns nothing
        set SvChulainn__ODMG[3]=75
        set SvChulainn__ODMG[4]=150
        set SvChulainn__ODMG[5]=375
        set SvChulainn__ODMG[6]=1200
        call s__eventServantAdd_register(SV_CHULAINN + OFF_C , function SvChulainn__onServantGet)
        call s__eventServantAdd_register(SV_CHULAINN + OFF_B , function SvChulainn__onServantGet)
        call s__eventServantAdd_register(SV_CHULAINN + OFF_A , function SvChulainn__onServantGet)
        call s__eventServantAdd_register(SV_CHULAINN + OFF_S , function SvChulainn__onServantGet)
    endfunction
// scope SvChulainn ends
