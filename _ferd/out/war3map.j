    function s__BUFFEnkiduEnuma_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFEnkiduEnuma_fx[this]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'o020', GetUnitX(s__BUFFEnkiduEnuma_source[this]), GetUnitY(s__BUFFEnkiduEnuma_source[this]), 270.00)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_반복됨()
    function s__BUFFEnkiduEnuma_onBuffEffect takes integer this returns nothing
//end of: 버프_이벤트_버프_반복됨()
        local real mtpl= 3
        if IS_PLAYER_HAVE_EX_GILGAMESH[GetPlayerId(GetOwningPlayer(s__BUFFEnkiduEnuma_caster[this]))] then
            set mtpl=4.50
        endif
        call FXRD_FXUltimateShock(s__BUFFEnkiduEnuma_source[this] , 1.10)
        call s__enemy_dealLogic(s__BUFFEnkiduEnuma_caster[this] , s__BUFFEnkiduEnuma_source[this] , sc__EVDamageManager_getFinalDamage(s__BUFFEnkiduEnuma_caster[this]) * mtpl , WEAPON_TYPE_METAL_MEDIUM_SLICE , 1)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFEnkiduEnuma_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
