//library CommonJ:

    function AddEffectForPlayer takes player p,string f,real x,real y returns effect
        if GetLocalPlayer() != p then
            set f=""
        endif
        return AddSpecialEffect(f, x, y)
    endfunction

    function IsObjectExists takes integer id returns boolean
        return GetObjectName(id) != null
    endfunction
    
    function CreateDummyCorpse takes integer id,real x,real y,real z,real d,real s,integer r,integer g,integer b,integer a returns nothing
        local unit u= CreateUnit(Player(15), id, x, y, d)
        call SetUnitFlyHeight(u, z, 0.00)
        call SetUnitScale(u, s, 0, 0)
        call SetUnitVertexColor(u, 255, 255, 255, a)
        call KillUnit(u)
        set u=null
    endfunction
    
    function CreateDummy takes integer id,real x,real y,real z,real d,real s,integer r,integer g,integer b,integer a returns nothing
        local unit u= CreateUnit(Player(15), id, x, y, d)
        call SetUnitFlyHeight(u, z, 0.00)
        call SetUnitScale(u, s, 0, 0)
        call SetUnitVertexColor(u, 255, 255, 255, a)
        set u=null
    endfunction

    function IsPlayingUser takes player p returns boolean
        return GetPlayerController(p) == MAP_CONTROL_USER and GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING
    endfunction
    function IsPlayerUser takes player p returns boolean
        return GetPlayerController(p) == MAP_CONTROL_USER
    endfunction
    function IsPlayerPlaying takes player p returns boolean
        return GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING
    endfunction
    
    function AddPlayerLumber takes player p,integer delta returns nothing
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER, GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER) + delta)
    endfunction
    function GetPlayerLumber takes player p returns integer
        return GetPlayerState(p, PLAYER_STATE_RESOURCE_LUMBER)
    endfunction
    function AddPlayerGold takes player p,integer delta returns nothing
        call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD) + delta)
    endfunction
    function GetPlayerGold takes player p returns integer
        return GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)
    endfunction
    
    function BlinkSpecialEffect takes player p,string s,real x,real y returns nothing
        if p != null and GetLocalPlayer() != p then
            set s=""
        endif
        call DestroyEffect(AddSpecialEffect(s, x, y))
    endfunction
    
    function CountPlayingUser takes nothing returns integer
        local integer i= 0
        local integer c= 0
        loop
            exitwhen i == bj_MAX_PLAYERS
            if IsPlayingUser(Player(i)) then
                set c=c + 1
            endif
            set i=i + 1
        endloop
        return c
    endfunction
    
    function CountPlayingUserInForce takes force f returns integer
        local integer i= 0
        local integer c= 0
        loop
            exitwhen i == bj_MAX_PLAYERS
            if IsPlayingUser(Player(i)) and IsPlayerInForce(Player(i), f) then
                set c=c + 1
            endif
            set i=i + 1
        endloop
        return c
    endfunction
    
    function ForceCountPlayers takes force f returns integer
        local integer s= 0
        local integer i= 0
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            if IsPlayerInForce(Player(i), f) then
                set s=s + 1
            endif
            set i=i + 1
        endloop
        return s
    endfunction
    
    function ForceFirstPlayer takes force f returns player
        local integer i= 0
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            if IsPlayerInForce(Player(i), f) then
                return Player(i)
            endif
            set i=i + 1
        endloop
        return null
    endfunction
    
    function AddLightningExSimple takes string s,unit src,real soff,unit dst,real doff returns lightning
        return AddLightningEx(s, false, GetUnitX(src), GetUnitY(src), GetUnitFlyHeight(src) + soff, GetUnitX(dst), GetUnitY(dst), GetUnitFlyHeight(dst) + doff)
    endfunction
    
    function MoveLightningExSimple takes lightning l,unit src,real soff,unit dst,real doff returns nothing
        call MoveLightningEx(l, false, GetUnitX(src), GetUnitY(src), GetUnitFlyHeight(src) + soff, GetUnitX(dst), GetUnitY(dst), GetUnitFlyHeight(dst) + doff)
    endfunction
    
    function Msg takes string s returns nothing
        call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, s)
    endfunction
    
    function MsgTimed takes real d,string s returns nothing
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, d, s)
    endfunction
    
    function IsUnitDead takes unit u returns boolean
        return IsUnitType(u, UNIT_TYPE_DEAD) or GetUnitTypeId(u) == 0
    endfunction
    function IsUnitAlive takes unit u returns boolean
        return not IsUnitType(u, UNIT_TYPE_DEAD) and GetUnitTypeId(u) != 0
    endfunction

//library CommonJ ends
//library CustomDataTable:


    function CreateCustomDataTable takes integer itype returns integer
        local integer i= CustomDataTable___LDX
        local integer tdx= i / 400000
        local integer kdx= i - tdx * 400000
        local integer hdx= kdx * 10000
        if CustomDataTable___HDX[tdx] == null then
            set CustomDataTable___HDX[tdx]=InitHashtable()
            call SaveInteger(CustomDataTable___HDX[tdx], 0, hdx, itype)
        endif
        set CustomDataTable___LDX=CustomDataTable___LDX + 1
        return i
    endfunction
    
    function GetCustomDataTable takes integer i returns hashtable
        local integer tdx= i / 400000
        return CustomDataTable___HDX[tdx]
    endfunction
    
    function GetCustomDataKey takes integer i returns integer
        local integer tdx= i / 400000
        local integer kdx= i - tdx * 400000
        return kdx * 10000
    endfunction
    

//library CustomDataTable ends
//library CustomEvent:
        function s__eventCustom_getTriggerId takes nothing returns integer
            return CustomEvent___CUSTOM_ID
        endfunction
        function s__eventCustom_getTriggerPlayer takes nothing returns player
            return CustomEvent___CUSTOM_PLAYER
        endfunction
        function s__eventCustom_getTriggerUnit takes nothing returns unit
            return CustomEvent___CUSTOM_UNIT
        endfunction
        function s__eventCustom_getTriggerItem takes nothing returns item
            return CustomEvent___CUSTOM_ITEM
        endfunction
        function s__eventCustom_RegisterAction takes triggeraction ta,integer id returns triggeraction
            call SaveInteger(CustomEvent___H, 0, GetHandleId(ta), id)
            return ta
        endfunction
        function s__eventCustom_removeAction takes triggeraction ta returns nothing
            local integer ev= LoadInteger(CustomEvent___H, 0, GetHandleId(ta))
            if ev == 0 then
                call DisplayTextToPlayer(GetLocalPlayer(), 0.00, 0.00, "Warning: Attempted to remove non-custom event action element from custom event")
            endif
            call TriggerRemoveAction(LoadTriggerHandle(CustomEvent___TH, 0, ev), ta)
            return
        endfunction
        function s__eventCustom_addAction takes integer ev,code c returns triggeraction
            if not HaveSavedHandle(CustomEvent___TH, 0, ev) then
                call SaveTriggerHandle(CustomEvent___TH, 0, ev, CreateTrigger())
            endif
            return s__eventCustom_RegisterAction(TriggerAddAction(LoadTriggerHandle(CustomEvent___TH, 0, ev), c) , ev)
        endfunction
        function s__eventCustom_evaluate takes integer ev,player p,unit u,item i,integer id returns nothing
            local integer pev= CustomEvent___CUSTOM_EVENT
            local player pp= CustomEvent___CUSTOM_PLAYER
            local unit pu= CustomEvent___CUSTOM_UNIT
            local item pi= CustomEvent___CUSTOM_ITEM
            local integer pid= CustomEvent___CUSTOM_ID
            set CustomEvent___CUSTOM_EVENT=ev
            set CustomEvent___CUSTOM_PLAYER=p
            set CustomEvent___CUSTOM_UNIT=u
            set CustomEvent___CUSTOM_ITEM=i
            set CustomEvent___CUSTOM_ID=id
            call TriggerExecute(LoadTriggerHandle(CustomEvent___TH, 0, ev))
            set CustomEvent___CUSTOM_EVENT=pev
            set CustomEvent___CUSTOM_PLAYER=pp
            set CustomEvent___CUSTOM_UNIT=pu
            set CustomEvent___CUSTOM_ITEM=pi
            set CustomEvent___CUSTOM_ID=pid
            set pp=null
            set pu=null
            set pi=null
        endfunction

//library CustomEvent ends
//library Distance:

        function s__Distance_PBP takes real x,real y,real tx,real ty returns real
            local real dx= tx - x
            local real dy= ty - y
            return SquareRoot(dx * dx + dy * dy)
        endfunction
        function s__Distance_WBP takes widget w,real tx,real ty returns real
            local real dx= tx - GetWidgetX(w)
            local real dy= ty - GetWidgetY(w)
            return SquareRoot(dx * dx + dy * dy)
        endfunction
        function s__Distance_WBW takes widget w,widget t returns real
            local real dx= GetWidgetX(t) - GetWidgetX(w)
            local real dy= GetWidgetY(t) - GetWidgetY(w)
            return SquareRoot(dx * dx + dy * dy)
        endfunction
        function s__Distance_PBW takes real x,real y,widget t returns real
            local real dx= GetWidgetX(t) - x
            local real dy= GetWidgetY(t) - y
            return SquareRoot(dx * dx + dy * dy)
        endfunction


//library Distance ends
//library EasyWc3Events:
    function EZTriggerRegisterTimerEvent takes real timeout,boolean periodic,code c returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, c)
        call TriggerRegisterTimerEvent(t, timeout, periodic)
        set t=null
    endfunction
    function EZTriggerRegisterTimerEventSingle takes real timeout,code c returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, c)
        call TriggerRegisterTimerEvent(t, timeout, false)
        set t=null
    endfunction

//library EasyWc3Events ends
//library EnumForce:
        function s__enumForce__get_e takes nothing returns player
            return s__enumForce_P
        endfunction
        function s__enumForce_doEx takes integer s,integer e,code c returns nothing
            local force f= CreateForce()
            local integer i= s
            loop
                exitwhen i > e
                call ForceAddPlayer(f, Player(i))
                set i=i + 1
            endloop
            call sc__enumForce_do(f , c)
            call ForceClear(f)
            call DestroyForce(f)
            set f=null
        endfunction
        function s__enumForce_do takes force f,code c returns nothing
            local integer i= 0
            local trigger t= CreateTrigger()
            local triggeraction ta= TriggerAddAction(t, c)
            local player ppp= s__enumForce_P
            loop
                if IsPlayerInForce(Player(i), f) then
                    set s__enumForce_P=Player(i)
                    call TriggerExecute(t)
                endif
                set i=i + 1
                exitwhen i == bj_MAX_PLAYER_SLOTS
            endloop
            set s__enumForce_P=ppp
            call TriggerRemoveAction(t, ta)
            call DestroyTrigger(t)
            set ppp=null
            set ta=null
            set t=null
        endfunction

//library EnumForce ends
