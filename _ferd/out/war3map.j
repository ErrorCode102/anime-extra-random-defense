//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILTSUpDownSunLight_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        if GetUnitState(src, UNIT_STATE_MANA) >= 50.0 then
            call SetUnitState(src, UNIT_STATE_MANA, 0.0)
            call FXRD_FXDebuffShock(dst , 5.00)
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) * 15.00 , WEAPON_TYPE_WHOKNOWS , 1)
        endif
        set src=null
        set dst=null
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
