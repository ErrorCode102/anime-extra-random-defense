//library FXRDPlayerFaction:
//==========================================================================
// 세력 참조
// local fxFaction myFact = FXGetPlayerCurrentFaction( player )
// call FXSetPlayerCurrentFaction( player, fxFaction )
//==========================================================================
    function FXGetPlayerCurrentFaction takes player p returns integer
        return FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]
    endfunction
    function FXSetPlayerCurrentFaction takes player p,integer fact returns nothing
        set FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]=fact
    endfunction
//==========================================================================
//　마스터 레벨
//　　local integer i = FXGetPlayerMasterLevel( player )
//　　local integer i = FXGetPlayerMasterXp( player )
//　　call FXAddPlayerMasterXp( player, amount )
//==========================================================================
    function FXIsPlayerMaster takes player p returns boolean
        return FXRDPlayerFaction__MASTER_LEVEL[GetPlayerId(p)] > 0
    endfunction
    function FXSetPlayerMasterLevel takes player p,integer amount returns nothing
        set FXRDPlayerFaction__MASTER_LEVEL[GetPlayerId(p)]=amount
    endfunction
    function FXSetPlayerMasterXp takes player p,integer amount returns nothing
        set FXRDPlayerFaction__MASTER_XP[GetPlayerId(p)]=amount
    endfunction
    function FXGetPlayerMasterLevel takes player p returns integer
        return FXRDPlayerFaction__MASTER_LEVEL[GetPlayerId(p)]
    endfunction
    function FXGetPlayerMasterXp takes player p returns integer
        return FXRDPlayerFaction__MASTER_XP[GetPlayerId(p)]
    endfunction
    function FXAddPlayerMasterXp takes player p,integer amount returns nothing
        call FXSetMasterXpCalc(FXGetPlayerMasterLevel(p) , FXGetPlayerMasterXp(p) , amount)
        call FXSetPlayerMasterLevel(p , FXGetXpCalcLv())
        call FXSetPlayerMasterXp(p , FXGetXpCalcXp())
    endfunction
    function FXPromotePlayerMaster takes player p returns nothing
        set FXRDPlayerFaction__MASTER_LEVEL[GetPlayerId(p)]=IMaxBJ(1, FXRDPlayerFaction__MASTER_LEVEL[GetPlayerId(p)])
    endfunction
//==========================================================================
//　팩션 레벨
//　　local integer i = FXGetPlayerFactionLevel( player, faction )
//　　local integer i = FXGetPlayerFactionXp( player, faction )
//　　call FXAddPlayerFactionXp( player, faction, amount )
//==========================================================================
    function FXIsPlayerFactionMastered takes player p,integer fact returns boolean
        return FXRDPlayerFaction__FACTION_LEVEL[GetPlayerId(p) * FX_FACTION_MAX + fact] >= FX_FACTION_MAX_LEVEL
    endfunction
    function FXCountPlayerFactionMastered takes player p returns integer
        local integer i= 1
        local integer c= 0
        loop
            exitwhen i > FX_FACTION_MAX
            if FXIsPlayerFactionMastered(p , i) then
                set c=c + 1
            endif
            set i=i + 1
        endloop
        return c
    endfunction
    function FXSetPlayerFactionLevel takes player p,integer fact,integer amount returns nothing
        set FXRDPlayerFaction__FACTION_LEVEL[GetPlayerId(p) * FX_FACTION_MAX + fact]=amount
    endfunction
    function FXSetPlayerFactionXp takes player p,integer fact,integer amount returns nothing
        set FXRDPlayerFaction__FACTION_XP[GetPlayerId(p) * FX_FACTION_MAX + fact]=amount
    endfunction
    function FXGetPlayerFactionLevel takes player p,integer fact returns integer
        return FXRDPlayerFaction__FACTION_LEVEL[GetPlayerId(p) * FX_FACTION_MAX + fact]
    endfunction
    function FXGetPlayerFactionXp takes player p,integer fact returns integer
        return FXRDPlayerFaction__FACTION_XP[GetPlayerId(p) * FX_FACTION_MAX + fact]
    endfunction
    function FXAddPlayerFactionXp takes player p,integer fact,integer amount returns nothing
        call FXSetXpCalc(FXGetPlayerFactionLevel(p , fact) , FXGetPlayerFactionXp(p , fact) , amount)
        call FXSetPlayerFactionLevel(p , fact , FXGetXpCalcLv())
        call FXSetPlayerFactionXp(p , fact , FXGetXpCalcXp())
        if FXGetXpCalcLv() == FX_FACTION_MAX_LEVEL then
            call FXPromotePlayerMaster(p)
        endif
    endfunction
//==========================================================================
//　통합 레벨
//　　local integer i = FXGetPlayerLevel( player )
//　　local integer i = FXGetPlayerXp( player )
//==========================================================================
    function FXIsPlayerCurrentFactionMastered takes player p returns boolean
        local integer f= FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]
        return FXIsPlayerFactionMastered(p , f)
    endfunction
    function FXGetPlayerLevel takes player p returns integer
        local integer f= FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]
        if FXIsPlayerFactionMastered(p , f) then
            return FXGetPlayerMasterLevel(p)
        endif
        return FXGetPlayerFactionLevel(p , f)
    endfunction
    function FXGetPlayerXp takes player p returns integer
        local integer f= FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]
        if FXIsPlayerFactionMastered(p , f) then
            return FXGetPlayerMasterXp(p)
        endif
        return FXGetPlayerFactionXp(p , f)
    endfunction
    function FXAddPlayerXp takes player p,integer amount returns nothing
        local integer f= FXRDPlayerFaction__PLAYER_FACTION[GetPlayerId(p)]
        if FXIsPlayerFactionMastered(p , f) then
            call FXAddPlayerMasterXp(p , amount)
        else
            call FXAddPlayerFactionXp(p , f , amount)
        endif
    endfunction

//library FXRDPlayerFaction ends
