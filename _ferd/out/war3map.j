// scope FXResultInterfaceScope begins
    function FXResultInterfaceScope___onUIClose takes nothing returns nothing
        local integer req= RRGetRequest()
        local integer id= GetPlayerId(s__GameRequest__get_Player(req))
        local integer ui= (id)
        local boolean isProperPlayer= ( s__GameRequest__get_Player(req) != null )
        // 유효성 검사
        if GetPlayerSlotState(s__GameRequest__get_Player(req)) == PLAYER_SLOT_STATE_LEFT then
            set isProperPlayer=false
        endif
        if not isProperPlayer then
            return
        endif
        if not s__FXResultInterface_Visible[ui] then
            return
        endif
        set s__FXResultInterface_Visible[ui]=false
        // 브로드캐스트
        call RRResponsePlayer(RESPONSE_UI_RESULT_CLOSING , s__GameRequest__get_Player(req))
    endfunction
    function FXResultInterfaceScope___onUIOpen takes nothing returns nothing
        local integer req= RRGetRequest()
        local integer id= GetPlayerId(s__GameRequest__get_Player(req))
        local integer ui= (id)
        local boolean isProperPlayer= ( s__GameRequest__get_Player(req) != null )
        // 유효성 검사
        if GetPlayerSlotState(s__GameRequest__get_Player(req)) == PLAYER_SLOT_STATE_LEFT then
            set isProperPlayer=false
        endif
        if not isProperPlayer then
            return
        endif
        if s__FXResultInterface_Visible[ui] then
            return
        endif
        set s__FXResultInterface_Visible[ui]=true
        // 브로드캐스트
        call RRResponsePlayer(RESPONSE_UI_RESULT_OPENING , s__GameRequest__get_Player(req))
        call RRResponsePlayer(RESPONSE_UI_RESULT_UPDATING , s__GameRequest__get_Player(req))
    endfunction
    function FXResultInterfaceScope___onUIUpdate takes nothing returns nothing
        local integer req= RRGetRequest()
        local integer id= GetPlayerId(s__GameRequest__get_Player(req))
        local integer ui= (id)
        local boolean isProperPlayer= ( s__GameRequest__get_Player(req) != null )
        // 유효성 검사
        if not isProperPlayer then
            return
        endif
        if not s__FXResultInterface_Visible[ui] then
            return
        endif
        set s__FXResultInterface_Visible[ui]=true
        // 브로드캐스트
        call RRResponsePlayer(RESPONSE_UI_RESULT_UPDATING , s__GameRequest__get_Player(req))
    endfunction
    function FXResultInterfaceScope___main takes nothing returns nothing
        call RRRegisterRequestEvent(REQUEST_UI_RESULT_OPEN , function FXResultInterfaceScope___onUIOpen)
        call RRRegisterRequestEvent(REQUEST_UI_RESULT_CLOSE , function FXResultInterfaceScope___onUIClose)
        call RRRegisterRequestEvent(REQUEST_UI_RESULT_UPDATE , function FXResultInterfaceScope___onUIUpdate)
    endfunction
// scope FXResultInterfaceScope ends
