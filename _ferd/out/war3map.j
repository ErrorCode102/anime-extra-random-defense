// Trigger: WI GameAlliance
//===========================================================================
//textmacro instance: 월드_초기화_시작("GAMEALLIANCE")
// scope WORLDINITGAMEALLIANCE begins
    function WORLDINITGAMEALLIANCE__main takes nothing returns nothing
//end of: 월드_초기화_시작("GAMEALLIANCE")
    
    // 플레이어와, 플레이어용 할당 플레이어의 관계는 적대적입니다.
    call SetPlayerAlliance(Player(0), Player(4), ALLIANCE_PASSIVE, false)
    call SetPlayerAlliance(Player(1), Player(5), ALLIANCE_PASSIVE, false)
    call SetPlayerAlliance(Player(2), Player(6), ALLIANCE_PASSIVE, false)
    call SetPlayerAlliance(Player(3), Player(7), ALLIANCE_PASSIVE, false)
    
    // 플레이어와 관전자는 서로 다른 포스지만, 동맹이 됩니다.
    call SetPlayerAlliance(Player(0), Player(8), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(1), Player(8), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(2), Player(8), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(3), Player(8), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(0), Player(9), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(1), Player(9), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(2), Player(9), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(3), Player(9), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(0), Player(10), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(1), Player(10), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(2), Player(10), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(3), Player(10), ALLIANCE_PASSIVE, true)
    
    // 그 역도 성립합니다.
    call SetPlayerAlliance(Player(8), Player(0), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(8), Player(1), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(8), Player(2), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(8), Player(3), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(9), Player(0), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(9), Player(1), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(9), Player(2), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(9), Player(3), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(10), Player(0), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(10), Player(1), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(10), Player(2), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(10), Player(3), ALLIANCE_PASSIVE, true)
        
    // 공통 적과 플레이어용 할당 적은 서로 다른 포스지만 동맹 취급됩니다.
    call SetPlayerAlliance(Player(11), Player(4), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(11), Player(5), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(11), Player(6), ALLIANCE_PASSIVE, true)
    call SetPlayerAlliance(Player(11), Player(7), ALLIANCE_PASSIVE, true)
    
    //동맹끼리만 자원 공유가 가능합니다.
    call SetMapFlag(MAP_RESOURCE_TRADING_ALLIES_ONLY, true)
    
    //플레이어는 더미 소유자(=중립 우호적)와 시야를 공유합니다
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(0), ALLIANCE_SHARED_VISION_FORCED, true)
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(1), ALLIANCE_SHARED_VISION_FORCED, true)
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(2), ALLIANCE_SHARED_VISION_FORCED, true)
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(3), ALLIANCE_SHARED_VISION_FORCED, true)
    // 관전자는 더미 소유자(=중립 우호적)와 시야를 공유합니다
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(8), ALLIANCE_SHARED_VISION_FORCED, true)
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(9), ALLIANCE_SHARED_VISION_FORCED, true)
    call SetPlayerAlliance(FX_PLAYER_DUMMY, Player(10), ALLIANCE_SHARED_VISION_FORCED, true)
    
//textmacro instance: 월드_초기화_끝()//===========================================================================
    endfunction
// scope WORLDINITGAMEALLIANCE ends
//end of: 월드_초기화_끝()//===========================================================================
// Trigger: WI LoadingScreen
//===========================================================================
//textmacro instance: 월드_초기화_시작("LOADINGSCREEN")
// scope WORLDINITLOADINGSCREEN begins
    function WORLDINITLOADINGSCREEN__main takes nothing returns nothing
//end of: 월드_초기화_시작("LOADINGSCREEN")
    //카메라 적용
    call CameraSetupApplyForceDuration(gg_cam_ui_zone, true, 0.00)
    call FixCameraForPlayer(GetLocalPlayer() , gg_cam_ui_zone)
    //화면 처리 : 암전 / 인터페이스 없음
    call EnableSelect(false, false)
    call EnableDragSelect(false, false)
    call ShowInterface(false, 0.00)
    //부드러운 카메라 이동 지원
    call CameraSetSmoothingFactor(0.50)
    //시야 처리 : 모두 보이기
    call FogEnable(false)
    call FogMaskEnable(false)
    //기타 설정들
    //치트 메시지 숨기기
    call SetMapFlag(MAP_CHEATS_HIDDEN, true)
    //브금 개시
    call PlayMusic("Music\\YouAreMyKing_Part_A.mp3")
    call ResumeMusic()
    //인터페이스 영역 지형 투명하게 덧칠하기
    call SetTerrainType(6144.00, 0.00, 'Oaby', 0, 8, 1)
//textmacro instance: 월드_초기화_끝()//===========================================================================
    endfunction
// scope WORLDINITLOADINGSCREEN ends
//end of: 월드_초기화_끝()//===========================================================================
