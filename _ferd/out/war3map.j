    endfunction
    
    //생성자, 소멸자
    
    function s__EV149JeanneA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV149JeanneA__allocate()
        set s__EV149JeanneA_ID[this]=GetUnitUserData(src)
        call s__EV149JeanneA_setThis(s__EV149JeanneA_ID[this] , this)
        return this
    endfunction
    
    function s__EV149JeanneA_destroy takes integer this returns nothing
        call s__EV149JeanneA_setThis(s__EV149JeanneA_ID[this] , 0)
        call s__EV149JeanneA_deallocate(this)
    endfunction
    
    //API
    function s__EV149JeanneA_append takes unit src,real coold,real mana returns nothing
        local integer this= s__EV149JeanneA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV149JeanneA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV149JeanneA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV149JeanneA_onSourceUnitRemove)
        set s__EV149JeanneA_myServant[this]=src
        set s__EV149JeanneA_myMana[this]=mana
        set s__EV149JeanneA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV149JeanneA_coolTick[this],coold , true , function sc__EV149JeanneA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV149JeanneA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV149JeanneA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV149JeanneA_coolTick[this])
        set s__EV149JeanneA_myServant[this]=null
        call TriggerUnbindAction(s__EV149JeanneA_onRemoveAction[this])
        set s__EV149JeanneA_onRemoveAction[this]=null
        //종결
        call s__EV149JeanneA_destroy(this)
    endfunction
    
    function s__EV149JeanneA_enumGetTarget takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A09N') > 0 then
            return
        endif
        if GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_MANA) <= GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", GetEnumUnit(), "origin"))
        call SetUnitState(GetEnumUnit(), UNIT_STATE_MANA, GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) + s__EV149JeanneA_myMana[this])
    endfunction
    
    function s__EV149JeanneA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV149JeanneA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV149JeanneA_coolTick[this])
            return
        endif
        call s__splash_range(s__splash_ALLY , s__EV149JeanneA_myServant[this] , GetUnitX(s__EV149JeanneA_myServant[this]) , GetUnitY(s__EV149JeanneA_myServant[this]) , 700 , function s__EV149JeanneA_enumGetTarget)
    endfunction
    

