    endfunction
    
    //API
    function s__EVSpecialBounty_append takes unit src,string btype,player to,integer gamt,integer lamt,integer wamt,integer srnk,integer samt,integer xamt returns nothing
        local integer this= s__EVSpecialBounty_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVSpecialBounty application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVSpecialBounty_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVSpecialBounty_onSourceUnitRemove)
        set s__EVSpecialBounty_mySource[this]=src
        set s__EVSpecialBounty_bountyTarget[this]=to
        set s__EVSpecialBounty_goldAmt[this]=gamt
        set s__EVSpecialBounty_lumberAmt[this]=lamt
        set s__EVSpecialBounty_wispAmt[this]=wamt
        set s__EVSpecialBounty_servantRank[this]=srnk
        set s__EVSpecialBounty_servantAmt[this]=samt
        set s__EVSpecialBounty_xpAmt[this]=xamt
        set s__EVSpecialBounty_bountyType[this]=btype
        set s__EVSpecialBounty_atDeath[this]=CreateTrigger()
        set s__EVSpecialBounty_onDeathAction[this]=TriggerAddAction(s__EVSpecialBounty_atDeath[this], function sc__EVSpecialBounty_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVSpecialBounty_atDeath[this], src, EVENT_UNIT_DEATH)
    endfunction
    
    //구현부
    function s__EVSpecialBounty_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVSpecialBounty_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EVSpecialBounty_atDeath[this], s__EVSpecialBounty_onDeathAction[this])
        set s__EVSpecialBounty_onDeathAction[this]=null
        call DestroyTrigger(s__EVSpecialBounty_atDeath[this])
        set s__EVSpecialBounty_atDeath[this]=null
        set s__EVSpecialBounty_mySource[this]=null
        set s__EVSpecialBounty_bountyTarget[this]=null
        call TriggerUnbindAction(s__EVSpecialBounty_onRemoveAction[this])
        set s__EVSpecialBounty_onRemoveAction[this]=null
        //종결
        call s__EVSpecialBounty_destroy(this)
    endfunction
    
    function s__EVSpecialBounty_giveBounty takes player p,integer this returns nothing
        local integer id= GetPlayerId(p)
        local real x= GetPlayerStartLocationX(Player(id + 4))
        local real y= GetPlayerStartLocationY(Player(id + 4))
        local integer i= 0
        if USER_IS_PLAYING[id] then
            call DisplayTimedTextToPlayer(Player(id), 0, 0, 30, "|c000080ff" + s__EVSpecialBounty_bountyType[this] + " rewards:|r")
            if s__EVSpecialBounty_goldAmt[this] > 0 then
                call DisplayTimedTextToPlayer(Player(id), 0, 0, 30, " - " + I2S(s__EVSpecialBounty_goldAmt[this]) + " Gold")
                call AddPlayerGold(Player(id) , s__EVSpecialBounty_goldAmt[this])
            endif
            if s__EVSpecialBounty_lumberAmt[this] > 0 then
                call DisplayTimedTextToPlayer(Player(id), 0, 0, 30, " - " + I2S(s__EVSpecialBounty_lumberAmt[this]) + " H-Spirit Pts")
                call AddPlayerLumber(Player(id) , s__EVSpecialBounty_lumberAmt[this])
            endif
            if s__EVSpecialBounty_wispAmt[this] > 0 then
                call DisplayTimedTextToPlayer(Player(id), 0, 0, 30, " - " + I2S(s__EVSpecialBounty_wispAmt[this]) + " Wisps")
                call CreateWisp(Player(id) , s__EVSpecialBounty_wispAmt[this])
            endif
            if s__EVSpecialBounty_xpAmt[this] > 0 and not s__FXGameResult_Resulted[(id)] then
                set USER_XP_BONUS[id]=USER_XP_BONUS[id] + s__EVSpecialBounty_xpAmt[this]
                call DisplayTimedTextToPlayer(Player(id), 0, 0, 30, " - Extra Experience " + I2S(s__EVSpecialBounty_xpAmt[this]) + "% |c00808080(Cumulative " + I2S(USER_XP_BONUS[id]) + "%)|r")
            endif
            if s__EVSpecialBounty_servantRank[this] > 0 then
                loop
                    exitwhen i >= s__EVSpecialBounty_servantAmt[this]
                    call s__servant_add(Player(id) , s__gacha_do(Player(id) , s__EVSpecialBounty_servantRank[this] , x , y , 270) , s__servant_BOUNTY)
                    set i=i + 1
                endloop
            endif
        endif
    endfunction
    
    function s__EVSpecialBounty_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVSpecialBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id
        if s__EVSpecialBounty_bountyTarget[this] == Player(11) then
            set id=0
            loop
                exitwhen id == 4
                call s__EVSpecialBounty_giveBounty(Player(id) , this)
                set id=id + 1
            endloop
        else
            set id=GetPlayerId(s__EVSpecialBounty_bountyTarget[this])
            call s__EVSpecialBounty_giveBounty(Player(id) , this)
        endif
    endfunction
    

//===========================================================================
// Trigger: EV 15 GameFinalizer
//===========================================================================

    
    function s__EVGameFinalizer_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVGameFinalizer_STRUCT_ID)
    endfunction
    
    function s__EVGameFinalizer_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVGameFinalizer_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EVGameFinalizer_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVGameFinalizer__allocate()
        set s__EVGameFinalizer_ID[this]=GetUnitUserData(src)
        call s__EVGameFinalizer_setThis(s__EVGameFinalizer_ID[this] , this)
        return this
    endfunction
    
    function s__EVGameFinalizer_destroy takes integer this returns nothing
        call s__EVGameFinalizer_setThis(s__EVGameFinalizer_ID[this] , 0)
        call s__EVGameFinalizer_deallocate(this)
    endfunction
    
    //API
    function s__EVGameFinalizer_append takes unit src returns nothing
        local integer this= s__EVGameFinalizer_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVGameFinalizer application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVGameFinalizer_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVGameFinalizer_onSourceUnitRemove)
        set s__EVGameFinalizer_mySource[this]=src
        set s__EVGameFinalizer_atDeath[this]=CreateTrigger()
        set s__EVGameFinalizer_onDeathAction[this]=TriggerAddAction(s__EVGameFinalizer_atDeath[this], function sc__EVGameFinalizer_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVGameFinalizer_atDeath[this], src, EVENT_UNIT_DEATH)
    endfunction
    
    //구현부
    function s__EVGameFinalizer_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVGameFinalizer_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EVGameFinalizer_atDeath[this], s__EVGameFinalizer_onDeathAction[this])
        set s__EVGameFinalizer_onDeathAction[this]=null
        call DestroyTrigger(s__EVGameFinalizer_atDeath[this])
        set s__EVGameFinalizer_atDeath[this]=null
        set s__EVGameFinalizer_mySource[this]=null
        call TriggerUnbindAction(s__EVGameFinalizer_onRemoveAction[this])
        set s__EVGameFinalizer_onRemoveAction[this]=null
        //종결
        call s__EVGameFinalizer_destroy(this)
    endfunction
    
    function s__EVGameFinalizer_onFinal takes nothing returns nothing
        local integer i= 0
        call DestroyTimer(GetExpiredTimer())
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                call RRRequestPlayer(REQUEST_GAME_PLAYER_VICTORY , Player(i))
            endif
            set i=i + 1
        endloop
    endfunction
    
    function s__EVGameFinalizer_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVGameFinalizer_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(s__EVGameFinalizer_mySource[this]))
        local real x= GetUnitX(GetTriggerUnit())
        local real y= GetUnitY(GetTriggerUnit())
        if id == 11 then
            if not GAME_IS_PLAYING then
                return
            endif
            if PANALTY_COUNT > 0 then
                call CONTSetTerrainNormalMode()
            endif
            //동맹 전체 승리
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cff0080ffCongratulations!|r You've cleared the game on " + LEVEL_NAME[LEVEL_CURRENT] + " |cff0080ffdifficulty!|r")
            if GAME_IS_ONLINE then
                call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cff0080ffThe game was played on LAN or Battle.net|r")
            endif
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|c004080ffPlaytime: " + s__playtime__get_hmsms() + "|r")
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.00, 0.00, 10.00, "|cffff8000Player Name: " + USER_NAME[GetPlayerId(GetLocalPlayer())] + "|r")
            //
            call TimerStart(CreateTimer(), 0.50, false, function s__EVGameFinalizer_onFinal)
            return
        endif
        set id=id - 4
        if not USER_IS_PLAYING[id] then
            return
        endif
        //개인 승리
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cff0080ffCongratulations!|r |cff0080ff You've completed speedrun on|r " + LEVEL_NAME[LEVEL_CURRENT])
        if GAME_IS_ONLINE then
            call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cff0080ffThe game was played on LAN or Battle.net|r")
        endif
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|c004080ffPlaytime: " + s__playtime__get_hmsms() + "|r")
        call DisplayTimedTextToPlayer(Player(id), 0.00, 0.00, 30.00, "|cffff8000Player Name: " + USER_NAME[id] + "|r")
        //
        call RRRequestPlayer(REQUEST_GAME_PLAYER_VICTORY , Player(id))
    endfunction
    

