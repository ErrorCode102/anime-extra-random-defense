    //API
    function s__EVBossSkillTornado_append takes unit src,rect r returns nothing
        local integer this= s__EVBossSkillTornado_create(src)
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVBossSkillTornado application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVBossSkillTornado_ONRM[this]=s__EVUnitRemove_bind(src , function sc__EVBossSkillTornado_onSourceUnitRemove)
        set s__EVBossSkillTornado_listenerDeath[this]=CreateTrigger()
        set s__EVBossSkillTornado_listenerDeathAction[this]=TriggerAddAction(s__EVBossSkillTornado_listenerDeath[this], function sc__EVBossSkillTornado_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVBossSkillTornado_listenerDeath[this], src, EVENT_UNIT_DEATH)
        set s__EVBossSkillTornado_mySource[this]=src
        
        set s__EVBossSkillTornado_myTyphoon[this]=FXRD_FXTyphoonCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
        set s__EVBossSkillTornado_myTyphoon2[this]=FXRD_FXTyphoonCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
        set s__EVBossSkillTornado_myTyphoon3[this]=FXRD_FXTyphoonCreate(x - 960 , x + 960 , y - 960 , y + 960 , 192)
    endfunction
    
    //구현부
    function s__EVBossSkillTornado_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVBossSkillTornado_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EVBossSkillTornado_myTyphoon[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon[this])
        endif
        if s__EVBossSkillTornado_myTyphoon2[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon2[this])
        endif
        if s__EVBossSkillTornado_myTyphoon3[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon3[this])
        endif
        set s__EVBossSkillTornado_mySource[this]=null
        call TriggerUnbindAction(s__EVBossSkillTornado_ONRM[this])
        set s__EVBossSkillTornado_ONRM[this]=null
        call TriggerRemoveAction(s__EVBossSkillTornado_listenerDeath[this], s__EVBossSkillTornado_listenerDeathAction[this])
        set s__EVBossSkillTornado_listenerDeathAction[this]=null
        call DestroyTrigger(s__EVBossSkillTornado_listenerDeath[this])
        set s__EVBossSkillTornado_listenerDeath[this]=null
        //종결
        call s__EVBossSkillTornado_destroy(this)
    endfunction
    
    function s__EVBossSkillTornado_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVBossSkillTornado_getThis(GetUnitUserData(GetTriggerUnit()))
        if s__EVBossSkillTornado_myTyphoon[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon[this])
        endif
        if s__EVBossSkillTornado_myTyphoon2[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon2[this])
        endif
        if s__EVBossSkillTornado_myTyphoon3[this] != 0 then
            call FXRD_FXTyphoonDestroy(s__EVBossSkillTornado_myTyphoon3[this])
        endif
        set s__EVBossSkillTornado_myTyphoon[this]=0
        set s__EVBossSkillTornado_myTyphoon2[this]=0
        set s__EVBossSkillTornado_myTyphoon3[this]=0
    endfunction
    
// Trigger: EV 26 BossSkillStasis
//===========================================================================

    
    function s__EVBossSkillStasis_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVBossSkillStasis_STRUCT_ID)
    endfunction
    
    function s__EVBossSkillStasis_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVBossSkillStasis_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EVBossSkillStasis_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVBossSkillStasis__allocate()
        set s__EVBossSkillStasis_ID[this]=GetUnitUserData(src)
        call s__EVBossSkillStasis_setThis(s__EVBossSkillStasis_ID[this] , this)
        return this
    endfunction
    
    function s__EVBossSkillStasis_destroy takes integer this returns nothing
        call s__EVBossSkillStasis_setThis(s__EVBossSkillStasis_ID[this] , 0)
        call s__EVBossSkillStasis_deallocate(this)
    endfunction
    
    //API
    
    function s__EVBossSkillStasis_append takes unit src,real coold,rect r returns nothing
        local integer this= s__EVBossSkillStasis_create(src)
        local integer i= 0
        local real arc
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVBossSkillStasis application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVBossSkillStasis_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVBossSkillStasis_onSourceUnitRemove)
        set s__EVBossSkillStasis_myServant[this]=src
        set s__EVBossSkillStasis_myRect[this]=r
        
        set s__EVBossSkillStasis_myTick[this]=s__tick_create(this)
        call s__tick_start(s__EVBossSkillStasis_myTick[this],coold , true , function sc__EVBossSkillStasis_onCoolTime)
    endfunction
    
    //구현부
    function s__EVBossSkillStasis_CastStasisOnRect takes rect r returns nothing
        local real x= GetRectCenterX(r)
        local real y= GetRectCenterY(r)
        call FXRD_FXStasisField(x + GetRandomReal(- 960, 960) , y + GetRandomReal(- 960, 960) , 3 , 5)
        call FXRD_FXStasisField(x + GetRandomReal(- 960, 960) , y + GetRandomReal(- 960, 960) , 3 , 5)
    endfunction
    
    function s__EVBossSkillStasis_onCoolTime takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EVBossSkillStasis_myServant[this]) then
            call s__tick_pause(s__EVBossSkillStasis_myTick[this])
            return
        endif
        //CreateStasis
        call s__EVBossSkillStasis_CastStasisOnRect(s__EVBossSkillStasis_myRect[this])
    endfunction
    
    function s__EVBossSkillStasis_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVBossSkillStasis_getThis(s__EVUnitRemove_e)
        local integer i= 0
        //누수처리
        set s__EVBossSkillStasis_myRect[this]=null
        call s__tick_destroy(s__EVBossSkillStasis_myTick[this])
        set s__EVBossSkillStasis_myServant[this]=null
        call TriggerUnbindAction(s__EVBossSkillStasis_onRemoveAction[this])
        set s__EVBossSkillStasis_onRemoveAction[this]=null
        //종결
        call s__EVBossSkillStasis_destroy(this)
    endfunction
    
