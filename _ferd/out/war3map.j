        local integer this= s__EV165LeeSMA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV165LeeSMA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
