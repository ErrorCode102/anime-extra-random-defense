//textmacro instance: 어빌리티_선언_개시("BBSSCCCC")
//end of: 어빌리티_선언_개시("BBSSCCCC")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0ET")
    
    function s__ABILBBSSCCCC_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILBBSSCCCC_onSpellEffect[this], s__ABILBBSSCCCC_onSpellEffectAction[this])
        set s__ABILBBSSCCCC_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILBBSSCCCC_onSpellEffect[this])
        set s__ABILBBSSCCCC_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILBBSSCCCC_rmTrig[this], s__ABILBBSSCCCC_rmAct[this])
        set s__ABILBBSSCCCC_rmAct[this]=null
        set s__ABILBBSSCCCC_rmTrig[this]=null
        call sc__ABILBBSSCCCC_onAbilityLost(this)
        set s__ABILBBSSCCCC_source[this]=null
        set s__ABILBBSSCCCC_exists[this]=false
    endfunction
    
    function s__ABILBBSSCCCC_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSCCCC_free(this)
    endfunction
    
    function s__ABILBBSSCCCC_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILBBSSCCCC_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILBBSSCCCC_exists[this] then
            set s__ABILBBSSCCCC_exists[this]=true
            set s__ABILBBSSCCCC_source[this]=src
            set s__ABILBBSSCCCC_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILBBSSCCCC_rmAct[this]=TriggerAddAction(s__ABILBBSSCCCC_rmTrig[this], function s__ABILBBSSCCCC_OnSourceRemove)
            set s__ABILBBSSCCCC_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILBBSSCCCC_onSpellEffect[this], Condition(function sc__ABILBBSSCCCC_conditionSpellEffect))
            set s__ABILBBSSCCCC_onSpellEffectAction[this]=TriggerAddAction(s__ABILBBSSCCCC_onSpellEffect[this], function sc__ABILBBSSCCCC_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILBBSSCCCC_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILBBSSCCCC_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILBBSSCCCC_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILBBSSCCCC_exists[this] then
            return
        endif
        call sc__ABILBBSSCCCC_onAbilityEffect(this)
    endfunction
    
    function s__ABILBBSSCCCC_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILBBSSCCCC_ABILITY
    endfunction
