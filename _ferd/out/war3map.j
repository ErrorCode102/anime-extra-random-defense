    //API
    function s__EVSquareMovement_append takes unit src,integer r,integer mdex returns nothing
        local integer this= s__EVSquareMovement_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVSquareMovement application failed!")
