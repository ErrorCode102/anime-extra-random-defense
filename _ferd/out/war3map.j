        set s__EVSquareMovement_myMoveDist[this]=0.0
        set s__EVSquareMovement_myPosX[this]=GetUnitX(src)
        set s__EVSquareMovement_myPosY[this]=GetUnitY(src)
        set s__EVSquareMovement_myTick[this]=s__tick_create(this)
        set s__EVSquareMovement_myRoute[this]=r
        set s__EVSquareMovement_myMotionIndex[this]=mdex
        call s__Route_calc(s__EVSquareMovement_myRoute[this],s__EVSquareMovement_myMoveDist[this])
        call SetUnitX(src, s__Route_X[s__EVSquareMovement_myRoute[this]])
        call SetUnitY(src, s__Route_Y[s__EVSquareMovement_myRoute[this]])
        set s__EVSquareMovement_myFacing[this]=s__Route_R[s__EVSquareMovement_myRoute[this]]
        call SetUnitFacing(src, s__EVSquareMovement_myFacing[this])
        call SetUnitAnimationByIndex(src, mdex)
        call s__tick_start(s__EVSquareMovement_myTick[this],0.03125 , true , function sc__EVSquareMovement_onExpire)
    endfunction
    
    //구현부
    function s__EVSquareMovement_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVSquareMovement_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EVSquareMovement_mySource[this]=null
        call s__tick_destroy(s__EVSquareMovement_myTick[this])
        call TriggerUnbindAction(s__EVSquareMovement_ONRM[this])
        set s__EVSquareMovement_ONRM[this]=null
        //종결
        call s__EVSquareMovement_destroy(this)
    endfunction
    function s__EVSquareMovement_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local real speed= GetUnitMoveSpeed(s__EVSquareMovement_mySource[this]) * 0.1
        if IsUnitDead(s__EVSquareMovement_mySource[this]) then
            call SetUnitTimeScale(s__EVSquareMovement_mySource[this], 1.0)
            call s__tick_pause(s__EVSquareMovement_myTick[this])
            return
        endif
        set s__EVSquareMovement_myMoveDist[this]=s__EVSquareMovement_myMoveDist[this] + speed
        call SetUnitTimeScale(s__EVSquareMovement_mySource[this], speed * 0.08)
        if s__EVSquareMovement_myMoveDist[this] > s__Route__get_distance(s__EVSquareMovement_myRoute[this]) then
            set s__EVSquareMovement_myMoveDist[this]=s__EVSquareMovement_myMoveDist[this] - s__Route__get_distance(s__EVSquareMovement_myRoute[this])
        endif
        call s__Route_calc(s__EVSquareMovement_myRoute[this],s__EVSquareMovement_myMoveDist[this])
        call SetUnitX(s__EVSquareMovement_mySource[this], s__Route_X[s__EVSquareMovement_myRoute[this]])
        call SetUnitY(s__EVSquareMovement_mySource[this], s__Route_Y[s__EVSquareMovement_myRoute[this]])
        if s__Route_R[s__EVSquareMovement_myRoute[this]] != s__EVSquareMovement_myFacing[this] then
            set s__EVSquareMovement_myFacing[this]=s__Route_R[s__EVSquareMovement_myRoute[this]]
            call SetUnitFacing(s__EVSquareMovement_mySource[this], s__EVSquareMovement_myFacing[this])
            call SetUnitAnimationByIndex(s__EVSquareMovement_mySource[this], s__EVSquareMovement_myMotionIndex[this])
        endif
    endfunction
    
//===========================================================================
// Trigger: EV 12 DebuffStunServant
//===========================================================================

    
    function s__EVDebuffStunServant_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVDebuffStunServant_STRUCT_ID)
    endfunction
    
    function s__EVDebuffStunServant_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVDebuffStunServant_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EVDebuffStunServant_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVDebuffStunServant__allocate()
        set s__EVDebuffStunServant_ID[this]=GetUnitUserData(src)
        call s__EVDebuffStunServant_setThis(s__EVDebuffStunServant_ID[this] , this)
        return this
    endfunction
    
    function s__EVDebuffStunServant_destroy takes integer this returns nothing
        call s__EVDebuffStunServant_setThis(s__EVDebuffStunServant_ID[this] , 0)
        call s__EVDebuffStunServant_deallocate(this)
    endfunction
    
    //API
    function s__EVDebuffStunServant_append takes unit src returns nothing
        local integer this= s__EVDebuffStunServant_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVDebuffStunServant application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVDebuffStunServant_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVDebuffStunServant_onSourceUnitRemove)
        set s__EVDebuffStunServant_mySource[this]=src
        set s__EVDebuffStunServant_stack[this]=false
        set s__EVDebuffStunServant_myTick[this]=s__tick_create(this)
    endfunction
    function s__EVDebuffStunServant_clear takes unit src returns nothing
        local integer this= s__EVDebuffStunServant_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        call s__tick_pause(s__EVDebuffStunServant_myTick[this])
        if IsUnitType(s__EVDebuffStunServant_mySource[this], UNIT_TYPE_DEAD) then
            return
        endif
        call UnitRemoveAbility(s__EVDebuffStunServant_mySource[this], 'BPSE')
        set s__EVDebuffStunServant_stack[this]=false
    endfunction
    
    
    function s__EVDebuffStunServant_apply takes unit src,real amt returns nothing
        local integer this= s__EVDebuffStunServant_getThis(GetUnitUserData(src))
        if this == 0 then
            return
        endif
        if GetUnitAbilityLevel(src, 'A09B') > 0 then
            return
        endif
        if s__tick__get_remaining(s__EVDebuffStunServant_myTick[this]) < amt or not s__EVDebuffStunServant_stack[this] then
            call s__tick_start(s__EVDebuffStunServant_myTick[this],amt , false , function sc__EVDebuffStunServant_onExpire)
        endif
        if not s__EVDebuffStunServant_stack[this] then
            set s__EVDebuffStunServant_stack[this]=true
            call s__BufferDummy_castStr("creepthunderbolt" , src)
        endif
    endfunction
    
    //구현부
    function s__EVDebuffStunServant_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVDebuffStunServant_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EVDebuffStunServant_mySource[this]=null
        call s__tick_destroy(s__EVDebuffStunServant_myTick[this])
        call TriggerUnbindAction(s__EVDebuffStunServant_onRemoveAction[this])
        set s__EVDebuffStunServant_onRemoveAction[this]=null
        //종결
        call s__EVDebuffStunServant_destroy(this)
    endfunction
        
    function s__EVDebuffStunServant_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitDead(s__EVDebuffStunServant_mySource[this]) then
            return
        endif
        call UnitRemoveAbility(s__EVDebuffStunServant_mySource[this], 'BPSE')
        set s__EVDebuffStunServant_stack[this]=false
    endfunction
    
    function s__EVDebuffStunServant_onInit takes nothing returns nothing
    
    endfunction
    

