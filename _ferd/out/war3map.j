    function FXPlayerDataInit__ClearAllPlayerData takes nothing returns nothing
        local integer id= 0
        loop
            call ClearUser(Player(id))
            call ClearData(Player(id))
            set id=id + 1
            exitwhen id == 4
        endloop
    endfunction
    function FXPlayerDataInit__onMapInitializing takes nothing returns nothing
        call s__FXMapInit_ImInitializerModule()
        call FXPlayerDataInit__ClearAllPlayerData()
        call s__FXMapInit_ImInitialized()
    endfunction

    function FXPlayerDataInit__main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_MAP_INITIALIZING , function FXPlayerDataInit__onMapInitializing)
