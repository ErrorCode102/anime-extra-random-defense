        call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1)
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvZeromodel__onAttackAbility takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call SetUnitState(src, UNIT_STATE_MANA, GetUnitState(src, UNIT_STATE_MANA) + 1)
        call s__CMWeaponfireMissle_cast(src , GetUnitX(dst) , GetUnitY(dst) , s__EVDamageManager_getFinalDamage(src))
        set src=null
        set dst=null
    endfunction
    function SvZeromodel__onServantGet takes nothing returns nothing
