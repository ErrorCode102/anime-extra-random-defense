function sa__roundWave_create takes nothing returns boolean
local player p=f__arg_player1
local player e=f__arg_player2
local player w=f__arg_player3
local integer r=f__arg_integer1
local string s=f__arg_string1
            local integer this= s__roundWave__allocate()
            local real spawnFullTime= 2.00 / 3.00
            local integer uid
            set ENEMY_WAVE_STACK[GetPlayerId(w)]=ENEMY_WAVE_STACK[GetPlayerId(w)] + 1
            set ENEMY_WAVE_WORKING[GetPlayerId(w)]=ENEMY_WAVE_WORKING[GetPlayerId(w)] + 1
            set s__roundWave_imWorking[this]=true
            if FXRD_ROUND_ID[r] == 0 then
                if ModuloInteger(r, 10) == 0 then
                    set FXRD_ROUND_ID[r]=FXWave___RNUID[0]
                    set FXRD_ROUND_MOV[r]=FXWave___MOVID[0]
                else
                    set uid=GetRandomInt(1, FXWave___MAX_UNIT_TYPE)
                    set FXRD_ROUND_ID[r]=FXWave___RNUID[uid]
                    set FXRD_ROUND_MOV[r]=FXWave___MOVID[uid]
                endif
            endif
            if MODE_CURRENT == MODE_SPEEDRUN then
                set spawnFullTime=0.25
            endif
            set s__roundWave_myOwner[this]=p
            set s__roundWave_myEnemy[this]=e
            set s__roundWave_myWaveStack[this]=w
            set s__roundWave_myRound[this]=r
            set s__roundWave_myWaveTick[this]=s__tick_create(this)
            call s__tick_start(s__roundWave_myWaveTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] , false , function sc__roundWave_onRoundExpireA)
            set s__roundWave_myWaveTickUI[this]=s__tickUI_create(s__roundWave_myWaveTick[this])
            call s__tickUI__set_title(s__roundWave_myWaveTickUI[this],s)
            call s__tickUI__set_visible(s__roundWave_myWaveTickUI[this],GetLocalPlayer() == p)
            set s__roundWave_mySpawnTick[this]=s__tick_create(this)
            set s__roundWave_mySpawnCount[this]=0
            if GetPanalty(PANALTY_ENEMY_BONUS) then
                set s__roundWave_mySpawnCountMax[this]=80
                call s__tick_start(s__roundWave_mySpawnTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] * spawnFullTime / s__roundWave_mySpawnCountMax[this] , true , function sc__roundWave_onSpawnExpire)
            else
                set s__roundWave_mySpawnCountMax[this]=40
                call s__tick_start(s__roundWave_mySpawnTick[this],LEVEL_TIMEOUT[LEVEL_CURRENT] * spawnFullTime / s__roundWave_mySpawnCountMax[this] , true , function sc__roundWave_onSpawnExpire)
            endif
set f__result_integer= this
   return true
endfunction
function sa__roundWave_onRoundExpireA takes nothing returns boolean

            local integer this= s__tick_data[s__tick_getExpired()]
            if GetUserLife(s__roundWave_myOwner[this]) <= 0 then
                call CleanupUser(s__roundWave_myOwner[this])
            endif
            if s__roundWave_imWorking[this] then
                set s__roundWave_imWorking[this]=false
                set ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])]=ENEMY_WAVE_WORKING[GetPlayerId(s__roundWave_myWaveStack[this])] - 1
            endif
            call s__roundWave_destroy(this)
   return true
endfunction
function sa__roundWave_onSpawnExpire takes nothing returns boolean

            local integer this= s__tick_data[s__tick_getExpired()]
            local integer id= GetPlayerId(s__roundWave_myOwner[this])
            local real x= GetPlayerStartLocationX(s__roundWave_myOwner[this])
            local real y= GetPlayerStartLocationY(s__roundWave_myOwner[this])
            local integer hp= R2Rhp(s__roundWave_myRound[this])
            local integer mp= R2Rmp(s__roundWave_myRound[this])
            local integer bounty= 0
            local unit u
            if not USER_IS_PLAYING[id] then
return true
            endif
            if ModuloInteger(s__roundWave_myRound[this], 10) == 0 then
                set bounty=IMaxBJ(1, s__roundWave_myRound[this] * 2)
            else
                set bounty=IMaxBJ(1, s__roundWave_myRound[this] / 2)
            endif
            if FXRD_UNION_LINE then
                set u=CreateUnit(s__roundWave_myEnemy[this], FXRD_ROUND_ID[s__roundWave_myRound[this]], x + FXWave___spawnX[id], y + FXWave___spawnY[id], 270)
            else
                set u=CreateUnit(s__roundWave_myEnemy[this], FXRD_ROUND_ID[s__roundWave_myRound[this]], x - 960, y + 960, 270)
            endif
            if s__roundWave_mySpawnCount[this] == 0 and GetPanalty(PANALTY_POWERFUL_LEADER) then
                call UnitAddAbility(u, 'A0EW')
                set hp=hp * 20
                set mp=mp * 20
                set bounty=bounty * 10
            else
                if GetPanalty(PANALTY_ENEMY_BONUS) then
                    set hp=hp / 2
                    set mp=mp / 2
                    set bounty=IMaxBJ(1, bounty / 2)
                endif
            endif
            call s__lifeMod_apply(u , R2I(hp * LEVEL_HP[LEVEL_CURRENT]))
            call s__manaMod_apply(u , R2I(mp * LEVEL_HP[LEVEL_CURRENT]))
            call AddEnemyRemain(s__roundWave_myEnemy[this] , 1)
            call s__enemy_add(s__roundWave_myEnemy[this] , u)
            if GetPanalty(PANALTY_ENEMY_HEAL) then
                call UnitAddAbility(u, 'A04J')
                call sc__EVStateRegenerate_append(u , GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.005 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
            else
                call sc__EVStateRegenerate_append(u , 0.00 , GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.01)
            endif
            call sc__EVDeathBounty_append(u , bounty , s__roundWave_myOwner[this])
            if FXRD_UNION_LINE then
                call sc__EVSquareMovement_append(u , ROUTE_LANE_TEAM[id] , FXRD_ROUND_MOV[s__roundWave_myRound[this]])
            else
                call sc__EVSquareMovement_append(u , ROUTE_LANE[id] , FXRD_ROUND_MOV[s__roundWave_myRound[this]])
            endif
            set u=null
            set s__roundWave_mySpawnCount[this]=s__roundWave_mySpawnCount[this] + 1
            if s__roundWave_mySpawnCount[this] == s__roundWave_mySpawnCountMax[this] then
                call s__tick_start(s__roundWave_mySpawnTick[this],1.0 , true , function s__roundWave_onSkipCheck)
            endif
   return true
endfunction
