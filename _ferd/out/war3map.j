// scope UIResultPanelChallenge begins


    function UIResultPanelChallenge___onClosing takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        local integer i= 1
        
        call RemoveDestructable(UIResultPanelChallenge___BACKDROP[ui])
        set UIResultPanelChallenge___BACKDROP[ui]=null
        call RemoveDestructable(UIResultPanelChallenge___MILESTONE[ui])
        set UIResultPanelChallenge___MILESTONE[ui]=null
        
        loop
            call ShowUnit(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i], false)
            call KillUnit(UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX + i])
            set UIResultPanelChallenge___ICONBOUND[ui * PANALTY_MAX]=null
            call RemoveDestructable(UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i])
            set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + i]=null
            exitwhen i == PANALTY_MAX
            set i=i + 1
        endloop
        
        set p=null
    endfunction
    
    function UIResultPanelChallenge___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer ui= GetPlayerId(p)
        
        local integer i= 1
        
        set UIResultPanelChallenge___BACKDROP[ui]=CreateDestructableZ('B032', CONF_UI_CENTERX, CONF_UI_CENTERY, 0.0, 270.0, 4.5, 0)
        call ShowDestructable(UIResultPanelChallenge___BACKDROP[ui], false)
        
        set UIResultPanelChallenge___MILESTONE[ui]=CreateDestructableZ('B015', 6784.0, 384.0, 130.0, 270.0, 0.95, 0)
        call ShowDestructable(UIResultPanelChallenge___MILESTONE[ui], false)
        
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 1]=CreateDestructableZ('B018', CONF_UI_CENTERX + 96.0, CONF_UI_CENTERY + 384.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 2]=CreateDestructableZ('B019', CONF_UI_CENTERX + 96.0 + 96.0, CONF_UI_CENTERY + 384.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 3]=CreateDestructableZ('B01A', CONF_UI_CENTERX + 96.0 + 192.0, CONF_UI_CENTERY + 384.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 4]=CreateDestructableZ('B01B', CONF_UI_CENTERX + 96.0 + 288.0, CONF_UI_CENTERY + 384.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 5]=CreateDestructableZ('B01C', CONF_UI_CENTERX + 96.0 + 384.0, CONF_UI_CENTERY + 384.0, 0.0, 270.0, 1.0, 0)
        
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 6]=CreateDestructableZ('B01D', CONF_UI_CENTERX + 96.0, CONF_UI_CENTERY + 384.0 - 96.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 7]=CreateDestructableZ('B01E', CONF_UI_CENTERX + 96.0 + 96.0, CONF_UI_CENTERY + 384.0 - 96.0, 0.0, 270.0, 1.0, 0)
        set UIResultPanelChallenge___ICON[ui * PANALTY_MAX + 8]=CreateDestructableZ('B01F', CONF_UI_CENTERX + 96.0 + 192.0, CONF_UI_CENTERY + 384.0 - 96.0, 0.0, 270.0, 1.0, 0)
