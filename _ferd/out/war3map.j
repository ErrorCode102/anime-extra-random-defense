function sa__ABILEXGawainAttack_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local unit source= GetTriggerUnit()
        local unit target= GetEventDamageSource()
        local boolean isDayTime= GetUnitAbilityLevel(source, 'A0HN') > 0
        local real mana= 5.0
        local real curMana
        if isDayTime then
            call DestroyEffect(AddSpecialEffectTarget("FX Power Charge\\FX Power Charge Blue.mdl", source, "hand right"))
            call DestroyEffect(AddSpecialEffectTarget("FX\\Gawain\\Sun.mdl", target, "origin"))
            set mana=15.0
        else
            call s__bountyTag_custom(GetOwningPlayer(source) , GetUnitX(source) + GetRandomReal(- 64.0, 64.0) , GetUnitY(source) + 64 , s__ABILEXGawainAttack_MESSAGE[GetRandomInt(0, 2)])
        endif
        set curMana=GetUnitState(source, UNIT_STATE_MANA) + mana
        if curMana >= 300.0 then
            if isDayTime then
                call sc__TMGawainGalatin_cast(source , target , sc__EVDamageManager_getFinalDamage(source) * 30.0)
            else
                call sc__TMGawainGalatin_cast(source , target , sc__EVDamageManager_getFinalDamage(source) * 10.0)
            endif
            set curMana=0
        endif
        call SetUnitState(source, UNIT_STATE_MANA, curMana)
        call s__enemy_dealLogic(source , target , sc__EVDamageManager_getFinalDamage(source) , WEAPON_TYPE_WHOKNOWS , 1)
        set source=null
        set target=null
   return true
endfunction
