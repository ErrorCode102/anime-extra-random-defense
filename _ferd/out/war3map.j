function sa__EV142NeroA_onCastSpell takes nothing returns boolean

        local integer this= s__tick_data[s__tick_getExpired()]
        local real mtpl
        if IsUnitType(s__EV142NeroA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV142NeroA_coolTick[this])
return true
        endif
        set s__EV142NeroA_DEST=null
        set s__EV142NeroA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV142NeroA_myServant[this] , GetUnitX(s__EV142NeroA_myServant[this]) , GetUnitY(s__EV142NeroA_myServant[this]) , 400 , function s__EV142NeroA_enumGetTarget)
        if s__EV142NeroA_DEST == null then
            call s__tick_start(s__EV142NeroA_coolTick[this],1.00 , true , function s__EV142NeroA_onCastSpell)
return true
        endif
        set mtpl=s__EV142NeroA_myMtpl[this]
        if GetUnitAbilityLevel(s__EV142NeroA_myServant[this], 'A08O') > 0 then
            set mtpl=mtpl * 2.00
        endif
        call s__CMBladestorm_cast(s__EV142NeroA_myServant[this] , s__EV142NeroA_myDamage[this] + s__EVDamageManager_getFinalDamage(s__EV142NeroA_myServant[this]) * mtpl , 10)
        call s__tick_start(s__EV142NeroA_coolTick[this],s__EV142NeroA_myCooldown[this] , true , function s__EV142NeroA_onCastSpell)
        set s__EV142NeroA_DEST=null
   return true
endfunction
