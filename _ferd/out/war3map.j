    function s__CMHeroslayBuff_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(s__CMHeroslayBuff_target[this], UNIT_TYPE_DEAD) then
            call UnitRemoveAbility(s__CMHeroslayBuff_target[this], 'A02K')
            call UnitRemoveAbility(s__CMHeroslayBuff_target[this], 'B014')
            call s__EVDamageManager_addBonus(s__CMHeroslayBuff_target[this] , - 200)
        endif
        call DestroyEffect(s__CMHeroslayBuff_fx[this])
        set s__CMHeroslayBuff_fx[this]=null
        set s__CMHeroslayBuff_target[this]=null
        call s__tick_destroy(s__CMHeroslayBuff_mainFlow[this])
    endfunction
    function s__CMHeroslayBuff_cast takes unit src,unit dst,real delay returns nothing
        local integer this
        if GetUnitAbilityLevel(dst, 'A02K') > 0 then
            return
        endif
        set this=s__tick_create(0)
        set s__CMHeroslayBuff_target[this]=dst
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", GetUnitX(dst), GetUnitY(dst)))
        set s__CMHeroslayBuff_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageMissile.mdl", dst, "origin")
        call UnitAddAbility(s__CMHeroslayBuff_target[this], 'A02K')
        call s__EVDamageManager_addBonus(s__CMHeroslayBuff_target[this] , 200)
        set s__CMHeroslayBuff_mainFlow[this]=this
        call s__tick_start(s__CMHeroslayBuff_mainFlow[this],delay , false , function s__CMHeroslayBuff_onFinal)
    endfunction
