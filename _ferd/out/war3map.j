        //종결
        call s__EV151ZeromodelA_destroy(this)
    endfunction
    
    
    function s__EV151ZeromodelA_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV151ZeromodelA_CNT) == 0 then
            set s__EV151ZeromodelA_DEST=GetEnumUnit()
        endif
        set s__EV151ZeromodelA_CNT=s__EV151ZeromodelA_CNT + 1
    endfunction
    
    function s__EV151ZeromodelA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV151ZeromodelA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV151ZeromodelA_coolTick[this])
            return
        endif
        set s__EV151ZeromodelA_DEST=null
        set s__EV151ZeromodelA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV151ZeromodelA_myServant[this] , GetUnitX(s__EV151ZeromodelA_myServant[this]) , GetUnitY(s__EV151ZeromodelA_myServant[this]) , GetUnitAcquireRange(s__EV151ZeromodelA_myServant[this]) * 2 , function s__EV151ZeromodelA_enumGetTarget)
        //대상이 없으면
        if s__EV151ZeromodelA_DEST == null then
            call s__tick_start(s__EV151ZeromodelA_coolTick[this],1.00 , true , function s__EV151ZeromodelA_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMWeaponfireMissle_cast(s__EV151ZeromodelA_myServant[this] , GetUnitX(s__EV151ZeromodelA_DEST) , GetUnitY(s__EV151ZeromodelA_DEST) , s__EV151ZeromodelA_myDamage[this])
        call s__tick_start(s__EV151ZeromodelA_coolTick[this],s__EV151ZeromodelA_myCooldown[this] , true , function s__EV151ZeromodelA_onCastSpell)
        set s__EV151ZeromodelA_DEST=null
    endfunction
    

//===========================================================================
// Trigger: EV 152 ZeromodelB
//===========================================================================
//textmacro instance: 어빌리티_선언_개시("ZeromodelB")
//end of: 어빌리티_선언_개시("ZeromodelB")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILZeromodelB_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILZeromodelB_rmTrig[this], s__ABILZeromodelB_rmAct[this])
        set s__ABILZeromodelB_rmAct[this]=null
        set s__ABILZeromodelB_rmTrig[this]=null
        call sc__ABILZeromodelB_onAbilityLost(this)
        call s__tick_destroy(s__ABILZeromodelB_durTik[this])
        set s__ABILZeromodelB_source[this]=null
        set s__ABILZeromodelB_exists[this]=false
    endfunction
    
    function s__ABILZeromodelB_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILZeromodelB_free(this)
    endfunction
    
    function s__ABILZeromodelB_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILZeromodelB_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILZeromodelB_source[this]) then
            return
        endif
        call sc__ABILZeromodelB_onAbilityEffect(this)
        call s__tick_start(s__ABILZeromodelB_durTik[this],s__ABILZeromodelB_duration[this] , false , function s__ABILZeromodelB_onExpire)
    endfunction
    
    function s__ABILZeromodelB_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILZeromodelB_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILZeromodelB_exists[this] then
            set s__ABILZeromodelB_exists[this]=true
            set s__ABILZeromodelB_source[this]=src
            set s__ABILZeromodelB_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILZeromodelB_rmAct[this]=TriggerAddAction(s__ABILZeromodelB_rmTrig[this], function s__ABILZeromodelB_OnSourceRemove)
            
            set s__ABILZeromodelB_duration[this]=dur
            set s__ABILZeromodelB_defaultDuration[this]=dur
            set s__ABILZeromodelB_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILZeromodelB_durTik[this],dur , false , function s__ABILZeromodelB_onExpire)
            call sc__ABILZeromodelB_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILZeromodelB_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILZeromodelB_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILZeromodelB_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitState(s__ABILZeromodelB_source[this], UNIT_STATE_MANA) < 20 then
            return
        endif
        call SetUnitState(s__ABILZeromodelB_source[this], UNIT_STATE_MANA, 0.00)
        call s__CMGateofabaylon_cast(s__ABILZeromodelB_source[this] , s__EVDamageManager_getFinalDamage(s__ABILZeromodelB_source[this]) , 10)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()
