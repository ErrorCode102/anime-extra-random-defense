//library FXKnockback:

    
    
    function FXKnockback___OnExpire takes nothing returns nothing
        local integer self= s__tick_getExpired()
        local real curZ
        local real dltZ
        set FXKnockback___ICUR[self]=FXKnockback___ICUR[self] + 1
        set curZ=FXKnockback___ZHEI[self] * Sin(3.14 * FXKnockback___ICUR[self] / FXKnockback___IMAX[self])
        set dltZ=curZ - FXKnockback___PRVZ[self]
        set FXKnockback___SUMZ[self]=FXKnockback___SUMZ[self] + dltZ
        set FXKnockback___PRVZ[self]=curZ
        call SetUnitX(FXKnockback___USRC[self], GetUnitX(FXKnockback___USRC[self]) + FXKnockback___PODX[self])
        call SetUnitY(FXKnockback___USRC[self], GetUnitY(FXKnockback___USRC[self]) + FXKnockback___PODY[self])
        call SetUnitFlyHeight(FXKnockback___USRC[self], GetUnitFlyHeight(FXKnockback___USRC[self]) + dltZ, 0.00)
        if FXKnockback___ICUR[self] < FXKnockback___IMAX[self] then
            return
        endif
        if not IsUnitDead(FXKnockback___USRC[self]) then
            call UnitRemoveAbility(FXKnockback___USRC[self], FXKnockback___ABID)
            call UnitRemoveAbility(FXKnockback___USRC[self], FXKnockback___BFID)
            call SetUnitFlyHeight(FXKnockback___USRC[self], GetUnitFlyHeight(FXKnockback___USRC[self]) - FXKnockback___SUMZ[self], 0.00)
        endif
        set FXKnockback___USRC[self]=null
        call s__tick_destroy(self)
    endfunction
    
    function FXRD_FXKnockbackTo takes unit src,real tx,real ty,real mz,real dur returns nothing
        local integer self
        local real dist
        local real direct
        if GetUnitAbilityLevel(src, FXKnockback___ABID) > 0 then
            return
        endif
        if FXRD_FXIsImmuneKnockback(src) then
            return
        endif
        call UnitAddAbility(src, FXKnockback___ABID)
        set self=s__tick_create(0)
        set FXKnockback___PRVZ[self]=0
        set FXKnockback___SUMZ[self]=0
        set FXKnockback___USRC[self]=src
        call SetSafeXY(tx , ty)
        set FXKnockback___XEND[self]=GetSafeX()
        set FXKnockback___YEND[self]=GetSafeY()
        set FXKnockback___ZHEI[self]=mz
        set dist=s__Distance_WBP(src , FXKnockback___XEND[self] , FXKnockback___YEND[self])
        set direct=s__Angle_WBP(src , FXKnockback___XEND[self] , FXKnockback___YEND[self])
        set FXKnockback___IMAX[self]=IMaxBJ(1, R2I(dur * 32))
        set FXKnockback___PODX[self]=s__Polar_X(dist / FXKnockback___IMAX[self] , direct)
        set FXKnockback___PODY[self]=s__Polar_Y(dist / FXKnockback___IMAX[self] , direct)
        set FXKnockback___ICUR[self]=0
        call s__tick_start(self,0.03125 , true , function FXKnockback___OnExpire)
    endfunction
    
    function FXRD_FXKnockback takes unit src,real dir,real dist,real mz,real dur returns nothing
        local real x= GetUnitX(src) + s__Polar_X(dist , dir)
        local real y= GetUnitY(src) + s__Polar_Y(dist , dir)
        call FXRD_FXKnockbackTo(src , x , y , mz , dur)
    endfunction
    
    function FXRD_FXKnockbackFrom takes unit src,unit ori,real dist,real mz,real dur returns nothing
        local real dir= s__Angle_WBW(ori , src)
        call FXRD_FXKnockback(src , dir , dist , mz , dur)
    endfunction
    
    function FXRD_FXKnockbackFromPos takes unit src,real ox,real oy,real dist,real mz,real dur returns nothing
        local real dir= s__Angle_PBW(ox , oy , src)
        call FXRD_FXKnockback(src , dir , dist , mz , dur)
    endfunction
    
    function FXRD_FXKnockbackFromTo takes unit src,unit ori,real dist,real mz,real dur returns nothing
        local real dir= s__Angle_WBW(ori , src)
        set dist=dist - s__Distance_WBW(ori , src)
        call FXRD_FXKnockback(src , dir , dist , mz , dur)
    endfunction
    
    function FXRD_FXKnockbackFromToPos takes unit src,real ox,real oy,real dist,real mz,real dur returns nothing
        local real dir= s__Angle_PBW(ox , oy , src)
        set dist=dist - s__Distance_PBW(ox , oy , src)
        call FXRD_FXKnockback(src , dir , dist , mz , dur)
    endfunction
    
    function FXRD_FXKnockbackInverse takes unit src,unit ori,real dist,real mz,real dur returns nothing
        local real dir= s__Angle_WBW(ori , src) - 180
        call FXRD_FXKnockback(src , dir , dist , mz , dur)
    endfunction

