    function FXTrig1SInitialUnits___atCreateBuilding takes nothing returns nothing
        local integer i= 0
        if FXTrig1SInitialUnits___SLOTNUM == 4 then
            call DestroyTimer(GetExpiredTimer())
        endif
        loop
            exitwhen i == 4
            if USER_IS_PLAYING[i] then
                call s__eventCustom_evaluate(FXTrig1SInitialUnits___EVENT_PLAYER_BUILDING_SLOT[FXTrig1SInitialUnits___SLOTNUM] , Player(i) , null , null , 0)
            endif
            set i=i + 1
        endloop
        set FXTrig1SInitialUnits___SLOTNUM=FXTrig1SInitialUnits___SLOTNUM + 1
    endfunction
    
    function FXTrig1SInitialUnits___onGameInit takes nothing returns nothing
        call TimerStart(CreateTimer(), 1.00, true, function FXTrig1SInitialUnits___atCreateBuilding)
    endfunction
    
    function FXTrig1SInitialUnits___main takes nothing returns nothing
        set FXTrig1SInitialUnits___EVENT_PLAYER_BUILDING_SLOT[0]=EVENT_PLAYER_BUILDING_SLOT_0
        set FXTrig1SInitialUnits___EVENT_PLAYER_BUILDING_SLOT[1]=EVENT_PLAYER_BUILDING_SLOT_1
        set FXTrig1SInitialUnits___EVENT_PLAYER_BUILDING_SLOT[2]=EVENT_PLAYER_BUILDING_SLOT_2
        set FXTrig1SInitialUnits___EVENT_PLAYER_BUILDING_SLOT[3]=EVENT_PLAYER_BUILDING_SLOT_3
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXTrig1SInitialUnits___onGameInit)
    endfunction
