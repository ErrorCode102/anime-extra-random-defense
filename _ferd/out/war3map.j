// Trigger: FX Trig Try Servant Sell
//===========================================================================
// scope FXTrigTryServantSell begins
        
    function FXTrigTryServantSell___atServantSell takes player p,unit u returns nothing
            local integer lev= GetUnitLevel(u)
            local real x= GetUnitX(u)
            local real y= GetUnitY(u)
            local integer id= GetPlayerId(p)
            call s__servant_remove(p , u)
            call KillUnit(u)
            call ShowUnit(u, false)
            if lev > 3 then
                call SetSoundPosition(gg_snd_ServantPoint2, x, y, 200)
                call StartSoundForPlayerBJ(p, gg_snd_ServantPoint2)
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", x, y))
                call CreateWisp(p , lev)
            else
                if GetRandomReal(0.00, 100.00) < 70.00 then
                    call SetSoundPosition(gg_snd_ServantPoint2, x, y, 200)
                    call StartSoundForPlayerBJ(p, gg_snd_ServantPoint2)
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", x, y))
                    call DisplayTextToPlayer(p, 0.00, 0.00, "Sale success!")
                    call CreateWisp(p , IMaxBJ(1, lev - 1))
                else
                    call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Undead\\UndeadDissipate\\UndeadDissipate.mdl", x, y))
                    call DisplayTextToPlayer(p, 0.00, 0.00, "Sale failed ㅠㅠ")
                endif
            endif
    endfunction
    
    function FXTrigTryServantSell___onServantSell takes nothing returns nothing
        if GetPanalty(PANALTY_SERVANT_SELL_DISABLED) then
            call StartSoundForPlayerBJ(GetOwningPlayer(GetTriggerUnit()), gg_snd_Error)
            call s__bountyTag_custom(GetOwningPlayer(GetTriggerUnit()) , GetUnitX(GetTriggerUnit()) , GetUnitY(GetTriggerUnit()) , "|c00FF0000Penalty - Servants cannot be sold!|r")
            return
        endif
        call FXTrigTryServantSell___atServantSell(GetOwningPlayer(GetTriggerUnit()) , GetTriggerUnit())
    endfunction
    
    function FXTrigTryServantSell___main takes nothing returns nothing
        call s__AbilityEffectEvent_Create('A000' , function FXTrigTryServantSell___onServantSell)
    endfunction
    
