        call s__UnitSelectEvent_Create('n00U' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00V' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00W' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00X' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00Y' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00Z' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n010' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n011' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n012' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n013' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n014' , function UIGameSettingModule__onTogglePanaltyButton)
        
        call s__UnitSelectEvent_Create('n01F' , function UIGameSettingModule__onToggleDiffButton)
