        call TriggerUnbindAction(s__EV123NeroBrideA_onRemoveAction[this])
        set s__EV123NeroBrideA_onRemoveAction[this]=null
        //종결
        call s__EV123NeroBrideA_destroy(this)
    endfunction
    

//===========================================================================
// Trigger: EV 125 MooncellD
//===========================================================================

    
    function s__EV125MooncellD_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV125MooncellD_STRUCT_ID)
    endfunction
    
    function s__EV125MooncellD_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV125MooncellD_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV125MooncellD_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV125MooncellD__allocate()
        set s__EV125MooncellD_ID[this]=GetUnitUserData(src)
        call s__EV125MooncellD_setThis(s__EV125MooncellD_ID[this] , this)
        return this
    endfunction
    
    function s__EV125MooncellD_destroy takes integer this returns nothing
        call s__EV125MooncellD_setThis(s__EV125MooncellD_ID[this] , 0)
        call s__EV125MooncellD_deallocate(this)
    endfunction
    
    //API
    
    function s__EV125MooncellD_append takes unit src returns nothing
        local integer this= s__EV125MooncellD_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV125MooncellD failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV125MooncellD_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV125MooncellD_onSourceUnitRemove)
        set s__EV125MooncellD_myServant[this]=src
        
        set s__EV125MooncellD_onSpellEffect[this]=CreateTrigger()
        call TriggerAddCondition(s__EV125MooncellD_onSpellEffect[this], Condition(function sc__EV125MooncellD_conditionSpellEffect))
        set s__EV125MooncellD_onSpellEffectAction[this]=TriggerAddAction(s__EV125MooncellD_onSpellEffect[this], function sc__EV125MooncellD_actionSpellEffect)
        call TriggerRegisterUnitEvent(s__EV125MooncellD_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
        
        set s__EV125MooncellD_onSpellCast[this]=CreateTrigger()
        call TriggerAddCondition(s__EV125MooncellD_onSpellCast[this], Condition(function sc__EV125MooncellD_conditionSpellEffect))
        set s__EV125MooncellD_onSpellCastAction[this]=TriggerAddAction(s__EV125MooncellD_onSpellCast[this], function sc__EV125MooncellD_actionSpellCast)
        call TriggerRegisterUnitEvent(s__EV125MooncellD_onSpellCast[this], src, EVENT_UNIT_SPELL_CAST)
    endfunction
    
    //구현부
    function s__EV125MooncellD_actionSpellCast takes nothing returns nothing
        if IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            if GetUnitLevel(GetSpellTargetUnit()) == 7 then
                if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GP') == 0 then
                    if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A02W') == 0 then
                        return
                    endif
                else
                    call StartSoundForPlayerBJ(GetOwningPlayer(GetTriggerUnit()), gg_snd_Error)
                endif
            endif
        endif
        call UnitRemoveAbility(GetTriggerUnit(), 'A05B')
        call UnitAddAbility(GetTriggerUnit(), 'A05B')
        call IssueImmediateOrder(GetTriggerUnit(), "holdposition")
    endfunction
    function s__EV125MooncellD_actionSpellEffect takes nothing returns nothing
        local integer this= s__EV125MooncellD_getThis(GetUnitUserData(GetTriggerUnit()))
        //
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetTriggerUnit(), "origin"))
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GO') > 0 then
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetSpellTargetUnit(), "origin"))
            call UnitRemoveAbility(GetSpellTargetUnit(), 'A0GO')
            call UnitRemoveAbility(GetSpellTargetUnit(), 'A0GN')
            call UnitAddAbility(GetSpellTargetUnit(), 'A0GP')
            call UnitAddAbility(GetSpellTargetUnit(), 'A0GR')
            call s__EVDamageManager_addBonus(GetSpellTargetUnit() , 350)
        else
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetSpellTargetUnit(), "origin"))
            call UnitAddAbility(GetSpellTargetUnit(), 'A02W')
            call s__EVDamageManager_addBonus(GetSpellTargetUnit() , 100)
        endif
        //
        call UnitRemoveAbility(GetTriggerUnit(), 'A05B')
        call UnitAddAbility(GetTriggerUnit(), 'A02R')
    endfunction
    function s__EV125MooncellD_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == 'A05B'
    endfunction
    function s__EV125MooncellD_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV125MooncellD_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EV125MooncellD_onSpellEffect[this], s__EV125MooncellD_onSpellEffectAction[this])
        set s__EV125MooncellD_onSpellEffectAction[this]=null
        call DestroyTrigger(s__EV125MooncellD_onSpellEffect[this])
        set s__EV125MooncellD_onSpellEffect[this]=null
        call TriggerRemoveAction(s__EV125MooncellD_onSpellCast[this], s__EV125MooncellD_onSpellCastAction[this])
        set s__EV125MooncellD_onSpellCastAction[this]=null
        call DestroyTrigger(s__EV125MooncellD_onSpellCast[this])
        set s__EV125MooncellD_onSpellCast[this]=null
        set s__EV125MooncellD_myServant[this]=null
        call TriggerUnbindAction(s__EV125MooncellD_onRemoveAction[this])
        set s__EV125MooncellD_onRemoveAction[this]=null
        //종결
        call s__EV125MooncellD_destroy(this)
    endfunction
    
    

//===========================================================================
// Trigger: EV 126 BBB
//===========================================================================

    
    function s__EV126BBB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV126BBB_STRUCT_ID)
    endfunction
    
    function s__EV126BBB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV126BBB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV126BBB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV126BBB__allocate()
        set s__EV126BBB_ID[this]=GetUnitUserData(src)
        call s__EV126BBB_setThis(s__EV126BBB_ID[this] , this)
        return this
    endfunction
    
    function s__EV126BBB_destroy takes integer this returns nothing
        call s__EV126BBB_setThis(s__EV126BBB_ID[this] , 0)
        call s__EV126BBB_deallocate(this)
    endfunction
    
    //API
    function s__EV126BBB_append takes unit src,real coold,real delay,integer dests returns nothing
        local integer this= s__EV126BBB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV126BBB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV126BBB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV126BBB_onSourceUnitRemove)
        set s__EV126BBB_myServant[this]=src
        set s__EV126BBB_myBuffDelay[this]=delay
        set s__EV126BBB_myCooldown[this]=coold
        set s__EV126BBB_myTargetCount[this]=dests
        set s__EV126BBB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV126BBB_coolTick[this],1.00 , true , function sc__EV126BBB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV126BBB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV126BBB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV126BBB_coolTick[this])
        set s__EV126BBB_myServant[this]=null
        call TriggerUnbindAction(s__EV126BBB_onRemoveAction[this])
        set s__EV126BBB_onRemoveAction[this]=null
        //종결
        call s__EV126BBB_destroy(this)
    endfunction
    
    
    function s__EV126BBB_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__EV126BBB_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A07V') > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__EV126BBB_LEV then
            set s__EV126BBB_LEV=GetUnitLevel(GetEnumUnit())
            set s__EV126BBB_CNT=0
        endif
        if GetRandomInt(0, s__EV126BBB_CNT) == 0 then
            set s__EV126BBB_DEST=GetEnumUnit()
        endif
        set s__EV126BBB_CNT=s__EV126BBB_CNT + 1
    endfunction
    
    function s__EV126BBB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local integer i= 0
        if IsUnitType(s__EV126BBB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV126BBB_coolTick[this])
            return
        endif
        loop
            exitwhen i == s__EV126BBB_myTargetCount[this]
            set s__EV126BBB_DEST=null
            set s__EV126BBB_CNT=0
            set s__EV126BBB_LEV=0
            call s__splash_range(s__splash_ALLY , s__EV126BBB_myServant[this] , GetUnitX(s__EV126BBB_myServant[this]) , GetUnitY(s__EV126BBB_myServant[this]) , GetUnitAcquireRange(s__EV126BBB_myServant[this]) + 200 , function s__EV126BBB_enumGetTarget)
            if s__EV126BBB_DEST != null then
                call s__CMAurea_cast(s__EV126BBB_myServant[this] , s__EV126BBB_DEST , s__EV126BBB_myBuffDelay[this])
            endif
            set i=i + 1
        endloop
        call s__tick_start(s__EV126BBB_coolTick[this],s__EV126BBB_myCooldown[this] , true , function s__EV126BBB_onCastSpell)
        set s__EV126BBB_DEST=null
    endfunction
    

