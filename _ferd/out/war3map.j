function sa__ABILBBSSAConsume_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local player p= GetOwningPlayer(s__ABILBBSSAConsume_source[this])
        local boolean isError= false
        local string errmsg= "|c00FF0000Unknown Error!|r"
        local integer level= GetUnitLevel(GetSpellTargetUnit())
        local integer statamt= 0
        local integer stat
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GP') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『Raw power......it's too much.......』|r"
            else
                set errmsg=errmsg + "BB『How can it happen.......』|r"
            endif
        endif
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A0GO') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『It's unsightly.』|r"
            else
                set errmsg=errmsg + "BB『It tastes awful.』|r"
            endif
        endif
        if GetUnitAbilityLevel(GetSpellTargetUnit(), 'A02W') > 0 then
            set isError=true
            set errmsg="|c00FF0000Servant too powerful to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『I can't believe you're above me.......』|r"
            else
                set errmsg=errmsg + "BB『I can't accept this result......!』|r"
            endif
        endif
        if level > 7 then
            set isError=true
            set errmsg="|c00FF0000This unit cannot be consumed|r"
        endif
        if level < 4 then
            set isError=true
            set errmsg="|c00FF0000Too weak to be consumed!|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『It is unnecessary.』|r"
            else
                set errmsg=errmsg + "BB『You are so incompetent.』|r"
            endif
        endif
        if not IsUnitType(GetSpellTargetUnit(), UNIT_TYPE_TAUREN) then
            set isError=true
            set errmsg="|c00FF0000This unit cannot be consumed|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『......Hmm.』|r"
            else
                set errmsg=errmsg + "BB『Really.......』|r"
            endif
        endif
        if GetOwningPlayer(GetSpellTargetUnit()) != p then
            set isError=true
            set errmsg="|c00FF0000It's not a player-owned unit.|r"
        endif
        if GetUnitAbilityLevel(s__ABILBBSSAConsume_source[this], 'A0EM') <= 1 then
            set isError=true
            set errmsg="|c00FF0000Level is too low|c00FF8000\n"
            if GetRandomInt(0, 1) == 0 then
                set errmsg=errmsg + "BB『Weak.』|r"
            else
                set errmsg=errmsg + "BB『......Small.』|r"
            endif
        endif
        if isError then
            call StartSoundForPlayerBJ(p, gg_snd_Error)
            call DisplayTextToPlayer(p, 0.0, 0.0, errmsg)
        else
            call s__servant_kill(GetSpellTargetUnit() , true)
            set errmsg="BB's |c00FFFF00XP|r "
            if level == 4 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 100, true)
                set errmsg=errmsg + "|c00808080" + I2S(100) + "|r"
                set statamt=10
            endif
            if level == 5 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 250, true)
                set errmsg=errmsg + "|c00808080" + I2S(250) + "|r"
                set statamt=25
            endif
            if level == 6 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 1000, true)
                set errmsg=errmsg + "|c00808080" + I2S(1000) + "|r"
                set statamt=80
            endif
            if level == 7 then
                call AddHeroXP(s__ABILBBSSAConsume_source[this], 1500, true)
                set errmsg=errmsg + "|c00808080" + I2S(1500) + "|r"
                set statamt=115
            endif
            set errmsg=errmsg + " increases!\nBB's "
            set stat=GetRandomInt(0, 2)
            if stat == 0 then
                call SetHeroInt(s__ABILBBSSAConsume_source[this], GetHeroInt(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c004040FFIntelligence|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIim\\AIimTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            if stat == 1 then
                call SetHeroAgi(s__ABILBBSSAConsume_source[this], GetHeroAgi(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c0040FF40Agility|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            if stat == 2 then
                call SetHeroStr(s__ABILBBSSAConsume_source[this], GetHeroStr(s__ABILBBSSAConsume_source[this], false) + statamt, true)
                set errmsg=errmsg + "|c00FF8000Strength|r "
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIsm\\AIsmTarget.mdl", s__ABILBBSSAConsume_source[this], "origin"))
            endif
            set errmsg=errmsg + "|c00808080" + I2S(statamt) + "|r increases!"
