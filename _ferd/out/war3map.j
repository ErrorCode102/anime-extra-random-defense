// Trigger: Mod FXOnlineCheck
//===========================================================================
// scope FXOnlineCheck begins


    function FXOnlineCheck__onEnd takes nothing returns nothing
        local integer i= 0
        call DestroyTimer(GetExpiredTimer())
        set GAME_IS_ONLINE=true
        loop
            if GetPlayerState(Player(i), PLAYER_STATE_RESOURCE_GOLD) > 0 then
                call SetPlayerState(Player(i), PLAYER_STATE_RESOURCE_GOLD, 0)
                call SetPlayerState(Player(i), PLAYER_STATE_RESOURCE_LUMBER, 0)
                set GAME_IS_ONLINE=false
            endif
            set i=i + 1
            exitwhen i == 12
        endloop
        call s__FXMapInit_ImInitialized()
    endfunction
    
    function FXOnlineCheck__onMapInitializing takes nothing returns nothing
        call s__FXMapInit_ImInitializerModule()
        call Cheat("greedisgood")
        call TimerStart(CreateTimer(), FXOnlineCheck__DELAY_ONLINE_CHECK, false, function FXOnlineCheck__onEnd)
    endfunction

    function FXOnlineCheck__main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_MAP_INITIALIZING , function FXOnlineCheck__onMapInitializing)
    endfunction
    
// scope FXOnlineCheck ends

//===========================================================================
// Trigger: Mod DRM
//===========================================================================
// scope DRM begins


    function DRM__GenerateTable takes nothing returns nothing
        local integer i= 0
        local string s= "Default String"
        local string ts= ""
        if GetAbilityEffectById(DRM__ID, EFFECT_TYPE_TARGET, 0) == null then
            return
        endif
        loop
            set ts=GetAbilityEffectById(DRM__ID, EFFECT_TYPE_TARGET, i)
            exitwhen ts == null
            exitwhen ts == s
            set s=ts
            call SaveStr(DRM__TABLE, 0, StringHash(ts), ts)
            set i=i + 1
        endloop
    endfunction

    function DRM__ApplyTable takes nothing returns nothing
        local integer i= 0
        local string sh
        loop
            exitwhen i == 4
            set sh=GetPlayerName(Player(i))
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING then
                if HaveSavedString(DRM__TABLE, 0, StringHash(sh)) then
                    if sh == LoadStr(DRM__TABLE, 0, StringHash(sh)) then
                        call DisplayTimedTextToPlayer(Player(i), 0, 0, 3600, "|c00FF8000" + GetAbilityEffectById(DRM__ID, EFFECT_TYPE_MISSILE, 0) + "|r")
                        call DisplayTimedTextToPlayer(Player(i), 0, 0, 3600, "|c00FF8000" + GetAbilityEffectById(DRM__ID, EFFECT_TYPE_MISSILE, 1) + "|r")
                        call RemovePlayer(Player(i), PLAYER_GAME_RESULT_NEUTRAL)
                    endif
                endif
            endif
            set i=i + 1
        endloop
    endfunction
    
    function DRM__action takes nothing returns nothing
        call DRM__GenerateTable()
        call DRM__ApplyTable()
    endfunction

    function DRM__main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function DRM__action)
        call TriggerRegisterTimerEvent(t, 0.20, false)
        set t=null
    endfunction
    
// scope DRM ends
// Trigger: Mod Handle Performance
//===========================================================================
// scope HandlePerformance begins

    
    function HandlePerformance__getCurrentHandle takes nothing returns integer
        local location chl= Location(HandlePerformance__LX, HandlePerformance__LY)
        local integer r= GetHandleId(chl)
        call RemoveLocation(chl)
        set chl=null
        return r
    endfunction
    
    function HandlePerformance__getKey takes nothing returns nothing
        call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.0, 0.0, 20, "Leak Handle Value : " + I2S(HandlePerformance__HND))
    endfunction
    
    function HandlePerformance__validCheck takes nothing returns nothing
        set MAP_SESSION=IntegerTertiaryOp(HandlePerformance__HND == S2I(GetAbilityEffectById(HandlePerformance__ID, EFFECT_TYPE_LIGHTNING, 0)) and HandlePerformance__RELEASE_VERSION, 1, 0)
        if MAP_SESSION == 1 then
            set GAME_WELCOME="|c000FA3F0Thank you for playing Fate Extra Random Defense Official Map|r"
        else
            set GAME_WELCOME="|c00FF8000Note: You are currently playing an unofficial map or public test version\nThere is a risk of losing your save code due to a bug, so be sure to backup it before loading!|r"
        endif
    endfunction
    
    function HandlePerformance__action takes nothing returns nothing
        set MAP_INITIAL_USER=GetPlayerId(GetLocalPlayer())
        set HandlePerformance__HND=HandlePerformance__getCurrentHandle()
        if not HandlePerformance__MAP_EXPORT then
            call HandlePerformance__getKey()
        endif
        call HandlePerformance__validCheck()
    endfunction

    function HandlePerformance__main takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerAddAction(t, function HandlePerformance__action)
        call TriggerRegisterTimerEvent(t, 0.02, false)
        set t=null
    endfunction
    
// scope HandlePerformance ends
