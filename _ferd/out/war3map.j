// scope TrigFactionTamamoMPRegen begins
    function TrigFactionTamamoMPRegen__CheckMp takes player p returns nothing
        //FXRD 세력 - 현재 세력이 (TAMAMO)가 아니라면, 즉시 종료합니다.
        if FXGetPlayerCurrentFaction(p) != FX_FACTION_TAMAMO then
            return
        endif
        // 플레이어에게 100MP를 추가합니다.
        call AddPlayerMp(p , 100)
    endfunction
    function TrigFactionTamamoMPRegen__onGameRound takes nothing returns nothing
        local integer id= GetPlayerId(s__eventCustom_getTriggerPlayer())
        if id == 11 then
            call TrigFactionTamamoMPRegen__CheckMp(Player(0))
            call TrigFactionTamamoMPRegen__CheckMp(Player(1))
            call TrigFactionTamamoMPRegen__CheckMp(Player(2))
            call TrigFactionTamamoMPRegen__CheckMp(Player(3))
        else
            call TrigFactionTamamoMPRegen__CheckMp(Player(id))
        endif
    endfunction
    function TrigFactionTamamoMPRegen__main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_ROUND , function TrigFactionTamamoMPRegen__onGameRound)
    endfunction
// scope TrigFactionTamamoMPRegen ends
