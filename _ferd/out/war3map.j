    function FXGameSettingScreenControl__EnableControl takes nothing returns nothing
        call EnableSelect(true, true)
    endfunction
    
    function FXGameSettingScreenControl__onGameSetting takes nothing returns nothing
        call ShowInterface(true, 1.0)
        call TimerStart(FXGameSettingScreenControl__MODULE_TIMER, FXGameSettingScreenControl__DELAY_CONTROL_ENABLE, false, function FXGameSettingScreenControl__EnableControl)
    endfunction

    function FXGameSettingScreenControl__main takes nothing returns nothing
