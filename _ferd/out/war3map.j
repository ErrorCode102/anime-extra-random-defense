//textmacro instance: 어빌리티_선언_개시("MashuDLord")
//end of: 어빌리티_선언_개시("MashuDLord")
    function s__ABILMashuDLord_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if IsUnitDead(GetEnumUnit()) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectCaster.mdl", GetEnumUnit(), "origin"))
        call SetUnitState(GetEnumUnit(), UNIT_STATE_MANA, GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_MANA))
        call FXRD_FXImmuneStunTimed(GetEnumUnit() , 10.00)
        call FXRD_FXImmuneKnockbackTimed(GetEnumUnit() , 10.00)
        call sc__BUFFLordCamelot_apply(GetEnumUnit() , 10.00)
    endfunction
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0EK")
    
    function s__ABILMashuDLord_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMashuDLord_onSpellEffect[this], s__ABILMashuDLord_onSpellEffectAction[this])
        set s__ABILMashuDLord_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILMashuDLord_onSpellEffect[this])
        set s__ABILMashuDLord_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILMashuDLord_rmTrig[this], s__ABILMashuDLord_rmAct[this])
        set s__ABILMashuDLord_rmAct[this]=null
        set s__ABILMashuDLord_rmTrig[this]=null
        call sc__ABILMashuDLord_onAbilityLost(this)
        set s__ABILMashuDLord_source[this]=null
        set s__ABILMashuDLord_exists[this]=false
    endfunction
    
    function s__ABILMashuDLord_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMashuDLord_free(this)
    endfunction
    
    function s__ABILMashuDLord_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMashuDLord_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMashuDLord_exists[this] then
            set s__ABILMashuDLord_exists[this]=true
            set s__ABILMashuDLord_source[this]=src
            set s__ABILMashuDLord_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMashuDLord_rmAct[this]=TriggerAddAction(s__ABILMashuDLord_rmTrig[this], function s__ABILMashuDLord_OnSourceRemove)
            set s__ABILMashuDLord_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILMashuDLord_onSpellEffect[this], Condition(function sc__ABILMashuDLord_conditionSpellEffect))
            set s__ABILMashuDLord_onSpellEffectAction[this]=TriggerAddAction(s__ABILMashuDLord_onSpellEffect[this], function sc__ABILMashuDLord_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILMashuDLord_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILMashuDLord_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILMashuDLord_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILMashuDLord_exists[this] then
            return
        endif
        call sc__ABILMashuDLord_onAbilityEffect(this)
    endfunction
    
    function s__ABILMashuDLord_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILMashuDLord_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0EK")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILMashuDLord_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMashuDLord_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMashuDLord_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o014', GetUnitX(s__ABILMashuDLord_source[this]), GetUnitY(s__ABILMashuDLord_source[this]), 270.00))
        call s__splash_range(s__splash_ALLY , s__ABILMashuDLord_source[this] , GetUnitX(s__ABILMashuDLord_source[this]) , GetUnitY(s__ABILMashuDLord_source[this]) , 1000 , function s__ABILMashuDLord_enumGetTarget)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
