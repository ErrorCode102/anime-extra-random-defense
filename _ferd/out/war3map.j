    function s__UIGameSettingV2_DestroyPlayerUI takes nothing returns nothing
        local integer i= 0
        local integer f
        loop
            exitwhen i == 4
            call sc__InterfaceNumpad_destroy(s__UIGameSettingV2_num_lv[i])
            call sc__InterfaceNumpad_destroy(s__UIGameSettingV2_num_xp[i])
            call RemoveDestructable(s__s__UIGameSettingV2_spr_dock[i])
            set s__s__UIGameSettingV2_spr_dock[i]= null
            set f=1
            loop
                call sc__InterfaceNumpad_destroy(s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f])
                exitwhen f == FX_FACTION_MAX
                set f=f + 1
            endloop
            set i=i + 1
        endloop
    endfunction
    
    function s__UIGameSettingV2_CreatePlayerUI takes integer this returns nothing
        local integer i= 0
        local integer f
        local integer lvIndex
        loop
            exitwhen i == 4
            set s__UIGameSettingV2_num_lv[i]=sc__InterfaceNumpad_create(Player(i) , 5424.0 , 62.0 - 256.0 , "FXRD\\Numbers\\BlueNeon\\" , 0.5)
            set s__UIGameSettingV2_num_xp[i]=sc__InterfaceNumpad_create(Player(i) , 7004.0 , - 264.0 , "FXRD\\Numbers\\BlueNeon\\" , 1.0)
            set f=1
            loop
                set lvIndex=f - 1
                set s__UIGameSettingV2_num_lstlv[i * FX_FACTION_MAX + f]=sc__InterfaceNumpad_create(Player(i) , 5490.0 + 192.0 * ModuloInteger(lvIndex, 4) , 232.0 - ( 288.0 * ( lvIndex / 4 ) ) , "FXRD\\Numbers\\BlueNeon\\" , 1.0)
                exitwhen f == FX_FACTION_MAX
                set f=f + 1
            endloop
            set i=i + 1
        endloop
    endfunction
    
