    function FXPreloadAbil__PreloadLibraries takes nothing returns nothing
        local unit u= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), 'ncop', 0.00, 0.00, 270.00)
        call ShowUnit(u, false)
        //======================Preload Ability=====================
        call sc__EVDamageManager_preload(u)
        call s__lifeMod_preload(u)
        call s__manaMod_preload(u)
        //=======================Preload End======================
        call KillUnit(u)
        set u=null
    endfunction

    function FXPreloadAbil__CallBack takes nothing returns nothing
        call FXPreloadAbil__PreloadLibraries()
        call s__FXMapInit_ImInitialized()
    endfunction
    
    function FXPreloadAbil__onMapInitializing takes nothing returns nothing
        call s__FXMapInit_ImInitializerModule()
        call TimerStart(FXPreloadAbil__MODULE_TIMER, FXPreloadAbil__DELAY_LOAD, false, function FXPreloadAbil__CallBack)
    endfunction

    function FXPreloadAbil__main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_MAP_INITIALIZING , function FXPreloadAbil__onMapInitializing)
    endfunction
    
