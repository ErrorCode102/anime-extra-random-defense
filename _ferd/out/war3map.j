    endfunction
    
    
    function s__EV116AlteraA_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV116AlteraA_CNT) == 0 then
            set s__EV116AlteraA_DEST=GetEnumUnit()
        endif
        set s__EV116AlteraA_CNT=s__EV116AlteraA_CNT + 1
    endfunction
    
    function s__EV116AlteraA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV116AlteraA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV116AlteraA_coolTick[this])
            return
        endif
        set s__EV116AlteraA_DEST=null
        set s__EV116AlteraA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV116AlteraA_myServant[this] , GetUnitX(s__EV116AlteraA_myServant[this]) , GetUnitY(s__EV116AlteraA_myServant[this]) , GetUnitAcquireRange(s__EV116AlteraA_myServant[this]) , function s__EV116AlteraA_enumGetTarget)
        //대상이 없으면
        if s__EV116AlteraA_DEST == null then
            call s__tick_start(s__EV116AlteraA_coolTick[this],1.00 , true , function s__EV116AlteraA_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMCivildestroyer_cast(s__EV116AlteraA_myServant[this] , s__EVDamageManager_getFinalDamage(s__EV116AlteraA_myServant[this]) * 2.50 , GetUnitX(s__EV116AlteraA_DEST) , GetUnitY(s__EV116AlteraA_DEST) , s__EV116AlteraA_mySize[this])
        call s__tick_start(s__EV116AlteraA_coolTick[this],s__EV116AlteraA_myCooldown[this] , true , function s__EV116AlteraA_onCastSpell)
        set s__EV116AlteraA_DEST=null
    endfunction
    
    

