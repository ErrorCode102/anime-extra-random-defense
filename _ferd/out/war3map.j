    function s__BUFFEnkiduEnuma_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        call KillUnit(s__BUFFEnkiduEnuma_fx[this])
        set s__BUFFEnkiduEnuma_fx[this]=null
