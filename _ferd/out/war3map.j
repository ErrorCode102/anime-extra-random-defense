    endfunction
    
    function s__EVDamageBounty_destroy takes integer this returns nothing
        call s__EVDamageBounty_setThis(s__EVDamageBounty_ID[this] , 0)
        call s__EVDamageBounty_deallocate(this)
    endfunction
    
    //API
    function s__EVDamageBounty_append takes unit src returns nothing
        local integer this= s__EVDamageBounty_create(src)
        local integer i= 0
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVDamageBounty application failed!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EVDamageBounty_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVDamageBounty_onSourceUnitRemove)
        set s__EVDamageBounty_mySource[this]=src
        set s__EVDamageBounty_bestDamage[this]=0
        loop
            exitwhen i == bj_MAX_PLAYER_SLOTS
            set s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+i]=0
            set i=i + 1
        endloop
        set s__EVDamageBounty_atDeath[this]=CreateTrigger()
        set s__EVDamageBounty_onDeathAction[this]=TriggerAddAction(s__EVDamageBounty_atDeath[this], function sc__EVDamageBounty_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVDamageBounty_atDeath[this], src, EVENT_UNIT_DEATH)
        set s__EVDamageBounty_atDamage[this]=CreateTrigger()
        set s__EVDamageBounty_onDamageAction[this]=TriggerAddAction(s__EVDamageBounty_atDamage[this], function sc__EVDamageBounty_onSourceUnitDamage)
        call TriggerRegisterUnitEvent(s__EVDamageBounty_atDamage[this], src, EVENT_UNIT_DAMAGED)
    endfunction
    
    //구현부
    function s__EVDamageBounty_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVDamageBounty_getThis(s__EVUnitRemove_e)
        //누수처리
        call TriggerRemoveAction(s__EVDamageBounty_atDeath[this], s__EVDamageBounty_onDeathAction[this])
        set s__EVDamageBounty_onDeathAction[this]=null
        call DestroyTrigger(s__EVDamageBounty_atDeath[this])
        set s__EVDamageBounty_atDeath[this]=null
        call TriggerRemoveAction(s__EVDamageBounty_atDamage[this], s__EVDamageBounty_onDamageAction[this])
        set s__EVDamageBounty_onDamageAction[this]=null
        call DestroyTrigger(s__EVDamageBounty_atDamage[this])
        set s__EVDamageBounty_atDamage[this]=null
        set s__EVDamageBounty_mySource[this]=null
        call TriggerUnbindAction(s__EVDamageBounty_onRemoveAction[this])
        set s__EVDamageBounty_onRemoveAction[this]=null
        //종결
        call s__EVDamageBounty_destroy(this)
    endfunction
    
    function s__EVDamageBounty_onSourceUnitDamage takes nothing returns nothing
        local integer this= s__EVDamageBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(GetEventDamageSource()))
        set s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id]=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] + GetEventDamage()
        if s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] > s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+s__EVDamageBounty_bestDamage[this]] then
            set s__EVDamageBounty_bestDamage[this]=id
        endif
    endfunction
    
    function s__EVDamageBounty_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVDamageBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id= GetPlayerId(GetOwningPlayer(s__EVDamageBounty_mySource[this]))
        local real perc
        if not GAME_IS_PLAYING then
            return
        endif
        if id == 11 then
            //동맹 전체 중 개인 보상
            set id=s__EVDamageBounty_bestDamage[this]
            if not USER_IS_PLAYING[id] then
                return
            endif
            set perc=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] / GetUnitState(s__EVDamageBounty_mySource[this], UNIT_STATE_MAX_LIFE) * 100
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Ace Reward - " + s__pcs_get(Player(id)) + "|r")
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Damage Done: |c008080FF" + I2S(R2I(s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id])) + "|r (" + R2S(perc) + "%)")
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80 - 2 Wisps|r")
            call CreateWisp(Player(id) , 2)
            set id=GetPlayerId(GetLocalPlayer())
            if USER_IS_PLAYING[id] then
                set perc=s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id] / GetUnitState(s__EVDamageBounty_mySource[this], UNIT_STATE_MAX_LIFE) * 100
                call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "|c0080FF80Damage done by you: |c008080FF" + I2S(R2I(s___EVDamageBounty_myDamage[s__EVDamageBounty_myDamage[this]+id])) + "|r (" + R2S(perc) + "%)")
            endif
            return
        endif
        //개인 보상 - 없음
    endfunction
    

//===========================================================================
// Trigger: EV 17 ServantChanger
//===========================================================================

    
    function s__EVServantChanger_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVServantChanger_STRUCT_ID)
    endfunction
    
    function s__EVServantChanger_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EVServantChanger_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EVServantChanger_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EVServantChanger__allocate()
        set s__EVServantChanger_ID[this]=GetUnitUserData(src)
        call s__EVServantChanger_setThis(s__EVServantChanger_ID[this] , this)
        return this
    endfunction
    
    function s__EVServantChanger_destroy takes integer this returns nothing
        call s__EVServantChanger_setThis(s__EVServantChanger_ID[this] , 0)
        call s__EVServantChanger_deallocate(this)
    endfunction
    
    //API
    function s__EVServantChanger_append takes unit src,real delay,real nd,integer lev,boolean chained returns boolean
        local integer this= s__EVServantChanger_create(src)
        local integer i= 0
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EVServantChanger application failed!")
            return false
        endif
        if GetUnitAbilityLevel(src, 'A08P') > 0 then
            return false
        endif
        //유닛 소거 시 자동소멸
        set s__EVServantChanger_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EVServantChanger_onSourceUnitRemove)
        set s__EVServantChanger_mySource[this]=src
        set s__EVServantChanger_myDelay[this]=nd
        set s__EVServantChanger_myLev[this]=lev
        set s__EVServantChanger_isChained[this]=chained
        set s__EVServantChanger_atDeath[this]=CreateTrigger()
        set s__EVServantChanger_onDeathAction[this]=TriggerAddAction(s__EVServantChanger_atDeath[this], function sc__EVServantChanger_onSourceUnitDeath)
        call TriggerRegisterUnitEvent(s__EVServantChanger_atDeath[this], src, EVENT_UNIT_DEATH)
        
        call UnitAddAbility(src, 'A08P')
        set s__EVServantChanger_myFx[this]=AddSpecialEffectTarget("FXRD\\FX\\GoldTimer\\GoldTimer.mdl", src, "origin")
        
        set s__EVServantChanger_myCoolTick[this]=s__tick_create(this)
        call s__tick_start(s__EVServantChanger_myCoolTick[this],delay , false , function sc__EVServantChanger_onChange)
        return true
    endfunction
    
    //구현부
    function s__EVServantChanger_onChange takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local real x= GetUnitX(s__EVServantChanger_mySource[this])
        local real y= GetUnitY(s__EVServantChanger_mySource[this])
        local real r= GetUnitFacing(s__EVServantChanger_mySource[this])
        local player p= GetOwningPlayer(s__EVServantChanger_mySource[this])
        local unit u= null
        call s__servant_remove(p , s__EVServantChanger_mySource[this])
        call KillUnit(s__EVServantChanger_mySource[this])
        call ShowUnit(s__EVServantChanger_mySource[this], false)
        call s__bountyTag_custom(p , x , y , "|c004040FF『Spiritron's transformation』 started!|r")
        set u=s__gacha_do(p , s__EVServantChanger_myLev[this] , x , y , r)
        call s__servant_add(p , u , s__servant_CHANGE)
        call IssueImmediateOrder(u, "holdposition")
        if s__EVServantChanger_isChained[this] then
            call s__EVServantChanger_append(u , s__EVServantChanger_myDelay[this] , s__EVServantChanger_myDelay[this] , s__EVServantChanger_myLev[this] , s__EVServantChanger_isChained[this])
        endif
        set u=null
        set p=null
    endfunction
    
    function s__EVServantChanger_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EVServantChanger_getThis(s__EVUnitRemove_e)
        //누수처리
        call DestroyEffect(s__EVServantChanger_myFx[this])
        set s__EVServantChanger_myFx[this]=null
        call s__tick_destroy(s__EVServantChanger_myCoolTick[this])
        call TriggerRemoveAction(s__EVServantChanger_atDeath[this], s__EVServantChanger_onDeathAction[this])
        set s__EVServantChanger_onDeathAction[this]=null
        call DestroyTrigger(s__EVServantChanger_atDeath[this])
        set s__EVServantChanger_atDeath[this]=null
        set s__EVServantChanger_mySource[this]=null
        call TriggerUnbindAction(s__EVServantChanger_onRemoveAction[this])
        set s__EVServantChanger_onRemoveAction[this]=null
        //종결
        call s__EVServantChanger_destroy(this)
    endfunction
    
    function s__EVServantChanger_onSourceUnitDeath takes nothing returns nothing
        local integer this= s__EVServantChanger_getThis(GetUnitUserData(GetTriggerUnit()))
        call s__tick_pause(s__EVServantChanger_myCoolTick[this])
    endfunction
    

