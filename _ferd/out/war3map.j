    function s__CMSakanis_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMSakanis_caster[this]=null
        call s__tick_destroy(s__CMSakanis_main[this])
    endfunction
    function s__CMSakanis_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , 3.00)
        call s__EVDebuffSlow_apply(GetEnumUnit() , 5.00)
        call s__enemy_dealLogic(s__CMSakanis_caster[this] , GetEnumUnit() , s__CMSakanis_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMSakanis_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real x= GetUnitX(s__CMSakanis_caster[this])
        local real y= GetUnitY(s__CMSakanis_caster[this])
        if IsUnitType(s__CMSakanis_caster[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMSakanis_main[this],0.20 , false , function s__CMSakanis_onFinal)
            return
        endif
        set s__CMSakanis_loops[this]=s__CMSakanis_loops[this] + 1
        if s__CMSakanis_loops[this] == 5 then
            call SetSoundPosition(gg_snd_HowlOfTerror, x, y, 300.0)
            call StartSound(gg_snd_HowlOfTerror)
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'h00K', x, y, 270))
            call s__splash_range(s__splash_ENEMY , s__CMSakanis_caster[this] , x , y , 700 , function s__CMSakanis_enumDealt)
            call s__tick_start(s__CMSakanis_main[this],0.2 , false , function s__CMSakanis_onFinal)
            return
        endif
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o01E', x, y, GetRandomReal(0.00, 360.00)))
    endfunction
    function s__CMSakanis_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMSakanis_caster[this]=src
        set s__CMSakanis_loops[this]=0
        set s__CMSakanis_damage[this]=dmg
        set s__CMSakanis_main[this]=this
        call s__tick_start(s__CMSakanis_main[this],0.1 , true , function s__CMSakanis_onFire)
    endfunction

    function s__CMBathory_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMBathory_caster[this]=null
        call s__tick_destroy(s__CMBathory_main[this])
    endfunction
    function s__CMBathory_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
        call s__EVDebuffSlow_apply(GetEnumUnit() , 1.00)
        call DestroyEffect(AddSpecialEffect("FX\\Elizabeth\\Sonic.mdl", GetUnitX(GetEnumUnit()), GetUnitY(GetEnumUnit())))
        call s__enemy_dealLogic(s__CMBathory_caster[this] , GetEnumUnit() , s__CMBathory_damage[this] , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
    endfunction
    function s__CMBathory_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang= GetUnitFacing(s__CMBathory_caster[this])
        local real x= GetUnitX(s__CMBathory_caster[this])
        local real y= GetUnitY(s__CMBathory_caster[this])
        if IsUnitType(s__CMBathory_caster[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMBathory_main[this],0.2 , false , function s__CMBathory_onFinal)
            return
        endif
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o01E', x, y, GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(FX_PLAYER_DUMMY, '#xch', x, y, ang))
        call s__splash_range(s__splash_ENEMY , s__CMBathory_caster[this] , x , y , 600 , function s__CMBathory_enumDealt)
        call s__tick_start(s__CMBathory_main[this],0.20 , false , function s__CMBathory_onFinal)
    endfunction
    function s__CMBathory_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMBathory_caster[this]=src
        set s__CMBathory_damage[this]=dmg
        set s__CMBathory_main[this]=this
        call s__tick_start(s__CMBathory_main[this],0.10 , true , function s__CMBathory_onFire)
    endfunction
