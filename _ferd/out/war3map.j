    function s__ABILMeltCMeltout_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMeltCMeltout_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMeltCMeltout_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real dmg= sc__EVDamageManager_getFinalDamage(s__ABILMeltCMeltout_source[this]) * 20
        call FXRD_FXDebuffShock(GetSpellTargetUnit() , 10.00)
        call s__enemy_dealLogicEx(s__ABILMeltCMeltout_source[this] , GetSpellTargetUnit() , dmg , false , true , WEAPON_TYPE_WHOKNOWS , 1)
        call s__enemy_dealLogicEx(s__ABILMeltCMeltout_source[this] , GetSpellTargetUnit() , dmg , true , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
