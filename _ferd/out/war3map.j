        call s__EV109VladB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV109VladB_append takes unit src,real dmg,real coold returns nothing
        local integer this= s__EV109VladB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV109VladB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV109VladB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV109VladB_onSourceUnitRemove)
        set s__EV109VladB_myServant[this]=src
        set s__EV109VladB_myDamage[this]=dmg
        set s__EV109VladB_myCooldown[this]=coold
        set s__EV109VladB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV109VladB_coolTick[this],0.30 , true , function sc__EV109VladB_onCastSpell)
    endfunction
    
    //구현부
    
    function s__EV109VladB_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV109VladB_CNT) == 0 then
            set s__EV109VladB_DEST=GetEnumUnit()
        endif
        set s__EV109VladB_CNT=s__EV109VladB_CNT + 1
    endfunction
    
    function s__EV109VladB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV109VladB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV109VladB_coolTick[this])
            return
        endif
        set s__EV109VladB_DEST=null
        set s__EV109VladB_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV109VladB_myServant[this] , GetUnitX(s__EV109VladB_myServant[this]) , GetUnitY(s__EV109VladB_myServant[this]) , GetUnitAcquireRange(s__EV109VladB_myServant[this]) , function s__EV109VladB_enumGetTarget)
        //대상이 없으면
        if s__EV109VladB_DEST == null then
            call s__tick_start(s__EV109VladB_coolTick[this],1.00 , true , function s__EV109VladB_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMKazicleVoyvoda_cast(s__EV109VladB_myServant[this] , s__EV109VladB_DEST , s__EV109VladB_myDamage[this])
        call s__tick_start(s__EV109VladB_coolTick[this],s__EV109VladB_myCooldown[this] , true , function s__EV109VladB_onCastSpell)
        set s__EV109VladB_DEST=null
    endfunction
    
    function s__EV109VladB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV109VladB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV109VladB_coolTick[this])
        set s__EV109VladB_myServant[this]=null
        call TriggerUnbindAction(s__EV109VladB_onRemoveAction[this])
        set s__EV109VladB_onRemoveAction[this]=null
        //종결
        call s__EV109VladB_destroy(this)
    endfunction
    
    

//===========================================================================
// Trigger: EV 110 KireiA
//===========================================================================

    
    function s__EV110KireiA_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV110KireiA_STRUCT_ID)
    endfunction
    
    function s__EV110KireiA_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV110KireiA_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV110KireiA_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV110KireiA__allocate()
        set s__EV110KireiA_ID[this]=GetUnitUserData(src)
        call s__EV110KireiA_setThis(s__EV110KireiA_ID[this] , this)
        return this
    endfunction
    
    function s__EV110KireiA_destroy takes integer this returns nothing
        call s__EV110KireiA_setThis(s__EV110KireiA_ID[this] , 0)
        call s__EV110KireiA_deallocate(this)
    endfunction
    
    //API
    
    function s__EV110KireiA_append takes unit src,real dmg,boolean pen,boolean addit returns nothing
        local integer this= s__EV110KireiA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV110KireiA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV110KireiA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV110KireiA_onSourceUnitRemove)
        set s__EV110KireiA_myServant[this]=src
        set s__EV110KireiA_myLastTarget[this]=null
        set s__EV110KireiA_myDamage[this]=dmg
        set s__EV110KireiA_myDmgIgnoreShield[this]=pen
        set s__EV110KireiA_myDmgKickShield[this]=addit
        set s__EV110KireiA_myCombo[this]=3
        
        set s__EV110KireiA_myHandEffect[this]=null
        call s__EVServantAttack_addFunction(src , function sc__EV110KireiA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV110KireiA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV110KireiA_getThis(GetUnitUserData(src))
        if dst != s__EV110KireiA_myLastTarget[this] then
            set s__EV110KireiA_myLastTarget[this]=dst
            set s__EV110KireiA_myCombo[this]=3
            if s__EV110KireiA_myHandEffect[this] != null then
                call DestroyEffect(s__EV110KireiA_myHandEffect[this])
                set s__EV110KireiA_myHandEffect[this]=null
            endif
        endif
        set s__EV110KireiA_myCombo[this]=s__EV110KireiA_myCombo[this] - 1
        if s__EV110KireiA_myCombo[this] == 1 then
            if s__EV110KireiA_myHandEffect[this] != null then
                call DestroyEffect(s__EV110KireiA_myHandEffect[this])
            endif
            set s__EV110KireiA_myHandEffect[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", s__EV110KireiA_myServant[this], "hand right")
        endif
        if s__EV110KireiA_myCombo[this] == 0 then
            if s__EV110KireiA_myHandEffect[this] != null then
                call DestroyEffect(s__EV110KireiA_myHandEffect[this])
                set s__EV110KireiA_myHandEffect[this]=null
            endif
            set s__EV110KireiA_myCombo[this]=3
            //cast it
            call s__CMDeathfistbuff_cast(s__EV110KireiA_myServant[this] , 5.00)
            call s__CMDeathfist_cast(s__EV110KireiA_myServant[this] , dst , s__EV110KireiA_myDamage[this] , s__EV110KireiA_myDmgIgnoreShield[this] , s__EV110KireiA_myDmgKickShield[this])
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV110KireiA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV110KireiA_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV110KireiA_myHandEffect[this] != null then
            call DestroyEffect(s__EV110KireiA_myHandEffect[this])
            set s__EV110KireiA_myHandEffect[this]=null
        endif
        set s__EV110KireiA_myLastTarget[this]=null
        set s__EV110KireiA_myServant[this]=null
        call TriggerUnbindAction(s__EV110KireiA_onRemoveAction[this])
        set s__EV110KireiA_onRemoveAction[this]=null
        //종결
        call s__EV110KireiA_destroy(this)
    endfunction
    
    

