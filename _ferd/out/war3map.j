    function UIResultBackground___onClosing takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        
        local real x= GetPlayerStartLocationX(p)
        local real y= GetPlayerStartLocationY(p)
        
        call sc__InterfaceBackground_destroy(UIResultBackground___UI_FRAGMENT[id])
        call FixCameraForPlayer(p , null)
        call EnableSmartSeeyaForPlayer(p , true)
        if GetLocalPlayer() == p then
            call EnableDragSelect(true, true)
            call ResetToGameCamera(0.0)
            call PanCameraToTimed(x, y, 0.0)
        endif
        
        set p=null
    endfunction
    
    function UIResultBackground___onOpening takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        
        set UIResultBackground___UI_FRAGMENT[id]=sc__InterfaceBackground_create(p)
        call EnableSmartSeeyaForPlayer(p , false)
        call FixCameraForPlayer(p , gg_cam_ui_zone)
        if GetLocalPlayer() == p then
            call EnableDragSelect(false, false)
            call CameraSetupApplyForceDuration(gg_cam_ui_zone, true, 0.0)
        endif
    
        set p=null
    endfunction
    
    function UIResultBackground___onUpdating takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        local integer ui= (id)
        
        call sc__InterfaceBackground_show(UIResultBackground___UI_FRAGMENT[id],s__FXResultInterface_Visible[ui])
        
        set p=null
    endfunction

    function UIResultBackground___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_OPENING , function UIResultBackground___onOpening)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_UPDATING , function UIResultBackground___onUpdating)
        call RRRegisterResponseEvent(RESPONSE_UI_RESULT_CLOSING , function UIResultBackground___onClosing)
    endfunction
    
