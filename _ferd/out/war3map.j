function sa__ABILAstefDHippo_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local player p= GetOwningPlayer(s__ABILAstefDHippo_source[this])
        local real x= GetSpellTargetX()
        local real y= GetSpellTargetY()
        if not IsUnitDead(s__ABILAstefDHippo_HIPPO[this]) then
            call s__servant_kill(s__ABILAstefDHippo_HIPPO[this] , false)
        endif
        if RectContainsCoords(gg_rct_SP1_LINE, x, y) and USER_IS_PLAYING[0] then
            set p=Player(0)
        endif
        if RectContainsCoords(gg_rct_SP2_LINE, x, y) and USER_IS_PLAYING[1] then
            set p=Player(1)
        endif
        if RectContainsCoords(gg_rct_SP3_LINE, x, y) and USER_IS_PLAYING[2] then
            set p=Player(2)
        endif
        if RectContainsCoords(gg_rct_SP4_LINE, x, y) and USER_IS_PLAYING[3] then
            set p=Player(3)
        endif
        set s__ABILAstefDHippo_HIPPO[this]=CreateUnit(p, 'h00I', x, y, GetUnitFacing(s__ABILAstefDHippo_source[this]))
        call s__servant_add(GetOwningPlayer(s__ABILAstefDHippo_HIPPO[this]) , s__ABILAstefDHippo_HIPPO[this] , s__servant_QUIET)
        set p=null
   return true
endfunction
