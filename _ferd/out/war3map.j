    function SvTamamo___onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvTamamo___onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvTamamo___ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvTamamo___onAttack)
        //Adding Special Skillz
        if lv == 4 then
            call sc__EV127TamamoA_append(s__eventServantAdd_e , 3.0 , 5.0 , 1)
        endif
        if lv == 5 then
            call sc__EV127TamamoA_append(s__eventServantAdd_e , 2.0 , 5.0 , 1)
            call sc__EV128TamamoB_append(s__eventServantAdd_e , 15.0 , 15000 , 5.0)
        endif
        if lv == 6 then
            call sc__EV127TamamoA_append(s__eventServantAdd_e , 2.0 , 5.0 , 3)
            call sc__EV128TamamoB_append(s__eventServantAdd_e , 15.0 , 96000 , 5.0)
        endif
        if lv == 7 then
            call UnitRemoveAbility(s__eventServantAdd_e, 'A02Y')
            call sc__EV129TamamoEXA_append(s__eventServantAdd_e , 10.0 , 8.0)
            call sc__EV130TamamoEXB_append(s__eventServantAdd_e , 0.5 , 10)
            call sc__EV131TamamoEXC_append(s__eventServantAdd_e)
        endif
    endfunction
