    function FXGetXpReq takes integer lv returns integer
        return FXRDTier__FACTION_XP_REQ[IMinBJ(FX_FACTION_MAX_LEVEL, lv)]
    endfunction
    function FXGetMasterXpReq takes integer lv returns integer
        return FXRDTier__MASTER_XP_REQ[IMinBJ(90, lv)]
    endfunction
    function FXSetXpCalc takes integer lv,integer curxp,integer addxp returns nothing
        local integer reqxp
        set curxp=curxp + addxp
        loop
            set reqxp=FXGetXpReq(lv)
            exitwhen curxp < reqxp
            set curxp=curxp - reqxp
            set lv=IMinBJ(lv + 1, FX_FACTION_MAX_LEVEL)
        endloop
        if lv == FX_FACTION_MAX_LEVEL then
            set curxp=0
        endif
        set FXRDTier__CALC_LV=lv
        set FXRDTier__CALC_XP=curxp
    endfunction
    function FXSetMasterXpCalc takes integer lv,integer curxp,integer addxp returns nothing
        local integer reqxp
        set curxp=curxp + addxp
        loop
            set reqxp=FXGetMasterXpReq(lv)
            exitwhen curxp < reqxp
            set curxp=curxp - reqxp
            set lv=IMinBJ(lv + 1, FX_MASTER_MAX_LEVEL)
        endloop
        if lv == FX_MASTER_MAX_LEVEL then
            set curxp=0
        endif
        set FXRDTier__CALC_LV=lv
        set FXRDTier__CALC_XP=curxp
    endfunction
    function FXGetXpCalcLv takes nothing returns integer
        return FXRDTier__CALC_LV
    endfunction
    function FXGetXpCalcXp takes nothing returns integer
        return FXRDTier__CALC_XP
    endfunction

