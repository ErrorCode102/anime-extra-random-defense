        set s__EV161RyougiB_myLastTarget[this]=null
        set s__EV161RyougiB_maxCombo[this]=mcom
        set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_maxCombo[this]
        
        set s__EV161RyougiB_myHandEffect[this]=null
        call s__EVServantAttack_addFunction(src , function sc__EV161RyougiB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV161RyougiB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV161RyougiB_getThis(GetUnitUserData(src))
        if dst != s__EV161RyougiB_myLastTarget[this] then
            set s__EV161RyougiB_myLastTarget[this]=dst
            set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_maxCombo[this]
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
                set s__EV161RyougiB_myHandEffect[this]=null
            endif
        endif
        set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_myCombo[this] - 1
        if s__EV161RyougiB_myCombo[this] == 1 then
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
            endif
            set s__EV161RyougiB_myHandEffect[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", s__EV161RyougiB_myServant[this], "hand right")
        endif
        if s__EV161RyougiB_myCombo[this] > 0 then
            call s__bountyTag_custom(GetOwningPlayer(src) , GetUnitX(src) , GetUnitY(src) , "|c00FF0000" + I2S(s__EV161RyougiB_maxCombo[this] - s__EV161RyougiB_myCombo[this]) + " hit!")
        endif
        if s__EV161RyougiB_myCombo[this] == 0 then
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
                set s__EV161RyougiB_myHandEffect[this]=null
            endif
            set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_maxCombo[this]
            //cast it
            call FXRD_FXUltimateShock(dst , 3600.00)
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV161RyougiB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV161RyougiB_getThis(s__EVUnitRemove_e)
        //누수처리
        if s__EV161RyougiB_myHandEffect[this] != null then
            call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
            set s__EV161RyougiB_myHandEffect[this]=null
        endif
        set s__EV161RyougiB_myLastTarget[this]=null
        set s__EV161RyougiB_myServant[this]=null
        call TriggerUnbindAction(s__EV161RyougiB_onRemoveAction[this])
        set s__EV161RyougiB_onRemoveAction[this]=null
        //종결
        call s__EV161RyougiB_destroy(this)
    endfunction
    
    
// Trigger: EV 162 KarnaB
//===========================================================================

    
    function s__EV162KarnaB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV162KarnaB_STRUCT_ID)
    endfunction
    
    function s__EV162KarnaB_setThis takes integer id,integer this returns nothing
        call SaveInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV162KarnaB_STRUCT_ID, this)
    endfunction
    
    //생성자, 소멸자
    
    function s__EV162KarnaB_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__EV162KarnaB__allocate()
        set s__EV162KarnaB_ID[this]=GetUnitUserData(src)
        call s__EV162KarnaB_setThis(s__EV162KarnaB_ID[this] , this)
        return this
    endfunction
    
    function s__EV162KarnaB_destroy takes integer this returns nothing
        call s__EV162KarnaB_setThis(s__EV162KarnaB_ID[this] , 0)
        call s__EV162KarnaB_deallocate(this)
    endfunction
    
    //API
    function s__EV162KarnaB_append takes unit src,real dmg,real coold,string mot,integer mana returns nothing
        local integer this= s__EV162KarnaB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV162KarnaB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV162KarnaB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV162KarnaB_onSourceUnitRemove)
        set s__EV162KarnaB_myServant[this]=src
        set s__EV162KarnaB_myCooldown[this]=coold
        set s__EV162KarnaB_myDamage[this]=dmg
        set s__EV162KarnaB_myMotion[this]=mot
        set s__EV162KarnaB_myMana[this]=mana
        set s__EV162KarnaB_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV162KarnaB_coolTick[this],1.00 , true , function sc__EV162KarnaB_onCastSpell)
    endfunction
    
    //구현부
    function s__EV162KarnaB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV162KarnaB_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV162KarnaB_coolTick[this])
        set s__EV162KarnaB_myServant[this]=null
        call TriggerUnbindAction(s__EV162KarnaB_onRemoveAction[this])
        set s__EV162KarnaB_onRemoveAction[this]=null
        //종결
        call s__EV162KarnaB_destroy(this)
    endfunction
    
    
    function s__EV162KarnaB_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV162KarnaB_CNT) == 0 then
            set s__EV162KarnaB_DEST=GetEnumUnit()
        endif
        set s__EV162KarnaB_CNT=s__EV162KarnaB_CNT + 1
    endfunction
    
    function s__EV162KarnaB_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV162KarnaB_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV162KarnaB_coolTick[this])
            return
        endif
        set s__EV162KarnaB_DEST=null
        set s__EV162KarnaB_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV162KarnaB_myServant[this] , GetUnitX(s__EV162KarnaB_myServant[this]) , GetUnitY(s__EV162KarnaB_myServant[this]) , GetUnitAcquireRange(s__EV162KarnaB_myServant[this]) , function s__EV162KarnaB_enumGetTarget)
        //대상이 없으면
        if s__EV162KarnaB_DEST == null then
            call s__tick_start(s__EV162KarnaB_coolTick[this],1.00 , true , function s__EV162KarnaB_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMShakti_cast(s__EV162KarnaB_myServant[this] , s__EV162KarnaB_DEST , s__EV162KarnaB_myDamage[this] , s__EV162KarnaB_myMotion[this] , s__EV162KarnaB_myMana[this])
        call s__tick_start(s__EV162KarnaB_coolTick[this],s__EV162KarnaB_myCooldown[this] , true , function s__EV162KarnaB_onCastSpell)
        set s__EV162KarnaB_DEST=null
    endfunction
    

