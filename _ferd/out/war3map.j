        return this
    endfunction
    
    function s__EV163ChulainnA_destroy takes integer this returns nothing
        call s__EV163ChulainnA_setThis(s__EV163ChulainnA_ID[this] , 0)
        call s__EV163ChulainnA_deallocate(this)
    endfunction
    
    //API
    
    function s__EV163ChulainnA_append takes unit src,integer max returns nothing
        local integer this= s__EV163ChulainnA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV163ChulainnA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV163ChulainnA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV163ChulainnA_onSourceUnitRemove)
        set s__EV163ChulainnA_myServant[this]=src
        set s__EV163ChulainnA_myLastTarget[this]=null
        set s__EV163ChulainnA_myDmgBonus[this]=0
        set s__EV163ChulainnA_myMaxBonus[this]=max
        
        call s__EVServantAttack_addFunction(src , function sc__EV163ChulainnA_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV163ChulainnA_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV163ChulainnA_getThis(GetUnitUserData(src))
        if dst == s__EV163ChulainnA_myLastTarget[this] then
            call s__EVDamageManager_addBonus(src , - s__EV163ChulainnA_myDmgBonus[this])
            set s__EV163ChulainnA_myDmgBonus[this]=IMinBJ(s__EV163ChulainnA_myMaxBonus[this], s__EV163ChulainnA_myDmgBonus[this] + 20)
            call s__EVDamageManager_addBonus(src , s__EV163ChulainnA_myDmgBonus[this])
        else
            set s__EV163ChulainnA_myLastTarget[this]=dst
            call s__EVDamageManager_addBonus(src , - s__EV163ChulainnA_myDmgBonus[this])
            set s__EV163ChulainnA_myDmgBonus[this]=0
            call s__EVDamageManager_addBonus(src , s__EV163ChulainnA_myDmgBonus[this])
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV163ChulainnA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV163ChulainnA_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV163ChulainnA_myLastTarget[this]=null
        set s__EV163ChulainnA_myServant[this]=null
        call TriggerUnbindAction(s__EV163ChulainnA_onRemoveAction[this])
        set s__EV163ChulainnA_onRemoveAction[this]=null
        //종결
        call s__EV163ChulainnA_destroy(this)
    endfunction
    
