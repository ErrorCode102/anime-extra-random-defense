// scope SvTamamoBeach begins
    //기본 서번트 스탯 설정
    //구현부
    function SvTamamoBeach__onAttack takes nothing returns nothing
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        call s__enemy_dealLogic(src , dst , s__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
    endfunction
    function SvTamamoBeach__onServantGet takes nothing returns nothing
        local integer lv= GetUnitLevel(s__eventServantAdd_e)
        //Adding Base Damage / Attack
        call s__EVDamageManager_addOrigin(s__eventServantAdd_e , SvTamamoBeach__ODMG[lv])
        call s__EVServantAttack_addFunction(s__eventServantAdd_e , function SvTamamoBeach__onAttack)
        //Adding Special Skillz
        if lv == 4 then
            call sc__EV132TamamoBeachA_append(s__eventServantAdd_e , 200 , 5.00)
        endif
        if lv == 5 then
            call sc__EV132TamamoBeachA_append(s__eventServantAdd_e , 500 , 5.00)
            call sc__EV133TamamoBeachB_append(s__eventServantAdd_e , 2500 , 10.00)
        endif
        if lv == 6 then
            call sc__EV132TamamoBeachA_append(s__eventServantAdd_e , 1600 , 2.50)
            call sc__EV133TamamoBeachB_append(s__eventServantAdd_e , 8000 , 5.00)
        endif
    endfunction
    //초기화
    function SvTamamoBeach__main takes nothing returns nothing
        set SvTamamoBeach__ODMG[4]=240
        set SvTamamoBeach__ODMG[5]=600
        set SvTamamoBeach__ODMG[6]=1920
        call s__eventServantAdd_register(SV_TAMAMOBIKIBI + OFF_B , function SvTamamoBeach__onServantGet)
        call s__eventServantAdd_register(SV_TAMAMOBIKIBI + OFF_A , function SvTamamoBeach__onServantGet)
        call s__eventServantAdd_register(SV_TAMAMOBIKIBI + OFF_S , function SvTamamoBeach__onServantGet)
    endfunction
