function sa__EV143NeroB_onSourceUnitAttack takes nothing returns boolean

        local integer this
        local unit src
        local unit dst
        local real mtpl
        if not DEAL_FLAG_ATTACKING then
return true
        endif
        if DEAL_FLAG_LOGIC then
return true
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set this=s__EV143NeroB_getThis(GetUnitUserData(src))
        set s__EV143NeroB_myCombo[this]=s__EV143NeroB_myCombo[this] - 1
        if s__EV143NeroB_myCombo[this] == 1 then
            if s__EV143NeroB_myHandEffect[this] != null then
                call DestroyEffect(s__EV143NeroB_myHandEffect[this])
            endif
            set s__EV143NeroB_myHandEffect[this]=AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__EV143NeroB_myServant[this], "weapon right")
        endif
        if s__EV143NeroB_myCombo[this] == 0 then
            if s__EV143NeroB_myHandEffect[this] != null then
                call DestroyEffect(s__EV143NeroB_myHandEffect[this])
                set s__EV143NeroB_myHandEffect[this]=null
            endif
            set s__EV143NeroB_myCombo[this]=s__EV143NeroB_myMaxCombo[this]
            set mtpl=5.00
            if GetUnitAbilityLevel(s__EV143NeroB_myServant[this], 'A08O') > 0 then
                set mtpl=mtpl * 2.00
            endif
            call s__CMThrust_cast(s__EV143NeroB_myServant[this] , dst , s__EVDamageManager_getFinalDamage(s__EV143NeroB_myServant[this]) * mtpl)
        endif
        set src=null
        set dst=null
   return true
endfunction
function sa__EV143NeroB_onSourceUnitRemove takes nothing returns boolean

        local integer this= s__EV143NeroB_getThis(s__EVUnitRemove_e)
        if s__EV143NeroB_myHandEffect[this] != null then
            call DestroyEffect(s__EV143NeroB_myHandEffect[this])
            set s__EV143NeroB_myHandEffect[this]=null
        endif
        set s__EV143NeroB_myServant[this]=null
        call TriggerUnbindAction(s__EV143NeroB_onRemoveAction[this])
        set s__EV143NeroB_onRemoveAction[this]=null
        call s__EV143NeroB_destroy(this)
   return true
