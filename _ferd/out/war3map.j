    function FXTrig1SMultiboard___onExpireTime takes nothing returns nothing
        local string t= "Game Dashboard"
        local string s= "|c0000ff00" + s__playtime__get_hms()
        call s__statusBoard__set_time(s)
        if s__board_minimized(s__statusBoard__get_super()) then
            call s__board__set_title(s__statusBoard__get_super(),s)
        else
            call s__board__set_title(s__statusBoard__get_super(),t)
        endif
    endfunction

    function FXTrig1SMultiboard___atInitMultiboard takes nothing returns nothing
        call s__statusBoard_init()
        call s__statusBoard__set_difficulty(LEVEL_NAME[LEVEL_CURRENT] + " difficulty(" + MODE_NAME[MODE_CURRENT] + ")")
        //
        call s__statusBoard_refreshAll()
        //
        call s__statusBoard_show(true)
        call s__board_minimize(s__statusBoard__get_super(),false)
        call TimerStart(GetExpiredTimer(), 1.00, true, function FXTrig1SMultiboard___onExpireTime)
    endfunction
    
    function FXTrig1SMultiboard___onGameInit takes nothing returns nothing
        call TimerStart(CreateTimer(), 1.00, true, function FXTrig1SMultiboard___atInitMultiboard)
    endfunction
    
    function FXTrig1SMultiboard___main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_INIT , function FXTrig1SMultiboard___onGameInit)
    endfunction
