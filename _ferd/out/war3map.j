        set SvTamamo___ODMG[5]=500
        set SvTamamo___ODMG[6]=1600
        set SvTamamo___ODMG[7]=2070
        call s__eventServantAdd_register(SV_TAMAMO + OFF_C , function SvTamamo___onServantGet)
        call s__eventServantAdd_register(SV_TAMAMO + OFF_B , function SvTamamo___onServantGet)
