//end of: 어빌리티_선언_개시("EnkiduBUnstun")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILEnkiduBUnstun_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILEnkiduBUnstun_rmTrig[this], s__ABILEnkiduBUnstun_rmAct[this])
        set s__ABILEnkiduBUnstun_rmAct[this]=null
        set s__ABILEnkiduBUnstun_rmTrig[this]=null
        call sc__ABILEnkiduBUnstun_onAbilityLost(this)
        call s__tick_destroy(s__ABILEnkiduBUnstun_durTik[this])
        set s__ABILEnkiduBUnstun_source[this]=null
        set s__ABILEnkiduBUnstun_exists[this]=false
    endfunction
    
    function s__ABILEnkiduBUnstun_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILEnkiduBUnstun_free(this)
    endfunction
    
    function s__ABILEnkiduBUnstun_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILEnkiduBUnstun_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILEnkiduBUnstun_source[this]) then
            return
        endif
        call sc__ABILEnkiduBUnstun_onAbilityEffect(this)
        call s__tick_start(s__ABILEnkiduBUnstun_durTik[this],s__ABILEnkiduBUnstun_duration[this] , false , function s__ABILEnkiduBUnstun_onExpire)
    endfunction
    
    function s__ABILEnkiduBUnstun_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILEnkiduBUnstun_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILEnkiduBUnstun_exists[this] then
            set s__ABILEnkiduBUnstun_exists[this]=true
            set s__ABILEnkiduBUnstun_source[this]=src
            set s__ABILEnkiduBUnstun_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILEnkiduBUnstun_rmAct[this]=TriggerAddAction(s__ABILEnkiduBUnstun_rmTrig[this], function s__ABILEnkiduBUnstun_OnSourceRemove)
            
            set s__ABILEnkiduBUnstun_duration[this]=dur
            set s__ABILEnkiduBUnstun_defaultDuration[this]=dur
            set s__ABILEnkiduBUnstun_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILEnkiduBUnstun_durTik[this],dur , false , function s__ABILEnkiduBUnstun_onExpire)
            call sc__ABILEnkiduBUnstun_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
