            return
        endif
        //쿨 걸리면
        call s__CMHeavenlyDemonRain_cast(s__EV107SuzukaB_myServant[this] , s__EV107SuzukaB_myRange[this] , s__EV107SuzukaB_myDamage[this])
        call s__tick_start(s__EV107SuzukaB_coolTick[this],s__EV107SuzukaB_myCooldown[this] , true , function s__EV107SuzukaB_onCastSpell)
