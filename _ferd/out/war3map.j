function sa__EVSpecialBounty_onSourceUnitDeath takes nothing returns boolean

        local integer this= s__EVSpecialBounty_getThis(GetUnitUserData(GetTriggerUnit()))
        local integer id
        if s__EVSpecialBounty_bountyTarget[this] == Player(11) then
            set id=0
            loop
                exitwhen id == 4
                call s__EVSpecialBounty_giveBounty(Player(id) , this)
                set id=id + 1
            endloop
        else
            set id=GetPlayerId(s__EVSpecialBounty_bountyTarget[this])
            call s__EVSpecialBounty_giveBounty(Player(id) , this)
        endif
   return true
endfunction
