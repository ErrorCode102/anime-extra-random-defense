//==================================================================
//　서번트 기술부
//==================================================================
//textmacro instance: 어빌리티_선언_개시("MxltASadist")
//end of: 어빌리티_선언_개시("MxltASadist")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_패시브_쿨타임_일정()
    
    function s__ABILMxltASadist_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMxltASadist_rmTrig[this], s__ABILMxltASadist_rmAct[this])
        set s__ABILMxltASadist_rmAct[this]=null
        set s__ABILMxltASadist_rmTrig[this]=null
        call sc__ABILMxltASadist_onAbilityLost(this)
        call s__tick_destroy(s__ABILMxltASadist_durTik[this])
        set s__ABILMxltASadist_source[this]=null
        set s__ABILMxltASadist_exists[this]=false
    endfunction
    
    function s__ABILMxltASadist_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMxltASadist_free(this)
    endfunction
    
    function s__ABILMxltASadist_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILMxltASadist_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILMxltASadist_source[this]) then
            return
        endif
        call sc__ABILMxltASadist_onAbilityEffect(this)
        call s__tick_start(s__ABILMxltASadist_durTik[this],s__ABILMxltASadist_duration[this] , false , function s__ABILMxltASadist_onExpire)
    endfunction
    
    function s__ABILMxltASadist_append takes unit src,real dur returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMxltASadist_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMxltASadist_exists[this] then
            set s__ABILMxltASadist_exists[this]=true
            set s__ABILMxltASadist_source[this]=src
            set s__ABILMxltASadist_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMxltASadist_rmAct[this]=TriggerAddAction(s__ABILMxltASadist_rmTrig[this], function s__ABILMxltASadist_OnSourceRemove)
            
            set s__ABILMxltASadist_duration[this]=dur
            set s__ABILMxltASadist_defaultDuration[this]=dur
            set s__ABILMxltASadist_durTik[this]=s__tick_create(this)
            call s__tick_start(s__ABILMxltASadist_durTik[this],dur , false , function s__ABILMxltASadist_onExpire)
            call sc__ABILMxltASadist_onAbilityLearn(this)
        endif
    endfunction
//end of: 어빌리티_종류_패시브_쿨타임_일정()
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILMxltASadist_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMxltASadist_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMxltASadist_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        if GetUnitState(s__ABILMxltASadist_source[this], UNIT_STATE_MANA) < 150 then
            return
        endif
        if GetUnitAbilityLevel(s__ABILMxltASadist_source[this], s__BUFFUltimateSadist_ABILITY) > 0 then
            return
        endif
        call sc__BUFFUltimateSadist_apply(s__ABILMxltASadist_source[this] , 10.00)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
//end of: 어빌리티_이벤트_끝()
//textmacro instance: 어빌리티_선언_끝()
//end of: 어빌리티_선언_끝()

//textmacro instance: 버프_선언_개시("UltimateSadist")
//end of: 버프_선언_개시("UltimateSadist")
    // TODO : 버프의 종류를 선언합니다.
//textmacro instance: 버프_종류_기간제()
    function s__BUFFUltimateSadist_apply takes unit src,real dur returns nothing
        local integer this= IndexUnit(src)
        if this == 0 then
            return
        endif
        if not s__BUFFUltimateSadist_exist[this] then
            set s__BUFFUltimateSadist_exist[this]=true
            set s__BUFFUltimateSadist_running[this]=false
            set s__BUFFUltimateSadist_source[this]=src
            set s__BUFFUltimateSadist_duration[this]=dur
            set s__BUFFUltimateSadist_durationTimer[this]=s__tick_create(this)
            set s__BUFFUltimateSadist_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__BUFFUltimateSadist_rmAct[this]=TriggerAddAction(s__BUFFUltimateSadist_rmTrig[this], function sc__BUFFUltimateSadist_onSourceRemove)
        endif
        if s__BUFFUltimateSadist_running[this] then
            if dur < s__tick__get_remaining(s__BUFFUltimateSadist_durationTimer[this]) then
                return
            endif
        else
            set s__BUFFUltimateSadist_running[this]=true
            call sc__BUFFUltimateSadist_onBuffStart(this)
        endif
        set s__BUFFUltimateSadist_duration[this]=dur
        call sc__BUFFUltimateSadist_onBuffRefresh(this)
        call s__tick_start(s__BUFFUltimateSadist_durationTimer[this],s__BUFFUltimateSadist_duration[this] , false , function sc__BUFFUltimateSadist_onExpire)
    endfunction
    function s__BUFFUltimateSadist_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        set s__BUFFUltimateSadist_running[this]=false
        call sc__BUFFUltimateSadist_onBuffEnd(this)
    endfunction
    function s__BUFFUltimateSadist_onSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call TriggerRemoveAction(s__BUFFUltimateSadist_rmTrig[this], s__BUFFUltimateSadist_rmAct[this])
        set s__BUFFUltimateSadist_rmAct[this]=null
        set s__BUFFUltimateSadist_rmTrig[this]=null
        if s__BUFFUltimateSadist_running[this] then
            set s__BUFFUltimateSadist_running[this]=false
            call sc__BUFFUltimateSadist_onBuffEnd(this)
        endif
        call s__tick_destroy(s__BUFFUltimateSadist_durationTimer[this])
        set s__BUFFUltimateSadist_source[this]=null
        set s__BUFFUltimateSadist_exist[this]=false
    endfunction
//end of: 버프_종류_기간제()
    // TODO : 버프의 종류에 대응되는 각 버프 이벤트를 작성합니다.
//textmacro instance: 버프_이벤트_버프_부여됨()
    function s__BUFFUltimateSadist_onBuffStart takes integer this returns nothing
//end of: 버프_이벤트_버프_부여됨()
        set s__BUFFUltimateSadist_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\Human\\MagicSentry\\MagicSentryCaster.mdl", s__BUFFUltimateSadist_source[this], "overhead")
        call UnitAddAbility(s__BUFFUltimateSadist_source[this], s__BUFFUltimateSadist_ABILITY)
        call sc__EVDamageManager_addBonus(s__BUFFUltimateSadist_source[this] , s__BUFFUltimateSadist_ATBO)
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_갱신됨()
    function s__BUFFUltimateSadist_onBuffRefresh takes integer this returns nothing
//end of: 버프_이벤트_버프_갱신됨()
        // 기간제 기절/넉백 면역 효과 습득
        call FXRD_FXImmuneStunTimed(s__BUFFUltimateSadist_source[this] , s__BUFFUltimateSadist_duration[this])
        call FXRD_FXImmuneKnockbackTimed(s__BUFFUltimateSadist_source[this] , s__BUFFUltimateSadist_duration[this])
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_이벤트_버프_해제됨()
    function s__BUFFUltimateSadist_onBuffEnd takes integer this returns nothing
//end of: 버프_이벤트_버프_해제됨()
        if not IsUnitDead(s__BUFFUltimateSadist_source[this]) then
            call sc__EVDamageManager_addBonus(s__BUFFUltimateSadist_source[this] , - s__BUFFUltimateSadist_ATBO)
            call SetUnitState(s__BUFFUltimateSadist_source[this], UNIT_STATE_MANA, 0.00)
            call UnitRemoveAbility(s__BUFFUltimateSadist_source[this], s__BUFFUltimateSadist_ABILITY)
            call UnitRemoveAbility(s__BUFFUltimateSadist_source[this], s__BUFFUltimateSadist_BUFF)
        endif
        call DestroyEffect(s__BUFFUltimateSadist_fx[this])
        set s__BUFFUltimateSadist_fx[this]=null
//textmacro instance: 버프_이벤트_끝()
    endfunction
//end of: 버프_이벤트_끝()
//textmacro instance: 버프_선언_끝()
//end of: 버프_선언_끝()

//textmacro instance: 어빌리티_선언_개시("MeltDVergin")
//end of: 어빌리티_선언_개시("MeltDVergin")
    // TODO : 어빌리티의 종류를 선언합니다.
//textmacro instance: 어빌리티_종류_액티브("A0D8")
    
    function s__ABILMeltDVergin_free takes integer this returns nothing
        call TriggerRemoveAction(s__ABILMeltDVergin_onSpellEffect[this], s__ABILMeltDVergin_onSpellEffectAction[this])
        set s__ABILMeltDVergin_onSpellEffectAction[this]=null
        call DestroyTrigger(s__ABILMeltDVergin_onSpellEffect[this])
        set s__ABILMeltDVergin_onSpellEffect[this]=null
        //
        call TriggerRemoveAction(s__ABILMeltDVergin_rmTrig[this], s__ABILMeltDVergin_rmAct[this])
        set s__ABILMeltDVergin_rmAct[this]=null
        set s__ABILMeltDVergin_rmTrig[this]=null
        call sc__ABILMeltDVergin_onAbilityLost(this)
        set s__ABILMeltDVergin_source[this]=null
        set s__ABILMeltDVergin_exists[this]=false
    endfunction
    
    function s__ABILMeltDVergin_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILMeltDVergin_free(this)
    endfunction
    
    function s__ABILMeltDVergin_append takes unit src returns nothing
        local integer this
        if GetUnitTypeId(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, s__ABILMeltDVergin_STRUCT_FAILURE)
        endif
        set this=IndexUnit(src)
        if not s__ABILMeltDVergin_exists[this] then
            set s__ABILMeltDVergin_exists[this]=true
            set s__ABILMeltDVergin_source[this]=src
            set s__ABILMeltDVergin_rmTrig[this]=GetUnitRemoveTrigger(src)
            set s__ABILMeltDVergin_rmAct[this]=TriggerAddAction(s__ABILMeltDVergin_rmTrig[this], function s__ABILMeltDVergin_OnSourceRemove)
            set s__ABILMeltDVergin_onSpellEffect[this]=CreateTrigger()
            call TriggerAddCondition(s__ABILMeltDVergin_onSpellEffect[this], Condition(function sc__ABILMeltDVergin_conditionSpellEffect))
            set s__ABILMeltDVergin_onSpellEffectAction[this]=TriggerAddAction(s__ABILMeltDVergin_onSpellEffect[this], function sc__ABILMeltDVergin_actionSpellEffect)
            call TriggerRegisterUnitEvent(s__ABILMeltDVergin_onSpellEffect[this], src, EVENT_UNIT_SPELL_EFFECT)
            call sc__ABILMeltDVergin_onAbilityLearn(this)
        endif
    endfunction
    
    function s__ABILMeltDVergin_actionSpellEffect takes nothing returns nothing
        local integer this= GetUnitIndex(GetTriggerUnit())
        if not s__ABILMeltDVergin_exists[this] then
            return
        endif
        call sc__ABILMeltDVergin_onAbilityEffect(this)
    endfunction
    
    function s__ABILMeltDVergin_conditionSpellEffect takes nothing returns boolean
        return GetSpellAbilityId() == s__ABILMeltDVergin_ABILITY
    endfunction
//end of: 어빌리티_종류_액티브("A0D8")
    // TODO : 어빌리티의 종류에 대응되는 각 어빌리티 이벤트를 작성합니다.
//textmacro instance: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
    function s__ABILMeltDVergin_onAbilityLearn takes integer this returns nothing
    endfunction
    function s__ABILMeltDVergin_onAbilityLost takes integer this returns nothing
    endfunction
//end of: 어빌리티_이벤트_어빌리티_습득_잃음_없음()
//textmacro instance: 어빌리티_이벤트_어빌리티_효과_시작()
    function s__ABILMeltDVergin_onAbilityEffect takes integer this returns nothing
//end of: 어빌리티_이벤트_어빌리티_효과_시작()
        local real dmg= sc__EVDamageManager_getFinalDamage(s__ABILMeltDVergin_source[this]) * 40
        call FXRD_FXUltimateShock(GetSpellTargetUnit() , 10.00)
        call s__enemy_dealLogicEx(s__ABILMeltDVergin_source[this] , GetSpellTargetUnit() , dmg , false , false , WEAPON_TYPE_METAL_HEAVY_BASH , 1)
//textmacro instance: 어빌리티_이벤트_끝()
    endfunction
