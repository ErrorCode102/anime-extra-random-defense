function sa__ABILBBSSDomina_onAbilityEffect takes nothing returns boolean
local integer this=f__arg_this
        local unit src= GetTriggerUnit()
        local unit dst= GetEventDamageSource()
        local real dmg= sc__EVDamageManager_getFinalDamage(src)
        set s__ABILBBSSDomina_Combo[this]=s__ABILBBSSDomina_Combo[this] + 1
        if s__ABILBBSSDomina_Combo[this] >= 3 then
            if GetUnitAbilityLevel(src, 'A0EO') > 1 then
                set dmg=dmg * 10.0
                if IsUnitType(dst, UNIT_TYPE_GIANT) then
                    call UnitAddAbility(dst, 'A07G')
                endif
            else
                set dmg=dmg * 5.0
            endif
            call FXRD_FXDebuffShock(dst , 1.0)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl", dst, "origin"))
            call KillUnit(CreateUnit(FX_PLAYER_DUMMY, 'o02C', GetUnitX(src), GetUnitY(src), s__Angle_WBW(src , dst)))
            set s__ABILBBSSDomina_Combo[this]=0
        else
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\AvengerMissile\\AvengerMissile.mdl", dst, "chest"))
        endif
        call SetUnitState(s__ABILBBSSDomina_source[this], UNIT_STATE_MANA, GetUnitState(s__ABILBBSSDomina_source[this], UNIT_STATE_MANA) + 5.0 + GetHeroAgi(s__ABILBBSSDomina_source[this], true) * 0.02)
        call s__enemy_dealLogic(src , dst , dmg , WEAPON_TYPE_WHOKNOWS , 0)
        set src=null
        set dst=null
   return true
endfunction
