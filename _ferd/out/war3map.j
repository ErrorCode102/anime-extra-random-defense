    function s__CMHell_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMHell_caster[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMHell_mainFlow[this],1.00 , false , function s__CMHell_onFinal)
            return
        endif
        if IsUnitType(s__CMHell_target[this], UNIT_TYPE_DEAD) then
            call s__tick_start(s__CMHell_mainFlow[this],1.00 , false , function s__CMHell_onFinal)
            return
        endif
        if s__CMHell_myLoops[this] <= 0 then
            call s__tick_start(s__CMHell_mainFlow[this],1.00 , false , function s__CMHell_onFinal)
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl", s__CMHell_target[this], "chest"))
        call s__EVDebuffSlow_apply(s__CMHell_target[this] , 1.10)
        call s__enemy_dealLogic(s__CMHell_caster[this] , s__CMHell_target[this] , s__CMHell_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        set s__CMHell_myLoops[this]=s__CMHell_myLoops[this] - 1
    endfunction
    function s__CMHell_cast takes unit src,unit dst,real dmg,integer loops returns nothing
        local integer this= s__tick_create(0)
        set s__CMHell_caster[this]=src
        set s__CMHell_target[this]=dst
        set s__CMHell_myLoops[this]=loops
        set s__CMHell_damage[this]=dmg
        set s__CMHell_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\shadowstrike\\shadowstrike.mdl", dst, "overhead")
        call UnitAddAbility(s__CMHell_target[this], 'A02P')
        set s__CMHell_mainFlow[this]=this
        call s__tick_start(s__CMHell_mainFlow[this],1.00 , true , function s__CMHell_onFire)
    endfunction

