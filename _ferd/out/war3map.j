    endfunction
    
    function s__EV159EmiyaB_destroy takes integer this returns nothing
        call s__EV159EmiyaB_setThis(s__EV159EmiyaB_ID[this] , 0)
        call s__EV159EmiyaB_deallocate(this)
    endfunction
    
    //API
    
    function s__EV159EmiyaB_append takes unit src returns nothing
        local integer this= s__EV159EmiyaB_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV159EmiyaB failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV159EmiyaB_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV159EmiyaB_onSourceUnitRemove)
        set s__EV159EmiyaB_myServant[this]=src
        
        call s__EVServantAttack_addFunction(src , function sc__EV159EmiyaB_onSourceUnitAttack)
    endfunction
    
    //구현부
    function s__EV159EmiyaB_onSourceUnitAttack takes nothing returns nothing
        local integer this
        local unit src
        local unit dst
        local integer cmb
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        //Melee Attack
        set this=s__EV159EmiyaB_getThis(GetUnitUserData(src))
        //Cast it
        if GetUnitState(src, UNIT_STATE_MANA) >= 100 then
            call SetUnitState(src, UNIT_STATE_MANA, 0.00)
            call s__CMBladeWorks_cast(src , GetUnitX(src) , GetUnitY(src) , 700 , s__EVDamageManager_getFinalDamage(src) * 5.00 , 10 , 1.00)
        endif
        set src=null
        set dst=null
    endfunction
    
    function s__EV159EmiyaB_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV159EmiyaB_getThis(s__EVUnitRemove_e)
        //누수처리
        set s__EV159EmiyaB_myServant[this]=null
        call TriggerUnbindAction(s__EV159EmiyaB_onRemoveAction[this])
        set s__EV159EmiyaB_onRemoveAction[this]=null
        //종결
        call s__EV159EmiyaB_destroy(this)
    endfunction

