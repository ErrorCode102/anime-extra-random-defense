    function s__CMExcalMorganSingle_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMExcalMorganSingle_caster[this]=null
        call s__tick_destroy(s__CMExcalMorganSingle_main[this])
    endfunction
    function s__CMExcalMorganSingle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call FXRD_FXDebuffShock(GetEnumUnit() , 0.10)
        call DestroyEffect(AddSpecialEffectTarget("FX\\Slash\\Red.mdl", GetEnumUnit(), "chest"))
        call s__enemy_dealLogic(s__CMExcalMorganSingle_caster[this] , GetEnumUnit() , s__CMExcalMorganSingle_damage[this] , WEAPON_TYPE_METAL_MEDIUM_CHOP , 1)
    endfunction
    function s__CMExcalMorganSingle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(CreateUnit(Player(15), 'o027', GetUnitX(s__CMExcalMorganSingle_caster[this]), GetUnitY(s__CMExcalMorganSingle_caster[this]), GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(Player(15), 'o027', GetUnitX(s__CMExcalMorganSingle_caster[this]), GetUnitY(s__CMExcalMorganSingle_caster[this]), GetRandomReal(0.00, 360.00)))
        call KillUnit(CreateUnit(Player(15), 'o01B', GetUnitX(s__CMExcalMorganSingle_caster[this]), GetUnitY(s__CMExcalMorganSingle_caster[this]), GetRandomReal(0.00, 360.00)))
        call s__splash_range(s__splash_ENEMY , s__CMExcalMorganSingle_caster[this] , GetUnitX(s__CMExcalMorganSingle_caster[this]) , GetUnitY(s__CMExcalMorganSingle_caster[this]) , 800 , function s__CMExcalMorganSingle_enumDealt)
        call s__tick_start(s__CMExcalMorganSingle_main[this],0.20 , false , function s__CMExcalMorganSingle_onFinal)
    endfunction
    function s__CMExcalMorganSingle_cast takes unit src,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMExcalMorganSingle_caster[this]=src
        set s__CMExcalMorganSingle_damage[this]=dmg
        set s__CMExcalMorganSingle_main[this]=this
        call SetSoundPosition(gg_snd_weapon_swing_1, GetUnitX(s__CMExcalMorganSingle_caster[this]), GetUnitY(s__CMExcalMorganSingle_caster[this]), 300)
        call StopSound(gg_snd_weapon_swing_1, false, false)
        call StartSound(gg_snd_weapon_swing_1)
        call s__tick_start(s__CMExcalMorganSingle_main[this],0.40 , false , function s__CMExcalMorganSingle_onFire)
    endfunction

    function s__CMExcalMorgan_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if s__CMExcalMorgan_loops[this] < 1 or IsUnitType(s__CMExcalMorgan_caster[this], UNIT_TYPE_DEAD) then
            set s__CMExcalMorgan_caster[this]=null
            call s__tick_destroy(s__CMExcalMorgan_main[this])
            return
        endif
        call s__CMExcalMorganSingle_cast(s__CMExcalMorgan_caster[this] , s__CMExcalMorgan_damage[this])
        set s__CMExcalMorgan_loops[this]=s__CMExcalMorgan_loops[this] - 1
    endfunction
    function s__CMExcalMorgan_cast takes unit src,real dmg,integer cmb returns nothing
        local integer this= s__tick_create(0)
        set s__CMExcalMorgan_caster[this]=src
        set s__CMExcalMorgan_damage[this]=dmg
        set s__CMExcalMorgan_loops[this]=cmb
        set s__CMExcalMorgan_main[this]=this
        call s__tick_start(s__CMExcalMorgan_main[this],0.40 , true , function s__CMExcalMorgan_onFireStart)
    endfunction
