    function s__CMBrahmastra_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMBrahmastra_casterDummy[this])
        call ShowUnit(s__CMBrahmastra_casterDummy[this], false)
        set s__CMBrahmastra_casterDummy[this]=null
        set s__CMBrahmastra_caster[this]=null
        set s__CMBrahmastra_target[this]=null
        call s__tick_destroy(s__CMBrahmastra_mainFlow[this])
    endfunction
    function s__CMBrahmastra_onFireStart takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call DestroyEffect(AddSpecialEffect("Abilities\\Weapons\\Bolt\\BoltImpact.mdl", GetUnitX(s__CMBrahmastra_target[this]), GetUnitY(s__CMBrahmastra_target[this])))
        call sc__DummyLightning_cast("CLPB" , 1 , 1 , 1 , GetUnitX(s__CMBrahmastra_casterDummy[this]) , GetUnitY(s__CMBrahmastra_casterDummy[this]) , 440 , GetUnitX(s__CMBrahmastra_target[this]) , GetUnitY(s__CMBrahmastra_target[this]) , 60 , 0.30)
        if IsUnitType(s__CMBrahmastra_target[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMBrahmastra_casterDummy[this], "overhead"))
        else
            call s__enemy_dealLogic(s__CMBrahmastra_caster[this] , s__CMBrahmastra_target[this] , s__CMBrahmastra_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMBrahmastra_casterDummy[this] , 128 , 128 , 128 , 255 , 128 , 128 , 128 , 0 , 0.30)
        call SetUnitTimeScale(s__CMBrahmastra_casterDummy[this], 0.00)
        call s__tick_start(s__CMBrahmastra_mainFlow[this],0.40 , false , function s__CMBrahmastra_onFinal)
    endfunction
    function s__CMBrahmastra_cast takes unit src,unit dst,real dmg,string mot returns nothing
        local integer this= s__tick_create(0)
        local real dir= GetRandomReal(- 90, 90)
        local real dis= GetRandomReal(100.00, 400.00)
        set s__CMBrahmastra_caster[this]=src
        set s__CMBrahmastra_target[this]=dst
        set s__CMBrahmastra_damage[this]=dmg
        call SetSafeXY(GetUnitX(src) + s__Polar_X(dis , dir) , GetUnitY(src) + s__Polar_Y(dis , dir))
        set dir=s__Angle_PBW(GetSafeX() , GetSafeY() , dst)
        set s__CMBrahmastra_casterDummy[this]=CreateUnit(Player(15), 'o007', GetSafeX(), GetSafeY(), dir)
        call SetUnitLookAt(s__CMBrahmastra_casterDummy[this], "chest", dst, 0, 0, 80.00)
        call SetUnitLookAt(s__CMBrahmastra_casterDummy[this], "head", dst, 0, 0, 80.00)
        call sc__DummyKnockback_cast(s__CMBrahmastra_casterDummy[this] , 400 , dir - 180 , 300 , 2.50)
        call sc__DummyColorChanger_cast(s__CMBrahmastra_casterDummy[this] , 0 , 0 , 0 , 0 , 128 , 128 , 128 , 255 , 1.00)
        call SetUnitAnimation(s__CMBrahmastra_casterDummy[this], mot)
        set s__CMBrahmastra_mainFlow[this]=this
        call s__tick_start(s__CMBrahmastra_mainFlow[this],1.00 , false , function s__CMBrahmastra_onFireStart)
    endfunction

    function s__CMShaktiBurst_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__enemy_dealLogic(s__CMShaktiBurst_caster[this] , GetEnumUnit() , s__CMShaktiBurst_damage[this] , WEAPON_TYPE_WHOKNOWS , 1)
    endfunction
    function s__CMShaktiBurst_enumDealtAlly takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitState(GetEnumUnit(), UNIT_STATE_MAX_MANA) <= GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) then
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", GetEnumUnit(), "origin"))
        call SetUnitState(GetEnumUnit(), UNIT_STATE_MANA, GetUnitState(GetEnumUnit(), UNIT_STATE_MANA) + 2)
    endfunction
    function s__CMShaktiBurst_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        set s__CMShaktiBurst_combo[this]=s__CMShaktiBurst_combo[this] - 1
        call s__splash_range(s__splash_ENEMY , s__CMShaktiBurst_caster[this] , s__CMShaktiBurst_myX[this] , s__CMShaktiBurst_myY[this] , 600 , function s__CMShaktiBurst_enumDealt)
        if GetUnitLevel(s__CMShaktiBurst_caster[this]) == 6 then
            call s__splash_range(s__splash_ALLY , s__CMShaktiBurst_caster[this] , s__CMShaktiBurst_myX[this] , s__CMShaktiBurst_myY[this] , 600 , function s__CMShaktiBurst_enumDealtAlly)
        endif
        if s__CMShaktiBurst_combo[this] == 0 or IsUnitType(s__CMShaktiBurst_caster[this], UNIT_TYPE_DEAD) then
            call KillUnit(s__CMShaktiBurst_myDummy1[this])
            call KillUnit(s__CMShaktiBurst_myDummy2[this])
            set s__CMShaktiBurst_myDummy1[this]=null
            set s__CMShaktiBurst_myDummy2[this]=null
            set s__CMShaktiBurst_caster[this]=null
            call s__tick_destroy(s__CMShaktiBurst_main[this])
        endif
    endfunction
    function s__CMShaktiBurst_cast takes unit src,real tx,real ty,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMShaktiBurst_caster[this]=src
        set s__CMShaktiBurst_myX[this]=tx
        set s__CMShaktiBurst_myY[this]=ty
        set s__CMShaktiBurst_combo[this]=10
        set s__CMShaktiBurst_damage[this]=dmg
        set s__CMShaktiBurst_main[this]=this
        set s__CMShaktiBurst_myDummy1[this]=CreateUnit(Player(15), 'o01M', tx, ty, 270)
        set s__CMShaktiBurst_myDummy2[this]=CreateUnit(Player(15), 'o01L', tx, ty, 270)
        call s__tick_start(s__CMShaktiBurst_main[this],1.00 , true , function s__CMShaktiBurst_onFire)
    endfunction

    function s__CMShaktiMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__CMShaktiBurst_cast(s__CMShaktiMissle_caster[this] , s__CMShaktiMissle_myX[this] , s__CMShaktiMissle_myY[this] , s__CMShaktiMissle_damage[this])
        call KillUnit(s__CMShaktiMissle_myDummy[this])
        set s__CMShaktiMissle_myDummy[this]=null
        set s__CMShaktiMissle_caster[this]=null
        call s__tick_destroy(s__CMShaktiMissle_main[this])
    endfunction
    function s__CMShaktiMissle_cast takes unit src,real tx,real ty,real dmg,unit dum returns nothing
        local integer this= s__tick_create(0)
        set s__CMShaktiMissle_caster[this]=src
        set s__CMShaktiMissle_myX[this]=tx
        set s__CMShaktiMissle_myY[this]=ty
        set s__CMShaktiMissle_damage[this]=dmg
        set s__CMShaktiMissle_main[this]=this
        set s__CMShaktiMissle_myDummy[this]=CreateUnit(Player(15), 'o00N', GetUnitX(dum), GetUnitY(dum), GetUnitFacing(dum))
        call sc__DummyKnockback_cast(s__CMShaktiMissle_myDummy[this] , s__Distance_WBP(dum , tx , ty) , s__Angle_WBP(dum , tx , ty) , 0 , 0.30)
        call s__tick_start(s__CMShaktiMissle_main[this],0.30 , false , function s__CMShaktiMissle_onFire)
    endfunction

    function s__CMShakti_onFinal takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call KillUnit(s__CMShakti_myDummy[this])
        call ShowUnit(s__CMShakti_myDummy[this], false)
        set s__CMShakti_myDummy[this]=null
        set s__CMShakti_caster[this]=null
        call s__tick_destroy(s__CMShakti_main[this])
    endfunction
    function s__CMShakti_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        call s__CMShaktiMissle_cast(s__CMShakti_caster[this] , s__CMShakti_myX[this] , s__CMShakti_myY[this] , s__CMShakti_damage[this] , s__CMShakti_myDummy[this])
        call sc__DummyColorChanger_cast(s__CMShakti_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call SetUnitTimeScale(s__CMShakti_myDummy[this], 0.00)
        call s__tick_start(s__CMShakti_main[this],0.20 , false , function s__CMShakti_onFinal)
    endfunction
    function s__CMShakti_cast takes unit src,unit dst,real dmg,string mot,integer mana returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMShakti_caster[this]=src
        set s__CMShakti_myX[this]=GetUnitX(dst)
        set s__CMShakti_myY[this]=GetUnitY(dst)
        set s__CMShakti_damage[this]=dmg
        set s__CMShakti_main[this]=this
        set s__CMShakti_myDummy[this]=CreateUnit(Player(15), 'o007', GetUnitX(src) + s__Polar_X(200 , ang - 180), GetUnitY(src) + s__Polar_Y(200 , ang - 180), ang)
        call sc__DummyColorChanger_cast(s__CMShakti_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMShakti_myDummy[this], mot)
        call SetUnitTimeScale(s__CMShakti_myDummy[this], 1.20)
        call s__tick_start(s__CMShakti_main[this],0.40 , false , function s__CMShakti_onFire)
    endfunction
