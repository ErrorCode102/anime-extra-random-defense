    function FXTrigMissionUnlock___onGameRound takes nothing returns nothing
        local integer id= GetPlayerId(s__eventCustom_getTriggerPlayer())
        local integer wav= GetUserWave(Player(id))
        local integer lev= 0
        if wav == 15 then
            set lev=1
        endif
        if wav == 20 then
            set lev=2
        endif
        if wav == 25 then
            set lev=3
        endif
        if wav == 30 then
            set lev=4
        endif
        if wav == 40 then
            set lev=5
        endif
        if wav == 50 then
            set lev=6
        endif
        if id == 11 then
            call SetPlayerTechResearched(Player(0), 'R0WA', lev)
            call SetPlayerTechResearched(Player(1), 'R0WA', lev)
            call SetPlayerTechResearched(Player(2), 'R0WA', lev)
            call SetPlayerTechResearched(Player(3), 'R0WA', lev)
        else
            call SetPlayerTechResearched(Player(id), 'R0WA', lev)
        endif
    endfunction
    
    function FXTrigMissionUnlock___main takes nothing returns nothing
        call s__eventCustom_addAction(EVENT_GAME_ROUND , function FXTrigMissionUnlock___onGameRound)
    endfunction
