        call s__tick_destroy(s__EV121JeanneAlterA2_myCoolTick[this])
        set s__EV121JeanneAlterA2_myServant[this]=null
        call TriggerUnbindAction(s__EV121JeanneAlterA2_onRemoveAction[this])
        set s__EV121JeanneAlterA2_onRemoveAction[this]=null
        //종결
        call s__EV121JeanneAlterA2_destroy(this)
    endfunction
    
    

