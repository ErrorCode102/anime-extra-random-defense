        //cast it
        if IsUnitType(dst, UNIT_TYPE_UNDEAD) then
            set cmb=cmb + s__EV112LubuA_myComboAdd[this]
        endif
        call s__CMArmistice_cast(s__EV112LubuA_myServant[this] , dst , s__EV112LubuA_myDamage[this] , cmb)
