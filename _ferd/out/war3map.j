    function s__CMAvalonSingle_cast takes unit src,unit dst,real delay returns nothing
        local integer this= s__tick_create(0)
        set s__CMAvalonSingle_caster[this]=src
        set s__CMAvalonSingle_target[this]=dst
        set s__CMAvalonSingle_fx[this]=AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Rejuvenation\\RejuvenationTarget.mdl", dst, "chest")
        call UnitAddAbility(s__CMAvalonSingle_target[this], 'A08Q')
        call s__EVDamageManager_addBonus(s__CMAvalonSingle_target[this] , 100)
        set s__CMAvalonSingle_mainFlow[this]=this
        call s__tick_start(s__CMAvalonSingle_mainFlow[this],delay , false , function s__CMAvalonSingle_onFinal)
    endfunction

    
    function s__CMAvalon_enumGetTarget takes nothing returns nothing
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) < s__CMAvalon_LEV then
            return
        endif
        if GetUnitAbilityLevel(GetEnumUnit(), 'A08Q') > 0 then
            return
        endif
        if GetUnitLevel(GetEnumUnit()) > s__CMAvalon_LEV then
            set s__CMAvalon_LEV=GetUnitLevel(GetEnumUnit())
            set s__CMAvalon_CNT=0
        endif
        if GetRandomInt(0, s__CMAvalon_CNT) == 0 then
            set s__CMAvalon_DEST=GetEnumUnit()
        endif
        set s__CMAvalon_CNT=s__CMAvalon_CNT + 1
    endfunction
    
    function s__CMAvalon_cast takes unit src returns nothing
        local integer i= 0
        call KillUnit(CreateUnit(Player(15), 'o014', GetUnitX(src), GetUnitY(src), 270.00))
        loop
            exitwhen i == 10
            set s__CMAvalon_DEST=null
            set s__CMAvalon_CNT=0
            set s__CMAvalon_LEV=0
            call s__splash_range(s__splash_ALLY , src , GetUnitX(src) , GetUnitY(src) , 1000 , function s__CMAvalon_enumGetTarget)
            if s__CMAvalon_DEST != null then
                call s__CMAvalonSingle_cast(src , s__CMAvalon_DEST , 10.00)
            endif
            set i=i + 1
        endloop
        set s__CMAvalon_DEST=null
    endfunction

    function s__CMStrikeAirMissle_onFinal takes integer this returns nothing
        call KillUnit(s__CMStrikeAirMissle_myDummy[this])
        set s__CMStrikeAirMissle_myDummy[this]=null
        set s__CMStrikeAirMissle_caster[this]=null
        set s__CMStrikeAirMissle_target[this]=null
        call s__tick_destroy(s__CMStrikeAirMissle_main[this])
    endfunction
    function s__CMStrikeAirMissle_onFinalHit takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitType(s__CMStrikeAirMissle_target[this], UNIT_TYPE_DEAD) then
            call s__CMStrikeAirMissle_onFinal(this)
            return
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WarStomp\\WarStompCaster.mdl", s__CMStrikeAirMissle_target[this], "origin"))
        call s__enemy_dealLogic(s__CMStrikeAirMissle_caster[this] , s__CMStrikeAirMissle_target[this] , s__CMStrikeAirMissle_damage[this] , WEAPON_TYPE_METAL_HEAVY_CHOP , 1)
        call s__CMStrikeAirMissle_onFinal(this)
    endfunction
    function s__CMStrikeAirMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real ang
        if IsUnitType(s__CMStrikeAirMissle_target[this], UNIT_TYPE_DEAD) then
            call s__CMStrikeAirMissle_onFinal(this)
            return
        endif
        set ang=s__Angle_WBW(s__CMStrikeAirMissle_myDummy[this] , s__CMStrikeAirMissle_target[this])
        call SetUnitFacing(s__CMStrikeAirMissle_myDummy[this], ang)
        if s__Distance_WBW(s__CMStrikeAirMissle_target[this] , s__CMStrikeAirMissle_myDummy[this]) > s__CMStrikeAirMissle_mySpeed[this] then
            call SetUnitX(s__CMStrikeAirMissle_myDummy[this], GetUnitX(s__CMStrikeAirMissle_myDummy[this]) + s__Polar_X(s__CMStrikeAirMissle_mySpeed[this] , ang))
            call SetUnitY(s__CMStrikeAirMissle_myDummy[this], GetUnitY(s__CMStrikeAirMissle_myDummy[this]) + s__Polar_Y(s__CMStrikeAirMissle_mySpeed[this] , ang))
            set s__CMStrikeAirMissle_mySpeed[this]=s__CMStrikeAirMissle_mySpeed[this] + 1.00
            return
        endif
        call SetUnitX(s__CMStrikeAirMissle_myDummy[this], GetUnitX(s__CMStrikeAirMissle_target[this]))
        call SetUnitY(s__CMStrikeAirMissle_myDummy[this], GetUnitY(s__CMStrikeAirMissle_target[this]))
        call FXRD_FXDebuffShock(s__CMStrikeAirMissle_target[this] , 3.00)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl", s__CMStrikeAirMissle_target[this], "chest"))
        call DestroyEffect(AddSpecialEffectTarget("FXRD\\FX\\JeanneAlterSpell\\JeanneAlterSpell2.mdl", s__CMStrikeAirMissle_target[this], "origin"))
        call s__tick_start(s__CMStrikeAirMissle_main[this],1.00 , false , function s__CMStrikeAirMissle_onFinalHit)
    endfunction
    function s__CMStrikeAirMissle_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        local real ang= s__Angle_WBW(src , dst)
        set s__CMStrikeAirMissle_caster[this]=src
        set s__CMStrikeAirMissle_target[this]=dst
        set s__CMStrikeAirMissle_damage[this]=dmg
        set s__CMStrikeAirMissle_mySpeed[this]=10
        set s__CMStrikeAirMissle_main[this]=this
        set s__CMStrikeAirMissle_myDummy[this]=CreateUnit(Player(15), 'o00N', GetUnitX(src) + s__Polar_X(100 , ang - 180), GetUnitY(src) + s__Polar_Y(100 , ang - 180), ang)
        call s__tick_start(s__CMStrikeAirMissle_main[this],0.03125 , true , function s__CMStrikeAirMissle_onFire)
    endfunction

