        call s__EV105KarnaA_deallocate(this)
    endfunction
    
    //API
    function s__EV105KarnaA_append takes unit src,real coold,real dmg,string mot,real range returns nothing
        local integer this= s__EV105KarnaA_create(src)
        //대상 거르기
        if this < 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "EV105KarnaA failed to apply!")
            return
        endif
        //유닛 소거 시 자동소멸
        set s__EV105KarnaA_onRemoveAction[this]=s__EVUnitRemove_bind(src , function sc__EV105KarnaA_onSourceUnitRemove)
        set s__EV105KarnaA_myServant[this]=src
        set s__EV105KarnaA_myRange[this]=range
        set s__EV105KarnaA_myCooldown[this]=coold
        set s__EV105KarnaA_myDamage[this]=dmg
        set s__EV105KarnaA_motion[this]=mot
        set s__EV105KarnaA_coolTick[this]=s__tick_create(this)
        call s__tick_start(s__EV105KarnaA_coolTick[this],0.30 , true , function sc__EV105KarnaA_onCastSpell)
    endfunction
    
    //구현부
    function s__EV105KarnaA_onSourceUnitRemove takes nothing returns nothing
        local integer this= s__EV105KarnaA_getThis(s__EVUnitRemove_e)
        //누수처리
        call s__tick_destroy(s__EV105KarnaA_coolTick[this])
        set s__EV105KarnaA_myServant[this]=null
        call TriggerUnbindAction(s__EV105KarnaA_onRemoveAction[this])
        set s__EV105KarnaA_onRemoveAction[this]=null
        //종결
        call s__EV105KarnaA_destroy(this)
    endfunction
    
    
    function s__EV105KarnaA_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV105KarnaA_CNT) == 0 then
            set s__EV105KarnaA_DEST=GetEnumUnit()
        endif
        set s__EV105KarnaA_CNT=s__EV105KarnaA_CNT + 1
    endfunction
    
    function s__EV105KarnaA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV105KarnaA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV105KarnaA_coolTick[this])
            return
        endif
        set s__EV105KarnaA_DEST=null
        set s__EV105KarnaA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV105KarnaA_myServant[this] , GetUnitX(s__EV105KarnaA_myServant[this]) , GetUnitY(s__EV105KarnaA_myServant[this]) , s__EV105KarnaA_myRange[this] , function s__EV105KarnaA_enumGetTarget)
        //대상이 없으면
        if s__EV105KarnaA_DEST == null then
            call s__tick_start(s__EV105KarnaA_coolTick[this],1.00 , true , function s__EV105KarnaA_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMBrahmastra_cast(s__EV105KarnaA_myServant[this] , s__EV105KarnaA_DEST , s__EV105KarnaA_myDamage[this] , s__EV105KarnaA_motion[this])
        call s__tick_start(s__EV105KarnaA_coolTick[this],s__EV105KarnaA_myCooldown[this] , true , function s__EV105KarnaA_onCastSpell)
        set s__EV105KarnaA_DEST=null
    endfunction
    

