    constant function s__ToPlayer__staticgetindex takes integer v returns player
        return Player(v)
    endfunction

    function s__PlayerId__staticgetindex takes player v returns integer
        return GetPlayerId(v)
    endfunction
    function s__StartLocation__staticgetindex takes player v returns integer
        return GetPlayerStartLocation(v)
    endfunction
    function s__StartLocationX__staticgetindex takes player v returns real
        return GetStartLocationX(GetPlayerStartLocation(v))
    endfunction
    function s__StartLocationY__staticgetindex takes player v returns real
        return GetStartLocationY(GetPlayerStartLocation(v))
    endfunction

    function s__Mana__staticgetindex takes unit v returns real
        return GetUnitState(v, UNIT_STATE_MANA)
    endfunction
    function s__Life__staticgetindex takes unit v returns real
        return GetUnitState(v, UNIT_STATE_LIFE)
    endfunction
    function s__Owner__staticgetindex takes unit v returns player
        return GetOwningPlayer(v)
    endfunction
    function s__OwnerId__staticgetindex takes unit v returns integer
        return GetPlayerId(GetOwningPlayer(v))
    endfunction
    function s__Facing__staticgetindex takes unit v returns real
        return GetUnitFacing(v)
    endfunction
    function s__IsDead__staticgetindex takes unit v returns boolean
        return IsUnitType(v, UNIT_TYPE_DEAD) or GetUnitTypeId(v) == 0
    endfunction
    function s__IsAlive__staticgetindex takes unit v returns boolean
        return not IsUnitType(v, UNIT_TYPE_DEAD) and GetUnitTypeId(v) != 0
    endfunction

    function s__UnitId__staticgetindex takes unit v returns integer
        return GetUnitTypeId(v)
    endfunction
    function s__ItemId__staticgetindex takes item v returns integer
        return GetItemTypeId(v)
    endfunction

    function s__UnitName__staticgetindex takes unit v returns string
        return GetUnitName(v)
    endfunction
    function s__ItemName__staticgetindex takes item v returns string
        return GetItemName(v)
    endfunction
    function s__PlayerName__staticgetindex takes player v returns string
        return GetPlayerName(v)
    endfunction
    function s__ObjectName__staticgetindex takes integer v returns string
        return GetObjectName(v)
    endfunction

    function s__Gold__staticgetindex takes player v returns integer
        return GetPlayerState(v, PLAYER_STATE_RESOURCE_GOLD)
    endfunction
    function s__Lumber__staticgetindex takes player v returns integer
        return GetPlayerState(v, PLAYER_STATE_RESOURCE_LUMBER)
    endfunction

    function s__PosX__staticgetindex takes widget v returns real
        return GetWidgetX(v)
    endfunction
    function s__PosY__staticgetindex takes widget v returns real
        return GetWidgetY(v)
    endfunction
