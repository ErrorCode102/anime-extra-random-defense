function sa__EV161RyougiB_onSourceUnitAttack takes nothing returns boolean

        local integer this
        local unit src
        local unit dst
        if not DEAL_FLAG_ATTACKING then
return true
        endif
        if DEAL_FLAG_LOGIC then
return true
        endif
        set src=GetTriggerUnit()
        set dst=GetEventDamageSource()
        set this=s__EV161RyougiB_getThis(GetUnitUserData(src))
        if dst != s__EV161RyougiB_myLastTarget[this] then
            set s__EV161RyougiB_myLastTarget[this]=dst
            set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_maxCombo[this]
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
                set s__EV161RyougiB_myHandEffect[this]=null
            endif
        endif
        set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_myCombo[this] - 1
        if s__EV161RyougiB_myCombo[this] == 1 then
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
            endif
            set s__EV161RyougiB_myHandEffect[this]=AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", s__EV161RyougiB_myServant[this], "hand right")
        endif
        if s__EV161RyougiB_myCombo[this] > 0 then
            call s__bountyTag_custom(GetOwningPlayer(src) , GetUnitX(src) , GetUnitY(src) , "|c00FF0000" + I2S(s__EV161RyougiB_maxCombo[this] - s__EV161RyougiB_myCombo[this]) + " hit!")
        endif
        if s__EV161RyougiB_myCombo[this] == 0 then
            if s__EV161RyougiB_myHandEffect[this] != null then
                call DestroyEffect(s__EV161RyougiB_myHandEffect[this])
                set s__EV161RyougiB_myHandEffect[this]=null
            endif
            set s__EV161RyougiB_myCombo[this]=s__EV161RyougiB_maxCombo[this]
            call FXRD_FXUltimateShock(dst , 3600.00)
        endif
        set src=null
        set dst=null
   return true
endfunction
