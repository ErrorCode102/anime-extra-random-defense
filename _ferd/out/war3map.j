        set PLAYtryboss___UMOTION[3]=9
        set PLAYtryboss___UMOTION[4]=1
        set PLAYtryboss___UMOTION[5]=2
        set PLAYtryboss___UMOTION[6]=10
        set PLAYtryboss___UMOTION[7]=4
        set PLAYtryboss___UMOTION[8]=1
        set PLAYtryboss___UMOTION[9]=3
        set PLAYtryboss___UMOTION[10]=1
        
        set PLAYtryboss___UID[1]='nB00'
        set PLAYtryboss___UID[2]='nB01'
        set PLAYtryboss___UID[3]='nB02'
        set PLAYtryboss___UID[4]='nB03'
        set PLAYtryboss___UID[5]='nB04'
        set PLAYtryboss___UID[6]='nB05'
        set PLAYtryboss___UID[7]='nB06'
        set PLAYtryboss___UID[8]='nB07'
        set PLAYtryboss___UID[9]='nB08'
        set PLAYtryboss___UID[10]='nB09'
        
        call s__eventCustom_addAction(EVENT_GAME_ROUND , function PLAYtryboss___onGameRound)
        
        set PLAYtryboss___GOLD[1]=1500
        set PLAYtryboss___GOLD[2]=2500
        set PLAYtryboss___GOLD[3]=4500
        set PLAYtryboss___GOLD[4]=7500
        set PLAYtryboss___GOLD[5]=11500
        set PLAYtryboss___GOLD[6]=16500
        set PLAYtryboss___GOLD[7]=22500
        set PLAYtryboss___GOLD[8]=30000
        set PLAYtryboss___GOLD[9]=40000
        set PLAYtryboss___GOLD[10]=50000
    endfunction
