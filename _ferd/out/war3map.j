        set fx_lastCreatedAoe=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), utyp, x, y, f)
        call SetUnitVertexColor(fx_lastCreatedAoe, R, G, B, A)
        call SetUnitScale(fx_lastCreatedAoe, S, S, 1)
        return fx_lastCreatedAoe
    endfunction

