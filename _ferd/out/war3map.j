        set s__EV138AlexanderA_onRemoveAction[this]=null
        //종결
        call s__EV138AlexanderA_destroy(this)
    endfunction
    
    
    function s__EV138AlexanderA_enumGetTarget takes nothing returns nothing
        if GetRandomInt(0, s__EV138AlexanderA_CNT) == 0 then
            set s__EV138AlexanderA_DEST=GetEnumUnit()
        endif
        set s__EV138AlexanderA_CNT=s__EV138AlexanderA_CNT + 1
    endfunction
    
    function s__EV138AlexanderA_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if IsUnitType(s__EV138AlexanderA_myServant[this], UNIT_TYPE_DEAD) then
            call s__tick_pause(s__EV138AlexanderA_coolTick[this])
            return
        endif
        set s__EV138AlexanderA_DEST=null
        set s__EV138AlexanderA_CNT=0
        call s__splash_range(s__splash_ENEMY , s__EV138AlexanderA_myServant[this] , GetUnitX(s__EV138AlexanderA_myServant[this]) , GetUnitY(s__EV138AlexanderA_myServant[this]) , GetUnitAcquireRange(s__EV138AlexanderA_myServant[this]) , function s__EV138AlexanderA_enumGetTarget)
        //대상이 없으면
        if s__EV138AlexanderA_DEST == null then
            call s__tick_start(s__EV138AlexanderA_coolTick[this],1.00 , true , function s__EV138AlexanderA_onCastSpell)
            return
        endif
        //쿨 걸리면
        call s__CMSpatha_cast(s__EV138AlexanderA_myServant[this] , s__EV138AlexanderA_DEST , s__EV138AlexanderA_myDamage[this] + s__EV138AlexanderA_myDamageMtpl[this] * s__EVDamageManager_getFinalDamage(s__EV138AlexanderA_myServant[this]))
        call s__tick_start(s__EV138AlexanderA_coolTick[this],s__EV138AlexanderA_myCooldown[this] , true , function s__EV138AlexanderA_onCastSpell)
        set s__EV138AlexanderA_DEST=null
    endfunction
    

//===========================================================================
// Trigger: EV 139 AlexanderB
//===========================================================================

    
    function s__EV139AlexanderB_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__EV139AlexanderB_STRUCT_ID)
