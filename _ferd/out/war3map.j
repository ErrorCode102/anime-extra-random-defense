    endfunction
    
    function FXResultInterfaceCaller___onGamePlayerResulted takes nothing returns nothing
        local integer res= RRGetResponse()
        local player p= s__GameResponse__get_Player(res)
        local integer id= GetPlayerId(p)
        //결과창 출력
        if FXResultInterfaceCaller___MODULE_TIMER[id] == 0 then
            set FXResultInterfaceCaller___MODULE_TIMER[id]=s__tick_create(id)
        endif
        call s__tick_start(FXResultInterfaceCaller___MODULE_TIMER[id],FXResultInterfaceCaller___DELAY_INTERFACE , false , function FXResultInterfaceCaller___CallBack)
        
        set p=null
    endfunction

    function FXResultInterfaceCaller___main takes nothing returns nothing
        call RRRegisterResponseEvent(RESPONSE_GAME_PLAYER_RESULT , function FXResultInterfaceCaller___onGamePlayerResulted)
    endfunction
    
