        call RRRegisterResponseEvent(RESPONSE_GAME_SETTING , function UIGameSettingModule__onGameSetting)
        call RRRegisterResponseEvent(RESPONSE_GAME_SET , function UIGameSettingModule__onGameSet)
        
        call s__UnitSelectEvent_Create('n00Q' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00R' , function UIGameSettingModule__onTogglePanaltyButton)
        call s__UnitSelectEvent_Create('n00S' , function UIGameSettingModule__onTogglePanaltyButton)
