        if not IsUnitType(s__FXAltera_caster[this], UNIT_TYPE_DEAD) then
            call DestroyEffect(AddSpecialEffectTarget("FX\\Okita\\Aura1.mdl", s__FXAltera_caster[this], "origin"))
            set s__FXAltera_loops[this]=s__FXAltera_loops[this] - 1
            if s__FXAltera_loops[this] > 0 then
