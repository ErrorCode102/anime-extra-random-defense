    endfunction
    
    //생성자, 소멸자
    
    function s__BossSkillKnockback_create takes unit src returns integer
        local integer this= - 1
        if GetUnitUserData(src) == 0 then
            call DisplayTextToPlayer(GetLocalPlayer(), 0, 0, "Error: Attempt to join a module that requires indexing to an unindexed unit!")
            return this
        endif
        set this=s__BossSkillKnockback__allocate()
        set s__BossSkillKnockback_ID[this]=GetUnitUserData(src)
        call s__BossSkillKnockback_setThis(s__BossSkillKnockback_ID[this] , this)
        return this
    endfunction
    
