            call DestroyEffect(AddSpecialEffectTarget("Objects\\InventoryItems\\QuestionMark\\QuestionMark.mdl", s__CMBallBreak_myDummy[this], "overhead"))
        else
            call SetSoundPosition(gg_snd_TamamoEggBreakHit, GetUnitX(s__CMBallBreak_target[this]), GetUnitY(s__CMBallBreak_target[this]), 300)
            call StartSound(gg_snd_TamamoEggBreakHit)
            call SetSoundPosition(gg_snd_TamamoEggBreakImpact, GetUnitX(s__CMBallBreak_target[this]), GetUnitY(s__CMBallBreak_target[this]), 300)
            call StartSound(gg_snd_TamamoEggBreakImpact)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Silence\\SilenceTarget.mdl", s__CMBallBreak_target[this], "overhead"))
            call FXRD_FXDebuffShock(s__CMBallBreak_target[this] , 10.00)
            call s__enemy_dealLogicEx(s__CMBallBreak_caster[this] , s__CMBallBreak_target[this] , s__CMBallBreak_damage[this] , true , true , WEAPON_TYPE_ROCK_HEAVY_BASH , 1)
        endif
        call sc__DummyColorChanger_cast(s__CMBallBreak_myDummy[this] , 255 , 255 , 255 , 128 , 0 , 0 , 0 , 0 , 0.20)
        call s__tick_start(s__CMBallBreak_main[this],0.20 , false , function s__CMBallBreak_onFinal)
    endfunction
    function s__CMBallBreak_cast takes unit src,unit dst,real dmg returns nothing
        local integer this= s__tick_create(0)
        set s__CMBallBreak_caster[this]=src
        set s__CMBallBreak_target[this]=dst
        set s__CMBallBreak_damage[this]=dmg
        set s__CMBallBreak_main[this]=this
        call SetSoundPosition(gg_snd_TamamoEggBreakCast, GetUnitX(src), GetUnitY(src), 300)
        call StartSound(gg_snd_TamamoEggBreakCast)
        set s__CMBallBreak_myDummy[this]=CreateUnit(Player(15), 'o00R', GetUnitX(dst), GetUnitY(dst), s__Angle_WBW(src , dst))
        call sc__DummyColorChanger_cast(s__CMBallBreak_myDummy[this] , 255 , 255 , 255 , 0 , 255 , 255 , 255 , 128 , 0.20)
        call SetUnitAnimation(s__CMBallBreak_myDummy[this], "spell slam two")
        call s__tick_start(s__CMBallBreak_main[this],0.20 , true , function s__CMBallBreak_onFire)
    endfunction
