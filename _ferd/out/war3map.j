    endfunction
    
    function s__ABILBBSSPotnia_OnSourceRemove takes nothing returns nothing
        local integer this= GetTriggerIndex()
        call s__ABILBBSSPotnia_free(this)
    endfunction
    
    function s__ABILBBSSPotnia_onExpire takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        if not s__ABILBBSSPotnia_exists[this] then
            return
        endif
        if IsUnitDead(s__ABILBBSSPotnia_source[this]) then
