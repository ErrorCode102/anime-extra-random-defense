    function SVMELTPENGUINSPAWN___main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록_확장("h010","7","1725","Anylevel")
        set SVMELTPENGUINSPAWN___SERVANT_DAMAGE[7]=1725
        call s__eventServantAdd_register('h010' , function SVMELTPENGUINSPAWN___Anylevel)
//end of: 서번트_등록_확장("h010","7","1725","Anylevel")
        
//textmacro instance: 서번트_선언_끝()//===========================================================================
    endfunction
