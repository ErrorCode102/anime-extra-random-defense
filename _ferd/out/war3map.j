    // TODO : 서번트 무기에 관한 함수를 Import하거나, 사용자 정의 함수를 작성합니다.
//textmacro instance: 서번트_무기_일반("OnMeleeAttack")
        function SVDRAKE__OnMeleeAttack takes nothing returns nothing
            local unit src= GetTriggerUnit()
            local unit dst= GetEventDamageSource()
            call s__enemy_dealLogic(src , dst , sc__EVDamageManager_getFinalDamage(src) , WEAPON_TYPE_WHOKNOWS , 0)
            set src=null
            set dst=null
        endfunction
//end of: 서번트_무기_일반("OnMeleeAttack")

    // TODO : 서번트_공격방식_선언( 공격이름, 실행할무기 )
//textmacro instance: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
    function SVDRAKE__MeleeAttack takes nothing returns nothing
        if not DEAL_FLAG_ATTACKING then
            return
        endif
        if DEAL_FLAG_LOGIC then
            return
        endif
        call SVDRAKE__OnMeleeAttack()
    endfunction
//end of: 서번트_공격방식_선언("MeleeAttack", "OnMeleeAttack")
        
    // TODO : 서번트 획득 이벤트에 대한 사용자 정의 액션 함수를 작성합니다.
        function SVDRAKE__OnBAS takes nothing returns nothing
            local integer lv= GetUnitLevel(s__eventServantAdd_e)
            // Adding Melee Attack
            call sc__EVServantAttack_addFunction(s__eventServantAdd_e , function SVDRAKE__MeleeAttack)
            // Adding Special Skillz
            if lv == 4 then
                call sc__EV140FrancisA_append(s__eventServantAdd_e , 1000 , 2 , 5.0)
            endif
            if lv == 5 then
                call sc__EV140FrancisA_append(s__eventServantAdd_e , 2500 , 4 , 5.0)
                call sc__EV141FrancisB_append(s__eventServantAdd_e , 3)
            endif
            if lv == 6 then
                call sc__EV140FrancisA_append(s__eventServantAdd_e , 8000 , 8 , 5.0)
                call sc__EV141FrancisB_append(s__eventServantAdd_e , 10)
            endif
        endfunction
        
        function SVDRAKE__OnEX takes nothing returns nothing
            // Adding Melee Attack
            // call EVServantAttack.addFunction( eventServantAdd.e, function MeleeAttack )
            // Adding Special Skillz
            call sc__ABILEXDrakeAttack_append(s__eventServantAdd_e)
            call sc__ABILEXDrakeCannons_append(s__eventServantAdd_e , 1.0)
        endfunction
        
    // TODO : 서번트_획득_이벤트_선언( 이벤트_이름, 실행할함수명 )
//textmacro instance: 서번트_획득_이벤트_선언("BAS", "OnBAS")
    function SVDRAKE__BAS takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVDRAKE__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVDRAKE__OnBAS()
    endfunction
//end of: 서번트_획득_이벤트_선언("BAS", "OnBAS")
//textmacro instance: 서번트_획득_이벤트_선언("EX", "OnEX")
    function SVDRAKE__EX takes nothing returns nothing
        call sc__EVDamageManager_addOrigin(s__eventServantAdd_e , SVDRAKE__SERVANT_DAMAGE[GetUnitLevel(s__eventServantAdd_e)])
        call SVDRAKE__OnEX()
    endfunction
//end of: 서번트_획득_이벤트_선언("EX", "OnEX")
        
    // TODO : 서번트_등록( 등급, 기초 공격력, 발동될_획득_이벤트 )
//textmacro instance: 서번트_등록_개시()
    function SVDRAKE__main takes nothing returns nothing
//end of: 서번트_등록_개시()
//textmacro instance: 서번트_등록("4","170","BAS")
        set SVDRAKE__SERVANT_DAMAGE[4]=170
        call s__eventServantAdd_register(SVDRAKE__SERVANT_ID + FX_SERVANT_LEVEL_4 , function SVDRAKE__BAS)
//end of: 서번트_등록("4","170","BAS")
//textmacro instance: 서번트_등록("5","425","BAS")
        set SVDRAKE__SERVANT_DAMAGE[5]=425
        call s__eventServantAdd_register(SVDRAKE__SERVANT_ID + FX_SERVANT_LEVEL_5 , function SVDRAKE__BAS)
//end of: 서번트_등록("5","425","BAS")
//textmacro instance: 서번트_등록("6","1360","BAS")
        set SVDRAKE__SERVANT_DAMAGE[6]=1360
        call s__eventServantAdd_register(SVDRAKE__SERVANT_ID + FX_SERVANT_LEVEL_6 , function SVDRAKE__BAS)
//end of: 서번트_등록("6","1360","BAS")
//textmacro instance: 서번트_등록("7","2300","EX")
        set SVDRAKE__SERVANT_DAMAGE[7]=2300
        call s__eventServantAdd_register(SVDRAKE__SERVANT_ID + FX_SERVANT_LEVEL_7 , function SVDRAKE__EX)
//end of: 서번트_등록("7","2300","EX")
        
//textmacro instance: 서번트_선언_끝()
    endfunction
