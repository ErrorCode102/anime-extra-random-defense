//      네로 - 황금극장 가속 효과
//===================================================
// scope TrigFactionNeroDormusBoost begins

    function TrigFactionNeroDormusBoost__OnAction takes nothing returns nothing
        local unit self
        //FXRD 세력 - (추가된 서번트의 소유주)의 현재 세력이 (NERO)가 아니라면, 즉시 종료합니다.
        if FXGetPlayerCurrentFaction(s__eventServantAdd_ep) != FX_FACTION_NERO then
            return
        endif
        set self=s__eventServantAdd_e
        //유닛 - (추가된 서번트)에게 (황금 극장 효과 능력)을 추가합니다.
        call UnitAddAbility(self, TrigFactionNeroDormusBoost__ABID)
        //포상 텍스트 - (추가된 서번트의 소유주)에게 (효과 적용 알림 문구)텍스트를 표시합니다.
        call s__bountyTag_custom(s__eventServantAdd_ep , GetUnitX(self) , GetUnitY(self) , TrigFactionNeroDormusBoost__ATAS)
        call DestroyEffect(AddSpecialEffectTarget(TrigFactionNeroDormusBoost__FXPA, self, TrigFactionNeroDormusBoost__FXPO))
        set self=null
    endfunction
    
    function TrigFactionNeroDormusBoost__main takes nothing returns nothing
        //이벤트 - (종류에 관계없이) 서번트가 추가되면 발동합니다.
        call s__eventServantAdd_register(0 , function TrigFactionNeroDormusBoost__OnAction)
    endfunction
// scope TrigFactionNeroDormusBoost ends
//===================================================
//      네로 - 초기 자금 지급
//===================================================
// scope TrigFactionNeroStartGold begins
    function TrigFactionNeroStartGold__GiveGoldEnum takes nothing returns nothing
        local integer t= s__tick_getExpired()
        local real x= GetPlayerStartLocationX(TrigFactionNeroStartGold__GoldPlayer[t]) + GetRandomReal(- 64.0, 64.0)
        local real y= GetPlayerStartLocationY(TrigFactionNeroStartGold__GoldPlayer[t]) + GetRandomReal(- 64.0, 64.0)
        local integer amt= 10
        call AddPlayerGold(TrigFactionNeroStartGold__GoldPlayer[t] , amt)
        call DestroyEffect(AddSpecialEffect("Objects\\InventoryItems\\PotofGold\\PotofGold.mdl", x, y))
        call SetSoundPosition(gg_snd_Gold, x, y, 200)
        call StartSoundForPlayerBJ(TrigFactionNeroStartGold__GoldPlayer[t], gg_snd_Gold)
        call s__bountyTag_custom(TrigFactionNeroStartGold__GoldPlayer[t] , x , y + 64 , "|c00FFCC80+" + I2S(amt))
        set TrigFactionNeroStartGold__GoldAmount[t]=TrigFactionNeroStartGold__GoldAmount[t] + amt
        if TrigFactionNeroStartGold__GoldAmount[t] == 1000 then
            call s__tick_destroy(t)
        endif
    endfunction
    function TrigFactionNeroStartGold__GiveStartGold takes player p returns nothing
        local integer t= s__tick_create(0)
        set TrigFactionNeroStartGold__GoldPlayer[t]=p
        set TrigFactionNeroStartGold__GoldAmount[t]=0
        call s__tick_start(t,0.03125 , true , function TrigFactionNeroStartGold__GiveGoldEnum)
    endfunction
    function TrigFactionNeroStartGold__OnAction takes nothing returns nothing
        //FXRD 세력 - 현재 세력이 (NERO)가 아니라면, 즉시 종료합니다.
        if FXGetPlayerCurrentFaction(s__eventCustom_getTriggerPlayer()) != FX_FACTION_NERO then
            return
        endif
        call TrigFactionNeroStartGold__GiveStartGold(s__eventCustom_getTriggerPlayer())
    endfunction
    function TrigFactionNeroStartGold__main takes nothing returns nothing
        
        call s__eventCustom_addAction(EVENT_PLAYER_BUILDING_SLOT_3 , function TrigFactionNeroStartGold__OnAction)
    endfunction
// scope TrigFactionNeroStartGold ends
//===================================================
//      황제특권 도박
//===================================================
// scope TrigFactionNeroSuperGamble begins
    function TrigFactionNeroSuperGamble__G5000Gacha takes nothing returns nothing
        local player p= GetOwningPlayer(GetSellingUnit())
        local integer id= GetPlayerId(p)
        local integer amt= GetRandomInt(0, 25000)
        if amt < 5000 then
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, s__pcs_get(Player(id)) + "used the Imperial Privileges |c00FFFF00" + I2S(amt) + "G lost|r Damn...")
            call StartSound(gg_snd_GACHA_GOLD_LOST)
        elseif amt == 5000 then
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, s__pcs_get(Player(id)) + "used the Imperial Privileges |c00FFFF00" + I2S(amt) + " obtained gold!|r Luckily!")
            call StartSound(gg_snd_GACHA_GOLD_SAME)
        elseif amt < 10000 then
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, s__pcs_get(Player(id)) + "used the Imperial Privileges |c00FFFF00" + I2S(amt) + "G obtained!|r")
            call StartSound(gg_snd_GACHA_GOLD_GET)
        elseif amt < 20000 then
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, "Wow! " + s__pcs_get(Player(id)) + "used Imperial Privileges & earned |c00FFFF00" + I2S(amt) + "G|r!")
            call StartSound(gg_snd_gacha_good)
        else
            call DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, s__pcs_get(Player(id)) + " like a |c00FF80FFglove|r! Used Imperial Privilege & |c00FFFF00" + I2S(amt) + "G|r!")
            call StartSound(gg_snd_gacha_rare)
        endif
        call AddPlayerGold(p , amt)
        set p=null
    endfunction
    function TrigFactionNeroSuperGamble__main takes nothing returns nothing
        
        call s__UnitSellEvent_Create('n01C' , function TrigFactionNeroSuperGamble__G5000Gacha)
    endfunction
// scope TrigFactionNeroSuperGamble ends
