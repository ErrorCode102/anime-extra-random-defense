// scope FXGameResultScope begins
    function FXGameResultScope___onGameResultRequested takes nothing returns nothing
        local integer req= RRGetRequest()
        local player p= RRGetRequestPlayer()
        local integer id= GetPlayerId(p)
        local boolean isProperPlayer= ( p != null )
        local integer result= 0
        // 유효성 검사
        if GetPlayerSlotState(p) == PLAYER_SLOT_STATE_LEFT then
            set isProperPlayer=false
        endif
        
        if not isProperPlayer then
            return
        endif
        if s__FXGameResult_Resulted[(id)] then
            return
        endif
        set s__FXGameResult_Resulted[(id)]=true
        // 결과 분석
        if req == REQUEST_GAME_PLAYER_VICTORY then
            set result=s__FXGameResult_Victory
        endif
        if req == REQUEST_GAME_PLAYER_DEFEAT then
            set result=s__FXGameResult_Defeat
        endif
        // 브로드캐스트
        call RRResponsePlayerId(RESPONSE_GAME_PLAYER_RESULT , p , result)
        set p=null
    endfunction
    function FXGameResultScope___main takes nothing returns nothing
        call RRRegisterRequestEvent(REQUEST_GAME_PLAYER_VICTORY , function FXGameResultScope___onGameResultRequested)
        call RRRegisterRequestEvent(REQUEST_GAME_PLAYER_DEFEAT , function FXGameResultScope___onGameResultRequested)
    endfunction
