            set s__BossStunStrongest_myTarget[this]=null
            return
        endif
        call sc__EVBossStunMissle_cast(s__BossStunStrongest_myServant[this] , s__BossStunStrongest_myTarget[this])
    endfunction
    
    
    function s__BossStunStrongest_enumGetTarget takes nothing returns nothing
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        if GetRandomInt(0, s__BossStunStrongest_CNT) == 0 then
            set s__BossStunStrongest_DEST=GetEnumUnit()
        endif
        set s__BossStunStrongest_CNT=s__BossStunStrongest_CNT + 1
    endfunction
    
    function s__BossStunStrongest_onCastSpell takes nothing returns nothing
        local integer this= s__tick_data[s__tick_getExpired()]
        local unit u
        if IsUnitDead(s__BossStunStrongest_myServant[this]) then
            call s__tick_pause(s__BossStunStrongest_coolTick[this])
            return
        endif
        set s__BossStunStrongest_DEST=null
        set s__BossStunStrongest_CNT=0
        call s__splash_range(s__splash_ANY , null , GetUnitX(s__BossStunStrongest_myServant[this]) , GetUnitY(s__BossStunStrongest_myServant[this]) , 1000 , function s__BossStunStrongest_enumGetTarget)
        if s__BossStunStrongest_DEST == null then
            return
        endif
        set s__BossStunStrongest_myTarget[this]=s__BossStunStrongest_DEST
        set u=FXRD_FXAoeAlert(AOE_CIRCLE_NOLOOP , GetUnitX(s__BossStunStrongest_myTarget[this]) , GetUnitY(s__BossStunStrongest_myTarget[this]) , 270 , 255 , 0 , 0 , 255 , 7)
        call FXRD_FXBinderBindUnit(u , s__BossStunStrongest_myServant[this])
        call FXRD_FXBinderBindUnit(u , s__BossStunStrongest_myTarget[this])
        call UnitApplyTimedLife(u, 'BHwe', s__BossStunStrongest_myCharge[this])
        call sc__DummyFollowUnit_cast(u , s__BossStunStrongest_myTarget[this])
        set u=null
        call s__tick_start(s__BossStunStrongest_coolTick[this],s__BossStunStrongest_myCharge[this] , false , function s__BossStunStrongest_onCharge)
    endfunction
    

    function s__EVBossStunMissle_enumDealt takes nothing returns nothing
        local integer this= s__tick_getExpired()
        if IsUnitAlly(GetEnumUnit(), FX_PLAYER_ENEMY) then
            return
        endif
        if not IsUnitType(GetEnumUnit(), UNIT_TYPE_TAUREN) then
            return
        endif
        call s__EVDebuffStunServant_apply(GetEnumUnit() , 10.00)
    endfunction
    function s__EVBossStunMissle_onFire takes nothing returns nothing
        local integer this= s__tick_getExpired()
        local real tx= GetUnitX(s__EVBossStunMissle_myDummy[this])
        local real ty= GetUnitY(s__EVBossStunMissle_myDummy[this])
        if not IsUnitType(s__EVBossStunMissle_target[this], UNIT_TYPE_DEAD) then
            set tx=GetUnitX(s__EVBossStunMissle_target[this])
            set ty=GetUnitY(s__EVBossStunMissle_target[this])
        endif
        call KillUnit(CreateUnit(Player(15), 'o01R', tx, ty, 270.00))
        call s__splash_range(s__splash_ANY , s__EVBossStunMissle_caster[this] , tx , ty , 700 , function s__EVBossStunMissle_enumDealt)
        call KillUnit(s__EVBossStunMissle_myDummy[this])
        set s__EVBossStunMissle_myDummy[this]=null
        set s__EVBossStunMissle_caster[this]=null
        set s__EVBossStunMissle_target[this]=null
        call s__tick_destroy(s__EVBossStunMissle_main[this])
    endfunction
    function s__EVBossStunMissle_cast takes unit src,unit dst returns nothing
        local integer this= s__tick_create(0)
        local real ang= GetRandomReal(0.00, 360.00)
        local real dist= SquareRoot(GetRandomReal(0.00, 1.00)) * 300.00
        set s__EVBossStunMissle_caster[this]=src
        set s__EVBossStunMissle_target[this]=dst
        set s__EVBossStunMissle_main[this]=this
        set s__EVBossStunMissle_myDummy[this]=CreateUnit(Player(15), 'o00N', GetUnitX(src) + s__Polar_X(dist , ang), GetUnitY(src) + s__Polar_Y(dist , ang), ang)
        call SetUnitScale(s__EVBossStunMissle_myDummy[this], 4, 1, 1)
        call SetUnitFlyHeight(s__EVBossStunMissle_myDummy[this], 500 + GetRandomReal(0.00, 100.00), 0.00)
        call sc__DummyMissileTimed_cast(s__EVBossStunMissle_myDummy[this] , dst , 0 , 0 , 0.00 , 1.00)
        call s__tick_start(s__EVBossStunMissle_main[this],1.00 , false , function s__EVBossStunMissle_onFire)
    endfunction
// Trigger: EV 21 BossSkillKnockback
//===========================================================================

    
    function s__BossSkillKnockback_getThis takes integer id returns integer
        return LoadInteger(GetCustomDataTable(id), 0, GetCustomDataKey(id) + s__BossSkillKnockback_STRUCT_ID)
    endfunction
    
    function s__BossSkillKnockback_setThis takes integer id,integer this returns nothing
